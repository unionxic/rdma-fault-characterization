+/* =====================================================================
+ * [RDMA-FAULT-RECOVERY] In-tree fault classification + bilateral QP recovery.
+ *
+ * Opt-in: NCCL_RDMA_FAULT_RECOVERY=1. With it unset/0 every hook is skipped
+ * (base->fr.enabled == 0) and the transport issues the same verbs calls and
+ * returns the same results as stock v2.23.4-1.
+ *
+ * On a failed completion the fault is classified (ncclIbFrClassify, a port of
+ * the rdma-error harness taxonomy) and logged together with an OOB-socket
+ * liveness probe (ncclIbFrLiveness). Recovery is attempted ONLY when every
+ * condition below holds; otherwise the comm fails exactly like stock
+ * (ncclRemoteError) and the failure is latched (sticky) for the comm:
+ *  1. the incident's first error CQE is IBV_WC_WR_FLUSH_ERR on the SEND comm,
+ *     i.e. the local QP left RTS without a completion error of its own (a
+ *     transient local ERR such as NCCL_RDMA_FAULT_INJECT). NAK classes,
+ *     RETRY_EXC and local protection/length errors are never recovered;
+ *  2. configuration: nqps == 1, ndevs == 1, and the failed send has nreqs == 1;
+ *  3. QUIESCENCE, checked on both sides BEFORE any QP is modified:
+ *     - initiator: the failed request, decoded from wc->wr_id with the stock
+ *       encoding, is the only request of the comm with outstanding completions;
+ *     - responder: the receive the failed send was writing into (matched by the
+ *       CTS FIFO sequence number carried in the REQ) is outstanding, its data has
+ *       not been consumed, no other request has outstanding completions (so no
+ *       other receive is posted and no other signaled CTS write is pending), and
+ *       no GPU-flush read is in flight (waited for, bounded).
+ *     CTS writes of older receives were delivered: the failed send consumed the
+ *     CTS of this receive, and RC delivers the CTS writes of one QP in order;
+ *  4. no async fatal event on the comm or its device(s) (NCCL never clears it),
+ *     and no FIN/RST on the peer's OOB socket;
+ *  5. per-comm initiation cap (NCCL_IB_FR_MAX_ATTEMPTS), per-request replay cap.
+ *
+ * Handshake on base.sock (stock NCCL leaves this TCP socket open but unused
+ * after connection setup). All socket I/O is non-blocking with per-comm
+ * offsets; the initiator is a state machine driven by successive ncclIbTest
+ * calls, so the proxy thread keeps serving every other comm (in particular the
+ * local recv comm can answer the peer's REQ: no deadlock when both ranks fault).
+ *   initiator (send comm)                    responder (recv comm)
+ *   error CQE -> checks 1-5 -> REQ{psn,fifo} -> read on every ncclIbTest/Irecv
+ *   QP stays in ERR; test returns not-done   checks 3-4 fail -> NACK (both fail)
+ *                                            else QP RTS->ERR, wait (bounded) for
+ *                                            the receive's WQE to terminate, ->RESET,
+ *                                            ->INIT->RTR(peer psn)->RTS(fresh psn)
+ *                                            with connect-time attributes, re-post
+ *                                            that one receive, ACK{psn}
+ *   ACK -> QP ->RESET->INIT->RTR->RTS, replay the one RDMA_WRITE_WITH_IMM (RDMA
+ *   WRITE is idempotent: same bytes to the same, still-reserved remote buffer),
+ *   DONE ----------------------------------> idle again (Irecv held until DONE)
+ *   No reply within NCCL_RDMA_FAULT_HANDSHAKE_MS, NACK, FAIL, a closed socket or
+ *   any verbs error => both sides latch the failure and return the stock error.
+ * CQEs of the reset QP's old incarnation are dropped only when they belong to
+ * the request being recovered (its completion is re-created by the re-post and
+ * the replay); any other one is either consumed like ncclIbTest would or makes
+ * the recovery fail: a completion is never silently lost or fabricated.
+ * ===================================================================== */
+
+struct ncclIbFaultInfo {
+  const char* cause;
+  const char* action;
+  int recoverable;  // 1 only for WR_FLUSH_ERR (see condition 1 above)
+};
+
+static const char* ncclIbFrStatusStr(int status) {
+  switch (status) {
+    case IBV_WC_SUCCESS:           return "SUCCESS";
+    case IBV_WC_LOC_LEN_ERR:       return "LOC_LEN_ERR";
+    case IBV_WC_LOC_PROT_ERR:      return "LOC_PROT_ERR";
+    case IBV_WC_WR_FLUSH_ERR:      return "WR_FLUSH_ERR";
+    case IBV_WC_REM_INV_REQ_ERR:   return "REM_INV_REQ_ERR";
+    case IBV_WC_REM_ACCESS_ERR:    return "REM_ACCESS_ERR";
+    case IBV_WC_RETRY_EXC_ERR:     return "RETRY_EXC_ERR";
+    case IBV_WC_RNR_RETRY_EXC_ERR: return "RNR_RETRY_EXC_ERR";
+    default:                       return "OTHER";
+  }
+}
+
+// Port of the harness classify(). Only WR_FLUSH_ERR is recoverable in NCCL:
+//  - REM_ACCESS_ERR / REM_INV_REQ_ERR are NAKs; the responder QP that NAKs raises
+//    IBV_EVENT_QP_ACCESS_ERR / IBV_EVENT_QP_REQ_ERR, which ncclIbAsyncThreadMain
+//    turns into ncclIbQpFatalError() on the peer comm's stats; that count is never
+//    cleared and ncclIbStatsCheckFatalCount() fails every later test/isend/irecv of
+//    the peer comm, so a QP-level recovery cannot bring the comm back;
+//  - RNR_RETRY_EXC cannot happen with NCCL's rnr_retry=7 (infinite) unless the peer
+//    is broken; RETRY_EXC means no ACK at all (peer QP in ERR, process or path gone);
+//  - LOC_LEN / LOC_PROT are local WR/MR bugs that a replay would repeat.
+static struct ncclIbFaultInfo ncclIbFrClassify(int status, uint32_t vendor_err) {
+  struct ncclIbFaultInfo f = { "other", "inspect status+vendor_err; stock error", 0 };
+  switch (status) {
+    case IBV_WC_WR_FLUSH_ERR: /* 5 / vendor 0xf5 */
+      f.cause = "WR flushed: the local QP left RTS without a completion error of its own (transient local ERR)";
+      f.action = "bilateral QP reset + replay if both sides are quiescent, else stock error"; f.recoverable = 1; break;
+    case IBV_WC_REM_ACCESS_ERR: /* 10 / 0x88 */
+      f.cause = (vendor_err == 0x88) ? "remote access: invalid rkey or out-of-bounds address" : "remote access violation";
+      f.action = "not recovered: the peer QP raised IBV_EVENT_QP_ACCESS_ERR (fatal for the peer comm in NCCL)"; break;
+    case IBV_WC_REM_INV_REQ_ERR: /* 9 / 0x8a */
+      f.cause = "remote invalid request (opcode not enabled / length / malformed)";
+      f.action = "not recovered: the peer QP raised IBV_EVENT_QP_REQ_ERR (fatal for the peer comm in NCCL)"; break;
+    case IBV_WC_RNR_RETRY_EXC_ERR: /* 13 / 0x87 */
+      f.cause = "RNR retries exhausted (should not happen with rnr_retry=7)";
+      f.action = "not recovered: peer is not posting receives"; break;
+    case IBV_WC_RETRY_EXC_ERR: /* 12 / 0x81 */
+      f.cause = "transport retries exhausted (no ACK): peer QP in ERR, peer process dead, or path down";
+      f.action = "not recovered: human intervention; see liveness / 0x81 sub-cause"; break;
+    case IBV_WC_LOC_PROT_ERR: /* 4 */
+      f.cause = "local protection error (bad lkey / local MR bounds)"; f.action = "not recovered: a replay would repeat it"; break;
+    case IBV_WC_LOC_LEN_ERR: /* 1 */
+      f.cause = "local length error"; f.action = "not recovered: a replay would repeat it"; break;
+    default: break;
+  }
+  return f;
+}
+
+enum { ncclIbFrLiveUnknown = 0, ncclIbFrLiveNoEvidence = 1, ncclIbFrLiveFin = 2, ncclIbFrLiveRst = 3 };
+static const char* ncclIbFrLiveStr(int l) {
+  switch (l) {
+    case ncclIbFrLiveNoEvidence: return "no-FIN/RST";
+    case ncclIbFrLiveFin:        return "FIN(peer closed)";
+    case ncclIbFrLiveRst:        return "RST/TCP-error";
+    default:                     return "unknown";
+  }
+}
+
+// Peer liveness evidence from the OOB socket, without consuming data:
+// recv(MSG_PEEK|MSG_DONTWAIT) == 0 => FIN (peer process closed/exited);
+// -1 with ECONNRESET/EPIPE/ETIMEDOUT/ENOTCONN => RST or TCP failure;
+// -1 with EAGAIN, or pending bytes => no evidence of death.
+// NOTE: a host that dies without emitting FIN/RST (power loss, kernel panic, cable
+// pull) is NOT detected here until TCP itself times out; the handshake deadline
+// still bounds the recovery attempt in that case.
+static int ncclIbFrLiveness(struct ncclIbNetCommBase* base) {
+  if (base->fr.peerClosed) return ncclIbFrLiveFin;
+  int fd = base->sock.fd;
+  if (fd < 0) return ncclIbFrLiveUnknown;
+  char c;
+  ssize_t n = recv(fd, &c, 1, MSG_PEEK | MSG_DONTWAIT);
+  if (n == 0) return ncclIbFrLiveFin;
+  if (n > 0) return ncclIbFrLiveNoEvidence;
+  if (errno == EAGAIN || errno == EWOULDBLOCK || errno == EINTR) return ncclIbFrLiveNoEvidence;
+  if (errno == ECONNRESET || errno == EPIPE || errno == ETIMEDOUT || errno == ENOTCONN) return ncclIbFrLiveRst;
+  return ncclIbFrLiveUnknown;
+}
+
+static const char* ncclIbFrReasonStr(uint32_t r) {
+  switch (r) {
+    case 1:  return "not quiescent (other requests in flight)";
+    case 2:  return "no outstanding receive matches the failed send";
+    case 3:  return "receive data already consumed";
+    case 4:  return "multi-QP / multi-NIC / multi-recv";
+    case 5:  return "async fatal event on comm/device";
+    case 6:  return "responder has its own error CQE";
+    case 7:  return "GPU-flush read still in flight at deadline";
+    case 8:  return "QP reset/re-post failed";
+    case 9:  return "handshake timeout";
+    case 10: return "protocol error";
+    case 11: return "comm already failed";
+    case 12: return "replay failed";
+    case 13: return "request already replayed";
+    case 14: return "size mismatch";
+    case 15: return "fault not recoverable";
+    default: return "unspecified";
+  }
+}
+
+static int ncclIbFrInjectCount = 0;  // NCCL_RDMA_FAULT_INJECT: signaled multi-sends seen (process-wide)
+static int ncclIbFrInjectFired = 0;  // inject at most once per process
+
+static uint64_t ncclIbFrMs(int64_t ms) { return (uint64_t)(ms > 0 ? ms : 1) * 1000000ULL; }
+
+// Fresh random 24-bit PSN (non-zero), so stale packets of the old incarnation are
+// very unlikely (~2^-24) to land on the expected PSN of the new one.
+static uint32_t ncclIbFrFreshPsn(uint32_t salt) {
+  uint64_t x = 0;
+  if (getRandomData(&x, sizeof(x)) != ncclSuccess) x = clockNano();
+  x ^= ((uint64_t)salt << 32) ^ clockNano();
+  x += 0x9e3779b97f4a7c15ULL;
+  x = (x ^ (x >> 30)) * 0xbf58476d1ce4e5b9ULL;
+  x = (x ^ (x >> 27)) * 0x94d049bb133111ebULL;
+  x ^= x >> 31;
+  uint32_t psn = (uint32_t)(x & 0xFFFFFFu);
+  return psn ? psn : 1;
+}
+
+static int ncclIbFrOutstanding(struct ncclIbRequest* r) {
+  return r->type != NCCL_NET_IB_REQ_UNUSED && (r->events[0] != 0 || r->events[1] != 0);
+}
+
+static int ncclIbFrFatal(struct ncclIbNetCommBase* base) {
+  if (__atomic_load_n(&base->stats.fatalErrorCount, __ATOMIC_RELAXED)) return 1;
+  for (int i = 0; i < base->ndevs; i++) {
+    struct ncclIbNetCommDevBase* db = ncclIbGetNetCommDevBase(base, i);
+    if (__atomic_load_n(&ncclIbDevs[db->ibDevN].stats.fatalErrorCount, __ATOMIC_RELAXED)) return 1;
+  }
+  return 0;
+}
+
+// ---- non-blocking control-message I/O on base.sock --------------------------
+static void ncclIbFrTxProgress(struct ncclIbNetCommBase* base) {
+  struct ncclIbFrComm* fr = &base->fr;
+  while (fr->txOff < fr->txLen) {
+    if (fr->peerClosed || base->sock.fd < 0) { fr->txOff = fr->txLen = 0; return; }
+    ssize_t n = send(base->sock.fd, (char*)&fr->tx + fr->txOff, fr->txLen - fr->txOff, MSG_DONTWAIT | MSG_NOSIGNAL);
+    if (n > 0) { fr->txOff += (int)n; continue; }
+    if (n < 0 && (errno == EAGAIN || errno == EWOULDBLOCK || errno == EINTR)) return;  // retry on the next call
+    fr->peerClosed = 1; fr->txOff = fr->txLen = 0; return;
+  }
+  fr->txOff = fr->txLen = 0;
+}
+
+// One message in flight per direction at a time: every message is a reply to, or
+// the terminal step of, the previous one. A new message replaces an unsent one
+// only if nothing of it went out yet.
+static void ncclIbFrSend(struct ncclIbNetCommBase* base, uint32_t type, uint32_t seq, uint64_t fifoIdx, uint32_t psn, int32_t size, uint32_t reason) {
+  struct ncclIbFrComm* fr = &base->fr;
+  ncclIbFrTxProgress(base);
+  if (fr->txOff != 0 && fr->txOff < fr->txLen) return;  // partially sent: cannot interleave; the peer's deadline covers it
+  memset(&fr->tx, 0, sizeof(fr->tx));
+  fr->tx.magic = NCCL_IB_FR_MAGIC; fr->tx.type = type; fr->tx.seq = seq; fr->tx.nqps = base->nqps;
+  fr->tx.fifoIdx = fifoIdx; fr->tx.psn = psn; fr->tx.size = size; fr->tx.reason = reason;
+  fr->txOff = 0; fr->txLen = sizeof(fr->tx);
+  ncclIbFrTxProgress(base);
+}
+
+// Returns 1 when a complete message is available in fr->rx.
+static int ncclIbFrRxProgress(struct ncclIbNetCommBase* base) {
+  struct ncclIbFrComm* fr = &base->fr;
+  if (fr->peerClosed || base->sock.fd < 0) return 0;
+  while (fr->rxOff < (int)sizeof(fr->rx)) {
+    ssize_t n = recv(base->sock.fd, (char*)&fr->rx + fr->rxOff, sizeof(fr->rx) - fr->rxOff, MSG_DONTWAIT);
+    if (n > 0) { fr->rxOff += (int)n; continue; }
+    if (n < 0 && (errno == EAGAIN || errno == EWOULDBLOCK || errno == EINTR)) return 0;
+    fr->peerClosed = 1;  // 0 = FIN, <0 = RST/other
+    return 0;
+  }
+  fr->rxOff = 0;
+  return 1;
+}
+
+// Latch the comm as failed (sticky). A pending REQ is answered with a NACK; otherwise
+// the peer is told with FAIL (best effort) so it fails promptly instead of waiting.
+static void ncclIbFrFail(struct ncclIbNetCommBase* base, uint32_t reason, int notifyPeer) {
+  struct ncclIbFrComm* fr = &base->fr;
+  if (fr->state == ncclIbFrFailed) return;
+  if (!base->isSend && fr->state == ncclIbFrRespPending) ncclIbFrSend(base, ncclIbFrMsgNack, fr->seq, 0, 0, 0, reason);
+  else if (notifyPeer) ncclIbFrSend(base, ncclIbFrMsgFail, fr->seq, 0, 0, 0, reason);
+  fr->state = ncclIbFrFailed;
+  WARN("NET/IB: [FAULT-RECOVERY] %s comm latched FAILED (%s): this and every later operation on it returns the stock error",
+       base->isSend ? "send" : "recv", ncclIbFrReasonStr(reason));
+}
+
+// ---- CQE handling -----------------------------------------------------------
+// Same message as the stock failed-completion WARN in ncclIbTest.
+static void ncclIbFrLogWc(struct ncclIbNetCommBase* base, struct ibv_wc* wc, int i) {
+  union ncclSocketAddress addr;
+  ncclSocketGetAddr(&base->sock, &addr);
+  struct ncclIbNetCommDevBase* db = ncclIbGetNetCommDevBase(base, i);
+  char localGidString[INET6_ADDRSTRLEN] = "";
+  char remoteGidString[INET6_ADDRSTRLEN] = "";
+  const char* localGidStr = NULL, *remoteGidStr = NULL;
+  if (db->gidInfo.link_layer == IBV_LINK_LAYER_ETHERNET) {
+    localGidStr = inet_ntop(AF_INET6, &db->gidInfo.localGid, localGidString, sizeof(localGidString));
+    remoteGidStr = inet_ntop(AF_INET6, &base->remDevs[i].remoteGid, remoteGidString, sizeof(remoteGidString));
+  }
+  char line[SOCKET_NAME_MAXLEN+1];
+  int t = base->reqs[wc->wr_id & 0xff].type;
+  WARN("NET/IB: Got completion from peer %s with status=%d opcode=%d len=%d vendor err %d (%s)%s%s%s%s hca %s",
+      ncclSocketToString(&addr, line), wc->status, wc->opcode, wc->byte_len, wc->vendor_err,
+      (t >= NCCL_NET_IB_REQ_UNUSED && t <= NCCL_NET_IB_REQ_FLUSH) ? reqTypeStr[t] : "?",
+      localGidStr ?  " localGid ":"", localGidString, remoteGidStr ? " remoteGids":"", remoteGidString, db->pd->context->device->name);
+}
+
+// A SUCCESS completion, consumed exactly like the stock loop in ncclIbTest does:
+// wr_id low byte = request index; a multi-send packs one request index per byte.
+static ncclResult_t ncclIbFrCompleteWc(struct ncclIbNetCommBase* base, struct ibv_wc* wc, int i) {
+  struct ncclIbRequest* req = base->reqs + (wc->wr_id & 0xff);
+  if (req->type == NCCL_NET_IB_REQ_SEND) {
+    for (int j = 0; j < req->nreqs; j++) {
+      struct ncclIbRequest* sendReq = base->reqs + ((wc->wr_id >> (j*8)) & 0xff);
+      if ((sendReq->events[i] <= 0)) {
+        WARN("NET/IB: sendReq(%p)->events={%d,%d}, i=%d, j=%d <= 0", sendReq, sendReq->events[0], sendReq->events[1], i, j);
+        return ncclInternalError;
+      }
+      sendReq->events[i]--;
+    }
+  } else {
+    if (wc->opcode == IBV_WC_RECV_RDMA_WITH_IMM) {
+      if (req->type != NCCL_NET_IB_REQ_RECV) {
+        WARN("NET/IB: wc->opcode == IBV_WC_RECV_RDMA_WITH_IMM and req->type=%d", req->type);
+        return ncclInternalError;
+      }
+      if (req->nreqs == 1) {
+        req->recv.sizes[0] = wc->imm_data;
+      }
+      req->recv.arrived = 1;
+    }
+    req->events[i]--;
+  }
+  return ncclSuccess;
+}
+
+// An error completion: remembered (the first one is logged like stock), never
+// returned immediately, so the rest of the batch is still consumed.
+static void ncclIbFrNoteErrorWc(struct ncclIbNetCommBase* base, struct ibv_wc* wc, int i) {
+  struct ncclIbFrComm* fr = &base->fr;
+  if (fr->errCount == 0) {
+    ncclIbFrLogWc(base, wc, i);
+    fr->errStatus = wc->status; fr->errVendor = wc->vendor_err; fr->errWrId = wc->wr_id;
+    fr->errQpNum = wc->qp_num; fr->errDev = i; fr->errForeign = 0;
+  } else if ((wc->wr_id & 0xff) != (fr->errWrId & 0xff) || wc->qp_num != fr->errQpNum) {
+    fr->errForeign = 1;  // error CQE of another request or another QP
+  }
+  fr->errCount++;
+}
+
+// Poll every CQ of the comm until empty (non-blocking) and consume each CQE as
+// ncclIbTest would (successes complete their requests, errors are recorded).
+static ncclResult_t ncclIbFrDrainAll(struct ncclIbNetCommBase* base) {
+  for (int i = 0; i < base->ndevs; i++) {
+    struct ibv_cq* cq = ncclIbGetNetCommDevBase(base, i)->cq;
+    for (int guard = 0; guard < 4*MAX_REQUESTS; guard++) {
+      struct ibv_wc wcs[4];
+      int n = 0;
+      NCCLCHECK(wrap_ibv_poll_cq(cq, 4, wcs, &n));
+      if (n == 0) break;
+      for (int w = 0; w < n; w++) {
+        if (wcs[w].status == IBV_WC_SUCCESS) NCCLCHECK(ncclIbFrCompleteWc(base, wcs+w, i));
+        else ncclIbFrNoteErrorWc(base, wcs+w, i);
+      }
+    }
+  }
+  return ncclSuccess;
+}
+
+// Consume the CQ(s) while/after QP qpNum is moved to ERR/RESET.
+//  - CQEs of other QPs of the comm (the recv comm's GPU-flush QP): as ncclIbTest.
+//  - CQEs of qpNum that belong to request recIdx (the one being recovered) are from
+//    the old incarnation and are dropped: its completion is re-created by the
+//    re-post + replay. For the responder, *rqDone/*rqArrived report whether that
+//    receive's WQE terminated (success = data had landed; the replay rewrites the
+//    same bytes).
+//  - A SUCCESS CQE of any other request is consumed normally (never dropped);
+//    a flushed unsignaled CTS write of a completed receive is dropped (it had been
+//    delivered); anything else means the quiescence precondition was violated.
+static ncclResult_t ncclIbFrDrainOldQp(struct ncclIbNetCommBase* base, uint32_t qpNum, int recIdx, int* rqDone, int* rqArrived) {
+  for (int i = 0; i < base->ndevs; i++) {
+    struct ibv_cq* cq = ncclIbGetNetCommDevBase(base, i)->cq;
+    for (int guard = 0; guard < 4*MAX_REQUESTS; guard++) {
+      struct ibv_wc wcs[4];
+      int n = 0;
+      NCCLCHECK(wrap_ibv_poll_cq(cq, 4, wcs, &n));
+      if (n == 0) break;
+      for (int w = 0; w < n; w++) {
+        struct ibv_wc* wc = wcs + w;
+        if (wc->qp_num != qpNum) {
+          if (wc->status == IBV_WC_SUCCESS) { NCCLCHECK(ncclIbFrCompleteWc(base, wc, i)); continue; }
+          ncclIbFrLogWc(base, wc, i);
+          return ncclRemoteError;
+        }
+        uint64_t tag = wc->wr_id & ~0xffULL;
+        int idx = (int)(wc->wr_id & 0xff);
+        struct ncclIbRequest* req = base->reqs + idx;
+        if (idx == recIdx) {
+          if (!base->isSend && tag == NCCL_IB_FR_WRID_RQ) {
+            *rqDone = 1;
+            if (wc->status == IBV_WC_SUCCESS) *rqArrived = 1;
+          }
+          continue;
+        }
+        if (wc->status == IBV_WC_SUCCESS) {
+          if (!ncclIbFrOutstanding(req)) {
+            WARN("NET/IB: [FAULT-RECOVERY] success CQE for a request with no outstanding completion (idx %d wr_id 0x%lx)", idx, (unsigned long)wc->wr_id);
+            return ncclInternalError;
+          }
+          NCCLCHECK(ncclIbFrCompleteWc(base, wc, i));
+          continue;
+        }
+        if (!base->isSend && tag == NCCL_IB_FR_WRID_CTS && !ncclIbFrOutstanding(req)) continue;
+        WARN("NET/IB: [FAULT-RECOVERY] flushed WR of another in-flight request on the reset QP (idx %d wr_id 0x%lx status %d)",
+             idx, (unsigned long)wc->wr_id, wc->status);
+        return ncclInternalError;
+      }
+    }
+  }
+  return ncclSuccess;
+}
+
+static ncclResult_t ncclIbFrModifyState(struct ibv_qp* qp, enum ibv_qp_state s) {
+  struct ibv_qp_attr a;
+  memset(&a, 0, sizeof(a));
+  a.qp_state = s;
+  NCCLCHECK(wrap_ibv_modify_qp(qp, &a, IBV_QP_STATE));
+  return ncclSuccess;
+}
+
+// RESET -> INIT -> RTR -> RTS with the connect-time attributes: the same pkey/port/
+// access flags as ncclIbCreateQp, ibv_set_ece with the same ECE if it was applied
+// before RTR at connect time, the same remote QPN / remote dev info / override_tc
+// as ncclIbConnect/ncclIbAccept; only the PSNs differ (exchanged in the handshake).
+static ncclResult_t ncclIbFrBringUp(struct ncclIbNetCommBase* base, struct ncclIbQp* qp, uint32_t rqPsn, uint32_t sqPsn) {
+  struct ncclIbNetCommDevBase* db = ncclIbGetNetCommDevBase(base, qp->devIndex);
+  struct ibv_qp_attr a;
+  memset(&a, 0, sizeof(a));
+  a.qp_state = IBV_QPS_INIT;
+  a.pkey_index = ncclParamIbPkey();
+  a.port_num = ncclIbDevs[db->ibDevN].portNum;
+  a.qp_access_flags = qp->accessFlags;
+  NCCLCHECK(wrap_ibv_modify_qp(qp->qp, &a, IBV_QP_STATE | IBV_QP_PKEY_INDEX | IBV_QP_PORT | IBV_QP_ACCESS_FLAGS));
+  if (qp->eceSet) {
+    struct ibv_ece ece = qp->ece;
+    int supported = 1;
+    NCCLCHECK(wrap_ibv_set_ece(qp->qp, &ece, &supported));
+  }
+  NCCLCHECK(ncclIbRtrQp(qp->qp, &db->gidInfo, qp->remQpn, base->remDevs + qp->remDevIdx, qp->overrideTc ? true : false, rqPsn));
+  NCCLCHECK(ncclIbRtsQp(qp->qp, sqPsn));
+  return ncclSuccess;
+}
+
+// Re-post the failed single-request send with the same WR shape ncclIbMultiSend
+// uses for nreqs == 1 on one QP (optional AR split into RDMA_WRITE + 0-byte
+// WRITE_WITH_IMM), to the snapshotted CTS destination.
+static ncclResult_t ncclIbFrReplaySend(struct ncclIbSendComm* comm, struct ncclIbRequest* r) {
+  struct ncclIbQp* qp = comm->base.qps;
+  int devIndex = qp->devIndex;
+  uint64_t idx = (uint64_t)(r - comm->base.reqs);
+  struct ibv_sge sge;
+  struct ibv_send_wr wrs[2];
+  memset(&sge, 0, sizeof(sge));
+  memset(wrs, 0, sizeof(wrs));
+  sge.addr = (uintptr_t)r->send.data;
+  sge.length = r->send.size;
+  sge.lkey = r->send.lkeys[devIndex];
+  wrs[0].opcode = IBV_WR_RDMA_WRITE;
+  wrs[0].wr.rdma.remote_addr = r->send.remoteAddr;
+  wrs[0].wr.rdma.rkey = r->send.rkeys[qp->remDevIdx];
+  if (r->send.size > 0) { wrs[0].sg_list = &sge; wrs[0].num_sge = 1; }
+  struct ibv_send_wr* lastWr = wrs;
+  if (comm->ar && r->send.size > ncclParamIbArThreshold()) {
+    wrs[0].wr_id = NCCL_IB_FR_WRID_BODY | idx;
+    wrs[0].next = wrs + 1;
+    lastWr = wrs + 1;  // 0-byte, remote_addr/rkey 0, exactly as stock
+  }
+  lastWr->wr_id = idx;
+  lastWr->opcode = IBV_WR_RDMA_WRITE_WITH_IMM;
+  lastWr->imm_data = r->send.size;
+  lastWr->send_flags = IBV_SEND_SIGNALED;
+  lastWr->next = NULL;
+  r->events[0] = r->events[1] = 0;
+  ncclIbAddEvent(r, devIndex, &comm->devs[devIndex].base);
+  r->frReplays++;
+  struct ibv_send_wr* bad;
+  NCCLCHECK(wrap_ibv_post_send(qp->qp, wrs, &bad));
+  return ncclSuccess;
+}
+
+// ---- initiator (send comm) --------------------------------------------------
+// Validates condition 3 for the initiator. Returns the failed request's index, or -1
+// with *why/*reason set.
+static int ncclIbFrFailedSend(struct ncclIbNetCommBase* base, const char** why, uint32_t* reason) {
+  struct ncclIbFrComm* fr = &base->fr;
+  uint64_t id = fr->errWrId;
+  int idx = (int)(id & 0xff);
+  struct ncclIbRequest* f = base->reqs + idx;
+  if (fr->errForeign) { *why = "error CQEs of more than one request/QP"; *reason = 1; return -1; }
+  if (f->type != NCCL_NET_IB_REQ_SEND || !ncclIbFrOutstanding(f)) { *why = "failed wr_id does not decode to an outstanding send"; *reason = 10; return -1; }
+  if (f->nreqs != 1) { *why = "failed send is a multi-send (nreqs > 1)"; *reason = 4; return -1; }
+  if ((id & ~0xffULL) != 0 && (id & ~0xffULL) != NCCL_IB_FR_WRID_BODY) { *why = "unexpected wr_id encoding"; *reason = 10; return -1; }
+  if (f->frReplays >= NCCL_IB_FR_MAX_REPLAYS) { *why = "this request was already replayed once"; *reason = 13; return -1; }
+  if (f->send.remoteAddr == 0) { *why = "no CTS snapshot for the failed send"; *reason = 10; return -1; }
+  for (int i = 0; i < MAX_REQUESTS; i++) {
+    if (i != idx && ncclIbFrOutstanding(base->reqs + i)) { *why = "other send requests in flight (not quiescent)"; *reason = 1; return -1; }
+  }
+  return idx;
+}
+
+// Called by ncclIbTest after a poll batch that contained error CQE(s). Returns
+// ncclSuccess (caller reports not-done) when a handshake was started, otherwise
+// latches the comm FAILED and returns the stock error.
+static ncclResult_t ncclIbFrOnLocalError(struct ncclIbNetCommBase* base) {
+  struct ncclIbFrComm* fr = &base->fr;
+  ncclResult_t dr = ncclIbFrDrainAll(base);  // consume the rest of the batch first
+  struct ncclIbFaultInfo fi = ncclIbFrClassify(fr->errStatus, fr->errVendor);
+  int live = ncclIbFrLiveness(base);
+  WARN("NET/IB: [FAULT-RECOVERY] status=%d(%s) vendor_err=0x%x cause='%s' action='%s' recoverable=%d role=%s liveness=%s errCQEs=%d",
+       fr->errStatus, ncclIbFrStatusStr(fr->errStatus), fr->errVendor, fi.cause, fi.action, fi.recoverable,
+       base->isSend ? "INITIATOR" : "RESPONDER", ncclIbFrLiveStr(live), fr->errCount);
+  if (fr->errStatus == IBV_WC_RETRY_EXC_ERR) {
+    WARN("NET/IB: [FAULT-RECOVERY] 0x81 sub-cause: %s",
+         live == ncclIbFrLiveFin ? "proc_kill: peer process closed its OOB socket (FIN)" :
+         live == ncclIbFrLiveRst ? "peer process/host gone: OOB socket reset or TCP error" :
+         live == ncclIbFrLiveNoEvidence ? "server_qp_err or path problem: no FIN/RST on the OOB socket (a host death without FIN/RST is not detectable until TCP times out)" :
+         "undetermined (socket state unknown)");
+  }
+  const char* why = NULL;
+  uint32_t reason = 15;
+  int f = -1;
+  if (dr != ncclSuccess) { why = "CQ poll failed"; reason = 10; }
+  else if (fr->state != ncclIbFrIdle) { why = "error during a recovery in progress"; reason = 8; }
+  else if (!base->isSend) { why = "error on the recv comm (the responder never initiates)"; }
+  else if (!fi.recoverable) { why = "fault class is not recoverable"; }
+  else if (live != ncclIbFrLiveNoEvidence) { why = "peer OOB socket closed/reset/unusable"; }
+  else if (base->ndevs != 1 || base->nqps != 1) { why = "multi-NIC / multi-QP comm"; reason = 4; }
+  else if (fr->attempts >= NCCL_IB_FR_MAX_ATTEMPTS) { why = "per-comm attempt cap reached"; }
+  else if (ncclIbFrFatal(base)) { why = "async fatal event on comm/device"; reason = 5; }
+  else f = ncclIbFrFailedSend(base, &why, &reason);
+  fr->errCount = 0;
+  if (why) {
+    WARN("NET/IB: [FAULT-RECOVERY] recovery declined: %s -> stock error", why);
+    ncclIbFrFail(base, reason, 1);
+    return ncclRemoteError;
+  }
+  struct ncclIbRequest* fr_req = base->reqs + f;
+  fr->attempts++;
+  fr->seq++;
+  fr->reqIdx = f;
+  fr->myPsn = ncclIbFrFreshPsn(base->qps[0].qp->qp_num);
+  fr->deadline = clockNano() + ncclIbFrMs(ncclParamRdmaFaultHandshakeMs());
+  fr->state = ncclIbFrInitWait;
+  ncclIbFrSend(base, ncclIbFrMsgReq, fr->seq, fr_req->send.fifoIdx, fr->myPsn, fr_req->send.size, 0);
+  WARN("NET/IB: [FAULT-RECOVERY] initiator: quiescent single send (req %d, fifoIdx %lu, size %d) -> RECOVER_REQ seq %u sent (attempt %d/%d); QP left in ERR until ACK, deadline %ld ms",
+       f, (unsigned long)fr_req->send.fifoIdx, fr_req->send.size, fr->seq, fr->attempts, NCCL_IB_FR_MAX_ATTEMPTS, (long)ncclParamRdmaFaultHandshakeMs());
+  return ncclSuccess;
+}
+
+// ACK received: reset our QP, bring it up with the responder's PSN, replay.
+static ncclResult_t ncclIbFrInitiatorComplete(struct ncclIbNetCommBase* base, uint32_t peerPsn) {
+  struct ncclIbFrComm* fr = &base->fr;
+  struct ncclIbRequest* f = base->reqs + fr->reqIdx;
+  if (f->type != NCCL_NET_IB_REQ_SEND || !ncclIbFrOutstanding(f) || ncclIbFrFatal(base)) return ncclInternalError;
+  struct ncclIbQp* qp = base->qps;
+  uint32_t qpn = qp->qp->qp_num;
+  int rqDone = 0, rqArrived = 0;
+  NCCLCHECK(ncclIbFrModifyState(qp->qp, IBV_QPS_RESET));
+  NCCLCHECK(ncclIbFrDrainOldQp(base, qpn, fr->reqIdx, &rqDone, &rqArrived));
+  NCCLCHECK(ncclIbFrBringUp(base, qp, peerPsn, fr->myPsn));
+  NCCLCHECK(ncclIbFrReplaySend((struct ncclIbSendComm*)base, f));
+  return ncclSuccess;
+}
+
+// Drives the initiator while it waits for the responder. *proceed = 1 once
+// recovered (the caller then polls normally for the replay's completion).
+static ncclResult_t ncclIbFrInitiatorStep(struct ncclIbNetCommBase* base, int* proceed) {
+  struct ncclIbFrComm* fr = &base->fr;
+  *proceed = 0;
+  ncclIbFrTxProgress(base);
+  // Deadline and async-fatal state are checked BEFORE acting on a buffered reply: a
+  // late ACK is never used (the responder's DONE deadline is 2x ours, see below).
+  if (clockNano() > fr->deadline) {
+    WARN("NET/IB: [FAULT-RECOVERY] initiator: no ACK/NACK within %ld ms (NCCL_RDMA_FAULT_HANDSHAKE_MS) -> stock error", (long)ncclParamRdmaFaultHandshakeMs());
+    ncclIbFrFail(base, 9, 1);
+    return ncclRemoteError;
+  }
+  if (ncclIbFrFatal(base)) {
+    WARN("NET/IB: [FAULT-RECOVERY] initiator: async fatal event during the handshake -> stock error");
+    ncclIbFrFail(base, 5, 1);
+    return ncclRemoteError;
+  }
+  if (ncclIbFrRxProgress(base)) {
+    struct ncclIbFrMsg* m = &fr->rx;
+    if (m->magic != NCCL_IB_FR_MAGIC) {
+      WARN("NET/IB: [FAULT-RECOVERY] initiator: bad message magic 0x%x (stream desynchronized)", m->magic);
+      ncclIbFrFail(base, 10, 0);
+      fr->peerClosed = 1;
+      return ncclRemoteError;
+    }
+    if (m->type == ncclIbFrMsgFail) { WARN("NET/IB: [FAULT-RECOVERY] initiator: peer reported failure (%s)", ncclIbFrReasonStr(m->reason)); ncclIbFrFail(base, 11, 0); return ncclRemoteError; }
+    if (m->seq != fr->seq) { WARN("NET/IB: [FAULT-RECOVERY] initiator: reply seq %u != %u", m->seq, fr->seq); ncclIbFrFail(base, 10, 1); return ncclRemoteError; }
+    if (m->type == ncclIbFrMsgNack) {
+      WARN("NET/IB: [FAULT-RECOVERY] initiator: responder NACK (%s): nothing was reset on either side -> stock error", ncclIbFrReasonStr(m->reason));
+      ncclIbFrFail(base, m->reason, 0);
+      return ncclRemoteError;
+    }
+    if (m->type != ncclIbFrMsgAck || m->nqps != 1 || m->fifoIdx != base->reqs[fr->reqIdx].send.fifoIdx) {
+      WARN("NET/IB: [FAULT-RECOVERY] initiator: unexpected reply type %u nqps %u fifoIdx %lu", m->type, m->nqps, (unsigned long)m->fifoIdx);
+      ncclIbFrFail(base, 10, 1);
+      return ncclRemoteError;
+    }
+    ncclResult_t rr = ncclIbFrInitiatorComplete(base, m->psn);
+    if (rr != ncclSuccess) {
+      WARN("NET/IB: [FAULT-RECOVERY] initiator: QP reset/replay failed (rc=%d) after ACK", rr);
+      ncclIbFrFail(base, 12, 1);
+      return ncclRemoteError;
+    }
+    ncclIbFrSend(base, ncclIbFrMsgDone, fr->seq, 0, 0, 0, 0);
+    fr->state = ncclIbFrIdle;
+    struct ncclIbRequest* f = base->reqs + fr->reqIdx;
+    WARN("NET/IB: [FAULT-RECOVERY] initiator: recovered (seq %u): QP re-driven RESET->INIT->RTR(rq_psn=0x%x)->RTS(sq_psn=0x%x) with connect-time attributes; replayed WRITE_WITH_IMM size=%d -> remoteAddr=0x%lx",
+         fr->seq, m->psn, fr->myPsn, f->send.size, (unsigned long)f->send.remoteAddr);
+    *proceed = 1;
+    return ncclSuccess;
+  }
+  if (fr->peerClosed) { WARN("NET/IB: [FAULT-RECOVERY] initiator: peer socket closed during handshake"); ncclIbFrFail(base, 10, 0); return ncclRemoteError; }
+  return ncclSuccess;
+}
+
+// Send comm outside a handshake: keep flushing a pending DONE/FAIL and watch for a FAIL
+// from the responder (e.g. it timed out waiting for DONE), so both sides always latch
+// together. Any other message here is a protocol error.
+static void ncclIbFrInitiatorIdle(struct ncclIbNetCommBase* base) {
+  struct ncclIbFrComm* fr = &base->fr;
+  ncclIbFrTxProgress(base);
+  if (!ncclIbFrRxProgress(base)) return;
+  struct ncclIbFrMsg* m = &fr->rx;
+  if (m->magic == NCCL_IB_FR_MAGIC && m->type == ncclIbFrMsgFail) {
+    WARN("NET/IB: [FAULT-RECOVERY] initiator: peer reported failure (%s)", ncclIbFrReasonStr(m->reason));
+    ncclIbFrFail(base, 11, 0);
+  } else {
+    WARN("NET/IB: [FAULT-RECOVERY] initiator: unexpected message (magic 0x%x type %u) while idle", m->magic, m->type);
+    ncclIbFrFail(base, 10, 0);
+    fr->peerClosed = 1;  // stream no longer trusted
+  }
+}
+
+// ---- responder (recv comm) --------------------------------------------------
+// Reset the recv comm's QP and re-post exactly receive ridx (see the protocol above).
+static ncclResult_t ncclIbFrResponderReset(struct ncclIbNetCommBase* base, int ridx, int* arrivedBeforeReset) {
+  struct ncclIbFrComm* fr = &base->fr;
+  struct ncclIbRequest* r = base->reqs + ridx;
+  struct ncclIbQp* qp = base->qps;
+  uint32_t qpn = qp->qp->qp_num;
+  int rqDone = 0, rqArrived = 0;
+  // Stop accepting packets; the HCA flushes the posted WQEs.
+  NCCLCHECK(ncclIbFrModifyState(qp->qp, IBV_QPS_ERR));
+  // Wait (bounded) until this receive's WQE terminated: RQ completions are in order,
+  // so every earlier receive completion is then in the CQ and consumed, before RESET
+  // (which on mlx5 also removes the QP's remaining CQEs from the CQ).
+  // Flush CQEs appear within microseconds; this busy-poll (it runs on the proxy thread)
+  // is capped at min(HANDSHAKE_MS/10, 100 ms).
+  uint64_t t0 = clockNano();
+  int64_t limMs = ncclParamRdmaFaultHandshakeMs() / 10;
+  uint64_t lim = ncclIbFrMs(limMs < 100 ? limMs : 100);
+  while (!rqDone) {
+    NCCLCHECK(ncclIbFrDrainOldQp(base, qpn, ridx, &rqDone, &rqArrived));
+    if (!rqDone && clockNano() - t0 > lim) {
+      WARN("NET/IB: [FAULT-RECOVERY] responder: receive WQE did not terminate within %lu ms after QP->ERR", (unsigned long)(lim/1000000));
+      return ncclSystemError;
+    }
+  }
+  NCCLCHECK(ncclIbFrModifyState(qp->qp, IBV_QPS_RESET));
+  // mlx5 already removed this QP's remaining CQEs; this catches any a provider leaves in
+  // the CQ. ridx's RQ WQE has already produced its one CQE above, so nothing the device
+  // could still write for the old QP can complete the receive re-posted below (a late
+  // CTS flush is an error CQE: dropped here, or a new fault -> latch, never a completion).
+  NCCLCHECK(ncclIbFrDrainOldQp(base, qpn, ridx, &rqDone, &rqArrived));
+  fr->myPsn = ncclIbFrFreshPsn(qpn);
+  NCCLCHECK(ncclIbFrBringUp(base, qp, fr->req.psn, fr->myPsn));
+  // Re-post exactly this receive; its only expected completion is now the replay
+  // (a signaled CTS completion it may have been waiting for was dropped above).
+  struct ibv_recv_wr wr;
+  memset(&wr, 0, sizeof(wr));
+  wr.wr_id = NCCL_IB_FR_WRID_RQ | (uint64_t)ridx;
+  wr.sg_list = NULL;
+  wr.num_sge = 0;
+  struct ibv_recv_wr* bad;
+  NCCLCHECK(wrap_ibv_post_recv(qp->qp, &wr, &bad));
+  r->events[0] = r->events[1] = 0;
+  ncclIbAddEvent(r, qp->devIndex, ncclIbGetNetCommDevBase(base, qp->devIndex));
+  r->frReplays++;
+  *arrivedBeforeReset = rqArrived;
+  return ncclSuccess;
+}
+
+// Evaluate a pending REQ (condition 3/4 for the responder); ACK or NACK it, or keep
+// it pending (bounded) while only a GPU-flush read is in flight.
+static void ncclIbFrResponderEvaluate(struct ncclIbNetCommBase* base) {
+  struct ncclIbFrComm* fr = &base->fr;
+  struct ncclIbFrMsg* q = &fr->req;
+  fr->errCount = 0;
+  ncclResult_t dr = ncclIbFrDrainAll(base);  // consume what is already in the CQ first
+  const char* why = NULL;
+  uint32_t reason = 0;
+  int ridx = -1, wait = 0;
+  if (dr != ncclSuccess || fr->errCount) { why = "responder has its own error CQE(s)"; reason = 6; }
+  else if (q->nqps != 1 || base->nqps != 1 || base->ndevs != 1) { why = "multi-QP / multi-NIC"; reason = 4; }
+  else if (ncclIbFrFatal(base)) { why = "async fatal event on comm/device"; reason = 5; }
+  else {
+    int nOther = 0, nFlush = 0;
+    for (int i = 0; i < MAX_REQUESTS; i++) {
+      struct ncclIbRequest* r = base->reqs + i;
+      if (!ncclIbFrOutstanding(r)) continue;
+      if (r->type == NCCL_NET_IB_REQ_RECV && r->recv.fifoIdx == q->fifoIdx && ridx < 0) { ridx = i; continue; }
+      if (r->type == NCCL_NET_IB_REQ_FLUSH) nFlush++; else nOther++;
+    }
+    struct ncclIbRequest* r = (ridx >= 0) ? base->reqs + ridx : NULL;
+    if (r == NULL) { why = "no outstanding receive matches the failed send"; reason = 2; }
+    else if (nOther) { why = "other requests in flight (not quiescent)"; reason = 1; }
+    else if (r->nreqs != 1) { why = "multi-recv"; reason = 4; }
+    else if (r->recv.arrived) { why = "receive data already consumed"; reason = 3; }
+    else if (q->size < 0 || q->size > r->recv.postedSize) { why = "size mismatch"; reason = 14; }
+    else if (r->frReplays >= NCCL_IB_FR_MAX_REPLAYS) { why = "receive already re-posted once"; reason = 13; }
+    else if (nFlush) wait = 1;
+  }
+  fr->errCount = 0;
+  if (!why && wait) {
+    if (clockNano() < fr->deadline) return;  // re-evaluated on the next call
+    why = "GPU-flush read still in flight at the deadline"; reason = 7;
+  }
+  if (why) {
+    WARN("NET/IB: [FAULT-RECOVERY] responder: NACK seq %u (%s); nothing reset -> stock error", q->seq, why);
+    ncclIbFrFail(base, reason, 0);  // sends the NACK (state is RespPending)
+    return;
+  }
+  int arrived = 0;
+  ncclResult_t rr = ncclIbFrResponderReset(base, ridx, &arrived);
+  if (rr != ncclSuccess) {
+    WARN("NET/IB: [FAULT-RECOVERY] responder: QP reset/re-post failed (rc=%d)", rr);
+    ncclIbFrFail(base, 8, 0);  // NACK
+    return;
+  }
+  ncclIbFrSend(base, ncclIbFrMsgAck, q->seq, q->fifoIdx, fr->myPsn, q->size, 0);
+  fr->state = ncclIbFrRespAcked;
+  fr->reqIdx = ridx;
+  fr->attempts++;
+  // 2x the initiator's deadline: the initiator acts on the ACK only before its own
+  // deadline (measured from its REQ, which precedes this ACK), so a DONE it sends always
+  // arrives before this expires unless the socket itself stalls.
+  fr->deadline = clockNano() + 2*ncclIbFrMs(ncclParamRdmaFaultHandshakeMs());
+  WARN("NET/IB: [FAULT-RECOVERY] responder: quiescent (req %d fifoIdx %lu): QP ->ERR->RESET->INIT->RTR(rq_psn=0x%x)->RTS(sq_psn=0x%x), receive re-posted%s, ACK seq %u sent",
+       ridx, (unsigned long)q->fifoIdx, q->psn, fr->myPsn, arrived ? " (data had landed before the reset; the replay rewrites the same bytes)" : "", q->seq);
+}
+
+// Socket service + state machine of a recovery-enabled recv comm. Called on every
+// ncclIbTest (any request type) and ncclIbIrecv, independently of the attempt cap.
+// Returns ncclRemoteError once the comm is latched FAILED.
+static ncclResult_t ncclIbFrResponderService(struct ncclIbNetCommBase* base) {
+  struct ncclIbFrComm* fr = &base->fr;
+  ncclIbFrTxProgress(base);
+  for (int k = 0; k < 4 && ncclIbFrRxProgress(base); k++) {
+    struct ncclIbFrMsg* m = &fr->rx;
+    if (m->magic != NCCL_IB_FR_MAGIC) {
+      WARN("NET/IB: [FAULT-RECOVERY] responder: bad message magic 0x%x (stream desynchronized; control channel abandoned)", m->magic);
+      ncclIbFrFail(base, 10, 0);
+      fr->peerClosed = 1;  // stop all further I/O on the channel
+      break;
+    }
+    if (m->type == ncclIbFrMsgReq) {
+      if (fr->state == ncclIbFrFailed) { ncclIbFrSend(base, ncclIbFrMsgNack, m->seq, 0, 0, 0, 11); continue; }
+      if (fr->state != ncclIbFrIdle) { WARN("NET/IB: [FAULT-RECOVERY] responder: REQ in state %d", fr->state); fr->seq = m->seq; ncclIbFrFail(base, 10, 1); continue; }
+      fr->req = *m;
+      fr->seq = m->seq;
+      fr->state = ncclIbFrRespPending;
+      fr->deadline = clockNano() + ncclIbFrMs(ncclParamRdmaFaultHandshakeMs() / 4);
+      WARN("NET/IB: [FAULT-RECOVERY] responder: RECOVER_REQ seq %u received (fifoIdx %lu size %d nqps %u)", m->seq, (unsigned long)m->fifoIdx, m->size, m->nqps);
+    } else if (m->type == ncclIbFrMsgDone) {
+      if (fr->state == ncclIbFrRespAcked && m->seq == fr->seq) {
+        fr->state = ncclIbFrIdle;
+        INFO(NCCL_NET, "NET/IB: [FAULT-RECOVERY] responder: DONE seq %u (initiator replayed)", m->seq);
+      } else if (fr->state != ncclIbFrFailed) {
+        WARN("NET/IB: [FAULT-RECOVERY] responder: unexpected DONE seq %u in state %d", m->seq, fr->state);
+        ncclIbFrFail(base, 10, 1);
+      }
+    } else if (m->type == ncclIbFrMsgFail) {
+      if (fr->state != ncclIbFrFailed) WARN("NET/IB: [FAULT-RECOVERY] responder: initiator reported failure (%s)", ncclIbFrReasonStr(m->reason));
+      ncclIbFrFail(base, 11, 0);
+    } else {
+      WARN("NET/IB: [FAULT-RECOVERY] responder: unexpected message type %u", m->type);
+      ncclIbFrFail(base, 10, 1);
+    }
+  }
+  if (fr->state == ncclIbFrRespPending) {
+    if (fr->peerClosed) { WARN("NET/IB: [FAULT-RECOVERY] responder: peer socket closed during handshake"); ncclIbFrFail(base, 10, 0); }
+    else ncclIbFrResponderEvaluate(base);
+  }
+  if (fr->state == ncclIbFrRespAcked) {
+    if (fr->peerClosed) { WARN("NET/IB: [FAULT-RECOVERY] responder: peer socket closed before DONE"); ncclIbFrFail(base, 10, 0); }
+    else if (clockNano() > fr->deadline) { WARN("NET/IB: [FAULT-RECOVERY] responder: no DONE within %ld ms", 2*(long)ncclParamRdmaFaultHandshakeMs()); ncclIbFrFail(base, 9, 1); }
+  }
+  return (fr->state == ncclIbFrFailed) ? ncclRemoteError : ncclSuccess;
+}
+
+// Entry point from ncclIbTest for recovery-enabled comms. *proceed = 0 means "report
+// not-done without polling" (initiator waiting for the responder).
+static ncclResult_t ncclIbFrPreTest(struct ncclIbNetCommBase* base, int* proceed) {
+  *proceed = 1;
+  if (!base->isSend) return ncclIbFrResponderService(base);
+  if (base->fr.state == ncclIbFrInitWait) NCCLCHECK(ncclIbFrInitiatorStep(base, proceed));
+  else if (base->fr.state == ncclIbFrIdle) ncclIbFrInitiatorIdle(base);
+  if (base->fr.state == ncclIbFrFailed) { ncclIbFrTxProgress(base); return ncclRemoteError; }
+  return ncclSuccess;
+}
