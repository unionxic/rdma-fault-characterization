+/* =====================================================================
+ * [RDMA-FAULT-RECOVERY] In-tree fault classification + QP-level recovery.
+ *
+ * Ported from ~/rdma-error/harness/common/probe.c classify(): on a failed
+ * IB completion we map (wc.status, wc.vendor_err) to a cause / recommended
+ * action / peer-liveness / auto-recoverable verdict, then (for NAK-class,
+ * auto-recoverable faults) attempt to re-drive the affected QP through
+ * ERR->RESET->INIT->RTR->RTS so the QP object is left usable instead of the
+ * communicator failing outright. All of this is OFF unless
+ * NCCL_RDMA_FAULT_RECOVERY=1, so default NCCL behavior is preserved.
+ *
+ * Bounded honesty note (see nccl-integration/README): re-driving the local QP
+ * cannot by itself transparently resume an in-flight RC transfer -- the remote
+ * QP's PSN state is not reset in lockstep and the failed WR is not replayed,
+ * because NCCL's mid-stream IB path has no bilateral re-handshake channel. So
+ * this restores QP usability + emits full diagnostics; it does not fabricate a
+ * completed transfer. RETRY_EXC (dead peer) is classed non-auto-recoverable and
+ * falls through to the normal error, matching the harness taxonomy.
+ * ===================================================================== */
+NCCL_PARAM(RdmaFaultRecovery, "RDMA_FAULT_RECOVERY", 0);
+// [phase 3] NCCL_RDMA_FAULT_INJECT=k: force the send QP to ERR exactly once, on
+// the k-th signaled multi-send (a transient, peer-alive, RECOVERABLE flush).
+NCCL_PARAM(RdmaFaultInject, "RDMA_FAULT_INJECT", 0);
+static int ncclIbInjectSendCount = 0;   // signaled sends seen (debug hook only)
+static int ncclIbInjectFired = 0;        // latch: inject at most once
+#define NCCL_IB_FAULT_MAX_ATTEMPTS 3   // per-comm cap on recovery attempts
+#define NCCL_IB_FAULT_MAX_RETRIES  8   // per-request cap on post-recovery re-polls
+#define NCCL_IB_RECOVER_MAGIC 0xFA017EC0u
+
+// Recovery control message, exchanged on the always-open OOB base.sock. psn[q] is
+// the sender's fresh base PSN for QP q (both REQ and ACK use this layout).
+struct ncclIbRecoverMsg {
+  uint32_t magic;
+  int      nqps;
+  uint32_t psn[NCCL_IB_MAX_QPS];
+};
+
+struct ncclIbFaultInfo {
+  const char* cause;
+  const char* action;
+  int peerAlive;         // best-effort; see RETRY_EXC note
+  int autoRecoverable;   // 1 => attempt QP-level recovery
+};
+
+// Self-contained status name (NCCL loads libibverbs symbols via wrap_*; we avoid
+// taking a direct dependency on ibv_wc_status_str for the few statuses we log).
+static const char* ncclIbStatusStr(int status) {
+  switch (status) {
+    case IBV_WC_SUCCESS:           return "SUCCESS";
+    case IBV_WC_LOC_LEN_ERR:       return "LOC_LEN_ERR";
+    case IBV_WC_LOC_PROT_ERR:      return "LOC_PROT_ERR";
+    case IBV_WC_WR_FLUSH_ERR:      return "WR_FLUSH_ERR";
+    case IBV_WC_REM_INV_REQ_ERR:   return "REM_INV_REQ_ERR";
+    case IBV_WC_REM_ACCESS_ERR:    return "REM_ACCESS_ERR";
+    case IBV_WC_RETRY_EXC_ERR:     return "RETRY_EXC_ERR";
+    case IBV_WC_RNR_RETRY_EXC_ERR: return "RNR_RETRY_EXC_ERR";
+    default:                       return "OTHER";
+  }
+}
+
+// Mirror of harness classify() over the meaningful RoCE completion faults.
+static struct ncclIbFaultInfo ncclIbClassify(enum ibv_wc_status status, uint32_t vendor_err) {
+  struct ncclIbFaultInfo f = { "unknown", "inspect status+vendor_err", 1, 0 };
+  switch (status) {
+    case IBV_WC_WR_FLUSH_ERR: /* 5 / 0xf5 */
+      f.cause = "WR flushed (local QP left RTS, e.g. forced ERR / drained after a prior fault)";
+      f.action = "drain CQ, QP-only recover, repost"; f.peerAlive = 1; f.autoRecoverable = 1; break;
+    case IBV_WC_REM_ACCESS_ERR: /* 10 / 0x88 */
+      f.cause = (vendor_err == 0x88) ? "remote access: invalid rkey or out-of-bounds addr"
+                                     : "remote access violation";
+      f.action = "refresh rkey / clamp to remote MR bounds, QP-only recover";
+      f.peerAlive = 1; f.autoRecoverable = 1; break;
+    case IBV_WC_REM_INV_REQ_ERR: /* 9 / 0x8a */
+      f.cause = "remote invalid request (malformed WR / len / opcode)";
+      f.action = "fix request params, QP-only recover"; f.peerAlive = 1; f.autoRecoverable = 1; break;
+    case IBV_WC_RNR_RETRY_EXC_ERR: /* 13 / 0x87 */
+      f.cause = "RNR retries exhausted (responder had no recv WQE)";
+      f.action = "ensure remote posts recvs, QP-only recover"; f.peerAlive = 1; f.autoRecoverable = 1; break;
+    case IBV_WC_RETRY_EXC_ERR: /* 12 / 0x81 */
+      f.cause = "transport retries exhausted (no ACK): responder QP in ERR, process dead, or link down";
+      f.action = "probe peer liveness (responder port_xmit_packets, external); if dead -> human intervention, else QP-only";
+      f.peerAlive = 0; f.autoRecoverable = 0; break;
+    case IBV_WC_LOC_PROT_ERR: /* 4 */
+      f.cause = "local protection (bad lkey / local MR bounds)";
+      f.action = "fix local MR/lkey, QP-only recover"; f.peerAlive = 1; f.autoRecoverable = 1; break;
+    case IBV_WC_LOC_LEN_ERR: /* 1 */
+      f.cause = "local length error"; f.action = "fix SGE length, QP-only recover";
+      f.peerAlive = 1; f.autoRecoverable = 1; break;
+    default:
+      f.cause = "other"; f.action = "inspect status+vendor_err"; f.peerAlive = 1; f.autoRecoverable = 0; break;
+  }
+  return f;
+}
+
+// ---------------------------------------------------------------------------
+// TRUE bilateral recovery: send side = INITIATOR, recv side = RESPONDER (role by
+// base.isSend, so a comm pair never double-initiates). Both ends drive their QPs
+// ERR->RESET->INIT->RTR->RTS with PSNs exchanged over base.sock so the two ends
+// stay mutually consistent (the correctness the unilateral re-drive lacked).
+// ---------------------------------------------------------------------------
+
+// Forward decls (definitions appear later in this file): the per-dev CQ/pd/gid
+// accessor and the IB_SPLIT_DATA_ON_QPS param, both used by the helpers below.
+struct ncclIbNetCommDevBase* ncclIbGetNetCommDevBase(ncclIbNetCommBase* base, int devIndex);
+int64_t ncclParamIbSplitDataOnQps();
+
+// Deterministic fresh, non-zero 24-bit PSN seed per (attempt,q). Exact value is
+// irrelevant (the real PSNs are exchanged in the message); it only needs to be
+// fresh vs the pre-fault PSN so a straggler packet cannot be mistaken for valid.
+static inline uint32_t ncclIbFreshPsn(int attempt, int q) {
+  return (0x000A0000u * (uint32_t)(attempt + 1) + 0x101u * (uint32_t)(q + 1)) & 0xFFFFFFu;
+}
+
+// Drain any lingering CQEs (e.g. stale FLUSH_ERR from the just-errored QP) so they
+// are not re-read as fresh faults after recovery. Assumes the faulted request is
+// the only op in flight on this comm's CQ(s) -- true for 1 op/comm at a time, as
+// in the tested all-reduce; concurrent multiplexed requests are out of scope.
+static void ncclIbDrainCqs(struct ncclIbNetCommBase* base) {
+  struct ibv_wc wcs[4];
+  for (int q = 0; q < base->nqps; q++) {
+    struct ncclIbQp* qp = base->qps + q;
+    if (qp->qp == NULL) continue;
+    struct ncclIbNetCommDevBase* db = ncclIbGetNetCommDevBase(base, qp->devIndex);
+    int n; do { n = 0; wrap_ibv_poll_cq(db->cq, 4, wcs, &n); } while (n > 0);
+  }
+}
+
+// ERR->RESET->INIT for every QP on this comm; fill myPsn[q] with fresh PSNs, then
+// drain the CQs. Local qp_num is preserved across RESET, so the peer still targets us.
+static ncclResult_t ncclIbResetQpsToInit(struct ncclIbNetCommBase* base, uint32_t* myPsn, int attempt) {
+  for (int q = 0; q < base->nqps; q++) {
+    struct ncclIbQp* qp = base->qps + q;
+    if (qp->qp == NULL) continue;
+    struct ncclIbNetCommDevBase* db = ncclIbGetNetCommDevBase(base, qp->devIndex);
+    uint8_t ib_port = ncclIbDevs[db->ibDevN].portNum;
+    struct ibv_qp_attr a;
+    memset(&a, 0, sizeof(a)); a.qp_state = IBV_QPS_RESET;
+    NCCLCHECK(wrap_ibv_modify_qp(qp->qp, &a, IBV_QP_STATE));
+    memset(&a, 0, sizeof(a));
+    a.qp_state = IBV_QPS_INIT; a.pkey_index = ncclParamIbPkey(); a.port_num = ib_port;
+    a.qp_access_flags = IBV_ACCESS_LOCAL_WRITE | IBV_ACCESS_REMOTE_WRITE | IBV_ACCESS_REMOTE_READ;
+    NCCLCHECK(wrap_ibv_modify_qp(qp->qp, &a, IBV_QP_STATE | IBV_QP_PKEY_INDEX | IBV_QP_PORT | IBV_QP_ACCESS_FLAGS));
+    myPsn[q] = ncclIbFreshPsn(attempt, q);
+  }
+  ncclIbDrainCqs(base);
+  return ncclSuccess;
+}
+
+// INIT->RTR(rq_psn = peerPsn[q]) ->RTS(sq_psn = myPsn[q]) for every QP, so this
+// end receives on the peer's send-PSN and sends on its own -- symmetric on both ends.
+static ncclResult_t ncclIbCompleteQps(struct ncclIbNetCommBase* base, uint32_t* myPsn, uint32_t* peerPsn) {
+  for (int q = 0; q < base->nqps; q++) {
+    struct ncclIbQp* qp = base->qps + q;
+    if (qp->qp == NULL) continue;
+    struct ncclIbNetCommDevBase* db = ncclIbGetNetCommDevBase(base, qp->devIndex);
+    struct ncclIbDevInfo* remDevInfo = base->remDevs + qp->remDevIdx;
+    NCCLCHECK(ncclIbRtrQp(qp->qp, &db->gidInfo, qp->remQpn, remDevInfo, false, peerPsn[q]));
+    NCCLCHECK(ncclIbRtsQp(qp->qp, myPsn[q]));
+  }
+  return ncclSuccess;
+}
+
+// INITIATOR (send side): reset -> send REQ{myPsn} -> recv ACK{peerPsn} -> RTR/RTS.
+// Any socket failure (dead peer) surfaces here => caller fails cleanly.
+static ncclResult_t ncclIbRecoverInitiate(struct ncclIbNetCommBase* base, int attempt) {
+  uint32_t myPsn[NCCL_IB_MAX_QPS]; memset(myPsn, 0, sizeof(myPsn));
+  NCCLCHECK(ncclIbResetQpsToInit(base, myPsn, attempt));
+  struct ncclIbRecoverMsg req; memset(&req, 0, sizeof(req));
+  req.magic = NCCL_IB_RECOVER_MAGIC; req.nqps = base->nqps;
+  for (int q = 0; q < base->nqps; q++) req.psn[q] = myPsn[q];
+  NCCLCHECK(ncclSocketSend(&base->sock, &req, sizeof(req)));
+  struct ncclIbRecoverMsg ack; memset(&ack, 0, sizeof(ack));
+  NCCLCHECK(ncclSocketRecv(&base->sock, &ack, sizeof(ack)));
+  if (ack.magic != NCCL_IB_RECOVER_MAGIC || ack.nqps != base->nqps) {
+    WARN("NET/IB: [FAULT-RECOVERY] bad RECOVER_ACK (magic=0x%x nqps=%d)", ack.magic, ack.nqps);
+    return ncclSystemError;
+  }
+  NCCLCHECK(ncclIbCompleteQps(base, myPsn, ack.psn));
+  INFO(NCCL_NET, "NET/IB: [FAULT-RECOVERY] initiator: bilateral PSN-consistent reset complete (nqps=%d)", base->nqps);
+  return ncclSuccess;
+}
+
+// forward decl (defined below): re-post the flushed recv WQE(s) for request r.
+static ncclResult_t ncclIbRepostRecv(struct ncclIbRecvComm* comm, struct ncclIbRequest* r);
+
+// RESPONDER (recv side): given an already-read REQ, reset -> RTR/RTS(using peer's
+// PSNs) -> re-post recv WQE -> send ACK{myPsn}. The recv WQE is re-posted BEFORE
+// the ACK so the initiator's replayed WRITE (sent only after it sees our ACK)
+// always finds a posted receive (closes the RNR window).
+static ncclResult_t ncclIbRecoverRespond(struct ncclIbRecvComm* comm, struct ncclIbRequest* r,
+                                         struct ncclIbRecoverMsg* reqMsg, int attempt) {
+  struct ncclIbNetCommBase* base = &comm->base;
+  uint32_t myPsn[NCCL_IB_MAX_QPS]; memset(myPsn, 0, sizeof(myPsn));
+  NCCLCHECK(ncclIbResetQpsToInit(base, myPsn, attempt));
+  NCCLCHECK(ncclIbCompleteQps(base, myPsn, reqMsg->psn));
+  NCCLCHECK(ncclIbRepostRecv(comm, r));
+  struct ncclIbRecoverMsg ack; memset(&ack, 0, sizeof(ack));
+  ack.magic = NCCL_IB_RECOVER_MAGIC; ack.nqps = base->nqps;
+  for (int q = 0; q < base->nqps; q++) ack.psn[q] = myPsn[q];
+  NCCLCHECK(ncclSocketSend(&base->sock, &ack, sizeof(ack)));
+  INFO(NCCL_NET, "NET/IB: [FAULT-RECOVERY] responder: bilateral PSN-consistent reset + recv repost + ACK done (nqps=%d)", base->nqps);
+  return ncclSuccess;
+}
+
+// Responder that reached the ERROR branch (its own QP flushed): bounded wait for
+// the initiator's REQ on base.sock, then respond. Used only in symmetric faults;
+// the common transient case is handled by the non-blocking peek in ncclIbTest.
+static ncclResult_t ncclIbRecoverRespondWait(struct ncclIbRecvComm* comm, struct ncclIbRequest* r, int attempt) {
+  struct ncclIbRecoverMsg reqMsg; int closed = 0;
+  for (int spins = 0; spins < 100000; spins++) {
+    ncclResult_t pr = ncclSocketTryRecv(&comm->base.sock, &reqMsg, sizeof(reqMsg), &closed, false);
+    if (closed) { WARN("NET/IB: [FAULT-RECOVERY] responder-wait: peer socket closed"); return ncclRemoteError; }
+    if (pr == ncclSuccess) {
+      if (reqMsg.magic != NCCL_IB_RECOVER_MAGIC) return ncclSystemError;
+      return ncclIbRecoverRespond(comm, r, &reqMsg, attempt);
+    }
+    if (pr != ncclInProgress) return pr;   // real socket error
+  }
+  WARN("NET/IB: [FAULT-RECOVERY] responder-wait: timed out waiting for RECOVER_REQ");
+  return ncclSystemError;
+}
+
+// [phase 2] Replay a flushed single-request send: re-post a signaled
+// RDMA_WRITE_WITH_IMM (idempotent) with the saved remote addr/rkey on QP 0, and
+// reset the request's event count to the single completion this will produce.
+static ncclResult_t ncclIbReplaySend(struct ncclIbSendComm* comm, struct ncclIbRequest* r) {
+  if (!r->send.recoverable) { WARN("NET/IB: [FAULT-RECOVERY] send not replayable (nreqs>1)"); return ncclSystemError; }
+  struct ncclIbQp* qp = comm->base.qps + 0;
+  int devIndex = qp->devIndex;
+  struct ibv_sge sge; memset(&sge, 0, sizeof(sge));
+  struct ibv_send_wr wr; memset(&wr, 0, sizeof(wr));
+  sge.addr = (uintptr_t)r->send.data; sge.length = r->send.size; sge.lkey = r->send.lkeys[devIndex];
+  wr.wr_id = (uint64_t)(r - comm->base.reqs);
+  wr.sg_list = r->send.size ? &sge : NULL;
+  wr.num_sge = r->send.size ? 1 : 0;
+  wr.opcode = IBV_WR_RDMA_WRITE_WITH_IMM;
+  wr.imm_data = r->send.size;
+  wr.wr.rdma.remote_addr = r->send.remoteAddr;
+  wr.wr.rdma.rkey = r->send.rkeys[qp->remDevIdx];
+  wr.send_flags = IBV_SEND_SIGNALED;
+  wr.next = NULL;
+  r->events[0] = r->events[1] = 0;
+  r->send.offset = 0;
+  struct ibv_send_wr* bad;
+  NCCLCHECK(wrap_ibv_post_send(qp->qp, &wr, &bad));
+  ncclIbAddEvent(r, devIndex, &comm->devs[devIndex].base);
+  INFO(NCCL_NET, "NET/IB: [FAULT-RECOVERY] replayed WRITE_WITH_IMM size=%d -> remoteAddr=0x%lx rkey=0x%x",
+       r->send.size, (unsigned long)r->send.remoteAddr, wr.wr.rdma.rkey);
+  return ncclSuccess;
+}
+
+// [phase 2] Re-post the flushed recv WQE(s) for request r on its QP(s), resetting
+// its event count to the completions the replayed WRITE_WITH_IMM will produce.
+static ncclResult_t ncclIbRepostRecv(struct ncclIbRecvComm* comm, struct ncclIbRequest* r) {
+  struct ibv_recv_wr wr; memset(&wr, 0, sizeof(wr));
+  wr.wr_id = (uint64_t)(r - comm->base.reqs); wr.sg_list = NULL; wr.num_sge = 0;
+  const int nqps = ncclParamIbSplitDataOnQps() ? comm->base.nqps : comm->base.ndevs;
+  r->events[0] = r->events[1] = 0;
+  int qpIndex = comm->base.qpIndex;
+  for (int i = 0; i < nqps; i++) {
+    struct ncclIbQp* qp = comm->base.qps + qpIndex;
+    struct ibv_recv_wr* bad;
+    NCCLCHECK(wrap_ibv_post_recv(qp->qp, &wr, &bad));
+    ncclIbAddEvent(r, qp->devIndex, &comm->devs[qp->devIndex].base);
+    qpIndex = (qpIndex + 1) % comm->base.nqps;
+  }
+  INFO(NCCL_NET, "NET/IB: [FAULT-RECOVERY] reposted recv WQE (wr_id=%ld)", (long)(r - comm->base.reqs));
+  return ncclSuccess;
+}
