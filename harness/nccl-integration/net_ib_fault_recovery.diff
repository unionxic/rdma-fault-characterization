       NCCLCHECKGOTO(wrap_ibv_set_ece(qp, &remQpInfo->ece, &remQpInfo->ece_supported), ret, fail);
 
+    comm->base.qps[q].remQpn = remQpInfo->qpn; // [RDMA-FAULT-RECOVERY] retain for QP re-drive
     NCCLCHECKGOTO(ncclIbRtrQp(qp, &commDev->base.gidInfo, remQpInfo->qpn, remDevInfo, false), ret, fail);
     NCCLCHECKGOTO(ncclIbRtsQp(qp), ret, fail);
   }
@@ -1472,6 +1596,7 @@ ib_recv:
     }
 
     bool override_tc = (q == 0) ? true : false;
+    qp->remQpn = remMeta.qpInfo[q].qpn; // [RDMA-FAULT-RECOVERY] retain for QP re-drive
     NCCLCHECKGOTO(ncclIbRtrQp(qp->qp, &rCommDev->base.gidInfo, remMeta.qpInfo[q].qpn, remDevInfo, override_tc), ret, fail);
     NCCLCHECKGOTO(ncclIbRtsQp(qp->qp), ret, fail);
   }
@@ -2121,6 +2246,32 @@ ncclResult_t ncclIbTest(void* request, int* done, int* sizes) {
             WARN("NET/IB: Got completion from peer %s with status=%d opcode=%d len=%d vendor err %d (%s)%s%s%s%s hca %s",
                 ncclSocketToString(&addr, line), wc->status, wc->opcode, wc->byte_len, wc->vendor_err, reqTypeStr[r->type],
                 localGidStr ?  " localGid ":"", localGidString, remoteGidStr ? " remoteGids":"", remoteGidString, hcaName);
+
+            // [RDMA-FAULT-RECOVERY] classify + (best-effort) QP-level recovery.
+            // Default behavior (flag off) is unchanged: fall straight to ncclRemoteError.
+            if (ncclParamRdmaFaultRecovery()) {
+              struct ncclIbFaultInfo fi = ncclIbClassify((enum ibv_wc_status)wc->status, wc->vendor_err);
+              WARN("NET/IB: [FAULT-RECOVERY] status=%d(%s) vendor_err=0x%x cause='%s' action='%s' peerAlive=%d autoRecoverable=%d",
+                   wc->status, ncclIbStatusStr(wc->status), wc->vendor_err, fi.cause, fi.action, fi.peerAlive, fi.autoRecoverable);
+              if (fi.autoRecoverable && r->base->faultRecoveryAttempts < NCCL_IB_FAULT_MAX_ATTEMPTS) {
+                r->base->faultRecoveryAttempts++;
+                INFO(NCCL_NET, "NET/IB: [FAULT-RECOVERY] auto-recoverable fault: attempting QP re-drive %d/%d on dev %d",
+                     r->base->faultRecoveryAttempts, NCCL_IB_FAULT_MAX_ATTEMPTS, i);
+                if (ncclIbFaultRecoverQp(r->base, r->devBases[i], i) == ncclSuccess &&
+                    r->faultRetries < NCCL_IB_FAULT_MAX_RETRIES) {
+                  // QP object restored to RTS. Give the caller a bounded re-poll
+                  // window (report "not done") rather than tearing down the comm.
+                  // NOTE: the failed WR is NOT replayed and the remote PSN is not
+                  // reset here, so a persistent fault will exhaust the retry cap
+                  // and then fail cleanly -- we never fabricate a completed transfer.
+                  r->faultRetries++;
+                  WARN("NET/IB: [FAULT-RECOVERY] QP re-driven to RTS; bounded re-poll %d/%d (in-flight WR not replayed)",
+                       r->faultRetries, NCCL_IB_FAULT_MAX_RETRIES);
+                  return ncclSuccess;
+                }
+                WARN("NET/IB: [FAULT-RECOVERY] recovery exhausted/failed; failing communicator cleanly");
+              }
+            }
             return ncclRemoteError;
           }
 
