+// [RDMA-FAULT-RECOVERY Stage 2] entry points: with recovery on, every call runs under the comm's lock
+// (trylock for isend/irecv: a NULL request makes NCCL retry; iflush must not return NULL spuriously,
+// so it waits). A comm FAILED by the async-fatal check sends FAIL before the stock check returns.
+static ncclResult_t fr2Enter(struct ncclIbNetCommBase* base) {
+  struct ncclIbFr2* fr = base->fr;
+  if (fr->state != FR2_FAILED && fr2Fatal(base)) fr2Fail(base, FR2_R_FATAL, 1);
+  if (fr->state == FR2_FAILED) { fr2ServiceFailed(base); return ncclRemoteError; }
+  return ncclSuccess;
+}
+
+ncclResult_t ncclIbIsend(void* sendComm, void* data, int size, int tag, void* mhandle, void** request) {
+  struct ncclIbSendComm* comm = (struct ncclIbSendComm*)sendComm;
+  struct ncclIbFr2* fr = comm->base.fr;
+  if (fr == NULL) return ncclIbIsendBody(sendComm, data, size, tag, mhandle, request);
+  if (pthread_mutex_trylock(&fr->lock) != 0) { *request = NULL; return ncclSuccess; }
+  ncclResult_t res = fr2Enter(&comm->base);
+  if (res == ncclSuccess) res = ncclIbIsendBody(sendComm, data, size, tag, mhandle, request);
+  pthread_mutex_unlock(&fr->lock);
+  return res;
+}
+
+ncclResult_t ncclIbIrecv(void* recvComm, int n, void** data, int* sizes, int* tags, void** mhandles, void** request) {
+  struct ncclIbRecvComm* comm = (struct ncclIbRecvComm*)recvComm;
+  struct ncclIbFr2* fr = comm->base.fr;
+  if (fr == NULL) return ncclIbIrecvBody(recvComm, n, data, sizes, tags, mhandles, request);
+  if (pthread_mutex_trylock(&fr->lock) != 0) { *request = NULL; return ncclSuccess; }
+  ncclResult_t res = fr2Enter(&comm->base);
+  if (res == ncclSuccess) res = ncclIbIrecvBody(recvComm, n, data, sizes, tags, mhandles, request);
+  pthread_mutex_unlock(&fr->lock);
+  return res;
+}
+
+ncclResult_t ncclIbIflush(void* recvComm, int n, void** data, int* sizes, void** mhandles, void** request) {
+  struct ncclIbRecvComm* comm = (struct ncclIbRecvComm*)recvComm;
+  struct ncclIbFr2* fr = comm->base.fr;
+  if (fr == NULL) return ncclIbIflushBody(recvComm, n, data, sizes, mhandles, request);
+  pthread_mutex_lock(&fr->lock);
+  ncclResult_t res = ncclIbIflushBody(recvComm, n, data, sizes, mhandles, request);
+  pthread_mutex_unlock(&fr->lock);
+  return res;
+}
