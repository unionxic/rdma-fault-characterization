+// Allocate the side state for a comm whose configuration Stage 2 supports.
+static void fr2Attach(struct ncclIbNetCommBase* base, int isSend, int ar, uint32_t remQpn, int eceSet,
+                      const struct ibv_ece* ece, bool overrideTc) {
+  if (!ncclParamRdmaFaultRecovery()) return;
+  if (base->nqps != 1 || base->ndevs != 1 || ar) {
+    INFO(NCCL_NET, "NET/IB: [FAULT-RECOVERY2] recovery off for this %s comm (nqps=%d ndevs=%d ar=%d): only 1 QP / 1 NIC / no AR is supported",
+         isSend ? "send" : "recv", base->nqps, base->ndevs, ar);
+    return;
+  }
+  // a full flush of this comm must fit in its CQ: RQ 256 + SQ 512 + markers + GPU-flush CQEs
+  struct ncclIbNetCommDevBase* db0 = ncclIbGetNetCommDevBase(base, 0);
+  if (db0->cq->cqe < 2 * MAX_REQUESTS + MAX_REQUESTS + 8) {
+    INFO(NCCL_NET, "NET/IB: [FAULT-RECOVERY2] recovery off for this comm: CQ holds %d entries, a full flush needs %d", db0->cq->cqe, 3 * MAX_REQUESTS + 8);
+    return;
+  }
+  struct ncclIbFr2* fr = (struct ncclIbFr2*)calloc(1, sizeof(struct ncclIbFr2));
+  if (fr == NULL) { WARN("NET/IB: [FAULT-RECOVERY2] allocation failed; recovery off for this comm"); return; }
+  pthread_mutex_init(&fr->lock, NULL);
+  fr->base = base;
+  fr->gidVer = (int)ncclParamIbRoceVersionNum();
+  if (db0->gidInfo.link_layer == IBV_LINK_LAYER_ETHERNET) {
+    struct ncclIbDev* ibDev0 = ncclIbDevs + db0->ibDevN; int ver = 0;
+    if (ncclIbRoceGetVersionNum(ibDev0->devName, ibDev0->portNum, db0->gidInfo.localGidIndex, &ver) == ncclSuccess && ver) fr->gidVer = ver;
+  }
+  fr->isSend = isSend;
+  fr->state = FR2_IDLE;
+  fr->pollNs = (uint64_t)std::max<int64_t>(0, ncclParamRdmaFaultPollUs()) * 1000ULL;
+  fr->remQpn = remQpn; fr->accessFlags = IBV_ACCESS_REMOTE_WRITE; fr->eceSet = eceSet;
+  if (ece) fr->ece = *ece;
+  fr->overrideTc = overrideTc;
+  fr->mute = (!isSend && ncclParamRdmaFaultTestMute()) ? 1 : 0;
+  if (!isSend && ncclParamRdmaFaultInjectRecvSilent() && ncclParamRdmaFaultInjectRecv() > 0) {
+    static int armedOnce = 0;   // the first recv comm of the process only
+    if (!__atomic_exchange_n(&armedOnce, 1, __ATOMIC_RELAXED)) fr->injSilentArmed = (int)ncclParamRdmaFaultInjectRecv();
+  }
+  fr2Keepalive(base->sock.fd, ncclParamRdmaFaultKeepaliveMs());
+  base->fr = fr;   // registered with the helper by fr2Activate, once connect/accept has finished with base.sock
+  INFO(NCCL_NET, "NET/IB: [FAULT-RECOVERY2] recovery on for %s comm qpn=%u remQpn=%u", isSend ? "send" : "recv", base->qps[0].qp->qp_num, remQpn);
+}
+
+static void fr2Detach(struct ncclIbNetCommBase* base) {
+  struct ncclIbFr2* fr = base->fr;
+  if (fr == NULL) return;
+  fr2Unregister(fr);                 // the helper no longer sees it once this returns
+  pthread_mutex_lock(&fr->lock);     // and no proxy call is inside it
+  pthread_mutex_unlock(&fr->lock);
+  pthread_mutex_destroy(&fr->lock);
+  base->fr = NULL;
+  free(fr);
+}
+
+// connect/accept is done with base.sock: from now on the helper may read it. Announce Stage 2 to the
+// peer (a peer with recovery off never answers, and then every fault fails like stock).
+static void fr2Activate(struct ncclIbNetCommBase* base) {
+  struct ncclIbFr2* fr = base->fr;
+  if (fr == NULL) return;
+  pthread_mutex_lock(&fr->lock);
+  fr2Send(base, FR2_HELLO, 0, 0, 0, 0);
+  pthread_mutex_unlock(&fr->lock);
+  fr2Register(fr);
+}
+
+static int fr2Fatal(struct ncclIbNetCommBase* base) {
+  if (!ncclParamIbAsyncEvents()) return 0;   // same switch as ncclIbStatsCheckFatalCount
+  if (__atomic_load_n(&base->stats.fatalErrorCount, __ATOMIC_RELAXED)) return 1;
+  struct ncclIbNetCommDevBase* db = ncclIbGetNetCommDevBase(base, 0);
+  return __atomic_load_n(&ncclIbDevs[db->ibDevN].stats.fatalErrorCount, __ATOMIC_RELAXED) ? 1 : 0;
+}
+
+// ---- OOB socket (non-blocking) ------------------------------------------------
+static void fr2TxProgress(struct ncclIbNetCommBase* base) {
+  struct ncclIbFr2* fr = base->fr;
+  while (fr->txCount > 0) {
+    if (fr->peerClosed || base->sock.fd < 0) { fr->txCount = 0; fr->txOff = 0; return; }
+    struct ncclIbFr2Msg* m = &fr->txq[fr->txHead];
+    ssize_t n = send(base->sock.fd, (char*)m + fr->txOff, sizeof(*m) - fr->txOff, MSG_DONTWAIT | MSG_NOSIGNAL);
+    if (n > 0) {
+      fr->txOff += (int)n;
+      if (fr->txOff == (int)sizeof(*m)) { fr->txOff = 0; fr->txHead = (fr->txHead + 1) % 8; fr->txCount--; }
+      continue;
+    }
+    if (n < 0 && (errno == EAGAIN || errno == EWOULDBLOCK || errno == EINTR)) return;
+    fr->peerClosed = 1; fr->txCount = 0; fr->txOff = 0; return;
+  }
+}
+
+static void fr2Send(struct ncclIbNetCommBase* base, uint32_t type, uint32_t reason, uint64_t a, uint64_t b, uint32_t psn) {
+  struct ncclIbFr2* fr = base->fr;
+  if (fr->txCount == 8) { WARN("NET/IB: [FAULT-RECOVERY2] OOB TX queue full, dropping %s", fr2MsgStr(type)); return; }
+  struct ncclIbFr2Msg* m = &fr->txq[(fr->txHead + fr->txCount) % 8];
+  memset(m, 0, sizeof(*m));
+  m->magic = FR2_MAGIC; m->type = type; m->epoch = fr->epoch; m->reason = reason; m->a = a; m->b = b; m->psn = psn;
+  m->nqps = base->nqps; m->ndevs = base->ndevs; m->status = fr->firstStatus; m->vendor = fr->firstVendor;
+  fr->txCount++;
+  fr2TxProgress(base);
+}
+
+// 1 when a whole message is in fr->rx.
+static int fr2RxProgress(struct ncclIbNetCommBase* base) {
+  struct ncclIbFr2* fr = base->fr;
+  if (fr->peerClosed || base->sock.fd < 0) return 0;
+  while (fr->rxOff < (int)sizeof(fr->rx)) {
+    ssize_t n = recv(base->sock.fd, (char*)&fr->rx + fr->rxOff, sizeof(fr->rx) - fr->rxOff, MSG_DONTWAIT);
+    if (n > 0) { fr->rxOff += (int)n; continue; }
+    if (n < 0 && (errno == EAGAIN || errno == EWOULDBLOCK || errno == EINTR)) return 0;
+    fr->peerClosed = 1;  // 0 = FIN; <0 = RST, ETIMEDOUT (keepalive), ...
+    return 0;
+  }
+  fr->rxOff = 0;
+  return 1;
+}
+
+// Liveness evidence without consuming data: 1 = dead (FIN/RST/TCP timeout), 0 = no evidence.
+static int fr2PeerDead(struct ncclIbNetCommBase* base) {
+  struct ncclIbFr2* fr = base->fr;
+  if (fr->peerClosed) return 1;
+  int fd = base->sock.fd;
+  if (fd < 0) return 1;
+  char c;
+  ssize_t n = recv(fd, &c, 1, MSG_PEEK | MSG_DONTWAIT);
+  if (n == 0) return 1;
+  if (n > 0) return 0;
+  if (errno == EAGAIN || errno == EWOULDBLOCK || errno == EINTR) return 0;
+  return 1;
+}
+
+static void fr2Fail(struct ncclIbNetCommBase* base, uint32_t reason, int notify) {
+  struct ncclIbFr2* fr = base->fr;
+  if (fr->state == FR2_FAILED) return;
+  int prev = fr->state;
+  if (notify) fr2Send(base, (!fr->isSend && (prev == FR2_R_DRAIN_REQ)) ? FR2_NACK : FR2_FAIL, reason, 0, 0, 0);
+  fr->state = FR2_FAILED;
+  fr->flState = 0;
+  WARN("NET/IB: [FAULT-RECOVERY2] %s comm FAILED in %s (%s, epoch %u, rounds %d): it now returns the stock error",
+       fr->isSend ? "send" : "recv", fr2StateStr(prev), fr2ReasonStr(reason), fr->epoch, fr->rounds);
+}
+
+// ---- classification -----------------------------------------------------------
+static int fr2Recoverable(int status) {
+  return status == IBV_WC_WR_FLUSH_ERR || status == IBV_WC_RETRY_EXC_ERR;
+}
+static const char* fr2StatusStr(int status) {
+  switch (status) {
+    case IBV_WC_SUCCESS: return "SUCCESS"; case IBV_WC_LOC_LEN_ERR: return "LOC_LEN_ERR"; case IBV_WC_LOC_PROT_ERR: return "LOC_PROT_ERR";
+    case IBV_WC_WR_FLUSH_ERR: return "WR_FLUSH_ERR"; case IBV_WC_REM_INV_REQ_ERR: return "REM_INV_REQ_ERR";
+    case IBV_WC_REM_ACCESS_ERR: return "REM_ACCESS_ERR"; case IBV_WC_RETRY_EXC_ERR: return "RETRY_EXC_ERR";
+    case IBV_WC_RNR_RETRY_EXC_ERR: return "RNR_RETRY_EXC_ERR"; default: return "OTHER";
+  }
+}
+
+// Start an incident (idempotent while one runs). src: "cqe", "notify".
+static void fr2StartIncident(struct ncclIbNetCommBase* base, int status, uint32_t vendor, const char* src) {
+  struct ncclIbFr2* fr = base->fr;
+  if (fr->state != FR2_IDLE) return;
+  fr->firstStatus = status; fr->firstVendor = vendor; fr->firstSrc = src;
+  fr->tDetect = clockNano();
+  int dead = fr2PeerDead(base);
+  WARN("NET/IB: [FAULT-RECOVERY2] %s comm: incident via %s: status=%d(%s) vendor_err=0x%x peer=%s -> %s",
+       fr->isSend ? "send" : "recv", src, status, fr2StatusStr(status), vendor, dead ? "dead(FIN/RST/timeout)" : "no-evidence-of-death",
+       fr2Recoverable(status) && !dead ? (fr->isSend ? "lead a recovery" : "drain, then NOTIFY the leader") : "fail");
+  if (!fr2Recoverable(status)) { fr2Fail(base, FR2_R_CLASS, 1); return; }
+  if (dead) { fr2Fail(base, FR2_R_PEER_DEAD, 0); return; }
+  if (!fr->peerHello) { fr2Fail(base, FR2_R_PEER_OFF, 0); return; }
+  if (fr2Fatal(base)) { fr2Fail(base, FR2_R_FATAL, 1); return; }
+  fr->errDone = fr->markSqPosted = fr->markRqPosted = fr->markSq = fr->markRq = fr->drained = 0;
+  fr->drainDeadline = clockNano() + fr2Ms(ncclParamRdmaFaultDrainMs());
+  fr->state = fr->isSend ? FR2_S_DRAIN : FR2_R_DRAIN_NOTIFY;
+}
+
+// Send/recv requests still waiting for a completion (GPU-flush requests excluded: they are local).
+static int fr2HasOutstanding(struct ncclIbNetCommBase* base) {
+  for (int i = 0; i < MAX_REQUESTS; i++) {
+    struct ncclIbRequest* r = base->reqs + i;
+    if ((r->type == NCCL_NET_IB_REQ_SEND || r->type == NCCL_NET_IB_REQ_RECV) && (r->events[0] || r->events[1])) return 1;
+  }
+  return 0;
+}
+
+static int fr2PendingRecvs(struct ncclIbNetCommBase* base) {
+  int n = 0;
+  for (int i = 0; i < MAX_REQUESTS; i++)
+    if (base->reqs[i].type == NCCL_NET_IB_REQ_RECV && !base->fr->req[i].arrived) n++;
+  return n;
+}
+
+// ---- CQ processing ------------------------------------------------------------
+// Polls the comm's CQ once (up to 16 CQEs). Success: stock accounting (+ side arrays). Error on
+// the connection QP: starts an incident when idle, ignored while one runs (flush of the old
+// incarnation; its requests are rebuilt by reconciliation). *n = CQEs consumed.
+static ncclResult_t fr2PollCq(struct ncclIbNetCommBase* base, int* n) {
+  struct ncclIbFr2* fr = base->fr;
+  struct ncclIbNetCommDevBase* db = ncclIbGetNetCommDevBase(base, 0);
+  struct ibv_wc wcs[16];
+  int got = 0;
+  *n = 0;
+  NCCLCHECK(wrap_ibv_poll_cq(db->cq, 16, wcs, &got));
+  *n = got;
+  uint32_t connQpn = base->qps[0].qp->qp_num;
+  for (int w = 0; w < got; w++) {
+    struct ibv_wc* wc = wcs + w;
+    if (wc->wr_id == FR2_MARK_SQ && wc->qp_num == connQpn) { fr->markSq = 1; continue; }
+    if (wc->wr_id == FR2_MARK_RQ && wc->qp_num == connQpn) { fr->markRq = 1; continue; }
+    if (wc->wr_id == FR2_MARK_FL) { fr->flMark = 1; continue; }
+    if (wc->wr_id == FR2_CTS_TAG && wc->qp_num == connQpn) {
+      if (wc->status != IBV_WC_SUCCESS && fr->state == FR2_IDLE) fr2StartIncident(base, wc->status, wc->vendor_err, "cqe(cts-rewrite)");
+      continue;
+    }
+    if (wc->status != IBV_WC_SUCCESS) {
+      if (wc->qp_num != connQpn) {  // GPU-flush (loopback) QP of the recv comm: recovered locally
+        if (!fr->isSend && fr->flState == 0 && (wc->status == IBV_WC_WR_FLUSH_ERR || wc->status == IBV_WC_RETRY_EXC_ERR)) {
+          WARN("NET/IB: [FAULT-RECOVERY2] recv comm: GPU-flush QP error (qpn=%u status=%d(%s) vendor_err=0x%x): local re-drive",
+               wc->qp_num, wc->status, fr2StatusStr(wc->status), wc->vendor_err);
+          fr->flState = 1; fr->flErrDone = fr->flMarkPosted = fr->flMark = 0;
+          fr->flDeadline = clockNano() + fr2Ms(ncclParamRdmaFaultPathWaitMs());
+        } else if (fr->flState == 0) {
+          WARN("NET/IB: [FAULT-RECOVERY2] error CQE on a non-connection QP (qpn=%u status=%d vendor_err=0x%x)", wc->qp_num, wc->status, wc->vendor_err);
+          fr2Fail(base, FR2_R_FLUSHQP, 1);
+        }
+        continue;   // flushes of the old flush-QP incarnation: their requests are re-posted
+      }
+      if (fr->state == FR2_IDLE) fr2StartIncident(base, wc->status, wc->vendor_err, "cqe");
+      else if ((fr->state == FR2_S_DRAIN || fr->state == FR2_R_DRAIN_NOTIFY || fr->state == FR2_R_DRAIN_REQ) &&
+               !fr2Recoverable(wc->status)) {
+        // e.g. a NOTIFY started this round but the local QP holds a NAK-class error: not recoverable
+        WARN("NET/IB: [FAULT-RECOVERY2] %s comm: non-recoverable error CQE during the drain: status=%d(%s) vendor_err=0x%x",
+             fr->isSend ? "send" : "recv", wc->status, fr2StatusStr(wc->status), wc->vendor_err);
+        fr->firstStatus = wc->status; fr->firstVendor = wc->vendor_err;
+        fr2Fail(base, FR2_R_CLASS, 1);
+      }
+      else if (fr->state == FR2_R_WAIT_DONE) {
+        // a new fault on the new incarnation before DONE: a fresh incident (S will see it too)
+        fr->state = FR2_IDLE;
+        fr2StartIncident(base, wc->status, wc->vendor_err, "cqe(after-ack)");
+      }
+      continue;
+    }
+    // success: the stock accounting of ncclIbTest
+    struct ncclIbRequest* req = base->reqs + (wc->wr_id & 0xff);
+    if (req->type == NCCL_NET_IB_REQ_SEND) {
+      for (int j = 0; j < req->nreqs; j++) {
+        struct ncclIbRequest* sendReq = base->reqs + ((wc->wr_id >> (j * 8)) & 0xff);
+        if (sendReq->events[0] <= 0) {
+          WARN("NET/IB: [FAULT-RECOVERY2] sendReq(%p)->events={%d,%d} <= 0 on a success CQE", sendReq, sendReq->events[0], sendReq->events[1]);
+          return ncclInternalError;
+        }
+        sendReq->events[0]--;
+      }
+      fr->progress++;
+    } else {
+      if (wc->opcode == IBV_WC_RECV_RDMA_WITH_IMM) {
+        if (req->type != NCCL_NET_IB_REQ_RECV) {
+          WARN("NET/IB: [FAULT-RECOVERY2] RECV_RDMA_WITH_IMM for req type %d", req->type);
+          return ncclInternalError;
+        }
+        if (req->nreqs == 1) req->recv.sizes[0] = wc->imm_data;
+        fr->req[req - base->reqs].arrived = 1;
+        if (fr->injSilentArmed > 1) fr->injSilentArmed--;
+        else if (fr->injSilentArmed == 1 && fr2PendingRecvs(base) >= 1) {
+          // test hook (SILENT): kill this QP right after a receive arrived while another receive is
+          // pending (its CTS is out, so the sender will write into the dead QP); do not notify, so
+          // the sender meets RETRY_EXC. Firing when nothing is pending would leave the sender idle
+          // waiting for a CTS, which only R's WAITREQ deadline can end.
+          fr->injSilentArmed = 0;
+          fr->silent = 1;
+          ncclResult_t ir = fr2ModifyState(base->qps[0].qp, IBV_QPS_ERR);
+          WARN("NET/IB: [FAULT-INJECT] forced recv QP (qpn=%u) to ERR after a receive completion [silent] (rc=%d)", base->qps[0].qp->qp_num, ir);
+        }
+      }
+      req->events[0]--;
+    }
+  }
+  return ncclSuccess;
+}
+
+// ---- drain (ib_drain_qp style) -------------------------------------------------
+static ncclResult_t fr2ModifyState(struct ibv_qp* qp, enum ibv_qp_state s) {
+  struct ibv_qp_attr attr;
+  memset(&attr, 0, sizeof(attr));
+  attr.qp_state = s;
+  return wrap_ibv_modify_qp(qp, &attr, IBV_QP_STATE);
+}
+
+// Advances the drain; *finished = 1 once both markers of this comm's queues were consumed.
+static ncclResult_t fr2DrainProgress(struct ncclIbNetCommBase* base, int* finished) {
+  struct ncclIbFr2* fr = base->fr;
+  struct ibv_qp* qp = base->qps[0].qp;
+  *finished = 0;
+  if (fr->drained) { *finished = 1; return ncclSuccess; }
+  if (!fr->errDone) {
+    if (fr2ModifyState(qp, IBV_QPS_ERR) != ncclSuccess) { fr2Fail(base, FR2_R_VERBS, 1); return ncclSuccess; }
+    fr->errDone = 1;
+  }
+  int n;
+  NCCLCHECK(fr2PollCq(base, &n));  // consuming flushed CQEs frees queue slots for the markers
+  if (fr->state == FR2_FAILED) return ncclSuccess;
+  if (!fr->markSqPosted) {
+    struct ibv_send_wr wr, *bad;
+    memset(&wr, 0, sizeof(wr));
+    wr.wr_id = FR2_MARK_SQ; wr.opcode = IBV_WR_RDMA_WRITE; wr.send_flags = IBV_SEND_SIGNALED;
+    if (qp->context->ops.post_send(qp, &wr, &bad) == 0) fr->markSqPosted = 1;  // ENOMEM: retry after more polling
+  }
+  if (!fr->isSend && !fr->markRqPosted) {
+    struct ibv_recv_wr wr, *bad;
+    memset(&wr, 0, sizeof(wr));
+    wr.wr_id = FR2_MARK_RQ;
+    if (qp->context->ops.post_recv(qp, &wr, &bad) == 0) fr->markRqPosted = 1;
+  }
+  NCCLCHECK(fr2PollCq(base, &n));
+  if (fr->state == FR2_FAILED) return ncclSuccess;
+  if (fr->markSq && (fr->isSend || fr->markRq)) {
+    fr->drained = 1; fr->tDrained = clockNano(); *finished = 1;
+    return ncclSuccess;
+  }
+  if (clockNano() > fr->drainDeadline) fr2Fail(base, FR2_R_DRAIN_TMO, 1);
+  return ncclSuccess;
+}
+
+// Current GID-table index of this comm's local GID, found by value and RoCE version. A GID entry
+// that a QP references is kept (pending deletion) when its address goes away, so an address that
+// comes back gets a NEW index while the QP's address vector still names the dead one: the QP stays
+// broken even after the address returns. Re-resolving the index at bring-up fixes that.
+// Returns 1 and the index when the GID is present, 0 when it is not (yet).
+static int fr2ResolveLocalGid(struct ncclIbNetCommDevBase* db, struct ncclIbDev* ibDev, int want_ver, int* idxOut) {
+  if (db->gidInfo.link_layer != IBV_LINK_LAYER_ETHERNET) { *idxOut = db->gidInfo.localGidIndex; return 1; }
+  struct ibv_port_attr pa;
+  if (wrap_ibv_query_port(ibDev->context, ibDev->portNum, &pa) != ncclSuccess) return 0;
+  int want = want_ver;
+  for (int i = 0; i < pa.gid_tbl_len; i++) {
+    union ibv_gid g;
+    if (wrap_ibv_query_gid(ibDev->context, ibDev->portNum, i, &g) != ncclSuccess) continue;
+    if (memcmp(&g, &db->gidInfo.localGid, sizeof(g)) != 0) continue;
+    int ver = 0;
+    if (ncclIbRoceGetVersionNum(ibDev->devName, ibDev->portNum, i, &ver) != ncclSuccess) continue;
+    if (ver == want) { *idxOut = i; return 1; }
+  }
+  return 0;
+}
+
+// RESET -> INIT -> [set_ece] -> RTR(rq_psn) -> RTS(sq_psn) with the connect-time attributes.
+// ncclInProgress = the path is not usable yet (local GID absent, or RTR could not resolve the peer):
+// the caller retries until its path deadline.
+static ncclResult_t fr2BringUp(struct ncclIbNetCommBase* base, uint32_t rqPsn, uint32_t sqPsn) {
+  struct ncclIbFr2* fr = base->fr;
+  struct ncclIbQp* q = base->qps + 0;
+  struct ncclIbNetCommDevBase* db = ncclIbGetNetCommDevBase(base, q->devIndex);
+  struct ncclIbDev* ibDev = ncclIbDevs + db->ibDevN;
+  int gidIdx = -1;
+  fr->bringupTries++;
+  if (!fr2ResolveLocalGid(db, ibDev, fr->gidVer, &gidIdx)) return ncclInProgress;
+  if (gidIdx != db->gidInfo.localGidIndex) {
+    WARN("NET/IB: [FAULT-RECOVERY2] local GID moved from index %d to %d (the address was re-created); using the new index",
+         db->gidInfo.localGidIndex, gidIdx);
+    db->gidInfo.localGidIndex = gidIdx;
+  }
+  NCCLCHECK(fr2ModifyState(q->qp, IBV_QPS_RESET));
+  struct ibv_qp_attr attr;
+  memset(&attr, 0, sizeof(attr));
+  attr.qp_state = IBV_QPS_INIT;
+  attr.pkey_index = ncclParamIbPkey();
+  attr.port_num = ibDev->portNum;
+  attr.qp_access_flags = fr->accessFlags;
+  NCCLCHECK(wrap_ibv_modify_qp(q->qp, &attr, IBV_QP_STATE | IBV_QP_PKEY_INDEX | IBV_QP_PORT | IBV_QP_ACCESS_FLAGS));
+  if (fr->eceSet) {
+    struct ibv_ece ece = fr->ece; int supported = 1;
+    NCCLCHECK(wrap_ibv_set_ece(q->qp, &ece, &supported));
+  }
+  if (ncclIbRtrQp(q->qp, &db->gidInfo, fr->remQpn, &base->remDevs[q->remDevIdx], fr->overrideTc, rqPsn) != ncclSuccess)
+    return ncclInProgress;   // left in INIT; the next try starts from RESET again
+  NCCLCHECK(ncclIbRtsQp(q->qp, sqPsn));
+  fr->errDone = fr->markSqPosted = fr->markRqPosted = fr->markSq = fr->markRq = fr->drained = 0;
+  return ncclSuccess;
+}
+
+// ---- R: reconcile + reset + re-post (on REQ, after the drain) -------------------
+static ncclResult_t fr2RecvReconcile(struct ncclIbRecvComm* comm, uint64_t* rDoneOut, int* ok) {
+  struct ncclIbNetCommBase* base = &comm->base;
+  struct ncclIbFr2* fr = base->fr;
+  *ok = 0;
+  uint64_t tail = comm->remFifo.fifoTail;   // idx of the last posted receive
+  int pend[MAX_REQUESTS]; int npend = 0; uint64_t minPend = UINT64_MAX, maxArr = 0;
+  for (int i = 0; i < MAX_REQUESTS; i++) {
+    struct ncclIbRequest* r = base->reqs + i;
+    if (r->type != NCCL_NET_IB_REQ_RECV) continue;
+    if (r->nreqs != 1) { fr2Fail(base, FR2_R_MULTI, 1); return ncclSuccess; }
+    if (fr->req[i].arrived) {
+      maxArr = std::max(maxArr, fr->req[i].idx);
+      r->events[0] = 0; r->events[1] = 0;   // only a CTS completion could be left: the CTS was delivered
+    } else {
+      pend[npend++] = i;
+      minPend = std::min(minPend, fr->req[i].idx);
+    }
+  }
+  uint64_t rDone = npend ? minPend - 1 : tail;
+  // pending receives must be exactly rDone+1 .. tail (contiguous suffix)
+  int consistent = (uint64_t)npend == tail - rDone && maxArr <= rDone &&
+                   fr->peerFifoHead >= rDone && fr->peerFifoHead <= tail;
+  if (consistent) {
+    std::sort(pend, pend + npend, [&](int x, int y) { return fr->req[x].idx < fr->req[y].idx; });
+    for (int k = 0; k < npend; k++) if (fr->req[pend[k]].idx != rDone + 1 + k) consistent = 0;
+  }
+  if (!consistent) {
+    WARN("NET/IB: [FAULT-RECOVERY2] recv reconcile: inconsistent (npend=%d rDone=%lu tail=%lu maxArrived=%lu peerFifoHead=%lu)",
+         npend, rDone, tail, maxArr, fr->peerFifoHead);
+    fr2Fail(base, FR2_R_INCONSISTENT, 1);
+    return ncclSuccess;
+  }
+  memcpy(fr->pend, pend, npend * sizeof(int));
+  fr->npend = npend;
+  fr->ctsFrom = std::max(fr->peerFifoHead, rDone) + 1;
+  *rDoneOut = rDone;
+  *ok = 1;
+  return ncclSuccess;
+}
+
+// R, after its bring-up: re-post the pending receives in FIFO order.
+static ncclResult_t fr2RecvRepost(struct ncclIbRecvComm* comm) {
+  struct ncclIbNetCommBase* base = &comm->base;
+  struct ncclIbFr2* fr = base->fr;
+  for (int k = 0; k < fr->npend; k++) {
+    struct ncclIbRequest* r = base->reqs + fr->pend[k];
+    struct ibv_recv_wr wr, *bad;
+    memset(&wr, 0, sizeof(wr));
+    wr.wr_id = fr->pend[k];
+    if (wrap_ibv_post_recv(base->qps[0].qp, &wr, &bad) != ncclSuccess) { fr2Fail(base, FR2_R_VERBS, 1); return ncclSuccess; }
+    r->events[0] = 1; r->events[1] = 0;
+  }
+  fr->lastReposted = fr->npend;
+  return ncclSuccess;
+}
+
+// R, after DONE: rewrite the CTS entries of pending receives the leader has not consumed.
+static ncclResult_t fr2CtsRewrite(struct ncclIbRecvComm* comm) {
+  struct ncclIbNetCommBase* base = &comm->base;
+  struct ncclIbFr2* fr = base->fr;
+  struct ncclIbQp* ctsQp = base->qps + 0;
+  uint64_t tail = comm->remFifo.fifoTail;
+  int count = 0;
+  for (uint64_t idx = fr->ctsFrom; idx <= tail; idx++) {
+    int slot = (int)((idx - 1) % MAX_REQUESTS);   // PostFifo used slot = fifoTail % MAX before fifoTail++
+    struct ncclIbSendFifo* localElem = comm->remFifo.elems[slot];
+    if (localElem[0].idx != idx) {
+      WARN("NET/IB: [FAULT-RECOVERY2] CTS rewrite: slot %d holds idx %lu, expected %lu", slot, localElem[0].idx, idx);
+      fr2Fail(base, FR2_R_INCONSISTENT, 1);
+      return ncclSuccess;
+    }
+    struct ibv_sge sge;
+    sge.addr = (uint64_t)localElem;
+    sge.length = localElem[0].nreqs * sizeof(struct ncclIbSendFifo);
+    sge.lkey = comm->devs[ctsQp->devIndex].fifoMr->lkey;
+    struct ibv_send_wr wr, *bad;
+    memset(&wr, 0, sizeof(wr));
+    wr.sg_list = &sge; wr.num_sge = 1;
+    wr.opcode = IBV_WR_RDMA_WRITE;
+    wr.send_flags = comm->remFifo.flags;
+    if (idx == tail || slot == 0) { wr.send_flags |= IBV_SEND_SIGNALED; wr.wr_id = FR2_CTS_TAG; }  // keep <= 256 posts between signaled WRs
+    wr.wr.rdma.remote_addr = comm->remFifo.addr + slot * NCCL_NET_IB_MAX_RECVS * sizeof(struct ncclIbSendFifo);
+    wr.wr.rdma.rkey = base->remDevs[ctsQp->remDevIdx].fifoRkey;
+    if (wrap_ibv_post_send(ctsQp->qp, &wr, &bad) != ncclSuccess) { fr2Fail(base, FR2_R_VERBS, 1); return ncclSuccess; }
+    count++;
+  }
+  fr->lastCts = count;
+  return ncclSuccess;
+}
+
+// ---- S: reconcile + reset + replay (on ACK) ------------------------------------
+static ncclResult_t fr2SendFinish(struct ncclIbSendComm* comm) {
+  struct ncclIbNetCommBase* base = &comm->base;
+  struct ncclIbFr2* fr = base->fr;
+  uint64_t head = comm->fifoHead;   // idx of the last matched (posted) group
+  uint64_t rDone = fr->rDone;
+  if (!(rDone <= head && head <= fr->peerFifoTail)) {
+    WARN("NET/IB: [FAULT-RECOVERY2] send reconcile: rDone=%lu fifoHead=%lu peerFifoTail=%lu", rDone, head, fr->peerFifoTail);
+    fr2Fail(base, FR2_R_INCONSISTENT, 1);
+    return ncclSuccess;
+  }
+  // in-flight groups: send requests with outstanding events, keyed by FIFO idx
+  uint8_t inflight[MAX_REQUESTS]; memset(inflight, 0, sizeof(inflight));
+  for (int i = 0; i < MAX_REQUESTS; i++) {
+    struct ncclIbRequest* r = base->reqs + i;
+    if (r->type != NCCL_NET_IB_REQ_SEND || (r->events[0] == 0 && r->events[1] == 0)) continue;
+    uint64_t idx = fr->req[i].idx;
+    if (r->nreqs != 1) { fr2Fail(base, FR2_R_MULTI, 1); return ncclSuccess; }
+    if (idx == 0 || idx > head || head - idx >= MAX_REQUESTS) {
+      WARN("NET/IB: [FAULT-RECOVERY2] send reconcile: in-flight req %d has idx %lu (fifoHead %lu)", i, idx, head);
+      fr2Fail(base, FR2_R_INCONSISTENT, 1);
+      return ncclSuccess;
+    }
+    inflight[(idx - 1) % MAX_REQUESTS] = 1;
+  }
+  // every group in rDone+1..head must be in flight (a completed group implies R executed it)
+  for (uint64_t idx = rDone + 1; idx <= head; idx++) {
+    int slot = (int)((idx - 1) % MAX_REQUESTS);
+    struct ncclIbFr2Group* g = fr->grp + slot;
+    if (!inflight[slot] || g->idx != idx || g->nreqs != 1 || fr->req[g->reqIdx].idx != idx) {
+      WARN("NET/IB: [FAULT-RECOVERY2] send reconcile: group %lu not replayable (inflight=%d rec.idx=%lu nreqs=%d)", idx, inflight[slot], g->idx, g->nreqs);
+      fr2Fail(base, FR2_R_INCONSISTENT, 1);
+      return ncclSuccess;
+    }
+  }
+  fr->bringupTries = 0; fr->bringupBackoff = 0;
+  fr->pathDeadline = clockNano() + fr2Ms(ncclParamRdmaFaultPathWaitMs());
+  fr->nextTry = 0;
+  fr->state = FR2_S_BRINGUP;
+  return ncclSuccess;
+}
+
+// S, after its bring-up: complete the groups R had, replay the others, DONE.
+static ncclResult_t fr2SendApply(struct ncclIbSendComm* comm) {
+  struct ncclIbNetCommBase* base = &comm->base;
+  struct ncclIbFr2* fr = base->fr;
+  uint64_t head = comm->fifoHead;
+  uint64_t rDone = fr->rDone;
+  // groups R executed: complete them
+  int completed = 0;
+  for (int i = 0; i < MAX_REQUESTS; i++) {
+    struct ncclIbRequest* r = base->reqs + i;
+    if (r->type != NCCL_NET_IB_REQ_SEND || (r->events[0] == 0 && r->events[1] == 0)) continue;
+    if (fr->req[i].idx <= rDone) { r->events[0] = 0; r->events[1] = 0; completed++; }
+  }
+  // groups R did not execute: replay in FIFO order (same WR as ncclIbMultiSend for nreqs == 1, no AR)
+  struct ncclIbQp* qp = base->qps + 0;
+  int replayed = 0;
+  for (uint64_t idx = rDone + 1; idx <= head; idx++) {
+    struct ncclIbFr2Group* g = fr->grp + (idx - 1) % MAX_REQUESTS;
+    struct ncclIbRequest* r = base->reqs + g->reqIdx;
+    struct ibv_sge sge;
+    struct ibv_send_wr wr, *bad;
+    memset(&wr, 0, sizeof(wr));
+    wr.wr_id = (uint64_t)g->reqIdx;
+    wr.opcode = IBV_WR_RDMA_WRITE_WITH_IMM;
+    wr.imm_data = r->send.size;
+    wr.send_flags = IBV_SEND_SIGNALED;
+    wr.wr.rdma.remote_addr = g->addr;
+    wr.wr.rdma.rkey = g->rkey;
+    if (r->send.size > 0) {
+      sge.addr = (uintptr_t)r->send.data; sge.length = r->send.size; sge.lkey = r->send.lkeys[qp->devIndex];
+      wr.sg_list = &sge; wr.num_sge = 1;
+    }
+    if (wrap_ibv_post_send(qp->qp, &wr, &bad) != ncclSuccess) { fr2Fail(base, FR2_R_VERBS, 1); return ncclSuccess; }
+    r->events[0] = 1; r->events[1] = 0;
+    r->send.offset = r->send.size;
+    replayed++;
+  }
+  fr->lastReplayed = replayed; fr->lastCompleted = completed;
+  fr->progress += completed;   // groups R had count as progress for MAX_ROUNDS
+  fr2Send(base, FR2_DONE, 0, (uint64_t)replayed, (uint64_t)completed, 0);
+  fr->tDone = clockNano();
+  fr->recoveries++;
+  fr->state = FR2_IDLE;
+  WARN("NET/IB: [FAULT-RECOVERY2] send comm: recovered (epoch %u, round %d): first error %s(0x%x) via %s; R_done=%lu fifoHead=%lu peerFifoTail=%lu; "
+       "completed %d group(s) R had, replayed %d; psn rq=0x%x sq=0x%x; detect->drained %.3f ms, ->ACK %.3f ms, ->replayed %.3f ms (total %.3f ms)",
+       fr->epoch, fr->rounds, fr2StatusStr(fr->firstStatus), fr->firstVendor, fr->firstSrc ? fr->firstSrc : "?", rDone, head, fr->peerFifoTail,
+       completed, replayed, fr->psnPeer, fr->psnLocal,
+       (fr->tDrained - fr->tDetect) / 1e6, (fr->tAck - fr->tDetect) / 1e6, (fr->tDone - fr->tAck) / 1e6, (fr->tDone - fr->tDetect) / 1e6);
+  if (fr->notifyPending) {   // R reported a fresh fault while this round ran
+    fr->notifyPending = 0;
+    fr2StartIncident(base, fr->notifyStatus, fr->notifyVendor, "notify(latched)");
+  }
+  return ncclSuccess;
+}
+
+// ---- messages -------------------------------------------------------------------
+static ncclResult_t fr2Handle(struct ncclIbNetCommBase* base, struct ncclIbFr2Msg* m) {
+  struct ncclIbFr2* fr = base->fr;
+  if (m->magic != FR2_MAGIC) { fr2Fail(base, FR2_R_PROTO, 0); fr->peerClosed = 1; return ncclSuccess; }
+  if (m->type == FR2_HELLO) { fr->peerHello = 1; return ncclSuccess; }
+  if (m->type == FR2_FAIL || m->type == FR2_NACK) {
+    WARN("NET/IB: [FAULT-RECOVERY2] %s comm: peer sent %s (%s)", fr->isSend ? "send" : "recv", fr2MsgStr(m->type), fr2ReasonStr(m->reason));
+    fr2Fail(base, FR2_R_PEER_FAIL, 0);
+    return ncclSuccess;
+  }
+  if (fr->state == FR2_FAILED) {
+    if (!fr->isSend && m->type == FR2_REQ) fr2Send(base, FR2_NACK, FR2_R_PEER_FAIL, 0, 0, 0);
+    return ncclSuccess;
+  }
+  if (fr->isSend) {
+    if (m->type == FR2_NOTIFY) {
+      // m->epoch = the last round R accepted. Older than ours: R noticed the incident we are already
+      // handling. Equal or newer: a fresh fault at R (e.g. on the new incarnation before our DONE).
+      if (m->epoch < fr->epoch) return ncclSuccess;
+      if (fr->state == FR2_IDLE) fr2StartIncident(base, (int)m->status, m->vendor, "notify");
+      else { fr->notifyPending = 1; fr->notifyStatus = (int)m->status; fr->notifyVendor = m->vendor; }
+      return ncclSuccess;
+    }
+    if (m->type == FR2_ACK) {
+      if (fr->state != FR2_S_WAIT_ACK || m->epoch != fr->epoch) return ncclSuccess;  // stale
+      fr->tAck = clockNano();
+      fr->psnPeer = m->psn; fr->rDone = m->a; fr->peerFifoTail = m->b;
+      return fr2SendFinish((struct ncclIbSendComm*)base);
+    }
+    fr2Fail(base, FR2_R_PROTO, 1);
+    return ncclSuccess;
+  }
+  // recv comm
+  if (m->type == FR2_REQ) {
+    if (fr->mute) return ncclSuccess;          // test hook: never answer
+    if (m->epoch <= fr->epoch) { fr2Fail(base, FR2_R_PROTO, 1); return ncclSuccess; }
+    if (m->nqps != 1 || m->ndevs != 1) { fr->state = FR2_R_DRAIN_REQ; fr2Fail(base, FR2_R_MULTI, 1); return ncclSuccess; }
+    fr->epoch = m->epoch; fr->psnPeer = m->psn; fr->peerFifoHead = m->a;
+    if (fr->state == FR2_IDLE || fr->state == FR2_R_WAIT_DONE) {
+      // the leader starts a (new) round: drain this incarnation first
+      if (fr->state == FR2_IDLE) { fr->firstStatus = (int)m->status; fr->firstVendor = m->vendor; fr->firstSrc = "req"; fr->tDetect = clockNano(); }
+      fr->errDone = fr->markSqPosted = fr->markRqPosted = fr->markSq = fr->markRq = fr->drained = 0;
+      fr->drainDeadline = clockNano() + fr2Ms(ncclParamRdmaFaultDrainMs());
+    }
+    fr->tReq = clockNano();
+    fr->state = FR2_R_DRAIN_REQ;
+    return ncclSuccess;
+  }
+  if (m->type == FR2_DONE) {
+    if (fr->state != FR2_R_WAIT_DONE || m->epoch != fr->epoch) return ncclSuccess;  // stale
+    NCCLCHECK(fr2CtsRewrite((struct ncclIbRecvComm*)base));
+    if (fr->state == FR2_FAILED) return ncclSuccess;
+    fr->tDone = clockNano();
+    fr->recoveries++;
+    fr->state = FR2_IDLE;
+    WARN("NET/IB: [FAULT-RECOVERY2] recv comm: recovered (epoch %u): R_done=%lu, re-posted %d receive(s), leader replayed %lu, rewrote %d CTS entr%s; "
+         "REQ->ACK %.3f ms, ACK->DONE %.3f ms",
+         fr->epoch, fr->rDone, fr->lastReposted, m->a, fr->lastCts, fr->lastCts == 1 ? "y" : "ies",
+         (fr->tAck - fr->tReq) / 1e6, (fr->tDone - fr->tAck) / 1e6);
+    return ncclSuccess;
+  }
+  fr2Fail(base, FR2_R_PROTO, 1);
+  return ncclSuccess;
+}
+
+// R: re-drive the GPU-flush loopback QP (no peer involved) and re-post the flush READs still
+// outstanding. Same GID re-resolution and path wait as the connection QP.
+static ncclResult_t fr2FlushStep(struct ncclIbRecvComm* comm) {
+  struct ncclIbNetCommBase* base = &comm->base;
+  struct ncclIbFr2* fr = base->fr;
+  struct ncclIbRecvCommDev* rd = comm->devs + 0;
+  struct ibv_qp* fqp = rd->gpuFlush.qp.qp;
+  if (fqp == NULL) { fr->flState = 0; fr2Fail(base, FR2_R_FLUSHQP, 1); return ncclSuccess; }
+  int n;
+  if (fr->flState == 1) {   // drain
+    if (!fr->flErrDone) { if (fr2ModifyState(fqp, IBV_QPS_ERR) != ncclSuccess) { fr2Fail(base, FR2_R_FLUSHQP, 1); return ncclSuccess; } fr->flErrDone = 1; }
+    NCCLCHECK(fr2PollCq(base, &n));
+    if (!fr->flMarkPosted) {
+      struct ibv_send_wr wr, *bad; memset(&wr, 0, sizeof(wr));
+      wr.wr_id = FR2_MARK_FL; wr.opcode = IBV_WR_RDMA_WRITE; wr.send_flags = IBV_SEND_SIGNALED;
+      if (fqp->context->ops.post_send(fqp, &wr, &bad) == 0) fr->flMarkPosted = 1;
+    }
+    NCCLCHECK(fr2PollCq(base, &n));
+    if (fr->flMark) { fr->flState = 2; fr->flNextTry = 0; }
+    else if (clockNano() > fr->flDeadline) fr2Fail(base, FR2_R_DRAIN_TMO, 1);
+    return ncclSuccess;
+  }
+  if (fr->flState == 2) {   // bring-up + re-post
+    if (clockNano() < fr->flNextTry) return ncclSuccess;
+    struct ncclIbNetCommDevBase* db = &rd->base;
+    struct ncclIbDev* ibDev = ncclIbDevs + db->ibDevN;
+    int gidIdx = -1;
+    if (!fr2ResolveLocalGid(db, ibDev, fr->gidVer, &gidIdx)) goto notready;
+    if (gidIdx != db->gidInfo.localGidIndex) {
+      WARN("NET/IB: [FAULT-RECOVERY2] local GID moved from index %d to %d (flush QP)", db->gidInfo.localGidIndex, gidIdx);
+      db->gidInfo.localGidIndex = gidIdx;
+    }
+    {
+      if (fr2ModifyState(fqp, IBV_QPS_RESET) != ncclSuccess) { fr2Fail(base, FR2_R_FLUSHQP, 1); return ncclSuccess; }
+      struct ibv_qp_attr attr; memset(&attr, 0, sizeof(attr));
+      attr.qp_state = IBV_QPS_INIT; attr.pkey_index = ncclParamIbPkey(); attr.port_num = ibDev->portNum;
+      attr.qp_access_flags = IBV_ACCESS_LOCAL_WRITE | IBV_ACCESS_REMOTE_READ;
+      if (wrap_ibv_modify_qp(fqp, &attr, IBV_QP_STATE | IBV_QP_PKEY_INDEX | IBV_QP_PORT | IBV_QP_ACCESS_FLAGS) != ncclSuccess) { fr2Fail(base, FR2_R_FLUSHQP, 1); return ncclSuccess; }
+      struct ncclIbDevInfo devInfo; memset(&devInfo, 0, sizeof(devInfo));
+      devInfo.lid = ibDev->portAttr.lid; devInfo.link_layer = ibDev->portAttr.link_layer; devInfo.ib_port = ibDev->portNum;
+      devInfo.gid = db->gidInfo.localGid; devInfo.mtu = ibDev->portAttr.active_mtu;
+      if (ncclIbRtrQp(fqp, &db->gidInfo, fqp->qp_num, &devInfo, false) != ncclSuccess) goto notready;
+      if (ncclIbRtsQp(fqp) != ncclSuccess) { fr2Fail(base, FR2_R_FLUSHQP, 1); return ncclSuccess; }
+    }
+    {
+      int reposted = 0;
+      for (int i = 0; i < MAX_REQUESTS; i++) {
+        struct ncclIbRequest* r = base->reqs + i;
+        if (r->type != NCCL_NET_IB_REQ_FLUSH || (r->events[0] == 0 && r->events[1] == 0)) continue;
+        struct ibv_send_wr wr, *bad; memset(&wr, 0, sizeof(wr));
+        wr.wr_id = i; wr.wr.rdma.remote_addr = fr->fl[i].addr; wr.wr.rdma.rkey = fr->fl[i].rkey;
+        wr.sg_list = &rd->gpuFlush.sge; wr.num_sge = 1; wr.opcode = IBV_WR_RDMA_READ; wr.send_flags = IBV_SEND_SIGNALED;
+        if (wrap_ibv_post_send(fqp, &wr, &bad) != ncclSuccess) { fr2Fail(base, FR2_R_FLUSHQP, 1); return ncclSuccess; }
+        r->events[0] = 1; r->events[1] = 0; reposted++;
+      }
+      fr->flState = 0; fr->flRecoveries++;
+      WARN("NET/IB: [FAULT-RECOVERY2] recv comm: GPU-flush QP re-driven, %d flush read(s) re-posted", reposted);
+    }
+    return ncclSuccess;
+notready:
+    if (clockNano() > fr->flDeadline) { fr2Fail(base, FR2_R_PATH_TMO, 1); return ncclSuccess; }
+    fr->flNextTry = clockNano() + 20000000ULL;
+  }
+  return ncclSuccess;
+}
+
+// A FAILED comm keeps answering, so the peer fails promptly instead of at its deadline.
+static void fr2ServiceFailed(struct ncclIbNetCommBase* base) {
+  struct ncclIbFr2* fr = base->fr;
+  fr2TxProgress(base);
+  for (int k = 0; k < 4 && fr2RxProgress(base); k++) {
+    if (fr->rx.magic != FR2_MAGIC) { fr->peerClosed = 1; break; }
+    if (fr->rx.type == FR2_REQ) fr2Send(base, FR2_NACK, FR2_R_PEER_FAIL, 0, 0, 0);
+    else if (fr->rx.type == FR2_NOTIFY) fr2Send(base, FR2_FAIL, FR2_R_PEER_FAIL, 0, 0, 0);
+  }
+}
+
+// ---- the state machine (called from test/isend/irecv) ---------------------------
+static ncclResult_t fr2Step(struct ncclIbNetCommBase* base) {
+  struct ncclIbFr2* fr = base->fr;
+  if (fr->state == FR2_FAILED) return ncclSuccess;
+  if (fr->flState) { NCCLCHECK(fr2FlushStep((struct ncclIbRecvComm*)base)); if (fr->state == FR2_FAILED) return ncclSuccess; }
+  uint64_t now = clockNano();
+  fr2TxProgress(base);
+  if (fr->state != FR2_IDLE || now >= fr->nextPoll) {
+    fr->nextPoll = now + fr->pollNs;
+    while (fr->state != FR2_FAILED && fr2RxProgress(base)) NCCLCHECK(fr2Handle(base, &fr->rx));
+    if (fr->state == FR2_FAILED) return ncclSuccess;
+    if (fr->state != FR2_IDLE && fr2PeerDead(base)) { fr2Fail(base, FR2_R_PEER_DEAD, 0); return ncclSuccess; }
+  }
+  if (fr->state != FR2_IDLE && fr2Fatal(base)) { fr2Fail(base, FR2_R_FATAL, 1); return ncclSuccess; }
+  int finished = 0, n = 0;
+  // IDLE + the peer's socket shows FIN/RST (or a keepalive timeout) while requests are outstanding:
+  // the peer process (or node) is gone and will never complete them. Stock NCCL would wait forever
+  // when nothing of ours is in flight (no RETRY_EXC ever comes). A normal teardown has nothing
+  // outstanding; a 50 ms grace with CQ polling covers completions still sitting in the CQ.
+  if (fr->state == FR2_IDLE && fr->peerClosed) {
+    if (!fr2HasOutstanding(base)) fr->finSeenAt = 0;
+    else if (fr->finSeenAt == 0) fr->finSeenAt = clockNano();
+    else if (clockNano() - fr->finSeenAt > 50000000ULL) {
+      NCCLCHECK(fr2PollCq(base, &n));
+      if (fr->state == FR2_IDLE && fr2HasOutstanding(base)) {
+        WARN("NET/IB: [FAULT-RECOVERY2] %s comm: the peer closed its OOB socket (FIN/RST/timeout) while requests are outstanding: peer process gone",
+             fr->isSend ? "send" : "recv");
+        fr2Fail(base, FR2_R_PEER_DEAD, 0);
+        return ncclSuccess;
+      }
+    }
+  }
+  switch (fr->state) {
+    case FR2_S_DRAIN:
+      NCCLCHECK(fr2DrainProgress(base, &finished));
+      if (fr->state != FR2_FAILED && finished) {
+        if (fr->progress == fr->progressAtReq) fr->rounds++; else fr->rounds = 1;
+        fr->progressAtReq = fr->progress;
+        if (fr->rounds > ncclParamRdmaFaultMaxRounds()) { fr2Fail(base, FR2_R_ROUNDS, 1); break; }
+        fr->epoch++;
+        fr->psnLocal = fr2FreshPsn(base->qps[0].qp->qp_num);
+        fr->tReq = clockNano();
+        fr->deadline = fr->tReq + fr2Ms(ncclParamRdmaFaultHandshakeMs()) + fr2Ms(ncclParamRdmaFaultPathWaitMs());
+        fr->state = FR2_S_WAIT_ACK;
+        fr2Send(base, FR2_REQ, 0, ((struct ncclIbSendComm*)base)->fifoHead, 0, fr->psnLocal);
+      }
+      break;
+    case FR2_S_WAIT_ACK:
+      NCCLCHECK(fr2PollCq(base, &n));
+      if (fr->state == FR2_S_WAIT_ACK && clockNano() > fr->deadline) fr2Fail(base, FR2_R_HS_TMO, 1);
+      break;
+    case FR2_S_BRINGUP: {
+      NCCLCHECK(fr2PollCq(base, &n));
+      if (fr->state != FR2_S_BRINGUP || clockNano() < fr->nextTry) break;
+      ncclResult_t br = fr2BringUp(base, fr->psnPeer, fr->psnLocal);
+      if (br == ncclInProgress) {
+        if (clockNano() > fr->pathDeadline) { fr2Fail(base, FR2_R_PATH_TMO, 1); break; }
+        fr->bringupBackoff = std::min<uint64_t>(fr->bringupBackoff ? 2 * fr->bringupBackoff : 20000000ULL, 1000000000ULL);
+        fr->nextTry = clockNano() + fr->bringupBackoff;
+        break;
+      }
+      if (br != ncclSuccess) { fr2Fail(base, FR2_R_VERBS, 1); break; }
+      if (fr->bringupTries > 1)
+        WARN("NET/IB: [FAULT-RECOVERY2] send comm: path usable again after %d bring-up tries", fr->bringupTries);
+      NCCLCHECK(fr2SendApply((struct ncclIbSendComm*)base));
+      break;
+    }
+    case FR2_R_DRAIN_NOTIFY:
+      NCCLCHECK(fr2DrainProgress(base, &finished));
+      if (fr->state != FR2_FAILED && finished) {
+        fr->state = FR2_R_WAIT_REQ;
+        fr->waitReqDeadline = clockNano() + fr2Ms(ncclParamRdmaFaultWaitReqMs());
+        if (!fr->silent) fr2Send(base, FR2_NOTIFY, 0, ((struct ncclIbRecvComm*)base)->remFifo.fifoTail, 0, 0);
+        else WARN("NET/IB: [FAULT-RECOVERY2] recv comm: drained; SILENT test mode: not notifying the leader");
+      }
+      break;
+    case FR2_R_WAIT_REQ:
+      NCCLCHECK(fr2PollCq(base, &n));   // GPU-flush completions keep flowing
+      if (fr->state == FR2_R_WAIT_REQ && clockNano() > fr->waitReqDeadline) fr2Fail(base, FR2_R_HS_TMO, 1);
+      break;
+    case FR2_R_DRAIN_REQ:
+      NCCLCHECK(fr2DrainProgress(base, &finished));
+      if (fr->state != FR2_FAILED && finished) {
+        uint64_t rDone = 0; int ok = 0;
+        NCCLCHECK(fr2RecvReconcile((struct ncclIbRecvComm*)base, &rDone, &ok));
+        if (!ok) break;
+        fr->rDone = rDone;
+        fr->psnLocal = fr2FreshPsn(base->qps[0].qp->qp_num);
+        fr->bringupTries = 0; fr->bringupBackoff = 0;
+        fr->pathDeadline = clockNano() + fr2Ms(ncclParamRdmaFaultPathWaitMs());
+        fr->nextTry = 0;
+        fr->state = FR2_R_BRINGUP;
+      }
+      break;
+    case FR2_R_BRINGUP: {
+      NCCLCHECK(fr2PollCq(base, &n));
+      if (fr->state != FR2_R_BRINGUP || clockNano() < fr->nextTry) break;
+      ncclResult_t br = fr2BringUp(base, fr->psnPeer, fr->psnLocal);
+      if (br == ncclInProgress) {
+        if (clockNano() > fr->pathDeadline) { fr2Fail(base, FR2_R_PATH_TMO, 1); break; }
+        fr->bringupBackoff = std::min<uint64_t>(fr->bringupBackoff ? 2 * fr->bringupBackoff : 20000000ULL, 1000000000ULL);
+        fr->nextTry = clockNano() + fr->bringupBackoff;   // 20 ms doubling to 1 s
+        break;
+      }
+      if (br != ncclSuccess) { fr2Fail(base, FR2_R_VERBS, 1); break; }
+      NCCLCHECK(fr2RecvRepost((struct ncclIbRecvComm*)base));
+      if (fr->state == FR2_FAILED) break;
+      fr->tAck = clockNano();
+      fr->deadline = fr->tAck + 2 * fr2Ms(ncclParamRdmaFaultHandshakeMs()) + fr2Ms(ncclParamRdmaFaultPathWaitMs());
+      fr->state = FR2_R_WAIT_DONE;
+      fr->silent = 0;
+      fr2Send(base, FR2_ACK, 0, fr->rDone, ((struct ncclIbRecvComm*)base)->remFifo.fifoTail, fr->psnLocal);
+      if (fr->bringupTries > 1)
+        WARN("NET/IB: [FAULT-RECOVERY2] recv comm: path usable again after %d bring-up tries", fr->bringupTries);
+      break;
+    }
+    case FR2_R_WAIT_DONE:
+      NCCLCHECK(fr2PollCq(base, &n));
+      if (fr->state == FR2_R_WAIT_DONE && clockNano() > fr->deadline) fr2Fail(base, FR2_R_DONE_TMO, 1);
+      break;
+    default:
+      break;
+  }
+  return ncclSuccess;
+}
