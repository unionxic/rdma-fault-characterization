+// ---- test-injection hooks (independent of the recovery flag) ----------------------
+static int fr2InjSendCount = 0, fr2InjSendFired = 0, fr2InjRecvCount = 0, fr2InjRecvFired = 0;
+
+static void fr2MaybeInjectSend(struct ncclIbNetCommBase* base) {
+  int64_t k = ncclParamRdmaFaultInject();
+  if (k <= 0) return;
+  int64_t reps = std::max<int64_t>(1, ncclParamRdmaFaultInjectRepeat()), per = ncclParamRdmaFaultInjectPeriod();
+  int fired = __atomic_load_n(&fr2InjSendFired, __ATOMIC_RELAXED);
+  if (fired >= reps) return;
+  int c = __atomic_add_fetch(&fr2InjSendCount, 1, __ATOMIC_RELAXED);
+  if (c == k + fired * per && (fired == 0 || per > 0)) {
+    __atomic_add_fetch(&fr2InjSendFired, 1, __ATOMIC_RELAXED);
+    ncclResult_t ir = fr2ModifyState(base->qps[0].qp, IBV_QPS_ERR);
+    WARN("NET/IB: [FAULT-INJECT] forced send QP (qpn=%u) to ERR before multi-send #%d (injection %d/%ld, rc=%d)",
+         base->qps[0].qp->qp_num, c, fired + 1, reps, ir);
+  }
+}
+
+static void fr2MaybeInjectRecv(struct ncclIbNetCommBase* base) {
+  int64_t k = ncclParamRdmaFaultInjectRecv();
+  if (k <= 0 || ncclParamRdmaFaultInjectRecvSilent() || __atomic_load_n(&fr2InjRecvFired, __ATOMIC_RELAXED)) return;
+  int c = __atomic_add_fetch(&fr2InjRecvCount, 1, __ATOMIC_RELAXED);
+  if (c == k && !__atomic_exchange_n(&fr2InjRecvFired, 1, __ATOMIC_RELAXED)) {
+    ncclResult_t ir = fr2ModifyState(base->qps[0].qp, IBV_QPS_ERR);
+    WARN("NET/IB: [FAULT-INJECT] forced recv QP (qpn=%u) to ERR before receive post #%d (rc=%d)", base->qps[0].qp->qp_num, c, ir);
+  }
+}
+
+// ncclIbTest with the flag on.
+static ncclResult_t fr2Test(struct ncclIbRequest* r, int* done, int* sizes) {
+  struct ncclIbNetCommBase* base = r->base;
+  struct ncclIbFr2* fr = base->fr;
+  *done = 0;
+  if (fr->state != FR2_FAILED && fr2Fatal(base)) fr2Fail(base, FR2_R_FATAL, 1);
+  if (fr->state == FR2_FAILED) {
+    NCCLCHECK(ncclIbStatsCheckFatalCount(&base->stats, __func__));
+    return ncclRemoteError;
+  }
+  NCCLCHECK(fr2Step(base));
+  for (int iter = 0; iter < 64; iter++) {
+    if (fr->state == FR2_FAILED) return ncclRemoteError;
+    if (r->events[0] == 0 && r->events[1] == 0) {
+      *done = 1;
+      if (sizes && r->type == NCCL_NET_IB_REQ_RECV) for (int i = 0; i < r->nreqs; i++) sizes[i] = r->recv.sizes[i];
+      if (sizes && r->type == NCCL_NET_IB_REQ_SEND) sizes[0] = r->send.size;
+      NCCLCHECK(ncclIbFreeRequest(r));
+      return ncclSuccess;
+    }
+    if (fr->state != FR2_IDLE) return ncclSuccess;   // recovery in progress: fr2Step polls the CQ
+    int n = 0;
+    NCCLCHECK(fr2PollCq(base, &n));
+    if ((fr->state != FR2_IDLE && fr->state != FR2_FAILED) || fr->flState) NCCLCHECK(fr2Step(base));
+    if (n == 0) return ncclSuccess;
+  }
+  return ncclSuccess;
+}
