+/* =====================================================================
+ * [RDMA-FAULT-RECOVERY Stage 2] in-tree recovery with many requests in flight.
+ * Design: harness/nccl-integration/stage2/DESIGN_stage2.md (rdma-error repo).
+ *
+ * Opt-in: NCCL_RDMA_FAULT_RECOVERY=1. With it unset/0, base->fr stays NULL and every hook below
+ * is skipped: the transport makes the same verbs calls as stock v2.23.4-1. With it on, a comm
+ * whose configuration is supported (1 QP, 1 NIC, no adaptive routing) gets a side allocation
+ * (struct ncclIbFr2) and:
+ *  - every CQE of the comm's CQ goes through fr2PollCq(): drain markers and FR tags first, the
+ *    stock accounting for successes, and the first error CQE of an incident starts a recovery
+ *    instead of failing the comm (WR_FLUSH, or RETRY_EXC with the peer alive);
+ *  - the send comm S always leads: drain (QP->ERR + marker, like ib_drain_qp), REQ; the recv
+ *    comm R drains, reconciles (R_done = last receive that completed; pending receives are a
+ *    suffix), resets, re-posts the pending receives, ACKs; S resets, completes the groups R got,
+ *    replays the others in FIFO order, DONE; R then rewrites the CTS entries S may lack;
+ *  - R that detects first drains and sends NOTIFY; S leads when it next runs;
+ *  - isend()/irecv() return a NULL request while a recovery runs; test() returns not-done;
+ *  - bounded: handshake deadline, drain deadline, max rounds without progress; peer death via
+ *    FIN/RST and TCP keepalive on base.sock.
+ * Test hooks (work with the recovery flag off too, to drive the stock error path):
+ *  NCCL_RDMA_FAULT_INJECT=k [_REPEAT=n _PERIOD=p]: force the send QP to ERR before multi-send k
+ *  NCCL_RDMA_FAULT_INJECT_RECV=k: force the recv QP to ERR before receive post k
+ *  NCCL_RDMA_FAULT_INJECT_RECV_SILENT=1: ... and R does not NOTIFY (S then sees RETRY_EXC)
+ *  NCCL_RDMA_FAULT_TEST_MUTE=1: R never answers a REQ (live but unresponsive peer)
+ * ===================================================================== */
+NCCL_PARAM(RdmaFaultRecovery, "RDMA_FAULT_RECOVERY", 0);
+NCCL_PARAM(RdmaFaultHandshakeMs, "RDMA_FAULT_HANDSHAKE_MS", 5000);
+NCCL_PARAM(RdmaFaultDrainMs, "RDMA_FAULT_DRAIN_MS", 1000);
+NCCL_PARAM(RdmaFaultMaxRounds, "RDMA_FAULT_MAX_ROUNDS", 8);
+NCCL_PARAM(RdmaFaultPollUs, "RDMA_FAULT_POLL_US", 100);
+NCCL_PARAM(RdmaFaultKeepaliveMs, "RDMA_FAULT_KEEPALIVE_MS", 5000);
+NCCL_PARAM(RdmaFaultPathWaitMs, "RDMA_FAULT_PATH_WAIT_MS", 30000);
+NCCL_PARAM(RdmaFaultWaitReqMs, "RDMA_FAULT_WAITREQ_MS", 120000);
+NCCL_PARAM(RdmaFaultInject, "RDMA_FAULT_INJECT", 0);
+NCCL_PARAM(RdmaFaultInjectRepeat, "RDMA_FAULT_INJECT_REPEAT", 1);
+NCCL_PARAM(RdmaFaultInjectPeriod, "RDMA_FAULT_INJECT_PERIOD", 0);
+NCCL_PARAM(RdmaFaultInjectRecv, "RDMA_FAULT_INJECT_RECV", 0);
+NCCL_PARAM(RdmaFaultInjectRecvSilent, "RDMA_FAULT_INJECT_RECV_SILENT", 0);
+NCCL_PARAM(RdmaFaultTestMute, "RDMA_FAULT_TEST_MUTE", 0);
+
+#define FR2_MARK_SQ 0xFEFEFEFEFEFEFE01ULL  // stock wr_ids are < 256 or pack distinct request indices
+#define FR2_MARK_RQ 0xFEFEFEFEFEFEFE02ULL
+#define FR2_CTS_TAG 0xFEFEFEFEFEFEFE03ULL
+#define FR2_MARK_FL 0xFEFEFEFEFEFEFE04ULL  // drain marker of the GPU-flush QP
+#define FR2_MAGIC 0x46523253u               // "FR2S"
+
+enum { FR2_NOTIFY = 1, FR2_REQ = 2, FR2_ACK = 3, FR2_NACK = 4, FR2_DONE = 5, FR2_FAIL = 6, FR2_HELLO = 7 };
+static const char* fr2MsgStr(uint32_t t) {
+  switch (t) { case FR2_NOTIFY: return "NOTIFY"; case FR2_REQ: return "REQ"; case FR2_ACK: return "ACK";
+    case FR2_NACK: return "NACK"; case FR2_DONE: return "DONE"; case FR2_FAIL: return "FAIL"; case FR2_HELLO: return "HELLO"; default: return "?"; }
+}
+
+struct ncclIbFr2Msg {
+  uint32_t magic, type, epoch, reason;
+  uint64_t a, b;
+  uint32_t psn, nqps, ndevs, status, vendor, flags;
+};
+static_assert(sizeof(struct ncclIbFr2Msg) == 56, "FR2 message size");
+
+enum ncclIbFr2State {
+  FR2_IDLE = 0,
+  FR2_S_DRAIN, FR2_S_WAIT_ACK, FR2_S_BRINGUP,                               // send comm (leader)
+  FR2_R_DRAIN_NOTIFY, FR2_R_WAIT_REQ, FR2_R_DRAIN_REQ, FR2_R_BRINGUP, FR2_R_WAIT_DONE,  // recv comm
+  FR2_FAILED
+};
+static const char* fr2StateStr(int s) {
+  switch (s) { case FR2_IDLE: return "IDLE"; case FR2_S_DRAIN: return "S_DRAIN"; case FR2_S_WAIT_ACK: return "S_WAIT_ACK";
+    case FR2_R_DRAIN_NOTIFY: return "R_DRAIN_NOTIFY"; case FR2_R_WAIT_REQ: return "R_WAIT_REQ"; case FR2_R_DRAIN_REQ: return "R_DRAIN_REQ";
+    case FR2_R_WAIT_DONE: return "R_WAIT_DONE"; case FR2_S_BRINGUP: return "S_BRINGUP"; case FR2_R_BRINGUP: return "R_BRINGUP";
+    case FR2_FAILED: return "FAILED"; default: return "?"; }
+}
+
+enum {  // reasons (FAIL/NACK and logs)
+  FR2_R_NONE = 0, FR2_R_CLASS = 1, FR2_R_PEER_DEAD = 2, FR2_R_FATAL = 3, FR2_R_DRAIN_TMO = 4, FR2_R_HS_TMO = 5,
+  FR2_R_PROTO = 6, FR2_R_INCONSISTENT = 7, FR2_R_MULTI = 8, FR2_R_VERBS = 9, FR2_R_ROUNDS = 10, FR2_R_PEER_FAIL = 11,
+  FR2_R_FLUSHQP = 12, FR2_R_DONE_TMO = 13, FR2_R_PATH_TMO = 14, FR2_R_PEER_OFF = 15
+};
+static const char* fr2ReasonStr(uint32_t r) {
+  switch (r) {
+    case FR2_R_CLASS: return "fault class not recoverable";
+    case FR2_R_PEER_DEAD: return "peer dead (FIN/RST/keepalive)";
+    case FR2_R_FATAL: return "async fatal event on comm/device";
+    case FR2_R_DRAIN_TMO: return "drain marker not seen before the deadline";
+    case FR2_R_HS_TMO: return "no ACK before the handshake deadline";
+    case FR2_R_PROTO: return "protocol error";
+    case FR2_R_INCONSISTENT: return "reconciliation found an inconsistent state";
+    case FR2_R_MULTI: return "unsupported group (nreqs>1)";
+    case FR2_R_VERBS: return "verbs call failed during recovery";
+    case FR2_R_ROUNDS: return "too many rounds without progress";
+    case FR2_R_PEER_FAIL: return "peer failed or declined";
+    case FR2_R_FLUSHQP: return "error on the GPU-flush QP";
+    case FR2_R_DONE_TMO: return "no DONE before the deadline";
+    case FR2_R_PATH_TMO: return "local GID / path did not come back before the deadline";
+    case FR2_R_PEER_OFF: return "the peer has recovery off (no HELLO)";
+    default: return "unspecified";
+  }
+}
+
+struct ncclIbFr2ReqInfo { uint64_t idx; int arrived; };
+struct ncclIbFr2Group { uint64_t idx; uint64_t addr; uint32_t rkey; int nreqs; int reqIdx; int remSize; };
+
+struct ncclIbFr2 {
+  pthread_mutex_t lock;          // serialises the proxy thread's calls and the helper thread
+  struct ncclIbFr2* next;        // helper-thread list
+  struct ncclIbNetCommBase* base;
+  uint64_t waitReqDeadline;      // R in WAIT_REQ
+  int peerHello;                 // the peer runs Stage 2 on this connection
+  int notifyPending; int notifyStatus; uint32_t notifyVendor;   // S: a NOTIFY for a new incident seen mid-round
+  int gidVer;                    // RoCE version of the connect-time local GID entry
+  uint64_t bringupBackoff;       // ns, grows while the path is not usable
+  uint64_t finSeenAt;            // IDLE: when a FIN/RST was first seen while requests were outstanding
+  int injSilentArmed;            // R: silent injection pending (fires at a receive completion)
+  int isSend;
+  int state;
+  uint32_t epoch;            // S: last REQ sent; R: last REQ accepted
+  int rounds;                // S: consecutive rounds without progress
+  uint64_t progress, progressAtReq;  // S: success group completions
+  uint64_t deadline;         // handshake / DONE deadline (ns)
+  uint64_t nextPoll;         // socket poll throttle in IDLE (ns)
+  uint64_t pollNs;
+  uint32_t psnLocal, psnPeer;
+  // incident / drain
+  int errDone, markSqPosted, markRqPosted, markSq, markRq, drained;
+  uint64_t drainDeadline;
+  int silent, mute;
+  int firstStatus; uint32_t firstVendor; const char* firstSrc;
+  uint64_t tDetect, tDrained, tReq, tAck, tDone;
+  uint64_t peerFifoHead;     // R: from REQ
+  uint64_t rDone, peerFifoTail;  // S: from ACK
+  uint64_t ctsFrom;          // R: rewrite CTS for idx >= ctsFrom after DONE
+  int recoveries, lastReplayed, lastCompleted, lastReposted, lastCts;
+  uint64_t pathDeadline, nextTry; int bringupTries;
+  int pend[MAX_REQUESTS]; int npend;   // R: pending receives (request indices) in FIFO order
+  // R: local recovery of the GPU-flush (loopback) QP
+  int flState, flErrDone, flMarkPosted, flMark, flRecoveries; uint64_t flDeadline, flNextTry;
+  struct { uint64_t addr; uint32_t rkey; } fl[MAX_REQUESTS];   // READ target of each flush request
+  // OOB socket
+  struct ncclIbFr2Msg rx; int rxOff;
+  struct ncclIbFr2Msg txq[8]; int txHead, txCount, txOff;
+  int peerClosed;
+  // connect-time attributes of qps[0]
+  uint32_t remQpn; int accessFlags; int eceSet; struct ibv_ece ece; bool overrideTc;
+  // side arrays
+  struct ncclIbFr2ReqInfo req[MAX_REQUESTS];
+  struct ncclIbFr2Group grp[MAX_REQUESTS];   // S: by FIFO slot
+};
+
+static inline uint64_t fr2Ms(int64_t ms) { return (uint64_t)(ms > 0 ? ms : 1) * 1000000ULL; }
+
+static uint32_t fr2FreshPsn(uint32_t salt) {
+  uint64_t x = 0;
+  if (getRandomData(&x, sizeof(x)) != ncclSuccess) x = clockNano();
+  x ^= ((uint64_t)salt << 32) ^ clockNano();
+  x += 0x9e3779b97f4a7c15ULL;
+  x = (x ^ (x >> 30)) * 0xbf58476d1ce4e5b9ULL;
+  x = (x ^ (x >> 27)) * 0x94d049bb133111ebULL;
+  x ^= x >> 31;
+  uint32_t psn = (uint32_t)(x & 0xFFFFFFu);
+  return psn ? psn : 1;
+}
+
+// TCP keepalive + user timeout on the OOB socket, so a peer node that dies without FIN/RST
+// (crash, power loss, partition) shows up as ETIMEDOUT within about `ms`.
+static void fr2Keepalive(int fd, int64_t ms) {
+  if (fd < 0 || ms <= 0) return;
+  int one = 1, idle = (int)std::max<int64_t>(1, (ms * 2 / 5) / 1000), intvl = (int)std::max<int64_t>(1, (ms / 5) / 1000), cnt = 3;
+  unsigned int uto = (unsigned int)ms;
+  if (setsockopt(fd, SOL_SOCKET, SO_KEEPALIVE, &one, sizeof(one)) ||
+      setsockopt(fd, IPPROTO_TCP, TCP_KEEPIDLE, &idle, sizeof(idle)) ||
+      setsockopt(fd, IPPROTO_TCP, TCP_KEEPINTVL, &intvl, sizeof(intvl)) ||
+      setsockopt(fd, IPPROTO_TCP, TCP_KEEPCNT, &cnt, sizeof(cnt)) ||
+      setsockopt(fd, IPPROTO_TCP, TCP_USER_TIMEOUT, &uto, sizeof(uto)))
+    WARN("NET/IB: [FAULT-RECOVERY2] setting keepalive on the OOB socket failed: %s", strerror(errno));
+}
+
+// ---- helper thread ---------------------------------------------------------------
+// NCCL calls a comm only while it has an active op, so a comm with nothing pending would never read a
+// NOTIFY/REQ. One helper thread per process serves every recovery-enabled comm: it waits on their OOB
+// sockets and steps any comm that has input or a recovery in progress. It only uses trylock, and the
+// proxy hooks use trylock too (they return not-done / a NULL request when the helper holds the lock),
+// so neither thread ever blocks the other.
+static pthread_mutex_t fr2ListLock = PTHREAD_MUTEX_INITIALIZER;
+static struct ncclIbFr2* fr2List = NULL;
+static pthread_t fr2HelperThread;
+static int fr2HelperStarted = 0;
+static ncclResult_t fr2Step(struct ncclIbNetCommBase* base);
+static void fr2ServiceFailed(struct ncclIbNetCommBase* base);
+static ncclResult_t fr2ModifyState(struct ibv_qp* qp, enum ibv_qp_state s);
+static void fr2Send(struct ncclIbNetCommBase* base, uint32_t type, uint32_t reason, uint64_t a, uint64_t b, uint32_t psn);
+static void fr2Fail(struct ncclIbNetCommBase* base, uint32_t reason, int notify);
+
+static inline int fr2Busy(struct ncclIbFr2* fr) {
+  return (fr->state != FR2_IDLE && fr->state != FR2_FAILED) || fr->flState;
+}
+
+static void* fr2HelperMain(void*) {
+  std::vector<struct pollfd> pfd;
+  std::vector<int> ready;
+  std::vector<struct ncclIbFr2*> work;
+  while (1) {
+    pfd.clear(); ready.clear(); work.clear();
+    int busy = 0;
+    pthread_mutex_lock(&fr2ListLock);
+    for (struct ncclIbFr2* fr = fr2List; fr; fr = fr->next) {
+      if (fr2Busy(fr)) busy = 1;
+      else if (!fr->peerClosed && fr->base->sock.fd >= 0) { struct pollfd p; p.fd = fr->base->sock.fd; p.events = POLLIN; p.revents = 0; pfd.push_back(p); }
+    }
+    pthread_mutex_unlock(&fr2ListLock);
+    if (busy) usleep(200);
+    int nready = pfd.empty() ? 0 : poll(pfd.data(), pfd.size(), busy ? 0 : 2);
+    if (pfd.empty() && !busy) { usleep(2000); continue; }
+    if (!busy && nready <= 0) continue;
+    for (auto& p : pfd) if (p.revents) ready.push_back(p.fd);
+    // pick the comms to serve under the list lock (only live ones), serve them outside it: fr2Detach
+    // unregisters under the list lock and then waits for the comm lock we hold, so fr stays valid
+    pthread_mutex_lock(&fr2ListLock);
+    for (struct ncclIbFr2* fr = fr2List; fr; fr = fr->next) {
+      int need = fr2Busy(fr) || std::find(ready.begin(), ready.end(), fr->base->sock.fd) != ready.end();
+      if (need && pthread_mutex_trylock(&fr->lock) == 0) work.push_back(fr);
+    }
+    pthread_mutex_unlock(&fr2ListLock);
+    for (struct ncclIbFr2* fr : work) {
+      if (fr->state == FR2_FAILED) fr2ServiceFailed(fr->base);
+      else { fr->nextPoll = 0; if (fr2Step(fr->base) != ncclSuccess) fr2Fail(fr->base, FR2_R_VERBS, 1); }
+      pthread_mutex_unlock(&fr->lock);
+    }
+  }
+  return NULL;
+}
+
+static void fr2Register(struct ncclIbFr2* fr) {
+  pthread_mutex_lock(&fr2ListLock);
+  fr->next = fr2List; fr2List = fr;
+  if (!fr2HelperStarted) {
+    if (pthread_create(&fr2HelperThread, NULL, fr2HelperMain, NULL) == 0) {
+      pthread_detach(fr2HelperThread);
+      ncclSetThreadName(fr2HelperThread, "NCCL IbFR2");
+      fr2HelperStarted = 1;
+    } else WARN("NET/IB: [FAULT-RECOVERY2] helper thread not started; idle comms recover only when NCCL calls them");
+  }
+  pthread_mutex_unlock(&fr2ListLock);
+}
+
+static void fr2Unregister(struct ncclIbFr2* fr) {
+  pthread_mutex_lock(&fr2ListLock);
+  for (struct ncclIbFr2** p = &fr2List; *p; p = &(*p)->next) if (*p == fr) { *p = fr->next; break; }
+  pthread_mutex_unlock(&fr2ListLock);
+}
