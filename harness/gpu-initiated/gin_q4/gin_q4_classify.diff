# GIN Q4 for NCCL GIN GDAKI (research build): CQ-shape knob + device-side error-CQE
# classification with a host mailbox. All env-gated, default OFF (= stock behaviour).
#
# base tag: v2.32.3-1  commit: 12df1a11afad322be5a204a2db890161cbf8131d
# LAYERED on top of ../gin/gin_fault_inject.diff (the Q2 fault-injection hook); apply both
# from the NCCL source root, in this order:
#   git apply ../gin/gin_fault_inject.diff && git apply gin_q4_classify.diff
#
# env:
#   NCCL_GIN_GDAKI_CQ_TYPE=ring|collapsed|collapsed_host[_force]   (unset/ring = stock ring CQ)
#       collapsed      DOCA_GPUNETIO_VERBS_CQ_64B_COLLAPSED (cc=1, GPU memory); also passes
#                      DOCA_GPUNETIO_VERBS_GPU_CODE_OPT_CPU_PROXY_UPDATE_PI for collapsed CQs,
#                      without which DOCA's collapsed blocking poll spins forever in CPU-proxy
#                      doorbell mode (measured: stall at the first SQ wrap, 64 put+signal)
#       collapsed_host DOCA_GPUNETIO_VERBS_CQ_64B_COLLAPSED_HOST; refused unless GDRCopy is
#                      available (_force tries anyway)
#   NCCL_GIN_FAULT_CLASSIFY=1          device classification + host mailbox (default 0)
#   NCCL_GIN_FAULT_CLASSIFY_POLL_US=N  host mailbox poll period in us (default 20)
#   NCCL_GIN_Q4_QPWATCH_MS=N           diagnostic: watcher logs peer-QP state transitions (default 0)
#   NCCL_GIN_Q4_LATE_READ_US=N         diagnostic, collapsed CQ: re-read slot 0 N us after detection (default 0)
#
# files:
#   include/nccl_device/gin/gdaki/gin_gdaki_device_host_common.h  mailbox record (256 B), device
#       control block, class ids; new GPU-context field `fault` (nullptr = off)
#   include/nccl_device/gin/gdaki/gin_gdaki.h  q4Classify/q4Report (reads the error CQE: syndrome
#       byte 55, vendor_err 54, qpn 57-59, wqe_counter 60-61; ring: scans [cqe_ci, ticket] for the
#       first error CQE = root cause), -EIO handling in the timeout wait/flush and in the blocking
#       wait (status-returning DOCA poll instead of the void doca_gpu_dev_verbs_wait), sticky
#       per-context error, ncclGinApi_QueryError<GDAKI>, collapsed-CQ code option
#   include/nccl_device/gin/gin_device_common.h  ncclGinApi_QueryError primary template (ncclSuccess)
#   include/nccl_device/gin.h, impl/gin__funcs.h  blocking ncclGin::flush()/wait() now return
#       ncclResult_t (source compatible): ncclRemoteError after a classified error CQE
#   transport/net_ib/gdaki/gin_host_gdaki.cc  CQ-type knob, mailbox alloc (ncclCudaHostCalloc,
#       mapped) + watcher thread (WARN with fingerprint/class/action, sets the GIN async result,
#       direct QUERY_QP), queryLastError returns the classified error without the 10 s throttle
#   gin/gin_host.cc  thread-local pointer to comm->sharedRes->ginState.asyncResult for the watcher
#
