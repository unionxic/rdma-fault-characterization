+  case 0x05: return 5;   // IBV_WC_WR_FLUSH_ERR
+  case 0x06: return 6;   // IBV_WC_MW_BIND_ERR
+  case 0x10: return 7;   // IBV_WC_BAD_RESP_ERR
+  case 0x11: return 8;   // IBV_WC_LOC_ACCESS_ERR
+  case 0x12: return 9;   // IBV_WC_REM_INV_REQ_ERR
+  case 0x13: return 10;  // IBV_WC_REM_ACCESS_ERR
+  case 0x14: return 11;  // IBV_WC_REM_OP_ERR
+  case 0x15: return 12;  // IBV_WC_RETRY_EXC_ERR
+  case 0x16: return 13;  // IBV_WC_RNR_RETRY_EXC_ERR
+  case 0x22: return 16;  // IBV_WC_REM_ABORT_ERR
+  default: return 21;    // IBV_WC_GENERAL_ERR
+  }
+}
+
+struct gdakiQ4ClassText {
+  const char* name;
+  const char* fault;
+  const char* cause;
+  const char* action;
+};
+
+// Wording of cause/action follows harness/common/probe.c classify().
+static gdakiQ4ClassText gdakiQ4Class(uint8_t cls, uint8_t vendor) {
+  switch (cls) {
+  case NCCL_GIN_Q4_CLASS_LOCAL_QP_ERR:
+    return {"LOCAL_QP_ERR", "local_err", "WR flushed (local QP left RTS, e.g. forced ERR); head-of-SQ WQE (vendor 0xf5)",
+            "drain CQ, QP-only recover, repost"};
+  case NCCL_GIN_Q4_CLASS_FLUSH_TRAILING:
+    return {"FLUSH_TRAILING", "unknown",
+            "WR flushed behind an earlier error (vendor 0xf9); no root-cause CQE in the polled window",
+            "query QP state and peer liveness; drain CQ, QP-only recover, repost"};
+  case NCCL_GIN_Q4_CLASS_FLUSH_OTHER:
+    return {"WR_FLUSH", "local_err?", "WR flushed (local QP left RTS, e.g. forced ERR)", "drain CQ, QP-only recover, repost"};
+  case NCCL_GIN_Q4_CLASS_REM_ACCESS:
+    return {"REM_ACCESS", "rem_access",
+            vendor == 0x88 ? "remote access: invalid rkey or out-of-bounds addr" : "remote access violation",
+            "refresh rkey / clamp to remote MR bounds, QP-only recover"};
+  case NCCL_GIN_Q4_CLASS_RETRY_EXC:
+    return {"RETRY_EXC", "peer_err|proc_kill",
+            "transport retries exhausted (no ACK): responder QP ERR, process dead, or link down",
+            "probe peer liveness (counters/ctrl); if dead -> human intervention, else QP-only"};
+  case NCCL_GIN_Q4_CLASS_REM_INV_REQ:
+    return {"REM_INV_REQ", "rem_inv_req", "remote invalid request (malformed WR / len / opcode)",
+            "fix request params, QP-only recover"};
+  case NCCL_GIN_Q4_CLASS_RNR_RETRY_EXC:
+    return {"RNR_RETRY_EXC", "rnr", "RNR retries exhausted (responder had no recv WQE)",
+            "ensure remote posts recvs, QP-only recover"};
+  case NCCL_GIN_Q4_CLASS_LOC_PROT:
+    return {"LOC_PROT", "loc_prot", "local protection (bad lkey / local MR bounds)", "fix local MR/lkey, QP-only recover"};
+  case NCCL_GIN_Q4_CLASS_LOC_LEN:
+    return {"LOC_LEN", "loc_len", "local length error", "fix SGE length, QP-only recover"};
+  case NCCL_GIN_Q4_CLASS_NO_ERR_CQE:
+    return {"NO_ERR_CQE", "-", "device wait expired and no error CQE was at the polled CQ index",
+            "nothing to classify from the CQ; host must query QP state / peer liveness"};
+  default:
+    return {"OTHER", "other", "other", "inspect status+vendor_err"};
+  }
+}
+
+static const char* gdakiQ4PathStr(uint8_t p) {
+  switch (p) {
+  case NCCL_GIN_Q4_PATH_WAIT_TIMEOUT: return "wait-timeout";
+  case NCCL_GIN_Q4_PATH_FLUSH_TIMEOUT: return "flush-timeout";
+  case NCCL_GIN_Q4_PATH_WAIT_BLOCKING: return "wait-blocking";
+  case NCCL_GIN_Q4_PATH_FLUSH_BLOCKING: return "flush-blocking";
+  case NCCL_GIN_Q4_PATH_ABORTABLE: return "abortable";
+  default: return "?";
+  }
+}
+
+static const char* gdakiQ4CqStr(uint8_t t) {
+  switch (t) {
+  case DOCA_GPUNETIO_VERBS_CQ_64B: return "ring";
+  case DOCA_GPUNETIO_VERBS_CQ_64B_COLLAPSED: return "collapsed";
+  case DOCA_GPUNETIO_VERBS_CQ_64B_COLLAPSED_HOST: return "collapsed_host";
+  default: return "?";
+  }
+}
+
+// Visit this rank's peer-connected main QPs (same set as the fault hook).
+template <typename F>
+static void gdakiQ4ForPeerQps(struct gdaki_context* g, F fn) {
+  const int nranks = g->collComm->nranks;
+  const int rankOff = g->rank % g->rankStride;
+  for (int c = 0; c < g->nContexts; c++) {
+    for (int r = 0; r < nranks; r++) {
+      if (r == g->rank || (r % g->rankStride) != rankOff) continue;
+      struct doca_gpu_verbs_qp_hl* q = g->gqps ? g->gqps[r + c * nranks] : nullptr;
+      if (q && q->qp && q->qp_gverbs) fn(q);
+    }
+  }
+}
+
+// Host QP state by QUERY_QP (doca_gpu_verbs_query_last_error: has_error = state==ERR).
+static int gdakiQ4QpErr(struct doca_gpu_verbs_qp_hl* q, double* us) {
+  struct doca_gpu_verbs_qp_error_info info;
+  double t0 = gdakiQ4MonoMs();
+  doca_error_t s = doca_gpu_verbs_query_last_error(q->qp_gverbs, &info);
+  if (us) *us = (gdakiQ4MonoMs() - t0) * 1e3;
+  if (s != DOCA_SUCCESS) return -1;
+  return info.has_error ? 1 : 0;
+}
+
+static void gdakiQ4Handle(struct gdakiQ4Host* q, const struct ncclGinGdakiQ4Record& r, double monoMs) {
+  struct gdaki_context* g = q->ctx;
+  const bool isErr = (r.kind == NCCL_GIN_Q4_KIND_ERR_CQE);
+  if (isErr) {
+    // Make ncclCommGetAsyncError report it now: the GIN async result (read when GIN proxy
+    // threads exist) and the flag consulted by ncclGinGdakiQueryLastError (always).
+    q->hasError.store(1, std::memory_order_release);
+    if (q->asyncResult) __atomic_store_n(q->asyncResult, ncclRemoteError, __ATOMIC_RELEASE);
+    q->nErr++;
+  } else {
+    q->nDump++;
+  }
+  if (++q->nLogged > 64) return;  // bounded logging; counts are kept
+  const bool rootErr = (r.root_opcode == 0xd || r.root_opcode == 0xe);
+  const gdakiQ4ClassText ct = gdakiQ4Class(r.cls, r.vendor_err);
+  const int st = rootErr ? gdakiQ4WcStatus(r.syndrome) : 0;
+  WARN("GIN/Q4: %s rank=%d seq=%u ctx=%u peer=%u qpn=%#x wqe=%u path=%s cq=%s fp=%d/%#x syndrome=%#x hw_err=%#x/%#x "
+       "class=%s fault=%s cause=\"%s\" action=\"%s\" root_op=%#x polled[wqe=%u op=%#x syn=%#x ve=%#x] "
+       "window[err=%u ok=%u root_idx=%lu ticket=%lu cqe_ci=%lu] cq_buffer_err=%u/%u gtimer_ns=%lu mono_ms=%.3f",
+       isErr ? "device-classified error CQE" : "device wait-timeout dump", g->rank, r.seq, r.ctx_id, r.peer, r.qpn,
+       r.wqe_counter, gdakiQ4PathStr(r.path), gdakiQ4CqStr(r.cq_type), st, rootErr ? r.vendor_err : 0,
+       rootErr ? r.syndrome : 0, r.hw_err_synd, r.hw_synd_type, ct.name, ct.fault, ct.cause, ct.action, r.root_opcode,
+       r.polled_wqe_counter, r.polled_opcode, r.polled_syndrome, r.polled_vendor_err, r.n_err_window, r.n_ok_window,
+       (unsigned long)r.root_index, (unsigned long)r.ticket, (unsigned long)r.cqe_ci, r.n_err_buffer, r.cqe_num,
+       (unsigned long)r.gtimer_ns, monoMs);
+  if (r.late_valid)
+    WARN("GIN/Q4: collapsed slot re-read rank=%d seq=%u late[wqe=%u op=%#x syn=%#x ve=%#x after_us=%.1f]", g->rank,
+         r.seq, r.late_wqe_counter, r.late_opcode, r.late_syndrome, r.late_vendor_err, r.late_delay_ns / 1e3);
+  // Diagnostic: direct host QUERY_QP of the QP the record came from.
+  gdakiQ4ForPeerQps(g, [&](struct doca_gpu_verbs_qp_hl* qh) {
+    uint32_t qpn = 0;
+    if (doca_verbs_qp_get_qpn(qh->qp, &qpn) != DOCA_SUCCESS || qpn != r.qpn) return;
+    double us = 0;
+    int e = gdakiQ4QpErr(qh, &us);
+    WARN("GIN/Q4: host QUERY_QP rank=%d qpn=%#x state=%s query_us=%.0f mono_ms=%.3f", g->rank, qpn,
+         e < 0 ? "query-failed" : e ? "ERR" : "not-ERR", us, gdakiQ4MonoMs());
+  });
+}
+
+static void gdakiQ4Watch(struct gdakiQ4Host* q) {
+  volatile uint32_t* words = (volatile uint32_t*)q->rec_h;
+  const int wpr = sizeof(struct ncclGinGdakiQ4Record) / 4;
+  std::vector<int> qpState;
+  double nextWatch = gdakiQ4MonoMs();
+  while (!q->stop.load(std::memory_order_acquire)) {
+    for (int s = 0; s < NCCL_GIN_GDAKI_Q4_NSLOTS; s++) {
+      volatile uint32_t* w = words + s * wpr;
+      const uint32_t magic = w[0], seq = w[1];
+      if (magic != NCCL_GIN_GDAKI_Q4_MAGIC || seq == 0 || seq == q->lastSeq[s]) continue;
+      const double monoMs = gdakiQ4MonoMs();
+      std::atomic_thread_fence(std::memory_order_acquire);
+      struct ncclGinGdakiQ4Record r;
+      uint32_t* dst = (uint32_t*)&r;
+      for (int i = 0; i < wpr; i++) dst[i] = w[i];
+      std::atomic_thread_fence(std::memory_order_acquire);
+      if (w[1] != seq || w[0] != NCCL_GIN_GDAKI_Q4_MAGIC) continue;  // being rewritten; next round
+      q->lastSeq[s] = seq;
+      gdakiQ4Handle(q, r, monoMs);
+    }
+    if (q->qpWatchMs > 0 && gdakiQ4MonoMs() >= nextWatch) {
+      nextWatch += q->qpWatchMs;
+      int i = 0;
+      gdakiQ4ForPeerQps(q->ctx, [&](struct doca_gpu_verbs_qp_hl* qh) {
+        double us = 0;
+        int e = gdakiQ4QpErr(qh, &us);
+        if (i >= (int)qpState.size()) qpState.push_back(-2);
+        if (e != qpState[i]) {
+          uint32_t qpn = 0;
+          doca_verbs_qp_get_qpn(qh->qp, &qpn);
+          WARN("GIN/Q4: QPWATCH rank=%d qpn=%#x state %s -> %s query_us=%.0f mono_ms=%.3f", q->ctx->rank, qpn,
+               qpState[i] == -2 ? "init" : qpState[i] ? "ERR" : "not-ERR", e < 0 ? "query-failed" : e ? "ERR" : "not-ERR",
+               us, gdakiQ4MonoMs());
+          qpState[i] = e;
+        }
+        i++;
+      });
+    }
+    if (q->pollUs > 0) std::this_thread::sleep_for(std::chrono::microseconds(q->pollUs));
+  }
+}
+
+static ncclResult_t gdakiQ4Alloc(struct gdaki_context* g, struct gdakiQ4Host** out) {
+  *out = nullptr;
+  if (ncclParamGinFaultClassify() == 0) return ncclSuccess;
+  ncclResult_t ret = ncclSuccess;
+  struct ncclGinGdakiQ4 init;
+  struct gdakiQ4Host* q = new gdakiQ4Host();
+  q->ctx = g;
+  q->pollUs = (int)std::max<int64_t>(0, ncclParamGinFaultClassifyPollUs());
+  q->qpWatchMs = (int)std::max<int64_t>(0, ncclParamGinQ4QpWatchMs());
+  q->asyncResult = ncclGinQ4AsyncResult;
+  NCCLCHECKGOTO(ncclCudaHostCalloc(&q->rec_h, NCCL_GIN_GDAKI_Q4_NSLOTS), ret, fail);
+  CUDACHECKGOTO(cudaHostGetDevicePointer((void**)&q->rec_d, q->rec_h, 0), ret, fail);
+  NCCLCHECKGOTO(ncclCudaCalloc(&q->dev, 1, nullptr), ret, fail);
+  memset(&init, 0, sizeof(init));
+  init.mbx = q->rec_d;
+  init.nslots = NCCL_GIN_GDAKI_Q4_NSLOTS;
+  init.late_read_ns = (uint32_t)std::max<int64_t>(0, ncclParamGinQ4LateReadUs()) * 1000u;
+  NCCLCHECKGOTO(ncclCudaMemcpy<struct ncclGinGdakiQ4>(q->dev, &init, 1), ret, fail);
+  *out = q;
+  return ncclSuccess;
+fail:
+  if (q->dev) ncclCudaFree(q->dev, nullptr);
+  if (q->rec_h) ncclCudaHostFree(q->rec_h);
+  delete q;
+  return ret;
+}
+
+static void gdakiQ4Start(struct gdakiQ4Host* q) {
+  if (!q) return;
+  q->th = std::thread(gdakiQ4Watch, q);
+  WARN("GIN/Q4: device error classification ON rank=%d mailbox=%d x %zu B host-mapped poll_us=%d qpwatch_ms=%d "
+       "async_result=%s",
+       q->ctx->rank, NCCL_GIN_GDAKI_Q4_NSLOTS, sizeof(struct ncclGinGdakiQ4Record), q->pollUs, q->qpWatchMs,
+       q->asyncResult ? "gin" : "query-only");
+}
+
+static void gdakiQ4Free(struct gdakiQ4Host* q) {
+  if (!q) return;
+  if (q->th.joinable()) {
+    q->stop.store(true, std::memory_order_release);
+    q->th.join();
+  }
+  INFO(NCCL_NET, "GIN/Q4: mailbox closed: %d error record(s), %d timeout dump(s)", q->nErr, q->nDump);
+  if (q->dev) ncclCudaFree(q->dev, nullptr);
+  if (q->rec_h) ncclCudaHostFree(q->rec_h);
+  delete q;
+}
