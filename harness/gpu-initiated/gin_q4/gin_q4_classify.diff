+// NCCL_GIN_GDAKI_CQ_TYPE -> qp_init_attr. Returns ncclInvalidUsage if the requested type cannot work here.
+static ncclResult_t gdakiQ4ApplyCqType(struct doca_gpu_verbs_qp_init_attr_hl* a, int rank) {
+  const char* s = getenv("NCCL_GIN_GDAKI_CQ_TYPE");
+  if (s == nullptr || *s == '\0' || strcmp(s, "ring") == 0) return ncclSuccess;  // stock
+  if (strcmp(s, "collapsed") == 0) {
+    a->cq_type = DOCA_GPUNETIO_VERBS_CQ_64B_COLLAPSED;
+    a->cq_collapsed = true;
+  } else if (strncmp(s, "collapsed_host", 14) == 0) {
+    const bool force = strcmp(s, "collapsed_host_force") == 0;
+    const bool gdr = doca_gpu_gdrcopy_is_supported();
+    if (!gdr && !force) {
+      WARN("GIN/Q4: NCCL_GIN_GDAKI_CQ_TYPE=collapsed_host refused on rank %d: GDRCopy is not available "
+           "(doca_gpu_gdrcopy_is_supported()=0). DOCA needs it to map the GPU-resident device QP array to the CPU "
+           "(doca_gpu_verbs_export_multi_qps_dev: need_cpu_mapping -> assert(support_gdrcopy), "
+           "DOCA_GPU_MEM_TYPE_GPU_CPU) so the CPU progress thread can advance cqe_ci.",
+           rank);
+      return ncclInvalidUsage;
+    }
+    a->cq_type = DOCA_GPUNETIO_VERBS_CQ_64B_COLLAPSED_HOST;
+    a->cq_collapsed = true;
+  } else {
+    WARN("GIN/Q4: unknown NCCL_GIN_GDAKI_CQ_TYPE=%s (ring|collapsed|collapsed_host)", s);
+    return ncclInvalidUsage;
+  }
+  WARN("GIN/Q4: GDAKI CQ type %s (cq_type=%d cq_collapsed=%d) rank=%d", s, (int)a->cq_type, (int)a->cq_collapsed, rank);
+  return ncclSuccess;
+}
