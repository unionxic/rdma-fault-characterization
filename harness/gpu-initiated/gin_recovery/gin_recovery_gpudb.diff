+// GIN recovery v2 (GPU doorbells): the doorbell path of a GDAKI QP, as DOCA resolved it at export.
+//   CPU proxy (PeerMappingOverride off): the GPU publishes its producer index in the host-mapped
+//     mailbox cpu_db; a CPU thread (NCCL "GIN P" progress thread) writes the host-memory doorbell
+//     record and rings the UAR doorbell.
+//   GPU_SM_DB (UAR mapped into the GPU, e.g. PeerMappingOverride=1): the GPU itself rings the UAR
+//     doorbell and writes the doorbell record, which lives in GPU memory; sq_wqe_pi tracks the last
+//     index it submitted. There is no CPU-side doorbell state.
+// Other modes (BlueFlame, no-DBR, SW-emulated DBR, free-flow proxy) are not supported by recovery.
+enum { GDAKI_REC_DB_UNSUPPORTED = 0, GDAKI_REC_DB_CPU_PROXY = 1, GDAKI_REC_DB_GPU = 2 };
+static int gdakiRecDbMode(struct doca_gpu_verbs_qp* v) {
+  const int h = (int)v->qp_cpu->nic_handler;
+  if (v->cpu_proxy && h == DOCA_GPUNETIO_VERBS_NIC_HANDLER_CPU_PROXY &&
+      v->send_dbr_mode_ext == DOCA_GPUNETIO_VERBS_SEND_DBR_MODE_EXT_VALID_DBR)
+    return GDAKI_REC_DB_CPU_PROXY;
+  if (!v->cpu_proxy && h == DOCA_GPUNETIO_VERBS_NIC_HANDLER_GPU_SM_DB &&
+      v->send_dbr_mode_ext == DOCA_GPUNETIO_VERBS_SEND_DBR_MODE_EXT_VALID_DBR)
+    return GDAKI_REC_DB_GPU;
+  return GDAKI_REC_DB_UNSUPPORTED;
+}
+static const char* gdakiNicHandlerStr(int h) {
+  switch (h) {
+  case DOCA_GPUNETIO_VERBS_NIC_HANDLER_CPU_PROXY: return "CPU_PROXY";
+  case DOCA_GPUNETIO_VERBS_NIC_HANDLER_GPU_SM_DB: return "GPU_SM_DB";
+  case DOCA_GPUNETIO_VERBS_NIC_HANDLER_GPU_SM_BF: return "GPU_SM_BF";
+  case DOCA_GPUNETIO_VERBS_NIC_HANDLER_GPU_SM_NO_DBR: return "GPU_SM_NO_DBR";
+  case DOCA_GPUNETIO_VERBS_NIC_HANDLER_CPU_PROXY_FREE_FLOW: return "CPU_PROXY_FREE_FLOW";
+  default: return "?";
+  }
+}
+
+// Once per GDAKI context: the doorbell mode DOCA chose for its main QPs (the doorbell mode is not
+// logged anywhere in stock NCCL/DOCA). WARN when the Q4 classifier or recovery is on, INFO otherwise.
+static void gdakiDbModeLog(struct gdaki_context* g, bool needsProxyProgress) {
+  int nGpu = 0, nProxy = 0, nOther = 0, total = 0;
+  const char* first = "?";
+  const int nq = g->nContexts * (g->collComm->nranks + 1);
+  for (int i = 0; i < nq; i++) {
+    struct doca_gpu_verbs_qp_hl* q = g->gqps ? g->gqps[i] : nullptr;
+    if (q == nullptr || q->qp_gverbs == nullptr || q->qp_gverbs->qp_cpu == nullptr) continue;
+    const int h = (int)q->qp_gverbs->qp_cpu->nic_handler;
+    if (total == 0) first = gdakiNicHandlerStr(h);
+    total++;
+    if (h == DOCA_GPUNETIO_VERBS_NIC_HANDLER_GPU_SM_DB && !q->qp_gverbs->cpu_proxy) nGpu++;
+    else if (h == DOCA_GPUNETIO_VERBS_NIC_HANDLER_CPU_PROXY && q->qp_gverbs->cpu_proxy) nProxy++;
+    else nOther++;
+  }
+  const bool loud = ncclParamGinFaultClassify() || ncclParamGinFaultRecovery();
+  const char* mode = (nGpu == total) ? "GPU" : (nProxy == total) ? "CPU_PROXY" : "MIXED";
+  if (loud)
+    WARN("GIN/GDAKI: doorbell mode=%s rank=%d user_ctx=%d main_qps=%d gpu_sm_db=%d cpu_proxy=%d other=%d "
+         "first_nic_handler=%s needsProxyProgress=%d",
+         mode, g->rank, (int)ncclGinFaultUserCtx, total, nGpu, nProxy, nOther, first, (int)needsProxyProgress);
+  else
+    INFO(NCCL_NET | NCCL_INIT, "GIN/GDAKI: doorbell mode=%s rank=%d main_qps=%d gpu_sm_db=%d cpu_proxy=%d other=%d "
+         "needsProxyProgress=%d", mode, g->rank, total, nGpu, nProxy, nOther, (int)needsProxyProgress);
+}
