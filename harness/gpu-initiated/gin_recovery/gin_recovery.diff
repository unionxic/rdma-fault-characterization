+  unsigned int cqeErr;         /* error CQEs of the ending epoch in the unconsumed window (all QPs) */
+  unsigned int cqeOk;          /* successful CQEs in that window */
+  unsigned long long epochWqes; /* WQEs of the ending epoch, summed over the QPs */
+  double prepareUs, errUs, drainUs; /* Prepare: total, move-to-ERR, drain wait */
