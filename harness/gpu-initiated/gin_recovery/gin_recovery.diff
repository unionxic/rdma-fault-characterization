+  unsigned int sqPsn[NCCL_GIN_RECOVERY_MAX_QPS];           /* fresh send PSN of the new incarnation */
+  unsigned long long epochWqes[NCCL_GIN_RECOVERY_MAX_QPS]; /* WQEs posted in the ending epoch */
+} ncclGinRecoverToken_t;
+
+typedef struct {
