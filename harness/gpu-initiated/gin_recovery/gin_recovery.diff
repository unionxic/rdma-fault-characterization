+#define NCCL_GIN_RECOVERY_TOKEN_MAGIC 0x47524543u /* "GREC" */
+typedef struct {
+  int valid;                   /* 1 if a device-classified error CQE was reported since the last recovery */
+  int recoverable;             /* 0 no, 1 yes (LOCAL_QP_ERR), 2 yes if the peer is alive (RETRY_EXC) */
+  int cls;                     /* device class id (NCCL_GIN_Q4_CLASS_*) */
+  int wcStatus;                /* ibv_wc_status equivalent of the root-cause CQE */
+  int vendorErr;
+  int syndrome;
+  int peer;
+  int ctxId;
+  unsigned int qpn;
+  unsigned int wqeCounter;
+  unsigned int seq;
+  unsigned int nRecords;       /* error records since the last recovery */
+  unsigned long long gtimerNs; /* device %globaltimer at detection */
+  double hostMonoMs;           /* CLOCK_MONOTONIC (ms) when the host watcher read the record */
+  char className[24];
+} ncclGinFaultInfo_t;
+
+typedef struct {
+  unsigned int magic;
+  unsigned int nqp;
+  unsigned int qpn[NCCL_GIN_RECOVERY_MAX_QPS];             /* local QPN, (devComm, GIN context) order */
