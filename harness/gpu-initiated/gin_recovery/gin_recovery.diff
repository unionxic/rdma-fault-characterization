+// ---------------------------------------------------------------------------
+// GIN recovery (research build; default OFF), layered on the Q4 classifier above.
+//   NCCL_GIN_FAULT_RECOVERY=1            enable (needs NCCL_GIN_FAULT_CLASSIFY=1; user devComms only)
+//   NCCL_GIN_RECOVERY_DRAIN_MS=<ms>      bound on waiting for the CQE of the last posted WQE (1000)
+//   NCCL_GIN_FAULT_INJECT_WAIT_S=<s>     multi-shot hook: bound on waiting for the next commit (60)
+// Host API (nccl.h): ncclGinFaultQuery, ncclGinRecoverPrepare, ncclGinRecoverCommit,
+// ncclGinRecoverAbort. Design and safety argument: harness/gpu-initiated/gin_recovery/
+// RECOVERY_DESIGN.md. In short: with every GPU producer stopped, Prepare pauses the CPU-proxy
+// doorbell thread for this context, checks that each peer QP is quiescent (no half-posted or
+// unsubmitted WQE), moves it to ERR and waits for the CQE of its last WQE; Commit (after the
+// peer did the same) resets the QP (2RST), restarts the device WQE index space at 0 with
+// cqe_rsvd advanced by the WQEs of the ending epoch, zeroes the doorbell record / proxy
+// mailbox / proxy counter and the get tickets, and reconnects with the connect-time attributes
+// and fresh PSNs (INIT/RTR/RTS), then clears the Q4 error state.
+// ---------------------------------------------------------------------------
+NCCL_PARAM(GinFaultRecovery, "GIN_FAULT_RECOVERY", 0);
+NCCL_PARAM(GinRecoveryDrainMs, "GIN_RECOVERY_DRAIN_MS", 1000);
+NCCL_PARAM(GinFaultInjectWaitS, "GIN_FAULT_INJECT_WAIT_S", 60);
+// Diagnostic A/B only (default: the design). NCCL_GIN_RECOVERY_DIAG=doca_cqe_rsvd sets cqe_rsvd to the
+// ending epoch's WQE count like doca_gpu_verbs_reset_tracking_and_memory (not cumulative);
+// =keep_proxy_db leaves the CPU-proxy doorbell mailbox (cpu_db) and its counter unreset.
+static int gdakiRecDiag() {
+  static int v = -1;
+  if (v < 0) {
+    const char* e = getenv("NCCL_GIN_RECOVERY_DIAG");
+    v = (e && strcmp(e, "doca_cqe_rsvd") == 0) ? 1 : (e && strcmp(e, "keep_proxy_db") == 0) ? 2 : 0;
+    if (v) WARN("GIN/REC: DIAGNOSTIC mode NCCL_GIN_RECOVERY_DIAG=%s (breaks the recovery on purpose)", e);
+  }
+  return v;
+}
+extern thread_local void* ncclGinRecCommKey;  // gin/gin_host.cc
+
+struct gdakiRecQp {
+  bool used = false;             // a peer-connected main QP of this rank
+  int ctxIdx = 0, peer = 0, qpIdx = 0;
+  struct gdaki_exch_info exch;   // connect-time info of the peer QP (copy)
+  uint8_t lag = 0;               // connect-time LAG TX port affinity
+  struct doca_gpu_dev_verbs_qp snap;  // device QP struct at Prepare
+  uint64_t epochWqes = 0;        // sq_rsvd_index at Prepare = WQEs of the ending epoch
+  uint32_t newSqPsn = 0;
+};
+
+struct gdakiRecHost {
+  void* commKey = nullptr;
+  struct gdaki_context* ctx = nullptr;
+  std::vector<gdakiRecQp> qps;   // indexed by qp_idx = rank + ctx * nranks
+  std::atomic<int> paused{0};    // proxy progress skips this context while set
+  std::atomic<int> busy{0};      // proxy progress calls inside this context
+  std::mutex opMu;               // Prepare/Commit bodies vs. the test hook's fire
+  int state = 0;                 // 0 idle, 1 prepared
+  int preparedPeer = -1;
+  cudaStream_t stream = nullptr; // private non-blocking stream: never waits for user kernels
+  uint8_t* pinned = nullptr;     // pinned staging for D2H/H2D copies
+  size_t pinnedSize = 0;
+  std::mt19937 rng;
+  int nCommits = 0, nAborts = 0;
+  // multi-shot test hook (NCCL_GIN_FAULT_INJECT with a list)
+  std::thread hookTh;
+  std::mutex hookMu;
+  std::condition_variable hookCv;
+  bool hookStop = false;
+  uint64_t commits = 0;
+  int armShot = 0, armTotal = 0;  // delay -1: Commit fires this shot after RTS, before it returns
+};
+
+static std::mutex gdakiRecRegMu;
+static std::vector<struct gdakiRecHost*> gdakiRecReg;
+
+// Proxy progress guard: with recovery off (rec == nullptr) it does nothing.
+struct gdakiRecProgressGuard {
+  struct gdakiRecHost* r;
+  bool skip = false;
+  explicit gdakiRecProgressGuard(struct gdakiRecHost* r_) : r(r_) {
+    if (r == nullptr) return;
+    r->busy.fetch_add(1, std::memory_order_seq_cst);
+    if (r->paused.load(std::memory_order_seq_cst)) {
+      r->busy.fetch_sub(1, std::memory_order_seq_cst);
+      r = nullptr;
+      skip = true;
+    }
+  }
+  ~gdakiRecProgressGuard() {
+    if (r) r->busy.fetch_sub(1, std::memory_order_seq_cst);
+  }
+};
+
+static ncclResult_t gdakiRecPause(struct gdakiRecHost* r) {
+  r->paused.store(1, std::memory_order_seq_cst);
+  const double t0 = gdakiQ4MonoMs();
+  while (r->busy.load(std::memory_order_seq_cst) != 0) {
+    if (gdakiQ4MonoMs() - t0 > 1000) {
+      r->paused.store(0, std::memory_order_seq_cst);
+      WARN("GIN/REC: proxy progress did not leave the context within 1 s");
+      return ncclInternalError;
+    }
+    std::this_thread::yield();
+  }
+  return ncclSuccess;
+}
+
+static void gdakiRecResume(struct gdakiRecHost* r) { r->paused.store(0, std::memory_order_seq_cst); }
+
+static ncclResult_t gdakiRecD2H(struct gdakiRecHost* r, void* dst, const void* src, size_t n) {
+  if (n > r->pinnedSize) return ncclInternalError;
+  CUDACHECK(cudaMemcpyAsync(r->pinned, src, n, cudaMemcpyDeviceToHost, r->stream));
+  CUDACHECK(cudaStreamSynchronize(r->stream));
+  memcpy(dst, r->pinned, n);
+  return ncclSuccess;
+}
+
+static ncclResult_t gdakiRecH2D(struct gdakiRecHost* r, void* dst, const void* src, size_t n) {
+  if (n > r->pinnedSize) return ncclInternalError;
+  memcpy(r->pinned, src, n);
+  CUDACHECK(cudaMemcpyAsync(dst, r->pinned, n, cudaMemcpyHostToDevice, r->stream));
+  CUDACHECK(cudaStreamSynchronize(r->stream));
+  return ncclSuccess;
+}
+
+// A CQE at ring position `pos` belongs to the current lap and to WQE `wqeIdx` (ring CQ).
+static bool gdakiRecCqeCurrent(const uint8_t* cqe, uint64_t pos, uint32_t cqeNum, uint64_t wqeIdx) {
+  const uint16_t wc = ((uint16_t)cqe[60] << 8) | cqe[61];
+  const uint8_t opown = cqe[63];
+  const bool owner = (opown & DOCA_GPUNETIO_IB_MLX5_CQE_OWNER_MASK) != 0;
+  return owner == ((pos & cqeNum) != 0) && wc == (uint16_t)(wqeIdx & 0xffff);
+}
+
+static void gdakiRecFind(void* key, std::vector<struct gdakiRecHost*>& out) {
+  std::lock_guard<std::mutex> lk(gdakiRecRegMu);
+  for (auto* r : gdakiRecReg)
+    if (r->commKey == key) out.push_back(r);
+}
+
+static uint32_t gdakiRecQpn(struct doca_gpu_verbs_qp_hl* q) {
+  uint32_t qpn = 0;
+  doca_verbs_qp_get_qpn(q->qp, &qpn);
+  return qpn;
+}
+
+static ncclResult_t gdakiRecModify(struct doca_gpu_verbs_qp_hl* q, enum doca_verbs_qp_state st) {
+  doca_verbs_qp_attr_t* a = nullptr;
+  if (doca_verbs_qp_attr_create(&a) != DOCA_SUCCESS) return ncclSystemError;
+  doca_verbs_qp_attr_set_next_state(a, st);
+  doca_error_t e = doca_verbs_qp_modify(q->qp, a, DOCA_VERBS_QP_ATTR_NEXT_STATE);
+  doca_verbs_qp_attr_destroy(a);
+  if (e != DOCA_SUCCESS) {
+    WARN("GIN/REC: modify qpn=%#x -> state %d failed (%d)", gdakiRecQpn(q), (int)st, (int)e);
+    return ncclSystemError;
+  }
+  return ncclSuccess;
+}
+
+// The peer-connected QPs of `r` to `peer`, in GIN-context order.
+template <typename F>
+static void gdakiRecForPeer(struct gdakiRecHost* r, int peer, F fn) {
+  const int nranks = r->ctx->collComm->nranks;
+  for (int c = 0; c < r->ctx->nContexts; c++) {
+    const int i = peer + c * nranks;
+    if (i < (int)r->qps.size() && r->qps[i].used) fn(r->qps[i], r->ctx->gqps[i]);
+  }
+}
+
+static void gdakiRecAllToErr(struct gdakiRecHost* r, int peer) {
+  gdakiRecForPeer(r, peer, [&](gdakiRecQp&, struct doca_gpu_verbs_qp_hl* q) { (void)gdakiRecModify(q, DOCA_VERBS_QP_STATE_ERR); });
+}
+
+static void gdakiRecRegister(struct gdaki_context* g) {
+  struct gdakiRecHost* r = g->rec;
+  if (r == nullptr) return;
+  if (g->q4 == nullptr) {
+    WARN("GIN/REC: NCCL_GIN_FAULT_RECOVERY=1 needs NCCL_GIN_FAULT_CLASSIFY=1; recovery disabled on rank %d", g->rank);
+    delete r;
+    g->rec = nullptr;
+    return;
+  }
+  uint32_t cqeMax = 1;
+  while (cqeMax < g->qp_sq_size) cqeMax <<= 1;
+  r->pinnedSize = std::max<size_t>((size_t)cqeMax * DOCA_GPUNETIO_VERBS_CQE_SIZE, sizeof(struct doca_gpu_dev_verbs_qp)) + 4096;
+  if (cudaStreamCreateWithFlags(&r->stream, cudaStreamNonBlocking) != cudaSuccess ||
+      cudaHostAlloc((void**)&r->pinned, r->pinnedSize, cudaHostAllocDefault) != cudaSuccess) {
+    WARN("GIN/REC: could not allocate the recovery stream/staging; recovery disabled on rank %d", g->rank);
+    if (r->stream) cudaStreamDestroy(r->stream);
+    delete r;
+    g->rec = nullptr;
+    return;
+  }
+  std::random_device rd;
+  r->rng.seed(rd() ^ (uint32_t)clockNano() ^ ((uint32_t)g->rank << 24));
+  int n = 0;
+  for (auto& q : r->qps) n += q.used ? 1 : 0;
+  {
+    std::lock_guard<std::mutex> lk(gdakiRecRegMu);
+    gdakiRecReg.push_back(r);
+  }
+  WARN("GIN/REC: recovery ON rank=%d peer_qps=%d contexts=%d drain_ms=%ld (API: ncclGinRecoverPrepare/Commit)", g->rank,
+       n, g->nContexts, (long)ncclParamGinRecoveryDrainMs());
+}
+
+static void gdakiRecFree(struct gdakiRecHost* r) {
+  if (r == nullptr) return;
+  {
+    std::lock_guard<std::mutex> lk(gdakiRecRegMu);
+    gdakiRecReg.erase(std::remove(gdakiRecReg.begin(), gdakiRecReg.end(), r), gdakiRecReg.end());
+  }
+  {
+    std::lock_guard<std::mutex> lk(r->hookMu);
+    r->hookStop = true;
+  }
+  r->hookCv.notify_all();
+  if (r->hookTh.joinable()) r->hookTh.join();
+  if (r->stream) cudaStreamDestroy(r->stream);
+  if (r->pinned) cudaFreeHost(r->pinned);
+  INFO(NCCL_NET, "GIN/REC: closed: %d commit(s), %d abort(s)", r->nCommits, r->nAborts);
+  delete r;
+}
+
+// Multi-shot fault hook: shot 1 fires delays[0] ms after context creation; shot k > 1 fires
+// delays[k-1] ms after the recovery commit that followed shot k-1 on this rank (0 = at once).
+// A delay of -1 fires shot k *inside* that commit, after the QPs reached RTS and before Commit
+// returns, so the application's replay meets a QP in ERR (a fault during the recovery itself).
+// Joined on context destruction.
+static void gdakiRecHookStart(struct gdaki_context* g, const std::vector<int>& delays, const char* spec) {
+  struct gdakiRecHost* r = g->rec;
+  const int nranks = g->collComm->nranks;
+  WARN("GIN/FAULT: GDAKI fault hook armed (%s): %d context(s) x %d peer(s), %zu shot(s); shot 1 fires in %d ms, "
+       "shot k>1 fires its delay after the recovery commit that followed shot k-1",
+       spec, g->nContexts, nranks - 1, delays.size(), delays[0]);
+  r->hookTh = std::thread([g, r, delays]() {
+    const double waitS = (double)ncclParamGinFaultInjectWaitS();
+    uint64_t commitsAtFire = 0;
+    for (size_t k = 0; k < delays.size(); k++) {
+      std::unique_lock<std::mutex> lk(r->hookMu);
+      if (k > 0 && delays[k] < 0) {
+        r->armShot = (int)k + 1;
+        r->armTotal = (int)delays.size();
+        bool ok = r->hookCv.wait_for(lk, std::chrono::duration<double>(waitS),
+                                     [&] { return r->hookStop || r->armShot == 0; });
+        if (r->hookStop) return;
+        if (!ok) {
+          r->armShot = 0;
+          WARN("GIN/FAULT: shot %zu/%zu cancelled: no recovery commit within %.0f s", k + 1, delays.size(), waitS);
+          return;
+        }
+        commitsAtFire = r->commits;  // the commit that fired it has already counted itself
+        continue;
+      }
+      if (k > 0) {
+        bool ok = r->hookCv.wait_for(lk, std::chrono::duration<double>(waitS),
+                                     [&] { return r->hookStop || r->commits > commitsAtFire; });
+        if (r->hookStop) return;
+        if (!ok) {
+          WARN("GIN/FAULT: shot %zu/%zu cancelled: no recovery commit within %.0f s", k + 1, delays.size(), waitS);
+          return;
+        }
+      }
+      if (delays[k] > 0 &&
+          r->hookCv.wait_for(lk, std::chrono::milliseconds(delays[k]), [&] { return r->hookStop; }))
+        return;
+      if (r->hookStop) return;
+      lk.unlock();
+      std::lock_guard<std::mutex> op(r->opMu);  // never inside a Prepare/Commit body
+      {
+        std::lock_guard<std::mutex> lk2(r->hookMu);
+        commitsAtFire = r->commits;
+      }
+      char tag[48];
+      snprintf(tag, sizeof(tag), " (shot %zu/%zu)", k + 1, delays.size());
+      ncclGinGdakiFaultFire(g, tag);
+    }
+  });
+}
+
+static const char* gdakiRecStateStr(int s) { return s == 0 ? "idle" : s == 1 ? "prepared" : "?"; }
+
+NCCL_API(ncclResult_t, ncclGinFaultQuery, ncclComm_t comm, int waitMs, ncclGinFaultInfo_t* info);
+ncclResult_t ncclGinFaultQuery(ncclComm_t comm, int waitMs, ncclGinFaultInfo_t* info) {
+  if (info == nullptr) return ncclInvalidArgument;
+  memset(info, 0, sizeof(*info));
+  std::vector<struct gdakiRecHost*> rs;
+  gdakiRecFind((void*)comm, rs);
+  if (rs.empty()) return ncclInvalidUsage;
+  const double deadline = gdakiQ4MonoMs() + std::max(0, waitMs);
+  do {
+    for (auto* r : rs) {
+      struct gdakiQ4Host* q = r->ctx->q4;
+      std::lock_guard<std::mutex> lk(q->lastMu);
+      if (q->nErrSinceRec == 0 || (info->valid && q->lastErrMonoMs <= info->hostMonoMs)) continue;
+      const struct ncclGinGdakiQ4Record& e = q->lastErr;
+      const bool rootErr = (e.root_opcode == 0xd || e.root_opcode == 0xe);
+      info->valid = 1;
+      info->cls = e.cls;
+      info->wcStatus = rootErr ? gdakiQ4WcStatus(e.syndrome) : 0;
+      info->vendorErr = rootErr ? e.vendor_err : 0;
+      info->syndrome = rootErr ? e.syndrome : 0;
+      info->peer = (int)e.peer;
+      info->ctxId = (int)e.ctx_id;
+      info->qpn = e.qpn;
+      info->wqeCounter = e.wqe_counter;
+      info->seq = e.seq;
+      info->nRecords = q->nErrSinceRec;
+      info->gtimerNs = e.gtimer_ns;
+      info->hostMonoMs = q->lastErrMonoMs;
+      info->recoverable = (e.cls == NCCL_GIN_Q4_CLASS_LOCAL_QP_ERR) ? 1 : (e.cls == NCCL_GIN_Q4_CLASS_RETRY_EXC) ? 2 : 0;
+      snprintf(info->className, sizeof(info->className), "%s", gdakiQ4Class(e.cls, e.vendor_err).name);
+    }
+    if (info->valid) break;
+    std::this_thread::sleep_for(std::chrono::microseconds(20));
+  } while (gdakiQ4MonoMs() < deadline);
+  return ncclSuccess;
+}
+
+NCCL_API(ncclResult_t, ncclGinRecoverPrepare, ncclComm_t comm, int peer, ncclGinRecoverToken_t* local,
+         ncclGinRecoverStats_t* stats);
+ncclResult_t ncclGinRecoverPrepare(ncclComm_t comm, int peer, ncclGinRecoverToken_t* local,
+                                   ncclGinRecoverStats_t* stats) {
+  if (local == nullptr) return ncclInvalidArgument;
+  ncclGinRecoverStats_t st;
+  memset(&st, 0, sizeof(st));
+  memset(local, 0, sizeof(*local));
+  local->magic = NCCL_GIN_RECOVERY_TOKEN_MAGIC;
+  std::vector<struct gdakiRecHost*> rs;
+  gdakiRecFind((void*)comm, rs);
+  if (rs.empty()) {
+    WARN("GIN/REC: prepare: no recovery-enabled GDAKI context on this communicator");
+    return ncclInvalidUsage;
+  }
+  const double t0 = gdakiQ4MonoMs();
+  ncclResult_t ret = ncclSuccess;
+  std::vector<std::unique_lock<std::mutex>> ops;
+  std::vector<struct gdakiRecHost*> pausedRs;
+  const char* why = nullptr;
+
+  // 1. configuration (checked before anything is touched)
+  for (auto* r : rs) {
+    struct gdaki_context* g = r->ctx;
+    if (peer < 0 || peer >= g->collComm->nranks || peer == g->rank) { why = "invalid peer"; goto decline; }
+    if (r->state != 0) { why = "a recovery is already prepared"; goto decline; }
+    if (g->companion_gqps != nullptr) { why = "companion (counter) QPs present"; goto decline; }
+    int n = 0;
+    gdakiRecForPeer(r, peer, [&](gdakiRecQp&, struct doca_gpu_verbs_qp_hl* q) {
+      n++;
+      struct doca_gpu_verbs_qp* v = q->qp_gverbs;
+      if (!v->cpu_proxy || (v->qp_cpu->nic_handler & DOCA_GPUNETIO_VERBS_NIC_HANDLER_FLAG_FREE_FLOW) != 0)
+        why = "doorbell mode is not CPU proxy";
+      else if (v->cq_type != DOCA_GPUNETIO_VERBS_CQ_64B)
+        why = "CQ is not a ring CQ";
+      else if (v->qp_gpu == nullptr)
+        why = "QP not exported";
+    });
+    if (why) goto decline;
+    if (n == 0) { why = "no QP to this peer"; goto decline; }
+    if ((int)local->nqp + n > NCCL_GIN_RECOVERY_MAX_QPS) { why = "too many QPs"; goto decline; }
+    local->nqp += n;
+  }
+  local->nqp = 0;
+
+  // 2. pause the proxy doorbell thread, ring any pending doorbell, snapshot and check quiescence
+  for (auto* r : rs) {
+    ops.emplace_back(r->opMu);
+    if (gdakiRecPause(r) != ncclSuccess) { why = "cannot pause proxy progress"; goto decline; }
+    pausedRs.push_back(r);
+    bool bad = false;
+    gdakiRecForPeer(r, peer, [&](gdakiRecQp& rq, struct doca_gpu_verbs_qp_hl* q) {
+      if (bad) return;
+      struct doca_gpu_verbs_qp* v = q->qp_gverbs;
+      bool progressed = false;
+      doca_gpu_verbs_cpu_proxy_progress(v, &progressed);
+      if (gdakiRecD2H(r, &rq.snap, v->qp_gpu, sizeof(rq.snap)) != ncclSuccess) { bad = true; why = "cannot read device QP"; return; }
+      const uint64_t S = rq.snap.sq_rsvd_index, R = rq.snap.sq_ready_index;
+      const uint64_t P = __atomic_load_n(v->cpu_db, __ATOMIC_ACQUIRE);
+      if (R != S || P != S || v->sq_wqe_pi_last != S) {
+        WARN("GIN/REC: prepare: qpn=%#x not quiescent: sq_rsvd_index=%lu sq_ready_index=%lu proxy_db=%lu rung=%lu",
+             gdakiRecQpn(q), (unsigned long)S, (unsigned long)R, (unsigned long)P, (unsigned long)v->sq_wqe_pi_last);
+        bad = true;
+        why = "GPU producer not quiescent";
+        return;
+      }
+      rq.epochWqes = S;
+    });
+    if (bad) goto decline;
+  }
+
+  // 3. every QP of the pair set -> ERR (stops retransmission and execution of the old incarnation)
+  {
+    const double e0 = gdakiQ4MonoMs();
+    for (auto* r : rs) {
+      bool bad = false;
+      gdakiRecForPeer(r, peer, [&](gdakiRecQp&, struct doca_gpu_verbs_qp_hl* q) {
+        if (!bad && gdakiRecModify(q, DOCA_VERBS_QP_STATE_ERR) != ncclSuccess) bad = true;
+      });
+      if (bad) { why = "modify to ERR failed"; goto decline; }
+    }
+    st.errUs = (gdakiQ4MonoMs() - e0) * 1e3;
+  }
+
+  // 4. drain: the CQE of the last WQE of the epoch is in the ring (all earlier ones are too)
+  {
+    const double d0 = gdakiQ4MonoMs();
+    const double deadline = d0 + (double)ncclParamGinRecoveryDrainMs();
+    for (auto* r : rs) {
+      bool bad = false;
+      gdakiRecForPeer(r, peer, [&](gdakiRecQp& rq, struct doca_gpu_verbs_qp_hl* q) {
+        if (bad || rq.epochWqes == 0) return;
+        const struct doca_gpu_dev_verbs_cq& cq = rq.snap.cq_sq;
+        const uint32_t cqeNum = cq.cqe_num;
+        if ((size_t)cqeNum * DOCA_GPUNETIO_VERBS_CQE_SIZE > r->pinnedSize) { bad = true; why = "CQ too large"; return; }
+        const uint64_t last = rq.epochWqes - 1;
+        const uint64_t pos = last + cq.cqe_rsvd;
+        const uint8_t* slotAddr = cq.cqe_daddr + (pos & (cqeNum - 1)) * DOCA_GPUNETIO_VERBS_CQE_SIZE;
+        uint8_t cqe[64];
+        while (true) {
+          if (gdakiRecD2H(r, cqe, slotAddr, sizeof(cqe)) != ncclSuccess) { bad = true; why = "cannot read CQ"; return; }
+          if (gdakiRecCqeCurrent(cqe, pos, cqeNum, last)) break;
+          if (gdakiQ4MonoMs() > deadline) {
+            WARN("GIN/REC: prepare: qpn=%#x drain timeout: CQE of WQE %lu (ring pos %lu) not written after %ld ms "
+                 "(wqe_counter=%u op_own=%#x)",
+                 gdakiRecQpn(q), (unsigned long)last, (unsigned long)pos, (long)ncclParamGinRecoveryDrainMs(),
+                 ((unsigned)cqe[60] << 8) | cqe[61], cqe[63]);
+            bad = true;
+            why = "drain timeout";
+            return;
+          }
+          std::this_thread::sleep_for(std::chrono::microseconds(50));
+        }
+        // Diagnostics: current CQEs of the unconsumed window [cqe_ci, S).
+        std::vector<uint8_t> ring((size_t)cqeNum * DOCA_GPUNETIO_VERBS_CQE_SIZE);
+        if (gdakiRecD2H(r, ring.data(), cq.cqe_daddr, ring.size()) != ncclSuccess) return;
+        uint64_t lo = cq.cqe_ci;
+        if (rq.epochWqes > cqeNum && lo < rq.epochWqes - cqeNum) lo = rq.epochWqes - cqeNum;
+        for (uint64_t i = lo; i < rq.epochWqes; i++) {
+          const uint64_t p = i + cq.cqe_rsvd;
+          const uint8_t* c = ring.data() + (p & (cqeNum - 1)) * DOCA_GPUNETIO_VERBS_CQE_SIZE;
+          if (!gdakiRecCqeCurrent(c, p, cqeNum, i)) continue;
+          const uint8_t op = c[63] >> 4;
+          if (op == 0xd || op == 0xe) st.cqeErr++;
+          else st.cqeOk++;
+        }
+      });
+      if (bad) goto decline;
+    }
+    st.drainUs = (gdakiQ4MonoMs() - d0) * 1e3;
+  }
+
+  // 5. token: fresh 24-bit send PSN per QP
+  for (auto* r : rs) {
+    gdakiRecForPeer(r, peer, [&](gdakiRecQp& rq, struct doca_gpu_verbs_qp_hl* q) {
+      rq.newSqPsn = r->rng() & 0xffffff;
+      const unsigned n = local->nqp++;
+      local->qpn[n] = gdakiRecQpn(q);
+      local->remoteQpn[n] = (unsigned)rq.exch.qpn;
+      local->sqPsn[n] = rq.newSqPsn;
+      local->epochWqes[n] = rq.epochWqes;
+      st.epochWqes += rq.epochWqes;
+    });
+    r->state = 1;
+    r->preparedPeer = peer;
+  }
+  st.nqp = (int)local->nqp;
+  st.prepareUs = (gdakiQ4MonoMs() - t0) * 1e3;
+  if (stats) *stats = st;
+  INFO(NCCL_NET, "GIN/REC: prepared peer=%d qps=%d epoch_wqes=%llu cqe_err=%u cqe_ok=%u err_us=%.0f drain_us=%.0f total_us=%.0f",
+       peer, st.nqp, st.epochWqes, st.cqeErr, st.cqeOk, st.errUs, st.drainUs, st.prepareUs);
+  return ncclSuccess;
+
+decline:
+  for (auto* r : pausedRs) gdakiRecResume(r);
+  WARN("GIN/REC: prepare declined (peer=%d): %s", peer, why ? why : "?");
+  if (ret == ncclSuccess) ret = ncclInvalidUsage;
+  return ret;
+}
+
+NCCL_API(ncclResult_t, ncclGinRecoverCommit, ncclComm_t comm, int peer, const ncclGinRecoverToken_t* remote,
+         ncclGinRecoverStats_t* stats);
+ncclResult_t ncclGinRecoverCommit(ncclComm_t comm, int peer, const ncclGinRecoverToken_t* remote,
+                                  ncclGinRecoverStats_t* stats) {
+  if (remote == nullptr) return ncclInvalidArgument;
+  std::vector<struct gdakiRecHost*> rs;
+  gdakiRecFind((void*)comm, rs);
+  if (rs.empty()) return ncclInvalidUsage;
+  ncclGinRecoverStats_t st;
+  if (stats) st = *stats;
+  else memset(&st, 0, sizeof(st));
+  // Validate before touching anything: same QP set, each end connected to the other.
+  {
+    unsigned n = 0;
+    bool bad = remote->magic != NCCL_GIN_RECOVERY_TOKEN_MAGIC;
+    for (auto* r : rs) {
+      if (r->state != 1 || r->preparedPeer != peer) {
+        WARN("GIN/REC: commit: context not prepared for peer %d (state %s)", peer, gdakiRecStateStr(r->state));
+        return ncclInvalidUsage;
+      }
