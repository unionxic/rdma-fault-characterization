+
+// The helper socket to `p` failed (pe.closeCause). Dead: recovery with this peer ends, as before. Unknown: the socket
+// is closed and the peer waits for a reconnect. One WARN either way.
+static int gdakiTsSocketLost(struct gdakiRecHost* r, int p) {
+  struct gdakiTs* ts = r->ts;
+  struct gdakiTsPeer& pe = ts->peers[p];
+  const char* cause = pe.closeCause[0] ? pe.closeCause : "unknown";
+  const int lv = gdakiTsCauseLiveness(cause);
+  snprintf(pe.lostCause, sizeof(pe.lostCause), "%s", cause);
+  if (lv == GDAKI_TS_LV_UNKNOWN) {
+    if (pe.fd >= 0) close(pe.fd);
+    pe.fd = -1;
+    pe.have = 0;
+    pe.unknown = true;
+    pe.lostMs = gdakiQ4MonoMs();
+    pe.nextDialMs = pe.lostMs;
+    pe.attempts = 0;
+  } else {
+    pe.gone = true;
+    pe.unknown = false;
+  }
+  WARN("GIN/TS: rank %d: socket to rank %d closed cause=%s mono_ms=%.3f liveness=%s", r->ctx->rank, p, cause,
+       gdakiQ4MonoMs(), lv == GDAKI_TS_LV_UNKNOWN ? "unknown" : "dead");
+  return lv;
+}
