+// gin-reconnect: liveness of a peer from its helper socket, three ways.
+//   dead:        FIN, ECONNRESET, EPIPE, a refused re-dial (ECONNREFUSED), BADMAGIC, any other errno
+//   unknown:     ETIMEDOUT, EHOSTUNREACH, ENETUNREACH (the socket is closed; the lower rank re-dials)
+//   no evidence: EAGAIN, EWOULDBLOCK, EINTR (the socket is as good as before)
+enum { GDAKI_TS_LV_NOEVIDENCE = 0, GDAKI_TS_LV_UNKNOWN = 1, GDAKI_TS_LV_DEAD = 2 };
+
+static int gdakiTsCauseLiveness(const char* cause) {
+  if (!strcmp(cause, "ETIMEDOUT") || !strcmp(cause, "EHOSTUNREACH") || !strcmp(cause, "ENETUNREACH"))
+    return GDAKI_TS_LV_UNKNOWN;
+  return GDAKI_TS_LV_DEAD;
+}
