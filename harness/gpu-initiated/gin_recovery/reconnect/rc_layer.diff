+// One step of the reconnect machinery, never blocking for long (the helper loop and a fault's wait call it):
+//  - lower rank, for every unknown higher peer: a non-blocking re-dial every 500 ms, each attempt bounded by 500 ms;
+//    connected -> HELLO (context number, generation + 1) -> installed; a refused re-dial (ECONNREFUSED) -> dead;
+//  - higher rank: accept on the kept listen socket, read the HELLO (bounded), install if it comes from a lower rank of
+//    this context with a newer generation (an old socket to that rank is replaced).
+static void gdakiTsReconnectStep(struct gdakiRecHost* r) {
+  struct gdakiTs* ts = r->ts;
+  const int rank = r->ctx->rank;
+  if (!ts->reconnect) return;
+  const double now = gdakiQ4MonoMs();
+  for (int p = rank + 1; p < (int)ts->peers.size(); p++) {
+    struct gdakiTsPeer& pe = ts->peers[p];
+    if (!pe.gated || !pe.unknown || pe.declined || !pe.haveAddr) continue;
+    if (pe.dialFd >= 0) {
+      struct pollfd pf = {pe.dialFd, POLLOUT, 0};
+      const int pr = poll(&pf, 1, 0);
+      if (pr == 1) {
+        int err = 0;
+        socklen_t elen = sizeof(err);
+        if (getsockopt(pe.dialFd, SOL_SOCKET, SO_ERROR, &err, &elen) != 0) err = errno;
+        if (err == 0) {
+          struct gdakiTsMsg h;
+          memset(&h, 0, sizeof(h));
+          h.type = GDAKI_TS_HELLO;
+          h.from = rank;
+          h.arg = (int32_t)ts->ctxSeq;
+          h.round = pe.gen + 1;
+          if (gdakiTsSend(pe.dialFd, &h, 200) == 0) {
+            const int fd = pe.dialFd;
+            pe.dialFd = -1;
+            gdakiTsInstall(r, p, fd, pe.gen + 1, pe.attempts);
+            continue;
+          }
+          close(pe.dialFd);
+          pe.dialFd = -1;
+        } else if (err == ECONNREFUSED) {
+          close(pe.dialFd);
+          pe.dialFd = -1;
+          snprintf(pe.closeCause, sizeof(pe.closeCause), "ECONNREFUSED");
+          (void)gdakiTsSocketLost(r, p);  // dead: the peer's listen socket is gone
+          continue;
+        } else {
+          close(pe.dialFd);
+          pe.dialFd = -1;
+        }
+      } else if (now - pe.dialStartMs >= 500.0) {
+        close(pe.dialFd);
+        pe.dialFd = -1;
+      }
+    }
+    if (pe.dialFd < 0 && now >= pe.nextDialMs) {
+      const socklen_t alen = pe.addr.sa.sa_family == AF_INET6 ? sizeof(pe.addr.sin6) : sizeof(pe.addr.sin);
+      const int fd = socket(pe.addr.sa.sa_family, SOCK_STREAM, 0);
+      pe.nextDialMs = now + 500.0;
+      if (fd < 0) continue;
+      gdakiTsSockOpts(fd);
+      gdakiTsMuteFd(ts, fd);
+      pe.attempts++;
+      const int rc = connect(fd, &pe.addr.sa, alen);
+      if (rc == 0 || errno == EINPROGRESS) {
+        pe.dialFd = fd;
+        pe.dialStartMs = now;
+      } else if (errno == ECONNREFUSED) {
+        close(fd);
+        snprintf(pe.closeCause, sizeof(pe.closeCause), "ECONNREFUSED");
+        (void)gdakiTsSocketLost(r, p);
+      } else {
+        close(fd);
+      }
+    }
+  }
+  if (ts->listenFd >= 0) {
+    struct pollfd pf = {ts->listenFd, POLLIN, 0};
+    while (poll(&pf, 1, 0) == 1 && (pf.revents & POLLIN)) {
+      const int fd = accept(ts->listenFd, nullptr, nullptr);
+      if (fd < 0) break;
+      gdakiTsSockOpts(fd);
+      gdakiTsMuteFd(ts, fd);
+      struct gdakiTsPeer tmp;
+      tmp.fd = fd;
+      struct gdakiTsMsg h;
+      memset(&h, 0, sizeof(h));
+      const int got = gdakiTsRecv(tmp, &h, 500, &ts->stop);
+      const int from = h.from;
+      if (got != 1 || h.type != GDAKI_TS_HELLO || from < 0 || from >= rank || from >= (int)ts->peers.size() ||
+          !ts->peers[from].gated || ts->peers[from].declined || h.arg != (int32_t)ts->ctxSeq ||
+          h.round <= ts->peers[from].gen) {
+        INFO(NCCL_NET, "GIN/TS: rank %d: refused a reconnect (got=%d type=%u from=%d ctx=%d gen=%lu)", rank, got, h.type,
+             from, h.arg, (unsigned long)h.round);
+        close(fd);
+        continue;
+      }
+      gdakiTsInstall(r, from, fd, (uint32_t)h.round, 0);
+    }
+  }
 }
 
