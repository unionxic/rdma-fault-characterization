+  if (pe.unknown) return GDAKI_TS_LV_UNKNOWN;
+  if (pe.fd < 0) return GDAKI_TS_LV_DEAD;
+  if (pe.have > 0) return GDAKI_TS_LV_NOEVIDENCE;
