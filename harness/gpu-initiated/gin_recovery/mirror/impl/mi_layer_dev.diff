+  }
+  cudaStream_t st = lh->appStream;
+  // the side table's header as gdakiRsStart wrote it: where the cells are (none: the pool rkeys are not written)
+  struct ncclGinRsSide hdr;
+  memset(&hdr, 0, sizeof(hdr));
+  if (cudaMemcpyAsync(&hdr, r->rsBase, sizeof(hdr), cudaMemcpyDeviceToHost, st) != cudaSuccess ||
+      cudaStreamSynchronize(st) != cudaSuccess) {
+    snprintf(why, whyLen, "the step-aligned import was refused, nothing applied: the side table could not be read");
+    return ncclUnhandledCudaError;
+  }
+  auto partWay = [&](const char* what) {
+    snprintf(why, whyLen, "the step-aligned import failed part way (%s); the restore falls back", what);
+    return ncclSystemError;
+  };
+  // (1) the rkey slots of each survivor: read, compared, written (incarnation above 0) and read back
+  int nWritten = 0, nWarned = 0, nPool = 0;
+  for (const auto& pe : imp->plan.peers) {
+    for (const auto& en : pe.keys) {
+      uint32_t* dev = nullptr;
+      uint32_t* host = nullptr;
+      const size_t need = (size_t)(pe.rank + 1) * sizeof(uint32_t);
+      if (en.kind == GDAKI_RS_RKEY_WINDOW) {
+        const struct gdakiRsWin* w = gdakiMiWinOf(r, en.id);
+        if (w == nullptr || w->rkeys == nullptr || need > w->rkeysBytes) continue;  // incarnation 0 only (checked above)
+        dev = (uint32_t*)w->rkeys + pe.rank;
+        struct gdaki_mem_handle* mh = (struct gdaki_mem_handle*)w->mhandle;
+        if (mh != nullptr && mh->rkeys_hd_mhandle != nullptr && mh->rkeys_hd_mhandle->host_buf != nullptr)
+          host = mh->rkeys_hd_mhandle->host_buf + pe.rank;
+      } else if (en.kind == GDAKI_RS_RKEY_SIGNALS && r->ctx->signals_table != nullptr &&
+                 r->ctx->signals_table->rkeys_bytes() >= need) {
+        dev = r->ctx->signals_table->get_rkeys_d() + pe.rank;
+      } else if (en.kind == GDAKI_RS_RKEY_COUNTERS && r->ctx->counters_table != nullptr &&
+                 r->ctx->counters_table->rkeys_bytes() >= need) {
+        dev = r->ctx->counters_table->get_rkeys_d() + pe.rank;
+      } else if (en.kind == GDAKI_MI_RKEY_POOL) {  // the survivor's pool: the cells of its wards, invalid until a switch
+        for (int d = 0; d < nranks; d++) {
+          void* cell = d != me && ncclGinMiBuddyOf(d, nranks) == pe.rank ? gdakiMiCellDev(r, hdr, d) : nullptr;
+          if (cell == nullptr) continue;
+          const uint32_t v[2] = {0u, en.rkeyBe};
+          uint32_t back[2] = {1u, 0u};
+          if (cudaMemcpyAsync(cell, v, sizeof(v), cudaMemcpyHostToDevice, st) != cudaSuccess ||
+              cudaMemcpyAsync(back, cell, sizeof(back), cudaMemcpyDeviceToHost, st) != cudaSuccess ||
+              cudaStreamSynchronize(st) != cudaSuccess || back[0] != v[0] || back[1] != v[1])
+            return partWay("a cell's pool rkey could not be written");
+          nPool++;
+        }
+        continue;
+      }
+      if (dev == nullptr) continue;
+      uint32_t have = 0;
+      if (cudaMemcpyAsync(&have, dev, sizeof(have), cudaMemcpyDeviceToHost, st) != cudaSuccess ||
+          cudaStreamSynchronize(st) != cudaSuccess)
+        return partWay("an rkey slot could not be read");
+      const int v = gdakiMiRkeyVerdict(pe.incarnation, have, en.rkeyBe);
+      if (v == GDAKI_MI_RKEY_WARN) {
+        nWarned++;
+        WARN("GIN/MI: rank %d: rank %d (incarnation 0) lists rkey %#x for kind %u id %u, the replayed table has %#x: the "
+             "recorded value stays mono_ms=%.3f", me, pe.rank, (unsigned)en.rkeyBe, en.kind, en.id, (unsigned)have,
+             gdakiQ4MonoMs());
+      } else if (v == GDAKI_MI_RKEY_WRITE) {
+        uint32_t back = 0;
+        if (cudaMemcpyAsync(dev, &en.rkeyBe, sizeof(uint32_t), cudaMemcpyHostToDevice, st) != cudaSuccess ||
+            cudaMemcpyAsync(&back, dev, sizeof(back), cudaMemcpyDeviceToHost, st) != cudaSuccess ||
+            cudaStreamSynchronize(st) != cudaSuccess || back != en.rkeyBe)
+          return partWay("an rkey slot could not be written");
+        if (host != nullptr) *host = en.rkeyBe;
+        nWritten++;
+      }
+    }
+  }
+  // (2) the counts: per user QP msgs = X, suppress = X - P, the responder base M; per mirror QP msgs = X, suppress 0, the
+  // base M, or miUse 0 when the survivor's mirror count was not valid (this rank then never mirrors toward its pool; the
+  // decision is kept in imp->mirUnusable as well)
+  for (const auto& pe : imp->plan.peers) {
+    int idx[NCCL_GIN_RECOVERY_MAX_QPS];
+    const int n = gdakiRsQpsOfPeer(r, pe.rank, idx);
+    char sw[160];
+    if (n != pe.nqp || gdakiRsSuppressWrite(r, idx, n, pe.x, pe.budget, sw, sizeof(sw)) != ncclSuccess)
+      return partWay("a survivor's budgets");
+    for (int k = 0; k < n; k++) gdakiRsExecSetBase(r, idx[k], pe.m[k]);
+    const int m = gdakiMiQpOfPeer(r, pe.rank);
+    if (m < 0) continue;
+    struct ncclGinRsQp* const q = gdakiRsQpDev(r, m);
+    if (pe.mirValid) {
+      const uint64_t v[2] = {pe.mirX, 0};
+      uint64_t back[2] = {~0ull, ~0ull};
+      if (cudaMemcpyAsync(&q->msgs, v, sizeof(v), cudaMemcpyHostToDevice, st) != cudaSuccess ||
+          cudaMemcpyAsync(back, &q->msgs, sizeof(back), cudaMemcpyDeviceToHost, st) != cudaSuccess ||
+          cudaStreamSynchronize(st) != cudaSuccess || back[0] != v[0] || back[1] != v[1])
+        return partWay("a mirror QP's count");
+      gdakiRsExecSetBase(r, m, pe.mirM);
+    } else {
+      const uint32_t zero = 0;
+      uint32_t back = 1;
+      if (cudaMemcpyAsync(&q->miUse, &zero, sizeof(zero), cudaMemcpyHostToDevice, st) != cudaSuccess ||
+          cudaMemcpyAsync(&back, &q->miUse, sizeof(back), cudaMemcpyDeviceToHost, st) != cudaSuccess ||
+          cudaStreamSynchronize(st) != cudaSuccess || back != 0)
+        return partWay("a mirror QP's use mark");
+      imp->mirUnusable.push_back(pe.rank);
+    }
+  }
+  // (3) the queue, and step ckpt + 1's inputs now
+  for (const auto& sp : imp->plan.steps) imp->steps.push_back(sp.step);
+  imp->ckpt = ckpt;
+  imp->last = gdakiMiPaceLast(imp->steps, ckpt);
+  const size_t end = gdakiMiPaceEnd(imp->steps, 0, ckpt + 1);
+  for (size_t i = 0; i < end; i++) {
+    if (!gdakiMiApplyStep(r, imp->plan.steps[i], pw, sizeof(pw))) return partWay(pw);
+    imp->poolBytes += imp->plan.steps[i].poolBytes;
+    imp->stepsDone++;
+  }
+  imp->next = end;
+  imp->left.store(end < imp->steps.size(), std::memory_order_release);
+  GIN_TS_NOTE("GIN/MI: rank %d: import plan: checkpoint=%lu survivors=%zu entries=%lu mirror_entries=%lu mirror_bytes=%lu "
+              "signal_adds=%lu signal_sum=%lu steps=%zu first_step=%lu last_step=%lu queued=%zu rkeys_written=%d "
+              "rkeys_warned=%d pool_cells=%d mirror_unusable=%zu incarnation=%u prepare_ms=%.1f mono_ms=%.3f", me,
+              (unsigned long)ckpt, imp->plan.peers.size(), (unsigned long)imp->plan.entries,
+              (unsigned long)imp->plan.nMirror, (unsigned long)imp->plan.mirrorBytes, (unsigned long)imp->plan.sigAdds,
+              (unsigned long)sigTotal, imp->steps.size(), (unsigned long)(imp->steps.empty() ? 0 : imp->steps.front()),
+              (unsigned long)imp->last, imp->steps.size() - imp->next, nWritten, nWarned, nPool, imp->mirUnusable.size(),
+              incarnation, gdakiQ4MonoMs() - t0, gdakiQ4MonoMs());
+  r->mi.imp = imp;
+  *injectNow = !imp->left.load(std::memory_order_acquire);
+  imp = nullptr;  // kept: DelOnFail deletes nothing now
+  return ncclSuccess;
+}
+static ncclResult_t gdakiMiImportPrepare(struct gdakiRecHost* r, const struct gdakiCkptPeerP* peerP, uint32_t nPeers,
+                                         const std::vector<std::vector<uint8_t>>& exports, uint64_t ckpt,
+                                         uint32_t incarnation, const struct gdakiMiFetched& fetched, char* why,
+                                         size_t whyLen) {
+  if (!gdakiRsLogReady(r)) return gdakiRsLogNotReady(why, whyLen);
+  if (r->ts == nullptr || r->nranks <= 0 || (peerP == nullptr && nPeers != 0)) {
+    snprintf(why, whyLen, "no transparent recovery state, or no P records");
+    return ncclInvalidUsage;
+  }
+  if (r->mi.imp != nullptr) {
+    snprintf(why, whyLen, "the step-aligned import already ran on this context");
+    return ncclInvalidUsage;
+  }
+  bool injectNow = false;
+  ncclResult_t res;
+  {
+    std::lock_guard<std::mutex> wl(gdakiRsWinMu);  // the windows stay registered while their memory is written
+    std::lock_guard<std::mutex> al(r->rsLog->appMu);
+    res = gdakiMiImportPrepareLocked(r, peerP, nPeers, exports, ckpt, incarnation, fetched, &injectNow, why, whyLen);
+  }
+  if (res == ncclSuccess && injectNow) {  // step ckpt + 1 was the only one: INJECTED at the helper's start
+    gdakiMiInjectedReady(r, r->mi.imp->last);
+    gdakiMiImportDoneLine(r, r->mi.imp);
+  }
+  return res;
+}
+static ncclResult_t gdakiMiImportStep(struct gdakiRecHost* r, uint64_t step, char* why, size_t whyLen) {
+  struct gdakiMiImport* const imp = r != nullptr ? r->mi.imp : nullptr;
+  if (imp == nullptr || !imp->left.load(std::memory_order_acquire)) return ncclSuccess;  // nothing queued
+  char w[320];
+  if (imp->failed) {
+    if (why != nullptr && whyLen != 0) snprintf(why, whyLen, "an earlier step of the import failed");
+    return ncclSystemError;
+  }
+  const size_t end = gdakiMiPaceEnd(imp->steps, imp->next, step + 1);
+  if (end == imp->next) return ncclSuccess;
+  bool ok = true;
+  {
+    std::lock_guard<std::mutex> wl(gdakiRsWinMu);
+    std::lock_guard<std::mutex> al(r->rsLog->appMu);
+    struct gdakiRsDevGuard g;
+    if (!gdakiRsAppStream(r, &g)) {
+      snprintf(w, sizeof(w), "no CUDA stream on device %d", r->ctx->cuda_id);
+      ok = false;
+    }
+    for (size_t i = imp->next; ok && i < end; i++) {
+      ok = gdakiMiApplyStep(r, imp->plan.steps[i], w, sizeof(w));
+      if (!ok) break;
+      imp->poolBytes += imp->plan.steps[i].poolBytes;
+      imp->stepsDone++;
+      imp->next = i + 1;
+    }
+  }
+  if (!ok) {
+    imp->failed = true;
+    WARN("GIN/MI: rank %d: ncclGinRestoreStep(%lu): the import of the queued inputs failed (%s); the helper ends this "
+         "process's part without BYE mono_ms=%.3f", r->ctx->rank, (unsigned long)step, w, gdakiQ4MonoMs());
+    if (why != nullptr && whyLen != 0) snprintf(why, whyLen, "%s", w);
+    gdakiMiImportDoneLine(r, imp);
+    imp->endAsked.store(true, std::memory_order_release);  // gdakiMiImportHelperStep
+    return ncclSystemError;
+  }
+  if (imp->next == imp->steps.size()) {  // the last queued step is in: INJECTED (the host branch's helper sends it)
+    imp->left.store(false, std::memory_order_release);
+    gdakiMiInjectedReady(r, imp->last);
+    gdakiMiImportDoneLine(r, imp);
+  }
+  return ncclSuccess;
+}
