+// The export v2 (impl/rs_log_api.h v2), parsed and checked without applying anything: gdakiRsLogXHdr (version 2) |
+// gdakiRsLogXHdr2 | nEntries x gdakiRsLogXEnt2 | gdakiRsLogXEnd | gdakiRsRkeysHdr + count x gdakiRsRkeyEntry, the whole
+// buffer and nothing more. The trailer is read before the entries: a survivor's refusal is reported as such.
+struct gdakiMiLogXItem {
+  struct ncclGinRsLogEntry e;
+  uint64_t step = 0, seg = 0;
+};
+struct gdakiMiLogXParsed {
+  struct gdakiRsLogXHdr hdr;
+  struct gdakiRsLogXHdr2 hdr2;
+  struct gdakiRsLogXEnd end;
+  struct gdakiRsRkeysHdr rk;
+  std::vector<struct gdakiRsRkeyEntry> keys;
+  std::vector<struct gdakiMiLogXItem> items;
+  uint64_t nMirror = 0, mirrorBytes = 0;
+};
+static bool gdakiMiLogXParse(const uint8_t* p, size_t n, struct gdakiMiLogXParsed* out, char* why, size_t whyLen) {
+  out->items.clear();
+  out->keys.clear();
+  out->nMirror = out->mirrorBytes = 0;
+  const size_t head = sizeof(struct gdakiRsLogXHdr) + sizeof(struct gdakiRsLogXHdr2);
+  const size_t fixed = head + sizeof(struct gdakiRsLogXEnd) + sizeof(struct gdakiRsRkeysHdr);
+  if (p == nullptr || n < fixed) {
+    snprintf(why, whyLen, "the export v2 is shorter than its fixed records (%zu bytes)", n);
+    return false;
+  }
+  memcpy(&out->hdr, p, sizeof(out->hdr));
+  memcpy(&out->hdr2, p + sizeof(out->hdr), sizeof(out->hdr2));
+  const struct gdakiRsLogXHdr& h = out->hdr;
+  if (h.magic != GDAKI_RS_LOGX_MAGIC || h.version != GDAKI_RS_LOGX_VERSION_MI) {
+    snprintf(why, whyLen, "not an export v2 (magic %#x, version %u)", h.magic, h.version);
+    return false;
+  }
+  if ((out->hdr2.flags & GDAKI_RS_LOGX_F_MIRROR) == 0) {
+    snprintf(why, whyLen, "the export v2 does not carry the mirror flag");
+    return false;
+  }
+  if (h.nqp == 0 || h.nqp > NCCL_GIN_RECOVERY_MAX_QPS || h.head < h.cut || h.nEntries > h.head - h.cut ||
+      h.nEntries > (uint64_t)((n - fixed) / sizeof(struct gdakiRsLogXEnt2))) {
+    snprintf(why, whyLen, "the export's header is out of range (nqp %u, cut %lu, head %lu, entries %lu)", h.nqp,
+             (unsigned long)h.cut, (unsigned long)h.head, (unsigned long)h.nEntries);
+    return false;
+  }
+  const size_t endOff = head + (size_t)h.nEntries * sizeof(struct gdakiRsLogXEnt2);
+  memcpy(&out->end, p + endOff, sizeof(out->end));
+  if (out->end.magic != GDAKI_RS_LOGX_MAGIC) {
+    snprintf(why, whyLen, "the export's trailer is not one");
+    return false;
+  }
+  if (out->end.ok != 1) {
+    snprintf(why, whyLen, "the survivor refused its export: %.*s", (int)sizeof(out->end.why), out->end.why);
+    return false;
+  }
+  const size_t rkOff = endOff + sizeof(out->end);
+  memcpy(&out->rk, p + rkOff, sizeof(out->rk));
+  const struct gdakiRsRkeysHdr& k = out->rk;
+  if (k.magic != GDAKI_RS_RKEYS_MAGIC || k.version != 1u || k.count > GDAKI_RS_RKEYS_MAX ||
+      n - rkOff - sizeof(k) != (size_t)k.count * sizeof(struct gdakiRsRkeyEntry)) {
+    snprintf(why, whyLen, "the rkey list after the trailer is damaged, or the export is not its size (%zu bytes)", n);
+    return false;
+  }
+  if (k.rank != h.from || k.nonce != h.nonce) {
+    snprintf(why, whyLen, "the rkey list is rank %d's, the export rank %d's (nonce %s)", k.rank, h.from,
+             k.nonce == h.nonce ? "matches" : "differs");
+    return false;
+  }
+  out->keys.resize(k.count);
+  if (k.count != 0) memcpy(out->keys.data(), p + rkOff + sizeof(k), (size_t)k.count * sizeof(struct gdakiRsRkeyEntry));
+  for (uint64_t i = 0; i < h.nEntries; i++) {
+    struct gdakiRsLogXEnt2 x;
+    memcpy(&x, p + head + (size_t)i * sizeof(x), sizeof(x));
+    struct gdakiMiLogXItem it;
+    it.e = x.e;
+    it.step = x.step;
+    it.seg = x.seg;
+    const char* bad = gdakiMiEntryCheck(it.e);
+    if (bad == nullptr && it.step == GDAKI_RS_STEP_UNKNOWN) bad = "its step is unknown";
+    if (bad == nullptr && gdakiMiEntryMirrored(it.e.qpKf) && it.seg == 0) bad = "its segment is 0 (below every live one)";
+    if (bad == nullptr && !gdakiMiEntryMirrored(it.e.qpKf) && it.seg != 0) bad = "a segment on an entry not mirrored";
+    if (bad != nullptr) {
+      snprintf(why, whyLen, "entry %lu: %s", (unsigned long)i, bad);
+      return false;
+    }
+    if (gdakiMiEntryMirrored(it.e.qpKf)) {
+      out->nMirror++;
+      out->mirrorBytes += it.e.bytes;
+    }
+    out->items.push_back(it);
+  }
+  if (out->nMirror != out->hdr2.nMirror || out->mirrorBytes != out->hdr2.mirrorBytes) {
+    snprintf(why, whyLen, "the export says %lu MIRROR entries of %lu bytes, its entries %lu of %lu",
+             (unsigned long)out->hdr2.nMirror, (unsigned long)out->hdr2.mirrorBytes, (unsigned long)out->nMirror,
+             (unsigned long)out->mirrorBytes);
+    return false;
+  }
+  return true;
+}
