+// ---- gin-mirror (dev): pure (begin; impl/mi_unit_dev.cc compiles this region on the CPU) ----
+// The dev branch of gin-mirror (impl/PARALLEL.md; EXPERIMENT.md 9.2-9.5): the side table v4's layout, the two QP sets, the
+// MIRROR log entry, the export v2's parse, the step-aligned import's plan and its pacing. Placed after the spare branch's
+// region for its rkey list records. No NCCL, no CUDA, no network.
+
+// The side table v4 (impl/rs_mirror_api.h "device layout"): v1's allocation (gdakiRsSideLayoutOf) with, when nCells > 0
+// (the mirror on: one cell per rank), the cell array at cellsOff = 128 + 128 x nqp and the ring 256-byte aligned after it.
+// nCells 0: v1's layout, byte for byte (cellsOff 0).
+struct gdakiMiSideLayout {
+  struct gdakiRsSideLayout L;
+  size_t cellsOff = 0;
+};
+static bool gdakiMiSideLayoutOf(int nqp, int nLogged, long long entriesVar, int nCells, struct gdakiMiSideLayout* M) {
+  M->cellsOff = 0;
+  if (nCells < 0 || nCells > (int)NCCL_GIN_RS_QP_MASK || !gdakiRsSideLayoutOf(nqp, nLogged, entriesVar, &M->L))
+    return false;
+  if (nCells == 0) return true;
+  M->cellsOff = M->L.qpOff + (size_t)nqp * sizeof(struct ncclGinRsQp);
+  M->L.ringsOff = (M->cellsOff + (size_t)nCells * sizeof(struct ncclGinMiCell) + 255) & ~(size_t)255;
+  const unsigned long long total = (unsigned long long)M->L.ringsOff + (unsigned long long)M->L.ringBytes;
+  if (total > (1ULL << 40)) return false;
+  M->L.bytes = (size_t)((total + 4095) & ~4095ULL);
+  return true;
+}
+
+// The two QP sets (impl/rs_mirror_api.h), by side table index (context x nranks + peer); used(i): QP i is in use in the
+// context array and inside the side table. "User only": every context but the mirror context (miCtx; -1: no mirror), in
+// GIN-context order, at most NCCL_GIN_RECOVERY_MAX_QPS (gin-restore's set when miCtx is -1). The mirror QP to `peer`:
+// miCtx x nranks + peer, or -1 (no mirror, the own rank, a rank outside, not in use).
+template <typename U>
+static int gdakiMiUserQpsOf(int nContexts, int miCtx, int nranks, int peer, U used, int* idx) {
+  int n = 0;
+  if (peer < 0 || peer >= nranks) return 0;
+  for (int c = 0; c < nContexts && n < NCCL_GIN_RECOVERY_MAX_QPS; c++) {
+    if (c == miCtx) continue;
+    const int i = peer + c * nranks;
+    if (used(i)) idx[n++] = i;
+  }
+  return n;
+}
+template <typename U>
+static int gdakiMiMirrorQpOf(int miCtx, int nranks, int me, int peer, U used) {
+  if (miCtx < 0 || peer < 0 || peer >= nranks || peer == me) return -1;
+  const int i = miCtx * nranks + peer;
+  return used(i) ? i : -1;
+}
