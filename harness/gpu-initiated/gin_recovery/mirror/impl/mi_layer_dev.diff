+// The MIRROR entry (impl/rs_mirror_api.h): flag 0x20 on a put with data, its data's offset in the sender's lane in the
+// `csum` word in 64-byte units, never with a checksum scheme, NOBASE or SPLIT. With the mirror on every put with data the
+// export carries is mirrored (impl/rs_log_api.h v2: the exporter refuses, the importer checks again).
+static bool gdakiMiEntryMirrored(uint32_t qpKf) { return (ncclGinRsEntryFlags(qpKf) & NCCL_GIN_RS_LOGF_MIRROR) != 0; }
+static uint64_t gdakiMiEntryLaneOff(const struct ncclGinRsLogEntry& e) { return (uint64_t)e.csum << 6; }
+static const char* gdakiMiEntryCheck(const struct ncclGinRsLogEntry& e) {
+  const char* bad = gdakiRsEntryCheck(e);
+  if (bad != nullptr) return bad;
+  const uint32_t kind = ncclGinRsEntryKind(e.qpKf), f = ncclGinRsEntryFlags(e.qpKf);
+  const bool data = kind == NCCL_GIN_RS_LOG_PUT && e.bytes != 0;
+  if (!gdakiMiEntryMirrored(e.qpKf)) return data ? "a put with data that was not mirrored" : nullptr;
+  if (!data) return "a MIRROR flag on an entry that is not a put with data";
+  if ((f & (NCCL_GIN_RS_LOGF_SPLIT | NCCL_GIN_RS_LOGF_NOBASE | (3u << NCCL_GIN_RS_LOGF_CSUM_SHIFT))) != 0)
+    return "a MIRROR entry with a split, a checksum scheme or no source address";
+  return nullptr;
+}
