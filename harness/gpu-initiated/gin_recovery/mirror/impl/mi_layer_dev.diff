+// ---------------------------------------------------------------------------
+// gin-mirror (dev; EXPERIMENT.md 9.2, 9.3; impl/rs_mirror_api.h): the device mirror. In a program compiled with
+// NCCL_GIN_RESTORE_DEVICE whose side table says miOn, a put with data toward rank d whose cell is valid posts its data a
+// second time, with the same source and lkey, into this rank's lane for d in the pool of d's buddy b, over the mirror
+// context's QP to b (GPU sharing mode: every user context shares it), inside d's gate: the cursor's atomic add takes the
+// lane's place, a non-sleeping single entry of the mirror gate (an odd or failed gate is a break, never a wait), the pool
+// rkey read after that entry, the chunks counted on the mirror QP's msgs, the WRITE, the gate left (a slot wait's error
+// is reported as the mirror context's). The mirror wait at the end of a flush or a wait polls the mirror QP up to its
+// index then, in one counted poll region, bounded by the caller's deadline and abort word and by the epoch: whatever
+// stops it short is a break of the lanes b serves. The mirror path never parks, never sets abandoned, DEV_FAILED or a
+// sticky error and never changes what the application's call returns (the invariant of 9.3): a break is counted in the
+// cells (`broken`), and the helper DISARMs the destinations.
+// ---------------------------------------------------------------------------
+// The side table's entry of the mirror context's QP to `b`, or null (outside the side table).
+NCCL_DEVICE_INLINE static struct ncclGinRsQp* rsMiQpOf(struct ncclGinRsSide* rs, uint32_t miCtx, uint32_t nranks, int b) {
+  const uint32_t i = ncclGinMiQpIdx(miCtx, nranks, (uint32_t)b);
+  if (i >= nccl::utility::loadConst(&rs->nqp)) return nullptr;
+  return reinterpret_cast<struct ncclGinRsQp*>(reinterpret_cast<char*>(rs) + sizeof(struct ncclGinRsSide)) + i;
+}
+// This rank's cell for destination d, or null (no cells, or d outside them).
+NCCL_DEVICE_INLINE static struct ncclGinMiCell* rsMiCellOf(struct ncclGinRsSide* rs, int d) {
+  using nccl::utility::loadConst;
+  const uint64_t off = loadConst(&rs->miCellsOff);
+  if (off == 0 || d < 0 || (uint32_t)d >= loadConst(&rs->miNCells)) return nullptr;
+  return reinterpret_cast<struct ncclGinMiCell*>(reinterpret_cast<char*>(rs) + off) + d;
+}
+// One break more on this rank's lanes in the pool of b (the cells of b's wards; never this rank's own).
+NCCL_DEVICE_INLINE static void rsMiBreakWards(struct ncclGinRsSide* rs, int b, int nranks, int me) {
+  int w[2];
+  const int k = ncclGinMiWardsOf(b, nranks, w);
+  for (int i = 0; i < k; i++) {
+    struct ncclGinMiCell* const c = w[i] != me ? rsMiCellOf(rs, w[i]) : nullptr;
+    if (c != nullptr) atomicAdd(reinterpret_cast<unsigned long long*>(&c->broken), 1ull);
+  }
+}
+// The mirror of one put to `peer` (inside its gate; a put with data, not split). Returns 0 when nothing was mirrored, else
+// 1 << 32 | the lane word (the data's offset in the lane / 64) for the log entry. A valid cell that cannot be mirrored
+// (no usable mirror QP, a full lane, a closed mirror gate) is a break: one more on the cell, the put goes on alone.
+template <int Unused = 0>
+__device__ __noinline__ static uint64_t rsMiPut(ncclGinCtx ctx, struct ncclGinRsSide* rs, struct ncclGinGdakiQ4* q4,
+                                                int peer, uint64_t srcOff, __be32 lkey, uint64_t bytes) {
+  using nccl::utility::loadConst;
+  struct ncclGinMiCell* const c = peer != ctx.rank ? rsMiCellOf(rs, peer) : nullptr;
+  if (c == nullptr || tsLoadRelaxedSys(&c->valid) == 0) return 0;  // not mirrored toward d now: not a break
+  const int b = ncclGinMiBuddyOf(peer, ctx.nRanks);
+  const uint32_t miCtx = loadConst(&rs->miCtx);
+  struct ncclGinRsQp* const mq = b >= 0 ? rsMiQpOf(rs, miCtx, (uint32_t)ctx.nRanks, b) : nullptr;
+  if (mq != nullptr && tsLoadRelaxedSys(&mq->miUse) != 0) {
+    // written over the NIC while d's gates are odd: read through L2, not L1
+    const uint64_t laneBase = tsLoadRelaxedSys64(&c->laneBase);
+    const uint64_t laneBytes = tsLoadRelaxedSys64(&c->laneBytes);
+    // a put larger than the lane takes no room (and its round-up cannot wrap): a break
+    const uint64_t off = bytes <= laneBytes ? (uint64_t)atomicAdd(reinterpret_cast<unsigned long long*>(&c->cursor),
+                                                                  (unsigned long long)ncclGinMiRound64(bytes))
+                                            : ~0ull;
+    if (ncclGinMiFits(off, bytes, laneBytes)) {
+      ncclGinGdakiGPUContext* const mg = &((struct ncclGinGdakiGPUContext*)ctx.handle)[miCtx];
+      doca_gpu_dev_verbs_qp* const mqp = loadConst(&mg->gdqp) + b;
+      const bool gated = tsOn(mqp);  // the self loop (this rank is b) has no gate, as hk's put to itself
+      bool open = true;
+      if (gated) {  // one entry, never parked: a round, a hold of b or a failed QP closes it
+        const unsigned long long w = tsWordEnter(tsWord(mqp));
+        if (!tsWordOpen(w)) {
+          tsWordLeave(tsWord(mqp));
+          open = false;
+        }
+      } else {
+        // the self loop: DOCA's stock slot wait (no gate) spins for ever once a reservation's slot CQE (its index minus
+        // the SQ size) lies outside the CQ's window [ci, ci + cqe_num) while an error CQE stopped the consumer index.
+        // Two checks, no wait: the oldest outstanding completion is polled (an error there: the loop failed, a break,
+        // nothing more posted), and the reservation this put would take must keep its slot CQE inside the window (else
+        // a break: more than a ring of posts is blocked behind the consumer index). Reservations racing between the
+        // read and the add move the slot CQE further by the racers' chunks only; accepted (impl/notes_dev.md)
+        struct doca_gpu_dev_verbs_cq* const cq = doca_gpu_dev_verbs_qp_get_cq_sq(mqp);
+        const uint64_t ci = *(volatile uint64_t*)&cq->cqe_ci;
+        const uint64_t rsvd =
+          doca_gpu_dev_verbs_atomic_read<uint64_t, DOCA_GPUNETIO_VERBS_RESOURCE_SHARING_MODE_GPU>(&mqp->sq_rsvd_index);
+        const uint64_t nwqe = doca_gpu_dev_verbs_load_const(&mqp->sq_wqe_num);
+        const uint64_t cqeNum = doca_gpu_dev_verbs_load_const(&cq->cqe_num);
+        if (rsvd + ncclGinRsDataMsgs(true, bytes) > ci + nwqe + cqeNum) open = false;
+        else if (rsvd > ci && doca_gpu_dev_verbs_poll_one_cq_at<DOCA_GPUNETIO_VERBS_RESOURCE_SHARING_MODE_GPU>(mqp, ci) < 0)
+          open = false;
+      }
+      // after the entry: a rekey happens while the gate is odd; 0 is "unknown" (impl/rs_mirror_api.h): a break
+      const uint32_t rkey = open ? tsLoadRelaxedSys(&c->rkeyBe) : 0u;
+      if (open && rkey == 0) {
+        if (gated) tsWordLeave(tsWord(mqp));
+        open = false;
+      }
+      if (open) {
+        doca_gpu_dev_verbs_addr raddr, laddr;
+        raddr.addr = laneBase + off;  // the pool is registered zero-based
+        raddr.key = rkey;
+        laddr.addr = srcOff;
+        laddr.key = lkey;
+        atomicAdd(reinterpret_cast<unsigned long long*>(&mq->msgs), (unsigned long long)ncclGinRsDataMsgs(true, bytes));
+        doca_gpu_dev_verbs_put<DOCA_GPUNETIO_VERBS_RESOURCE_SHARING_MODE_GPU>(
+          mqp, raddr, laddr, bytes, q4CollapsedCodeOpt(mqp, DOCA_GPUNETIO_VERBS_GPU_CODE_OPT_DEFAULT));
+        if (gated) {
+          ncclGinCtx mctx = ctx;  // a slot wait's error CQE is reported as the mirror context's (the helper absorbs it)
+          mctx.contextId = (int)miCtx;
+          tsPostLeave(mctx, q4, mqp, b);
+        }
+        return (1ull << 32) | (uint64_t)(uint32_t)(off >> 6);
+      }
+    }
+  }
+  atomicAdd(reinterpret_cast<unsigned long long*>(&c->broken), 1ull);
+  return 0;
+}
