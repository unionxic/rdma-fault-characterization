+// The segments of this rank's lane toward one destination d (impl/rs_mirror_api.h "segments"). The host keeps them on
+// the helper thread; a rollback restores a copy taken before the switch.
+struct gdakiMiSeg {
+  uint64_t seg = 0;                   // segment number (from 1)
+  uint64_t start = 0;                 // the ring head of the pause that opened it (the oldest one's: the view's floor)
+  uint64_t cut = 0;                   // closed: the ring head of the pause that closed it (its entries are below)
+  uint64_t fill = 0;                  // closed: min(cursor, L) at its close
+  uint64_t closedAt = GDAKI_MI_OPEN;  // d's checkpoint whose pause closed it
+  uint64_t brokenOpen = 0;            // the cell's cumulative broken at its opening
+  uint64_t broken = 0;                // closed: breaks while it was open (the cell's and the host's)
+};
+struct gdakiMiSegs {
+  std::vector<struct gdakiMiSeg> live;  // closed in closing order, then the open one (closedAt GDAKI_MI_OPEN) last
+  uint64_t lastSeg = 0;                 // the last segment number opened (0: none)
+  uint32_t hostBreaks = 0;              // breaks the host saw while the open one is open (its QP given up, the self loop)
+  bool hasOpen() const { return !live.empty() && live.back().closedAt == GDAKI_MI_OPEN; }
+};
+// The switch in d's input pause of checkpoint `ckpt` (gates odd, count 0), from the cell read now (cursor, broken): the
+// open segment is closed at the pause's ring head, or, when the live segments would be more than `slots`, every live
+// segment is dropped (the restart: the caller DISARMs d and PAUSED is not armable); then the next one opens. Returns its
+// number. A cumulative counter below the opening's value counts as a break.
+static uint64_t gdakiMiSegsSwitch(struct gdakiMiSegs& s, uint64_t ckpt, uint64_t head, uint64_t cursor, uint64_t broken,
+                                  uint64_t slots, uint64_t laneBytes, bool* restart) {
+  *restart = gdakiMiSwitchVerdict((uint32_t)s.live.size(), (uint32_t)slots) == GDAKI_MI_SW_RESTART;
+  if (*restart) {
+    s.live.clear();
+  } else if (s.hasOpen()) {
+    struct gdakiMiSeg& o = s.live.back();
+    o.cut = head;
+    o.fill = cursor < laneBytes ? cursor : laneBytes;
+    o.closedAt = ckpt;
+    o.broken = (broken >= o.brokenOpen ? broken - o.brokenOpen : 1u) + s.hostBreaks;
+  }
+  struct gdakiMiSeg n;
+  n.seg = s.lastSeg + 1u;
+  n.start = head;
+  n.brokenOpen = broken;
+  s.live.push_back(n);
+  s.lastSeg = n.seg;
+  s.hostBreaks = 0;
+  return n.seg;
+}
+// CKPT_STABLE(k) of d: every closed segment whose closing checkpoint is <= k goes. Returns how many.
+static int gdakiMiSegsStable(struct gdakiMiSegs& s, uint64_t k) {
+  int n = 0;
+  for (size_t i = 0; i < s.live.size();)
+    if (s.live[i].closedAt != GDAKI_MI_OPEN && s.live[i].closedAt <= k) {
+      s.live.erase(s.live.begin() + (long)i);
+      n++;
+    } else {
+      i++;
+    }
+  return n;
+}
+// d's INJECTED (its import used them): every closed segment goes, the open one stays. Returns how many.
+static int gdakiMiSegsDropClosed(struct gdakiMiSegs& s) { return gdakiMiSegsStable(s, GDAKI_MI_OPEN - 1u); }
+// d's buddy was restored (a new pool): every segment goes; the numbers go on.
+static void gdakiMiSegsDropAll(struct gdakiMiSegs& s) {
+  s.live.clear();
+  s.hostBreaks = 0;
+}
+// Bytes the live segments hold now (the open one's: min(cursor, L)).
+static uint64_t gdakiMiSegsLiveBytes(const struct gdakiMiSegs& s, uint64_t cursor, uint64_t laneBytes) {
+  uint64_t b = 0;
+  for (const auto& g : s.live) b += g.closedAt == GDAKI_MI_OPEN ? (cursor < laneBytes ? cursor : laneBytes) : g.fill;
+  return b;
+}
+// The view the export v2 and HOLDING read (impl/rs_mirror_api.h gdakiMiSegView): the closed segments, the open one
+// (openCursor: the cursor the host last read; openBroken: the cell's cumulative broken at its opening, to subtract from
+// the device's value now; a host-side break shows as cellValid false), the floor. False: no live segment.
+static bool gdakiMiSegsViewOf(const struct gdakiMiSegs& s, bool cellValid, uint64_t cursor, struct gdakiMiSegView* out) {
+  *out = gdakiMiSegView();
+  if (s.live.empty()) return false;
+  for (const auto& g : s.live) {
+    if (g.closedAt == GDAKI_MI_OPEN) continue;
+    out->cuts.push_back(g.cut);
+    out->segs.push_back(g.seg);
+    out->fills.push_back(g.fill);
+    out->closedAt.push_back(g.closedAt);
+    out->broken.push_back(g.broken);
+  }
+  if (s.hasOpen()) {
+    out->openSeg = s.live.back().seg;
+    out->openCursor = cursor;
+    out->openBroken = s.live.back().brokenOpen;
+  }
+  out->floor = s.live.front().start;
+  out->cellValid = cellValid;
+  return true;
+}
