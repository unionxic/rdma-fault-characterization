+// ---- the poll (every helper step; impl/rs_mirror_api.h gdakiMiPoll) and the pull ----
+static void gdakiMiPoll(struct gdakiRecHost* r, std::vector<int>* disarm) {
+  if (!gdakiMiOn(r) || r->ts == nullptr || r->hold == nullptr) return;
+  struct gdakiMiHost* m = r->mi.host;
+  const int n = r->nranks, me = r->ctx->rank;
+  gdakiMiInjectedStep(r);
+  for (int p = 0; p < n; p++) {  // the mirror's parked records: CKPT_PULL for this rank; a MIRROR_SETUP after its wait
+    if (p == me) continue;
+    struct gdakiTsMsg x;
+    while (gdakiHoldTakeMsg(r, p, GDAKI_TS_CKPT_PULL, &x))
+      if (x.arg == me) m->pull.store(true, std::memory_order_release);
+    while (gdakiHoldTakeMsg(r, p, GDAKI_TS_MI_SETUP, &x)) {  // a late one: on = 0 is the peer's "not connected"
+      struct gdakiMiSetup s;
+      memcpy(&s, x.executed, sizeof(s));
+      const bool ours = x.from == p && x.arg == p && x.nonce == r->ts->nonce && s.version == GDAKI_MI_WIRE_VERSION;
+      const bool demote = ours && gdakiMiSetupDemotes(m->connected[(size_t)p] != 0, s.on);
+      if (demote) {
+        const int qi = (int)ncclGinMiQpIdx((uint32_t)r->mi.ctx, (uint32_t)n, (uint32_t)p);
+        r->qps[(size_t)qi].used = false;  // as on the peer: the hk rounds walk the same QPs on both ranks
+        m->connected[(size_t)p] = 0;
+        m->givenUp[(size_t)p] = 1;
+        if (gdakiMiSide(r)) (void)gdakiMiUseSet(r, qi, 0u);
+      }
+      GIN_TS_NOTE("GIN/MI: rank %d: a MIRROR_SETUP (on=%u) from rank %d after its wait: %s mono_ms=%.3f", me, s.on, p,
+                  demote ? "its mirror QP is not used (the peer did not connect it)" : "dropped", gdakiQ4MonoMs());
+    }
+  }
+  const double now = gdakiQ4MonoMs();
+  if (r->rsMeasureMs > 0) return gdakiMiMeasureStep(r, now);
+  if (!gdakiHoldCommArmedNow(r->hold)) return;  // before Resume no cell is valid
+  if (now >= m->nextSelfMs) {
+    m->nextSelfMs = now + 100.0;
+    gdakiMiSelfCheck(r);
+  }
+  if (now < m->nextPollMs) return;
+  m->nextPollMs = now + GDAKI_HOLD_LOG_POLL_MS;
+  bool any = false;
+  for (int d = 0; d < n && !any; d++) any = m->dest[(size_t)d].led.segs.hasOpen();
+  const size_t bytes = sizeof(struct ncclGinMiCell) * (size_t)n;
+  if (!any || !gdakiMiSide(r) || !gdakiLbOn(r) || bytes > r->pinnedSize) return;
+  std::vector<struct ncclGinMiCell> cells((size_t)n);
+  if (gdakiRecD2H(r, cells.data(), gdakiMiCellDev(r, 0), bytes) != ncclSuccess) return;
+  const uint64_t L = (uint64_t)m->conf.lane;
+  for (int d = 0; d < n; d++) {
+    struct gdakiMiDest& x = m->dest[(size_t)d];
+    if (d == me || !x.led.segs.hasOpen()) continue;
+    const struct ncclGinMiCell& c = cells[(size_t)d];
+    const uint64_t seg = x.led.segs.live.back().seg;
+    x.cursor = c.cursor;
+    bool dis = false, pull = false;
+    uint32_t pct = 0;
+    gdakiMiPollStep(x.poll, seg, c.cursor, c.broken, L, m->conf.pullPct, &dis, &pull, &pct);
+    if (dis) {
+      m->nBroken++;
+      GIN_TS_NOTE("GIN/MI: rank %d: lane to rank %d broken (device): DISARM mono_ms=%.3f", me, d, gdakiQ4MonoMs());
+      disarm->push_back(d);
+    }
+    if (pull && x.led.cellValid) {
+      struct gdakiTsMsg p;
+      gdakiHoldMsgInit(&p, GDAKI_TS_CKPT_PULL, d, 0);
+      p.round = seg;
+      p.pad = pct;
+      if (gdakiHoldSend(r, d, &p) == 0) {
+        m->nPullSent++;
+        GIN_TS_NOTE("GIN/MI: rank %d: CKPT_PULL to rank %d seg=%lu fill_pct=%u mono_ms=%.3f", me, d, (unsigned long)seg,
+                    pct, gdakiQ4MonoMs());
+      }
+    }
+    m->maxLive = std::max(m->maxLive, gdakiMiSegsLiveBytes(x.led.segs, c.cursor, L));
+  }
+}
+static bool gdakiMiPullTake(struct gdakiRecHost* r) {
+  if (!gdakiMiOn(r) || !r->mi.host->pull.exchange(false, std::memory_order_acq_rel)) return false;
+  r->mi.host->nPullTaken.fetch_add(1, std::memory_order_relaxed);
+  return true;
+}
