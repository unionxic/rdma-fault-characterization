+// The setup agreement (EXPERIMENT.md 9.2): the restore can be enabled and every rank's record asks for the mirror.
+static bool gdakiMiAgreed(int n, const uint32_t* pads, bool restoreEnabled) {
+  if (!restoreEnabled || n < 2) return false;
+  for (int p = 0; p < n; p++)
+    if (!(pads[p] & GDAKI_MI_PAD_MIRROR)) return false;
