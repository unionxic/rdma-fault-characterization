+// ---- INJECTED: the revived rank's send, a survivor's apply; RESTORED with the mirror ----
+static void gdakiMiInjectedReady(struct gdakiRecHost* r, uint64_t lastStep) {
+  if (!gdakiMiOn(r)) return;
+  r->mi.host->injStep.store(lastStep, std::memory_order_relaxed);
+  r->mi.host->injPending.store(1, std::memory_order_release);
+}
+static void gdakiMiInjectedStep(struct gdakiRecHost* r) {
+  struct gdakiMiHost* m = r->mi.host;
+  const int n = r->nranks, me = r->ctx->rank;
+  if (m->injPending.exchange(0, std::memory_order_acq_rel) != 0) {
+    const uint32_t self = gdakiRsPeerInc(r, me);
+    if (self == 0) {  // its own incarnation not known yet: kept for a later step
+      m->injPending.store(1, std::memory_order_release);
+    } else if (m->injSentInc != self) {  // once per incarnation
+      m->injSentInc = self;
+      m->injSent.assign((size_t)n, 0);
+      m->injActive = true;
+      m->injTries = 0;
+      m->injNextMs = 0;
+      m->injStepNow = m->injStep.load(std::memory_order_relaxed);
+    }
+  }
+  if (!m->injActive) return;
+  const double now = gdakiQ4MonoMs();
+  if (now < m->injNextMs) return;
+  m->injNextMs = now + 20.0;
+  int owed = 0, told = 0;
+  for (int p = 0; p < n; p++) {
+    if (!gdakiMiInjOwed(m->injSent, p, me, r->ts->peers[(size_t)p].declined)) continue;
+    struct gdakiTsMsg x;
+    gdakiHoldMsgInit(&x, GDAKI_TS_RS_INJECTED, me, 0);
+    x.round = m->injStepNow;
+    x.pad = m->injSentInc;
+    x.executed[0] = GDAKI_RS_WIRE_VERSION;
+    x.executed[1] = m->injSentInc;
+    if (gdakiHoldSend(r, p, &x) == 0) m->injSent[(size_t)p] = 1;
+    else owed++;
+  }
+  if (owed > 0 && ++m->injTries < 50) return;
+  m->injActive = false;
+  for (int p = 0; p < n; p++) told += m->injSent[(size_t)p] ? 1 : 0;
+  GIN_TS_NOTE("GIN/MI: rank %d: INJECTED sent step=%lu survivors=%d unsent=%d mono_ms=%.3f", me,
+              (unsigned long)m->injStepNow, told, owed, gdakiQ4MonoMs());
+}
+static bool gdakiMiKeepGatesOdd(struct gdakiRecHost* r, int peer) {
+  return gdakiMiOn(r) && gdakiHoldPeerState(r, peer, nullptr) == GDAKI_HOLD_COMMITTING;
+}
+static void gdakiStoreOnBuddyRestored(struct gdakiRecHost*, int) {}  // placeholder (integration replaces)
+static void gdakiMiApplyRestored(struct gdakiRecHost* r, int peer, const struct gdakiTsMsg& m) {
+  struct gdakiHold* h = gdakiHoldOf(r);
+  if (!gdakiMiOn(r) || !gdakiHoldPeerOk(h, peer)) return;
+  r->mi.host->restoredPad[(size_t)peer] = m.pad;
+  gdakiCkptPeerReset(r, peer);  // work package 5 (as gin-restore at RESTORED)
+  if (gdakiHoldBuddyOf(h->rank, h->nranks) == peer) gdakiStoreOnBuddyRestored(r, peer);  // impl/rs_store_api.h
+  // gin-restore's line, its text unchanged (the restore time is measured to it, EXPERIMENT.md 9.4 "4 KiB 셀"); the state
+  // it names is the one it keeps until INJECTED (published, or timed-out-published)
+  const struct gdakiHoldPeer& hp = h->peers[(size_t)peer];
+  const uint32_t st = gdakiHoldStateOf(gdakiHoldLoad(h->cells[peer]));
+  GIN_TS_NOTE("GIN/RS: rank %d: rank %d restored as incarnation %u (%s; %.1f ms after the hold start, %.1f ms after the "
+              "publish); state %s mono_ms=%.3f", h->rank, peer, m.pad,
+              st == GDAKI_HOLD_TIMED_OUT_PUBLISHED ? "read before the timed-out publish fell back" : "on time",
+              gdakiQ4MonoMs() - hp.holdStartMs, gdakiQ4MonoMs() - hp.publishMs, gdakiHoldStateName(st), gdakiQ4MonoMs());
+  gdakiHoldDisarmSelf(r, "this rank took part in a restore: armed again at its own next stable checkpoint");
+}
+static void gdakiHoldApplyInjected(struct gdakiRecHost* r, int peer, const struct gdakiTsMsg& m) {
+  struct gdakiHold* h = gdakiHoldOf(r);
+  if (!gdakiHoldPeerOk(h, peer)) return;
+  const uint64_t v = gdakiHoldLoad(h->cells[peer]);
+  const int c = gdakiMiInjectedCheck(gdakiMiOn(r), peer, m.arg, m.executed[0], GDAKI_RS_WIRE_VERSION, m.executed[1], m.pad,
+                                     gdakiHoldStateOf(v), gdakiHoldIncOf(v),
+                                     gdakiMiOn(r) ? r->mi.host->restoredPad[(size_t)peer] : 0u);
+  if (c != GDAKI_MI_INJ_APPLY) {
+    GIN_TS_NOTE("GIN/MI: rank %d: an INJECTED (incarnation %u, step %lu) from rank %d ignored (%s) in state %s "
+                "(incarnation %u) mono_ms=%.3f", h->rank, m.pad, (unsigned long)m.round, peer, gdakiMiInjectedWhy(c),
+                gdakiHoldStateName(gdakiHoldStateOf(v)), gdakiHoldIncOf(v), gdakiQ4MonoMs());
+    return;
+  }
+  struct gdakiHoldPeer& hp = h->peers[(size_t)peer];
+  const double t = gdakiQ4MonoMs();
+  // the user QPs' gates even: as the empty round (its commit point, the next even epoch, lbase unchanged); the mirror QP's
+  // gate was published even
+  const char* why = nullptr;
+  bool ok;
+  {
+    gdakiTsScopeGuard miScope(gdakiTsScope & gdakiMiUserScope(r));
+    ok = gdakiCkptEmptyRound(r, peer, &why);
+  }
+  if (!ok) {
+    char w[224];
+    snprintf(w, sizeof(w), "the user gates could not be made even at INJECTED (%.150s)", why ? why : "?");
+    return gdakiHoldFallback(r, peer, w);
+  }
+  // PUBLISHED or TIMED_OUT_PUBLISHED of incarnation i -> ARMED or OFF of i + 1 (as gin-restore at RESTORED)
+  const uint32_t ns = gdakiHoldRestoredState(gdakiHoldCommArmedNow(h), hp.disarmDuringHold,
+                                             gdakiHoldRespareRegistered(r, peer));
+  uint32_t from = 0, inc = 0;
+  if (!gdakiHoldRestoreMove(h->cells[peer], m.pad, ns, &from, &inc)) {  // only the helper leaves the published states
+    GIN_TS_NOTE("GIN/MI: rank %d: an INJECTED from rank %d found state %s (incarnation %u) after its gates went even "
+                "mono_ms=%.3f", h->rank, peer, gdakiHoldStateName(from), inc, gdakiQ4MonoMs());
+    return;
+  }
+  h->cells[peer].deadlineUs.store(0, std::memory_order_release);
+  int e = peer;
+  h->heldPeer.compare_exchange_strong(e, -1, std::memory_order_acq_rel);
+  hp.revivedFromValid = true;
+  hp.revivedFrom = inc;
+  hp.phase = GDAKI_HOLD_P_REJOIN;
+  gdakiHoldXferClose(hp);
+  h->nRestored.fetch_add(1, std::memory_order_relaxed);
+  gdakiMiSegDropClosed(r, peer);  // its import used them
+  GIN_TS_NOTE("GIN/MI: rank %d: INJECTED from rank %d step=%lu state=%s gate_odd_ms=%.1f mono_ms=%.3f", h->rank, peer,
+              (unsigned long)m.round, gdakiHoldStateName(ns), t - hp.gateOddMs, gdakiQ4MonoMs());
+}
