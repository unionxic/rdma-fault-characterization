+// ---- the mirror context (ncclGinGdakiCreateContext) ----
+// Whether this context gets the mirror context: asked, transparent recovery's variables, no companion QPs (transparent
+// recovery has none), rank stride 1, this library's GPU context version, at most GDAKI_MI_MAX_USER_CTX user contexts.
+struct gdakiMiPlan {
+  bool asked = false, create = false;
+  char why[160] = {0};
+};
+static struct gdakiMiPlan gdakiMiPlanOf(int nUserCtx, bool needCompanion, int rankStride, int backendVersion) {
+  struct gdakiMiPlan p;
+  p.asked = gdakiMiAsked() && ncclGinFaultUserCtx;
+  if (!p.asked) return p;
+  if (!(ncclParamGinFaultRecovery() && ncclParamGinFaultTransparent()))
+    snprintf(p.why, sizeof(p.why), "transparent recovery's variables are off");
+  else if (needCompanion)
+    snprintf(p.why, sizeof(p.why), "the context has counter (companion) QPs");
+  else if (rankStride != 1)
+    snprintf(p.why, sizeof(p.why), "the GIN rank stride is %d", rankStride);
+  else if (backendVersion != NCCL_GIN_GDAKI_GPU_CONTEXT_VERSION)
+    snprintf(p.why, sizeof(p.why), "the program's GPU context version is %d", backendVersion);
+  else if (nUserCtx > GDAKI_MI_MAX_USER_CTX)
+    snprintf(p.why, sizeof(p.why), "%d user GIN contexts; at most %d with the mirror (its index must be a bit of a round's "
+             "scope mask)", nUserCtx, GDAKI_MI_MAX_USER_CTX);
+  else
+    p.create = true;
+  return p;
+}
+static void gdakiMiPoolFree(struct gdakiMiPool* p) {
+  if (p == nullptr) return;
+  if (p->mr != nullptr) (void)wrap_ibv_dereg_mr(p->mr);
+  free(p->mem);
+  delete p;
+}
+// The pool: page-aligned host memory registered in the GIN PD, zero based (iova 0: a remote address is the offset in the
+// pool), local write, remote write and remote read (the drain's fence, the FETCH), no relaxed ordering; not gdakiRegMr
+// (its dmabuf path is for GPU memory).
+static struct gdakiMiPool* gdakiMiPoolCreate(struct ibv_pd* pd, uint64_t bytes, char* why, size_t whyLen) {
+  const size_t pg = (size_t)sysconf(_SC_PAGESIZE);
+  struct gdakiMiPool* p = new gdakiMiPool();
+  p->bytes = (size_t)((bytes + pg - 1) / pg * pg);
+  if (posix_memalign(&p->mem, pg, p->bytes) != 0) {
+    p->mem = nullptr;
+    snprintf(why, whyLen, "no %zu bytes of host memory", p->bytes);
+    delete p;
+    return nullptr;
+  }
+  if (wrap_ibv_reg_mr_iova2(&p->mr, pd, p->mem, p->bytes, 0,
+                            IBV_ACCESS_LOCAL_WRITE | IBV_ACCESS_REMOTE_WRITE | IBV_ACCESS_REMOTE_READ) != ncclSuccess ||
+      p->mr == nullptr) {
+    snprintf(why, whyLen, "ibv_reg_mr_iova2 of %zu bytes failed (errno %d)", p->bytes, errno);
+    p->mr = nullptr;
+    gdakiMiPoolFree(p);
+    return nullptr;
+  }
+  return p;
+}
+// The context's destroy takes the pool before gdakiRecFree and frees it after the QPs (no late WRITE lands in freed
+// memory); the pointer stays readable until gdakiMiFree (the helper is stopped by then).
+static struct gdakiMiPool* gdakiMiTakePool(struct gdakiRecHost* r) {
+  if (r == nullptr || r->mi.host == nullptr) return nullptr;
+  r->mi.host->poolTaken = true;
+  return r->mi.host->pool;
+}
+// After the user contexts' connects and self loops (single thread): the host state, the mirror QPs' rec entries (unused
+// until MIRROR_SETUP connects them; a spare's at its setup), the self loop pair, the pool. Nothing here fails the context:
+// a failure is a Resume condition (35, 38).
+static void gdakiMiContextSetup(struct gdaki_context* g, const struct gdakiMiPlan& plan, int nUserCtx, int nqpsForComm,
+                                struct ibv_pd* pd) {
+  struct gdakiRecHost* r = g->rec;
