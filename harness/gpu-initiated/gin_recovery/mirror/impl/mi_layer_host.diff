+static inline uint64_t gdakiMiSegOfPos(const uint64_t* cuts, const uint64_t* segs, int n, uint64_t openSeg,
+                                       uint64_t floor, uint64_t pos) {
+  if (pos < floor) return 0;
+  for (int i = 0; i < n; i++)
