+// The parameters (read once; impl/rs_mirror_api.h). Condition 37 with S outside 2..4 too: the pool's bytes for nWards
+// wards of n ranks within poolMaxMb MiB.
+struct gdakiMiConf {
+  int64_t slots = 3, lane = 1 << 20, pullPct = 50, poolMaxMb = 2048;
+};
+static bool gdakiMiConfOk(const struct gdakiMiConf& c, int nWards, int n, uint64_t* poolBytes, char* why, size_t whyLen) {
+  *poolBytes = 0;
+  if (c.lane <= 0 || (c.lane % 64) != 0) {
+    snprintf(why, whyLen, "L %lld is not a positive multiple of 64", (long long)c.lane);
+    return false;
+  }
+  if (c.slots < 2 || c.slots > GDAKI_MI_SEG_MAX) {
+    snprintf(why, whyLen, "S %lld is not 2..%d", (long long)c.slots, GDAKI_MI_SEG_MAX);
+    return false;
+  }
+  if (n < 2 || nWards < 0 || nWards > 2) {
+    snprintf(why, whyLen, "%d ranks, %d wards", n, nWards);
+    return false;
+  }
+  const uint64_t maxB = c.poolMaxMb > 0 ? (uint64_t)c.poolMaxMb << 20 : 0;
+  const uint64_t units = (uint64_t)nWards * (uint64_t)c.slots * (uint64_t)(n - 1);  // lanes of L bytes
+  if (units > 0 && (uint64_t)c.lane > maxB / units) {
+    snprintf(why, whyLen, "the pool, %llu lanes of %lld bytes, is above %lld MiB", (unsigned long long)units,
+             (long long)c.lane, (long long)c.poolMaxMb);
+    return false;
+  }
+  *poolBytes = ncclGinMiPoolBytes(nWards, (uint64_t)c.slots, n, (uint64_t)c.lane);
+  return true;
+}
