+    struct doca_gpu_verbs_qp_hl* a = g->gqps[nUserCtx * n + me];
+    struct doca_gpu_verbs_qp_hl* b = g->gqps[nqpsForComm + nUserCtx];
+    struct gdaki_exch_info x;
+    gdakiFillExchInfo(&x, g, b);
+    bool ok = gdakiConnectQp(g, a, &x) == ncclSuccess;
+    gdakiFillExchInfo(&x, g, a);
+    ok = ok && gdakiConnectQp(g, b, &x) == ncclSuccess;
+    m->selfOk = ok;
+    if (m->confOk) {
+      if (m->nWards == 0 || m->poolBytes == 0) {
+        m->poolOk = true;  // no ward: no pool
+      } else {
+        m->pool = gdakiMiPoolCreate(pd, m->poolBytes, m->poolWhy, sizeof(m->poolWhy));
+        m->poolOk = m->pool != nullptr;
+        if (m->pool) m->ownRkey = m->pool->mr->rkey;
