+// ---- the setup: the agreement (ts nullptr) and MIRROR_SETUP (gdakiTsSetup, before the helper starts) ----
+static void gdakiMiSetupEnd(struct gdakiRecHost* r, struct gdakiTs* ts, bool agreed, bool replay) {
