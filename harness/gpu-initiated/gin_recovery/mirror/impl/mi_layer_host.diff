+enum { GDAKI_MI_SR_OK = 0, GDAKI_MI_SR_TYPE = 1, GDAKI_MI_SR_FROM = 2, GDAKI_MI_SR_VERSION = 3, GDAKI_MI_SR_OFF = 4,
+       GDAKI_MI_SR_QPN = 5 };
+static int gdakiMiSetupRecCheck(uint32_t type, int from, int arg, uint64_t nonce, int expectFrom, uint64_t expectNonce,
+                                const struct gdakiMiSetup& s) {
+  if (type != GDAKI_TS_MI_SETUP) return GDAKI_MI_SR_TYPE;
+  if (from != expectFrom || arg != expectFrom || nonce != expectNonce) return GDAKI_MI_SR_FROM;
+  if (s.version != GDAKI_MI_WIRE_VERSION) return GDAKI_MI_SR_VERSION;
+  if (s.on != 1) return GDAKI_MI_SR_OFF;
+  if (s.qpn == 0 || s.qpn > 0xffffffu) return GDAKI_MI_SR_QPN;
+  return GDAKI_MI_SR_OK;
+}
+static const char* gdakiMiSetupRecWhy(int code) {
+  switch (code) {
+    case GDAKI_MI_SR_OK: return "ok";
+    case GDAKI_MI_SR_TYPE: return "another record came instead";
+    case GDAKI_MI_SR_FROM: return "a record of another rank or context";
+    case GDAKI_MI_SR_VERSION: return "another wire version";
+    case GDAKI_MI_SR_OFF: return "the peer has no mirror QP or pool";
+    case GDAKI_MI_SR_QPN: return "no QP number";
+    default: return "?";
+  }
+}
