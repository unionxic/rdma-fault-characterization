+  m->connected.assign((size_t)n, 0);
+  m->poolRkey.assign((size_t)n, 0);
+  m->givenUp.assign((size_t)n, 0);
+  m->restoredPad.assign((size_t)n, 0);
+  m->dest.resize((size_t)n);
+  m->measureArm = gdakiMiMeasureArm();
+  if (m->created) {
+    for (int p = 0; p < n; p++) {
+      if (p == me) continue;
+      struct gdakiRecQp& rq = r->qps[(size_t)(nUserCtx * n + p)];
+      rq.used = false;
+      rq.ctxIdx = nUserCtx;
+      rq.peer = p;
+      rq.qpIdx = nUserCtx * n + p;
+      rq.exch = r->qps[(size_t)p].exch;  // the peer's context 0: the same port (LID, GID, MTU, ordering); QPN: MIRROR_SETUP
+      rq.exch.qpn = 0;
