+  m->ctx = nUserCtx;
+  m->nUserCtx = nUserCtx;
+  snprintf(m->notWhy, sizeof(m->notWhy), "%s", plan.why);
+  m->conf = gdakiMiConfNow();
+  m->nWards = ncclGinMiWardsOf(me, n, m->wards);
