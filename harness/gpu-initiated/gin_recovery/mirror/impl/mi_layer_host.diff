+// This rank's ledger toward one destination d: the segments, what the host last wrote into d's cell, and the switch of
+// the pause in progress (the copy a rollback restores). The host code reads and writes the cell over the NIC; these
+// functions decide what to write and keep the ledger (the unit test drives them against a model of the cell).
+struct gdakiMiLedger {
+  struct gdakiMiSegs segs;
+  bool cellValid = false;          // what the host last wrote into the cell's `valid`
+  bool pend = false;               // a switch of a pause not ended yet
+  uint64_t pendCkpt = 0;
+  struct ncclGinMiCell pendCell;   // the cell as it was before that switch (a rollback writes its first 40 bytes back)
+  struct gdakiMiSegs pendSegs;     // the segments before it
+  bool pendValid = false;          // cellValid before it
+};
+// The switch in d's pause of checkpoint `ckpt`, from the cell `c` read now: the ledger moves (the copy kept for a
+// rollback) and *w is the cell to write (its first 40 bytes: valid, rkey, segment, lane, L, cursor 0). Returns the new
+// segment number.
+static uint64_t gdakiMiLedgerSwitch(struct gdakiMiLedger& x, const struct ncclGinMiCell& c, uint64_t ckpt, uint64_t head,
+                                    bool wantValid, uint32_t rkeyBe, int wardIdx, int lane, int n, uint64_t slots,
+                                    uint64_t laneBytes, bool* restart, struct ncclGinMiCell* w) {
+  x.pend = true;
+  x.pendCkpt = ckpt;
+  x.pendCell = c;
+  x.pendSegs = x.segs;
+  x.pendValid = x.cellValid;
+  const uint64_t seg = gdakiMiSegsSwitch(x.segs, ckpt, head, c.cursor, c.broken, slots, laneBytes, restart);
+  *w = c;
+  w->valid = wantValid ? 1u : 0u;
+  w->rkeyBe = rkeyBe;
+  w->seg = seg;
+  w->laneBase = ncclGinMiLaneOff(wardIdx, seg % slots, lane, n, slots, laneBytes);
+  w->laneBytes = laneBytes;
+  w->cursor = 0;
+  return seg;
+}
+// A break the host saw (a mirror QP given up, the self loop, a cell it could not write): counted in the open segment
+// (and in the copy a rollback would restore), the cell invalid, and a rollback writes it back invalid too.
+static void gdakiMiLedgerHostBreak(struct gdakiMiLedger& x) {
+  x.segs.hostBreaks++;
+  if (x.pend) x.pendSegs.hostBreaks++;
+  x.cellValid = false;
+  x.pendCell.valid = 0;
+  x.pendValid = false;
+}
+// The switch's write: written (and read back) or not (a host break; the cell is made invalid).
+static void gdakiMiLedgerSwitchWritten(struct gdakiMiLedger& x, const struct ncclGinMiCell& w, bool ok) {
+  if (ok) x.cellValid = w.valid != 0;
+  else gdakiMiLedgerHostBreak(x);
+}
+// The end of the pause of `ckpt` (impl/rs_mirror_api.h gdakiMiSegPauseEnd): true when the caller must write pendCell's
+// first 40 bytes back (a rollback of this pause's switch); then gdakiMiLedgerRolledBack.
+static bool gdakiMiLedgerPauseEnd(struct gdakiMiLedger& x, uint64_t ckpt, bool rollback) {
+  if (!x.pend || x.pendCkpt != ckpt) return false;
+  x.pend = false;
+  return rollback;
+}
+static void gdakiMiLedgerRolledBack(struct gdakiMiLedger& x, bool ok) {
+  if (ok) {
+    x.segs = x.pendSegs;
+    x.cellValid = x.pendValid;
+  } else {
+    gdakiMiLedgerHostBreak(x);  // the new segment stays, as a switch that failed
+  }
+}
+// CKPT_STABLE(k): the closed segments up to k go, also from the copy (a rollback must not bring them back).
+static void gdakiMiLedgerStable(struct gdakiMiLedger& x, uint64_t k) {
+  (void)gdakiMiSegsStable(x.segs, k);
+  if (x.pend) (void)gdakiMiSegsStable(x.pendSegs, k);
+}
+// INJECTED of d: its closed segments go; a pause of the incarnation that died is not rolled back any more.
+static void gdakiMiLedgerDropClosed(struct gdakiMiLedger& x) {
+  (void)gdakiMiSegsDropClosed(x.segs);
+  x.pend = false;
+}
+// d's buddy restored (a new pool): every segment goes, the cell is written invalid with the new key.
+static void gdakiMiLedgerDropAll(struct gdakiMiLedger& x) {
+  gdakiMiSegsDropAll(x.segs);
+  x.pend = false;
+  x.cellValid = false;
+}
