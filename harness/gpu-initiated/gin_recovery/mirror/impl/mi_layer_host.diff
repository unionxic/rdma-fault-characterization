+  GIN_TS_NOTE("GIN/MI: rank %d: mirror summary switches=%lu rollbacks=%lu restarts=%lu third_slot=%lu max_live_bytes=%lu "
+              "pulls_sent=%lu pulls_taken=%lu broken=%lu absorbed=%lu mono_ms=%.3f", r->ctx->rank,
+              (unsigned long)m->nSwitch, (unsigned long)m->nRollback, (unsigned long)m->nRestart,
+              (unsigned long)m->nThird, (unsigned long)m->maxLive, (unsigned long)m->nPullSent,
+              (unsigned long)m->nPullTaken.load(), (unsigned long)m->nBroken, (unsigned long)m->nAbsorbed,
+              gdakiQ4MonoMs());
