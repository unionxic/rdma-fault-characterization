+  GIN_TS_NOTE("GIN/MI: rank %d: mirror context %s ctx=%d wards=%d slots=%lld lane=%lld pool_bytes=%llu pool=%s self_loop=%s"
+              "%s%s%s%s mono_ms=%.3f", me, m->created ? "created" : "not created", nUserCtx, m->nWards,
+              (long long)m->conf.slots, (long long)m->conf.lane, (unsigned long long)m->poolBytes,
+              m->pool ? "registered" : m->poolOk ? "none" : "failed", m->selfOk ? "connected" : "no",
+              m->created ? "" : " why=", m->created ? "" : m->notWhy, m->confOk ? "" : " conf=",
+              m->confOk ? "" : m->confWhy, gdakiQ4MonoMs());
+  if (m->created && m->confOk && !m->poolOk)
+    WARN("GIN/MI: rank %d: the mirror pool could not be registered (%s)", me, m->poolWhy);
+}
