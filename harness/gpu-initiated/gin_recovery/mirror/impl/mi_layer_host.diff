+// MIRROR_SETUP's connection (EXPERIMENT.md 9.2): a rank connects its mirror QP to p when its own side is on, p's first
+// record is usable (on) and the connect and the baseline succeed. A rank whose own side is on and did not connect to p
+// sends p a second record with on = 0; p, which may have connected on the first one, gives that QP up when it reads it
+// (gdakiMiPoll). So both ranks of a pair end with the same mirror QP set (the hk rounds walk the same QPs).
+static bool gdakiMiSetupConnects(bool mineOn, int recCode, bool connectOk) {
+  return mineOn && recCode == GDAKI_MI_SR_OK && connectOk;
+}
+static bool gdakiMiSetupSendsOff(bool mineOn, bool connected) { return mineOn && !connected; }
+static bool gdakiMiSetupDemotes(bool connected, uint32_t lateOn) { return connected && lateOn == 0; }
+
+// The restore round's publish word of a QP (impl/rs_hold_api.h v2): with the gates kept odd (the mirror on, a restore
+// round), the user contexts' QPs get the new epoch odd, the mirror context's QP the new epoch even; else even.
+static uint32_t gdakiMiPublishWord(bool keepOdd, int ctxIdx, int miCtx, uint32_t eNew) {
+  return (keepOdd && ctxIdx != miCtx) ? (eNew | 1u) : eNew;
+}
+
+// A fault record of the mirror context (G4, before gdakiHoldRoute): NOT_MINE (another context, or the mirror off: the
+// record goes on to gin-restore's routes), STALE (older than the QP's covered epoch: a record of an epoch a round already
+// published; only its handled epoch moves), GIVE_UP (the QP is given up).
+enum { GDAKI_MI_AB_NOT_MINE = 0, GDAKI_MI_AB_STALE = 1, GDAKI_MI_AB_GIVE_UP = 2 };
+static int gdakiMiAbsorbVerdict(bool on, int ctx, int miCtx, uint32_t recEpoch, uint32_t coveredEpoch) {
+  if (!on || miCtx < 0 || ctx != miCtx) return GDAKI_MI_AB_NOT_MINE;
+  return recEpoch < coveredEpoch ? GDAKI_MI_AB_STALE : GDAKI_MI_AB_GIVE_UP;
+}
