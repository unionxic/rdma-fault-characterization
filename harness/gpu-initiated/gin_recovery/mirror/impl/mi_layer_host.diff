+static inline int gdakiMiHoldingVerdict(const struct gdakiMiHolding& h, uint64_t k) {
+  if (h.version != GDAKI_MI_WIRE_VERSION || h.nSeg > GDAKI_MI_SEG_MAX) return 1;
