+static bool gdakiMiOn(struct gdakiRecHost* r) { return r != nullptr && r->mi.on && r->mi.host != nullptr; }
+static uint32_t gdakiMiUserScope(struct gdakiRecHost* r) {
+  static_assert(GDAKI_TS_SCOPE_ALL == 0xffffffffu, "gdakiMiUserScopeOf's every context");
+  return gdakiMiUserScopeOf(gdakiMiOn(r), gdakiMiOn(r) ? r->mi.ctx : -1);
