+// ---- the export v2 (impl/rs_log_api.h v2), the survivor's STATE with the mirror ----
+// As gdakiRsLogExport (the entries from gdakiRsLogCollect, whole since the cut; their messages per user QP equal m minus M
+// at the cut's pause), then no source byte: each entry gets its step (gdakiCkptStepPairs) and a MIRROR entry its segment
+// (gdakiMiSegViewOf, the open one the device's from the hold start). Refused before the stream when a put with data has no
+// MIRROR flag, a MIRROR entry lies below the oldest live segment, an entry's step is unknown, a live segment after the
+// checkpoint had a break (the hold start's payload), or the hold start's mirror facts are missing. The stream ends with
+// this rank's own rkey list (windows, signal and counter tables, the pool; its own incarnation). The line "export to rank".
+static ncclResult_t gdakiMiLogExport(struct gdakiRecHost* r, int peer, uint64_t ckpt, uint64_t cut, uint64_t head,
+                                     uint32_t incarnation, const uint64_t* x, const uint64_t* m, int nqp,
+                                     bool (*put)(void* arg, const void* p, size_t n), void* arg, char* why,
+                                     size_t whyLen) {
+  if (!gdakiRsLogReady(r)) return gdakiRsLogNotReady(why, whyLen);
+  struct gdakiRsLogHost* lh = r->rsLog;
+  int idx[NCCL_GIN_RECOVERY_MAX_QPS];
+  const int n = gdakiRsQpsOfPeer(r, peer, idx);
+  if (n == 0 || n != nqp || r->ts == nullptr || put == nullptr) {
+    snprintf(why, whyLen, "rank %d has %d QPs here, %d counts given", peer, n, nqp);
+    return ncclInvalidUsage;
+  }
+  struct gdakiMiSpareState* s = gdakiMiSpareOf(r);
+  if (s == nullptr || peer < 0 || peer >= (int)s->peers.size() || !s->peers[(size_t)peer].holdRead) {
+    snprintf(why, whyLen, "no mirror facts of rank %d were read at the hold start", peer);
+    return ncclInvalidUsage;
+  }
+  const struct gdakiMiSparePeer& sp = s->peers[(size_t)peer];
+  if (sp.own.version != GDAKI_MI_WIRE_VERSION) {
+    snprintf(why, whyLen, "the mirror facts of rank %d at the hold start are not usable", peer);
+    return ncclInvalidUsage;
+  }
+  for (uint32_t i = 0; i < sp.own.nSeg; i++) {
+    const struct gdakiMiHoldSeg& g = sp.own.seg[i];
+    if ((g.closedAt == GDAKI_MI_OPEN || g.closedAt > ckpt) && g.broken != 0) {
+      snprintf(why, whyLen, "this rank's lane for rank %d broke %u time(s) in segment %lu after checkpoint %lu", peer,
+               g.broken, (unsigned long)g.seg, (unsigned long)ckpt);
+      return ncclInvalidUsage;
+    }
+  }
+  std::vector<struct ncclGinRsLogEntry> ents;
+  const ncclResult_t rc = gdakiRsLogCollect(r, peer, cut, head, &ents, why, whyLen);
+  if (rc != ncclSuccess) return rc;
+  uint64_t mCut[NCCL_GIN_RECOVERY_MAX_QPS];
+  for (int k = 0; k < n; k++)
+    if (!gdakiRsLogStateMsgsAt(&lh->st, idx[k], cut, &mCut[k])) {
+      snprintf(why, whyLen, "qp %d: no message count kept for the pause at position %lu", idx[k], (unsigned long)cut);
+      return ncclInvalidUsage;
+    }
+  char cw[200];
+  if (!gdakiRsLogXMsgsCheck(ents.data(), ents.size(), idx, n, m, mCut, cw, sizeof(cw))) {
+    snprintf(why, whyLen, "the log toward rank %d is not whole: %s", peer, cw);
+    return ncclInvalidUsage;
+  }
+  std::vector<uint64_t> steps, heads;
+  uint64_t lastStep = GDAKI_RS_STEP_UNKNOWN;
+  gdakiCkptStepPairs(r, cut, &steps, &heads, &lastStep);
+  const int nPairs = (int)std::min(steps.size(), heads.size());
+  struct gdakiMiSegView view;
+  const bool haveView = gdakiMiSegViewOf(r, peer, &view);
+  const int nClosed = haveView ? (int)std::min(view.cuts.size(), view.segs.size()) : 0;
+  uint64_t openSeg = haveView ? view.openSeg : 0;
+  for (uint32_t i = 0; i < sp.own.nSeg; i++)  // the device's open segment at the hold start
+    if (sp.own.seg[i].closedAt == GDAKI_MI_OPEN) openSeg = sp.own.seg[i].seg;
+  std::vector<struct gdakiRsLogXEnt2> out(ents.size());
+  uint64_t nMirror = 0, mirrorBytes = 0, firstStep = 0, lastTag = 0;
+  for (size_t i = 0; i < ents.size(); i++) {
+    const uint64_t pos = gdakiMiPos64(cut, ents[i].pos);
+    const int v = gdakiMiExportTag(ents[i], pos, ckpt, steps.data(), heads.data(), nPairs, lastStep,
+                                   haveView ? view.cuts.data() : nullptr, haveView ? view.segs.data() : nullptr, nClosed,
+                                   openSeg, haveView ? view.floor : 0, &out[i]);
+    if (v != GDAKI_MI_X_OK) {
+      snprintf(why, whyLen, "export to rank %d refused at position %lu: %s", peer, (unsigned long)pos,
+               gdakiMiExportTagName(v));
+      WARN("GIN/MI: rank %d: export to rank %d refused: %s (position %lu) mono_ms=%.3f", r->ctx->rank, peer,
+           gdakiMiExportTagName(v), (unsigned long)pos, gdakiQ4MonoMs());
+      return ncclInvalidUsage;
+    }
+    if (out[i].seg != 0) {
+      nMirror++;
+      mirrorBytes += ents[i].bytes;
+    }
+    if (i == 0) firstStep = out[i].step;
+    lastTag = std::max(lastTag, out[i].step);
+    firstStep = std::min(firstStep, out[i].step);
+  }
+  struct gdakiRsLogXHdr hdr;
+  memset(&hdr, 0, sizeof(hdr));
+  hdr.magic = GDAKI_RS_LOGX_MAGIC;
+  hdr.version = GDAKI_RS_LOGX_VERSION_MI;
+  hdr.from = r->ctx->rank;
+  hdr.to = peer;
+  hdr.incarnation = incarnation;
+  hdr.nqp = (uint32_t)n;
+  hdr.nonce = r->ts->nonce;
+  hdr.ckpt = ckpt;
+  hdr.cut = cut;
+  hdr.head = head;
+  hdr.nEntries = ents.size();
+  for (int k = 0; k < n; k++) {
+    hdr.x[k] = x[k];
+    hdr.m[k] = m[k];
+  }
+  struct gdakiRsLogXHdr2 h2;
+  memset(&h2, 0, sizeof(h2));
+  h2.flags = GDAKI_RS_LOGX_F_MIRROR;
+  h2.mirValid = sp.mirValid ? 1u : 0u;
+  h2.mirX = sp.mirX;
+  h2.mirM = sp.mirM;
+  h2.lastStep = lastStep;
+  h2.nMirror = nMirror;
+  h2.mirrorBytes = mirrorBytes;
+  struct gdakiRsLogXEnd end;
+  memset(&end, 0, sizeof(end));
+  end.magic = GDAKI_RS_LOGX_MAGIC;
+  end.ok = 1;
+  struct gdakiRsRkeys keys;
+  gdakiRsSpareRkeys(r, gdakiRsSelfInc(r), &keys);  // this rank's own list (its pool included)
+  struct gdakiRsRkeysHdr kh;
+  memset(&kh, 0, sizeof(kh));
+  kh.magic = GDAKI_RS_RKEYS_MAGIC;
+  kh.version = 1u;
+  kh.rank = keys.rank;
+  kh.incarnation = keys.incarnation;
+  kh.nonce = keys.nonce;
+  kh.count = (uint32_t)keys.e.size();
+  auto putf = [&](const void* p, size_t k) { return put(arg, p, k); };
+  if (!gdakiMiLogXWrite2(hdr, h2, out.data(), out.size(), end, kh, keys.e.data(), putf)) {
+    snprintf(why, whyLen, "the export to rank %d could not be written", peer);
+    return ncclSystemError;
+  }
+  WARN("GIN/MI: rank %d: export to rank %d: entries=%zu mirror_entries=%lu mirror_bytes=%lu source_bytes=0 "
+       "first_step=%lu last_step=%lu mono_ms=%.3f", r->ctx->rank, peer, ents.size(), (unsigned long)nMirror,
+       (unsigned long)mirrorBytes, (unsigned long)firstStep, (unsigned long)lastTag, gdakiQ4MonoMs());
+  return ncclSuccess;
+}
