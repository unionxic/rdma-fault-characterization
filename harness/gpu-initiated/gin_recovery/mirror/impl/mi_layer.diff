+  std::vector<struct gdakiRsImportWin> wins;
+  for (const auto& w : gdakiRsWins)
+    if (w.coll == coll && !w.gone && w.id != 0) wins.push_back({w.id, (uint64_t)(w.hi - w.lo)});
+  uint64_t sigBytes = 0;
+  if (r->ctx->signals_table != nullptr && r->ctx->signals_table->gpu_ptr != nullptr)
+    sigBytes = (uint64_t)r->ctx->signals_table->buffer_bytes();
+  struct gdakiMiImport* imp = new gdakiMiImport();
+  struct DelOnFail {
+    struct gdakiMiImport** p;
+    ~DelOnFail() { delete *p; }
+  } del{&imp};
+  auto fetch = [&](int sender, uint64_t seg, uint64_t off, uint64_t bytes) {
+    return gdakiMiFetchedAt(fetched, sender, seg, off, bytes);
+  };
+  if (!gdakiMiImportPlanOf(me, ckpt, incarnation, r->ts->nonce, nqpOf.data(), nranks, pp.data(), (int)pp.size(), exports,
+                           wins.data(), (int)wins.size(), sigBytes, fetch, &imp->plan, pw, sizeof(pw)))
+    return refuse(pw);
+  uint64_t sigTotal = 0;
+  if (!gdakiMiImportSigCheck(exports, imp->plan, &sigTotal, pw, sizeof(pw))) return refuse(pw);
+  bool anySig = false;
+  for (const auto& sp : imp->plan.steps) {
+    anySig = anySig || !sp.sigs.empty();
+    for (const auto& t : sp.sigs) {
+      uint32_t rkey = 0;
+      if (!gdakiMiSigTarget(r, t, &rkey, pw, sizeof(pw))) return refuse(pw);
+    }
+  }
+  if (anySig && !lh->atomicOk) {
+    snprintf(pw, sizeof(pw), "this rank cannot add signals with NIC atomics (%s)", lh->atomicWhy);
+    return refuse(pw);
+  }
+  // the survivors' rkey lists, checked before anything is written: a survivor restored before (incarnation above 0)
+  // must name exactly the windows registered here, each with a slot for it in this rank's table, and only tables this
+  // rank has (its new keys replace the recorded ones); for one of incarnation 0 a difference is a WARN and the recorded
+  // values stay (impl/rs_spare_api.h v2)
+  for (const auto& pe : imp->plan.peers) {
+    const bool strict = pe.incarnation > 0;
+    for (const auto& w : gdakiRsWins) {
+      if (w.coll != coll || w.gone || w.id == 0) continue;
+      bool named = false;
+      for (const auto& en : pe.keys) named = named || (en.kind == GDAKI_RS_RKEY_WINDOW && en.id == w.id);
+      if (!named && strict) {
+        snprintf(pw, sizeof(pw), "rank %d's rkey list misses window %u", pe.rank, w.id);
+        return refuse(pw);
+      }
+      if (!named)
+        WARN("GIN/MI: rank %d: rank %d's rkey list misses window %u (incarnation 0: the recorded key stays) mono_ms=%.3f", me,
+             pe.rank, w.id, gdakiQ4MonoMs());
+    }
+    for (const auto& en : pe.keys) {
+      const char* bad = nullptr;
+      const size_t need = (size_t)(pe.rank + 1) * sizeof(uint32_t);
+      if (en.kind == GDAKI_RS_RKEY_WINDOW) {
+        const struct gdakiRsWin* w = gdakiMiWinOf(r, en.id);
+        if (w == nullptr) bad = "names a window that is not registered here";
+        else if (w->rkeys == nullptr || need > w->rkeysBytes) bad = "names a window whose rkey table has no slot for it";
+      } else if (en.kind == GDAKI_RS_RKEY_SIGNALS) {
+        if (r->ctx->signals_table == nullptr || r->ctx->signals_table->rkeys_bytes() < need) bad = "names no signal table";
+      } else if (en.kind == GDAKI_RS_RKEY_COUNTERS) {
+        if (r->ctx->counters_table == nullptr || r->ctx->counters_table->rkeys_bytes() < need) bad = "names no counter table";
+      } else if (en.kind != GDAKI_MI_RKEY_POOL) {
+        bad = "has an entry of an unknown kind";
+      }
+      if (bad == nullptr) continue;
+      if (strict) {
+        snprintf(pw, sizeof(pw), "rank %d's rkey list %s (kind %u, id %u)", pe.rank, bad, en.kind, en.id);
+        return refuse(pw);
+      }
+      WARN("GIN/MI: rank %d: rank %d's rkey list %s (kind %u, id %u; incarnation 0: ignored) mono_ms=%.3f", me, pe.rank, bad,
+           en.kind, en.id, gdakiQ4MonoMs());
+    }
+  }
+  // survivors more than one step apart: a lagging survivor's held puts may be inputs of a step the others' entries end
+  // before; the restore then waits for its PUBLISHED deadline (EXPERIMENT.md 9.4, requirement 14)
+  {
+    uint64_t lo = ~0ull, hi = 0;
+    for (const auto& pe : imp->plan.peers) {
+      lo = std::min(lo, pe.lastStep);
+      hi = std::max(hi, pe.lastStep);
+    }
+    if (!imp->plan.peers.empty() && hi - lo > 1)
+      WARN("GIN/MI: rank %d: the survivors' last steps before the hold span %lu .. %lu (more than one step apart) "
+           "mono_ms=%.3f", me, (unsigned long)lo, (unsigned long)hi, gdakiQ4MonoMs());
+  }
+  struct gdakiRsDevGuard g;
+  if (!gdakiRsAppStream(r, &g)) {
+    snprintf(why, whyLen, "the step-aligned import was refused, nothing applied: no CUDA stream on device %d",
+             r->ctx->cuda_id);
+    return ncclUnhandledCudaError;
+  }
+  // the image's copies have landed before anything here is read or written (gdakiRsSpareImport's rule)
+  if (cudaDeviceSynchronize() != cudaSuccess) {
+    snprintf(why, whyLen, "the step-aligned import was refused, nothing applied: the device did not synchronize");
+    return ncclUnhandledCudaError;
+  }
+  cudaStream_t st = lh->appStream;
+  // the side table's header as gdakiRsStart wrote it: where the cells are (none: the pool rkeys are not written)
+  struct ncclGinRsSide hdr;
+  memset(&hdr, 0, sizeof(hdr));
+  if (cudaMemcpyAsync(&hdr, r->rsBase, sizeof(hdr), cudaMemcpyDeviceToHost, st) != cudaSuccess ||
+      cudaStreamSynchronize(st) != cudaSuccess) {
+    snprintf(why, whyLen, "the step-aligned import was refused, nothing applied: the side table could not be read");
+    return ncclUnhandledCudaError;
+  }
+  auto partWay = [&](const char* what) {
+    snprintf(why, whyLen, "the step-aligned import failed part way (%s); the restore falls back", what);
+    return ncclSystemError;
+  };
+  // (1) the rkey slots of each survivor: read, compared, written (incarnation above 0) and read back
+  int nWritten = 0, nWarned = 0, nPool = 0;
+  for (const auto& pe : imp->plan.peers) {
+    for (const auto& en : pe.keys) {
+      uint32_t* dev = nullptr;
+      uint32_t* host = nullptr;
+      const size_t need = (size_t)(pe.rank + 1) * sizeof(uint32_t);
+      if (en.kind == GDAKI_RS_RKEY_WINDOW) {
+        const struct gdakiRsWin* w = gdakiMiWinOf(r, en.id);
+        if (w == nullptr || w->rkeys == nullptr || need > w->rkeysBytes) continue;  // incarnation 0 only (checked above)
+        dev = (uint32_t*)w->rkeys + pe.rank;
+        struct gdaki_mem_handle* mh = (struct gdaki_mem_handle*)w->mhandle;
+        if (mh != nullptr && mh->rkeys_hd_mhandle != nullptr && mh->rkeys_hd_mhandle->host_buf != nullptr)
+          host = mh->rkeys_hd_mhandle->host_buf + pe.rank;
+      } else if (en.kind == GDAKI_RS_RKEY_SIGNALS && r->ctx->signals_table != nullptr &&
+                 r->ctx->signals_table->rkeys_bytes() >= need) {
+        dev = r->ctx->signals_table->get_rkeys_d() + pe.rank;
+      } else if (en.kind == GDAKI_RS_RKEY_COUNTERS && r->ctx->counters_table != nullptr &&
+                 r->ctx->counters_table->rkeys_bytes() >= need) {
+        dev = r->ctx->counters_table->get_rkeys_d() + pe.rank;
+      } else if (en.kind == GDAKI_MI_RKEY_POOL) {  // the survivor's pool: the cells of its wards, invalid until a switch
+        for (int d = 0; d < nranks; d++) {
+          void* cell = d != me && ncclGinMiBuddyOf(d, nranks) == pe.rank ? gdakiMiCellDev(r, hdr, d) : nullptr;
+          if (cell == nullptr) continue;
+          const uint32_t v[2] = {0u, en.rkeyBe};
+          uint32_t back[2] = {1u, 0u};
+          if (cudaMemcpyAsync(cell, v, sizeof(v), cudaMemcpyHostToDevice, st) != cudaSuccess ||
+              cudaMemcpyAsync(back, cell, sizeof(back), cudaMemcpyDeviceToHost, st) != cudaSuccess ||
+              cudaStreamSynchronize(st) != cudaSuccess || back[0] != v[0] || back[1] != v[1])
+            return partWay("a cell's pool rkey could not be written");
+          nPool++;
+        }
+        continue;
+      }
+      if (dev == nullptr) continue;
+      uint32_t have = 0;
+      if (cudaMemcpyAsync(&have, dev, sizeof(have), cudaMemcpyDeviceToHost, st) != cudaSuccess ||
+          cudaStreamSynchronize(st) != cudaSuccess)
+        return partWay("an rkey slot could not be read");
+      const int v = gdakiMiRkeyVerdict(pe.incarnation, have, en.rkeyBe);
+      if (v == GDAKI_MI_RKEY_WARN) {
+        nWarned++;
+        WARN("GIN/MI: rank %d: rank %d (incarnation 0) lists rkey %#x for kind %u id %u, the replayed table has %#x: the "
+             "recorded value stays mono_ms=%.3f", me, pe.rank, (unsigned)en.rkeyBe, en.kind, en.id, (unsigned)have,
+             gdakiQ4MonoMs());
+      } else if (v == GDAKI_MI_RKEY_WRITE) {
+        uint32_t back = 0;
+        if (cudaMemcpyAsync(dev, &en.rkeyBe, sizeof(uint32_t), cudaMemcpyHostToDevice, st) != cudaSuccess ||
+            cudaMemcpyAsync(&back, dev, sizeof(back), cudaMemcpyDeviceToHost, st) != cudaSuccess ||
+            cudaStreamSynchronize(st) != cudaSuccess || back != en.rkeyBe)
+          return partWay("an rkey slot could not be written");
+        if (host != nullptr) *host = en.rkeyBe;
+        nWritten++;
+      }
+    }
+  }
+  // (2) the counts: per user QP msgs = X, suppress = X - P, the responder base M; per mirror QP the base M, then msgs = X
+  // and suppress 0, or miUse 0 when the survivor's mirror count was not valid (this rank then never mirrors toward its
+  // pool; the decision is kept in imp->mirUnusable as well)
+  for (const auto& pe : imp->plan.peers) {
+    int idx[NCCL_GIN_RECOVERY_MAX_QPS];
+    const int n = gdakiRsQpsOfPeer(r, pe.rank, idx);
+    char sw[160];
+    if (n != pe.nqp || gdakiRsSuppressWrite(r, idx, n, pe.x, pe.budget, sw, sizeof(sw)) != ncclSuccess)
+      return partWay("a survivor's budgets");
+    for (int k = 0; k < n; k++) gdakiRsExecSetBase(r, idx[k], pe.m[k]);
+    const int m = gdakiMiQpOfPeer(r, pe.rank);
+    if (m < 0) continue;
+    struct ncclGinRsQp* const q = gdakiRsQpDev(r, m);
+    // integration (review, 2026-10-15): the responder base M always (the survivor's msgs on its mirror QP to this rank go
+    // on from there, also after it re-arms a QP it had given up); X and miUse as before
+    gdakiRsExecSetBase(r, m, pe.mirM);
+    if (pe.mirValid) {
+      const uint64_t v[2] = {pe.mirX, 0};
+      uint64_t back[2] = {~0ull, ~0ull};
+      if (cudaMemcpyAsync(&q->msgs, v, sizeof(v), cudaMemcpyHostToDevice, st) != cudaSuccess ||
+          cudaMemcpyAsync(back, &q->msgs, sizeof(back), cudaMemcpyDeviceToHost, st) != cudaSuccess ||
+          cudaStreamSynchronize(st) != cudaSuccess || back[0] != v[0] || back[1] != v[1])
+        return partWay("a mirror QP's count");
+    } else {
+      const uint32_t zero = 0;
+      uint32_t back = 1;
+      if (cudaMemcpyAsync(&q->miUse, &zero, sizeof(zero), cudaMemcpyHostToDevice, st) != cudaSuccess ||
+          cudaMemcpyAsync(&back, &q->miUse, sizeof(back), cudaMemcpyDeviceToHost, st) != cudaSuccess ||
+          cudaStreamSynchronize(st) != cudaSuccess || back != 0)
+        return partWay("a mirror QP's use mark");
+      imp->mirUnusable.push_back(pe.rank);
+    }
+  }
+  // (3) the queue, and step ckpt + 1's inputs now
+  for (const auto& sp : imp->plan.steps) imp->steps.push_back(sp.step);
+  imp->ckpt = ckpt;
+  imp->last = gdakiMiPaceLast(imp->steps, ckpt);
+  const size_t end = gdakiMiPaceEnd(imp->steps, 0, ckpt + 1);
+  for (size_t i = 0; i < end; i++) {
+    if (!gdakiMiApplyStep(r, imp->plan.steps[i], pw, sizeof(pw))) return partWay(pw);
+    imp->poolBytes += imp->plan.steps[i].poolBytes;
+    imp->stepsDone++;
+  }
+  imp->next = end;
+  imp->left.store(end < imp->steps.size(), std::memory_order_release);
+  GIN_TS_NOTE("GIN/MI: rank %d: import plan: checkpoint=%lu survivors=%zu entries=%lu mirror_entries=%lu mirror_bytes=%lu "
+              "signal_adds=%lu signal_sum=%lu steps=%zu first_step=%lu last_step=%lu queued=%zu rkeys_written=%d "
+              "rkeys_warned=%d pool_cells=%d mirror_unusable=%zu incarnation=%u prepare_ms=%.1f mono_ms=%.3f", me,
+              (unsigned long)ckpt, imp->plan.peers.size(), (unsigned long)imp->plan.entries,
+              (unsigned long)imp->plan.nMirror, (unsigned long)imp->plan.mirrorBytes, (unsigned long)imp->plan.sigAdds,
+              (unsigned long)sigTotal, imp->steps.size(), (unsigned long)(imp->steps.empty() ? 0 : imp->steps.front()),
+              (unsigned long)imp->last, imp->steps.size() - imp->next, nWritten, nWarned, nPool, imp->mirUnusable.size(),
+              incarnation, gdakiQ4MonoMs() - t0, gdakiQ4MonoMs());
+  r->mi.imp = imp;
+  *injectNow = !imp->left.load(std::memory_order_acquire);
+  imp = nullptr;  // kept: DelOnFail deletes nothing now
+  return ncclSuccess;
+}
+static ncclResult_t gdakiMiImportPrepare(struct gdakiRecHost* r, const struct gdakiCkptPeerP* peerP, uint32_t nPeers,
+                                         const std::vector<std::vector<uint8_t>>& exports, uint64_t ckpt,
+                                         uint32_t incarnation, const struct gdakiMiFetched& fetched, char* why,
+                                         size_t whyLen) {
+  if (!gdakiRsLogReady(r)) return gdakiRsLogNotReady(why, whyLen);
+  if (r->ts == nullptr || r->nranks <= 0 || (peerP == nullptr && nPeers != 0)) {
+    snprintf(why, whyLen, "no transparent recovery state, or no P records");
+    return ncclInvalidUsage;
+  }
+  if (r->mi.imp != nullptr) {
+    snprintf(why, whyLen, "the step-aligned import already ran on this context");
+    return ncclInvalidUsage;
+  }
+  bool injectNow = false;
+  ncclResult_t res;
+  {
+    std::lock_guard<std::mutex> wl(gdakiRsWinMu);  // the windows stay registered while their memory is written
+    std::lock_guard<std::mutex> al(r->rsLog->appMu);
+    res = gdakiMiImportPrepareLocked(r, peerP, nPeers, exports, ckpt, incarnation, fetched, &injectNow, why, whyLen);
+  }
+  if (res == ncclSuccess && injectNow) {  // step ckpt + 1 was the only one: INJECTED at the helper's start
+    gdakiMiInjectedReady(r, r->mi.imp->last);
+    gdakiMiImportDoneLine(r, r->mi.imp);
+  }
+  return res;
+}
+static ncclResult_t gdakiMiImportStep(struct gdakiRecHost* r, uint64_t step, char* why, size_t whyLen) {
+  struct gdakiMiImport* const imp = r != nullptr ? r->mi.imp : nullptr;
+  if (imp == nullptr || !imp->left.load(std::memory_order_acquire)) return ncclSuccess;  // nothing queued
+  char w[320];
+  if (imp->failed) {
+    if (why != nullptr && whyLen != 0) snprintf(why, whyLen, "an earlier step of the import failed");
+    return ncclSystemError;
+  }
+  const size_t end = gdakiMiPaceEnd(imp->steps, imp->next, step + 1);
+  if (end == imp->next) return ncclSuccess;
+  bool ok = true;
+  {
+    std::lock_guard<std::mutex> wl(gdakiRsWinMu);
+    std::lock_guard<std::mutex> al(r->rsLog->appMu);
+    struct gdakiRsDevGuard g;
+    if (!gdakiRsAppStream(r, &g)) {
+      snprintf(w, sizeof(w), "no CUDA stream on device %d", r->ctx->cuda_id);
+      ok = false;
+    }
+    for (size_t i = imp->next; ok && i < end; i++) {
+      ok = gdakiMiApplyStep(r, imp->plan.steps[i], w, sizeof(w));
+      if (!ok) break;
+      imp->poolBytes += imp->plan.steps[i].poolBytes;
+      imp->stepsDone++;
+      imp->next = i + 1;
+    }
+  }
+  if (!ok) {
+    imp->failed = true;
+    WARN("GIN/MI: rank %d: ncclGinRestoreStep(%lu): the import of the queued inputs failed (%s); the helper ends this "
+         "process's part without BYE mono_ms=%.3f", r->ctx->rank, (unsigned long)step, w, gdakiQ4MonoMs());
+    if (why != nullptr && whyLen != 0) snprintf(why, whyLen, "%s", w);
+    gdakiMiImportDoneLine(r, imp);
+    imp->endAsked.store(true, std::memory_order_release);  // gdakiMiImportHelperStep
+    return ncclSystemError;
+  }
+  if (imp->next == imp->steps.size()) {  // the last queued step is in: INJECTED (the host branch's helper sends it)
+    imp->left.store(false, std::memory_order_release);
+    gdakiMiInjectedReady(r, imp->last);
+    gdakiMiImportDoneLine(r, imp);
+  }
+  return ncclSuccess;
+}
+// ---- gin-mirror (dev): import (end) ----
+
+// ==== gin-mirror (spare): restore path (begin) ====
+// EXPERIMENT.md 9.4 (the restore path with the mirror), impl/rs_spare_api.h v2, impl/rs_store_api.h (the activation v2, the
+// FETCH), impl/rs_log_api.h v2 (the export v2), impl/rs_mirror_api.h (HOLDING's payload, the QP sets). Declared in the
+// block "gin-mirror (spare): declarations" (the REJOIN region); the pure pieces are in "gin-mirror (spare): pure". With the
+// mirror off (gdakiMiOn false) nothing here is reached but gdakiMiSpareFree (nothing to free).
+// Threads: the survivor's and the buddy's parts run on the helper thread; the spare's on its application thread inside its
+// ncclGinRestoreResume, before its helper starts; the buddy's FETCH waiter on a thread of its own (below).
+
+// The other branches' entry points this region calls are defined in their regions (the integration, 2026-10-15, removed
+// this branch's placeholders): gdakiMiOn, gdakiMiAbsorbQp, gdakiMiSegViewOf, gdakiMiPoolRekey, gdakiCkptStepPairs,
+// gdakiMiPoolInfoOf, gdakiMiSelfBase and NCCL_GIN_RESTORE_MIRROR_FETCH_MB (host); gdakiMiQpOfPeer, gdakiMiExecReadMirror
+// (dev); gdakiStoreActInfoOf and the host QP tools (store).
+
+// ---- this branch's state (struct gdakiMiState::spare; impl/rs_mirror_api.h: allocated and freed by this branch) ----
+struct gdakiMiSparePeer {
+  // survivor side, read at this rank's hold start of the peer (gdakiMiHoldStartRead)
+  bool holdRead = false;
+  int mirQp = -1;              // the mirror QP to the peer (its side table index), -1: none
+  bool mirValid = false;       // it was in use and its executed count valid at the hold start
+  uint64_t mirX = 0, mirM = 0; // its X (cumulative executed) and M (msgs) at the hold start: the export's mirX, mirM
+  struct gdakiMiHolding own;   // the payload this rank sent with HOLDING (or kept, as the peer's buddy)
+  // buddy side: the holders' payloads for the death of incarnation payInc (by sender rank)
+  bool payAny = false;
+  uint32_t payInc = 0;
+  std::vector<uint8_t> have;
+  std::vector<struct gdakiMiHolding> pay;
+  // buddy side, one activation sequence (incarnation actInc): the drain, the blob, the FETCH QP (until READY hands it on)
+  bool actAny = false;
+  uint32_t actInc = 0;
+  bool drainStarted = false, drained = false, drainFailed = false;
+  char drainWhy[192] = {0};       // a refusal is final for the sequence
+  double drainT0 = 0;
+  int drainQueries = 0, drainSenders = 0;
+  std::vector<uint8_t> drainLeft;
+  std::vector<struct gdakiMiActExt> ext;
+  bool blobOk = false;
+  struct gdakiMiActBlob blob;
+  struct gdakiMiHostQp* fetchQp = nullptr;
+  struct gdakiMiQpEndpoint fetchEp;  // its endpoint (INIT), the blob's `fetch` for every LATER retry
+};
+struct gdakiMiSpareState {
+  std::vector<struct gdakiMiSparePeer> peers;
+  // the spare process: its FETCH buffer (registered before it answers any activation), its FETCH QP, what the FETCH read
+  uint8_t* fetchBuf = nullptr;
+  uint64_t fetchCap = 0;
+  struct ibv_mr* fetchMr = nullptr;
+  struct gdakiMiHostQp* fetchQp = nullptr;
+  bool fetchOk = false;
+  char fetchWhy[160] = "the mirror FETCH did not run";
+  struct gdakiMiFetched fetched;
+  std::vector<struct gdakiCkptHdr> hdr;  // the slot's header (one element once fetched)
+  std::vector<uint8_t> blob;             // the application's blob from the slot
+  // the buddy's FETCH waiter (one at a time): it holds the activation connection after READY and destroys the FETCH QP
+  // at the spare's DONE, at a FIN or at its deadline (impl/rs_store_api.h gives that to "the data (serve) thread"; this
+  // branch has no hand-off into the checkpoint machine's serve thread: impl/notes_spare.md)
+  std::thread waiter;
+  std::atomic<bool> waiterStop{false};
+};
+static std::mutex gdakiMiSpareMu;  // the state's creation only
+static struct gdakiMiSpareState* gdakiMiSpareOf(struct gdakiRecHost* r) {
+  if (r == nullptr || r->nranks <= 0) return nullptr;
+  std::lock_guard<std::mutex> lk(gdakiMiSpareMu);
+  if (r->mi.spare == nullptr) {
+    r->mi.spare = new gdakiMiSpareState();
+    r->mi.spare->peers.resize((size_t)r->nranks);
+  }
+  return r->mi.spare;
+}
+// gdakiRsSpareForget: the communicator's teardown (after gdakiTsStop) and gdakiRecFree (after gdakiTsFree). A helper that
+// was orphaned inside a firmware command and has not exited may still use this state (the drain, the activation): it is
+// kept then, as the orphan path keeps the context, and freed by gdakiRecFree once the helper exited.
+static void gdakiMiSpareFree(struct gdakiRecHost* r) {
+  if (r == nullptr) return;
+  if (r->ts != nullptr && r->ts->life.load(std::memory_order_acquire) == GDAKI_TS_LIFE_ORPHAN &&
+      !r->ts->exited.load(std::memory_order_acquire))
+    return;
+  struct gdakiMiSpareState* s = nullptr;
+  {
+    std::lock_guard<std::mutex> lk(gdakiMiSpareMu);
+    if (r->mi.spare == nullptr) return;
+    s = r->mi.spare;
+    r->mi.spare = nullptr;
+  }
+  s->waiterStop.store(true, std::memory_order_release);
+  if (s->waiter.joinable()) s->waiter.join();
+  for (auto& p : s->peers)
+    if (p.fetchQp != nullptr) gdakiMiHostQpDestroy(p.fetchQp);
+  if (s->fetchQp != nullptr) gdakiMiHostQpDestroy(s->fetchQp);
+  if (s->fetchMr != nullptr) (void)wrap_ibv_dereg_mr(s->fetchMr);
+  if (s->fetchBuf != nullptr) (void)cudaFreeHost(s->fetchBuf);
+  delete s;
+}
+
+// ---- survivor side ----
+// The hold start of d (gdakiHoldStart, after the user set's counts; d's gates odd with count 0, every QP to d in ERR): the
+// mirror QP to d (X, M, in use) for the export v2, and HOLDING's payload for b = buddy(d): M_mir of this rank's mirror
+// path to b (the mirror QP to b, or the self loop when this rank is b) and whether it is usable, d's cell (segment,
+// cursor, breaks, valid; the device's values, EXPERIMENT.md 9.4 step 1), the closed live segments (the host branch's
+// records). False with the mirror off (nothing to add). A read that fails gives a payload of version 0, which the buddy
+// refuses (d's restore falls back there; the mirror never fails the hold itself).
+static bool gdakiMiHoldStartRead(struct gdakiRecHost* r, int d, struct gdakiMiHolding* out) {
+  memset(out, 0, sizeof(*out));
+  if (!gdakiMiOn(r) || r->ctx == nullptr) return false;
+  struct gdakiMiSpareState* s = gdakiMiSpareOf(r);
+  if (s == nullptr || d < 0 || d >= (int)s->peers.size()) return true;  // version 0
+  struct gdakiMiSparePeer& sp = s->peers[(size_t)d];
+  sp.holdRead = true;
+  sp.mirValid = false;
+  sp.mirX = sp.mirM = 0;
+  sp.mirQp = -1;
+  memset(&sp.own, 0, sizeof(sp.own));
+  const int n = r->nranks, me = r->ctx->rank, b = ncclGinMiBuddyOf(d, n);
+  struct ncclGinRsSide h;
+  std::vector<struct ncclGinRsQp> v;
+  const char* sw = "";
+  const bool side = gdakiRsReadSide(r, &h, &v, &sw) && h.miOn == 1u && (int)h.miCtx == r->mi.ctx &&
+                    h.miCellsOff != 0 && h.miNCells == (uint32_t)n;
+  // the mirror QP to d: the export's mirX and mirM (a QP not in use or with an invalidated count: mirValid 0)
+  const int qd = gdakiMiQpOfPeer(r, d);
+  if (side && qd >= 0 && qd < (int)v.size()) {
+    sp.mirQp = qd;
+    // integration (review, 2026-10-15): M (this rank's msgs on that QP) goes out whatever X's validity: the spare bases its
+    // responder count on it, so a later drain on the revived rank compares like with like even after this rank re-arms a
+    // QP it had given up
+    sp.mirM = v[(size_t)qd].msgs;
+    uint64_t cum = 0;
+    bool valid = false;
+    if (gdakiMiExecReadMirror(r, d, &cum, &valid) == ncclSuccess && valid && v[(size_t)qd].miUse == 1u) {
+      sp.mirValid = true;
+      sp.mirX = cum;
+      sp.mirM = v[(size_t)qd].msgs;
+    }
+  }
+  if (!side || b < 0) {
+    GIN_TS_NOTE("GIN/MI: rank %d: hold of rank %d: the side table's mirror fields could not be read (%s): HOLDING carries "
+                "an unusable mirror payload mono_ms=%.3f", me, d, side ? "no buddy" : sw, gdakiQ4MonoMs());
+    sp.own = *out;
+    return true;  // version 0
+  }
+  // M_mir and the path to b
+  uint64_t mMir = 0;
+  bool pathOk = false;
+  const int qb = (int)ncclGinMiQpIdx((uint32_t)r->mi.ctx, (uint32_t)n, (uint32_t)b);  // b == me: the self loop's requester
+  if (qb < (int)v.size()) {
+    mMir = v[(size_t)qb].msgs;
+    pathOk = v[(size_t)qb].miUse == 1u;
+    if (pathOk && b != me) {
+      uint64_t cum = 0;
+      bool valid = false;
+      pathOk = gdakiMiExecReadMirror(r, b, &cum, &valid) == ncclSuccess && valid;
+    }
+  }
+  // d's cell over the NIC copy path
+  struct ncclGinMiCell cell;
+  memset(&cell, 0, sizeof(cell));
+  const char* cellAt = (const char*)r->rsBase + h.miCellsOff + (uint64_t)d * sizeof(struct ncclGinMiCell);
+  const bool cellOk = gdakiLbXfer(r, false, cellAt, sizeof(cell)) == ncclSuccess;
+  if (cellOk) memcpy(&cell, r->pinned, sizeof(cell));
+  struct gdakiMiSegView view;
+  const bool haveView = gdakiMiSegViewOf(r, d, &view);
+  const int nClosed = haveView ? (int)std::min({view.segs.size(), view.fills.size(), view.closedAt.size(),
+                                                 view.broken.size()}) : 0;
+  bool ok = cellOk;
+  // the open segment's breaks count from the host's record of its opening; a cell whose segment the host did not record
+  // (no view, or another number) cannot be judged: unusable
+  if (ok && cell.seg != 0 && (!haveView || view.openSeg != cell.seg)) ok = false;
+  if (ok)
+    ok = gdakiMiHoldingOf(view.segs.data(), view.fills.data(), view.closedAt.data(), view.broken.data(), nClosed, cell.seg,
+                          cell.cursor, cell.broken, haveView ? view.openBroken : 0, cell.laneBytes, pathOk,
+                          cell.valid == 1u, mMir, out);
+  if (!ok) memset(out, 0, sizeof(*out));  // version 0
+  sp.own = *out;
+  GIN_TS_NOTE("GIN/MI: rank %d: hold of rank %d: mirror to buddy rank %d msgs=%lu path_ok=%u cell_valid=%u segments=%u "
+              "mirror_qp_x=%lu mirror_qp_m=%lu mirror_qp_valid=%d payload=%s mono_ms=%.3f", me, d, b,
+              (unsigned long)out->mirMsgs, out->pathOk, out->cellValid, out->nSeg, (unsigned long)sp.mirX,
+              (unsigned long)sp.mirM, sp.mirValid ? 1 : 0, out->version == GDAKI_MI_WIRE_VERSION ? "ok" : "unusable",
+              gdakiQ4MonoMs());
+  return true;
+}
+// The restore round of d (gdakiHoldCommitRound, after the user set's X check): the mirror QP to d ran nothing since the
+// hold start either. A moved or unreadable count breaks the lanes that QP serves (the host branch's absorption: d's wards'
+// cells invalid, their DISARM), never a fallback of d (impl/rs_mirror_api.h's invariant).
+static void gdakiMiCommitCheck(struct gdakiRecHost* r, int d) {
+  if (!gdakiMiOn(r)) return;
+  struct gdakiMiSpareState* s = gdakiMiSpareOf(r);
+  if (s == nullptr || d < 0 || d >= (int)s->peers.size()) return;
+  const struct gdakiMiSparePeer& sp = s->peers[(size_t)d];
+  if (!sp.holdRead || sp.mirQp < 0 || !sp.mirValid) return;  // nothing was promised to the spare (mirValid 0)
+  uint64_t cum = 0;
+  bool valid = false;
+  const bool read = gdakiMiExecReadMirror(r, d, &cum, &valid) == ncclSuccess;
+  if (read && valid && cum == sp.mirX) return;
+  char w[160];
+  if (!read || !valid) snprintf(w, sizeof(w), "the mirror QP's executed count could not be read before the Commit");
+  else snprintf(w, sizeof(w), "the mirror QP executed %lu messages since the hold start (%lu then)", (unsigned long)cum,
+                (unsigned long)sp.mirX);
+  WARN("GIN/MI: rank %d: restore round with rank %d: %s; the lanes it serves are broken mono_ms=%.3f", r->ctx->rank, d, w,
+       gdakiQ4MonoMs());
+  // the spare's msgs base is the X sent in the export: from here this rank's count of that QP is not one a later drain may
+  // trust (a drain naming d as a sender refuses), and the lanes it serves are broken
+  gdakiRsExecInvalidate(r, sp.mirQp);
+  (void)gdakiMiAbsorbQp(r, sp.mirQp, w);
+}
+
+// ---- buddy side: the holders' payloads (HOLDING), the drain, the fence, the blob, the activation v2 ----
+static void gdakiMiHoldingKeep(struct gdakiRecHost* r, int d, int from, uint32_t inc, const struct gdakiMiHolding& pl) {
+  struct gdakiMiSpareState* s = gdakiMiSpareOf(r);
+  if (s == nullptr || d < 0 || d >= (int)s->peers.size() || from < 0 || from >= (int)s->peers.size()) return;
+  struct gdakiMiSparePeer& sp = s->peers[(size_t)d];
+  if (sp.payAny && inc < sp.payInc) return;  // stale (as gdakiHoldHoldersAdd)
+  if (!sp.payAny || inc > sp.payInc) {
+    sp.payAny = true;
+    sp.payInc = inc;
+    sp.have.assign(s->peers.size(), 0);
+    sp.pay.assign(s->peers.size(), gdakiMiHolding());
+  }
+  sp.have[(size_t)from] = 1;
+  sp.pay[(size_t)from] = pl;
+}
+// A HOLDING record from holder `from` about d (gdakiHoldOnMsg, the buddy's branch): its payload, or an unusable one
+// (version 0) when the flag is missing.
+static void gdakiMiHoldingTake(struct gdakiRecHost* r, int d, int from, const struct gdakiTsMsg& m) {
+  if (!gdakiMiOn(r)) return;
+  struct gdakiMiHolding pl;
+  memset(&pl, 0, sizeof(pl));
+  if ((m.pad & GDAKI_HOLD_F_MIRROR) != 0) memcpy(&pl, m.executed, sizeof(pl));
+  gdakiMiHoldingKeep(r, d, from, (uint32_t)m.round, pl);
+}
+// A new activation sequence of d (its incarnation inc): the drain, the extents, the blob and the FETCH QP start again.
+static struct gdakiMiSparePeer* gdakiMiActSeq(struct gdakiRecHost* r, int d, uint32_t inc) {
+  struct gdakiMiSpareState* s = gdakiMiSpareOf(r);
+  if (s == nullptr || d < 0 || d >= (int)s->peers.size()) return nullptr;
+  struct gdakiMiSparePeer& sp = s->peers[(size_t)d];
+  if (!sp.actAny || sp.actInc != inc) {
+    sp.actAny = true;
+    sp.actInc = inc;
+    sp.drainStarted = sp.drained = sp.drainFailed = sp.blobOk = false;
+    sp.drainWhy[0] = '\0';
+    sp.drainQueries = sp.drainSenders = 0;
+    sp.drainLeft.clear();
+    sp.ext.clear();
+    sp.blob = gdakiMiActBlob();
+    if (sp.fetchQp != nullptr) gdakiMiHostQpDestroy(sp.fetchQp);  // an earlier hold's, never handed on
+    sp.fetchQp = nullptr;
+  }
+  return &sp;
+}
+// The activation of d ends without a FETCH (a fallback before ACCEPTED, or after a failed FETCH handshake): the buddy's
+// FETCH QP of that sequence goes now (a LATER retry keeps it).
+static void gdakiMiActEnd(struct gdakiRecHost* r, int d) {
+  struct gdakiMiSpareState* s = r != nullptr ? r->mi.spare : nullptr;
+  if (s == nullptr || d < 0 || d >= (int)s->peers.size()) return;
+  struct gdakiMiSparePeer& sp = s->peers[(size_t)d];
+  if (sp.fetchQp != nullptr) gdakiMiHostQpDestroy(sp.fetchQp);
+  sp.fetchQp = nullptr;
+  sp.blobOk = false;  // the blob named that QP
+}
+// The self loop's responder (impl/notes_spare.md: the host branch's mirror context is one more context of the GDAKI
+// context, so its self-loop pair is hk's: requester QP miCtx x nranks + rank, responder gqps[nContexts x nranks + miCtx]).
+static struct doca_gpu_verbs_qp_hl* gdakiMiSelfResponder(struct gdakiRecHost* r) {
+  struct gdaki_context* g = r->ctx;
+  if (g == nullptr || g->gqps == nullptr || r->mi.ctx < 0 || r->mi.ctx >= g->nContexts) return nullptr;
+  return g->gqps[(size_t)g->nContexts * (size_t)r->nranks + (size_t)r->mi.ctx];
+}
+// One step of the drain of d's lanes for the restore from checkpoint k (EXPERIMENT.md 9.4 step 2), the buddy's helper,
+// after every survivor holds d: every sender's payload is there and usable; each sender with bytes after k has its mirror
+// WRITEs executed here (QUERY_QP, outside the firmware guard: gdakiMiExecReadMirror's count reaches its M_mir; this rank's
+// own lane over the self loop: gdakiMiSelfDrained from the loop's connect base); then one 8-byte READ of the pool through
+// the GIN-PD loopback pair (the fence: the posted writes before it have landed). 1 not yet (the next helper step goes on;
+// a QUERY_QP that failed is asked again within the bounds), 0 drained and fenced (once per activation sequence; the line
+// "drain for rank d"), -1 refused (why; the caller falls back; final for the sequence): a payload missing or not usable,
+// an invalidated count, the bound NCCL_GIN_RESTORE_DRAIN_MS or NCCL_GIN_RESTORE_DRAIN_QUERIES passed, the fence, the pool's
+// geometry or the self loop missing.
+static int gdakiMiDrainStep(struct gdakiRecHost* r, int d, uint32_t inc, uint64_t k, char* why, size_t whyLen) {
+  struct gdakiMiSparePeer* sp = gdakiMiActSeq(r, d, inc);
+  if (sp == nullptr) {
+    snprintf(why, whyLen, "no mirror state for rank %d", d);
+    return -1;
+  }
+  if (sp->drained) return 0;
+  auto refuse = [&]() {
+    sp->drainFailed = true;
+    snprintf(sp->drainWhy, sizeof(sp->drainWhy), "%.190s", why);
+    return -1;
+  };
+  if (sp->drainFailed) {
+    snprintf(why, whyLen, "%s", sp->drainWhy);
+    return -1;
+  }
+  const int n = r->nranks, me = r->ctx->rank;
+  uint32_t poolRkey = 0, slots = 0;
+  uint64_t laneBytes = 0;
+  const bool pool = gdakiMiPoolInfoOf(r, &poolRkey, &laneBytes, &slots) && poolRkey != 0;
+  if (!sp->drainStarted) {
+    sp->drainStarted = true;
+    sp->drainT0 = gdakiQ4MonoMs();
+    if (!sp->payAny || sp->payInc != inc) {
+      snprintf(why, whyLen, "no HOLDING mirror payload of rank %d's death of incarnation %u arrived here", d, inc);
+      return refuse();
+    }
+    if (!pool) {
+      snprintf(why, whyLen, "this rank's mirror pool is not known (rkey, lane bytes, slots)");
+      return refuse();
+    }
+    int bad = -1, verdict = 0;
+    const int rc = gdakiMiExtentsOf(sp->pay.data(), sp->have.data(), n, d, k, ncclGinMiWardIdx(d, n), slots, laneBytes,
+                                    &sp->ext, &sp->drainLeft, &bad, &verdict);
+    if (rc != 0) {
+      if (rc == 1) snprintf(why, whyLen, "rank %d's HOLDING carried no mirror payload", bad);
+      else if (rc == 2) snprintf(why, whyLen, "rank %d's mirror lane for rank %d is not usable after checkpoint %lu (verdict %d)",
+                                 bad, d, (unsigned long)k, verdict);
+      else if (rc == 3) snprintf(why, whyLen, "more than %u live mirror extents after checkpoint %lu", GDAKI_MI_ACT_MAX_EXT,
+                                 (unsigned long)k);
+      else snprintf(why, whyLen, "the mirror pool's geometry is not usable for rank %d", d);
+      return refuse();
+    }
+    sp->drainSenders = 0;
+    for (uint8_t x : sp->drainLeft) sp->drainSenders += x ? 1 : 0;
+  }
+  if ((int)sp->drainLeft.size() != n || (int)sp->pay.size() != n) {
+    snprintf(why, whyLen, "the drain of rank %d has no sender table", d);
+    return refuse();
+  }
+  const int64_t budget = std::max<int64_t>(1, ncclParamGinRestoreDrainQueries());
+  bool left = false;
+  for (int s = 0; s < n; s++) {
+    if (!sp->drainLeft[(size_t)s]) continue;
+    if (sp->drainQueries >= budget) {
+      left = true;
+      break;
+    }
+    sp->drainQueries++;
+    if (s == me) {  // this rank's own lane: the self loop (outside the rec set)
+      struct doca_gpu_verbs_qp_hl* q = gdakiMiSelfResponder(r);
+      uint32_t rmsn = 0, st = 0, base = 0;
+      bool qok = false;
+      if (q != nullptr) {
+        std::lock_guard<std::mutex> op(r->opMu);  // QUERY_QP never overlaps a QP state change (as gdakiRsExecRead)
+        qok = doca_verbs_qp_query_seq(q->qp, &rmsn, nullptr, nullptr, &st) == DOCA_SUCCESS;
+      }
+      if (q == nullptr || !gdakiMiSelfBase(r, &base)) {
+        snprintf(why, whyLen, "this rank's self loop (or its connect base) for rank %d is not known", d);
+        return refuse();
+      }
+      if (qok && st != 0x3u /* PRM RTS */) {
+        snprintf(why, whyLen, "this rank's self loop for rank %d is not RTS (state %u)", d, st);
+        return refuse();
+      }
+      if (qok && gdakiMiSelfDrained(sp->pay[(size_t)s].mirMsgs, rmsn, base)) sp->drainLeft[(size_t)s] = 0;
+      else left = true;  // not yet, or a QUERY_QP that failed: asked again within the bounds
+      continue;
+    }
+    uint64_t cum = 0;
+    bool valid = true;
+    const ncclResult_t er = gdakiMiExecReadMirror(r, s, &cum, &valid);
+    if (er == ncclSuccess && !valid) {
+      snprintf(why, whyLen, "the mirror QP to rank %d has an invalidated executed count", s);
+      return refuse();
+    }
+    if (er == ncclSuccess && gdakiMiDrainOf(valid, cum, sp->pay[(size_t)s].mirMsgs) == 0) sp->drainLeft[(size_t)s] = 0;
+    else left = true;  // not yet, or a QUERY_QP that failed: asked again within the bounds
+  }
+  const double el = gdakiQ4MonoMs() - sp->drainT0;
+  if (left) {
+    if (el > (double)ncclParamGinRestoreDrainMs() || sp->drainQueries >= budget) {
+      snprintf(why, whyLen, "the mirror lanes for rank %d did not drain within NCCL_GIN_RESTORE_DRAIN_MS or "
+               "NCCL_GIN_RESTORE_DRAIN_QUERIES (%d queries)", d, sp->drainQueries);
+      return refuse();
+    }
+    return 1;
+  }
+  if (!sp->ext.empty()) {  // the fence: an 8-byte READ of the ward's first pool word through the loopback pair
+    const uint64_t off = ncclGinMiLaneOff(ncclGinMiWardIdx(d, n), 0, 0, n, slots, laneBytes);
+    uint64_t val = 0;
+    char fw[160];
+    if (gdakiRsAtomicOp(r, true, off, poolRkey, 0, &val, fw, sizeof(fw)) != ncclSuccess) {
+      snprintf(why, whyLen, "the drain's fence READ failed: %.120s", fw);
+      return refuse();
+    }
+  }
+  sp->drained = true;
+  const double t = gdakiQ4MonoMs();
+  WARN("GIN/MI: rank %d: drain for rank %d: senders=%d queries=%d drain_us=%.0f mono_ms=%.3f", me, d, sp->drainSenders,
+       sp->drainQueries, (t - sp->drainT0) * 1000.0, t);
+  return 0;
+}
+// The blob of d's activation (once per activation sequence, after the drain): the address and incarnation table, the
+// store slot (the store branch's), the pool and the extents (the drain's), the buddy's FETCH QP (created now, kept for the
+// LATER answers' retries). Null with why: no stable slot here, a slot of another checkpoint than the activation's, the
+// FETCH QP not created.
+static const struct gdakiMiActBlob* gdakiMiActBlobFor(struct gdakiRecHost* r, int d, uint32_t inc,
+                                                      const struct gdakiRsActivate& a, char* why, size_t whyLen) {
+  struct gdakiMiSparePeer* sp = gdakiMiActSeq(r, d, inc);
+  if (sp == nullptr || !sp->drained) {
+    snprintf(why, whyLen, "the activation blob of rank %d was asked before its drain", d);
+    return nullptr;
+  }
+  if (sp->blobOk) return &sp->blob;
+  struct gdakiStoreActInfo st;
+  if (!gdakiStoreActInfoOf(r, d, &st)) {
+    snprintf(why, whyLen, "no stable checkpoint of rank %d in this rank's store", d);
+    return nullptr;
+  }
+  if (st.ckpt != a.step) {
+    snprintf(why, whyLen, "the store's stable checkpoint of rank %d is %lu, the activation's %lu", d, (unsigned long)st.ckpt,
+             (unsigned long)a.step);
+    return nullptr;
+  }
+  uint32_t poolRkey = 0, slots = 0;
+  uint64_t laneBytes = 0;
+  const bool pool = gdakiMiPoolInfoOf(r, &poolRkey, &laneBytes, &slots) && poolRkey != 0;
+  if (sp->fetchQp == nullptr) {
+    memset(&sp->fetchEp, 0, sizeof(sp->fetchEp));
+    if (gdakiMiHostQpCreate(r, 16, &sp->fetchQp, &sp->fetchEp, why, whyLen) != ncclSuccess) {
+      sp->fetchQp = nullptr;
+      return nullptr;
+    }
+  }
+  struct gdakiTs* ts = r->ts;
+  const int n = r->nranks, me = r->ctx->rank;
+  struct gdakiMiActBlob& b = sp->blob;
+  memset(&b.hdr, 0, sizeof(b.hdr));
+  b.hdr.magic = GDAKI_MI_ACTB_MAGIC;
+  b.hdr.version = GDAKI_MI_WIRE_VERSION;
+  b.hdr.rank = d;
+  b.hdr.incarnation = a.incarnation;
+  b.hdr.nonce = a.nonce;
+  b.hdr.ckpt = a.step;
+  b.hdr.nranks = b.hdr.nAddr = (uint32_t)n;
+  b.hdr.nExt = (uint32_t)sp->ext.size();
+  b.hdr.flags = GDAKI_MI_ACTB_F_STORE | (pool ? GDAKI_MI_ACTB_F_POOL : 0u);
+  b.hdr.storeRkey = st.rkey;
+  b.hdr.storeSlot = st.slot;
+  b.hdr.storeOff = st.off;
+  b.hdr.usedBytes = st.usedBytes;
+  b.hdr.imageBytes = st.imageBytes;
+  b.hdr.layoutHash = st.layoutHash;
+  b.hdr.blobBytes = st.blobBytes;
+  b.hdr.poolRkey = poolRkey;
+  b.hdr.laneBytes = laneBytes;
+  b.hdr.slots = slots;
+  b.hdr.wardIdx = ncclGinMiWardIdx(d, n);
+  b.hdr.fetch = sp->fetchEp;
+  b.addr.assign((size_t)n, gdakiMiActAddr());
+  for (int q = 0; q < n; q++) {
+    struct gdakiMiActAddr& e = b.addr[(size_t)q];
+    memset(&e, 0, sizeof(e));
+    if (q == d) {
+      e.rank = -1;
+      continue;
+    }
+    e.rank = q;
+    if (q == me) {
+      e.incarnation = gdakiRsSelfInc(r);
+      memcpy(e.listenAddr, &ts->listenAddr, std::min(sizeof(e.listenAddr), sizeof(union ncclSocketAddress)));
+    } else {
+      e.incarnation = gdakiRsPeerInc(r, q);
+      memcpy(e.listenAddr, &ts->peers[(size_t)q].addr, std::min(sizeof(e.listenAddr), sizeof(union ncclSocketAddress)));
+    }
+  }
+  b.ext = sp->ext;
+  sp->blobOk = true;
+  return &b;
+}
+// The buddy's FETCH waiter: reads the spare's DONE (or a FIN) on the activation connection until its deadline, then
+// destroys the buddy's FETCH QP and closes the connection.
+static void gdakiMiFetchWait(struct gdakiMiSpareState* s, int rank, int d, int fd, struct gdakiMiHostQp* qp,
+                             double deadlineMs) {
+  struct gdakiMiActDone done;
+  memset(&done, 0, sizeof(done));
+  size_t have = 0;
+  const char* how = "its deadline passed";
+  while (have < sizeof(done)) {
+    if (s->waiterStop.load(std::memory_order_acquire)) { how = "the context ends"; break; }
+    if (gdakiQ4MonoMs() >= deadlineMs) break;
+    const ssize_t k = recv(fd, (char*)&done + have, sizeof(done) - have, MSG_DONTWAIT);
+    if (k > 0) { have += (size_t)k; continue; }
+    if (k == 0) { how = "the spare closed the connection"; break; }
+    if (errno != EAGAIN && errno != EWOULDBLOCK && errno != EINTR) { how = "the connection failed"; break; }
+    struct pollfd pf = {fd, POLLIN, 0};
+    (void)poll(&pf, 1, 5);
+  }
+  if (have == sizeof(done) && done.magic == GDAKI_MI_ACTB_MAGIC) {
+    done.why[sizeof(done.why) - 1] = '\0';
+    GIN_TS_NOTE("GIN/MI: rank %d: rank %d's spare ended its FETCH: ok=%u bytes=%lu%s%s mono_ms=%.3f", rank, d, done.ok,
+                (unsigned long)done.bytes, done.ok ? "" : " why=", done.ok ? "" : done.why, gdakiQ4MonoMs());
+  } else {
+    GIN_TS_NOTE("GIN/MI: rank %d: rank %d's spare sent no FETCH DONE (%s); the FETCH QP is destroyed mono_ms=%.3f", rank, d,
+                how, gdakiQ4MonoMs());
+  }
+  gdakiMiHostQpDestroy(qp);
+  close(fd);
+}
+// The activation v2 (impl/rs_store_api.h): the record (version GDAKI_RS_ACT_VERSION_MI) and the blob on one connection to
+// the spare's activation port; its answer; after ACCEPTED its FETCH endpoint (1000 ms), this rank's FETCH QP to RTS, READY,
+// and the connection with the QP handed to the FETCH waiter. Returns the answer kind, -1 (no answer), or
+// GDAKI_MI_ACT_FETCH_FAILED (ACCEPTED, then the FETCH handshake failed: the spare gives up; the caller falls back).
+static int gdakiMiSendActivate(struct gdakiRecHost* r, int peer, const void* spareAddr, const struct gdakiRsActivate* a,
+                               const struct gdakiMiActBlob& blob, int timeoutMs) {
+  struct gdakiMiSpareState* s = gdakiMiSpareOf(r);
+  struct gdakiMiSparePeer* sp = gdakiMiActSeq(r, peer, a->incarnation - 1u);
+  if (s == nullptr || sp == nullptr || sp->fetchQp == nullptr) return GDAKI_MI_ACT_FETCH_FAILED;
+  std::vector<uint8_t> bytes;
+  if (!gdakiMiActBlobEncode(blob.hdr, blob.addr, blob.ext, &bytes)) return GDAKI_MI_ACT_FETCH_FAILED;
+  const union ncclSocketAddress* sa = (const union ncclSocketAddress*)spareAddr;
+  const socklen_t alen = sa->sa.sa_family == AF_INET6 ? sizeof(sa->sin6) : sizeof(sa->sin);
+  const int fd = socket(sa->sa.sa_family, SOCK_STREAM, 0);
+  if (fd < 0) return -1;
+  gdakiTsSockOpts(fd);
+  const double deadline = gdakiQ4MonoMs() + timeoutMs;
+  int rc = connect(fd, &sa->sa, alen);
+  if (rc != 0 && errno == EINPROGRESS) {
+    struct pollfd pf = {fd, POLLOUT, 0};
+    int err = 0;
+    socklen_t el = sizeof(err);
+    if (poll(&pf, 1, std::max(1, (int)(deadline - gdakiQ4MonoMs()))) != 1 ||
+        getsockopt(fd, SOL_SOCKET, SO_ERROR, &err, &el) != 0 || err != 0) { close(fd); return -1; }
+  } else if (rc != 0) { close(fd); return -1; }
+  struct gdakiRsActivate rec = *a;
+  struct gdakiRsActivate ans;
+  if (!gdakiRsIoAll(fd, &rec, sizeof(rec), true, deadline) || !gdakiRsIoAll(fd, bytes.data(), bytes.size(), true, deadline) ||
+      !gdakiRsIoAll(fd, &ans, sizeof(ans), false, deadline) || ans.magic != GDAKI_RS_ACT_MAGIC) {
+    close(fd);
+    return -1;
+  }
+  if (ans.kind != GDAKI_RS_ACT_ACCEPTED) {
+    close(fd);
+    return (int)ans.kind;
+  }
+  const int me = r->ctx->rank;
+  struct gdakiMiActAnswer an;
+  memset(&an, 0, sizeof(an));
+  struct gdakiMiActReady rd;
+  memset(&rd, 0, sizeof(rd));
+  rd.magic = GDAKI_MI_ACTB_MAGIC;
+  char w[160] = {0};
+  if (!gdakiRsIoAll(fd, &an, sizeof(an), false, gdakiQ4MonoMs() + 1000.0) || an.magic != GDAKI_MI_ACTB_MAGIC || an.ok != 1) {
+    if (an.magic == GDAKI_MI_ACTB_MAGIC) an.why[sizeof(an.why) - 1] = '\0';
+    snprintf(w, sizeof(w), "no FETCH endpoint from the spare%s%.100s", an.magic == GDAKI_MI_ACTB_MAGIC ? ": " : "",
+             an.magic == GDAKI_MI_ACTB_MAGIC ? an.why : "");
+  } else if (gdakiMiHostQpConnect(sp->fetchQp, an.fetch, w, sizeof(w)) != ncclSuccess) {
+    // w says why
+  } else {
+    rd.kind = GDAKI_MI_ACT_READY;
+  }
+  if (rd.kind != GDAKI_MI_ACT_READY) {
+    rd.kind = GDAKI_MI_ACT_FAIL;
+    snprintf(rd.why, sizeof(rd.why), "%.63s", w);
+    (void)gdakiRsIoAll(fd, &rd, sizeof(rd), true, gdakiQ4MonoMs() + 500.0);
+    close(fd);
+    WARN("GIN/MI: rank %d: rank %d's spare accepted its activation but the FETCH handshake failed (%s) mono_ms=%.3f", me,
+         peer, w, gdakiQ4MonoMs());
+    return GDAKI_MI_ACT_FETCH_FAILED;
+  }
+  if (!gdakiRsIoAll(fd, &rd, sizeof(rd), true, gdakiQ4MonoMs() + 500.0)) {
+    close(fd);
+    WARN("GIN/MI: rank %d: READY could not be sent to rank %d's spare mono_ms=%.3f", me, peer, gdakiQ4MonoMs());
+    return GDAKI_MI_ACT_FETCH_FAILED;
+  }
+  // the connection and the QP to the waiter; the last waiter (an earlier activation) ends first
+  if (s->waiter.joinable()) {
+    s->waiterStop.store(true, std::memory_order_release);
+    s->waiter.join();
+  }
+  s->waiterStop.store(false, std::memory_order_release);
+  struct gdakiMiHostQp* qp = sp->fetchQp;
+  sp->fetchQp = nullptr;
+  const double wDeadline = gdakiQ4MonoMs() + (double)std::max(1000, gdakiHoldLeftMs(r, peer));
+  s->waiter = std::thread(gdakiMiFetchWait, s, me, peer, fd, qp, wDeadline);
+  GIN_TS_NOTE("GIN/MI: rank %d: rank %d's spare is READY to FETCH checkpoint %lu: slot_bytes=%lu extents=%u mono_ms=%.3f",
+              me, peer, (unsigned long)a->step, (unsigned long)blob.hdr.usedBytes, blob.hdr.nExt, gdakiQ4MonoMs());
+  return GDAKI_RS_ACT_ACCEPTED;
+}
+
+// ---- the spare process ----
+// Its FETCH buffer (impl/rs_store_api.h; NCCL_GIN_RESTORE_MIRROR_FETCH_MB): pinned host memory registered in the GIN PD,
+// made at the driver's start, before the activation socket opens (impl/notes_spare.md: no hook of this branch inside the
+// init replay; this is before any activation, so the pinning is not in the restore time). A failure leaves the capacity
+// at 0: every activation v2 is then refused (gdakiMiActCheck 7).
+static void gdakiMiFetchBufSetup(struct gdakiRecHost* r) {
+  struct gdakiMiSpareState* s = gdakiMiSpareOf(r);
+  if (s == nullptr || s->fetchMr != nullptr) return;
+  const int me = r->ctx->rank;
+  const int64_t mb = ncclParamGinRestoreMirrorFetchMb();
+  struct ibv_pd* pd = r->ctx->collComm ? r->ctx->collComm->ib.pd : nullptr;
+  const double t0 = gdakiQ4MonoMs();
+  if (mb <= 0 || mb > (1LL << 20) || pd == nullptr) {
+    WARN("GIN/MI: rank %d: no FETCH buffer (NCCL_GIN_RESTORE_MIRROR_FETCH_MB %lld, %s): every activation is refused",
+         me, (long long)mb, pd ? "out of range" : "no GIN protection domain");
+    return;
+  }
+  const uint64_t bytes = (uint64_t)mb << 20;
+  int prevDev = -1;
+  if (cudaGetDevice(&prevDev) != cudaSuccess) prevDev = -1;
+  if (prevDev != r->ctx->cuda_id) (void)cudaSetDevice(r->ctx->cuda_id);
+  void* p = nullptr;
+  const bool alloc = cudaHostAlloc(&p, (size_t)bytes, cudaHostAllocPortable) == cudaSuccess;
+  if (prevDev >= 0 && prevDev != r->ctx->cuda_id) (void)cudaSetDevice(prevDev);
+  if (!alloc) {
+    WARN("GIN/MI: rank %d: the %lu-byte FETCH buffer could not be allocated: every activation is refused", me,
+         (unsigned long)bytes);
+    return;
+  }
+  struct ibv_mr* mr = wrap_direct_ibv_reg_mr(pd, p, (size_t)bytes, IBV_ACCESS_LOCAL_WRITE);
+  if (mr == nullptr) {
+    (void)cudaFreeHost(p);
+    WARN("GIN/MI: rank %d: the %lu-byte FETCH buffer could not be registered: every activation is refused", me,
+         (unsigned long)bytes);
+    return;
+  }
+  s->fetchBuf = (uint8_t*)p;
+  s->fetchCap = bytes;
+  s->fetchMr = mr;
+  GIN_TS_NOTE("GIN/MI: rank %d: FETCH buffer of %lu MiB registered in %.1f ms mono_ms=%.3f", me,
+              (unsigned long)(bytes >> 20), gdakiQ4MonoMs() - t0, gdakiQ4MonoMs());
+}
+// The blob of an activation on the spare (read right after the record, within its 500 ms): 0 usable, else the REFUSED
+// reason code with why (final: the buddy falls back). Version 2 needs the mirror on here and the reverse; then
+// gdakiMiActCheck (the store slot, the extents, the FETCH buffer's size) and the address table (every gated survivor's
+// entry is its own, a restored survivor has an address, this rank's own entry is empty).
+static int gdakiMiActRecv(struct gdakiRecHost* r, int fd, const struct gdakiRsActivate& act, double deadlineMs,
+                          struct gdakiMiActBlob* blob, char* why, size_t whyLen) {
+  struct gdakiTs* ts = r->ts;
+  const int me = r->ctx->rank, n = r->nranks;
+  if (!gdakiMiOn(r)) {
+    snprintf(why, whyLen, "an activation with a blob (version %u) at a spare without the mirror", act.version);
+    return 8;
+  }
+  if (act.version != GDAKI_RS_ACT_VERSION_MI) {
+    snprintf(why, whyLen, "an activation without a blob (version %u) at a spare with the mirror", act.version);
+    return 9;
+  }
+  struct gdakiMiSpareState* s = gdakiMiSpareOf(r);
+  if (s == nullptr) {
+    snprintf(why, whyLen, "no mirror state");
+    return 10;
+  }
+  // the header, its counts checked before the rest is read, then the whole blob through the unit-tested decoder
+  struct gdakiMiActHdr hh;
+  if (!gdakiRsIoAll(fd, &hh, sizeof(hh), false, deadlineMs)) {
+    snprintf(why, whyLen, "the activation blob's header did not arrive");
+    return 3;
+  }
+  int code = gdakiMiActHdrSane(hh, n);
+  if (code != 0) {
+    snprintf(why, whyLen, "the activation blob's header is malformed (%d)", code);
+    return code;
+  }
+  std::vector<uint8_t> bytes((size_t)(sizeof(hh) + gdakiMiActRestBytes(hh)));
+  memcpy(bytes.data(), &hh, sizeof(hh));
+  if (bytes.size() > sizeof(hh) &&
+      !gdakiRsIoAll(fd, bytes.data() + sizeof(hh), bytes.size() - sizeof(hh), false, deadlineMs)) {
+    snprintf(why, whyLen, "the activation blob is cut or late");
+    return 3;
+  }
+  code = gdakiMiActBlobDecode(bytes.data(), bytes.size(), n, &blob->hdr, &blob->addr, &blob->ext);
+  if (code == 0) code = gdakiMiActFits(blob->hdr, s->fetchCap);
+  if (code == 0)
+    code = gdakiMiActCheck(blob->hdr, blob->ext.data(), blob->hdr.nExt, me, act.incarnation, ts->nonce, act.step,
+                           s->fetchCap);
+  if (code != 0) {
+    snprintf(why, whyLen, "the activation blob does not hold (gdakiMiActCheck %d; FETCH buffer %lu bytes)", code,
+             (unsigned long)s->fetchCap);
+    return code;
+  }
+  if (!gdakiMiAddrSelfOk(blob->addr[(size_t)me])) {
+    snprintf(why, whyLen, "the address table's entry of the restored rank is not empty");
+    return 11;
+  }
+  for (int q = 0; q < n; q++) {
+    if (q == me || !ts->peers[(size_t)q].gated) continue;
+    if (gdakiMiAddrRule(q, blob->addr[(size_t)q], (const uint8_t*)&ts->peers[(size_t)q].addr,
+                        sizeof(union ncclSocketAddress)) == GDAKI_MI_ADDR_BAD) {
+      snprintf(why, whyLen, "the address table's entry of rank %d is not usable", q);
+      return 11;
+    }
+  }
+  snprintf(why, whyLen, "activation blob: %u extents, slot %lu bytes", blob->hdr.nExt, (unsigned long)blob->hdr.usedBytes);
+  return 0;
+}
+// A refused activation whose blob was not read to its end: the answer is out; half-close, read what the buddy still sends
+// (until its FIN or the record's deadline), then close, so the unread bytes do not turn the close into a reset that could
+// discard the answer (the buddy would read "no answer" instead of REFUSED).
+static void gdakiMiCloseAfterAnswer(int fd, double deadlineMs) {
+  (void)shutdown(fd, SHUT_WR);
+  char sink[4096];
+  while (gdakiQ4MonoMs() < deadlineMs) {
+    const ssize_t k = recv(fd, sink, sizeof(sink), MSG_DONTWAIT);
+    if (k > 0) continue;
+    if (k == 0 || (errno != EAGAIN && errno != EWOULDBLOCK && errno != EINTR)) break;
+    struct pollfd pf = {fd, POLLIN, 0};
+    (void)poll(&pf, 1, std::max(1, std::min(5, (int)(deadlineMs - gdakiQ4MonoMs()))));
+  }
+  close(fd);
+}
+// After ACCEPTED, on the activation connection: this spare's FETCH QP (INIT) and its endpoint, the buddy's READY (the
+// handshake bound), then the FETCH (gdakiMiSpareFetch). *as follows gdakiMiActStep.
+static ncclResult_t gdakiMiSpareActivateFetch(struct gdakiRecHost* r, int fd, const struct gdakiMiActBlob& blob, int* as,
+                                              char* why, size_t whyLen) {
+  struct gdakiMiSpareState* s = gdakiMiSpareOf(r);
+  if (s == nullptr) {
+    snprintf(why, whyLen, "no mirror state");
+    return ncclInternalError;
+  }
+  struct gdakiMiActAnswer an;
+  memset(&an, 0, sizeof(an));
+  an.magic = GDAKI_MI_ACTB_MAGIC;
+  if (s->fetchQp != nullptr) gdakiMiHostQpDestroy(s->fetchQp);
+  s->fetchQp = nullptr;
+  char cw[128] = {0};
+  if (gdakiMiHostQpCreate(r, 16, &s->fetchQp, &an.fetch, cw, sizeof(cw)) == ncclSuccess) {
+    an.ok = 1;
+  } else {
+    s->fetchQp = nullptr;
+    snprintf(an.why, sizeof(an.why), "%.63s", cw);
+  }
+  if (!gdakiRsIoAll(fd, &an, sizeof(an), true, gdakiQ4MonoMs() + 1000.0) || an.ok != 1) {
+    snprintf(why, whyLen, "the FETCH endpoint could not be given to the buddy (%s)", an.ok ? "send failed" : cw);
+    if (s->fetchQp != nullptr) gdakiMiHostQpDestroy(s->fetchQp);
+    s->fetchQp = nullptr;
+    return ncclSystemError;
+  }
+  *as = gdakiMiActStep(*as, GDAKI_MI_AE_ANSWER);
+  struct gdakiMiActReady rd;
+  memset(&rd, 0, sizeof(rd));
+  if (!gdakiRsIoAll(fd, &rd, sizeof(rd), false, gdakiQ4MonoMs() + (double)r->ts->handshakeMs) ||
+      rd.magic != GDAKI_MI_ACTB_MAGIC || rd.kind != GDAKI_MI_ACT_READY) {
+    rd.why[sizeof(rd.why) - 1] = '\0';
+    snprintf(why, whyLen, "no READY from the buddy within %d ms%s%.64s", r->ts->handshakeMs,
+             rd.magic == GDAKI_MI_ACTB_MAGIC && rd.kind == GDAKI_MI_ACT_FAIL ? ": FAIL " : "",
+             rd.magic == GDAKI_MI_ACTB_MAGIC && rd.kind == GDAKI_MI_ACT_FAIL ? rd.why : "");
+    gdakiMiHostQpDestroy(s->fetchQp);
+    s->fetchQp = nullptr;
+    *as = GDAKI_MI_AS_FAIL;
+    return ncclSystemError;
+  }
+  *as = gdakiMiActStep(*as, GDAKI_MI_AE_READY);
+  const ncclResult_t fr = gdakiMiSpareFetch(r, fd, blob, &s->fetched, why, whyLen);
+  if (s->fetchQp != nullptr) gdakiMiHostQpDestroy(s->fetchQp);  // its READs are done (the buddy's waiter frees the other side)
+  s->fetchQp = nullptr;
+  if (fr != ncclSuccess) {
+    *as = GDAKI_MI_AS_FAIL;
+    return fr;
+  }
+  *as = gdakiMiActStep(gdakiMiActStep(*as, GDAKI_MI_AE_READ), GDAKI_MI_AE_DONE);
+  return ncclSuccess;
+}
+// The READs of one region of the buddy's memory into the FETCH buffer, 1 GiB at a time.
+static ncclResult_t gdakiMiFetchRead(struct gdakiMiSpareState* s, uint64_t bufOff, uint64_t remote, uint32_t rkey,
+                                     uint64_t bytes, char* why, size_t whyLen) {
+  const uint64_t chunk = 1ull << 30;
+  for (uint64_t o = 0; o < bytes; o += chunk) {
+    const uint64_t k = std::min(chunk, bytes - o);
+    const int tmo = (int)std::min<uint64_t>(60000, 1000 + (k >> 20));  // 1 s + 1 ms per MiB
+    const ncclResult_t rc = gdakiMiHostQpXfer(s->fetchQp, true, s->fetchBuf + bufOff + o, s->fetchMr->lkey, remote + o, rkey,
+                                              k, tmo, why, whyLen);
+    if (rc != ncclSuccess) return rc;
+  }
+  return ncclSuccess;
+}
+// The FETCH (impl/rs_store_api.h gdakiMiSpareFetch; after READY, before the first REJOIN): this spare's FETCH QP to RTS,
+// the stable slot and then every extent READ into the FETCH buffer (outside every executed-count book: the FETCH QP is not
+// a rec QP), DONE to the buddy, then the slot's header checked against the blob and this process, the image written into
+// this process's regions (as gin-restore's TCP FETCH, gdakiCkptSpareFetch), the header and the blob kept for Resume
+// (gdakiMiSpareFetchTake) and *out for the import. The line "fetch for checkpoint K from buddy rank b".
+static ncclResult_t gdakiMiSpareFetch(struct gdakiRecHost* r, int fd, const struct gdakiMiActBlob& blob,
+                                      struct gdakiMiFetched* out, char* why, size_t whyLen) {
+  struct gdakiMiSpareState* s = gdakiMiSpareOf(r);
+  const struct gdakiMiActHdr& h = blob.hdr;
+  const int me = r->ctx->rank, b = ncclGinMiBuddyOf(me, r->nranks);
+  if (s == nullptr || s->fetchQp == nullptr || s->fetchMr == nullptr) {
+    snprintf(why, whyLen, "no FETCH QP or buffer");
+    return ncclInternalError;
+  }
+  s->fetchOk = false;
+  std::vector<uint64_t> off(blob.ext.size());
+  const uint64_t total = gdakiMiFetchLayout(h.usedBytes, blob.ext.data(), (uint32_t)blob.ext.size(), off.data());
+  if (total > s->fetchCap || h.usedBytes < GDAKI_STORE_HDR_BYTES) {
+    snprintf(why, whyLen, "the FETCH needs %lu bytes, the buffer has %lu", (unsigned long)total, (unsigned long)s->fetchCap);
+    return ncclInvalidUsage;
+  }
+  if (gdakiMiHostQpConnect(s->fetchQp, h.fetch, why, whyLen) != ncclSuccess) return ncclSystemError;
+  const double t0 = gdakiQ4MonoMs();
+  ncclResult_t rc = gdakiMiFetchRead(s, 0, h.storeOff, h.storeRkey, h.usedBytes, why, whyLen);
+  uint64_t segBytes = 0;
+  for (size_t i = 0; rc == ncclSuccess && i < blob.ext.size(); i++) {
+    rc = gdakiMiFetchRead(s, off[i], blob.ext[i].poolOff, h.poolRkey, blob.ext[i].fill, why, whyLen);
+    segBytes += blob.ext[i].fill;
+  }
+  const double t1 = gdakiQ4MonoMs();
+  struct gdakiMiActDone dn;
+  memset(&dn, 0, sizeof(dn));
+  dn.magic = GDAKI_MI_ACTB_MAGIC;
+  dn.ok = rc == ncclSuccess ? 1u : 0u;
+  dn.bytes = rc == ncclSuccess ? h.usedBytes + segBytes : 0;
+  if (rc != ncclSuccess) snprintf(dn.why, sizeof(dn.why), "%.63s", why);
+  (void)gdakiRsIoAll(fd, &dn, sizeof(dn), true, gdakiQ4MonoMs() + 500.0);  // the buddy's waiter frees its QP at its deadline anyway
+  if (rc != ncclSuccess) return rc;
+  // the slot's header against the blob and this process
+  struct gdakiCkptHdr hd;
+  memcpy(&hd, s->fetchBuf, sizeof(hd));
+  struct gdakiTs* ts = r->ts;
+  if (hd.magic != GDAKI_CKPT_MAGIC || hd.version != GDAKI_CKPT_VERSION || hd.rank != me || hd.nonce != ts->nonce ||
+      hd.ckpt != h.ckpt || hd.imageBytes != h.imageBytes || hd.blobBytes != h.blobBytes ||
+      hd.nRegions > GDAKI_CKPT_MAX_REGIONS || hd.nPeers > GDAKI_CKPT_MAX_PEERS ||
+      gdakiStoreUsedBytes(hd.imageBytes, hd.blobBytes) != h.usedBytes ||
+      gdakiStoreLayoutHash(hd.region, hd.nRegions, hd.imageBytes) != h.layoutHash) {
+    snprintf(why, whyLen, "the store slot's header does not match checkpoint %lu of this rank (or the blob's layout)",
+             (unsigned long)h.ckpt);
+    return ncclInvalidUsage;
+  }
+  // the image into this process's regions (as gdakiCkptSpareFetch)
+  std::vector<struct gdakiCkptRegionSrc> regs;
+  if (!gdakiCkptRegions(r, &regs)) {
+    snprintf(why, whyLen, "more than %d regions here", GDAKI_CKPT_MAX_REGIONS);
+    return ncclInvalidUsage;
+  }
+  uint32_t kind2[GDAKI_CKPT_MAX_REGIONS], id[GDAKI_CKPT_MAX_REGIONS];
+  uint64_t rbytes[GDAKI_CKPT_MAX_REGIONS];
+  int map[GDAKI_CKPT_MAX_REGIONS];
+  for (size_t j = 0; j < regs.size(); j++) {
+    kind2[j] = regs[j].kind;
+    id[j] = regs[j].id;
+    rbytes[j] = regs[j].bytes;
+  }
+  const char* mw = "";
+  if (!gdakiCkptRegionMatch(hd.region, (int)hd.nRegions, kind2, id, rbytes, (int)regs.size(), map, &mw)) {
+    snprintf(why, whyLen, "%s", mw);
+    return ncclInvalidUsage;
+  }
+  for (uint32_t i = 0; i < hd.nRegions; i++)
+    if (hd.region[i].offset > hd.imageBytes || hd.region[i].bytes > hd.imageBytes - hd.region[i].offset) {
+      snprintf(why, whyLen, "a region lies outside the image");
+      return ncclInvalidUsage;
+    }
+  int prevDev = -1;
+  if (cudaGetDevice(&prevDev) != cudaSuccess || (prevDev != r->ctx->cuda_id && cudaSetDevice(r->ctx->cuda_id) != cudaSuccess)) {
+    snprintf(why, whyLen, "the context's CUDA device %d could not be selected", r->ctx->cuda_id);
+    return ncclUnhandledCudaError;
+  }
+  const uint8_t* img = s->fetchBuf + GDAKI_STORE_HDR_BYTES;
+  bool copied = true;
+  for (uint32_t i = 0; copied && i < hd.nRegions; i++)
+    if (cudaMemcpy((void*)regs[(size_t)map[i]].src, img + hd.region[i].offset, (size_t)hd.region[i].bytes,
+                   cudaMemcpyHostToDevice) != cudaSuccess) {
+      snprintf(why, whyLen, "the copy of region %u into this process's memory failed", i);
+      copied = false;
+    }
+  if (copied && cudaDeviceSynchronize() != cudaSuccess) {
+    snprintf(why, whyLen, "the image's copies did not complete");
+    copied = false;
+  }
+  if (prevDev >= 0 && prevDev != r->ctx->cuda_id) (void)cudaSetDevice(prevDev);
+  if (!copied) return ncclUnhandledCudaError;
+  const double t2 = gdakiQ4MonoMs();
+  s->hdr.assign(1, hd);
+  s->blob.assign(s->fetchBuf + gdakiStoreBlobOff(hd.imageBytes), s->fetchBuf + gdakiStoreBlobOff(hd.imageBytes) + hd.blobBytes);
+  out->ckpt = h.ckpt;
+  out->buf = s->fetchBuf;
+  out->usedBytes = h.usedBytes;
+  out->ext = blob.ext;
+  out->bufOff = off;
+  s->fetchOk = true;
+  snprintf(s->fetchWhy, sizeof(s->fetchWhy), "fetched");
+  WARN("GIN/MI: rank %d: fetch for checkpoint %lu from buddy rank %d: image_bytes=%lu segment_bytes=%lu extents=%zu "
+       "fetch_us=%.0f h2d_us=%.0f mono_ms=%.3f", me, (unsigned long)h.ckpt, b, (unsigned long)hd.imageBytes,
+       (unsigned long)segBytes, blob.ext.size(), (t1 - t0) * 1000.0, (t2 - t1) * 1000.0, t2);
+  return ncclSuccess;
+}
+// The address table (before the first REJOIN): pe.addr of every gated survivor as gdakiMiAddrRule says (a survivor
+// restored before: the table's; incarnation 0: the recorded one, a WARN line when the table differs).
+static void gdakiMiApplyAddrTable(struct gdakiRecHost* r, const struct gdakiMiActBlob& blob) {
+  struct gdakiTs* ts = r->ts;
+  const int me = r->ctx->rank;
+  for (int q = 0; q < (int)ts->peers.size() && q < (int)blob.addr.size(); q++) {
+    struct gdakiTsPeer& pe = ts->peers[(size_t)q];
+    if (q == me || !pe.gated) continue;
+    const struct gdakiMiActAddr& e = blob.addr[(size_t)q];
+    const int a = gdakiMiAddrRule(q, e, (const uint8_t*)&pe.addr, sizeof(union ncclSocketAddress));
+    if (a == GDAKI_MI_ADDR_TAKE) {
+      memcpy(&pe.addr, e.listenAddr, sizeof(union ncclSocketAddress));
+      pe.haveAddr = true;
+      GIN_TS_NOTE("GIN/MI: rank %d: rank %d (incarnation %u) is reached at the activation table's address mono_ms=%.3f", me,
+                  q, e.incarnation, gdakiQ4MonoMs());
+    } else if (a == GDAKI_MI_ADDR_WARN) {
+      WARN("GIN/MI: rank %d: the activation table's address of rank %d (incarnation 0) differs from the recorded one; the "
+           "recorded one is kept mono_ms=%.3f", me, q, gdakiQ4MonoMs());
+    }
+  }
+}
+// gdakiCkptSpareFetch with the mirror: the driver's RDMA FETCH already wrote the image (before its first REJOIN); its slot
+// header and blob become the TCP FETCH's result, so Resume's code after the driver is unchanged (impl/rs_store_api.h).
+static bool gdakiMiSpareFetchTake(struct gdakiCkptSpareData* d) {
+  d->fetched = true;
+  struct gdakiMiSpareState* s = gdakiMiSpareOf(d->r);
+  if (s == nullptr || !s->fetchOk || s->hdr.empty()) {
+    snprintf(d->fetchWhy, sizeof(d->fetchWhy), "%s", s ? s->fetchWhy : "no mirror state");
+    return false;
+  }
+  d->hdr = s->hdr;
+  d->blob = s->blob;
+  d->fetchOk = true;
+  return true;
+}
+// What the FETCH hands to the import (impl/rs_store_api.h gdakiMiFetched; the dev branch's gdakiMiImportPrepare): null
+// before a FETCH that succeeded (impl/notes_spare.md: an accessor outside the interface).
+static const struct gdakiMiFetched* gdakiMiSpareFetched(struct gdakiRecHost* r) {
+  struct gdakiMiSpareState* s = r != nullptr ? r->mi.spare : nullptr;
+  return s != nullptr && s->fetchOk ? &s->fetched : nullptr;
+}
