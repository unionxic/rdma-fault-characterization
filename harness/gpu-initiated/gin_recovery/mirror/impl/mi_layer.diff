+// ---------------------------------------------------------------------------
+// gin-mirror (dev; EXPERIMENT.md 9.2, 9.3; impl/rs_mirror_api.h): the device mirror. In a program compiled with
+// NCCL_GIN_RESTORE_DEVICE whose side table says miOn, a put with data toward rank d whose cell is valid posts its data a
+// second time, with the same source and lkey, into this rank's lane for d in the pool of d's buddy b, over the mirror
+// context's QP to b (GPU sharing mode: every user context shares it), inside d's gate: the cursor's atomic add takes the
+// lane's place, a non-sleeping single entry of the mirror gate (an odd or failed gate is a break, never a wait), the pool
+// rkey read after that entry, the chunks counted on the mirror QP's msgs, the WRITE, the gate left (a slot wait's error
+// is reported as the mirror context's). The mirror wait at the end of a flush or a wait polls the mirror QP up to its
+// index then, in one counted poll region, bounded by the caller's deadline and abort word and by the epoch: whatever
+// stops it short is a break of the lanes b serves. The mirror path never parks, never sets abandoned, DEV_FAILED or a
+// sticky error and never changes what the application's call returns (the invariant of 9.3): a break is counted in the
+// cells (`broken`), and the helper DISARMs the destinations.
+// ---------------------------------------------------------------------------
+// The side table's entry of the mirror context's QP to `b`, or null (outside the side table).
+NCCL_DEVICE_INLINE static struct ncclGinRsQp* rsMiQpOf(struct ncclGinRsSide* rs, uint32_t miCtx, uint32_t nranks, int b) {
+  const uint32_t i = ncclGinMiQpIdx(miCtx, nranks, (uint32_t)b);
+  if (i >= nccl::utility::loadConst(&rs->nqp)) return nullptr;
+  return reinterpret_cast<struct ncclGinRsQp*>(reinterpret_cast<char*>(rs) + sizeof(struct ncclGinRsSide)) + i;
+}
+// This rank's cell for destination d, or null (no cells, or d outside them).
+NCCL_DEVICE_INLINE static struct ncclGinMiCell* rsMiCellOf(struct ncclGinRsSide* rs, int d) {
+  using nccl::utility::loadConst;
+  const uint64_t off = loadConst(&rs->miCellsOff);
+  if (off == 0 || d < 0 || (uint32_t)d >= loadConst(&rs->miNCells)) return nullptr;
+  return reinterpret_cast<struct ncclGinMiCell*>(reinterpret_cast<char*>(rs) + off) + d;
+}
+// One break on cell c: the count, then the reason and the mirror QP's rank (plain stores, the last break wins; the
+// host's line of the first break it sees; fix of pilot 1's defect D, 2026-10-15).
+NCCL_DEVICE_INLINE static void rsMiNoteBreak(struct ncclGinMiCell* c, uint32_t why, int b) {
+  atomicAdd(reinterpret_cast<unsigned long long*>(&c->broken), 1ull);
+  *reinterpret_cast<volatile uint32_t*>(&c->brkWhy) = why;
+  *reinterpret_cast<volatile uint32_t*>(&c->brkPeer) = (uint32_t)b;
+}
+// One break more on this rank's lanes whose mirror goes to b (never this rank's own cell): the restore's rule, the
+// cells of b's wards; the measurement mode's arms (miMode not 0), every cell whose target (ncclGinMiTargetOf) is b.
+NCCL_DEVICE_INLINE static void rsMiBreakWards(struct ncclGinRsSide* rs, int b, int nranks, int me, uint32_t why) {
+  const uint32_t mode = nccl::utility::loadConst(&rs->miMode);
+  if (mode == NCCL_GIN_MI_MODE_BUDDY) {
+    int w[2];
+    const int k = ncclGinMiWardsOf(b, nranks, w);
+    for (int i = 0; i < k; i++) {
+      struct ncclGinMiCell* const c = w[i] != me ? rsMiCellOf(rs, w[i]) : nullptr;
+      if (c != nullptr) rsMiNoteBreak(c, why, b);
+    }
+    return;
+  }
+  for (int d = 0; d < nranks; d++) {
+    struct ncclGinMiCell* const c = ncclGinMiTargetOf(mode, d, me, nranks) == b ? rsMiCellOf(rs, d) : nullptr;
+    if (c != nullptr) rsMiNoteBreak(c, why, b);
+  }
+}
+// The mirror of one put to `peer` (inside its gate; a put with data, not split). Returns 0 when nothing was mirrored, else
+// 1 << 32 | the lane word (the data's offset in the lane / 64) for the log entry. A valid cell that cannot be mirrored
+// (no usable mirror QP, a full lane, a closed mirror gate) is a break: one more on the cell, the put goes on alone. The
+// mirror QP is the one to ncclGinMiTargetOf(miMode, peer): peer's buddy, or in the measurement mode's arms this rank's
+// self loop (self) or the QP to peer (peer; pilot 1's defect D: the device took peer's buddy for every mode).
+template <int Unused = 0>
+__device__ __noinline__ static uint64_t rsMiPut(ncclGinCtx ctx, struct ncclGinRsSide* rs, struct ncclGinGdakiQ4* q4,
+                                                int peer, uint64_t srcOff, __be32 lkey, uint64_t bytes) {
