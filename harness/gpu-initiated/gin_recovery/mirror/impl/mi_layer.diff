+// The table's entry for survivor q against the address the spare replayed from its transcript (`recorded`, addrBytes of a
+// union ncclSocketAddress). A survivor restored before (incarnation above 0) listens somewhere new: TAKE the table's.
+// One of incarnation 0 keeps the recorded address (gin-restore's decision, letter for letter); a different table address
+// is only a WARN. BAD: the entry is not q's, or a restored survivor has no address (the spare refuses the activation).
+enum { GDAKI_MI_ADDR_KEEP = 0, GDAKI_MI_ADDR_TAKE = 1, GDAKI_MI_ADDR_WARN = 2, GDAKI_MI_ADDR_BAD = 3 };
+static inline int gdakiMiAddrRule(int q, const struct gdakiMiActAddr& e, const uint8_t* recorded, size_t addrBytes) {
+  static const uint8_t zero[sizeof(e.listenAddr)] = {0};
+  if (addrBytes == 0 || addrBytes > sizeof(e.listenAddr) || e.rank != q) return GDAKI_MI_ADDR_BAD;
+  if (e.incarnation == 0) return memcmp(recorded, e.listenAddr, addrBytes) == 0 ? GDAKI_MI_ADDR_KEEP : GDAKI_MI_ADDR_WARN;
+  if (memcmp(e.listenAddr, zero, addrBytes) == 0) return GDAKI_MI_ADDR_BAD;
+  return GDAKI_MI_ADDR_TAKE;
