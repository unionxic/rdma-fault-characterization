+// ==== gin-mirror (host): setup, segments, absorption, INJECTED (begin) ====
+// The host branch of gin-mirror (EXPERIMENT.md 9.2-9.5, 9.7; impl/rs_mirror_api.h, impl/rs_hold_api.h v2,
+// impl/PARALLEL.md):
+//   - the mirror context: one more GIN context after the user's, its QPs created with the context (no all-to-all), its
+//     self loop pair connected there, its pool (host memory in the GIN PD, zero based, no relaxed ordering) registered
+//     there; the setup record's mirror bit; MIRROR_SETUP (48) on the installed helper sockets after the agreement, each
+//     mirror QP to a peer connected (both records on) with its responder baseline; Resume's facts for 34-40;
+//   - the segments of this rank's lanes (the switch in a destination's input pause, the rollback, the restart, the drops at
+//     CKPT_STABLE, INJECTED and a new pool of the buddy), the poll (breaks -> DISARM, CKPT_PULL 49), the pull's take;
+//   - the absorption of the mirror context's fault records (G4, before gdakiHoldRoute) and of the scan's conditions on a
+//     mirror QP: the QP given up (miUse 0), the lanes it serves broken (their cells invalid, their destinations DISARMed),
+//     the peer never declined; a restore round of that peer re-arms the QP;
+//   - PUBLISHED and INJECTED: the restore round's user gates stay odd, RESTORED is bookkeeping, INJECTED (38) makes them
+//     even and moves the state; the revived rank sends INJECTED once its import says so.
+// The helper thread runs everything but the setup (application thread, before the helper starts), gdakiMiPullTake and
+// gdakiMiInjectedReady (application thread, atomics). With the mirror off (gdakiMiOn false) every entry returns at once.
+struct gdakiMiPool {
+  void* mem = nullptr;
+  size_t bytes = 0;  // whole pages
+  struct ibv_mr* mr = nullptr;
+};
+struct gdakiMiDest {  // this rank as the sender toward destination d (helper)
+  struct gdakiMiLedger led; // the segments, the cell's validity, the pause's switch (the pure region's ledger)
+  uint64_t cursor = 0;      // the open segment's cursor at the last poll (the view's openCursor)
+  struct gdakiMiPollMem poll;
+  bool lastPath = false, lastPool = false;  // the last switch's facts (PAUSED's armable)
+  uint64_t measBroken = 0;  // the measurement mode: the cell's broken counter at the last check (integration)
+  bool brkLined = false;    // the first device break of this lane was written (gdakiMiFirstBreakLine; fix, defect D)
+};
+struct gdakiMiHost {
+  // the context's creation (application thread; fixed after)
+  bool asked = false;            // NCCL_GIN_RESTORE_MIRROR in a process that asks for the restore, a user context
+  bool created = false;          // the mirror context exists (its QPs and its GPU context)
+  int ctx = -1;                  // its index (= nUserCtx)
+  int nUserCtx = 0;
+  char notWhy[160] = {0};        // why it was not created
+  struct gdakiMiConf conf;
+  bool confOk = false;
+  char confWhy[128] = {0};
+  int nWards = 0, wards[2] = {-1, -1};
+  uint64_t poolBytes = 0;
+  struct gdakiMiPool* pool = nullptr;  // valid until gdakiMiFree; the context's destroy frees it after its QPs (poolTaken)
+  bool poolTaken = false;
+  uint32_t ownRkey = 0;          // the pool's rkey (host order; 0: no pool)
+  bool poolOk = false;           // registered, or nothing to register (no ward)
+  char poolWhy[128] = {0};
+  bool selfOk = false;           // the self loop pair connected
+  bool selfBaseOk = false;       // integration: its responder's MSN read right after the connect (the drain's base)
+  uint32_t selfBase = 0;
+  int measureArm = 0;            // NCCL_GIN_RESTORE_LOG_MEASURE_MIRROR
+  // the setup (application thread, before the helper; fixed after)
+  bool agreed = false;           // the setup agreement turned the mirror on
+  bool replay = false;           // a spare process (no MIRROR_SETUP)
+  bool peersOk = false;          // every peer's MIRROR_SETUP arrived and its mirror QP connected
+  char peersWhy[160] = {0};
+  std::vector<uint8_t> connected;  // by peer: this rank's mirror QP to it connected at the setup (or re-armed)
+  std::vector<uint32_t> poolRkey;  // by peer: its pool rkey, host order (MIRROR_SETUP, gdakiMiPoolRekey, a cell's)
+  // helper
+  std::vector<uint8_t> givenUp;  // by peer: the mirror QP to it is given up (miUse 0) until its restore re-arms it
+  bool selfErr = false;          // the self loop left RTS: its lanes stay broken
+  bool sideOk = false, sideBad = false;
+  uint64_t cellsOff = 0;
+  std::vector<struct gdakiMiDest> dest;
+  std::vector<uint32_t> restoredPad;  // by peer: the RESTORED taken in its PUBLISHED (its pad; 0: none)
+  double nextPollMs = 0, nextSelfMs = 0, nextMeasureMs = 0;
+  bool measureSet = false;
+  uint32_t injSentInc = 0;       // the incarnation INJECTED goes out for
+  std::vector<uint8_t> injSent;  // by peer: told (sends that failed are retried every 20 ms, 50 times at most)
+  bool injActive = false;
+  int injTries = 0;
+  uint64_t injStepNow = 0;
+  double injNextMs = 0;
+  // the application thread
+  std::atomic<bool> pull{false};    // a CKPT_PULL for this rank arrived since the last checkpoint
+  std::atomic<int> injPending{0};   // gdakiMiInjectedReady was called
+  std::atomic<uint64_t> injStep{0};
+  // counters (the summary line, after the helper stopped)
+  uint64_t nSwitch = 0, nRollback = 0, nRestart = 0, nThird = 0, maxLive = 0, nPullSent = 0, nBroken = 0, nAbsorbed = 0;
+  uint64_t nSwitchFail = 0;
