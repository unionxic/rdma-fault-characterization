+  struct ncclGinMiCell* const c = peer != ctx.rank ? rsMiCellOf(rs, peer) : nullptr;
+  if (c == nullptr || tsLoadRelaxedSys(&c->valid) == 0) return 0;  // not mirrored toward d now: not a break
+  const int b = ncclGinMiTargetOf(loadConst(&rs->miMode), peer, ctx.rank, ctx.nRanks);
+  const uint32_t miCtx = loadConst(&rs->miCtx);
+  struct ncclGinRsQp* const mq = b >= 0 ? rsMiQpOf(rs, miCtx, (uint32_t)ctx.nRanks, b) : nullptr;
+  uint32_t why = NCCL_GIN_MI_BRK_NO_QP;
+  if (mq != nullptr && tsLoadRelaxedSys(&mq->miUse) != 0) {
+    why = NCCL_GIN_MI_BRK_FULL;
+    // written over the NIC while d's gates are odd: read through L2, not L1
+    const uint64_t laneBase = tsLoadRelaxedSys64(&c->laneBase);
+    const uint64_t laneBytes = tsLoadRelaxedSys64(&c->laneBytes);
+    // a put larger than the lane takes no room (and its round-up cannot wrap): a break
+    const uint64_t off = bytes <= laneBytes ? (uint64_t)atomicAdd(reinterpret_cast<unsigned long long*>(&c->cursor),
+                                                                  (unsigned long long)ncclGinMiRound64(bytes))
+                                            : ~0ull;
+    if (ncclGinMiFits(off, bytes, laneBytes)) {
+      ncclGinGdakiGPUContext* const mg = &((struct ncclGinGdakiGPUContext*)ctx.handle)[miCtx];
+      doca_gpu_dev_verbs_qp* const mqp = loadConst(&mg->gdqp) + b;
+      const bool gated = tsOn(mqp);  // the self loop (this rank is b) has no gate, as hk's put to itself
+      bool open = true;
+      if (gated) {  // one entry, never parked: a round, a hold of b or a failed QP closes it
+        const unsigned long long w = tsWordEnter(tsWord(mqp));
+        if (!tsWordOpen(w)) {
+          tsWordLeave(tsWord(mqp));
+          open = false;
+          why = NCCL_GIN_MI_BRK_GATE;
+        }
+      } else {
+        // the self loop: DOCA's stock slot wait (no gate) spins for ever once a reservation's slot CQE (its index minus
+        // the SQ size) lies outside the CQ's window [ci, ci + cqe_num) while an error CQE stopped the consumer index.
+        // Two checks, no wait: the oldest outstanding completion is polled (an error there: the loop failed, a break,
+        // nothing more posted), and the reservation this put would take must keep its slot CQE inside the window (else
+        // a break: more than a ring of posts is blocked behind the consumer index). Reservations racing between the
+        // read and the add move the slot CQE further by the racers' chunks only; accepted (impl/notes_dev.md)
+        struct doca_gpu_dev_verbs_cq* const cq = doca_gpu_dev_verbs_qp_get_cq_sq(mqp);
+        const uint64_t ci = *(volatile uint64_t*)&cq->cqe_ci;
+        const uint64_t rsvd =
+          doca_gpu_dev_verbs_atomic_read<uint64_t, DOCA_GPUNETIO_VERBS_RESOURCE_SHARING_MODE_GPU>(&mqp->sq_rsvd_index);
+        const uint64_t nwqe = doca_gpu_dev_verbs_load_const(&mqp->sq_wqe_num);
+        const uint64_t cqeNum = doca_gpu_dev_verbs_load_const(&cq->cqe_num);
+        if (rsvd + ncclGinRsDataMsgs(true, bytes) > ci + nwqe + cqeNum) open = false;
+        else if (rsvd > ci && doca_gpu_dev_verbs_poll_one_cq_at<DOCA_GPUNETIO_VERBS_RESOURCE_SHARING_MODE_GPU>(mqp, ci) < 0)
+          open = false;
+        if (!open) why = NCCL_GIN_MI_BRK_SELF;
+      }
+      // after the entry: a rekey happens while the gate is odd; 0 is "unknown" (impl/rs_mirror_api.h): a break
+      const uint32_t rkey = open ? tsLoadRelaxedSys(&c->rkeyBe) : 0u;
+      if (open && rkey == 0) {
+        if (gated) tsWordLeave(tsWord(mqp));
+        open = false;
+        why = NCCL_GIN_MI_BRK_RKEY;
+      }
+      if (open) {
+        doca_gpu_dev_verbs_addr raddr, laddr;
+        raddr.addr = laneBase + off;  // the pool is registered zero-based
+        raddr.key = rkey;
+        laddr.addr = srcOff;
+        laddr.key = lkey;
+        atomicAdd(reinterpret_cast<unsigned long long*>(&mq->msgs), (unsigned long long)ncclGinRsDataMsgs(true, bytes));
+        doca_gpu_dev_verbs_put<DOCA_GPUNETIO_VERBS_RESOURCE_SHARING_MODE_GPU>(
+          mqp, raddr, laddr, bytes, q4CollapsedCodeOpt(mqp, DOCA_GPUNETIO_VERBS_GPU_CODE_OPT_DEFAULT));
+        if (gated) {
+          ncclGinCtx mctx = ctx;  // a slot wait's error CQE is reported as the mirror context's (the helper absorbs it)
+          mctx.contextId = (int)miCtx;
+          tsPostLeave(mctx, q4, mqp, b);
+        }
+        return (1ull << 32) | (uint64_t)(uint32_t)(off >> 6);
+      }
+    }
+  }
+  rsMiNoteBreak(c, why, b);
+  return 0;
+}
