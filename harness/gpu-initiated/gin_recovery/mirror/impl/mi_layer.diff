+// The scope mask of the user contexts (the input pause's walks): every context but the mirror's; the mirror off (or no
+// such bit): every context, as before.
+static uint32_t gdakiMiUserScopeOf(bool on, int miCtx) {
+  return (on && miCtx >= 0 && miCtx < 32) ? (0xffffffffu & ~(1u << miCtx)) : 0xffffffffu;
+}
+// The absorption's test (G4 before gdakiHoldRoute, the scan): a fault record or a QP of the mirror context, whatever its
+// class; the mirror off: never (gin-restore's routes, unchanged).
+static bool gdakiMiIsMirrorCtx(bool on, int ctx, int miCtx) { return on && miCtx >= 0 && ctx == miCtx; }
+static bool gdakiMiIsMirrorQp(bool on, int qpIdx, int nranks, int miCtx) {
+  return nranks > 0 && qpIdx >= 0 && gdakiMiIsMirrorCtx(on, qpIdx / nranks, miCtx);
+}
+// The destinations a mirror QP to `b` serves: b's wards but this rank (whose lane would be to itself). Their lanes break
+// when that QP is given up.
+static int gdakiMiServedBy(int b, int me, int n, int* out) {
+  int w[2];
+  const int k = ncclGinMiWardsOf(b, n, w);
+  int c = 0;
+  for (int i = 0; i < k; i++)
+    if (w[i] != me) out[c++] = w[i];
+  return c;
+}
+
+// PUBLISHED's deadline of a restore round (impl/rs_hold_api.h v2): with the user gates kept odd, min(v1's, the hold's
+// device bound); a bound not known (0) leaves v1's.
+static int64_t gdakiMiPublishedDeadlineUs(bool keptOdd, int64_t v1Us, int64_t deviceBoundUs) {
+  return (keptOdd && deviceBoundUs > 0) ? gdakiHoldInjectWaitDeadlineUs(v1Us, deviceBoundUs) : v1Us;
+}
+
+// INJECTED (record 38) from `from` on a survivor: 0 = apply (impl/rs_hold_api.h v2 gdakiHoldInjectedAction), else why
+// not. restoredPad: the pad (new incarnation) of the RESTORED this rank took from it (0: none).
+enum { GDAKI_MI_INJ_APPLY = 0, GDAKI_MI_INJ_OFF = 1, GDAKI_MI_INJ_FORMAT = 2, GDAKI_MI_INJ_NO_RESTORED = 3,
+       GDAKI_MI_INJ_STATE = 4 };
+static int gdakiMiInjectedCheck(bool mirrorOn, int from, int arg, uint32_t ver, uint32_t wantVer, uint32_t senderInc,
+                                uint32_t pad, uint32_t state, uint32_t inc, uint32_t restoredPad) {
+  if (!mirrorOn) return GDAKI_MI_INJ_OFF;
+  if (arg != from || ver != wantVer || senderInc != pad || pad == 0) return GDAKI_MI_INJ_FORMAT;
+  const bool restoredTaken = restoredPad != 0 && restoredPad == pad;
+  if (gdakiHoldInjectedAction(state, inc, pad, restoredTaken) == GDAKI_HOLD_INJ_APPLY) return GDAKI_MI_INJ_APPLY;
+  const bool published = state == GDAKI_HOLD_PUBLISHED || state == GDAKI_HOLD_TIMED_OUT_PUBLISHED;
+  return (published && pad == inc + 1u) ? GDAKI_MI_INJ_NO_RESTORED : GDAKI_MI_INJ_STATE;
+}
+static const char* gdakiMiInjectedWhy(int code) {
+  switch (code) {
+    case GDAKI_MI_INJ_APPLY: return "applied";
+    case GDAKI_MI_INJ_OFF: return "the mirror is off";
+    case GDAKI_MI_INJ_FORMAT: return "a malformed record";
+    case GDAKI_MI_INJ_NO_RESTORED: return "its RESTORED was not taken first";
+    case GDAKI_MI_INJ_STATE: return "not a published restore of that incarnation";
+    default: return "?";
+  }
+}
+
+// The measurement mode's arm (NCCL_GIN_RESTORE_LOG_MEASURE_MIRROR; EXPERIMENT.md 7, 9.7): 0 off, 1 self (every put to d
+// mirrored into this rank's own pool over the self loop), 2 peer (into d's own pool); -1 another value (off). The lane is
+// a fixed one of that pool's first ward (the data is never read): false when that pool has no ward.
+static int gdakiMiMeasureArmOf(const char* v) {
+  if (v == nullptr || *v == '\0' || strcmp(v, "0") == 0) return 0;
+  if (strcmp(v, "self") == 0) return 1;
+  if (strcmp(v, "peer") == 0) return 2;
+  return -1;
+}
+static bool gdakiMiMeasureLane(int arm, int me, int d, int n, uint64_t slots, uint64_t laneBytes, int* target,
+                               uint64_t* laneBase) {
+  *target = arm == 1 ? me : arm == 2 ? d : -1;
+  int w[2];
+  if (*target < 0 || n < 2 || d == me || ncclGinMiWardsOf(*target, n, w) == 0) return false;
+  const int lane = *target == me ? (d < me ? d : d - 1) : (me < d ? me : me - 1);
+  if (lane < 0 || lane >= n - 1) return false;
+  *laneBase = ncclGinMiLaneOff(0, 0, lane, n, slots, laneBytes);
+  return true;
+}
+// The device's reason of a lane's last break (the cell's brkWhy, NCCL_GIN_MI_BRK_*), as the first-break line names it
+// (fix of pilot 1's defect D, 2026-10-15).
+static const char* gdakiMiBrkName(uint32_t why) {
+  switch (why) {
+    case NCCL_GIN_MI_BRK_NONE: return "none";
+    case NCCL_GIN_MI_BRK_NO_QP: return "no_mirror_qp";
+    case NCCL_GIN_MI_BRK_FULL: return "lane_full";
+    case NCCL_GIN_MI_BRK_GATE: return "gate_closed";
+    case NCCL_GIN_MI_BRK_SELF: return "self_loop";
+    case NCCL_GIN_MI_BRK_RKEY: return "rkey_unknown";
+    case NCCL_GIN_MI_BRK_WAIT: return "mirror_wait";
+    default: return "?";
+  }
+}
