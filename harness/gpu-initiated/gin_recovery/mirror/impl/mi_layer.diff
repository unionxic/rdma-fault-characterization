+static bool gdakiMiOn(struct gdakiRecHost* r) { return r != nullptr && r->mi.on && r->mi.host != nullptr; }
+// The side table header's miMode in the measurement mode (gdakiRsStart writes it before the publish): the arm's (1 self,
+// 2 peer: the numbers of gdakiMiMeasureArmOf and NCCL_GIN_MI_MODE_*), else the restore's (0). Fix of pilot 1's defect D.
+static uint32_t gdakiMiMeasureModeOf(struct gdakiRecHost* r) {
+  static_assert(NCCL_GIN_MI_MODE_SELF == 1u && NCCL_GIN_MI_MODE_PEER == 2u, "gdakiMiMeasureArmOf's numbers");
+  if (!gdakiMiOn(r)) return NCCL_GIN_MI_MODE_BUDDY;
+  const int a = r->mi.host->measureArm;
+  return a == 1 ? NCCL_GIN_MI_MODE_SELF : a == 2 ? NCCL_GIN_MI_MODE_PEER : NCCL_GIN_MI_MODE_BUDDY;
+}
