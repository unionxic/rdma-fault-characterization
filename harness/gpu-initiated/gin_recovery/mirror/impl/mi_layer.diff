+// QP, whose number no transcript holds) while this rank's own incarnation is 0; none once this rank was itself restored
+// (the spare's transcript holds the first incarnation's numbers).
+static inline int gdakiMiRejoinCmpCount(int nqp, bool mirrorOn, uint32_t selfInc) {
+  if (!mirrorOn) return nqp;
+  if (selfInc != 0) return 0;
+  return nqp > 0 ? nqp - 1 : 0;
+}
+// Spare side (TOKEN): the survivor's QPNs against the transcript's view, compared as gdakiMiRejoinCmpCount says for the
+// survivor's own incarnation (from its REJOIN_ACK). Mirror off: every QP, as v1.
+static bool gdakiMiTokenQpnCheck(unsigned nqp, const uint32_t* tokQpn, const uint32_t* recQpn, bool mirrorOn,
+                                 uint32_t survivorInc, char* why, size_t whyLen) {
+  const int n = gdakiMiRejoinCmpCount((int)nqp, mirrorOn, survivorInc);
+  for (int i = 0; i < n; i++)
+    if (tokQpn[i] != recQpn[i]) {
+      snprintf(why, whyLen, "TOKEN QP %d: QPN %#x is not the transcript's %#x (incarnation %u)", i, tokQpn[i], recQpn[i],
+               survivorInc);
+      return false;
+    }
+  snprintf(why, whyLen, "TOKEN QPNs: %d of %u compared (incarnation %u)", n, nqp, survivorInc);
+  return true;
+}
+// The spare connects QP i of nqp with the token's QPN (true) or the transcript's (false; equal to the token's then): the
+// mirror QP (the last) always, every QP of a survivor restored before (incarnation above 0).
+static inline bool gdakiMiQpnFromToken(unsigned i, unsigned nqp, bool mirrorOn, uint32_t survivorInc) {
+  return mirrorOn && (survivorInc != 0 || i + 1u == nqp);
+}
+
+// ---- the rkey rule of the spare's import (impl/rs_spare_api.h v2: STATE's rkey lists against the replayed values) ----
+// For one entry of survivor q's list (q's own incarnation `survivorInc`): the pool (kind GDAKI_MI_RKEY_POOL) is never in a
+// transcript, so it is always TAKEn; a window, the signal or the counter table of a survivor restored before is TAKEn; of
+// a survivor of incarnation 0 the replayed value is KEPT (WARN when the list differs); SKIP: a kind this rule does not know,
+// or an entry with no replayed slot here (the import's coverage check refuses that).
+enum { GDAKI_MI_RK_KEEP = 0, GDAKI_MI_RK_TAKE = 1, GDAKI_MI_RK_WARN = 2, GDAKI_MI_RK_SKIP = 3 };
+static inline int gdakiMiRkeyRule(uint32_t kind, uint32_t survivorInc, bool haveReplayed, uint32_t replayedBe,
+                                  uint32_t listBe) {
+  if (kind == GDAKI_MI_RKEY_POOL) return GDAKI_MI_RK_TAKE;
+  if (kind != GDAKI_RS_RKEY_WINDOW && kind != GDAKI_RS_RKEY_SIGNALS && kind != GDAKI_RS_RKEY_COUNTERS) return GDAKI_MI_RK_SKIP;
+  if (!haveReplayed) return GDAKI_MI_RK_SKIP;
+  if (survivorInc != 0) return GDAKI_MI_RK_TAKE;
+  return replayedBe == listBe ? GDAKI_MI_RK_KEEP : GDAKI_MI_RK_WARN;
+}
+// One survivor's list merged with the replayed values (rep: kind, id, rkeyBe of every slot the spare replayed for that
+// survivor): *write = the entries to write (the pool's included), *warns = differences kept as replayed, *poolBe = the
+// pool's rkey (0: none in the list). 0, or -1 when an entry of a known kind has no replayed slot or a replayed window is
+// missing from the list (coverage, as gdakiRsSwapRkeys), with why. The integration (2026-10-15) made the coverage rule
+// the dev branch's import's (gdakiMiImportPrepareLocked, gdakiMiRkeyVerdict): for a survivor of incarnation 0 a coverage
+// gap is a WARN (counted in *warns, the replayed values stay), only for one restored before (incarnation above 0) a
+// refusal. The import applies the same rule with its device reads; this function is its pure statement (unit test).
+static int gdakiMiRkeyMerge(const struct gdakiRsRkeyEntry* list, uint32_t n, uint32_t survivorInc,
+                            const struct gdakiRsRkeyEntry* rep, uint32_t nRep, std::vector<struct gdakiRsRkeyEntry>* write,
+                            int* warns, uint32_t* poolBe, char* why, size_t whyLen) {
+  write->clear();
+  *warns = 0;
+  *poolBe = 0;
+  for (uint32_t j = 0; j < nRep; j++) {
+    if (rep[j].kind != GDAKI_RS_RKEY_WINDOW) continue;
+    bool named = false;
+    for (uint32_t i = 0; i < n && !named; i++) named = list[i].kind == rep[j].kind && list[i].id == rep[j].id;
+    if (!named && survivorInc != 0) {
+      snprintf(why, whyLen, "window number %u is registered here but missing from the rkey list", rep[j].id);
+      return -1;
+    }
+    if (!named) (*warns)++;  // incarnation 0: the recorded key stays
+  }
+  for (uint32_t i = 0; i < n; i++) {
+    const struct gdakiRsRkeyEntry& e = list[i];
+    const struct gdakiRsRkeyEntry* hit = nullptr;
+    for (uint32_t j = 0; j < nRep && hit == nullptr; j++)
+      if (rep[j].kind == e.kind && rep[j].id == e.id) hit = &rep[j];
+    const int a = gdakiMiRkeyRule(e.kind, survivorInc, hit != nullptr, hit ? hit->rkeyBe : 0u, e.rkeyBe);
+    if (e.kind == GDAKI_MI_RKEY_POOL) *poolBe = e.rkeyBe;
+    if (a == GDAKI_MI_RK_SKIP && hit == nullptr && e.kind >= GDAKI_RS_RKEY_WINDOW && e.kind <= GDAKI_RS_RKEY_COUNTERS) {
+      if (survivorInc == 0) {  // incarnation 0: ignored with a WARN
+        (*warns)++;
+        continue;
+      }
+      snprintf(why, whyLen, "rkey list entry kind %u number %u has no slot here", e.kind, e.id);
+      return -1;
+    }
+    if (a == GDAKI_MI_RK_TAKE) write->push_back(e);
+    if (a == GDAKI_MI_RK_WARN) (*warns)++;
+  }
+  snprintf(why, whyLen, "%zu rkey(s) to write, %d difference(s) kept as replayed", write->size(), *warns);
+  return 0;
+}
+
+// ---- the order on the spare's activation connection (impl/rs_store_api.h: ACCEPTED, the FETCH endpoint, READY, the
+// READs, DONE; impl/rs_spare_api.h v2: FETCH before the first REJOIN) ----
+enum {
+  GDAKI_MI_AS_WAIT = 0,      // no usable ACTIVATE yet
+  GDAKI_MI_AS_ACCEPTED = 1,  // answered ACCEPTED (record and blob checked)
+  GDAKI_MI_AS_ANSWERED = 2,  // the spare's FETCH endpoint went out (its QP in INIT)
+  GDAKI_MI_AS_READY = 3,     // the buddy's READY arrived (its FETCH QP is RTS): READs may go out now, not before
+  GDAKI_MI_AS_READ = 4,      // every READ completed
+  GDAKI_MI_AS_DONE = 5,      // DONE sent: the first REJOIN may go out
+  GDAKI_MI_AS_FAIL = 100,
+};
+enum { GDAKI_MI_AE_ACCEPT = 1, GDAKI_MI_AE_ANSWER = 2, GDAKI_MI_AE_READY = 3, GDAKI_MI_AE_READ = 4, GDAKI_MI_AE_DONE = 5 };
+// The one legal next state for (state, event); anything else (a READ before READY, a second ACCEPTED, ...) is FAIL.
+static inline int gdakiMiActStep(int state, int event) {
+  if (state < GDAKI_MI_AS_WAIT || state >= GDAKI_MI_AS_DONE) return GDAKI_MI_AS_FAIL;
+  return event == state + 1 ? state + 1 : GDAKI_MI_AS_FAIL;
+}
+// The spare's first REJOIN: with the mirror only after DONE (its image and segments are in its FETCH buffer).
+static inline bool gdakiMiRejoinAllowed(bool mirrorOn, int state) { return !mirrorOn || state == GDAKI_MI_AS_DONE; }
+
+// ---- the FETCH buffer's layout (impl/rs_store_api.h gdakiMiFetched): the slot at 0, then every extent 64-byte aligned
+// from the slot's 4 KiB-rounded end, in the blob's order (the sum gdakiMiActCheck bounds by the buffer) ----
+static inline uint64_t gdakiMiFetchLayout(uint64_t usedBytes, const struct gdakiMiActExt* ext, uint32_t n, uint64_t* off) {
+  uint64_t o = gdakiStoreRound4k(usedBytes);
+  for (uint32_t i = 0; i < n; i++) {
+    off[i] = o;
+    o += (ext[i].fill + 63u) & ~(uint64_t)63u;
+  }
+  return o;
+}
+
+// ---- HOLDING's payload (impl/rs_mirror_api.h gdakiMiHolding) from the holder's records and the cell read at its hold
+// start ----
+// closed segments (oldest first): seg, fill, the checkpoint that closed it, breaks while it was open; the open one from the
+// device's cell (EXPERIMENT.md 9.4 step 1: the device's values, also when the hold took over a pause): its segment number
+// (0: the cell never opened one), cursor and cumulative breaks now; brokenAtOpen: the cumulative breaks when it opened
+// (the host's record of the last switch). False (version 0: the buddy refuses it) when more live segments than a payload
+// carries.
+static bool gdakiMiHoldingOf(const uint64_t* cSeg, const uint64_t* cFill, const uint64_t* cClosedAt, const uint64_t* cBroken,
+                             int nClosed, uint64_t openSeg, uint64_t cursor, uint64_t brokenNow, uint64_t brokenAtOpen,
+                             uint64_t laneBytes, bool pathOk, bool cellValid, uint64_t mirMsgs,
+                             struct gdakiMiHolding* out) {
+  memset(out, 0, sizeof(*out));
+  out->mirMsgs = mirMsgs;
+  out->pathOk = pathOk ? 1u : 0u;
+  out->cellValid = cellValid ? 1u : 0u;
+  const int nOpen = openSeg != 0 ? 1 : 0;
+  if (nClosed < 0 || nClosed + nOpen > GDAKI_MI_SEG_MAX) return false;
+  for (int i = 0; i < nClosed; i++) {
+    struct gdakiMiHoldSeg& g = out->seg[out->nSeg++];
+    g.seg = cSeg[i];
+    g.fill = cFill[i] < laneBytes ? cFill[i] : laneBytes;
+    g.closedAt = cClosedAt[i];
+    g.broken = cBroken[i] > 0xffffffffull ? 0xffffffffu : (uint32_t)cBroken[i];
+  }
+  if (nOpen) {
+    struct gdakiMiHoldSeg& g = out->seg[out->nSeg++];
+    g.seg = openSeg;
+    g.fill = cursor < laneBytes ? cursor : laneBytes;
+    g.closedAt = GDAKI_MI_OPEN;
+    const uint64_t b = brokenNow >= brokenAtOpen ? brokenNow - brokenAtOpen : ~0ull;  // went back: count it a break
+    g.broken = b > 0xffffffffull ? 0xffffffffu : (uint32_t)b;
+  }
+  out->version = GDAKI_MI_WIRE_VERSION;
+  return true;
+}
+
+// ---- the buddy: the blob's extents from the holders' payloads ----
+// pay[s], have[s] by sender rank (n of them; d itself has none). For a restore of d from its stable checkpoint k: every
+// payload must be there and usable (gdakiMiHoldingVerdict); every live segment closed after k or open that holds bytes is
+// one extent (sender order, then the payload's order), its pool offset from (wardIdx, seg mod slots, lane); drain[s] = 1
+// for a sender with such bytes (its mirror WRITEs must have executed here before the activation). 0, or 1 a payload
+// missing, 2 a payload not usable (*bad: the sender, *verdict: its code), 3 more extents than a blob carries, 4 the
+// geometry is not usable (no slots or lane bytes, d has no ward index).
+static int gdakiMiExtentsOf(const struct gdakiMiHolding* pay, const uint8_t* have, int n, int d, uint64_t k, int wardIdx,
+                            uint64_t slots, uint64_t laneBytes, std::vector<struct gdakiMiActExt>* ext,
+                            std::vector<uint8_t>* drain, int* bad, int* verdict) {
+  ext->clear();
+  drain->assign((size_t)(n > 0 ? n : 0), 0);
+  *bad = -1;
+  *verdict = 0;
+  if (n < 2 || d < 0 || d >= n || wardIdx < 0 || slots == 0 || laneBytes == 0) return 4;
+  for (int s = 0; s < n; s++) {
+    if (s == d) continue;
+    if (!have[s]) {
+      *bad = s;
+      return 1;
+    }
+    const int v = gdakiMiHoldingVerdict(pay[s], k);
+    if (v != 0) {
+      *bad = s;
+      *verdict = v;
+      return 2;
+    }
+    for (uint32_t i = 0; i < pay[s].nSeg; i++) {
+      const struct gdakiMiHoldSeg& g = pay[s].seg[i];
+      if (g.closedAt != GDAKI_MI_OPEN && g.closedAt <= k) continue;  // in the image already (dropped by k)
+      if (g.fill == 0) continue;
+      if (g.fill > laneBytes) {
+        *bad = s;
+        *verdict = 4;
+        return 2;
+      }
+      if (ext->size() >= GDAKI_MI_ACT_MAX_EXT) return 3;
+      struct gdakiMiActExt e;
+      memset(&e, 0, sizeof(e));
+      e.seg = g.seg;
+      e.sender = s;
+      e.lane = (uint32_t)ncclGinMiLaneOf(s, d);
+      e.poolOff = ncclGinMiLaneOff(wardIdx, g.seg % slots, (int)e.lane, n, slots, laneBytes);
+      e.fill = g.fill;
+      e.closedAt = g.closedAt;
+      ext->push_back(e);
+      (*drain)[(size_t)s] = 1;
+    }
+  }
+  return 0;
+}
+
+// ---- the drain (EXPERIMENT.md 9.4 step 2) ----
+// A sender's lane over a mirror QP of the GIN rec set: the buddy's cumulative executed count of that QP (folded by the
+// watch's QUERY_QP) must reach the sender's M_mir. -1: the count was invalidated (the drain refuses), 0 drained, 1 not yet.
+static inline int gdakiMiDrainOf(bool valid, uint64_t cum, uint64_t mMir) {
+  if (!valid) return -1;
+  return cum >= mMir ? 0 : 1;
+}
+// The buddy's own lane over its self loop (a QP pair outside the rec set: no watch folds its count). The requester's msgs
+// count from 0 (the side table starts zeroed); the responder's 24-bit MSN counts from `base`, its value when the loop was
+// connected (gdakiMiSelfBase). With mSelf the msgs read at the hold start and E the WRITEs executed now: E - mSelf lies in
+// (-depth, 2^23), since at most a send queue's depth is posted and not executed and the WRITEs posted since the hold start
+// (toward the buddy's other ward) are far fewer than 2^23 by the drain. So 24 bits tell it, with no fold across helper
+// steps: drained when the MSN is at or past base + mSelf modulo 2^24.
+static inline bool gdakiMiSelfDrained(uint64_t mSelf, uint32_t rmsn, uint32_t base) {
+  return (((uint64_t)rmsn - (uint64_t)base - mSelf) & 0xffffffull) < 0x800000ull;
+}
+
+// ---- the export v2 (impl/rs_log_api.h v2) ----
+// The 64-bit position of a collected entry from its low 32 bits (`from` is the first position asked; the range is far
+// below 2^32 entries).
+static inline uint64_t gdakiMiPos64(uint64_t from, uint32_t lo) { return from + (uint64_t)(uint32_t)(lo - (uint32_t)from); }
+// The step of an entry: gdakiRsStepOfPos over the (step, head) pairs above the cut; with no pair the last recorded step + 1
+// (an entry after the last Step), GDAKI_RS_STEP_UNKNOWN when no step was ever recorded.
+static inline uint64_t gdakiMiStepTag(const uint64_t* steps, const uint64_t* heads, int nPairs, uint64_t lastStep,
+                                      uint64_t pos) {
+  if (nPairs > 0) return gdakiRsStepOfPos(steps, heads, nPairs, pos);
+  return lastStep == GDAKI_RS_STEP_UNKNOWN ? GDAKI_RS_STEP_UNKNOWN : lastStep + 1;
+}
+// One entry toward the restored rank after the cut: its record v2 (step, segment). 0, or the refusal (the exporter's and
+// the importer's): 1 a put with data without MIRROR; 2 a MIRROR entry below the oldest live segment (segment 0); 3 its step
+// unknown or not after the checkpoint; 4 MIRROR on an entry that is not a put with data.
+enum { GDAKI_MI_X_OK = 0, GDAKI_MI_X_NOMIRROR = 1, GDAKI_MI_X_NOSEG = 2, GDAKI_MI_X_NOSTEP = 3, GDAKI_MI_X_BADMIRROR = 4 };
+static int gdakiMiExportTag(const struct ncclGinRsLogEntry& e, uint64_t pos, uint64_t ckpt, const uint64_t* steps,
+                            const uint64_t* heads, int nPairs, uint64_t lastStep, const uint64_t* cuts, const uint64_t* segs,
+                            int nClosed, uint64_t openSeg, uint64_t floor, struct gdakiRsLogXEnt2* out) {
+  memset(out, 0, sizeof(*out));
+  out->e = e;
+  const uint32_t kind = ncclGinRsEntryKind(e.qpKf), flags = ncclGinRsEntryFlags(e.qpKf);
+  const bool data = kind == NCCL_GIN_RS_LOG_PUT && e.bytes > 0;
+  const bool mirror = (flags & NCCL_GIN_RS_LOGF_MIRROR) != 0;
+  if (mirror && !data) return GDAKI_MI_X_BADMIRROR;
+  if (data && !mirror) return GDAKI_MI_X_NOMIRROR;
+  out->step = gdakiMiStepTag(steps, heads, nPairs, lastStep, pos);
+  if (out->step == GDAKI_RS_STEP_UNKNOWN || out->step <= ckpt) return GDAKI_MI_X_NOSTEP;
+  if (mirror) {
+    out->seg = gdakiMiSegOfPos(cuts, segs, nClosed, openSeg, floor, pos);
+    if (out->seg == 0) return GDAKI_MI_X_NOSEG;
+  }
+  return GDAKI_MI_X_OK;
+}
+static inline const char* gdakiMiExportTagName(int v) {
+  switch (v) {
+    case GDAKI_MI_X_NOMIRROR: return "a put with data was not mirrored";
+    case GDAKI_MI_X_NOSEG: return "a mirrored put lies below the oldest live segment";
+    case GDAKI_MI_X_NOSTEP: return "an entry's step is unknown or not after the checkpoint";
+    case GDAKI_MI_X_BADMIRROR: return "the mirror flag is on an entry that is not a put with data";
+    default: return "ok";
+  }
+}
+// The stream of the export v2 through `put`, in this order: gdakiRsLogXHdr (version 2), gdakiRsLogXHdr2, the entries,
+// gdakiRsLogXEnd, then the rkey list (gdakiRsRkeysHdr and its entries). False when `put` failed.
+template <typename F>
+static bool gdakiMiLogXWrite2(const struct gdakiRsLogXHdr& h, const struct gdakiRsLogXHdr2& h2,
+                              const struct gdakiRsLogXEnt2* ents, size_t n, const struct gdakiRsLogXEnd& end,
+                              const struct gdakiRsRkeysHdr& kh, const struct gdakiRsRkeyEntry* keys, F put) {
+  if (!put(&h, sizeof(h)) || !put(&h2, sizeof(h2))) return false;
+  if (n && !put(ents, n * sizeof(*ents))) return false;
+  if (!put(&end, sizeof(end)) || !put(&kh, sizeof(kh))) return false;
+  return kh.count == 0 || put(keys, (size_t)kh.count * sizeof(*keys));
+}
