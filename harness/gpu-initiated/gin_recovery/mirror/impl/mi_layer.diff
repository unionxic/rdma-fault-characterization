+// The segments of this rank's lane toward one destination d (impl/rs_mirror_api.h "segments"). The host keeps them on
+// the helper thread; a rollback restores a copy taken before the switch.
+struct gdakiMiSeg {
+  uint64_t seg = 0;                   // segment number (from 1)
+  uint64_t start = 0;                 // the ring head of the pause that opened it (the oldest one's: the view's floor)
+  uint64_t cut = 0;                   // closed: the ring head of the pause that closed it (its entries are below)
+  uint64_t fill = 0;                  // closed: min(cursor, L) at its close
+  uint64_t closedAt = GDAKI_MI_OPEN;  // d's checkpoint whose pause closed it
+  uint64_t brokenOpen = 0;            // the cell's cumulative broken at its opening
+  uint64_t broken = 0;                // closed: breaks while it was open (the cell's and the host's)
+};
+struct gdakiMiSegs {
+  std::vector<struct gdakiMiSeg> live;  // closed in closing order, then the open one (closedAt GDAKI_MI_OPEN) last
+  uint64_t lastSeg = 0;                 // the last segment number opened (0: none)
+  uint32_t hostBreaks = 0;              // breaks the host saw while the open one is open (its QP given up, the self loop)
+  bool hasOpen() const { return !live.empty() && live.back().closedAt == GDAKI_MI_OPEN; }
+};
+// The switch in d's input pause of checkpoint `ckpt` (gates odd, count 0), from the cell read now (cursor, broken): the
+// open segment is closed at the pause's ring head, or, when the live segments would be more than `slots`, every live
+// segment is dropped (the restart: the caller DISARMs d and PAUSED is not armable); then the next one opens. Returns its
+// number. A cumulative counter below the opening's value counts as a break.
+static uint64_t gdakiMiSegsSwitch(struct gdakiMiSegs& s, uint64_t ckpt, uint64_t head, uint64_t cursor, uint64_t broken,
+                                  uint64_t slots, uint64_t laneBytes, bool* restart) {
+  *restart = gdakiMiSwitchVerdict((uint32_t)s.live.size(), (uint32_t)slots) == GDAKI_MI_SW_RESTART;
+  if (*restart) {
+    s.live.clear();
+  } else if (s.hasOpen()) {
+    struct gdakiMiSeg& o = s.live.back();
+    o.cut = head;
+    o.fill = cursor < laneBytes ? cursor : laneBytes;
+    o.closedAt = ckpt;
+    o.broken = (broken >= o.brokenOpen ? broken - o.brokenOpen : 1u) + s.hostBreaks;
+  }
+  struct gdakiMiSeg n;
+  n.seg = s.lastSeg + 1u;
+  n.start = head;
+  n.brokenOpen = broken;
+  s.live.push_back(n);
+  s.lastSeg = n.seg;
+  s.hostBreaks = 0;
+  return n.seg;
+}
+// CKPT_STABLE(k) of d: every closed segment whose closing checkpoint is <= k goes. Returns how many.
+static int gdakiMiSegsStable(struct gdakiMiSegs& s, uint64_t k) {
+  int n = 0;
+  for (size_t i = 0; i < s.live.size();)
+    if (s.live[i].closedAt != GDAKI_MI_OPEN && s.live[i].closedAt <= k) {
+      s.live.erase(s.live.begin() + (long)i);
+      n++;
+    } else {
+      i++;
+    }
+  return n;
+}
+// d's INJECTED (its import used them): every closed segment goes, the open one stays. Returns how many.
+static int gdakiMiSegsDropClosed(struct gdakiMiSegs& s) { return gdakiMiSegsStable(s, GDAKI_MI_OPEN - 1u); }
+// d's buddy was restored (a new pool): every segment goes; the numbers go on.
+static void gdakiMiSegsDropAll(struct gdakiMiSegs& s) {
+  s.live.clear();
+  s.hostBreaks = 0;
+}
+// Bytes the live segments hold now (the open one's: min(cursor, L)).
+static uint64_t gdakiMiSegsLiveBytes(const struct gdakiMiSegs& s, uint64_t cursor, uint64_t laneBytes) {
+  uint64_t b = 0;
+  for (const auto& g : s.live) b += g.closedAt == GDAKI_MI_OPEN ? (cursor < laneBytes ? cursor : laneBytes) : g.fill;
+  return b;
+}
+// The view the export v2 and HOLDING read (impl/rs_mirror_api.h gdakiMiSegView): the closed segments, the open one
+// (openCursor: the cursor the host last read; openBroken: the cell's cumulative broken at its opening, to subtract from
+// the device's value now; a host-side break shows as cellValid false), the floor. False: no live segment.
+static bool gdakiMiSegsViewOf(const struct gdakiMiSegs& s, bool cellValid, uint64_t cursor, struct gdakiMiSegView* out) {
+  *out = gdakiMiSegView();
+  if (s.live.empty()) return false;
+  for (const auto& g : s.live) {
+    if (g.closedAt == GDAKI_MI_OPEN) continue;
+    out->cuts.push_back(g.cut);
+    out->segs.push_back(g.seg);
+    out->fills.push_back(g.fill);
+    out->closedAt.push_back(g.closedAt);
+    out->broken.push_back(g.broken);
+  }
+  if (s.hasOpen()) {
+    out->openSeg = s.live.back().seg;
+    out->openCursor = cursor;
+    out->openBroken = s.live.back().brokenOpen;
+  }
+  out->floor = s.live.front().start;
+  out->cellValid = cellValid;
+  return true;
+}
+
+// This rank's ledger toward one destination d: the segments, what the host last wrote into d's cell, and the switch of
+// the pause in progress (the copy a rollback restores). The host code reads and writes the cell over the NIC; these
+// functions decide what to write and keep the ledger (the unit test drives them against a model of the cell).
+struct gdakiMiLedger {
+  struct gdakiMiSegs segs;
+  bool cellValid = false;          // what the host last wrote into the cell's `valid`
+  bool pend = false;               // a switch of a pause not ended yet
+  uint64_t pendCkpt = 0;
+  struct ncclGinMiCell pendCell;   // the cell as it was before that switch (a rollback writes its first 40 bytes back)
+  struct gdakiMiSegs pendSegs;     // the segments before it
+  bool pendValid = false;          // cellValid before it
+};
+// The switch in d's pause of checkpoint `ckpt`, from the cell `c` read now: the ledger moves (the copy kept for a
+// rollback) and *w is the cell to write (its first 40 bytes: valid, rkey, segment, lane, L, cursor 0). Returns the new
+// segment number.
+static uint64_t gdakiMiLedgerSwitch(struct gdakiMiLedger& x, const struct ncclGinMiCell& c, uint64_t ckpt, uint64_t head,
+                                    bool wantValid, uint32_t rkeyBe, int wardIdx, int lane, int n, uint64_t slots,
+                                    uint64_t laneBytes, bool* restart, struct ncclGinMiCell* w) {
+  x.pend = true;
+  x.pendCkpt = ckpt;
+  x.pendCell = c;
+  x.pendSegs = x.segs;
+  x.pendValid = x.cellValid;
+  const uint64_t seg = gdakiMiSegsSwitch(x.segs, ckpt, head, c.cursor, c.broken, slots, laneBytes, restart);
+  *w = c;
+  w->valid = wantValid ? 1u : 0u;
+  w->rkeyBe = rkeyBe;
+  w->seg = seg;
+  w->laneBase = ncclGinMiLaneOff(wardIdx, seg % slots, lane, n, slots, laneBytes);
+  w->laneBytes = laneBytes;
+  w->cursor = 0;
+  return seg;
+}
+// A break the host saw (a mirror QP given up, the self loop, a cell it could not write): counted in the open segment
+// (and in the copy a rollback would restore), the cell invalid, and a rollback writes it back invalid too.
+static void gdakiMiLedgerHostBreak(struct gdakiMiLedger& x) {
+  x.segs.hostBreaks++;
+  if (x.pend) x.pendSegs.hostBreaks++;
+  x.cellValid = false;
+  x.pendCell.valid = 0;
+  x.pendValid = false;
+}
+// The switch's write: written (and read back) or not (a host break; the cell is made invalid).
+static void gdakiMiLedgerSwitchWritten(struct gdakiMiLedger& x, const struct ncclGinMiCell& w, bool ok) {
+  if (ok) x.cellValid = w.valid != 0;
+  else gdakiMiLedgerHostBreak(x);
+}
+// The end of the pause of `ckpt` (impl/rs_mirror_api.h gdakiMiSegPauseEnd): true when the caller must write pendCell's
+// first 40 bytes back (a rollback of this pause's switch); then gdakiMiLedgerRolledBack.
+static bool gdakiMiLedgerPauseEnd(struct gdakiMiLedger& x, uint64_t ckpt, bool rollback) {
+  if (!x.pend || x.pendCkpt != ckpt) return false;
+  x.pend = false;
+  return rollback;
+}
+static void gdakiMiLedgerRolledBack(struct gdakiMiLedger& x, bool ok) {
+  if (ok) {
+    x.segs = x.pendSegs;
+    x.cellValid = x.pendValid;
+  } else {
+    gdakiMiLedgerHostBreak(x);  // the new segment stays, as a switch that failed
+  }
+}
+// CKPT_STABLE(k): the closed segments up to k go, also from the copy (a rollback must not bring them back).
+static void gdakiMiLedgerStable(struct gdakiMiLedger& x, uint64_t k) {
+  (void)gdakiMiSegsStable(x.segs, k);
+  if (x.pend) (void)gdakiMiSegsStable(x.pendSegs, k);
+}
+// INJECTED of d: its closed segments go; a pause of the incarnation that died is not rolled back any more.
+static void gdakiMiLedgerDropClosed(struct gdakiMiLedger& x) {
+  (void)gdakiMiSegsDropClosed(x.segs);
+  x.pend = false;
+}
+// d's buddy restored (a new pool): every segment goes, the cell is written invalid with the new key.
+static void gdakiMiLedgerDropAll(struct gdakiMiLedger& x) {
+  gdakiMiSegsDropAll(x.segs);
+  x.pend = false;
+  x.cellValid = false;
+}
+
+// MIRROR_SETUP's connection (EXPERIMENT.md 9.2): a rank connects its mirror QP to p when its own side is on, p's first
+// record is usable (on) and the connect and the baseline succeed. A rank whose own side is on and did not connect to p
+// sends p a second record with on = 0; p, which may have connected on the first one, gives that QP up when it reads it
+// (gdakiMiPoll). So both ranks of a pair end with the same mirror QP set (the hk rounds walk the same QPs).
+static bool gdakiMiSetupConnects(bool mineOn, int recCode, bool connectOk) {
+  return mineOn && recCode == GDAKI_MI_SR_OK && connectOk;
+}
+static bool gdakiMiSetupSendsOff(bool mineOn, bool connected) { return mineOn && !connected; }
+static bool gdakiMiSetupDemotes(bool connected, uint32_t lateOn) { return connected && lateOn == 0; }
+
+// The restore round's publish word of a QP (impl/rs_hold_api.h v2): with the gates kept odd (the mirror on, a restore
+// round), the user contexts' QPs get the new epoch odd, the mirror context's QP the new epoch even; else even.
+static uint32_t gdakiMiPublishWord(bool keepOdd, int ctxIdx, int miCtx, uint32_t eNew) {
+  return (keepOdd && ctxIdx != miCtx) ? (eNew | 1u) : eNew;
+}
+
+// A fault record of the mirror context (G4, before gdakiHoldRoute): NOT_MINE (another context, or the mirror off: the
+// record goes on to gin-restore's routes), STALE (older than the QP's covered epoch: a record of an epoch a round already
+// published; only its handled epoch moves), GIVE_UP (the QP is given up).
+enum { GDAKI_MI_AB_NOT_MINE = 0, GDAKI_MI_AB_STALE = 1, GDAKI_MI_AB_GIVE_UP = 2 };
+static int gdakiMiAbsorbVerdict(bool on, int ctx, int miCtx, uint32_t recEpoch, uint32_t coveredEpoch) {
+  if (!on || miCtx < 0 || ctx != miCtx) return GDAKI_MI_AB_NOT_MINE;
+  return recEpoch < coveredEpoch ? GDAKI_MI_AB_STALE : GDAKI_MI_AB_GIVE_UP;
+}
+
+// ncclGinRestoreStep: a pending CKPT_PULL is consumed whenever a checkpoint can be asked for now (the machine idle, no
+// back-off), whether or not the interval made this Step due anyway (a pull taken by a due checkpoint is spent on it).
+static bool gdakiMiPullConsumes(bool mirrorOn, bool idle, bool retryOk) { return mirrorOn && idle && retryOk; }
+
+// INJECTED's sends (the revived rank): the survivors still to be told, retried every helper step for a bounded number of
+// steps. True when peer p is still owed one.
+static bool gdakiMiInjOwed(const std::vector<uint8_t>& sent, int p, int me, bool declined) {
+  return p != me && p >= 0 && p < (int)sent.size() && !sent[(size_t)p] && !declined;
+}
+
+// The helper's poll of d's cell (every 10 ms; impl/rs_mirror_api.h gdakiMiPoll). The cumulative broken counter moved
+// since the last read: breaks; a new burst DISARMs d once (a burst ends with a read that saw none, or with the segment).
+// The fill passed pullPct of L for the first time in this segment: CKPT_PULL (once per segment).
+struct gdakiMiPollMem {
+  bool seen = false;       // a baseline is set (the first switch sets it)
+  uint64_t broken = 0;     // the cumulative broken accounted so far
+  bool burst = false;      // the last read saw new breaks
+  uint64_t burstSeg = 0;   // in this segment
+  uint64_t pulledSeg = 0;  // CKPT_PULL went out for this segment
+};
+static void gdakiMiPollBase(struct gdakiMiPollMem& m, uint64_t broken) {
+  if (m.seen) return;
+  m.seen = true;
+  m.broken = broken;
+}
+static void gdakiMiPollStep(struct gdakiMiPollMem& m, uint64_t seg, uint64_t cursor, uint64_t broken, uint64_t laneBytes,
+                            int64_t pullPct, bool* disarm, bool* pull, uint32_t* fillPct) {
+  *disarm = *pull = false;
+  const uint64_t fill = cursor < laneBytes ? cursor : laneBytes;
+  *fillPct = laneBytes ? (uint32_t)(fill * 100u / laneBytes) : 0u;
+  gdakiMiPollBase(m, broken);
+  if (broken != m.broken) {  // a counter that went back is a break too (it never does)
+    if (!m.burst || m.burstSeg != seg) *disarm = true;
+    m.burst = true;
+    m.burstSeg = seg;
+  } else {
+    m.burst = false;
+  }
+  m.broken = broken;
+  if (pullPct > 0 && seg != 0 && m.pulledSeg != seg && fill * 100u >= (uint64_t)pullPct * laneBytes) {
+    *pull = true;
+    m.pulledSeg = seg;
+  }
+}
