+#ifdef NCCL_GIN_RESTORE_DEVICE
+// gin-mirror (dev; EXPERIMENT.md 9.2 "local 완료", 9.5 rule 12): after a flush or a wait returned success, the mirror QP
+// to buddy b up to its index now (the request keeps one QP's ticket only, so the mirror's is read here: a longer wait,
+// never an early one). One counted poll region, never parked: a closed gate, an epoch that changes, an error CQE (reported
+// once per epoch as the mirror context's, no sticky error), the QP given up meanwhile (miUse 0), a slot wait's error record
+// (swErr), a ticket past the CQ's window whose consumer index did not move for NCCL_GIN_MI_STUCK_NS (this poll never
+// moves it; only the slot waits of later posts do: a stopped index with the ticket outside the window is an error CQE
+// nobody else reports, the self loop's case), the caller's deadline (bounded, timeoutCycles not 0: since startCycle) or
+// abort word, or the mirror QP's peer word end it as a break of b's lanes. A mirror QP not in use (miUse 0) is not waited
+// for.
+#define NCCL_GIN_MI_STUCK_NS 20000000ull  // 20 ms: a healthy QP completes something in far less; a false break only DISARMs
+template <int Unused = 0>
+__device__ __noinline__ static void rsMiWait(ncclGinCtx ctx, struct ncclGinRsSide* rs, int b, uint32_t* abortFlag,
+                                             bool bounded, uint64_t startCycle, uint64_t timeoutCycles,
+                                             cuda::memory_order ord) {
+  using nccl::utility::loadConst;
+  if (b < 0 || b >= ctx.nRanks) return;
+  const uint32_t miCtx = loadConst(&rs->miCtx);
+  struct ncclGinRsQp* const mq = rsMiQpOf(rs, miCtx, (uint32_t)ctx.nRanks, b);
+  if (mq == nullptr || tsLoadRelaxedSys(&mq->miUse) == 0) return;
+  ncclGinGdakiGPUContext* const mg = &((struct ncclGinGdakiGPUContext*)ctx.handle)[miCtx];
+  doca_gpu_dev_verbs_qp* const mqp = loadConst(&mg->gdqp) + b;
+  const bool gated = tsOn(mqp);
+  uint32_t e = NCCL_GIN_TS_EPOCH_ANY;
+  if (gated && !tsPollEnter(mqp, &e)) {  // a round or a hold of b, or the QP failed: no wait, a break
+    rsMiBreakWards(rs, b, ctx.nRanks, ctx.rank, NCCL_GIN_MI_BRK_WAIT);
+    return;
+  }
+  const uint64_t n =
+    doca_gpu_dev_verbs_atomic_read<uint64_t, DOCA_GPUNETIO_VERBS_RESOURCE_SHARING_MODE_GPU>(&mqp->sq_rsvd_index);
+  struct doca_gpu_dev_verbs_cq* const cq = doca_gpu_dev_verbs_qp_get_cq_sq(mqp);
+  const uint32_t cqeNum = doca_gpu_dev_verbs_load_const(&cq->cqe_num);
+  uint64_t stuckCi = ~0ull, stuckSince = 0;  // the consumer index while the ticket was past the window, and since when
+  bool ok = n == 0;
+  uint32_t steps = 0;
+  NVCC_PRAGMA_UNROLL_DISABLED
+  while (!ok) {
+    const int st = doca_gpu_dev_verbs_poll_one_cq_at<DOCA_GPUNETIO_VERBS_RESOURCE_SHARING_MODE_GPU>(mqp, n - 1);
+    if (st == 0) {
+      ok = true;
+      break;
+    }
+    if (st < 0) {
+      struct ncclGinGdakiQ4* const q4 = loadConst(&mg->fault);
+      if (gated && q4 != nullptr && atomicMax(&tsGate(mqp)->reported, e + 2u) < e + 2u) {
+        ncclGinCtx mctx = ctx;
+        mctx.contextId = (int)miCtx;
+        q4Report(mctx, q4, mqp, b, n - 1, NCCL_GIN_Q4_KIND_ERR_CQE,
+                 bounded ? NCCL_GIN_Q4_PATH_FLUSH_TIMEOUT : NCCL_GIN_Q4_PATH_FLUSH_BLOCKING, /*sticky=*/false, e);
+      }
+      break;
+    }
+    ++steps;
+    if ((steps & 0x3ffu) == 0) {
+      if (gated && tsWordHi(tsWordLoad(tsWord(mqp))) != e) break;  // a round started
+      // the QP was given up (a fault record absorbed, miUse 0: no round follows, the epoch stays), or an error CQE was
+      // seen by a slot wait (the QP is in ERR: the ticket never completes well), or the ticket is past the CQ's window
+      // and the consumer index (stopped by an error CQE) did not move since the last check
+      if (tsLoadRelaxedSys(&mq->miUse) == 0) break;
+      if (gated && (tsLoadRelaxedSys(&tsGate(mqp)->swErr) & NCCL_GIN_TS_SWERR_VALID) != 0) break;
+      const uint64_t ci = *(volatile uint64_t*)&cq->cqe_ci;
+      if (n - 1 >= ci + cqeNum) {  // past the window: this poll cannot see the ticket until the index moves
+        const uint64_t now = tsNowNs();
+        if (ci != stuckCi) {
+          stuckCi = ci;
+          stuckSince = now;
+        } else if (now - stuckSince >= NCCL_GIN_MI_STUCK_NS) {
+          break;
+        }
+      } else {
+        stuckCi = ~0ull;
+      }
+    }
+    if (bounded && timeoutCycles != 0 && (uint64_t)clock64() - startCycle >= timeoutCycles) break;  // as tsExpired
+    if (steps % 10000u == 0) {
+      uint32_t* const pw = tsPosterAbortWord(mqp);  // b's word (a decline or the death of b)
+      if ((abortFlag != nullptr && tsLoadRelaxedSys(abortFlag) != 0) || (pw != nullptr && tsLoadRelaxedSys(pw) != 0))
+        break;
+    }
+  }
+  if (gated) tsPollLeave(mqp);
+  if (ok) cuda::atomic_thread_fence(ord, cuda::thread_scope_system);
+  else rsMiBreakWards(rs, b, ctx.nRanks, ctx.rank, NCCL_GIN_MI_BRK_WAIT);
+}
+// The mirror wait of a wait on `peer`'s request (the mirror QP to ncclGinMiTargetOf(peer): buddy(peer), or in the
+// measurement mode's arms the self loop or peer); of a flush, every mirror QP, split over the cooperating threads as the
+// flush splits the peers. One side table read and a branch when the mirror is off.
+NCCL_DEVICE_INLINE static void rsMiAfterWait(ncclGinCtx ctx, int peer, uint32_t* abortFlag, bool bounded,
+                                             uint64_t startCycle, uint64_t timeoutCycles, cuda::memory_order ord) {
+  ncclGinGdakiGPUContext* const gdaki = &((struct ncclGinGdakiGPUContext*)ctx.handle)[ctx.contextId];
+  struct ncclGinRsSide* const rs = rsSideOf(gdaki);
+  if (rs != nullptr && nccl::utility::loadConst(&rs->miOn) != 0 && peer != ctx.rank)
+    rsMiWait(ctx, rs, ncclGinMiTargetOf(nccl::utility::loadConst(&rs->miMode), peer, ctx.rank, ctx.nRanks), abortFlag,
+             bounded, startCycle, timeoutCycles, ord);
+}
+template <typename Coop>
+NCCL_DEVICE_INLINE static void rsMiAfterFlush(ncclGinCtx ctx, Coop coop, uint32_t* abortFlag, bool bounded,
+                                              uint64_t startCycle, uint64_t timeoutCycles, cuda::memory_order ord) {
+  ncclGinGdakiGPUContext* const gdaki = &((struct ncclGinGdakiGPUContext*)ctx.handle)[ctx.contextId];
+  struct ncclGinRsSide* const rs = rsSideOf(gdaki);
+  if (rs == nullptr || nccl::utility::loadConst(&rs->miOn) == 0) return;
+  for (int b = coop.thread_rank(); b < ctx.nRanks; b += coop.size())
+    rsMiWait(ctx, rs, b, abortFlag, bounded, startCycle, timeoutCycles, ord);
+}
+#endif  // NCCL_GIN_RESTORE_DEVICE
