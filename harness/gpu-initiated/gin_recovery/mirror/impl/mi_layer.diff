+// ---- teardown (gdakiCkptFree, after the helper and the data threads stopped) ----
+// The summary line, the store thread stopped, then the QPs, then every MR before its memory (9.7 "정리와 해제").
+static void gdakiStoreFree(struct gdakiRecHost* r) {
+  struct gdakiStoreState* st;
+  {
+    std::lock_guard<std::mutex> lk(gdakiStoreLifeMu);
+    st = r != nullptr ? r->mi.store : nullptr;
+    if (st == nullptr) return;
+    r->mi.store = nullptr;
+  }
+  struct gdakiCkpt* ck = gdakiCkptOf(r);
+  // tcp_image_bytes: this rank's UPLOAD bytes over the data socket; tcp_segment_bytes: no store path sends segment bytes
+  // over a socket (0 by construction, impl/notes_store.md). WARN in both builds: prediction store_rdma reads it.
+  WARN("GIN/MI: rank %d: store summary writes=%lld failed=%lld requests=%lld tcp_image_bytes=%lld "
+              "tcp_segment_bytes=0 served=%lld mono_ms=%.3f", st->me, st->nWrites.load(), st->nFailed.load(),
+              st->nRequests.load(), ck != nullptr ? ck->nUploadBytes.load() : 0LL, st->nServed.load(), gdakiQ4MonoMs());
+  {
+    std::lock_guard<std::mutex> lk(st->mu);
+    st->stop = true;
+  }
+  st->cv.notify_all();
+  if (st->th.joinable()) st->th.join();
+  gdakiMiHostQpDestroy(st->upQp);
+  st->upQp = nullptr;
+  for (auto& w : st->wards) {
+    gdakiMiHostQpDestroy(w.qp);
+    w.qp = nullptr;
+  }
+  // every MR before its memory (gdakiStoreFreeMr keeps the memory of an MR that could not be deregistered)
+  for (auto& j : st->jobs)
+    if (j.kind == GDAKI_STORE_JOB_FREE) gdakiStoreFreeMr(j.mr, j.mem);
+  for (auto& w : st->wards) {
+    gdakiStoreFreeMr(w.mr, w.mem);
+    gdakiStoreFreeMr(w.oldMr, w.oldMem);
+    for (auto& x : w.parked) gdakiStoreFreeMr(x.first, x.second);
+    w.parked.clear();
+  }
+  if (st->stageMr == nullptr || wrap_ibv_dereg_mr(st->stageMr) == ncclSuccess) {
+    if (st->stage != nullptr) (void)cudaFreeHost(st->stage);
+  } else {
+    WARN("GIN/MI: rank %d: the upload staging MR could not be deregistered; its buffer is kept mono_ms=%.3f", st->me,
+         gdakiQ4MonoMs());
+  }
+  delete st;
+}
