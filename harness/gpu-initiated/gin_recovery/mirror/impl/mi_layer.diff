+    struct gdakiMiLogXItem it;
+    it.e = x.e;
+    it.step = x.step;
+    it.seg = x.seg;
+    const char* bad = gdakiMiEntryCheck(it.e);
+    if (bad == nullptr && it.step == GDAKI_RS_STEP_UNKNOWN) bad = "its step is unknown";
+    if (bad == nullptr && gdakiMiEntryMirrored(it.e.qpKf) && it.seg == 0) bad = "its segment is 0 (below every live one)";
+    if (bad == nullptr && !gdakiMiEntryMirrored(it.e.qpKf) && it.seg != 0) bad = "a segment on an entry not mirrored";
+    if (bad != nullptr) {
+      snprintf(why, whyLen, "entry %lu: %s", (unsigned long)i, bad);
+      return false;
+    }
+    if (gdakiMiEntryMirrored(it.e.qpKf)) {
+      out->nMirror++;
+      out->mirrorBytes += it.e.bytes;
+    }
+    out->items.push_back(it);
+  }
+  if (out->nMirror != out->hdr2.nMirror || out->mirrorBytes != out->hdr2.mirrorBytes) {
+    snprintf(why, whyLen, "the export says %lu MIRROR entries of %lu bytes, its entries %lu of %lu",
+             (unsigned long)out->hdr2.nMirror, (unsigned long)out->hdr2.mirrorBytes, (unsigned long)out->nMirror,
+             (unsigned long)out->mirrorBytes);
+    return false;
+  }
+  return true;
+}
+
+// The step-aligned import's plan (EXPERIMENT.md 9.4 "단계 맞춤 가져오기"), every export checked before anything is applied:
+// gin-restore's checks (gdakiRsImportPlanOf: one export from every rank with QPs to this rank and from no other, for this
+// restore, P of each user QP, X >= P, every target inside this process's windows or signal table, 8-byte aligned signal
+// words) on the v2 exports, plus: every entry's step is above the checkpoint, every put's data is mirrored and its
+// (sender, segment, lane offset, bytes) lies in the fetched segments: fetch(sender, seg, off, bytes) returns where, or
+// null. The inputs are grouped by step, increasing; within a step the copies keep survivor rank order, then stream order,
+// and the signal additions are summed per target; a data target over a signal word of the same step is refused (the
+// order would matter). Steps differ in time, so targets may repeat across steps (the training shape's receive ring).
+struct gdakiMiImportStepPlan {
+  uint64_t step = 0;
+  std::vector<struct gdakiRsImportCopy> copies;  // data: the FETCH buffer (a put) or `value` (a putValue)
+  std::vector<struct gdakiRsImportSig> sigs;     // summed per target, (window, offset) increasing
+  uint64_t entries = 0, poolBytes = 0, valueBytes = 0, sigAdds = 0, sigSum = 0;
+};
+struct gdakiMiImportPeer {
+  int32_t rank = -1;
+  int nqp = 0;
+  uint64_t budget[NCCL_GIN_RECOVERY_MAX_QPS] = {}, x[NCCL_GIN_RECOVERY_MAX_QPS] = {}, m[NCCL_GIN_RECOVERY_MAX_QPS] = {};
+  bool mirValid = false;  // the survivor's mirror QP to this rank was in use with a valid count at its hold start
+  uint64_t mirX = 0, mirM = 0;
+  uint32_t incarnation = 0;  // the survivor's own (its rkey list's)
+  uint64_t lastStep = 0;     // its last ncclGinRestoreStep before the hold (gdakiRsLogXHdr2; diagnostic)
+  std::vector<struct gdakiRsRkeyEntry> keys;
+};
+struct gdakiMiImportPlan {
+  std::vector<struct gdakiMiImportStepPlan> steps;  // step increasing, only steps with inputs
+  std::vector<struct gdakiMiImportPeer> peers;
+  uint64_t entries = 0, nMirror = 0, mirrorBytes = 0, sigAdds = 0;
+};
+template <typename Fetch>
+static bool gdakiMiImportPlanOf(int me, uint64_t ckpt, uint32_t incarnation, uint64_t nonce, const int* nqpOf, int nranks,
+                                const struct gdakiRsImportP* pp, int nP, const std::vector<std::vector<uint8_t>>& exports,
+                                const struct gdakiRsImportWin* wins, int nWins, uint64_t sigBytes, Fetch fetch,
+                                struct gdakiMiImportPlan* out, char* why, size_t whyLen) {
+  *out = gdakiMiImportPlan();
+  if ((int)exports.size() > nranks) {
+    snprintf(why, whyLen, "%zu exports for %d ranks", exports.size(), nranks);
+    return false;
+  }
+  for (int i = 0; i < nWins; i++)
+    for (int j = 0; j < i; j++)
+      if (wins[i].id == wins[j].id) {
+        snprintf(why, whyLen, "two windows numbered %u", wins[i].id);
+        return false;
+      }
+  auto winBytes = [&](uint32_t id, uint64_t* bytes) {
+    for (int i = 0; i < nWins; i++)
+      if (wins[i].id == id) {
+        *bytes = wins[i].bytes;
+        return true;
+      }
+    return false;
+  };
+  std::vector<struct gdakiMiImportStepPlan> sps;              // step increasing
+  std::vector<std::vector<struct gdakiRsImportSig>> sigOf;    // sps[i]'s every addition, merged at the end
+  auto stepAt = [&](uint64_t s) -> struct gdakiMiImportStepPlan& {
+    size_t i = 0;
+    while (i < sps.size() && sps[i].step < s) i++;
+    if (i == sps.size() || sps[i].step != s) {
+      sps.insert(sps.begin() + (long)i, gdakiMiImportStepPlan());
+      sps[i].step = s;
+      sigOf.insert(sigOf.begin() + (long)i, std::vector<struct gdakiRsImportSig>());
+    }
+    return sps[i];
+  };
+  auto sigsOf = [&](uint64_t s) -> std::vector<struct gdakiRsImportSig>& {
+    size_t i = 0;
+    while (sps[i].step != s) i++;  // stepAt(s) made it
+    return sigOf[i];
+  };
+  for (int q = 0; q < nranks; q++) {
+    const bool has = q < (int)exports.size() && !exports[(size_t)q].empty();
+    const int nq = q == me ? 0 : nqpOf[q];
+    if (nq <= 0) {
+      if (has) {
+        snprintf(why, whyLen, "an export from rank %d, which has no QP to this rank", q);
+        return false;
+      }
+      continue;
+    }
+    if (!has) {
+      snprintf(why, whyLen, "no log export from rank %d", q);
+      return false;
+    }
+    struct gdakiMiLogXParsed px;
+    char pw[200];
+    if (!gdakiMiLogXParse(exports[(size_t)q].data(), exports[(size_t)q].size(), &px, pw, sizeof(pw))) {
+      snprintf(why, whyLen, "rank %d's export: %s", q, pw);
+      return false;
+    }
+    const struct gdakiRsLogXHdr& h = px.hdr;
+    if (h.from != q || h.to != me || h.ckpt != ckpt || h.incarnation != incarnation || h.nonce != nonce ||
+        (int)h.nqp != nq) {
+      snprintf(why, whyLen, "rank %d's export is not for this restore (from %d, to %d, checkpoint %lu, incarnation %u, nqp "
+               "%u; expected %d, %d, %lu, %u, %d; nonce %s)", q, h.from, h.to, (unsigned long)h.ckpt, h.incarnation, h.nqp,
+               q, me, (unsigned long)ckpt, incarnation, nq, h.nonce == nonce ? "matches" : "differs");
+      return false;
+    }
+    const struct gdakiRsImportP* P = nullptr;
+    for (int i = 0; i < nP; i++)
+      if (pp[i].rank == q) {
+        if (P != nullptr) {
+          snprintf(why, whyLen, "two P records for rank %d", q);
+          return false;
+        }
+        P = &pp[i];
+      }
+    if (P == nullptr || (int)P->nqp != nq || P->p == nullptr) {
+      snprintf(why, whyLen, "no P of rank %d's %d QPs in the checkpoint", q, nq);
+      return false;
+    }
+    struct gdakiMiImportPeer pe;
+    pe.rank = q;
+    pe.nqp = nq;
+    for (int k = 0; k < nq; k++) {
+      if (!gdakiRsBudgetOf(h.x[k], P->p[k], &pe.budget[k])) {
+        snprintf(why, whyLen, "rank %d qp %d: executed %lu at the hold start, %lu at the checkpoint", q, k,
+                 (unsigned long)h.x[k], (unsigned long)P->p[k]);
+        return false;
+      }
+      pe.x[k] = h.x[k];
+      pe.m[k] = h.m[k];
+    }
+    pe.mirValid = px.hdr2.mirValid != 0;
+    pe.mirX = px.hdr2.mirX;
+    pe.mirM = px.hdr2.mirM;
+    pe.incarnation = px.rk.incarnation;
+    pe.lastStep = px.hdr2.lastStep;
+    pe.keys = px.keys;
+    for (size_t i = 0; i < px.items.size(); i++) {
+      const struct gdakiMiLogXItem& it = px.items[i];
+      const struct ncclGinRsLogEntry& e = it.e;
+      if (it.step <= ckpt) {
+        snprintf(why, whyLen, "rank %d's entry %zu: its step %lu is not after the checkpoint %lu", q, i,
+                 (unsigned long)it.step, (unsigned long)ckpt);
+        return false;
+      }
+      struct gdakiMiImportStepPlan& sp = stepAt(it.step);
+      const uint32_t kind = ncclGinRsEntryKind(e.qpKf);
+      uint64_t size = 0;
+      if (kind == NCCL_GIN_RS_LOG_PUT || kind == NCCL_GIN_RS_LOG_PUTVALUE) {
+        if (!winBytes(e.dstWin, &size) || !gdakiRsImportRange(e.dstOff, e.bytes, size)) {
+          snprintf(why, whyLen, "rank %d's entry %zu: window %u offset %lu, %lu bytes is not a window of this process", q, i,
+                   e.dstWin, (unsigned long)e.dstOff, (unsigned long)e.bytes);
+          return false;
+        }
+        if (e.bytes != 0) {
+          struct gdakiRsImportCopy c;
+          c.win = e.dstWin;
+          c.off = e.dstOff;
+          c.bytes = e.bytes;
+          c.data = nullptr;
+          c.value = 0;
+          if (kind == NCCL_GIN_RS_LOG_PUT) {  // mirrored (gdakiMiEntryCheck): its bytes in the fetched segment
+            c.data = fetch(q, it.seg, gdakiMiEntryLaneOff(e), e.bytes);
+            if (c.data == nullptr) {
+              snprintf(why, whyLen, "rank %d's entry %zu: segment %lu, lane offset %lu, %lu bytes are not in the fetched "
+                       "segments", q, i, (unsigned long)it.seg, (unsigned long)gdakiMiEntryLaneOff(e),
+                       (unsigned long)e.bytes);
+              return false;
+            }
+            sp.poolBytes += e.bytes;
+            out->nMirror++;
+            out->mirrorBytes += e.bytes;
+          } else {
+            c.value = e.src;
+            sp.valueBytes += e.bytes;
+          }
+          sp.copies.push_back(c);
+        }
+      }
+      if (ncclGinRsEntryFlags(e.qpKf) & NCCL_GIN_RS_LOGF_SIGNAL) {
+        if (e.sigWin == 0) size = sigBytes;
+        else if (!winBytes(e.sigWin, &size)) size = 0;
+        if ((e.sigOff & 7) != 0 || !gdakiRsImportRange(e.sigOff, 8, size)) {
+          snprintf(why, whyLen, "rank %d's entry %zu: signal %s %u offset %lu is not in this process", q, i,
+                   e.sigWin ? "window" : "table", e.sigWin, (unsigned long)e.sigOff);
+          return false;
+        }
+        sigsOf(it.step).push_back({e.sigWin, e.sigOff, e.sigVal});
+        sp.sigAdds++;
+        sp.sigSum += e.sigVal;
+        out->sigAdds++;
+      }
+      sp.entries++;
+      out->entries++;
+    }
+    out->peers.push_back(pe);
+  }
+  for (size_t si = 0; si < sps.size(); si++) {
+    struct gdakiMiImportStepPlan& sp = sps[si];
+    std::vector<struct gdakiRsImportSig>& sig = sigOf[si];
+    std::stable_sort(sig.begin(), sig.end(), [](const struct gdakiRsImportSig& a, const struct gdakiRsImportSig& b) {
+      return a.win != b.win ? a.win < b.win : a.off < b.off;
+    });
+    std::vector<struct gdakiRsImportCopy> byWin(sp.copies);
+    std::sort(byWin.begin(), byWin.end(), [](const struct gdakiRsImportCopy& a, const struct gdakiRsImportCopy& b) {
+      return a.win != b.win ? a.win < b.win : a.off < b.off;
+    });
+    size_t c = 0;
+    uint64_t reach = 0;  // the furthest end of this window's data ranges seen so far (gdakiRsImportPlanOf's pass)
+    uint32_t win = 0;
+    bool any = false;
+    for (const auto& g : sig) {
+      if (!any || g.win != win) {
+        win = g.win;
+        reach = 0;
+        any = true;
+        while (c < byWin.size() && byWin[c].win < win) c++;
+      }
+      while (c < byWin.size() && byWin[c].win == win && byWin[c].off < g.off + 8) {
+        reach = std::max<uint64_t>(reach, byWin[c].off + byWin[c].bytes);
+        c++;
+      }
+      if (reach > g.off) {
+        snprintf(why, whyLen, "step %lu: a put's target overlaps the signal word at window %u offset %lu",
+                 (unsigned long)sp.step, g.win, (unsigned long)g.off);
+        return false;
+      }
+    }
+    for (const auto& s : sig) {
+      if (!sp.sigs.empty() && sp.sigs.back().win == s.win && sp.sigs.back().off == s.off) sp.sigs.back().add += s.add;
+      else sp.sigs.push_back(s);
+    }
+  }
+  out->steps = std::move(sps);
+  return true;
+}
+// The CPU-side check of the signal additions (as gdakiRsImportSigCheck, per step): every export parsed again and its
+// signal values summed by (step, target) in a second pass; each step's plan must add exactly those, targets in strictly
+// increasing order, no step or target missing or extra; *total: every signal entry's value summed (mod 2^64).
+static bool gdakiMiImportSigCheck(const std::vector<std::vector<uint8_t>>& exports, const struct gdakiMiImportPlan& plan,
+                                  uint64_t* total, char* why, size_t whyLen) {
+  struct T {
+    uint64_t step;
+    uint32_t win;
+    uint64_t off, add;
+  };
+  std::vector<struct T> all;
+  uint64_t sum = 0;
+  for (size_t q = 0; q < exports.size(); q++) {
+    if (exports[q].empty()) continue;
+    struct gdakiMiLogXParsed px;
+    char pw[200];
+    if (!gdakiMiLogXParse(exports[q].data(), exports[q].size(), &px, pw, sizeof(pw))) {
+      snprintf(why, whyLen, "rank %zu's export: %s", q, pw);
+      return false;
+    }
+    for (const auto& it : px.items)
+      if (ncclGinRsEntryFlags(it.e.qpKf) & NCCL_GIN_RS_LOGF_SIGNAL) {
+        all.push_back({it.step, it.e.sigWin, it.e.sigOff, it.e.sigVal});
+        sum += it.e.sigVal;
+      }
+  }
+  std::sort(all.begin(), all.end(), [](const struct T& a, const struct T& b) {
+    return a.step != b.step ? a.step < b.step : a.win != b.win ? a.win < b.win : a.off < b.off;
+  });
+  if ((uint64_t)all.size() != plan.sigAdds) {
+    snprintf(why, whyLen, "%zu signal entries, the plan counted %lu", all.size(), (unsigned long)plan.sigAdds);
+    return false;
+  }
+  size_t i = 0;
+  uint64_t planSum = 0;
+  for (const auto& sp : plan.steps) {
+    if (i < all.size() && all[i].step < sp.step) {  // a step with signals the plan has none of
+      snprintf(why, whyLen, "step %lu has a signal entry but no addition in the plan", (unsigned long)all[i].step);
+      return false;
+    }
+    for (size_t k = 0; k < sp.sigs.size(); k++) {
+      const struct gdakiRsImportSig& t = sp.sigs[k];
+      planSum += t.add;
+      if (k > 0 && !(sp.sigs[k - 1].win < t.win || (sp.sigs[k - 1].win == t.win && sp.sigs[k - 1].off < t.off))) {
+        snprintf(why, whyLen, "step %lu: the plan's signal targets are not in strictly increasing order at %zu",
+                 (unsigned long)sp.step, k);
+        return false;
+      }
+      uint64_t got = 0;
+      size_t n = 0;
+      for (; i < all.size() && all[i].step == sp.step && all[i].win == t.win && all[i].off == t.off; i++, n++)
+        got += all[i].add;
+      if (n == 0 || got != t.add) {
+        snprintf(why, whyLen, "step %lu signal window %u offset %lu: the plan adds %lu, its %zu entries %lu",
+                 (unsigned long)sp.step, t.win, (unsigned long)t.off, (unsigned long)t.add, n, (unsigned long)got);
+        return false;
+      }
+    }
+    if (i < all.size() && all[i].step == sp.step) {
+      snprintf(why, whyLen, "step %lu signal window %u offset %lu has entries but no addition in the plan",
+               (unsigned long)sp.step, all[i].win, (unsigned long)all[i].off);
+      return false;
+    }
+  }
+  if (i != all.size()) {
+    snprintf(why, whyLen, "step %lu has signal entries but no addition in the plan", (unsigned long)all[i].step);
+    return false;
+  }
+  if (planSum != sum) {
+    snprintf(why, whyLen, "the plan adds %lu in total, the entries %lu", (unsigned long)planSum, (unsigned long)sum);
+    return false;
+  }
+  *total = sum;
+  return true;
+}
+// The pacing (EXPERIMENT.md 9.4): Resume injects the queued steps up to ckpt + 1, ncclGinRestoreStep(t) the queued steps
+// up to t + 1 (in order, so a skipped Step loses nothing), before it returns. The steps to inject at a call that allows
+// up to `upTo`: [next, end) of the queued steps (their numbers increasing). INJECTED names the last step of the restore:
+// the last queued step, or ckpt + 1 when nothing after it is queued.
+static size_t gdakiMiPaceEnd(const std::vector<uint64_t>& steps, size_t next, uint64_t upTo) {
+  size_t e = next;
+  while (e < steps.size() && steps[e] <= upTo) e++;
+  return e;
+}
+static uint64_t gdakiMiPaceLast(const std::vector<uint64_t>& steps, uint64_t ckpt) {
+  return !steps.empty() && steps.back() > ckpt + 1 ? steps.back() : ckpt + 1;
+}
+// A survivor's rkey against the value this process has for it (impl/rs_spare_api.h v2): a survivor of incarnation 0 keeps
+// the recorded (replayed) value, a difference is a WARN; one restored before (incarnation above 0) gets the list's value.
+// The integration (2026-10-15): the one rule of the restore path; the spare branch's gdakiMiRkeyMerge states the same
+// rule (coverage included: incarnation 0 WARN, above 0 refused) and its unit test checks it.
+enum { GDAKI_MI_RKEY_SAME = 0, GDAKI_MI_RKEY_WRITE = 1, GDAKI_MI_RKEY_WARN = 2 };
+static int gdakiMiRkeyVerdict(uint32_t survivorInc, uint32_t haveBe, uint32_t listBe) {
+  if (haveBe == listBe) return GDAKI_MI_RKEY_SAME;
+  return survivorInc > 0 ? GDAKI_MI_RKEY_WRITE : GDAKI_MI_RKEY_WARN;
+}
