+// ---- the mirror context (ncclGinGdakiCreateContext) ----
+// Whether this context gets the mirror context: asked, transparent recovery's variables, no companion QPs (transparent
+// recovery has none), rank stride 1, this library's GPU context version, at most GDAKI_MI_MAX_USER_CTX user contexts.
+struct gdakiMiPlan {
+  bool asked = false, create = false;
+  char why[160] = {0};
+};
+static struct gdakiMiPlan gdakiMiPlanOf(int nUserCtx, bool needCompanion, int rankStride, int backendVersion) {
+  struct gdakiMiPlan p;
+  p.asked = gdakiMiAsked() && ncclGinFaultUserCtx;
+  if (!p.asked) return p;
+  if (!(ncclParamGinFaultRecovery() && ncclParamGinFaultTransparent()))
+    snprintf(p.why, sizeof(p.why), "transparent recovery's variables are off");
+  else if (needCompanion)
+    snprintf(p.why, sizeof(p.why), "the context has counter (companion) QPs");
+  else if (rankStride != 1)
+    snprintf(p.why, sizeof(p.why), "the GIN rank stride is %d", rankStride);
+  else if (backendVersion != NCCL_GIN_GDAKI_GPU_CONTEXT_VERSION)
+    snprintf(p.why, sizeof(p.why), "the program's GPU context version is %d", backendVersion);
+  else if (nUserCtx > GDAKI_MI_MAX_USER_CTX)
+    snprintf(p.why, sizeof(p.why), "%d user GIN contexts; at most %d with the mirror (its index must be a bit of a round's "
+             "scope mask)", nUserCtx, GDAKI_MI_MAX_USER_CTX);
+  else
+    p.create = true;
+  return p;
+}
+static void gdakiMiPoolFree(struct gdakiMiPool* p) {
+  if (p == nullptr) return;
+  if (p->mr != nullptr) (void)wrap_ibv_dereg_mr(p->mr);
+  free(p->mem);
+  delete p;
+}
+// The pool: page-aligned host memory registered in the GIN PD, zero based (iova 0: a remote address is the offset in the
+// pool), local write, remote write and remote read (the drain's fence, the FETCH), no relaxed ordering; not gdakiRegMr
+// (its dmabuf path is for GPU memory).
+static struct gdakiMiPool* gdakiMiPoolCreate(struct ibv_pd* pd, uint64_t bytes, char* why, size_t whyLen) {
+  const size_t pg = (size_t)sysconf(_SC_PAGESIZE);
+  struct gdakiMiPool* p = new gdakiMiPool();
+  p->bytes = (size_t)((bytes + pg - 1) / pg * pg);
+  if (posix_memalign(&p->mem, pg, p->bytes) != 0) {
+    p->mem = nullptr;
+    snprintf(why, whyLen, "no %zu bytes of host memory", p->bytes);
+    delete p;
+    return nullptr;
+  }
+  if (wrap_ibv_reg_mr_iova2(&p->mr, pd, p->mem, p->bytes, 0,
+                            IBV_ACCESS_LOCAL_WRITE | IBV_ACCESS_REMOTE_WRITE | IBV_ACCESS_REMOTE_READ) != ncclSuccess ||
+      p->mr == nullptr) {
+    snprintf(why, whyLen, "ibv_reg_mr_iova2 of %zu bytes failed (errno %d)", p->bytes, errno);
+    p->mr = nullptr;
+    gdakiMiPoolFree(p);
+    return nullptr;
+  }
+  return p;
+}
+// The context's destroy takes the pool before gdakiRecFree and frees it after the QPs (no late WRITE lands in freed
+// memory); the pointer stays readable until gdakiMiFree (the helper is stopped by then).
+static struct gdakiMiPool* gdakiMiTakePool(struct gdakiRecHost* r) {
+  if (r == nullptr || r->mi.host == nullptr) return nullptr;
+  r->mi.host->poolTaken = true;
+  return r->mi.host->pool;
+}
+// After the user contexts' connects and self loops (single thread): the host state, the mirror QPs' rec entries (unused
+// until MIRROR_SETUP connects them; a spare's at its setup), the self loop pair, the pool. Nothing here fails the context:
+// a failure is a Resume condition (35, 38).
+static void gdakiMiContextSetup(struct gdaki_context* g, const struct gdakiMiPlan& plan, int nUserCtx, int nqpsForComm,
+                                struct ibv_pd* pd) {
+  struct gdakiRecHost* r = g->rec;
+  if (r == nullptr || !plan.asked) return;
+  struct gdakiMiHost* m = new gdakiMiHost();
+  r->mi.host = m;
+  const int n = r->nranks, me = g->rank;
+  m->asked = true;
+  m->created = plan.create;
+  m->ctx = nUserCtx;
+  m->nUserCtx = nUserCtx;
+  snprintf(m->notWhy, sizeof(m->notWhy), "%s", plan.why);
+  m->conf = gdakiMiConfNow();
+  m->nWards = ncclGinMiWardsOf(me, n, m->wards);
+  m->confOk = gdakiMiConfOk(m->conf, m->nWards, n, &m->poolBytes, m->confWhy, sizeof(m->confWhy));
+  m->connected.assign((size_t)n, 0);
+  m->poolRkey.assign((size_t)n, 0);
+  m->givenUp.assign((size_t)n, 0);
+  m->restoredPad.assign((size_t)n, 0);
+  m->dest.resize((size_t)n);
+  m->measureArm = gdakiMiMeasureArm();
+  if (m->created) {
+    for (int p = 0; p < n; p++) {
+      if (p == me) continue;
+      struct gdakiRecQp& rq = r->qps[(size_t)(nUserCtx * n + p)];
+      rq.used = false;
+      rq.ctxIdx = nUserCtx;
+      rq.peer = p;
+      rq.qpIdx = nUserCtx * n + p;
+      rq.exch = r->qps[(size_t)p].exch;  // the peer's context 0: the same port (LID, GID, MTU, ordering); QPN: MIRROR_SETUP
+      rq.exch.qpn = 0;
+      rq.lag = r->qps[(size_t)p].lag;
+    }
+    // the self loop pair (the mirror WRITEs of a destination whose buddy is this rank), as the user contexts' pairs
+    struct doca_gpu_verbs_qp_hl* a = g->gqps[nUserCtx * n + me];
+    struct doca_gpu_verbs_qp_hl* b = g->gqps[nqpsForComm + nUserCtx];
+    struct gdaki_exch_info x;
+    gdakiFillExchInfo(&x, g, b);
+    bool ok = gdakiConnectQp(g, a, &x) == ncclSuccess;
+    gdakiFillExchInfo(&x, g, a);
+    ok = ok && gdakiConnectQp(g, b, &x) == ncclSuccess;
+    m->selfOk = ok;
+    // integration (impl/notes_spare.md gap 9): the responder's MSN now, before any mirror WRITE (the drain counts from it)
+    m->selfBaseOk = ok && doca_verbs_qp_query_seq(b->qp, &m->selfBase, nullptr, nullptr, nullptr) == DOCA_SUCCESS;
+    m->selfOk = m->selfBaseOk;  // a self loop without its base cannot be drained (Resume condition 38 then refuses)
+    if (m->confOk) {
+      if (m->nWards == 0 || m->poolBytes == 0) {
+        m->poolOk = true;  // no ward: no pool
+      } else {
+        m->pool = gdakiMiPoolCreate(pd, m->poolBytes, m->poolWhy, sizeof(m->poolWhy));
+        m->poolOk = m->pool != nullptr;
+        if (m->pool) m->ownRkey = m->pool->mr->rkey;
+      }
+    }
+  }
+  GIN_TS_NOTE("GIN/MI: rank %d: mirror context %s ctx=%d wards=%d slots=%lld lane=%lld pool_bytes=%llu pool=%s self_loop=%s"
+              "%s%s%s%s mono_ms=%.3f", me, m->created ? "created" : "not created", nUserCtx, m->nWards,
+              (long long)m->conf.slots, (long long)m->conf.lane, (unsigned long long)m->poolBytes,
+              m->pool ? "registered" : m->poolOk ? "none" : "failed", m->selfOk ? "connected" : "no",
+              m->created ? "" : " why=", m->created ? "" : m->notWhy, m->confOk ? "" : " conf=",
+              m->confOk ? "" : m->confWhy, gdakiQ4MonoMs());
+  if (m->created && m->confOk && !m->poolOk)
+    WARN("GIN/MI: rank %d: the mirror pool could not be registered (%s)", me, m->poolWhy);
+}
+
+// ---- the setup: the agreement (ts nullptr) and MIRROR_SETUP (gdakiTsSetup, before the helper starts) ----
+static void gdakiMiSetupEnd(struct gdakiRecHost* r, struct gdakiTs* ts, bool agreed, bool replay) {
+  struct gdakiMiHost* m = r != nullptr ? r->mi.host : nullptr;
+  if (m == nullptr) return;
+  m->agreed = agreed;
+  m->replay = replay;
+  if (ts == nullptr) return;
+  r->mi.on = agreed && m->created;
+  r->mi.ctx = r->mi.on ? m->ctx : -1;
+  struct gdaki_context* g = r->ctx;
+  const int n = r->nranks, me = g->rank, c = m->ctx;
+  if (!r->mi.on) {
+    GIN_TS_NOTE("GIN/MI: rank %d: the mirror is off on this context (%s) mono_ms=%.3f", me,
+                !agreed ? "the setup agreement turned it off" : m->notWhy, gdakiQ4MonoMs());
+    return;
+  }
+  int gated = 0, nConn = 0;
+  for (int p = 0; p < n; p++)
+    if (p != me && ts->peers[p].gated) gated++;
+  if (replay) {  // its mirror QPs connect at the REJOIN (TOKEN's QPNs), its survivors' pool keys come from STATE
+    for (int p = 0; p < n; p++)
+      if (p != me && ts->peers[p].gated) r->qps[(size_t)(c * n + p)].used = true;
+    m->peersOk = true;
+    GIN_TS_NOTE("GIN/MI: rank %d: the mirror is on (spare: %d mirror QP(s) connect at the REJOIN) mono_ms=%.3f", me, gated,
+                gdakiQ4MonoMs());
+    return;
+  }
+  // this rank's records first, to every peer, then every peer's (each rank sends before it reads: no wait cycle)
+  const bool mineOn = m->confOk && m->poolOk;
+  auto sendSetup = [&](int p, bool on) -> bool {
+    if (ts->peers[p].fd < 0) return false;
+    struct gdakiMiSetup s;
+    memset(&s, 0, sizeof(s));
+    s.version = GDAKI_MI_WIRE_VERSION;
+    s.on = on ? 1u : 0u;
+    s.qpn = gdakiRecQpn(g->gqps[c * n + p]);
+    s.sqPsn = 0;  // the connect-time send PSN (gdakiConnectQp's)
+    s.poolRkey = m->ownRkey;
+    s.slots = (uint32_t)m->conf.slots;
+    s.laneBytes = (uint64_t)m->conf.lane;
+    s.poolBytes = m->poolBytes;
+    s.nWards = (uint32_t)m->nWards;
+    struct gdakiTsMsg x;
+    memset(&x, 0, sizeof(x));
+    x.type = GDAKI_TS_MI_SETUP;
+    x.from = me;
+    x.arg = me;
+    x.nqp = 1;
+    x.nonce = ts->nonce;
+    memcpy(x.executed, &s, sizeof(s));
+    return gdakiTsSend(ts->peers[p].fd, &x, ts->handshakeMs) == 0;
+  };
+  for (int p = 0; p < n; p++) {
+    if (p == me || !ts->peers[p].gated) continue;
+    if (!sendSetup(p, mineOn) && m->peersWhy[0] == '\0')
+      snprintf(m->peersWhy, sizeof(m->peersWhy), "MIRROR_SETUP could not be sent to rank %d", p);
+  }
+  const double deadline = gdakiQ4MonoMs() + (double)ts->handshakeMs;
+  for (int p = 0; p < n; p++) {
+    if (p == me || !ts->peers[p].gated) continue;
+    struct gdakiTsPeer& pe = ts->peers[p];
+    struct gdakiTsMsg in;
+    const int rem = (int)(deadline - gdakiQ4MonoMs());
+    const int got = pe.fd >= 0 ? gdakiTsRecv(pe, &in, std::max(1, rem), &ts->stop) : -1;
+    char w[128] = {0};
+    if (got != 1) {
+      snprintf(w, sizeof(w), "rank %d: %s", p, got == 0 ? "no MIRROR_SETUP within NCCL_GIN_TS_HANDSHAKE_MS"
+                                                         : "the helper socket ended before MIRROR_SETUP");
+    } else {
+      struct gdakiMiSetup s;
+      memcpy(&s, in.executed, sizeof(s));
+      const int code = gdakiMiSetupRecCheck(in.type, in.from, in.arg, in.nonce, p, ts->nonce, s);
+      if (in.type == GDAKI_TS_BYE) pe.left = true;  // as the idle loop: its FIN that follows is not death
+      if (code != GDAKI_MI_SR_OK) {
+        snprintf(w, sizeof(w), "rank %d: %s", p, gdakiMiSetupRecWhy(code));
+        if (code == GDAKI_MI_SR_TYPE)
+          WARN("GIN/MI: rank %d: %s from rank %d instead of MIRROR_SETUP; dropped", me, gdakiTsMsgName(in.type), p);
+      } else {
+        m->poolRkey[(size_t)p] = s.poolRkey;
+        if (mineOn) {  // both records on: both ranks connect (a rank whose own side is off connects none)
+          const int qi = c * n + p;
+          struct gdakiRecQp& rq = r->qps[(size_t)qi];
+          struct gdaki_exch_info x = r->qps[(size_t)p].exch;
+          x.qpn = (int)s.qpn;
+          uint32_t rmsn = 0;
+          bool ok = false;
+          if (gdakiConnectQp(g, g->gqps[qi], &x, r->qps[(size_t)p].lag, s.sqPsn, 0) != ncclSuccess)
+            snprintf(w, sizeof(w), "rank %d: its mirror QP could not be connected", p);
+          else if (doca_verbs_qp_query_seq(g->gqps[qi]->qp, &rmsn, nullptr, nullptr, nullptr) != DOCA_SUCCESS)
+            snprintf(w, sizeof(w), "rank %d: QUERY_QP failed after the connect (no baseline)", p);
+          else
+            ok = true;
+          if (gdakiMiSetupConnects(mineOn, code, ok)) {
+            ts->qs[(size_t)qi].rmsn0 = rmsn;  // the responder baseline (the log's count starts there)
+            gdakiRsExecRebase(r, qi, rmsn);   // no log yet: nothing
+            rq.used = true;
+            rq.exch = x;
+            m->connected[(size_t)p] = 1;
+            nConn++;
+          }
+        }
+      }
+    }
+    if (w[0] != '\0' && m->peersWhy[0] == '\0') snprintf(m->peersWhy, sizeof(m->peersWhy), "%s", w);
+  }
+  // a pair stays symmetric: a peer this rank did not connect to may have connected on this rank's first record; a second
+  // record with on = 0 makes it give that QP up (gdakiMiPoll). Not sent: that peer's socket failed (Resume refuses: 38).
+  int nOff = 0;
+  for (int p = 0; p < n; p++)
+    if (p != me && ts->peers[p].gated && gdakiMiSetupSendsOff(mineOn, m->connected[(size_t)p] != 0) && sendSetup(p, false))
+      nOff++;
+  m->peersOk = mineOn && nConn == gated && m->peersWhy[0] == '\0';
+  GIN_TS_NOTE("GIN/MI: rank %d: the mirror is on: MIRROR_SETUP peers=%d connected=%d off_sent=%d pool_bytes=%llu "
+              "pool_rkey=%#x wards=%d slots=%lld lane=%lld%s%s mono_ms=%.3f", me, gated, nConn, nOff,
+              (unsigned long long)m->poolBytes,
+              m->ownRkey, m->nWards, (long long)m->conf.slots, (long long)m->conf.lane, m->peersOk ? "" : " why=",
+              m->peersOk ? "" : (m->peersWhy[0] ? m->peersWhy : "this rank's own side is off"), gdakiQ4MonoMs());
+}
+
+// ---- Resume's facts (ncclGinRestoreResume, under gdakiRecRegMu; fields fixed before the helper started) ----
+static void gdakiMiResumeFacts(struct gdakiRecHost* r, bool spare, struct gdakiRsLocalIn* in, struct gdakiRsXRec* x,
+                               char* ctxWhy, char* poolWhy, char* confWhy, char* peersWhy, size_t whyLen) {
+  in->miAsked = gdakiMiAsked();
+  x->miReq = in->miAsked ? 1u : 0u;
+  if (!in->miAsked) return;
+  const struct gdakiMiConf c = gdakiMiConfNow();
+  x->miSlots = (uint32_t)c.slots;
+  x->miLane = (uint64_t)c.lane;
+  in->miSpare = spare;
+  in->miCsum = gdakiRsCsumScheme() != NCCL_GIN_RS_CSUM_OFF;
+  struct gdakiMiHost* m = r != nullptr ? r->mi.host : nullptr;
+  if (m == nullptr) {  // no context of this communicator with transparent recovery: an earlier condition refuses
+    in->miAgreed = false;
+    in->miCtxOk = false;
+    snprintf(ctxWhy, whyLen, "no mirror state on this rank's context");
+    in->miCtxWhy = ctxWhy;
+    return;
+  }
+  in->miAgreed = m->agreed;
+  in->miCtxOk = m->created;
+  snprintf(ctxWhy, whyLen, "%s", m->notWhy);
+  in->miCtxWhy = ctxWhy;
+  in->miConfOk = m->confOk;
+  snprintf(confWhy, whyLen, "%s", m->confWhy);
+  in->miConfWhy = confWhy;
+  in->miPoolOk = m->poolOk;
+  snprintf(poolWhy, whyLen, "%s", m->poolWhy[0] ? m->poolWhy : "not registered");
+  in->miPoolWhy = poolWhy;
+  in->miPeersOk = m->peersOk;
+  snprintf(peersWhy, whyLen, "%s", m->peersWhy[0] ? m->peersWhy : "this rank's own side is off");
+  in->miPeersWhy = peersWhy;
+  in->miSelfOk = m->selfOk;
+}
+
+// ---- the side table's mirror fields over the NIC copy path (helper; the side table is dev's, impl/rs_mirror_api.h) ----
+static bool gdakiMiSide(struct gdakiRecHost* r) {
+  struct gdakiMiHost* m = r->mi.host;
+  if (m->sideOk) return true;
+  if (m->sideBad || !r->rsPtrSet || !r->rsLbOk || !gdakiLbOn(r)) return false;
+  struct ncclGinRsSide h;
+  if (!gdakiRsReadSide(r, &h, nullptr)) return false;
+  const uint64_t qpEnd = sizeof(struct ncclGinRsSide) + sizeof(struct ncclGinRsQp) * (uint64_t)r->rsNqp;
+  const uint64_t cellsEnd = h.miCellsOff + sizeof(struct ncclGinMiCell) * (uint64_t)r->nranks;
+  if (h.magic != NCCL_GIN_RS_SIDE_MAGIC || h.miOn != 1u || (int)h.miCtx != r->mi.ctx ||
+      h.miNCells != (uint32_t)r->nranks || h.miCellsOff < qpEnd || cellsEnd > (uint64_t)r->rsBytes ||
+      (uint64_t)ncclGinMiQpIdx((uint32_t)r->mi.ctx, (uint32_t)r->nranks, (uint32_t)(r->nranks - 1)) >= (uint64_t)r->rsNqp) {
+    m->sideBad = true;
+    WARN("GIN/MI: rank %d: the side table's mirror fields do not hold together (magic %#x, miOn %u, miCtx %u, miNCells %u, "
+         "miCellsOff %lu); the mirror stays unused on this rank", r->ctx->rank, h.magic, h.miOn, h.miCtx, h.miNCells,
+         (unsigned long)h.miCellsOff);
+    return false;
+  }
+  m->cellsOff = h.miCellsOff;
+  m->sideOk = true;
+  return true;
+}
+static uint8_t* gdakiMiCellDev(struct gdakiRecHost* r, int d) {
+  return (uint8_t*)r->rsBase + r->mi.host->cellsOff + sizeof(struct ncclGinMiCell) * (size_t)d;
+}
+static uint8_t* gdakiMiQpUseDev(struct gdakiRecHost* r, int qpIdx) {
+  return (uint8_t*)r->rsBase + sizeof(struct ncclGinRsSide) + sizeof(struct ncclGinRsQp) * (size_t)qpIdx +
+         offsetof(struct ncclGinRsQp, miUse);
+}
+static bool gdakiMiCellRead(struct gdakiRecHost* r, int d, struct ncclGinMiCell* c) {
+  return gdakiLbOn(r) && gdakiRecD2H(r, c, gdakiMiCellDev(r, d), sizeof(*c)) == ncclSuccess;
+}
+// The first `bytes` bytes of d's cell, written over the NIC and read back.
+static bool gdakiMiCellPut(struct gdakiRecHost* r, int d, const struct ncclGinMiCell& w, size_t bytes) {
+  struct ncclGinMiCell back;
+  return gdakiLbOn(r) && gdakiRecH2D(r, gdakiMiCellDev(r, d), &w, bytes) == ncclSuccess && gdakiMiCellRead(r, d, &back) &&
+         memcmp(&back, &w, bytes) == 0;
+}
+static bool gdakiMiUseGet(struct gdakiRecHost* r, int qpIdx, uint32_t* v) {
+  return gdakiLbOn(r) && gdakiRecD2H(r, v, gdakiMiQpUseDev(r, qpIdx), sizeof(*v)) == ncclSuccess;
+}
+static bool gdakiMiUseSet(struct gdakiRecHost* r, int qpIdx, uint32_t v) {
+  uint32_t back = ~v;
+  return gdakiLbOn(r) && gdakiRecH2D(r, gdakiMiQpUseDev(r, qpIdx), &v, sizeof(v)) == ncclSuccess &&
+         gdakiMiUseGet(r, qpIdx, &back) && back == v;
+}
+// The first device break the helper sees on this rank's lane toward d (once per destination and process; WARN in both
+// builds; fix of pilot 1's defect D, 2026-10-15): the device's reason and the rank of the mirror QP it concerned (the
+// cell's brkWhy and brkPeer), that QP's number, state and miUse now, the cell's rkey and lane, and the side table's
+// miMode. `where`: "measurement" or "restore".
+static void gdakiMiFirstBreakLine(struct gdakiRecHost* r, int d, const struct ncclGinMiCell& c, const char* where) {
+  struct gdakiMiHost* m = r->mi.host;
+  if (d < 0 || d >= (int)m->dest.size() || m->dest[(size_t)d].brkLined) return;
+  m->dest[(size_t)d].brkLined = true;
+  const int n = r->nranks, b = (int)c.brkPeer;
+  uint32_t qpn = 0, st = ~0u, use = ~0u;
+  if (b >= 0 && b < n && r->mi.ctx >= 0) {
+    const int qi = (int)ncclGinMiQpIdx((uint32_t)r->mi.ctx, (uint32_t)n, (uint32_t)b);
+    struct doca_gpu_verbs_qp_hl* q = qi < (int)r->qps.size() ? r->ctx->gqps[qi] : nullptr;
+    if (q != nullptr) {
+      qpn = gdakiRecQpn(q);
+      std::lock_guard<std::mutex> op(r->opMu);  // as gdakiMiSelfCheck's query
+      if (doca_verbs_qp_query_seq(q->qp, nullptr, nullptr, nullptr, &st) != DOCA_SUCCESS) st = ~0u;
+    }
+    if (!gdakiMiUseGet(r, qi, &use)) use = ~0u;
+  }
+  WARN("GIN/MI: rank %d: first mirror break toward rank %d (%s): why=%s mirror_qp_peer=%d qpn=%#x qp_state=%d mi_use=%d "
+       "rkey=%#x cell_valid=%u lane_base=%lu lane_bytes=%lu cursor=%lu broken=%lu mode=%u mono_ms=%.3f", r->ctx->rank, d,
+       where, gdakiMiBrkName(c.brkWhy), b, qpn, st == ~0u ? -1 : (int)st, use == ~0u ? -1 : (int)use, be32toh(c.rkeyBe),
+       c.valid, (unsigned long)c.laneBase, (unsigned long)c.laneBytes, (unsigned long)c.cursor, (unsigned long)c.broken,
+       r->rsMeasureMs > 0 ? gdakiMiMeasureModeOf(r) : NCCL_GIN_MI_MODE_BUDDY, gdakiQ4MonoMs());
+}
+// A host-side break of d's lane (gdakiMiLedgerHostBreak: counted, and a pending rollback writes the cell back invalid),
+// its cell's `valid` written 0 (4 bytes) whatever the host wrote before.
+static void gdakiMiCellInvalid(struct gdakiRecHost* r, int d) {
+  gdakiMiLedgerHostBreak(r->mi.host->dest[(size_t)d].led);
+  const uint32_t z = 0;
+  if (gdakiMiSide(r) && gdakiLbOn(r)) (void)gdakiRecH2D(r, gdakiMiCellDev(r, d), &z, sizeof(z));
+}
+static void gdakiMiLaneBroken(struct gdakiRecHost* r, int d, const char* cause) {
+  r->mi.host->nBroken++;
+  GIN_TS_NOTE("GIN/MI: rank %d: lane to rank %d broken (%s): DISARM mono_ms=%.3f", r->ctx->rank, d, cause, gdakiQ4MonoMs());
+  char w[160];
+  snprintf(w, sizeof(w), "its mirror lane on this rank broke (%.120s)", cause);
+  gdakiHoldDisarm(r, d, w, true);
+}
+// The mirror path to `b` (d's buddy) for a switch: the self loop (b is this rank) without an error, or the mirror QP to b
+// in use. miUse 1 is written here for a QP this rank connected at the setup (or re-armed) that does not say so yet; on a
+// revived rank for a QP its REJOIN connected, unless its import wrote miUse 0 there (gdakiMiImportMirrorUnusable).
+static bool gdakiMiPathReady(struct gdakiRecHost* r, int b) {
+  struct gdakiMiHost* m = r->mi.host;
+  const int n = r->nranks, me = r->ctx->rank;
+  if (b < 0 || b >= n) return false;
+  const int qi = (int)ncclGinMiQpIdx((uint32_t)r->mi.ctx, (uint32_t)n, (uint32_t)b);
+  uint32_t use = 0;
+  if (b == me) {
+    if (!m->selfOk || m->selfErr || !gdakiMiUseGet(r, qi, &use)) return false;
+    return use == 1u || gdakiMiUseSet(r, qi, 1u);
+  }
+  if (m->givenUp[(size_t)b] || qi >= (int)r->qps.size() || !r->qps[(size_t)qi].used || !gdakiMiUseGet(r, qi, &use))
+    return false;
+  if (use == 1u) return true;
+  if (m->replay) {
+    // integration (2026-10-15): a revived rank's mirror QPs were connected at its REJOIN (TOKEN's QPN) and its import
+    // set their counts; miUse 1 is written here, at the first switch toward a ward of b, except on the QP whose
+    // survivor's mirror count was not valid at the hold start (the import wrote miUse 0 there): that QP is given up
+    // until a restore round of b re-arms it (gdakiMiAfterRestorePublish)
+    if (gdakiMiImportMirrorUnusable(r, b)) {
+      m->givenUp[(size_t)b] = 1;
+      return false;
+    }
+    return gdakiMiUseSet(r, qi, 1u);
+  }
+  return m->connected[(size_t)b] && gdakiMiUseSet(r, qi, 1u);
+}
+
+// ---- segments (impl/rs_mirror_api.h; the checkpoint machine's pause calls them) ----
+static bool gdakiMiSegSwitch(struct gdakiRecHost* r, int d, uint64_t ckpt, uint64_t pauseHead, bool* restarted) {
+  *restarted = false;
+  if (!gdakiMiOn(r)) return false;
+  struct gdakiMiHost* m = r->mi.host;
+  const int n = r->nranks, me = r->ctx->rank;
+  if (d < 0 || d >= n || d == me) return false;
+  struct gdakiMiDest& x = m->dest[(size_t)d];
+  x.lastPath = x.lastPool = false;
+  const int b = ncclGinMiBuddyOf(d, n), wardIdx = ncclGinMiWardIdx(d, n), lane = ncclGinMiLaneOf(me, d);
+  struct ncclGinMiCell c;
+  if (b < 0 || wardIdx < 0 || !m->confOk || !gdakiMiSide(r) || !gdakiMiCellRead(r, d, &c)) {
+    m->nSwitchFail++;
+    return false;  // nothing changed: the old segment goes on (PAUSED not armable)
+  }
+  // the pool key of b: this rank's own, MIRROR_SETUP's, a restore round's (gdakiMiPoolRekey), or the cell's (a spare's
+  // import writes its survivors' keys there)
+  uint32_t rkey = b == me ? m->ownRkey : m->poolRkey[(size_t)b];
+  if (rkey == 0 && b != me && c.rkeyBe != 0) rkey = m->poolRkey[(size_t)b] = be32toh(c.rkeyBe);
+  const bool path = gdakiMiPathReady(r, b);
+  x.lastPath = path;
+  x.lastPool = rkey != 0;
+  // the records first (a copy for the rollback), then the cell: {valid, rkey, seg + 1, its lane, L, cursor 0}
+  const uint64_t S = (uint64_t)m->conf.slots, L = (uint64_t)m->conf.lane;
+  const uint64_t liveBytes = gdakiMiSegsLiveBytes(x.led.segs, c.cursor, L);
+  gdakiMiPollBase(x.poll, c.broken);
+  bool restart = false;
+  struct ncclGinMiCell w;
+  (void)gdakiMiLedgerSwitch(x.led, c, ckpt, pauseHead, path && rkey != 0, htobe32(rkey), wardIdx, lane, n, S, L, &restart,
+                            &w);
+  const bool written = gdakiMiCellPut(r, d, w, offsetof(struct ncclGinMiCell, broken));
+  gdakiMiLedgerSwitchWritten(x.led, w, written);
+  x.cursor = 0;
+  if (!written) {
+    // the cell is not known now: invalid if it can be written (a rollback of this pause writes the old values back,
+    // invalid), the lane broken
+    m->nSwitchFail++;
+    const uint32_t z = 0;
+    if (gdakiLbOn(r)) (void)gdakiRecH2D(r, gdakiMiCellDev(r, d), &z, sizeof(z));
+    gdakiMiLaneBroken(r, d, "the segment switch could not be written");
+    if (restart) m->nRestart++;
+    return false;
+  }
+  m->nSwitch++;
+  if (x.led.segs.live.size() >= 3) m->nThird++;
+  m->maxLive = std::max(m->maxLive, liveBytes);
+  if (restart) {
+    m->nRestart++;
+    *restarted = true;
+    GIN_TS_NOTE("GIN/MI: rank %d: segments of rank %d restarted at its checkpoint %lu mono_ms=%.3f", me, d,
+                (unsigned long)ckpt, gdakiQ4MonoMs());
+  }
+  return true;
+}
+static void gdakiMiPathOf(struct gdakiRecHost* r, int d, bool* pathUsable, bool* poolKnown) {
+  *pathUsable = *poolKnown = false;
+  if (!gdakiMiOn(r) || d < 0 || d >= r->nranks) return;
+  *pathUsable = r->mi.host->dest[(size_t)d].lastPath;
+  *poolKnown = r->mi.host->dest[(size_t)d].lastPool;
+}
+static void gdakiMiSegPauseEnd(struct gdakiRecHost* r, int d, uint64_t ckpt, bool rollback) {
+  if (!gdakiMiOn(r) || d < 0 || d >= r->nranks || d == r->ctx->rank) return;
+  struct gdakiMiHost* m = r->mi.host;
+  struct gdakiMiDest& x = m->dest[(size_t)d];
+  if (!gdakiMiLedgerPauseEnd(x.led, ckpt, rollback)) return;
+  // the gates are odd with count 0: nothing of the device moved the cell but its broken counter (not written back)
+  const bool ok = gdakiMiSide(r) && gdakiMiCellPut(r, d, x.led.pendCell, offsetof(struct ncclGinMiCell, broken));
+  gdakiMiLedgerRolledBack(x.led, ok);
+  if (ok) {
+    m->nRollback++;
+    return;
+  }
+  // the old values could not be written back: the new segment stays, as a switch that failed
+  const uint32_t z = 0;
+  if (gdakiMiSide(r) && gdakiLbOn(r)) (void)gdakiRecH2D(r, gdakiMiCellDev(r, d), &z, sizeof(z));
+  gdakiMiLaneBroken(r, d, "the rollback of a segment switch could not be written");
+}
+static void gdakiMiSegStable(struct gdakiRecHost* r, int d, uint64_t ckpt) {
+  if (!gdakiMiOn(r) || d < 0 || d >= r->nranks) return;
+  struct gdakiMiDest& x = r->mi.host->dest[(size_t)d];
+  gdakiMiLedgerStable(x.led, ckpt);  // also from a pending rollback's copy
+}
+static bool gdakiMiSegViewOf(struct gdakiRecHost* r, int d, struct gdakiMiSegView* out) {
+  if (!gdakiMiOn(r) || d < 0 || d >= r->nranks || d == r->ctx->rank) {
+    *out = gdakiMiSegView();
+    return false;
+  }
+  const struct gdakiMiDest& x = r->mi.host->dest[(size_t)d];
+  return gdakiMiSegsViewOf(x.led.segs, x.led.cellValid, x.cursor, out);
+}
+static void gdakiMiSegDropClosed(struct gdakiRecHost* r, int d) {
+  if (!gdakiMiOn(r) || d < 0 || d >= r->nranks) return;
+  struct gdakiMiDest& x = r->mi.host->dest[(size_t)d];
+  gdakiMiLedgerDropClosed(x.led);
+}
+// d's buddy b is restored (its restore round, before the publish; from the spare branch's rkey swap): every segment of d
+// goes, d's cell invalid with b's new pool key. Never a failure of that round: a cell it cannot write breaks d's lane.
+static ncclResult_t gdakiMiPoolRekey(struct gdakiRecHost* r, int d, uint32_t rkeyBe, char* why, size_t whyLen) {
+  if (!gdakiMiOn(r)) return ncclSuccess;
+  struct gdakiMiHost* m = r->mi.host;
+  const int n = r->nranks, me = r->ctx->rank;
+  if (d < 0 || d >= n) {
+    snprintf(why, whyLen, "gdakiMiPoolRekey: rank %d is not a rank of this communicator", d);
+    return ncclInvalidUsage;
+  }
+  if (d == me) return ncclSuccess;  // this rank as a ward of the restored buddy: no lane of its own toward itself
+  const int b = ncclGinMiBuddyOf(d, n);
+  if (b >= 0 && b != me) m->poolRkey[(size_t)b] = be32toh(rkeyBe);
+  struct gdakiMiDest& x = m->dest[(size_t)d];
+  gdakiMiLedgerDropAll(x.led);
+  x.cursor = 0;
+  x.poll.burst = false;
+  struct ncclGinMiCell w;
+  memset(&w, 0, sizeof(w));
+  w.rkeyBe = rkeyBe;
+  if (!gdakiMiSide(r) || !gdakiMiCellPut(r, d, w, offsetof(struct ncclGinMiCell, seg)))
+    gdakiMiLaneBroken(r, d, "its buddy's new pool key could not be written");
+  return ncclSuccess;
+}
+
+// ---- absorption (G4 before gdakiHoldRoute; the scan) and the self loop ----
+// The mirror QP to `b` (b == this rank: the self loop) is given up: miUse 0, the lanes it serves broken (cells invalid,
+// DISARM), the peer never declined. Once per QP until a restore round of b re-arms it; `count` counts every call.
+static void gdakiMiGiveUp(struct gdakiRecHost* r, int b, const char* cause, bool count) {
+  struct gdakiMiHost* m = r->mi.host;
+  const int n = r->nranks, me = r->ctx->rank;
+  if (b < 0 || b >= n) return;
+  bool first;
+  if (b == me) {
+    first = !m->selfErr;
+    m->selfErr = true;
+  } else {
+    first = !m->givenUp[(size_t)b];
+    m->givenUp[(size_t)b] = 1;
+  }
+  if (count || first) m->nAbsorbed++;
+  if (!first) return;
+  const int qi = (int)ncclGinMiQpIdx((uint32_t)r->mi.ctx, (uint32_t)n, (uint32_t)b);
+  if (gdakiMiSide(r)) (void)gdakiMiUseSet(r, qi, 0u);
+  int t[2];
+  const int k = gdakiMiServedBy(b, me, n, t);
+  GIN_TS_NOTE("GIN/MI: rank %d: the mirror QP to rank %d is given up (%s): %d lane(s) broken, rank %d is not declined "
+              "mono_ms=%.3f", me, b, cause, k, b, gdakiQ4MonoMs());
+  for (int i = 0; i < k; i++) {
+    gdakiMiCellInvalid(r, t[i]);  // counted as a host break (also in a pending rollback's copy)
+    gdakiMiLaneBroken(r, t[i], cause);
+  }
+}
+static bool gdakiMiAbsorb(struct gdakiRecHost* r, const struct gdakiTsFault& f) {
+  if (!gdakiMiOn(r) || r->ts == nullptr || !gdakiMiIsMirrorCtx(true, (int)f.rec.ctx_id, r->mi.ctx)) return false;
+  const int b = (int)f.rec.peer;
+  const int qi = b + r->mi.ctx * r->nranks;
+  const bool qOk = qi >= 0 && qi < (int)r->ts->qs.size();
+  if (qOk)  // as gdakiHoldRoute: the scan's lost-record check never counts it
+    r->ts->qs[(size_t)qi].handled = std::max(r->ts->qs[(size_t)qi].handled, f.rec.ts_epoch + 2u);
+  const int v = gdakiMiAbsorbVerdict(true, (int)f.rec.ctx_id, r->mi.ctx, f.rec.ts_epoch,
+                                     qOk ? gdakiTsCoveredEpoch(r->ts->qs[(size_t)qi]) : 0u);
+  if (v == GDAKI_MI_AB_STALE) {  // older than a round's publish (G6): the QP it named is not the one in use now
+    r->ts->nStale++;
+    return true;
+  }
+  char w[96];
+  snprintf(w, sizeof(w), "a fault record of the mirror QP, class %s", gdakiTsClassName(f.rec.cls));
+  gdakiMiGiveUp(r, b, w, true);
+  return true;
+}
+static bool gdakiMiAbsorbQp(struct gdakiRecHost* r, int qpIdx, const char* why) {
+  if (!gdakiMiOn(r) || !gdakiMiIsMirrorQp(true, qpIdx, r->nranks, r->mi.ctx)) return false;
+  char w[160];
+  snprintf(w, sizeof(w), "%.150s", why);
+  gdakiMiGiveUp(r, qpIdx % r->nranks, w, false);
+  return true;
+}
+// The self loop's requester QP left RTS (it has no watch, round or record of its own): its lanes stay broken.
+static void gdakiMiSelfCheck(struct gdakiRecHost* r) {
+  struct gdakiMiHost* m = r->mi.host;
+  const int n = r->nranks, me = r->ctx->rank;
+  if (m->nWards == 0 || !m->selfOk || m->selfErr) return;
+  struct doca_gpu_verbs_qp_hl* q = r->ctx->gqps[r->mi.ctx * n + me];
+  uint32_t st = 0;
+  bool ok;
+  {
+    std::lock_guard<std::mutex> op(r->opMu);  // as the watch's QUERY_QP (no QP state change overlaps)
+    ok = doca_verbs_qp_query_seq(q->qp, nullptr, nullptr, nullptr, &st) == DOCA_SUCCESS;
+  }
+  if (ok && st != 0x3u) {
+    char w[64];
+    snprintf(w, sizeof(w), "the self loop QP is in state %u", st);
+    gdakiMiGiveUp(r, me, w, true);
+  }
+}
+// A restore round of `peer` published (gdakiHoldAfterPublish): its mirror QP, reconnected with the rest, is in use again.
+static void gdakiMiAfterRestorePublish(struct gdakiRecHost* r, int peer) {
+  if (!gdakiMiOn(r) || peer < 0 || peer >= r->nranks || peer == r->ctx->rank) return;
+  struct gdakiMiHost* m = r->mi.host;
+  if (!m->givenUp[(size_t)peer]) return;
+  const int qi = (int)ncclGinMiQpIdx((uint32_t)r->mi.ctx, (uint32_t)r->nranks, (uint32_t)peer);
+  if (!r->qps[(size_t)qi].used) return;  // not in the round (never connected at the setup): stays unused
+  if (!gdakiMiSide(r) || !gdakiMiUseSet(r, qi, 1u)) return;
+  m->givenUp[(size_t)peer] = 0;
+  m->connected[(size_t)peer] = 1;
+  GIN_TS_NOTE("GIN/MI: rank %d: the mirror QP to rank %d is in use again after its restore round mono_ms=%.3f",
+              r->ctx->rank, peer, gdakiQ4MonoMs());
+}
+
+// ---- the measurement mode's arm (no Resume, no checkpoint: the cells are set once, their cursors kept low) ----
+static void gdakiMiMeasureStep(struct gdakiRecHost* r, double now) {
+  struct gdakiMiHost* m = r->mi.host;
+  if (m->measureArm == 0 || !m->confOk || !gdakiMiSide(r)) return;
+  const int n = r->nranks, me = r->ctx->rank;
+  const uint64_t S = (uint64_t)m->conf.slots, L = (uint64_t)m->conf.lane;
+  if (!m->measureSet) {
+    m->measureSet = true;
+    int cells = 0;
+    for (int d = 0; d < n; d++) {
+      int target = -1;
+      uint64_t lb = 0;
+      if (!gdakiMiMeasureLane(m->measureArm, me, d, n, S, L, &target, &lb)) continue;
+      const uint32_t rkey = target == me ? m->ownRkey : m->poolRkey[(size_t)target];
+      if (rkey == 0 || !gdakiMiPathReady(r, target)) continue;
+      struct ncclGinMiCell w;
+      memset(&w, 0, sizeof(w));
+      w.rkeyBe = htobe32(rkey);
+      w.seg = 1;
+      w.laneBase = lb;
+      w.laneBytes = L;
+      if (!gdakiMiCellPut(r, d, w, offsetof(struct ncclGinMiCell, broken))) continue;
+      w.valid = 1;  // last, alone
+      if (!gdakiMiCellPut(r, d, w, sizeof(w.valid))) continue;
+      m->dest[(size_t)d].led.cellValid = true;
+      cells++;
+    }
+    m->nextMeasureMs = now + (double)std::max<long long>(1, r->rsMeasureMs);
+    WARN("GIN/MI: rank %d: measurement mode mirror arm %s: %d cell(s) valid mono_ms=%.3f", me,  // both builds (integration)
+         m->measureArm == 1 ? "self" : "peer", cells, gdakiQ4MonoMs());
+    return;
+  }
+  // the lanes never fill: a cursor past half of L goes back to 0 (the data is never read). The integration (2026-10-15)
+  // checks every helper step (about 1 ms; the measurement period, 50 ms, let a fast arm run past L between two checks)
+  // and counts the device's breaks (the cells' broken counters) into the summary's broken=, so an arm whose puts did not
+  // all go out mirrored says so (the test branch takes a mirror arm only with broken=0). A put above L always breaks: the
+  // cost cells set L to at least twice (the largest put + the mirror bytes of a helper step), with room for a stalled
+  // step (impl/test/run_cost_mi.sh: 256 MiB). These cell reads add one small NIC-loopback read per valid cell per step
+  for (int d = 0; d < n; d++) {
+    struct gdakiMiDest& x = m->dest[(size_t)d];
+    if (!x.led.cellValid) continue;
+    struct ncclGinMiCell c;
+    if (!gdakiMiCellRead(r, d, &c)) continue;
+    if (c.broken > x.measBroken) {
+      m->nBroken += c.broken - x.measBroken;
+      gdakiMiFirstBreakLine(r, d, c, "measurement");  // fix (defect D): the first one says why
+    }
+    x.measBroken = c.broken;
+    m->maxLive = std::max(m->maxLive, std::min(c.cursor, L));
+    if (c.cursor <= L / 2) continue;
+    const uint64_t z = 0;
+    (void)gdakiRecH2D(r, gdakiMiCellDev(r, d) + offsetof(struct ncclGinMiCell, cursor), &z, sizeof(z));
+  }
+}
+
+// ---- INJECTED: the revived rank's send, a survivor's apply; RESTORED with the mirror ----
+static void gdakiMiInjectedReady(struct gdakiRecHost* r, uint64_t lastStep) {
+  if (!gdakiMiOn(r)) return;
+  r->mi.host->injStep.store(lastStep, std::memory_order_relaxed);
+  r->mi.host->injPending.store(1, std::memory_order_release);
+}
+static void gdakiMiInjectedStep(struct gdakiRecHost* r) {
+  struct gdakiMiHost* m = r->mi.host;
+  const int n = r->nranks, me = r->ctx->rank;
+  if (m->injPending.exchange(0, std::memory_order_acq_rel) != 0) {
+    const uint32_t self = gdakiRsPeerInc(r, me);
+    if (self == 0) {  // its own incarnation not known yet: kept for a later step
+      m->injPending.store(1, std::memory_order_release);
+    } else if (m->injSentInc != self) {  // once per incarnation
+      m->injSentInc = self;
+      m->injSent.assign((size_t)n, 0);
+      m->injActive = true;
+      m->injTries = 0;
+      m->injNextMs = 0;
+      m->injStepNow = m->injStep.load(std::memory_order_relaxed);
+    }
+  }
+  if (!m->injActive) return;
+  const double now = gdakiQ4MonoMs();
+  if (now < m->injNextMs) return;
+  m->injNextMs = now + 20.0;
+  int owed = 0, told = 0;
+  for (int p = 0; p < n; p++) {
+    if (!gdakiMiInjOwed(m->injSent, p, me, r->ts->peers[(size_t)p].declined)) continue;
+    struct gdakiTsMsg x;
+    gdakiHoldMsgInit(&x, GDAKI_TS_RS_INJECTED, me, 0);
+    x.round = m->injStepNow;
+    x.pad = m->injSentInc;
+    x.executed[0] = GDAKI_RS_WIRE_VERSION;
+    x.executed[1] = m->injSentInc;
+    if (gdakiHoldSend(r, p, &x) == 0) m->injSent[(size_t)p] = 1;
+    else owed++;
+  }
+  if (owed > 0 && ++m->injTries < 50) return;
+  m->injActive = false;
+  for (int p = 0; p < n; p++) told += m->injSent[(size_t)p] ? 1 : 0;
+  GIN_TS_NOTE("GIN/MI: rank %d: INJECTED sent step=%lu survivors=%d unsent=%d mono_ms=%.3f", me,
+              (unsigned long)m->injStepNow, told, owed, gdakiQ4MonoMs());
+}
+static bool gdakiMiKeepGatesOdd(struct gdakiRecHost* r, int peer) {
+  return gdakiMiOn(r) && gdakiHoldPeerState(r, peer, nullptr) == GDAKI_HOLD_COMMITTING;
+}
+// gdakiStoreOnBuddyRestored is the store branch's (once per incarnation of the buddy; the integration removed this
+// branch's placeholder)
+static void gdakiMiApplyRestored(struct gdakiRecHost* r, int peer, const struct gdakiTsMsg& m) {
+  struct gdakiHold* h = gdakiHoldOf(r);
+  if (!gdakiMiOn(r) || !gdakiHoldPeerOk(h, peer)) return;
+  r->mi.host->restoredPad[(size_t)peer] = m.pad;
+  gdakiCkptPeerReset(r, peer);  // work package 5 (as gin-restore at RESTORED)
+  if (gdakiHoldBuddyOf(h->rank, h->nranks) == peer) gdakiStoreOnBuddyRestored(r, peer);  // impl/rs_store_api.h
+  // gin-restore's line, its text unchanged (the restore time is measured to it, EXPERIMENT.md 9.4 "4 KiB 셀"); the state
+  // it names is the one it keeps until INJECTED (published, or timed-out-published)
+  const struct gdakiHoldPeer& hp = h->peers[(size_t)peer];
+  const uint32_t st = gdakiHoldStateOf(gdakiHoldLoad(h->cells[peer]));
+  GIN_TS_NOTE("GIN/RS: rank %d: rank %d restored as incarnation %u (%s; %.1f ms after the hold start, %.1f ms after the "
+              "publish); state %s mono_ms=%.3f", h->rank, peer, m.pad,
+              st == GDAKI_HOLD_TIMED_OUT_PUBLISHED ? "read before the timed-out publish fell back" : "on time",
+              gdakiQ4MonoMs() - hp.holdStartMs, gdakiQ4MonoMs() - hp.publishMs, gdakiHoldStateName(st), gdakiQ4MonoMs());
+  gdakiHoldDisarmSelf(r, "this rank took part in a restore: armed again at its own next stable checkpoint");
+}
+static void gdakiHoldApplyInjected(struct gdakiRecHost* r, int peer, const struct gdakiTsMsg& m) {
+  struct gdakiHold* h = gdakiHoldOf(r);
+  if (!gdakiHoldPeerOk(h, peer)) return;
+  const uint64_t v = gdakiHoldLoad(h->cells[peer]);
+  const int c = gdakiMiInjectedCheck(gdakiMiOn(r), peer, m.arg, m.executed[0], GDAKI_RS_WIRE_VERSION, m.executed[1], m.pad,
+                                     gdakiHoldStateOf(v), gdakiHoldIncOf(v),
+                                     gdakiMiOn(r) ? r->mi.host->restoredPad[(size_t)peer] : 0u);
+  if (c != GDAKI_MI_INJ_APPLY) {
+    GIN_TS_NOTE("GIN/MI: rank %d: an INJECTED (incarnation %u, step %lu) from rank %d ignored (%s) in state %s "
+                "(incarnation %u) mono_ms=%.3f", h->rank, m.pad, (unsigned long)m.round, peer, gdakiMiInjectedWhy(c),
+                gdakiHoldStateName(gdakiHoldStateOf(v)), gdakiHoldIncOf(v), gdakiQ4MonoMs());
+    return;
+  }
+  struct gdakiHoldPeer& hp = h->peers[(size_t)peer];
+  const double t = gdakiQ4MonoMs();
+  // the user QPs' gates even: as the empty round (its commit point, the next even epoch, lbase unchanged); the mirror QP's
+  // gate was published even
+  const char* why = nullptr;
+  bool ok;
+  {
+    gdakiTsScopeGuard miScope(gdakiTsScope & gdakiMiUserScope(r));
+    ok = gdakiCkptEmptyRound(r, peer, &why);
+  }
+  if (!ok) {
+    char w[224];
+    snprintf(w, sizeof(w), "the user gates could not be made even at INJECTED (%.150s)", why ? why : "?");
+    return gdakiHoldFallback(r, peer, w);
+  }
+  // PUBLISHED or TIMED_OUT_PUBLISHED of incarnation i -> ARMED or OFF of i + 1 (as gin-restore at RESTORED)
+  const uint32_t ns = gdakiHoldRestoredState(gdakiHoldCommArmedNow(h), hp.disarmDuringHold,
+                                             gdakiHoldRespareRegistered(r, peer));
+  uint32_t from = 0, inc = 0;
+  if (!gdakiHoldRestoreMove(h->cells[peer], m.pad, ns, &from, &inc)) {  // only the helper leaves the published states
+    GIN_TS_NOTE("GIN/MI: rank %d: an INJECTED from rank %d found state %s (incarnation %u) after its gates went even "
+                "mono_ms=%.3f", h->rank, peer, gdakiHoldStateName(from), inc, gdakiQ4MonoMs());
+    return;
+  }
+  h->cells[peer].deadlineUs.store(0, std::memory_order_release);
+  int e = peer;
+  h->heldPeer.compare_exchange_strong(e, -1, std::memory_order_acq_rel);
+  hp.revivedFromValid = true;
+  hp.revivedFrom = inc;
+  hp.phase = GDAKI_HOLD_P_REJOIN;
+  gdakiHoldXferClose(hp);
+  h->nRestored.fetch_add(1, std::memory_order_relaxed);
+  gdakiMiSegDropClosed(r, peer);  // its import used them
+  GIN_TS_NOTE("GIN/MI: rank %d: INJECTED from rank %d step=%lu state=%s gate_odd_ms=%.1f mono_ms=%.3f", h->rank, peer,
+              (unsigned long)m.round, gdakiHoldStateName(ns), t - hp.gateOddMs, gdakiQ4MonoMs());
+}
+
+// ---- the poll (every helper step; impl/rs_mirror_api.h gdakiMiPoll) and the pull ----
+static void gdakiMiPoll(struct gdakiRecHost* r, std::vector<int>* disarm) {
+  if (!gdakiMiOn(r) || r->ts == nullptr || r->hold == nullptr) return;
+  struct gdakiMiHost* m = r->mi.host;
+  const int n = r->nranks, me = r->ctx->rank;
+  gdakiMiInjectedStep(r);
+  for (int p = 0; p < n; p++) {  // the mirror's parked records: CKPT_PULL for this rank; a MIRROR_SETUP after its wait
+    if (p == me) continue;
+    struct gdakiTsMsg x;
+    while (gdakiHoldTakeMsg(r, p, GDAKI_TS_CKPT_PULL, &x))
+      if (x.arg == me) m->pull.store(true, std::memory_order_release);
+    while (gdakiHoldTakeMsg(r, p, GDAKI_TS_MI_SETUP, &x)) {  // a late one: on = 0 is the peer's "not connected"
+      struct gdakiMiSetup s;
+      memcpy(&s, x.executed, sizeof(s));
+      const bool ours = x.from == p && x.arg == p && x.nonce == r->ts->nonce && s.version == GDAKI_MI_WIRE_VERSION;
+      const bool demote = ours && gdakiMiSetupDemotes(m->connected[(size_t)p] != 0, s.on);
+      if (demote) {
+        const int qi = (int)ncclGinMiQpIdx((uint32_t)r->mi.ctx, (uint32_t)n, (uint32_t)p);
+        r->qps[(size_t)qi].used = false;  // as on the peer: the hk rounds walk the same QPs on both ranks
