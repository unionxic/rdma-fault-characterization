+static void gdakiMiTeardownLine(struct gdakiRecHost* r) {
+  if (!gdakiMiOn(r)) return;
+  const struct gdakiMiHost* m = r->mi.host;
+  // WARN in both builds (integration, 2026-10-15): the cost cells run the production build and read broken= (as the
+  // store summary)
+  WARN("GIN/MI: rank %d: mirror summary switches=%lu rollbacks=%lu restarts=%lu third_slot=%lu max_live_bytes=%lu "
+       "pulls_sent=%lu pulls_taken=%lu broken=%lu absorbed=%lu mono_ms=%.3f", r->ctx->rank, (unsigned long)m->nSwitch,
+       (unsigned long)m->nRollback, (unsigned long)m->nRestart, (unsigned long)m->nThird, (unsigned long)m->maxLive,
+       (unsigned long)m->nPullSent, (unsigned long)m->nPullTaken.load(), (unsigned long)m->nBroken,
+       (unsigned long)m->nAbsorbed, gdakiQ4MonoMs());
+}
+static void gdakiMiFree(struct gdakiRecHost* r) {
+  if (r == nullptr || r->mi.host == nullptr) return;
+  if (!r->mi.host->poolTaken) gdakiMiPoolFree(r->mi.host->pool);  // else the context's destroy frees it after the QPs
+  delete r->mi.host;
+  r->mi.host = nullptr;
+  r->mi.on = false;
+}
