+#define GDAKI_MI_ACT_MAX_ADDR 4096u  // nAddr at most (= nranks): a bound checked before the rest is read
+static inline uint64_t gdakiMiActRestBytes(const struct gdakiMiActHdr& h) {
+  return (uint64_t)h.nAddr * sizeof(struct gdakiMiActAddr) + (uint64_t)h.nExt * sizeof(struct gdakiMiActExt);
