+// ---- the integration (2026-10-15): three entry points the branches left open ----
+// impl/rs_log_api.h v2 (owner host): the (step, head) pairs of the checkpoint's step log whose head is above `from`,
+// increasing, and the last step ncclGinRestoreStep recorded (the newest pair's; with every pair settled, the stable step;
+// GDAKI_RS_STEP_UNKNOWN when no step was ever recorded). The log keeps the pairs not yet stable: a pair whose head is above
+// a peer's stable cut is never settled (its entries are not covered), so every pair of the export's range is there.
+static void gdakiCkptStepPairs(struct gdakiRecHost* r, uint64_t from, std::vector<uint64_t>* steps,
+                               std::vector<uint64_t>* heads, uint64_t* lastStep) {
+  steps->clear();
+  heads->clear();
+  *lastStep = GDAKI_RS_STEP_UNKNOWN;
+  struct gdakiCkpt* ck = r != nullptr ? gdakiCkptOf(r) : nullptr;
+  if (ck == nullptr) return;
+  std::lock_guard<std::mutex> lk(ck->mu);
+  const struct gdakiCkptStepLog& s = ck->steps;
+  const size_t n = std::min(s.steps.size(), s.heads.size());
+  for (size_t i = 0; i < n; i++)
+    if (s.heads[i] > from) {
+      steps->push_back(s.steps[i]);
+      heads->push_back(s.heads[i]);
+    }
+  if (n > 0) *lastStep = s.steps[n - 1];
+  else if (s.haveStable) *lastStep = s.stable;
+}
+// impl/notes_spare.md gap 3: this rank's pool (its rkey in host order, L, S) for the drain's fence, the activation blob
+// and the rkey lists. False with the mirror off or without a registered pool (no ward, or a registration that failed).
+static bool gdakiMiPoolInfoOf(struct gdakiRecHost* r, uint32_t* rkey, uint64_t* laneBytes, uint32_t* slots) {
+  *rkey = 0;
+  *laneBytes = 0;
+  *slots = 0;
+  if (!gdakiMiOn(r)) return false;
+  const struct gdakiMiHost* m = r->mi.host;
+  if (m->pool == nullptr || m->pool->mr == nullptr || !m->confOk) return false;
+  *rkey = m->ownRkey;
+  *laneBytes = (uint64_t)m->conf.lane;
+  *slots = (uint32_t)m->conf.slots;
+  return true;
+}
+// impl/notes_spare.md gap 9: the self loop's responder MSN at its connect (gdakiMiContextSetup).
+static bool gdakiMiSelfBase(struct gdakiRecHost* r, uint32_t* base) {
+  *base = 0;
+  if (!gdakiMiOn(r) || !r->mi.host->selfBaseOk) return false;
+  *base = r->mi.host->selfBase;
+  return true;
+}
