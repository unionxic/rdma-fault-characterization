+// The header's own fields, before the rest is read: 0, or a REFUSED reason code (as gdakiMiActCheck's: 1 magic or
+// version, 3 the counts).
+static inline int gdakiMiActHdrSane(const struct gdakiMiActHdr& h, int nranks) {
+  if (h.magic != GDAKI_MI_ACTB_MAGIC || h.version != GDAKI_MI_WIRE_VERSION) return 1;
+  if (nranks <= 0 || h.nranks != (uint32_t)nranks || h.nAddr != h.nranks || h.nAddr > GDAKI_MI_ACT_MAX_ADDR) return 3;
+  if (h.nExt > GDAKI_MI_ACT_MAX_EXT) return 3;
+  return 0;
+}
+// Sizes a spare can hold at all, before gdakiMiActCheck adds them (no sum may wrap): the slot and a lane each within the
+// FETCH buffer, the image within 2^40 bytes (as the TCP FETCH's bound). 0, or 7 (too large: REFUSED).
+static inline int gdakiMiActFits(const struct gdakiMiActHdr& h, uint64_t fetchCap) {
+  if (h.usedBytes > fetchCap || h.laneBytes > fetchCap || h.imageBytes > (1ull << 40) || fetchCap > (1ull << 50)) return 7;
+  return 0;
