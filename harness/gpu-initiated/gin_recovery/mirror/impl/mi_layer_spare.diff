+#define GDAKI_MI_ACTB_F_STORE 0x1u       // the store part is valid (always with the mirror)
+#define GDAKI_MI_ACTB_F_POOL 0x2u        // the pool part is valid (else every MIRROR entry is refused later)
+struct gdakiMiActHdr {
