+// The blob's bytes (the buddy sends them right after the record). False when the header's counts are not the lists'.
+static bool gdakiMiActBlobEncode(const struct gdakiMiActHdr& h, const std::vector<struct gdakiMiActAddr>& addr,
+                                 const std::vector<struct gdakiMiActExt>& ext, std::vector<uint8_t>* out) {
+  if (h.nAddr != addr.size() || h.nExt != ext.size()) return false;
+  const size_t a = addr.size() * sizeof(struct gdakiMiActAddr), e = ext.size() * sizeof(struct gdakiMiActExt);
+  out->resize(sizeof(h) + a + e);
+  memcpy(out->data(), &h, sizeof(h));
+  if (a) memcpy(out->data() + sizeof(h), addr.data(), a);
+  if (e) memcpy(out->data() + sizeof(h) + a, ext.data(), e);
+  return true;
+}
+// The reverse, over bytes that arrived whole: 0 and the three parts, or a REFUSED reason code (gdakiMiActHdrSane's, or
+// 3 when the length is not the header's).
+static int gdakiMiActBlobDecode(const uint8_t* p, size_t n, int nranks, struct gdakiMiActHdr* h,
+                                std::vector<struct gdakiMiActAddr>* addr, std::vector<struct gdakiMiActExt>* ext) {
+  if (n < sizeof(*h)) return 3;
+  memcpy(h, p, sizeof(*h));
+  const int sane = gdakiMiActHdrSane(*h, nranks);
+  if (sane != 0) return sane;
+  if ((uint64_t)n != sizeof(*h) + gdakiMiActRestBytes(*h)) return 3;
+  addr->resize(h->nAddr);
+  ext->resize(h->nExt);
+  const size_t a = (size_t)h->nAddr * sizeof(struct gdakiMiActAddr);
+  if (a) memcpy(addr->data(), p + sizeof(*h), a);
+  if (h->nExt) memcpy(ext->data(), p + sizeof(*h) + a, (size_t)h->nExt * sizeof(struct gdakiMiActExt));
+  return 0;
+}
