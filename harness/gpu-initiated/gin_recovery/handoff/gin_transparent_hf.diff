+// Visit this rank's peer-connected main QPs (same set as the fault hook).
+template <typename F>
+static void gdakiQ4ForPeerQps(struct gdaki_context* g, F fn) {
+  const int nranks = g->collComm->nranks;
+  const int rankOff = g->rank % g->rankStride;
+  for (int c = 0; c < g->nContexts; c++) {
+    for (int r = 0; r < nranks; r++) {
+      if (r == g->rank || (r % g->rankStride) != rankOff) continue;
+      struct doca_gpu_verbs_qp_hl* q = g->gqps ? g->gqps[r + c * nranks] : nullptr;
+      if (q && q->qp && q->qp_gverbs) fn(q);
+    }
+  }
+}
+
+// Host QP state by QUERY_QP (doca_gpu_verbs_query_last_error: has_error = state==ERR).
+static int gdakiQ4QpErr(struct doca_gpu_verbs_qp_hl* q, double* us) {
+  struct doca_gpu_verbs_qp_error_info info;
+  double t0 = gdakiQ4MonoMs();
+  doca_error_t s = doca_gpu_verbs_query_last_error(q->qp_gverbs, &info);
+  if (us) *us = (gdakiQ4MonoMs() - t0) * 1e3;
+  if (s != DOCA_SUCCESS) return -1;
+  return info.has_error ? 1 : 0;
+}
+
+static void gdakiQ4Handle(struct gdakiQ4Host* q, const struct ncclGinGdakiQ4Record& r, double monoMs) {
+  struct gdaki_context* g = q->ctx;
+  const bool isErr = (r.kind == NCCL_GIN_Q4_KIND_ERR_CQE);
+  if (isErr) {
+    // Make ncclCommGetAsyncError report it now: the GIN async result (read when GIN proxy
+    // threads exist) and the flag consulted by ncclGinGdakiQueryLastError (always).
+    if (g->rec) {
+      // GIN recovery: keep the record for ncclGinFaultQuery (before the flags below are raised).
+      std::lock_guard<std::mutex> lk(q->lastMu);
+      q->lastErr = r;
+      q->lastErrMonoMs = monoMs;
+      q->nErrSinceRec++;
+    }
+    if (gdakiTsRoutes(g->rec, r)) {
+      // GIN transparent recovery: the helper thread owns the fault now; the error surfaces only if it
+      // declines (gdakiTsDecline sets the same flags). Records of QPs without a gate (self loop) are
+      // handled as Q4 does.
+      gdakiTsPushFault(g->rec, r, monoMs);
+    } else {
+      gdakiBlameNote(q->asyncResult, (int)r.peer);  // gin-handoff: the QP's GIN peer, before the flag
+      q->hasError.store(1, std::memory_order_release);
+      if (q->asyncResult) {
+        __atomic_store_n(q->asyncResult, ncclRemoteError, __ATOMIC_RELEASE);
+        if (g->rec) q->setAsync.store(1, std::memory_order_release);  // GIN recovery may clear it
+      }
+    }
+    q->nErr++;
+  } else {
+    q->nDump++;
+  }
+  if (++q->nLogged > 64) return;  // bounded logging; counts are kept
+  const bool rootErr = (r.root_opcode == 0xd || r.root_opcode == 0xe);
+  const gdakiQ4ClassText ct = gdakiQ4Class(r.cls, r.vendor_err);
+  const int st = rootErr ? gdakiQ4WcStatus(r.syndrome) : 0;
+  // gin-harden: informational while the transparent-recovery helper owns the fault (INFO in the production build)
+  GIN_TS_NOTE("GIN/Q4: %s rank=%d seq=%u ctx=%u peer=%u qpn=%#x wqe=%u path=%s cq=%s fp=%d/%#x syndrome=%#x hw_err=%#x/%#x "
+       "class=%s fault=%s cause=\"%s\" action=\"%s\" root_op=%#x polled[wqe=%u op=%#x syn=%#x ve=%#x] "
+       "window[err=%u ok=%u root_idx=%lu ticket=%lu cqe_ci=%lu] cq_buffer_err=%u/%u root_src=%s gtimer_ns=%lu mono_ms=%.3f",
+       isErr ? "device-classified error CQE" : "device wait-timeout dump", g->rank, r.seq, r.ctx_id, r.peer, r.qpn,
+       r.wqe_counter, gdakiQ4PathStr(r.path), gdakiQ4CqStr(r.cq_type), st, rootErr ? r.vendor_err : 0,
+       rootErr ? r.syndrome : 0, r.hw_err_synd, r.hw_synd_type, ct.name, ct.fault, ct.cause, ct.action, r.root_opcode,
+       r.polled_wqe_counter, r.polled_opcode, r.polled_syndrome, r.polled_vendor_err, r.n_err_window, r.n_ok_window,
+       (unsigned long)r.root_index, (unsigned long)r.ticket, (unsigned long)r.cqe_ci, r.n_err_buffer, r.cqe_num,
+       r.root_src == 1 ? "slot-wait" : r.root_src == 2 ? "stale" : "cq", (unsigned long)r.gtimer_ns, monoMs);
+  if (r.late_valid)
+    GIN_TS_NOTE("GIN/Q4: collapsed slot re-read rank=%d seq=%u late[wqe=%u op=%#x syn=%#x ve=%#x after_us=%.1f]", g->rank,
+         r.seq, r.late_wqe_counter, r.late_opcode, r.late_syndrome, r.late_vendor_err, r.late_delay_ns / 1e3);
+#ifndef NCCL_GIN_TS_PRODUCTION
+  // Diagnostic: direct host QUERY_QP of the QP the record came from (not while the transparent-recovery
+  // helper owns the QPs).
+  if (gdakiTsActive(g->rec)) return;
+  gdakiQ4ForPeerQps(g, [&](struct doca_gpu_verbs_qp_hl* qh) {
+    uint32_t qpn = 0;
+    if (doca_verbs_qp_get_qpn(qh->qp, &qpn) != DOCA_SUCCESS || qpn != r.qpn) return;
+    double us = 0;
+    int e = gdakiQ4QpErr(qh, &us);
+    WARN("GIN/Q4: host QUERY_QP rank=%d qpn=%#x state=%s query_us=%.0f mono_ms=%.3f", g->rank, qpn,
+         e < 0 ? "query-failed" : e ? "ERR" : "not-ERR", us, gdakiQ4MonoMs());
+  });
+#endif
+}
+
+static void gdakiQ4Watch(struct gdakiQ4Host* q) {
+  volatile uint32_t* words = (volatile uint32_t*)q->rec_h;
+  const int wpr = sizeof(struct ncclGinGdakiQ4Record) / 4;
+  std::vector<int> qpState;
+  double nextWatch = gdakiQ4MonoMs();
+  while (!q->stop.load(std::memory_order_acquire)) {
+    for (int s = 0; s < NCCL_GIN_GDAKI_Q4_NSLOTS; s++) {
+      volatile uint32_t* w = words + s * wpr;
+      const uint32_t magic = w[0], seq = w[1];
+      if (magic != NCCL_GIN_GDAKI_Q4_MAGIC || seq == 0 || seq == q->lastSeq[s]) continue;
+      const double monoMs = gdakiQ4MonoMs();
+      std::atomic_thread_fence(std::memory_order_acquire);
+      struct ncclGinGdakiQ4Record r;
+      uint32_t* dst = (uint32_t*)&r;
+      for (int i = 0; i < wpr; i++) dst[i] = w[i];
+      std::atomic_thread_fence(std::memory_order_acquire);
+      if (w[1] != seq || w[0] != NCCL_GIN_GDAKI_Q4_MAGIC) continue;  // being rewritten; next round
+      q->lastSeq[s] = seq;
+      gdakiQ4Handle(q, r, monoMs);
+    }
+    if (q->ctx->rec) gdakiTsWatchdog(q->ctx->rec);  // GIN transparent recovery: no-op unless it is on
+#ifndef NCCL_GIN_TS_PRODUCTION
+    if (q->qpWatchMs > 0 && gdakiQ4MonoMs() >= nextWatch) {
+      nextWatch += q->qpWatchMs;
+      int i = 0;
+      gdakiQ4ForPeerQps(q->ctx, [&](struct doca_gpu_verbs_qp_hl* qh) {
+        double us = 0;
+        int e = gdakiQ4QpErr(qh, &us);
+        if (i >= (int)qpState.size()) qpState.push_back(-2);
+        if (e != qpState[i]) {
+          uint32_t qpn = 0;
+          doca_verbs_qp_get_qpn(qh->qp, &qpn);
+          WARN("GIN/Q4: QPWATCH rank=%d qpn=%#x state %s -> %s query_us=%.0f mono_ms=%.3f", q->ctx->rank, qpn,
+               qpState[i] == -2 ? "init" : qpState[i] ? "ERR" : "not-ERR", e < 0 ? "query-failed" : e ? "ERR" : "not-ERR",
+               us, gdakiQ4MonoMs());
+          qpState[i] = e;
+        }
+        i++;
+      });
+    }
+#else
+    (void)nextWatch;
+#endif
+    if (q->pollUs > 0) std::this_thread::sleep_for(std::chrono::microseconds(q->pollUs));
+  }
+}
+
+static ncclResult_t gdakiQ4Alloc(struct gdaki_context* g, struct gdakiQ4Host** out) {
+  *out = nullptr;
+  if (ncclParamGinFaultClassify() == 0) return ncclSuccess;
+  ncclResult_t ret = ncclSuccess;
+  struct ncclGinGdakiQ4 init;
+  struct gdakiQ4Host* q = new gdakiQ4Host();
+  q->ctx = g;
+  q->pollUs = (int)std::max<int64_t>(0, ncclParamGinFaultClassifyPollUs());
+  q->qpWatchMs = (int)std::max<int64_t>(0, ncclParamGinQ4QpWatchMs());
+  q->asyncResult = ncclGinQ4AsyncResult;
+  NCCLCHECKGOTO(ncclCudaHostCalloc(&q->rec_h, NCCL_GIN_GDAKI_Q4_NSLOTS), ret, fail);
+  CUDACHECKGOTO(cudaHostGetDevicePointer((void**)&q->rec_d, q->rec_h, 0), ret, fail);
+  NCCLCHECKGOTO(ncclCudaCalloc(&q->dev, 1, nullptr), ret, fail);
+  memset(&init, 0, sizeof(init));
+  init.mbx = q->rec_d;
+  init.nslots = NCCL_GIN_GDAKI_Q4_NSLOTS;
+  init.late_read_ns = (uint32_t)std::max<int64_t>(0, ncclParamGinQ4LateReadUs()) * 1000u;
+  NCCLCHECKGOTO(ncclCudaMemcpy<struct ncclGinGdakiQ4>(q->dev, &init, 1), ret, fail);
+  *out = q;
+  return ncclSuccess;
+fail:
+  if (q->dev) ncclCudaFree(q->dev, nullptr);
+  if (q->rec_h) ncclCudaHostFree(q->rec_h);
+  delete q;
+  return ret;
+}
+
+static void gdakiQ4Start(struct gdakiQ4Host* q) {
+  if (!q) return;
+  q->th = std::thread(gdakiQ4Watch, q);
+  GIN_TS_NOTE("GIN/Q4: device error classification ON rank=%d mailbox=%d x %zu B host-mapped poll_us=%d qpwatch_ms=%d "
+       "async_result=%s",
+       q->ctx->rank, NCCL_GIN_GDAKI_Q4_NSLOTS, sizeof(struct ncclGinGdakiQ4Record), q->pollUs, q->qpWatchMs,
+       q->asyncResult ? "gin" : "query-only");
+}
+
+// Stop (join) the mailbox watcher without freeing the mailbox: done before the recovery host is freed,
+// because the watcher's record handling reads the context's recovery host.
+static void gdakiQ4Stop(struct gdakiQ4Host* q) {
+  if (q && q->th.joinable()) {
+    q->stop.store(true, std::memory_order_release);
+    q->th.join();
+  }
+}
+
+static void gdakiQ4Free(struct gdakiQ4Host* q) {
+  if (!q) return;
+  if (q->th.joinable()) {
+    q->stop.store(true, std::memory_order_release);
+    q->th.join();
+  }
+  INFO(NCCL_NET, "GIN/Q4: mailbox closed: %d error record(s), %d timeout dump(s)", q->nErr, q->nDump);
+  if (q->dev) ncclCudaFree(q->dev, nullptr);
+  if (q->rec_h) ncclCudaHostFree(q->rec_h);
+  delete q;
+}
+
+// NCCL_GIN_GDAKI_CQ_TYPE -> qp_init_attr. Returns ncclInvalidUsage if the requested type cannot work here.
+static ncclResult_t gdakiQ4ApplyCqType(struct doca_gpu_verbs_qp_init_attr_hl* a, int rank) {
+#ifdef NCCL_GIN_TS_PRODUCTION
+  (void)a;
+  (void)rank;
+  return ncclSuccess;  // gin-harden: the diagnostic CQ shapes are not in the production build (stock ring CQ)
+#else
+  const char* s = getenv("NCCL_GIN_GDAKI_CQ_TYPE");
+  if (s == nullptr || *s == '\0' || strcmp(s, "ring") == 0) return ncclSuccess;  // stock
+  if (strcmp(s, "collapsed") == 0) {
+    a->cq_type = DOCA_GPUNETIO_VERBS_CQ_64B_COLLAPSED;
+    a->cq_collapsed = true;
+  } else if (strncmp(s, "collapsed_host", 14) == 0) {
+    const bool force = strcmp(s, "collapsed_host_force") == 0;
+    const bool gdr = doca_gpu_gdrcopy_is_supported();
+    if (!gdr && !force) {
+      WARN("GIN/Q4: NCCL_GIN_GDAKI_CQ_TYPE=collapsed_host refused on rank %d: GDRCopy is not available "
+           "(doca_gpu_gdrcopy_is_supported()=0). DOCA needs it to map the GPU-resident device QP array to the CPU "
+           "(doca_gpu_verbs_export_multi_qps_dev: need_cpu_mapping -> assert(support_gdrcopy), "
+           "DOCA_GPU_MEM_TYPE_GPU_CPU) so the CPU progress thread can advance cqe_ci.",
+           rank);
+      return ncclInvalidUsage;
+    }
+    a->cq_type = DOCA_GPUNETIO_VERBS_CQ_64B_COLLAPSED_HOST;
+    a->cq_collapsed = true;
+  } else {
+    WARN("GIN/Q4: unknown NCCL_GIN_GDAKI_CQ_TYPE=%s (ring|collapsed|collapsed_host)", s);
+    return ncclInvalidUsage;
+  }
+  WARN("GIN/Q4: GDAKI CQ type %s (cq_type=%d cq_collapsed=%d) rank=%d", s, (int)a->cq_type, (int)a->cq_collapsed, rank);
+  return ncclSuccess;
+#endif
+}
+
+// ---------------------------------------------------------------------------
+// GIN recovery (research build; default OFF), layered on the Q4 classifier above.
+//   NCCL_GIN_FAULT_RECOVERY=1            enable (needs NCCL_GIN_FAULT_CLASSIFY=1; user devComms only)
+//   NCCL_GIN_RECOVERY_DRAIN_MS=<ms>      bound on waiting for the CQE of the last posted WQE (1000)
+//   NCCL_GIN_FAULT_INJECT_WAIT_S=<s>     multi-shot hook: bound on waiting for the next commit (60)
+// Host API (nccl.h): ncclGinFaultQuery, ncclGinRecoverPrepare, ncclGinRecoverCommit,
+// ncclGinRecoverAbort. Design and safety argument: harness/gpu-initiated/gin_recovery/
+// RECOVERY_DESIGN.md. In short: with every GPU producer stopped, Prepare pauses the CPU-proxy
+// doorbell thread for this context, checks that each peer QP is quiescent (no half-posted or
+// unsubmitted WQE), moves it to ERR and waits for the CQE of its last WQE; Commit (after the
+// peer did the same) resets the QP (2RST), restarts the device WQE index space at 0 with
+// cqe_rsvd advanced by the WQEs of the ending epoch, zeroes the doorbell record / proxy
+// mailbox / proxy counter and the get tickets, and reconnects with the connect-time attributes
+// and fresh PSNs (INIT/RTR/RTS), then clears the Q4 error state.
+// ---------------------------------------------------------------------------
+NCCL_PARAM(GinFaultRecovery, "GIN_FAULT_RECOVERY", 0);
+NCCL_PARAM(GinRecoveryDrainMs, "GIN_RECOVERY_DRAIN_MS", 1000);
+#ifndef NCCL_GIN_TS_PRODUCTION
+NCCL_PARAM(GinFaultInjectWaitS, "GIN_FAULT_INJECT_WAIT_S", 60);
+#endif
+// gin-harden: bound on one device-state copy of a recovery (async copy + event polling, never an unbounded
+// stream synchronize). A copy that misses it declines the round.
+NCCL_PARAM(GinTsCopyMs, "GIN_TS_COPY_MS", 2000);
+// Diagnostic A/B only (default: the design). NCCL_GIN_RECOVERY_DIAG=doca_cqe_rsvd sets cqe_rsvd to the
+// ending epoch's WQE count like doca_gpu_verbs_reset_tracking_and_memory (not cumulative);
+// =keep_proxy_db leaves the CPU-proxy doorbell mailbox (cpu_db) and its counter unreset;
+// =keep_gpu_dbr leaves the GPU-memory doorbell record unreset (GPU doorbell mode);
+// =keep_gpu_pi leaves the device sq_wqe_pi (GPU doorbell producer index) unreset.
+static int gdakiRecDiag() {
+#ifdef NCCL_GIN_TS_PRODUCTION
+  return 0;  // gin-harden: no negative controls in the production build
+#else
+  static int v = -1;
+  if (v < 0) {
+    const char* e = getenv("NCCL_GIN_RECOVERY_DIAG");
+    v = (e && strcmp(e, "doca_cqe_rsvd") == 0) ? 1 : (e && strcmp(e, "keep_proxy_db") == 0) ? 2 :
+        (e && strcmp(e, "keep_gpu_dbr") == 0) ? 3 : (e && strcmp(e, "keep_gpu_pi") == 0) ? 4 : 0;
+    if (v) WARN("GIN/REC: DIAGNOSTIC mode NCCL_GIN_RECOVERY_DIAG=%s (breaks the recovery on purpose)", e);
+  }
+  return v;
+#endif
+}
+extern thread_local void* ncclGinRecCommKey;  // gin/gin_host.cc
+
+struct gdakiRecQp {
+  bool used = false;             // a peer-connected main QP of this rank
+  int ctxIdx = 0, peer = 0, qpIdx = 0;
+  struct gdaki_exch_info exch;   // connect-time info of the peer QP (copy)
+  uint8_t lag = 0;               // connect-time LAG TX port affinity
+  struct doca_gpu_dev_verbs_qp snap;  // device QP struct at Prepare
+  uint64_t epochWqes = 0;        // sq_rsvd_index at Prepare = WQEs of the ending epoch
+  uint32_t newSqPsn = 0;
+  int dbMode = 0;                // GDAKI_REC_DB_* at Prepare (v2)
+};
+
+struct gdakiRecHost {
+  void* commKey = nullptr;
+  struct gdaki_context* ctx = nullptr;
+  std::vector<gdakiRecQp> qps;   // indexed by qp_idx = rank + ctx * nranks
+  std::atomic<int> paused{0};    // proxy progress skips this context while set
+  std::atomic<int> busy{0};      // proxy progress calls inside this context
+  std::mutex opMu;               // Prepare/Commit bodies vs. the test hook's fire
+  int state = 0;                 // 0 idle, 1 prepared
+  int preparedPeer = -1;
+  cudaStream_t stream = nullptr; // private non-blocking stream: never waits for user kernels
+  uint8_t* pinned = nullptr;     // pinned staging for D2H/H2D copies
+  size_t pinnedSize = 0;
+  std::mt19937 rng;
+  int nCommits = 0, nAborts = 0;
+  // multi-shot test hook (NCCL_GIN_FAULT_INJECT with a list)
+  std::thread hookTh;
+  std::mutex hookMu;
+  std::condition_variable hookCv;
+  bool hookStop = false;
+  uint64_t commits = 0;
+  int armShot = 0, armTotal = 0;  // delay -1: Commit fires this shot after RTS, before it returns
+  cudaStream_t hookStream = nullptr;  // S2 test trigger (NCCL_GIN_FAULT_INJECT_AT): its poll stream and staging
+  uint64_t* hookPin = nullptr;
+  struct gdakiTs* ts = nullptr;   // GIN transparent recovery S1: nullptr unless NCCL_GIN_FAULT_TRANSPARENT=1
+  // gin-harden
+  int nranks = 0;                 // cached at creation: a helper never reads the collComm, which the communicator's
+                                  // teardown closes (an orphaned helper may outlive it, gdakiTsJoinBounded)
+  cudaEvent_t copyEv = nullptr;   // completion of the last device-state copy (gdakiRecCopyWait)
+  bool copyStuck = false;         // a copy missed NCCL_GIN_TS_COPY_MS; later copies fail until copyEv completes
+  int copyMs = 2000;
+  std::atomic<int> nCopyTimeouts{0};
+  std::atomic<int64_t> fwSinceUs{0};      // start of the firmware-command phase the helper is in, 0 outside one
+  std::atomic<const char*> fwPhase{""};   // its name (gdakiRecFwGuard)
+  std::atomic<int> fwOverrun{0};          // the watchdog saw a phase longer than NCCL_GIN_TS_FW_MS: set once (the user
+                                          // devComm word is raised then and every later round declines)
+  std::atomic<uint64_t> posterWord{0};    // the user devComm's abort word | 1, for parked posters (gdakiTsPosterWordStep)
+  uint64_t posterWordDone = 0;            // helper only: the value the gates hold
+};
+
+static std::mutex gdakiRecRegMu;
+static std::vector<struct gdakiRecHost*> gdakiRecReg;
+static std::vector<void*> gdakiTsOrphanColl;  // gin-harden: collComms an orphaned helper may still read (gdakiRecRegMu)
+
+// Proxy progress guard: with recovery off (rec == nullptr) it does nothing.
+struct gdakiRecProgressGuard {
+  struct gdakiRecHost* r;
+  bool skip = false;
+  explicit gdakiRecProgressGuard(struct gdakiRecHost* r_) : r(r_) {
+    if (r == nullptr) return;
+    r->busy.fetch_add(1, std::memory_order_seq_cst);
+    if (r->paused.load(std::memory_order_seq_cst)) {
+      r->busy.fetch_sub(1, std::memory_order_seq_cst);
+      r = nullptr;
+      skip = true;
+    }
+  }
+  ~gdakiRecProgressGuard() {
+    if (r) r->busy.fetch_sub(1, std::memory_order_seq_cst);
+  }
+};
+
+static ncclResult_t gdakiRecPause(struct gdakiRecHost* r) {
+  r->paused.store(1, std::memory_order_seq_cst);
+  const double t0 = gdakiQ4MonoMs();
+  while (r->busy.load(std::memory_order_seq_cst) != 0) {
+    if (gdakiQ4MonoMs() - t0 > 1000) {
+      r->paused.store(0, std::memory_order_seq_cst);
+      WARN("GIN/REC: proxy progress did not leave the context within 1 s");
+      return ncclInternalError;
+    }
+    std::this_thread::yield();
+  }
+  return ncclSuccess;
+}
+
+static void gdakiRecResume(struct gdakiRecHost* r) { r->paused.store(0, std::memory_order_seq_cst); }
+
+// gin-harden: the firmware-phase watchdog times single commands (see gdakiRecFwGuard below): a mark restarts the clock
+// of the phase the calling thread is inside, if any.
+static thread_local struct gdakiRecHost* gdakiRecFwCur = nullptr;  // the host whose phase this thread is inside
+static inline void gdakiRecFwMarkHost(struct gdakiRecHost* r) {
+  if (r != nullptr && r->fwSinceUs.load(std::memory_order_acquire) != 0)
+    r->fwSinceUs.store((int64_t)(gdakiQ4MonoMs() * 1000.0), std::memory_order_release);
+}
+static inline void gdakiRecFwMark(struct gdakiRecHost* r) { gdakiRecFwMarkHost(r != nullptr ? r : gdakiRecFwCur); }
+// gin-harden: every device-state copy of the recovery is bounded. The copy is issued asynchronously on the private
+// stream, an event is recorded after it and polled until NCCL_GIN_TS_COPY_MS (the copy engine does not need SMs, so a
+// GPU full of application kernels does not delay it; a stalled stream does). A copy that misses the bound fails and the
+// round declines. The late copy stays queued on the stream and may still read or write the staging buffer, so every
+// later copy fails at once (without queueing behind it) until its event has completed (gdakiRecCopyBlocked).
+static bool gdakiRecCopyBlocked(struct gdakiRecHost* r) {
+  if (!r->copyStuck) return false;
+  if (r->copyEv != nullptr && cudaEventQuery(r->copyEv) == cudaSuccess) {
+    r->copyStuck = false;
+    GIN_TS_NOTE("GIN/TS: rank %d: the late device-state copy completed; copies are allowed again mono_ms=%.3f",
+                r->ctx ? r->ctx->rank : -1, gdakiQ4MonoMs());
+    return false;
+  }
+  return true;
+}
+
+static ncclResult_t gdakiRecCopyWait(struct gdakiRecHost* r, const char* what, size_t n) {
+  if (r->copyEv == nullptr) {  // created lazily (also used by the application-thread recovery API)
+    if (cudaEventCreateWithFlags(&r->copyEv, cudaEventDisableTiming) != cudaSuccess) return ncclUnhandledCudaError;
+  }
+  CUDACHECK(cudaEventRecord(r->copyEv, r->stream));
+  const double t0 = gdakiQ4MonoMs();
+  gdakiRecFwMark(r);  // a copy is bounded by itself (NCCL_GIN_TS_COPY_MS): not charged to a firmware phase
+  for (uint32_t spins = 0;; spins++) {
+    const cudaError_t q = cudaEventQuery(r->copyEv);
+    if (q == cudaSuccess) {
+      gdakiRecFwMark(r);
+      return ncclSuccess;
+    }
+    if (q != cudaErrorNotReady) {
+      WARN("GIN/TS: device-state copy (%s, %zu B) failed: %s", what, n, cudaGetErrorString(q));
+      return ncclUnhandledCudaError;
+    }
+    const double el = gdakiQ4MonoMs() - t0;
+    if (el > (double)r->copyMs) {
+      r->copyStuck = true;
+      r->nCopyTimeouts.fetch_add(1, std::memory_order_relaxed);
+      WARN("GIN/TS: rank %d: device-state copy (%s, %zu B) not complete after %d ms (NCCL_GIN_TS_COPY_MS); the round "
+           "declines mono_ms=%.3f", r->ctx ? r->ctx->rank : -1, what, n, r->copyMs, gdakiQ4MonoMs());
+      return ncclSystemError;
+    }
+    if (el < 2.0) std::this_thread::yield();  // a copy normally takes tens of microseconds
+    else std::this_thread::sleep_for(std::chrono::microseconds(50));
+  }
+}
+
+static ncclResult_t gdakiRecD2H(struct gdakiRecHost* r, void* dst, const void* src, size_t n) {
+  if (n > r->pinnedSize) return ncclInternalError;
+  if (gdakiRecCopyBlocked(r)) return ncclSystemError;
+  CUDACHECK(cudaMemcpyAsync(r->pinned, src, n, cudaMemcpyDeviceToHost, r->stream));
+  NCCLCHECK(gdakiRecCopyWait(r, "device to host", n));
+  memcpy(dst, r->pinned, n);
+  return ncclSuccess;
+}
+
+static ncclResult_t gdakiRecH2D(struct gdakiRecHost* r, void* dst, const void* src, size_t n) {
+  if (n > r->pinnedSize) return ncclInternalError;
+  if (gdakiRecCopyBlocked(r)) return ncclSystemError;
+  memcpy(r->pinned, src, n);
+  CUDACHECK(cudaMemcpyAsync(dst, r->pinned, n, cudaMemcpyHostToDevice, r->stream));
+  NCCLCHECK(gdakiRecCopyWait(r, "host to device", n));
+  return ncclSuccess;
+}
+
+// gin-harden: a firmware-command phase of the helper (QP state changes, QUERY_QP). A firmware command cannot be
+// interrupted; the Q4 watcher's watchdog (gdakiTsWatchdog) reads how long the helper has been inside the current phase
+// and, past NCCL_GIN_TS_FW_MS, releases the device threads with an error and surfaces the fault; the round then
+// declines as soon as the command returns (gdakiTsFwCheck). Test switch (research build):
+// NCCL_GIN_TS_TEST_FW_DELAY=<ms>@<commit|2ERR|QUERY_QP> sleeps <ms> once, inside the first such phase of a round.
+// The watchdog times single commands, not whole phases: every firmware command inside a phase, and every device-state
+// copy (bounded by NCCL_GIN_TS_COPY_MS < NCCL_GIN_TS_FW_MS on its own), restarts the clock (gdakiRecFwMark).
+static void gdakiRecTestFwDelay(struct gdakiRecHost* r, const char* phase);  // below (test switch)
+struct gdakiRecFwGuard {
+  struct gdakiRecHost* r;
+  const char* prevPhase = "";
+  int64_t prevSince = 0;  // a nested phase (2ERR inside a failing commit) gives the outer phase its start back
+  gdakiRecFwGuard(struct gdakiRecHost* r_, const char* phase) : r(r_) {
+    if (r == nullptr) return;
+    prevPhase = r->fwPhase.load(std::memory_order_relaxed);
+    prevSince = r->fwSinceUs.load(std::memory_order_acquire);
+    if (prevSince == 0) {
+      r->fwPhase.store(phase, std::memory_order_relaxed);
+      r->fwSinceUs.store((int64_t)(gdakiQ4MonoMs() * 1000.0), std::memory_order_release);
+      gdakiRecFwCur = r;
+    }
+    gdakiRecTestFwDelay(r, phase);
+  }
+  ~gdakiRecFwGuard() {
+    if (r == nullptr) return;
+    if (prevSince == 0) {
+      r->fwSinceUs.store(0, std::memory_order_release);
+      gdakiRecFwCur = nullptr;
+    } else {
+      r->fwPhase.store(prevPhase, std::memory_order_relaxed);
+    }
+  }
+};
+
+// A CQE at ring position `pos` belongs to the current lap and to WQE `wqeIdx` (ring CQ).
+static bool gdakiRecCqeCurrent(const uint8_t* cqe, uint64_t pos, uint32_t cqeNum, uint64_t wqeIdx) {
+  const uint16_t wc = ((uint16_t)cqe[60] << 8) | cqe[61];
+  const uint8_t opown = cqe[63];
+  const bool owner = (opown & DOCA_GPUNETIO_IB_MLX5_CQE_OWNER_MASK) != 0;
+  return owner == ((pos & cqeNum) != 0) && wc == (uint16_t)(wqeIdx & 0xffff);
+}
+
+static void gdakiRecFind(void* key, std::vector<struct gdakiRecHost*>& out) {
+  // GIN transparent recovery: a helper thread acts on its own GDAKI context only.
+  if (gdakiTsOwner != nullptr) {
+    if (gdakiTsOwner->commKey == key) out.push_back(gdakiTsOwner);
+    return;
+  }
+  std::lock_guard<std::mutex> lk(gdakiRecRegMu);
+  for (auto* r : gdakiRecReg)
+    if (r->commKey == key) out.push_back(r);
+}
+
+static uint32_t gdakiRecQpn(struct doca_gpu_verbs_qp_hl* q) {
+  uint32_t qpn = 0;
+  doca_verbs_qp_get_qpn(q->qp, &qpn);
+  return qpn;
+}
+
+static ncclResult_t gdakiRecModify(struct doca_gpu_verbs_qp_hl* q, enum doca_verbs_qp_state st) {
+  doca_verbs_qp_attr_t* a = nullptr;
+  if (doca_verbs_qp_attr_create(&a) != DOCA_SUCCESS) return ncclSystemError;
+  doca_verbs_qp_attr_set_next_state(a, st);
+  gdakiRecFwMark(nullptr);  // gin-harden: one firmware command (the phase's clock restarts)
+  doca_error_t e = doca_verbs_qp_modify(q->qp, a, DOCA_VERBS_QP_ATTR_NEXT_STATE);
+  doca_verbs_qp_attr_destroy(a);
+  if (e != DOCA_SUCCESS) {
+    WARN("GIN/REC: modify qpn=%#x -> state %d failed (%d)", gdakiRecQpn(q), (int)st, (int)e);
+    return ncclSystemError;
+  }
+  return ncclSuccess;
+}
+
+// gin-pair-reset: the GIN contexts a transparent-recovery round covers (bit c = context c). Only the helper thread sets
+// it, for one round (gdakiTsScopeGuard); every other thread, and the helper outside a round, walks every context.
+#define GDAKI_TS_SCOPE_ALL 0xffffffffu
+static thread_local uint32_t gdakiTsScope = GDAKI_TS_SCOPE_ALL;
+
+// The peer-connected QPs of `r` to `peer`, in GIN-context order (gin-pair-reset: those of the current scope).
+template <typename F>
+static void gdakiRecForPeer(struct gdakiRecHost* r, int peer, F fn) {
+  const int nranks = r->nranks;
+  for (int c = 0; c < r->ctx->nContexts; c++) {
+    if (c < 32 && (gdakiTsScope & (1u << c)) == 0) continue;
+    const int i = peer + c * nranks;
+    if (i < (int)r->qps.size() && r->qps[i].used) fn(r->qps[i], r->ctx->gqps[i]);
+  }
+}
+
+static void gdakiRecAllToErr(struct gdakiRecHost* r, int peer) {
+  gdakiRecFwGuard fw(r, "2ERR");  // gin-harden: firmware-command phase (watchdog)
+  gdakiRecForPeer(r, peer, [&](gdakiRecQp&, struct doca_gpu_verbs_qp_hl* q) { (void)gdakiRecModify(q, DOCA_VERBS_QP_STATE_ERR); });
+}
+
+// GIN recovery v2 (GPU doorbells): the doorbell path of a GDAKI QP, as DOCA resolved it at export.
+//   CPU proxy (PeerMappingOverride off): the GPU publishes its producer index in the host-mapped
+//     mailbox cpu_db; a CPU thread (NCCL "GIN P" progress thread) writes the host-memory doorbell
+//     record and rings the UAR doorbell.
+//   GPU_SM_DB (UAR mapped into the GPU, e.g. PeerMappingOverride=1): the GPU itself rings the UAR
+//     doorbell and writes the doorbell record, which lives in GPU memory; sq_wqe_pi tracks the last
+//     index it submitted. There is no CPU-side doorbell state.
+// Other modes (BlueFlame, no-DBR, SW-emulated DBR, free-flow proxy) are not supported by recovery.
+enum { GDAKI_REC_DB_UNSUPPORTED = 0, GDAKI_REC_DB_CPU_PROXY = 1, GDAKI_REC_DB_GPU = 2 };
+static int gdakiRecDbMode(struct doca_gpu_verbs_qp* v) {
+  const int h = (int)v->qp_cpu->nic_handler;
+  if (v->cpu_proxy && h == DOCA_GPUNETIO_VERBS_NIC_HANDLER_CPU_PROXY &&
+      v->send_dbr_mode_ext == DOCA_GPUNETIO_VERBS_SEND_DBR_MODE_EXT_VALID_DBR)
+    return GDAKI_REC_DB_CPU_PROXY;
+  if (!v->cpu_proxy && h == DOCA_GPUNETIO_VERBS_NIC_HANDLER_GPU_SM_DB &&
+      v->send_dbr_mode_ext == DOCA_GPUNETIO_VERBS_SEND_DBR_MODE_EXT_VALID_DBR)
+    return GDAKI_REC_DB_GPU;
+  return GDAKI_REC_DB_UNSUPPORTED;
+}
+static const char* gdakiNicHandlerStr(int h) {
+  switch (h) {
+  case DOCA_GPUNETIO_VERBS_NIC_HANDLER_CPU_PROXY: return "CPU_PROXY";
+  case DOCA_GPUNETIO_VERBS_NIC_HANDLER_GPU_SM_DB: return "GPU_SM_DB";
+  case DOCA_GPUNETIO_VERBS_NIC_HANDLER_GPU_SM_BF: return "GPU_SM_BF";
+  case DOCA_GPUNETIO_VERBS_NIC_HANDLER_GPU_SM_NO_DBR: return "GPU_SM_NO_DBR";
+  case DOCA_GPUNETIO_VERBS_NIC_HANDLER_CPU_PROXY_FREE_FLOW: return "CPU_PROXY_FREE_FLOW";
+  default: return "?";
+  }
+}
+
+// Once per GDAKI context: the doorbell mode DOCA chose for its main QPs (the doorbell mode is not
+// logged anywhere in stock NCCL/DOCA). WARN when the Q4 classifier or recovery is on, INFO otherwise.
+static void gdakiDbModeLog(struct gdaki_context* g, bool needsProxyProgress) {
+  int nGpu = 0, nProxy = 0, nOther = 0, total = 0;
+  const char* first = "?";
+  const int nq = g->nContexts * (g->collComm->nranks + 1);
+  for (int i = 0; i < nq; i++) {
+    struct doca_gpu_verbs_qp_hl* q = g->gqps ? g->gqps[i] : nullptr;
+    if (q == nullptr || q->qp_gverbs == nullptr || q->qp_gverbs->qp_cpu == nullptr) continue;
+    const int h = (int)q->qp_gverbs->qp_cpu->nic_handler;
+    if (total == 0) first = gdakiNicHandlerStr(h);
+    total++;
+    if (h == DOCA_GPUNETIO_VERBS_NIC_HANDLER_GPU_SM_DB && !q->qp_gverbs->cpu_proxy) nGpu++;
+    else if (h == DOCA_GPUNETIO_VERBS_NIC_HANDLER_CPU_PROXY && q->qp_gverbs->cpu_proxy) nProxy++;
+    else nOther++;
+  }
+  const bool loud = ncclParamGinFaultClassify() || ncclParamGinFaultRecovery();
+  const char* mode = (nGpu == total) ? "GPU" : (nProxy == total) ? "CPU_PROXY" : "MIXED";
+  if (loud)
+    GIN_TS_NOTE("GIN/GDAKI: doorbell mode=%s rank=%d user_ctx=%d main_qps=%d gpu_sm_db=%d cpu_proxy=%d other=%d "
+         "first_nic_handler=%s needsProxyProgress=%d",
+         mode, g->rank, (int)ncclGinFaultUserCtx, total, nGpu, nProxy, nOther, first, (int)needsProxyProgress);
+  else
+    INFO(NCCL_NET | NCCL_INIT, "GIN/GDAKI: doorbell mode=%s rank=%d main_qps=%d gpu_sm_db=%d cpu_proxy=%d other=%d "
+         "needsProxyProgress=%d", mode, g->rank, total, nGpu, nProxy, nOther, (int)needsProxyProgress);
+}
+
+static void gdakiRecRegister(struct gdaki_context* g) {
+  struct gdakiRecHost* r = g->rec;
+  if (r == nullptr) return;
+  if (g->q4 == nullptr) {
+    WARN("GIN/REC: NCCL_GIN_FAULT_RECOVERY=1 needs NCCL_GIN_FAULT_CLASSIFY=1; recovery disabled on rank %d", g->rank);
+    gdakiTsFree(r);
+    delete r;
+    g->rec = nullptr;
+    return;
+  }
+  uint32_t cqeMax = 1;
+  while (cqeMax < g->qp_sq_size) cqeMax <<= 1;
+  r->pinnedSize = std::max<size_t>((size_t)cqeMax * DOCA_GPUNETIO_VERBS_CQE_SIZE, sizeof(struct doca_gpu_dev_verbs_qp)) + 4096;
+  if (cudaStreamCreateWithFlags(&r->stream, cudaStreamNonBlocking) != cudaSuccess ||
+      cudaHostAlloc((void**)&r->pinned, r->pinnedSize, cudaHostAllocDefault) != cudaSuccess) {
+    WARN("GIN/REC: could not allocate the recovery stream/staging; recovery disabled on rank %d", g->rank);
+    if (r->stream) cudaStreamDestroy(r->stream);
+    gdakiTsFree(r);
+    delete r;
+    g->rec = nullptr;
+    return;
+  }
+  std::random_device rd;
+  r->rng.seed(rd() ^ (uint32_t)clockNano() ^ ((uint32_t)g->rank << 24));
+  r->copyMs = (int)std::max<int64_t>(10, ncclParamGinTsCopyMs());  // gin-harden
+  if (cudaEventCreateWithFlags(&r->copyEv, cudaEventDisableTiming) != cudaSuccess) r->copyEv = nullptr;  // lazily later
+  int n = 0;
+  for (auto& q : r->qps) n += q.used ? 1 : 0;
+  {
+    std::lock_guard<std::mutex> lk(gdakiRecRegMu);
+    gdakiRecReg.push_back(r);
+  }
+  GIN_TS_NOTE("GIN/REC: recovery ON rank=%d peer_qps=%d contexts=%d drain_ms=%ld (API: ncclGinRecoverPrepare/Commit)", g->rank,
+       n, g->nContexts, (long)ncclParamGinRecoveryDrainMs());
+  gdakiTsStart(r);  // GIN transparent recovery S1 (only if gdakiTsSetup enabled it)
+}
+
+// gin-harden: returns true if the context must be kept (a detached recovery helper is still inside a firmware
+// command and uses r, its stream, its staging buffer, q4 and the QPs): nothing is freed then.
+static bool gdakiRecFree(struct gdakiRecHost* r) {
+  if (r == nullptr) return false;
+  {  // gin-harden: unregistered first (ncclGinGetRecoveryStats reads r->ts under this lock)
+    std::lock_guard<std::mutex> lk(gdakiRecRegMu);
+    gdakiRecReg.erase(std::remove(gdakiRecReg.begin(), gdakiRecReg.end(), r), gdakiRecReg.end());
+  }
+  if (gdakiTsFree(r)) return true;  // GIN transparent recovery: stop the helper before anything it uses goes away
+  {
+    std::lock_guard<std::mutex> lk(r->hookMu);
+    r->hookStop = true;
+  }
+  r->hookCv.notify_all();
+  if (r->hookTh.joinable()) r->hookTh.join();
+  if (r->hookStream) cudaStreamDestroy(r->hookStream);
+  if (r->hookPin) cudaFreeHost(r->hookPin);
+  // gin-harden: a late copy may still be queued on the stream and use the staging buffer: wait for it (bounded),
+  // else keep the buffer and the stream (leaked, with a WARN) rather than free memory a copy engine may still touch.
+  if (r->copyStuck && r->copyEv != nullptr) {
+    const double t0 = gdakiQ4MonoMs();
+    while (cudaEventQuery(r->copyEv) == cudaErrorNotReady && gdakiQ4MonoMs() - t0 < 10000.0)
+      std::this_thread::sleep_for(std::chrono::milliseconds(1));
+    if (cudaEventQuery(r->copyEv) == cudaErrorNotReady) {
+      // its destination is device state of this context (gate, QP, classifier): keep the whole context
+      WARN("GIN/REC: a late device-state copy is still queued after 10 s; the GDAKI context is kept (not freed)");
+      return true;
+    }
+  }
+  if (r->copyEv) cudaEventDestroy(r->copyEv);  // gin-harden
+  if (r->stream) cudaStreamDestroy(r->stream);
+  if (r->pinned) cudaFreeHost(r->pinned);
+  INFO(NCCL_NET, "GIN/REC: closed: %d commit(s), %d abort(s)", r->nCommits, r->nAborts);
+  delete r;
+  return false;
+}
