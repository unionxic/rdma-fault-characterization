+// ---------------------------------------------------------------------------
+// GIN transparent recovery S1/S2 (research build): a wait that holds across a recovery.
+// The ticket is a LOGICAL WQE index (lbase + physical index when it was taken), which a recovery
+// does not change: the host publishes lbase(new) = lbase(old) + U, where [0, U) of the ending epoch
+// were executed by the responder and [U, S) are re-posted at physical [0, S - U). Inside the counted
+// region a waiter maps it: below lbase = done; else physical = logical - lbase. On an error CQE the
+// waiter publishes the Q4 record (once per epoch, without the sticky error), leaves the region and
+// parks until a new stable epoch, or a decline. Bounds: a caller with a timeout gets ncclTimeout at
+// its own deadline, parked time included (the operation may still complete, as with a stock timeout);
+// holding is also bounded by the gate's waitMs (give-up through the commit point with the host,
+// tsGiveUp; one more bound after a lost give-up). A failed QP (declined, or a won give-up, which
+// poisons it) returns ncclRemoteError and raises the sticky error, as Q4 did.
+// ---------------------------------------------------------------------------
+// S2 (review): a poster whose slot wait saw an error CQE reports it once per epoch (the same dedupe as a
+// waiter, g->reported), without the sticky error: the helper recovers or declines, and a waiter stranded one
+// ring past the CQ window's consumer index is released by the epoch change. Declared before the post paths.
+__device__ __noinline__ static void tsSwErrReport(ncclGinCtx ctx, struct ncclGinGdakiQ4* q4, doca_gpu_dev_verbs_qp* qp,
+                                                  int peer) {
+  if (q4 == nullptr) return;
+  struct ncclGinTsGate* g = tsGate(qp);
+  const unsigned long long w = tsWordLoad(tsWord(qp));
+  if (tsWordFailed(w)) return;  // declined or poisoned already: every later wait fails anyway
+  const uint32_t epoch = tsWordEpoch(w) & ~1u;
+  if (atomicMax(&g->reported, epoch + 2u) >= epoch + 2u) return;
+  // The ticket is the CQ's software consumer index: the oldest unconsumed CQE, which the slot wait did not advance
+  // past the error it saw, so the window scan starts at the root (a newer index would put the root outside the
+  // one-ring window and find nothing current, b4b).
+  struct doca_gpu_dev_verbs_cq* cq = doca_gpu_dev_verbs_qp_get_cq_sq(qp);
+  const uint64_t t = *(volatile uint64_t*)&cq->cqe_ci;
+  q4Report(ctx, q4, qp, peer, t, NCCL_GIN_Q4_KIND_ERR_CQE, NCCL_GIN_Q4_PATH_POST, /*sticky=*/false, epoch);
+}
+
+NCCL_DEVICE_INLINE static ncclResult_t tsFail(ncclGinCtx ctx, struct ncclGinGdakiQ4* q4) {
+  if (q4 != nullptr) {
+    const uint32_t c = ctx.contextId < NCCL_GIN_GDAKI_Q4_MAX_CTX ? ctx.contextId : NCCL_GIN_GDAKI_Q4_MAX_CTX - 1;
+    atomicExch(&q4->sticky[c], 1u);
+  }
+  return ncclRemoteError;
+}
+
+// Wait for logical WQE `lticket`. entered: the caller holds the counted region for `epoch`, in which
+// the ticket is physical index `phys` (tsTicket with stay); else the region is entered here. With
+// HasTimeout, the caller's deadline (startCycle + timeoutCycles) covers everything, parked time included.
+template <bool HasTimeout, enum doca_gpu_dev_verbs_resource_sharing_mode doca_sharing_mode>
+__device__ __noinline__ static ncclResult_t tsPoll(ncclGinCtx ctx, struct ncclGinGdakiQ4* q4, doca_gpu_dev_verbs_qp* qp,
+                                                   int peer, uint64_t lticket, bool entered, uint32_t epoch,
+                                                   uint64_t phys, cuda::memory_order ord, uint32_t* abortFlag,
+                                                   uint64_t startCycle, uint64_t timeoutCycles, uint8_t path) {
+  using nccl::utility::testAbort;
+  struct ncclGinTsGate* g = tsGate(qp);
+  const bool noRebase = (g->flags & NCCL_GIN_TS_F_DIAG_NOREBASE) != 0;
+  struct ncclGinTsDeadline dl;
+  dl.start = startCycle;
+  dl.cycles = HasTimeout ? timeoutCycles : 0;
+  dl.abortFlag = abortFlag;  // gin-harden: a user devComm's own word releases parked waiters with an error
+  bool in = entered, havePhys = entered;
+  bool tryFirst = !entered;  // S2: one attempt at the region before parking (the fast path of wait())
+  uint64_t t = phys;
+  uint32_t steps = 0, abortSteps = 0;
+  NVCC_PRAGMA_UNROLL_DISABLED
+  while (true) {
+    if (!in) {
+      if (!tryFirst) {
+        const int pr = tsParkStable(qp, NCCL_GIN_TS_EPOCH_ANY, q4, ctx.contextId, dl);
+        if (pr == NCCL_GIN_TS_TIMEOUT) return ncclTimeout;  // the caller's bound; the operation may still complete
+        if (pr != NCCL_GIN_TS_OK) return tsFail(ctx, q4);   // declined / gave up
+      }
+      tryFirst = false;
+      uint32_t e = NCCL_GIN_TS_EPOCH_ANY;
+      if (!tsPollEnter(qp, &e)) continue;
+      in = true;
+      epoch = e;
+      const uint64_t lb = tsLoadRelaxedSys64(&g->lbase);
+      if (!(noRebase && havePhys)) {  // the negative control keeps its first (pre-recovery) index
+        if (lticket < lb) {  // executed by the responder before a recovery: complete
+          tsPollLeave(qp);
+          cuda::atomic_thread_fence(ord, cuda::thread_scope_system);
+          return ncclSuccess;
+        }
+        t = lticket - lb;
+        havePhys = true;
+      }
+    }
+    const int status = doca_gpu_dev_verbs_poll_one_cq_at<doca_sharing_mode>(qp, t);
+    if (status == 0) {
+      tsPollLeave(qp);
+      cuda::atomic_thread_fence(ord, cuda::thread_scope_system);
+      return ncclSuccess;
+    }
+    // An error CQE for the ticket, or (checked every 1024 polls) the QP left the epoch because a
+    // recovery was started by someone else: report (once per epoch, inside the region: the root-cause
+    // scan reads cqe_ci and the CQ), leave, park until a new stable epoch, re-enter and re-map.
+    if (status < 0 || ((++steps & 0x3ffu) == 0 && tsWordHi(tsWordLoad(tsWord(qp))) != epoch)) {
+      if (status < 0 && q4 != nullptr && atomicMax(&g->reported, epoch + 2u) < epoch + 2u)
+        q4Report(ctx, q4, qp, peer, t, NCCL_GIN_Q4_KIND_ERR_CQE, path, /*sticky=*/false, epoch);
+      tsPollLeave(qp);
+      in = false;
+      const int pr = tsParkStable(qp, epoch, q4, ctx.contextId, dl);
+      if (pr == NCCL_GIN_TS_TIMEOUT) return ncclTimeout;
+      if (pr != NCCL_GIN_TS_OK) return tsFail(ctx, q4);
+      steps = 0;
+      continue;
+    }
+    if (tsExpired(dl)) {
+      if (q4 != nullptr)
+        q4Report(ctx, q4, qp, peer, t, NCCL_GIN_Q4_KIND_TIMEOUT_DUMP, path, /*sticky=*/false, epoch);
+      tsPollLeave(qp);
+      return ncclTimeout;
+    }
+    if (testAbort(abortFlag, abortSteps)) {
+      tsPollLeave(qp);
+      // gin-harden: released by a user devComm's own word (error bit): the operation did not complete
+      if (nccl::utility::abortIsError(abortFlag)) return tsFail(ctx, q4);
+      cuda::atomic_thread_fence(ord, cuda::thread_scope_system);
+      return ncclSuccess;
+    }
+  }
+}
