+NCCL_DEVICE_INLINE static void q4StoreSys32(uint32_t* p, uint32_t v) {
+  asm volatile("st.relaxed.sys.global.u32 [%0], %1;" ::"l"(p), "r"(v) : "memory");
+}
+
+// Copy one 64-byte CQE (written by the NIC) with system-scope loads.
+NCCL_DEVICE_INLINE static void q4ReadCqe(const uint8_t* cqe, uint8_t out[64]) {
+  NVCC_PRAGMA_UNROLL_DISABLED
+  for (int w = 0; w < 16; w++) {
+    uint32_t v = doca_gpu_dev_verbs_load_relaxed_sys_global((uint32_t*)(cqe + 4 * w));
+    out[4 * w + 0] = v & 0xff;
+    out[4 * w + 1] = (v >> 8) & 0xff;
+    out[4 * w + 2] = (v >> 16) & 0xff;
+    out[4 * w + 3] = (v >> 24) & 0xff;
+  }
+}
+
+// op_own byte of a CQE slot (system-scope load of the last dword).
+NCCL_DEVICE_INLINE static uint32_t q4CqeTailChunk(const uint8_t* cqe) {
+  return doca_gpu_dev_verbs_bswap32(doca_gpu_dev_verbs_load_relaxed_sys_global((uint32_t*)(cqe + 60)));
+}
+
+// Build and publish one record. kind = error CQE seen (-EIO) or timeout dump.
+// Called by the polling thread only, on the error / timeout path.
+// GIN transparent recovery: sticky=false publishes the record without the sticky context error (the
+// fault may still be recovered); tsEpoch is the gate epoch the reporting waiter held.
+NCCL_DEVICE_INLINE static void q4Report(ncclGinCtx ctx, struct ncclGinGdakiQ4* f, doca_gpu_dev_verbs_qp* qp,
+                                        int peer, uint64_t ticket, uint8_t kind, uint8_t path, bool sticky = true,
+                                        uint32_t tsEpoch = 0) {
+  const uint64_t gt = q4GlobalTimer();
+  struct doca_gpu_dev_verbs_cq* cq = doca_gpu_dev_verbs_qp_get_cq_sq(qp);
+  const uint8_t* base = (const uint8_t*)doca_gpu_dev_verbs_load_const((uintptr_t*)&cq->cqe_daddr);
+  const uint32_t cqe_num = doca_gpu_dev_verbs_load_const(&cq->cqe_num);
+  const uint64_t cqe_rsvd = doca_gpu_dev_verbs_load_const(&cq->cqe_rsvd);
+  const uint8_t cq_type = doca_gpu_dev_verbs_load_const((uint8_t*)&cq->cq_type);
+  const uint64_t cqe_ci = *(volatile uint64_t*)&cq->cqe_ci;
+  const bool collapsed = (cq_type & DOCA_GPUNETIO_VERBS_CQ_FLAG_COLLAPSED) != 0;
+
+  struct ncclGinGdakiQ4Record r;
+  uint32_t* rw = (uint32_t*)&r;
+  NVCC_PRAGMA_UNROLL_DISABLED
+  for (unsigned i = 0; i < sizeof(r) / 4; i++) rw[i] = 0;
+  r.kind = kind;
+  r.path = path;
+  r.cq_type = cq_type;
+  r.peer = (uint32_t)peer;
+  r.ctx_id = ctx.contextId;
+  r.cqe_num = cqe_num;
+  r.ticket = ticket;
+  r.cqe_ci = cqe_ci;
+  r.gtimer_ns = gt;
+  r.ts_epoch = tsEpoch;
+
+  uint64_t rootIdx = ticket;
+  bool rootStale = false;
+  if (base != nullptr) {
+    // CQE at the polled index (ring) / the single collapsed slot 0.
+    const uint8_t* polled = collapsed ? base : base + ((ticket + cqe_rsvd) & (cqe_num - 1)) * DOCA_GPUNETIO_VERBS_CQE_SIZE;
+    q4ReadCqe(polled, r.polled_cqe);
+    r.polled_opcode = r.polled_cqe[63] >> DOCA_GPUNETIO_VERBS_MLX5_CQE_OPCODE_SHIFT;
+    r.polled_wqe_counter = ((uint16_t)r.polled_cqe[60] << 8) | r.polled_cqe[61];
+    r.polled_syndrome = r.polled_cqe[55];
+    r.polled_vendor_err = r.polled_cqe[54];
+
+    if (!collapsed) {
+      // Ring CQ: every WQE owns the CQE at its index. The root cause is the first error CQE of
+      // the current generation in the not-yet-consumed window [cqe_ci, ticket].
+      uint64_t lo = cqe_ci;
+      if (ticket + 1 > cqe_num && lo < ticket + 1 - cqe_num) lo = ticket + 1 - cqe_num;
+      bool found = false, ticketCurrent = false;
+      NVCC_PRAGMA_UNROLL_DISABLED
+      for (uint64_t i = lo; i <= ticket; i++) {
+        const uint64_t iq = i + cqe_rsvd;
+        const uint32_t chunk = q4CqeTailChunk(base + (iq & (cqe_num - 1)) * DOCA_GPUNETIO_VERBS_CQE_SIZE);
+        const uint16_t wc = chunk >> 16;
+        const uint8_t opown = chunk & 0xff;
+        const bool current = !((opown & DOCA_GPUNETIO_IB_MLX5_CQE_OWNER_MASK) ^ !!(iq & cqe_num)) &&
+                             (wc == (uint16_t)(i & 0xffff));
+        if (!current) continue;
+        if (i == ticket) ticketCurrent = true;
+        const uint8_t op = opown >> DOCA_GPUNETIO_VERBS_MLX5_CQE_OPCODE_SHIFT;
+        if (op == DOCA_GPUNETIO_IB_MLX5_CQE_REQ_ERR || op == DOCA_GPUNETIO_IB_MLX5_CQE_RESP_ERR) {
+          if (!found) { rootIdx = i; found = true; }
+          r.n_err_window++;
+        } else {
+          r.n_ok_window++;
+        }
+      }
+      q4ReadCqe(base + ((rootIdx + cqe_rsvd) & (cqe_num - 1)) * DOCA_GPUNETIO_VERBS_CQE_SIZE, r.root_cqe);
+      // S2 (review): no error in the window and the ticket's own slot not written for this lap (a poster-side
+      // report, tsSwErrReport, may arrive before the NIC wrote the CQEs): the slot holds a CQE of an earlier
+      // lap, which must not be classified (it declined a recoverable fault once with class OTHER, b4b).
+      if (!found && !ticketCurrent) rootStale = true;
+    } else {
+      for (int b = 0; b < 64; b++) r.root_cqe[b] = r.polled_cqe[b];
+      const uint8_t op = r.polled_opcode;
+      if (op == DOCA_GPUNETIO_IB_MLX5_CQE_REQ_ERR || op == DOCA_GPUNETIO_IB_MLX5_CQE_RESP_ERR) r.n_err_window = 1;
+      else if (op != DOCA_GPUNETIO_IB_MLX5_CQE_INVALID) r.n_ok_window = 1;
+      // Optional (diagnostic, NCCL_GIN_Q4_LATE_READ_US): re-read the single collapsed slot after a
+      // delay to see whether a later (flush) CQE overwrote the one the poll saw. Delays publishing.
+      const uint32_t lateNs = *(volatile uint32_t*)&f->late_read_ns;
+      if (lateNs > 0 && kind == NCCL_GIN_Q4_KIND_ERR_CQE) {
+        uint64_t now;
+        do { now = q4GlobalTimer(); } while (now - gt < lateNs);
+        uint8_t late[64];
+        q4ReadCqe(base, late);
+        r.late_opcode = late[63] >> DOCA_GPUNETIO_VERBS_MLX5_CQE_OPCODE_SHIFT;
+        r.late_wqe_counter = ((uint16_t)late[60] << 8) | late[61];
+        r.late_syndrome = late[55];
+        r.late_vendor_err = late[54];
+        r.late_valid = 1;
+        r.late_delay_ns = (uint32_t)(now - gt);
+      }
+    }
+    // Full-buffer scan: error opcodes anywhere in the CQ buffer.
+    NVCC_PRAGMA_UNROLL_DISABLED
+    for (uint32_t j = 0; j < cqe_num; j++) {
+      const uint8_t op = (q4CqeTailChunk(base + (uint64_t)j * DOCA_GPUNETIO_VERBS_CQE_SIZE) & 0xff) >>
+                         DOCA_GPUNETIO_VERBS_MLX5_CQE_OPCODE_SHIFT;
+      if (op == DOCA_GPUNETIO_IB_MLX5_CQE_REQ_ERR || op == DOCA_GPUNETIO_IB_MLX5_CQE_RESP_ERR) r.n_err_buffer++;
+    }
+  }
+  r.root_index = rootIdx;
+  // mlx5_err_cqe: hw_err_synd 52, hw_synd_type 53, vendor_err_synd 54, syndrome 55,
+  // s_wqe_opcode_qpn 56-59 (BE), wqe_counter 60-61 (BE), op_own 63.
+  r.hw_err_synd = r.root_cqe[52];
+  r.hw_synd_type = r.root_cqe[53];
+  r.vendor_err = r.root_cqe[54];
+  r.syndrome = r.root_cqe[55];
+  r.qpn = ((uint32_t)r.root_cqe[57] << 16) | ((uint32_t)r.root_cqe[58] << 8) | r.root_cqe[59];
+  r.wqe_counter = ((uint16_t)r.root_cqe[60] << 8) | r.root_cqe[61];
+  r.root_opcode = r.root_cqe[63] >> DOCA_GPUNETIO_VERBS_MLX5_CQE_OPCODE_SHIFT;
+  bool rootIsErr = !rootStale &&
+    (r.root_opcode == DOCA_GPUNETIO_IB_MLX5_CQE_REQ_ERR || r.root_opcode == DOCA_GPUNETIO_IB_MLX5_CQE_RESP_ERR);
+  if (rootStale) r.root_src = 2;  // the window held nothing current (the classification below comes from the record or is NO_ERR_CQE)
+  // S2 (review): the vendored slot wait may have seen the root error CQE first and recorded it (its slot is
+  // reused by the WQE that poster posts next, so the window may hold only the trailing flushes, or nothing).
+  // Classify from that record when the window has no root or only a trailing flush (syndrome 0x05, not the
+  // head-of-SQ vendor syndrome 0xf5).
+  if (tsOn(qp)) {
+    const uint32_t sw = *(volatile uint32_t*)&tsGate(qp)->swErr;
+    if ((sw & NCCL_GIN_TS_SWERR_VALID) && (!rootIsErr || (r.syndrome == 0x05 && r.vendor_err != 0xf5))) {
+      r.syndrome = (uint8_t)(sw >> 8);
+      r.vendor_err = (uint8_t)sw;
+      r.root_opcode = (uint8_t)((sw >> 16) & 0xf);
+      r.root_src = 1;
+      if (!rootIsErr) r.qpn = doca_gpu_dev_verbs_load_const(&qp->sq_num);
+      rootIsErr = true;
+    }
+  }
+  if (!rootIsErr) {
+    // Timeout dump without an error CQE: the QP number still comes from the device QP.
+    r.qpn = doca_gpu_dev_verbs_load_const(&qp->sq_num);
+    r.cls = NCCL_GIN_Q4_CLASS_NO_ERR_CQE;
+  } else {
+    r.cls = q4Classify(r.syndrome, r.vendor_err);
+  }
+
+  if (kind == NCCL_GIN_Q4_KIND_ERR_CQE && sticky) {
+    const uint32_t c = ctx.contextId < NCCL_GIN_GDAKI_Q4_MAX_CTX ? ctx.contextId : NCCL_GIN_GDAKI_Q4_MAX_CTX - 1;
+    atomicExch(&f->sticky[c], 1u);
+  }
+
+  // Publish: invalidate the slot, write the body, fence, then seq, fence, then magic.
+  struct ncclGinGdakiQ4Record* mbx = *(struct ncclGinGdakiQ4Record* volatile*)&f->mbx;
+  const uint32_t nslots = *(volatile uint32_t*)&f->nslots;
+  if (mbx == nullptr || nslots == 0) return;
+  const uint32_t seq = atomicAdd(&f->seq, 1u) + 1u;
+  r.seq = seq;
+  r.magic = NCCL_GIN_GDAKI_Q4_MAGIC;
+  uint32_t* dst = (uint32_t*)(mbx + ((seq - 1u) % nslots));
+  q4StoreSys32(&dst[0], 0u);
+  __threadfence_system();
+  NVCC_PRAGMA_UNROLL_DISABLED
+  for (unsigned i = 2; i < sizeof(r) / 4; i++) q4StoreSys32(&dst[i], rw[i]);
+  __threadfence_system();
+  q4StoreSys32(&dst[1], seq);
+  __threadfence_system();
+  q4StoreSys32(&dst[0], NCCL_GIN_GDAKI_Q4_MAGIC);
+  __threadfence_system();
+}
