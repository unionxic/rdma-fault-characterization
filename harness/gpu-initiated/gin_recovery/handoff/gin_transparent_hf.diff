+/* NCCL GIN transparent recovery S2: the slot wait of a gated QP (see above). Ring CQ only (the gate requires one). */
+template <enum doca_gpu_dev_verbs_resource_sharing_mode resource_sharing_mode,
+          enum doca_gpu_dev_verbs_qp_type qp_type, enum doca_gpu_dev_verbs_cq_type cq_type>
+__device__ static __noinline__ void doca_priv_gpu_dev_verbs_nccl_ts_slot_wait(struct doca_gpu_dev_verbs_qp *qp,
+                                                                              uint64_t target) {
+    struct doca_gpu_dev_verbs_cq *cq = doca_gpu_dev_verbs_qp_get_cq<qp_type>(qp);
+    uint8_t *cqe = (uint8_t *)doca_gpu_dev_verbs_load_const((uintptr_t *)&cq->cqe_daddr);
+    const uint32_t cqe_num = doca_gpu_dev_verbs_load_const(&cq->cqe_num);
+    const uint64_t cqe_rsvd = doca_gpu_dev_verbs_load_const(&cq->cqe_rsvd);
+    const uint64_t pos = target + cqe_rsvd;
+    struct doca_gpunetio_ib_mlx5_cqe64 *cqe64 =
+        (struct doca_gpunetio_ib_mlx5_cqe64 *)(cqe + ((pos & (cqe_num - 1)) * DOCA_GPUNETIO_VERBS_CQE_SIZE));
+    uint32_t steps = 0;
+    while (true) {
+        if (target < doca_gpu_dev_verbs_load_relaxed<resource_sharing_mode>(&cq->cqe_ci)) return;
+        /* The slot holds the most recent CQE written at this position: owner parity and the WQE counter
+         * together identify target's CQE (an older one is a lap behind: other parity). */
+        uint32_t chunk = doca_gpu_dev_verbs_load_relaxed_sys_global(&cqe64->wqe_counter_sig_op_own_raw);
+        chunk = doca_gpu_dev_verbs_bswap32(chunk);
+        const uint8_t opown = chunk & 0xff;
+        if (!((opown & DOCA_GPUNETIO_IB_MLX5_CQE_OWNER_MASK) ^ !!(pos & cqe_num)) &&
+            (uint16_t)(chunk >> 16) == (uint16_t)(target & 0xffff)) {
+            if ((opown >> DOCA_GPUNETIO_VERBS_MLX5_CQE_OPCODE_SHIFT) != DOCA_GPUNETIO_IB_MLX5_CQE_REQ_ERR) {
+                doca_gpu_dev_verbs_fence_acquire_nvidia_nic();
+                doca_gpu_dev_verbs_atomic_max<uint64_t, resource_sharing_mode>(&cq->cqe_ci, target + 1);
+                return;
+            }
+            /* target failed. Record the error (syndrome, vendor syndrome, opcode) for NCCL's classifier: the
+             * caller reuses this CQ slot too (the WQE it posts next gets its CQE here), so the root CQE may be
+             * gone before any waiter polls it. First writer per epoch wins; the host zeroes it at publish. */
+            {
+                const uint32_t e = doca_gpu_dev_verbs_load_relaxed_sys_global((uint32_t *)((uint8_t *)cqe64 + 52));
+                const uint32_t rec = 0x80000000u | ((e >> 16) & 0xffffu) /* vendor | syndrome << 8 */ |
+                                     ((uint32_t)(opown >> DOCA_GPUNETIO_VERBS_MLX5_CQE_OPCODE_SHIFT) << 16);
+                atomicCAS((unsigned int *)(qp->reserved2 + DOCA_GPUNETIO_VERBS_NCCL_TS_SWERR_OFF), 0u, rec);
+            }
+            /* keep its WQE for the recovery before the caller reuses the slot */
+            uint64_t *rescue = (uint64_t *)*(volatile uint64_t *)(qp->reserved2 + DOCA_GPUNETIO_VERBS_NCCL_TS_RESCUE_OFF);
+            const uint32_t laps = *(volatile uint32_t *)(qp->reserved2 + DOCA_GPUNETIO_VERBS_NCCL_TS_LAPS_OFF);
+            if (rescue != nullptr && laps != 0) {
+                const uint16_t nwqes = doca_gpu_dev_verbs_load_const(&qp->sq_wqe_num);
+                const volatile uint64_t *src = (const volatile uint64_t *)doca_gpu_dev_verbs_get_wqe_ptr(qp, (uint16_t)target);
+                uint64_t *dst = rescue + (size_t)(target % ((uint64_t)laps * nwqes)) * 8;
+                for (int w = 0; w < 8; w++) dst[w] = src[w];
+                __threadfence();
+                atomicAdd((unsigned int *)(qp->reserved2 + DOCA_GPUNETIO_VERBS_NCCL_TS_WRITES_OFF), 1u);
+            }
+            return;
+        }
+        if ((++steps & 0xffu) == 0) {
+            const uint32_t hi = *(volatile uint32_t *)(qp->reserved1 + 4);
+            /* Ring while a recovery is quiescing the QP (odd epoch) or has failed it (a decline writes
+             * HOST_FAILED with an even epoch; the QP is in ERR, so the ring gets this thread its CQE and
+             * the kernel can exit), and in any case after 64 checks (16 K spins): a WQE that was never rung
+             * completes only when rung, and nobody else will ring it while its poster is blocked here. */
+            if ((hi & (1u | DOCA_GPUNETIO_VERBS_NCCL_TS_HI_HOST_FAILED)) || steps >= (64u << 8)) {
+                const uint64_t pi = doca_gpu_dev_verbs_atomic_read<uint64_t, resource_sharing_mode>(&qp->sq_wqe_pi);
+                const uint64_t ready = doca_gpu_dev_verbs_atomic_read<uint64_t, resource_sharing_mode>(&qp->sq_ready_index);
+                if (target >= pi && ready > pi)
+                    doca_gpu_dev_verbs_submit<resource_sharing_mode, DOCA_GPUNETIO_VERBS_SYNC_SCOPE_GPU>(qp, ready);
+            }
