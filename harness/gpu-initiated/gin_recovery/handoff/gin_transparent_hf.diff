+#define NCCL_GIN_TS_W_HOST_FAILED 0x80000000u  // in the epoch half (host decline)
+#define NCCL_GIN_TS_W_PUBLISHING 0x40000000u   // in the epoch half (odd): the host is re-posting this round
+#define NCCL_GIN_TS_W_EPOCH_MASK 0x3fffffffu
