+// Test only (NCCL_GIN_TS_TEST_SPLIT, see struct ncclGinTsTest): called inside the gate for a
+// put+signal. Returns true if it posted the operation itself (split), false to post it normally.
+template <enum doca_gpu_dev_verbs_resource_sharing_mode resource_sharing_mode>
+__device__ __noinline__ static bool tsTestSplitPut(doca_gpu_dev_verbs_qp* qp, doca_gpu_dev_verbs_addr raddr,
+                                                   doca_gpu_dev_verbs_addr laddr, size_t bytes,
+                                                   doca_gpu_dev_verbs_addr sig_raddr,
+                                                   doca_gpu_dev_verbs_addr sig_laddr, uint64_t sigVal,
+                                                   uint32_t codeOpt) {
+  struct ncclGinTsGate* g = tsGate(qp);
+  volatile struct ncclGinTsTest* t = (volatile struct ncclGinTsTest*)tsLoadRelaxedSys64(&g->test);
+  if (t == nullptr || bytes == 0) return false;
+  const uint32_t k = atomicAdd(&g->testPuts, 1u) + 1u;
+  bool hit = false;
+  const uint32_t nl = t->nlist < NCCL_GIN_TS_TEST_MAXLIST ? t->nlist : NCCL_GIN_TS_TEST_MAXLIST;
+  for (uint32_t i = 0; i < nl; i++) hit |= (t->list[i] == k);
+  if (!hit) return false;
+  // 1. the WRITE alone; its success CQE means the responder executed it (RC: ACK after placement).
+  doca_gpu_dev_verbs_ticket_t w;
+  doca_gpu_dev_verbs_put<resource_sharing_mode>(qp, raddr, laddr, bytes, &w, codeOpt);
+  const uint64_t t0 = tsNowNs();
+  int st;
+  do {
+    st = doca_gpu_dev_verbs_poll_one_cq_at<resource_sharing_mode>(qp, w);
+  } while (st > 0 && tsNowNs() - t0 < 1000000000ull);
+  // 2. the gap: the host test thread moves the QPs to ERR, then acks (bounded).
+  bool acked = false;
+  if (st == 0) {
+    t->gapReq = k;
+    __threadfence_system();
+    while (tsNowNs() - t0 < 2000000000ull) {
+      if (t->gapAck == k) {
+        acked = true;
+        break;
+      }
+      __nanosleep(1000);
+    }
+  }
+  if (acked) t->nsplit = t->nsplit + 1;
+  else t->nsplitNoAck = t->nsplitNoAck + 1;
+  __threadfence_system();
+  // 3. the signal ADD alone, into the QP in ERR: flushed; the responder never executes it.
+  doca_gpu_dev_verbs_signal<DOCA_GPUNETIO_VERBS_SIGNAL_OP_ADD, resource_sharing_mode>(qp, sig_raddr, sig_laddr,
+                                                                                      sigVal, codeOpt);
+  return true;
+}
