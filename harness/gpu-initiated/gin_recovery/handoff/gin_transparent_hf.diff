+#ifndef NCCL_GIN_TS_PRODUCTION
+NCCL_PARAM(GinQ4QpWatchMs, "GIN_Q4_QPWATCH_MS", 0);
+NCCL_PARAM(GinQ4LateReadUs, "GIN_Q4_LATE_READ_US", 0);
+#else  // gin-harden: diagnostics, off in the production build
