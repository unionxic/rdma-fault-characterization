+#ifndef NCCL_GIN_TS_PRODUCTION  // gin-harden: test code
+// Multi-shot fault hook: shot 1 fires delays[0] ms after context creation; shot k > 1 fires
+// delays[k-1] ms after the recovery commit that followed shot k-1 on this rank (0 = at once).
+// A delay of -1 fires shot k *inside* that commit, after the QPs reached RTS and before Commit
+// returns, so the application's replay meets a QP in ERR (a fault during the recovery itself).
+// Joined on context destruction.
+static void gdakiRecHookStart(struct gdaki_context* g, const std::vector<int>& delays, const char* spec) {
+  struct gdakiRecHost* r = g->rec;
+  const int nranks = g->collComm->nranks;
+  WARN("GIN/FAULT: GDAKI fault hook armed (%s): %d context(s) x %d peer(s), %zu shot(s); shot 1 fires in %d ms, "
+       "shot k>1 fires its delay after the recovery commit that followed shot k-1",
+       spec, g->nContexts, nranks - 1, delays.size(), delays[0]);
+  // Test knob (S2): NCCL_GIN_FAULT_INJECT_AT=wqe:<n>|sig:<n> fires shot 1 when this rank's QP to the first
+  // peer (context 0) has posted >= n WQEs, or when this rank's GIN signal 0 of context 0 reached >= n,
+  // instead of delays[0] ms after context creation (delays[0] then bounds the wait). The value is polled
+  // from device memory with copies on the hook's own stream (no firmware command), so the fault lands at a
+  // chosen point of the traffic (e.g. inside a burst) rather than at a wall-clock time.
+  const char* at = getenv("NCCL_GIN_FAULT_INJECT_AT");
+  int atKind = 0;  // 1 wqe, 2 sig
+  uint64_t atN = 0;
+  if (at && sscanf(at, "wqe:%lu", (unsigned long*)&atN) == 1) atKind = 1;
+  else if (at && sscanf(at, "sig:%lu", (unsigned long*)&atN) == 1) atKind = 2;
+  const uint64_t* atPtr = nullptr;
+  if (atKind == 1) {
+    for (int p = 0; p < nranks && atPtr == nullptr; p++)
+      if (p != g->rank && g->gqps && g->gqps[p] && g->gqps[p]->qp_gverbs)
+        atPtr = (const uint64_t*)&g->gqps[p]->qp_gverbs->qp_gpu->sq_rsvd_index;
+  } else if (atKind == 2 && g->signals_table) {
+    atPtr = g->signals_table->gpu_ptr;
+  }
+  if (atKind) WARN("GIN/FAULT: shot 1 trigger %s (bound %d ms)", at, delays[0]);
+  // The poll's stream and staging are made here (context creation) and freed with the context: cudaHostAlloc and
+  // cudaFreeHost may wait for running kernels, which would delay the fire past the traffic it targets.
+  if (atKind && atPtr != nullptr &&
+      (cudaStreamCreateWithFlags(&r->hookStream, cudaStreamNonBlocking) != cudaSuccess ||
+       cudaHostAlloc((void**)&r->hookPin, sizeof(uint64_t), cudaHostAllocDefault) != cudaSuccess)) {
+    WARN("GIN/FAULT: shot 1 trigger: cannot allocate its stream/staging; trigger off");
+    atPtr = nullptr;
+  }
+  r->hookTh = std::thread([g, r, delays, atKind, atN, atPtr]() {
+    const double waitS = (double)ncclParamGinFaultInjectWaitS();
+    uint64_t commitsAtFire = 0;
+    if (atKind && atPtr != nullptr) {
+      cudaStream_t hs = r->hookStream;
+      uint64_t* pin = r->hookPin;
+      bool ok = cudaSetDevice(g->cuda_id) == cudaSuccess;
+      const double t0 = gdakiQ4MonoMs();
+      uint64_t v = 0;
+      while (ok) {
+        {
+          std::lock_guard<std::mutex> lk(r->hookMu);
+          if (r->hookStop) break;
+        }
+        if (cudaMemcpyAsync(pin, atPtr, sizeof(uint64_t), cudaMemcpyDeviceToHost, hs) != cudaSuccess ||
+            cudaStreamSynchronize(hs) != cudaSuccess) {
+          ok = false;
+          break;
+        }
+        v = *pin;
+        if (v >= atN) break;
+        if (gdakiQ4MonoMs() - t0 > delays[0]) {
+          ok = false;
+          break;
+        }
+        std::this_thread::sleep_for(std::chrono::microseconds(5));
+      }
+      {
+        std::lock_guard<std::mutex> lk(r->hookMu);
+        if (r->hookStop) return;
+      }
+      if (!ok) {
+        WARN("GIN/FAULT: shot 1 trigger not reached (value %lu < %lu) within %d ms: not fired", (unsigned long)v,
+             (unsigned long)atN, delays[0]);
+        return;
+      }
+      std::lock_guard<std::mutex> op(r->opMu);  // never inside a Prepare/Commit body
+      {
+        std::lock_guard<std::mutex> lk2(r->hookMu);
+        commitsAtFire = r->commits;
+      }
+      char tag[96];
+      snprintf(tag, sizeof(tag), " (shot 1/%zu, trigger value %lu >= %lu after %.1f ms)", delays.size(), (unsigned long)v,
+               (unsigned long)atN, gdakiQ4MonoMs() - t0);
+      ncclGinGdakiFaultFire(g, tag);
+      gdakiTsTestSelfReport(r);
+    }
+    for (size_t k = (atKind && atPtr != nullptr) ? 1 : 0; k < delays.size(); k++) {
+      std::unique_lock<std::mutex> lk(r->hookMu);
+      if (k > 0 && delays[k] < 0) {
+        r->armShot = (int)k + 1;
+        r->armTotal = (int)delays.size();
+        bool ok = r->hookCv.wait_for(lk, std::chrono::duration<double>(waitS),
+                                     [&] { return r->hookStop || r->armShot == 0; });
+        if (r->hookStop) return;
+        if (!ok) {
+          r->armShot = 0;
+          WARN("GIN/FAULT: shot %zu/%zu cancelled: no recovery commit within %.0f s", k + 1, delays.size(), waitS);
+          return;
+        }
+        commitsAtFire = r->commits;  // the commit that fired it has already counted itself
+        continue;
+      }
+      if (k > 0) {
+        bool ok = r->hookCv.wait_for(lk, std::chrono::duration<double>(waitS),
+                                     [&] { return r->hookStop || r->commits > commitsAtFire; });
+        if (r->hookStop) return;
+        if (!ok) {
+          WARN("GIN/FAULT: shot %zu/%zu cancelled: no recovery commit within %.0f s", k + 1, delays.size(), waitS);
+          return;
+        }
+      }
+      if (delays[k] > 0 &&
+          r->hookCv.wait_for(lk, std::chrono::milliseconds(delays[k]), [&] { return r->hookStop; }))
+        return;
+      if (r->hookStop) return;
+      lk.unlock();
+      std::lock_guard<std::mutex> op(r->opMu);  // never inside a Prepare/Commit body
+      {
+        std::lock_guard<std::mutex> lk2(r->hookMu);
+        commitsAtFire = r->commits;
+      }
+      char tag[48];
+      snprintf(tag, sizeof(tag), " (shot %zu/%zu)", k + 1, delays.size());
+      ncclGinGdakiFaultFire(g, tag);
+      gdakiTsTestSelfReport(r);
+    }
+  });
+}
+#endif  // NCCL_GIN_TS_PRODUCTION
+
+static const char* gdakiRecStateStr(int s) { return s == 0 ? "idle" : s == 1 ? "prepared" : "?"; }
+
+NCCL_API(ncclResult_t, ncclGinFaultQuery, ncclComm_t comm, int waitMs, ncclGinFaultInfo_t* info);
+ncclResult_t ncclGinFaultQuery(ncclComm_t comm, int waitMs, ncclGinFaultInfo_t* info) {
+  if (info == nullptr) return ncclInvalidArgument;
+  memset(info, 0, sizeof(*info));
+  std::vector<struct gdakiRecHost*> rs;
+  gdakiRecFind((void*)comm, rs);
+  if (rs.empty()) return ncclInvalidUsage;
+  const double deadline = gdakiQ4MonoMs() + std::max(0, waitMs);
+  do {
+    for (auto* r : rs) {
+      struct gdakiQ4Host* q = r->ctx->q4;
+      std::lock_guard<std::mutex> lk(q->lastMu);
+      if (q->nErrSinceRec == 0 || (info->valid && q->lastErrMonoMs <= info->hostMonoMs)) continue;
+      const struct ncclGinGdakiQ4Record& e = q->lastErr;
+      const bool rootErr = (e.root_opcode == 0xd || e.root_opcode == 0xe);
+      info->valid = 1;
+      info->cls = e.cls;
+      info->wcStatus = rootErr ? gdakiQ4WcStatus(e.syndrome) : 0;
+      info->vendorErr = rootErr ? e.vendor_err : 0;
+      info->syndrome = rootErr ? e.syndrome : 0;
+      info->peer = (int)e.peer;
+      info->ctxId = (int)e.ctx_id;
+      info->qpn = e.qpn;
+      info->wqeCounter = e.wqe_counter;
+      info->seq = e.seq;
+      info->nRecords = q->nErrSinceRec;
+      info->gtimerNs = e.gtimer_ns;
+      info->hostMonoMs = q->lastErrMonoMs;
+      info->recoverable = (e.cls == NCCL_GIN_Q4_CLASS_LOCAL_QP_ERR) ? 1 : (e.cls == NCCL_GIN_Q4_CLASS_RETRY_EXC) ? 2 : 0;
+      snprintf(info->className, sizeof(info->className), "%s", gdakiQ4Class(e.cls, e.vendor_err).name);
+    }
+    if (info->valid) break;
+    std::this_thread::sleep_for(std::chrono::microseconds(20));
+  } while (gdakiQ4MonoMs() < deadline);
+  return ncclSuccess;
+}
+
+NCCL_API(ncclResult_t, ncclGinRecoverPrepare, ncclComm_t comm, int peer, ncclGinRecoverToken_t* local,
+         ncclGinRecoverStats_t* stats);
+ncclResult_t ncclGinRecoverPrepare(ncclComm_t comm, int peer, ncclGinRecoverToken_t* local,
+                                   ncclGinRecoverStats_t* stats) {
+  if (local == nullptr) return ncclInvalidArgument;
+  ncclGinRecoverStats_t st;
+  memset(&st, 0, sizeof(st));
+  memset(local, 0, sizeof(*local));
+  local->magic = NCCL_GIN_RECOVERY_TOKEN_MAGIC;
+  std::vector<struct gdakiRecHost*> rs;
+  gdakiRecFind((void*)comm, rs);
+  if (rs.empty()) {
+    WARN("GIN/REC: prepare: no recovery-enabled GDAKI context on this communicator");
+    return ncclInvalidUsage;
+  }
+  if (!gdakiTsInHelper) {
+    for (auto* r_ : rs)
+      if (gdakiTsActive(r_)) {
+        WARN("GIN/REC: %s: transparent recovery (NCCL_GIN_FAULT_TRANSPARENT=1) owns the QPs", __func__);
+        return ncclInvalidUsage;
+      }
+  }
+  const double t0 = gdakiQ4MonoMs();
+  ncclResult_t ret = ncclSuccess;
+  std::vector<std::unique_lock<std::mutex>> ops;
+  std::vector<struct gdakiRecHost*> pausedRs;
+  const char* why = nullptr;
+
+  // 1. configuration (checked before anything is touched)
+  for (auto* r : rs) {
+    struct gdaki_context* g = r->ctx;
+    if (peer < 0 || peer >= r->nranks || peer == g->rank) { why = "invalid peer"; goto decline; }
+    if (r->state != 0) { why = "a recovery is already prepared"; goto decline; }
+    if (g->companion_gqps != nullptr) { why = "companion (counter) QPs present"; goto decline; }
+    int n = 0;
+    gdakiRecForPeer(r, peer, [&](gdakiRecQp&, struct doca_gpu_verbs_qp_hl* q) {
+      n++;
+      struct doca_gpu_verbs_qp* v = q->qp_gverbs;
+      if (gdakiRecDbMode(v) == GDAKI_REC_DB_UNSUPPORTED)
+        why = "doorbell mode is neither CPU proxy nor GPU_SM_DB";
+      else if (v->cq_type != DOCA_GPUNETIO_VERBS_CQ_64B)
+        why = "CQ is not a ring CQ";
+      else if (v->qp_gpu == nullptr)
+        why = "QP not exported";
+    });
+    if (why) goto decline;
+    if (n == 0) { why = "no QP to this peer"; goto decline; }
+    if ((int)local->nqp + n > NCCL_GIN_RECOVERY_MAX_QPS) { why = "too many QPs"; goto decline; }
+    local->nqp += n;
+  }
+  local->nqp = 0;
+
+  // 2. pause the proxy doorbell thread, ring any pending doorbell, snapshot and check quiescence
+  for (auto* r : rs) {
+    ops.emplace_back(r->opMu);
+    if (gdakiRecPause(r) != ncclSuccess) { why = "cannot pause proxy progress"; goto decline; }
+    pausedRs.push_back(r);
+    bool bad = false;
+    gdakiRecForPeer(r, peer, [&](gdakiRecQp& rq, struct doca_gpu_verbs_qp_hl* q) {
+      if (bad) return;
+      struct doca_gpu_verbs_qp* v = q->qp_gverbs;
+      rq.dbMode = gdakiRecDbMode(v);
+      if (rq.dbMode == GDAKI_REC_DB_CPU_PROXY) {
+        bool progressed = false;
+        doca_gpu_verbs_cpu_proxy_progress(v, &progressed);  // ring a doorbell the proxy has not rung yet
+      }
+      if (gdakiRecD2H(r, &rq.snap, v->qp_gpu, sizeof(rq.snap)) != ncclSuccess) { bad = true; why = "cannot read device QP"; return; }
+      const uint64_t S = rq.snap.sq_rsvd_index, R = rq.snap.sq_ready_index;
+      if (rq.dbMode == GDAKI_REC_DB_CPU_PROXY) {
+        const uint64_t P = __atomic_load_n(v->cpu_db, __ATOMIC_ACQUIRE);
+        if (R != S || P != S || v->sq_wqe_pi_last != S) {
+          WARN("GIN/REC: prepare: qpn=%#x not quiescent: sq_rsvd_index=%lu sq_ready_index=%lu proxy_db=%lu rung=%lu",
+               gdakiRecQpn(q), (unsigned long)S, (unsigned long)R, (unsigned long)P, (unsigned long)v->sq_wqe_pi_last);
+          bad = true;
+          why = "GPU producer not quiescent";
+          return;
+        }
+      } else {
+        // GPU doorbell: the GPU's submit raised sq_wqe_pi to the submitted index, rang the UAR and
+        // wrote the doorbell record (GPU memory, big-endian 16-bit counter) itself.
+        uint32_t dbr = 0;
+        if (gdakiRecD2H(r, &dbr, v->qp_cpu->sq_dbrec, sizeof(dbr)) != ncclSuccess) { bad = true; why = "cannot read doorbell record"; return; }
+        const uint32_t dbrHost = be32toh(dbr);
+        if (R != S || rq.snap.sq_wqe_pi != S || dbrHost != (uint32_t)(S & 0xffff)) {
+          WARN("GIN/REC: prepare: qpn=%#x not quiescent (GPU doorbell): sq_rsvd_index=%lu sq_ready_index=%lu "
+               "sq_wqe_pi=%lu dbrec=%u",
+               gdakiRecQpn(q), (unsigned long)S, (unsigned long)R, (unsigned long)rq.snap.sq_wqe_pi, dbrHost);
+          bad = true;
+          why = "GPU producer not quiescent";
+          return;
+        }
+      }
+      rq.epochWqes = S;
+    });
+    if (bad) goto decline;
+  }
+
+  // 3. every QP of the pair set -> ERR (stops retransmission and execution of the old incarnation)
+  {
+    const double e0 = gdakiQ4MonoMs();
+    for (auto* r : rs) {
+      gdakiRecFwGuard fw(r, "2ERR");  // gin-harden: firmware-command phase (watchdog)
+      bool bad = false;
+      gdakiRecForPeer(r, peer, [&](gdakiRecQp&, struct doca_gpu_verbs_qp_hl* q) {
+        if (!bad && gdakiRecModify(q, DOCA_VERBS_QP_STATE_ERR) != ncclSuccess) bad = true;
+      });
+      if (bad) { why = "modify to ERR failed"; goto decline; }
+    }
+    st.errUs = (gdakiQ4MonoMs() - e0) * 1e3;
+  }
+
+  // 4. drain: the CQE of the last WQE of the epoch is in the ring (all earlier ones are too)
+  {
+    const double d0 = gdakiQ4MonoMs();
+    const double deadline = d0 + (double)ncclParamGinRecoveryDrainMs();
+    for (auto* r : rs) {
+      bool bad = false;
+      gdakiRecForPeer(r, peer, [&](gdakiRecQp& rq, struct doca_gpu_verbs_qp_hl* q) {
+        if (bad || rq.epochWqes == 0) return;
+        const struct doca_gpu_dev_verbs_cq& cq = rq.snap.cq_sq;
+        const uint32_t cqeNum = cq.cqe_num;
+        if ((size_t)cqeNum * DOCA_GPUNETIO_VERBS_CQE_SIZE > r->pinnedSize) { bad = true; why = "CQ too large"; return; }
+        const uint64_t last = rq.epochWqes - 1;
+        const uint64_t pos = last + cq.cqe_rsvd;
+        const uint8_t* slotAddr = cq.cqe_daddr + (pos & (cqeNum - 1)) * DOCA_GPUNETIO_VERBS_CQE_SIZE;
+        uint8_t cqe[64];
+        while (true) {
+          if (gdakiRecD2H(r, cqe, slotAddr, sizeof(cqe)) != ncclSuccess) { bad = true; why = "cannot read CQ"; return; }
+          if (gdakiRecCqeCurrent(cqe, pos, cqeNum, last)) break;
+          if (gdakiQ4MonoMs() > deadline) {
+            WARN("GIN/REC: prepare: qpn=%#x drain timeout: CQE of WQE %lu (ring pos %lu) not written after %ld ms "
+                 "(wqe_counter=%u op_own=%#x)",
+                 gdakiRecQpn(q), (unsigned long)last, (unsigned long)pos, (long)ncclParamGinRecoveryDrainMs(),
+                 ((unsigned)cqe[60] << 8) | cqe[61], cqe[63]);
+            bad = true;
+            why = "drain timeout";
+            return;
+          }
+          std::this_thread::sleep_for(std::chrono::microseconds(50));
+        }
+        // Diagnostics: current CQEs of the unconsumed window [cqe_ci, S).
+        std::vector<uint8_t> ring((size_t)cqeNum * DOCA_GPUNETIO_VERBS_CQE_SIZE);
+        if (gdakiRecD2H(r, ring.data(), cq.cqe_daddr, ring.size()) != ncclSuccess) return;
+        uint64_t lo = cq.cqe_ci;
+        if (rq.epochWqes > cqeNum && lo < rq.epochWqes - cqeNum) lo = rq.epochWqes - cqeNum;
+        for (uint64_t i = lo; i < rq.epochWqes; i++) {
+          const uint64_t p = i + cq.cqe_rsvd;
+          const uint8_t* c = ring.data() + (p & (cqeNum - 1)) * DOCA_GPUNETIO_VERBS_CQE_SIZE;
+          if (!gdakiRecCqeCurrent(c, p, cqeNum, i)) continue;
+          const uint8_t op = c[63] >> 4;
+          if (op == 0xd || op == 0xe) st.cqeErr++;
+          else st.cqeOk++;
+        }
+      });
+      if (bad) goto decline;
+    }
+    st.drainUs = (gdakiQ4MonoMs() - d0) * 1e3;
+  }
+
+  // 5. token: fresh 24-bit send PSN per QP
+  for (auto* r : rs) {
+    gdakiRecForPeer(r, peer, [&](gdakiRecQp& rq, struct doca_gpu_verbs_qp_hl* q) {
+      rq.newSqPsn = r->rng() & 0xffffff;
+      const unsigned n = local->nqp++;
+      local->qpn[n] = gdakiRecQpn(q);
+      local->remoteQpn[n] = (unsigned)rq.exch.qpn;
+      local->sqPsn[n] = rq.newSqPsn;
+      local->epochWqes[n] = rq.epochWqes;
+      st.epochWqes += rq.epochWqes;
+    });
+    r->state = 1;
+    r->preparedPeer = peer;
+  }
+  st.nqp = (int)local->nqp;
+  st.prepareUs = (gdakiQ4MonoMs() - t0) * 1e3;
+  if (stats) *stats = st;
+  INFO(NCCL_NET, "GIN/REC: prepared peer=%d qps=%d epoch_wqes=%llu cqe_err=%u cqe_ok=%u err_us=%.0f drain_us=%.0f total_us=%.0f",
+       peer, st.nqp, st.epochWqes, st.cqeErr, st.cqeOk, st.errUs, st.drainUs, st.prepareUs);
+  return ncclSuccess;
+
+decline:
+  for (auto* r : pausedRs) gdakiRecResume(r);
+  WARN("GIN/REC: prepare declined (peer=%d): %s", peer, why ? why : "?");
+  if (ret == ncclSuccess) ret = ncclInvalidUsage;
+  return ret;
+}
+
+NCCL_API(ncclResult_t, ncclGinRecoverCommit, ncclComm_t comm, int peer, const ncclGinRecoverToken_t* remote,
+         ncclGinRecoverStats_t* stats);
+ncclResult_t ncclGinRecoverCommit(ncclComm_t comm, int peer, const ncclGinRecoverToken_t* remote,
+                                  ncclGinRecoverStats_t* stats) {
+  if (remote == nullptr) return ncclInvalidArgument;
+  std::vector<struct gdakiRecHost*> rs;
+  gdakiRecFind((void*)comm, rs);
+  if (rs.empty()) return ncclInvalidUsage;
+  if (!gdakiTsInHelper) {
+    for (auto* r_ : rs)
+      if (gdakiTsActive(r_)) {
+        WARN("GIN/REC: %s: transparent recovery (NCCL_GIN_FAULT_TRANSPARENT=1) owns the QPs", __func__);
+        return ncclInvalidUsage;
+      }
+  }
+  ncclGinRecoverStats_t st;
+  if (stats) st = *stats;
+  else memset(&st, 0, sizeof(st));
+  // Validate before touching anything: same QP set, each end connected to the other.
+  {
+    unsigned n = 0;
+    bool bad = remote->magic != NCCL_GIN_RECOVERY_TOKEN_MAGIC;
+    for (auto* r : rs) {
+      if (r->state != 1 || r->preparedPeer != peer) {
+        WARN("GIN/REC: commit: context not prepared for peer %d (state %s)", peer, gdakiRecStateStr(r->state));
+        return ncclInvalidUsage;
+      }
+      gdakiRecForPeer(r, peer, [&](gdakiRecQp& rq, struct doca_gpu_verbs_qp_hl* q) {
+        if (n >= remote->nqp || remote->qpn[n] != (unsigned)rq.exch.qpn || remote->remoteQpn[n] != gdakiRecQpn(q))
+          bad = true;
+        n++;
+      });
+    }
+    if (bad || n != remote->nqp) {
+      WARN("GIN/REC: commit: peer token does not match the connected QPs (local %u, remote %u)", n, remote->nqp);
+      return ncclInvalidArgument;
+    }
+  }
+  const double t0 = gdakiQ4MonoMs();
+  ncclResult_t ret = ncclSuccess;
+  unsigned n = 0;
+  for (auto* r : rs) {
+    std::lock_guard<std::mutex> op(r->opMu);
+    struct gdaki_context* g = r->ctx;
+    const int nranks = r->nranks;
+    bool bad = false;
+    gdakiRecFwGuard fw(r, "commit");  // gin-harden: firmware-command phase (2RST, INIT/RTR/RTS) for the watchdog
+    gdakiRecForPeer(r, peer, [&](gdakiRecQp& rq, struct doca_gpu_verbs_qp_hl* q) {
+      const unsigned idx = n++;
+      if (bad) return;
+      struct doca_gpu_verbs_qp* v = q->qp_gverbs;
+      // (a) 2RST: the NIC restarts this SQ at WQE counter 0; no CQE is written for it any more.
+      double a = gdakiQ4MonoMs();
+      if (gdakiRecModify(q, DOCA_VERBS_QP_STATE_RST) != ncclSuccess) { bad = true; return; }
+      double b = gdakiQ4MonoMs();
+      st.resetUs += (b - a) * 1e3;
+      // (b) doorbell state, while the QP is in RESET. CPU proxy: host-memory doorbell record,
+      // proxy mailbox and proxy counter. GPU doorbell: the doorbell record in GPU memory (the GPU's
+      // producer index sq_wqe_pi is part of the device struct below); no CPU-side state exists.
+      if (rq.dbMode == GDAKI_REC_DB_CPU_PROXY) {
+        __atomic_store_n(v->sq_dbrec, (__be32)0, __ATOMIC_RELEASE);
+        if (gdakiRecDiag() != 2) {
+          __atomic_store_n(&v->cpu_db[0], (uint64_t)0, __ATOMIC_RELEASE);
+          v->sq_wqe_pi_last = 0;
+        }
+      } else if (gdakiRecDiag() != 3) {
+        // (transparent recovery: a copy, not a memset, which may need a kernel slot the application holds)
+        if (gdakiTsInHelper ? gdakiTsZeroDev(r, v->qp_cpu->sq_dbrec, sizeof(uint32_t), 0) != ncclSuccess
+                            : (cudaMemsetAsync(v->qp_cpu->sq_dbrec, 0, sizeof(uint32_t), r->stream) != cudaSuccess ||
+                               cudaStreamSynchronize(r->stream) != cudaSuccess)) {
+          WARN("GIN/REC: commit: cannot clear the GPU doorbell record of qpn=%#x", gdakiRecQpn(q));
+          bad = true;
+          return;
+        }
+      }
+      // (c) device QP struct: new WQE index epoch; CQ mapping advanced by the WQEs of the old one.
+      struct doca_gpu_dev_verbs_qp nd = rq.snap;
+      nd.sq_rsvd_index = 0;
+      nd.sq_ready_index = 0;
+      nd.sq_wqe_pi = (gdakiRecDiag() == 4) ? rq.snap.sq_wqe_pi : 0;  // diag keep_gpu_pi: stale GPU producer index
+      nd.sq_lock = 0;
+      nd.cq_sq.cqe_ci = 0;
+      nd.cq_sq.cqe_rsvd = rq.snap.cq_sq.cqe_rsvd + rq.epochWqes;
+      if (gdakiRecDiag() == 1) nd.cq_sq.cqe_rsvd = rq.epochWqes;  // diagnostic: DOCA's formula
+      if (!gdakiTsInHelper) {
+        if (gdakiRecH2D(r, v->qp_gpu, &nd, sizeof(nd)) != ncclSuccess) { bad = true; return; }
+      } else {
+        // Transparent recovery: the application's kernel keeps running. Write only the fields the
+        // commit owns (indices, lock, CQ mapping); never the gate words in reserved1/reserved2, which
+        // parked posters and waiters still touch. Posters and pollers are excluded (gate counters 0).
+        const size_t sqEnd = offsetof(struct doca_gpu_dev_verbs_qp, reserved1);
+        const size_t cqOff = offsetof(struct doca_gpu_dev_verbs_qp, cq_sq);
+        if (gdakiRecH2D(r, v->qp_gpu, &nd, sqEnd) != ncclSuccess ||
+            gdakiRecH2D(r, (uint8_t*)v->qp_gpu + cqOff, (uint8_t*)&nd + cqOff, sizeof(nd.cq_sq)) != ncclSuccess) {
+          bad = true;
+          return;
+        }
+      }
+      v->qp_cpu->sq_rsvd_index = 0;
+      v->qp_cpu->sq_ready_index = 0;
+      v->qp_cpu->sq_wqe_pi = 0;
+      v->qp_cpu->sq_lock = 0;
+      v->qp_cpu->cq_sq.cqe_ci = 0;
+      v->qp_cpu->cq_sq.cqe_rsvd = nd.cq_sq.cqe_rsvd;
+      // (d) GIN get tickets of this (context, peer): WQE indices of the old epoch.
+      const size_t off = (size_t)rq.ctxIdx * nranks + rq.peer;
+      if (gdakiTsInHelper ? (gdakiTsZeroDev(r, g->last_issued_get + off, sizeof(uint64_t), 0) != ncclSuccess ||
+                             gdakiTsZeroDev(r, g->last_visible_get + off, sizeof(uint64_t), 0) != ncclSuccess)
+                          : (cudaMemsetAsync(g->last_issued_get + off, 0, sizeof(uint64_t), r->stream) != cudaSuccess ||
+                             cudaMemsetAsync(g->last_visible_get + off, 0, sizeof(uint64_t), r->stream) != cudaSuccess ||
+                             cudaStreamSynchronize(r->stream) != cudaSuccess)) {
+        WARN("GIN/REC: commit: cannot clear get tickets");
+        bad = true;
+        return;
+      }
+      double c = gdakiQ4MonoMs();
+      st.resyncUs += (c - b) * 1e3;
+      // (e) reconnect with the connect-time attributes and the fresh PSNs.
+      if (gdakiConnectQp(g, q, &rq.exch, rq.lag, remote->sqPsn[idx], rq.newSqPsn) != ncclSuccess) {
+        WARN("GIN/REC: commit: reconnect of qpn=%#x failed", gdakiRecQpn(q));
+        bad = true;
+        return;
+      }
+      st.connectUs += (gdakiQ4MonoMs() - c) * 1e3;
+      INFO(NCCL_NET, "GIN/REC: qpn=%#x -> remote %#x reconnected: epoch_wqes=%lu cqe_rsvd %lu->%lu rq_psn=%#x sq_psn=%#x",
+           gdakiRecQpn(q), rq.exch.qpn, (unsigned long)rq.epochWqes, (unsigned long)rq.snap.cq_sq.cqe_rsvd,
+           (unsigned long)nd.cq_sq.cqe_rsvd, remote->sqPsn[idx], rq.newSqPsn);
+    });
+    if (bad) {
+      // A half-reset pair must never carry traffic: leave every QP of this peer in ERR.
+      gdakiRecAllToErr(r, peer);
+      ret = ncclSystemError;
+    }
+  }
+  if (ret != ncclSuccess) {
+    for (auto* r : rs) {
+      r->state = 0;
+      r->nAborts++;
+      gdakiRecResume(r);
+    }
+    WARN("GIN/REC: commit failed (peer=%d); QPs left in ERR", peer);
+    return ret;
+  }
+#ifndef NCCL_GIN_TS_PRODUCTION
+  // Test hook (delay -1): fire the armed shot now, after RTS and before Commit returns.
+  for (auto* r : rs) {
+    int shot = 0, total = 0;
+    {
+      std::lock_guard<std::mutex> lk(r->hookMu);
+      shot = r->armShot;
+      total = r->armTotal;
+    }
+    if (shot > 0) {
+      char tag[64];
+      snprintf(tag, sizeof(tag), " (shot %d/%d, inside commit)", shot, total);
+      std::lock_guard<std::mutex> op(r->opMu);
+      ncclGinGdakiFaultFire(r->ctx, tag);
+    }
+  }
+#endif
+  // Clear the Q4 error state: device sticky errors, host flag, the GIN async result it set.
+  // (Transparent recovery never raises them for a fault it recovers, and one it declined, possibly for
+  // another peer, must stay surfaced: skipped in the helper.)
+  for (auto* r : rs) {
+    struct gdakiQ4Host* q = r->ctx->q4;
+    if (!gdakiTsInHelper) {
+    if (cudaMemsetAsync(q->dev->sticky, 0, sizeof(q->dev->sticky), r->stream) != cudaSuccess ||
+        cudaStreamSynchronize(r->stream) != cudaSuccess) {
+      WARN("GIN/REC: commit: cannot clear the device error state");
+      ret = ncclUnhandledCudaError;
+    }
+    {
+      std::lock_guard<std::mutex> lk(q->lastMu);
+      q->nErrSinceRec = 0;
+    }
+    q->hasError.store(0, std::memory_order_release);
+    if (q->asyncResult && q->setAsync.exchange(0)) {
+      ncclResult_t expect = ncclRemoteError;
+      __atomic_compare_exchange_n(q->asyncResult, &expect, ncclSuccess, false, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE);
+    }
+    }
+    r->state = 0;
+    r->nCommits++;
+    gdakiRecResume(r);
+    {
+      std::lock_guard<std::mutex> op(r->opMu);
+      std::lock_guard<std::mutex> lk(r->hookMu);
+      r->commits++;
+      r->armShot = 0;
+    }
+    r->hookCv.notify_all();
+  }
+  st.commitUs = (gdakiQ4MonoMs() - t0) * 1e3;
+  if (stats) *stats = st;
+  INFO(NCCL_NET, "GIN/REC: committed peer=%d qps=%u reset_us=%.0f resync_us=%.0f connect_us=%.0f total_us=%.0f", peer, n,
+       st.resetUs, st.resyncUs, st.connectUs, st.commitUs);
+  return ret;
+}
+
+NCCL_API(ncclResult_t, ncclGinRecoverAbort, ncclComm_t comm, int peer);
+ncclResult_t ncclGinRecoverAbort(ncclComm_t comm, int peer) {
+  std::vector<struct gdakiRecHost*> rs;
+  gdakiRecFind((void*)comm, rs);
+  if (rs.empty()) return ncclInvalidUsage;
+  if (!gdakiTsInHelper) {
+    for (auto* r_ : rs)
+      if (gdakiTsActive(r_)) {
+        WARN("GIN/REC: %s: transparent recovery (NCCL_GIN_FAULT_TRANSPARENT=1) owns the QPs", __func__);
+        return ncclInvalidUsage;
+      }
+  }
+  for (auto* r : rs) {
+    if (r->state != 1) continue;
+    r->state = 0;
+    r->nAborts++;
+    gdakiRecResume(r);  // QPs stay in ERR; the Q4 error stays set
+    WARN("GIN/REC: recovery aborted (peer=%d); QPs left in ERR", peer);
+  }
+  return ncclSuccess;
+}
+
+// ===========================================================================
+// GIN transparent recovery S1 (research build; default OFF).
+//   NCCL_GIN_FAULT_TRANSPARENT=1  needs NCCL_GIN_FAULT_RECOVERY=1 and NCCL_GIN_FAULT_CLASSIFY=1; user devComm,
+//                                 GPU-rung doorbells (GPU_SM_DB), ring CQ, no companion QPs. Must be set on
+//                                 every rank (init is collective). Each GDAKI context has its own helper.
+//   NCCL_GIN_TS_HANDSHAKE_MS=<ms>  handshake bound (3000); the initiator waits for ACK this long plus the
+//                                 responder's quiesce and drain bounds, the responder for DONE twice this
+//   NCCL_GIN_TS_HOLD_MS=<ms>       device: bound on how long a waiter holds for one recovery (30000; it must
+//                                 exceed the host's own bounds for one round, ~quiesce+drain+2x handshake)
+//   NCCL_GIN_TS_QUIESCE_MS=<ms>    bound on waiting for in-gate posters to leave (5000)
+//   NCCL_GIN_TS_CONNECT_MS=<ms>    bound on the init-time socket setup (15000)
+//   NCCL_GIN_TS_ROUND_MS=<ms>      watchdog: a helper round (or queued fault with no live helper) older than
+//                                 this surfaces the fault through ncclCommGetAsyncError (25000)
+//   NCCL_GIN_TS_PATH_WAIT_MS=<ms>  S2: at a reconnect, bound on waiting for this rank's own GID (looked up by
+//                                 value) to be back in the table after an address removal (30000, clamped to
+//                                 min(ROUND_MS, HOLD_MS) - HANDSHAKE_MS - 1000 = 21000 with the defaults, with a
+//                                 WARN); the handshake bounds grow by it, all bounded by what is left of the round
+//   NCCL_GIN_TS_RESCUE_LAPS=<n>    S2: rescue area per QP, in SQ rings (32; 0 = none): a poster that reuses the
+//                                 slot of a WQE that completed in error keeps a copy there for the re-post
+//   NCCL_GIN_TS_TIE_BREAK=0|1      S2: simultaneous initiation from both ends: the lower rank keeps the round
+//                                 and the higher rank answers it (1, default); 0 = S1 (NACK, both decline)
+//   test only: NCCL_GIN_TS_TEST_STALL=<ms>@quiesce|commit|replay|publishing (the initiator's helper sleeps in
+//   its round: after quiesce, after both commits, after the commit point, after the PUBLISHING mark),
+//   NCCL_GIN_TS_TEST_DIE=quiesce (the initiator's helper thread exits mid-round, leaving the QPs paused),
+//   NCCL_GIN_TS_TEST_SPLIT=<k>[,<k>...] (split the k-th put+signal: see struct ncclGinTsTest),
+//   NCCL_GIN_TS_TEST_SELF_REPORT=1 (S2: the helper gets a LOCAL_QP_ERR record when the fault hook fires on its rank)
+//   NCCL_GIN_TS_TEST_SOCK_MUTE=<start ms>:<length ms> (gin-s2-close: drop every segment arriving on the helper
+//   sockets for that window, a silent management-network outage of this connection; see gdakiTsTestMute)
+//   NCCL_GIN_TS_USER_ABORT=0|1 (gin-s2-close, default 1: a user devComm gets the communicator's device abort flag)
+//   NCCL_GIN_TS_RECONNECT=0|1 (gin-reconnect, default 1: a helper socket lost without evidence of death is re-dialled
+//   by the lower rank every 500 ms and re-accepted by the higher rank), NCCL_GIN_TS_RECONNECT_MS=<ms> (10000: how
+//   long a fault on such a peer waits for the reconnect before it is declined as "peer liveness unknown")
+//   NCCL_GIN_TS_PAIR_RESET=0|1 (gin-pair-reset, default 1: a round covers only the faulted GIN context's QP pair when
+//   this rank's other QPs to the peer are RTS and no other context's fault for the peer is queued; otherwise, and after
+//   a scope conflict of simultaneous rounds, every context as before; the scope travels in REQ/ACK), test only:
+//   NCCL_GIN_FAULT_INJECT_CTX=<c> (the fault hook moves only GIN context c's QPs to ERR)
+//   NCCL_GIN_TS_PAIR_CHECK=0|1 (gin-pair-check, default 1: before answering a narrowed REQ the answering rank queries its
+//   own QPs to the initiator outside the scope and refuses (NACK 12) if any is not RTS; the initiator then reruns the
+//   round as a full reset. A rank with NCCL_GIN_TS_PAIR_RESET=0 refuses every narrowed REQ. After a scope conflict the
+//   higher rank's fault is decided again; a second conflict on it runs as a full reset)
+//   NCCL_GIN_TS_DIAG=norebase|noring  negative controls only: waiters keep their stale ticket / the
+//                                 host does not ring the doorbell for the re-posted WQEs
+// gin-harden (harness/gpu-initiated/gin_recovery/harden/EXPERIMENT.md section 9):
+//   - a user devComm has its own abort word (ncclGinTsUserAbortWord), raised with NCCL_DEVCOMM_ABORT_ERROR by
+//     ncclCommAbort, an aborting ncclCommShrink, ncclCommRevoke, a decline, a peer judged dead and the firmware-phase
+//     watchdog; a wait it releases returns ncclRemoteError (nccl_device/utility.h)
+//   - liveness: death needs two refused connects at least 1000 ms apart; HELLO, HELLO-ACK and PROBE carry a random
+//     per-context nonce (a mismatch is "not accepted", never a connection or a death); a peer that leaves sends BYE
+//     first (its FIN is then "left", not death); a FIN or reset inside a round before the commit cancels the round, the
+//     peer becomes unknown and the fault is retried after the reconnect (at most 3 times); a peer judged dead is
+//     declined at once (async error, user waits released with an error)
+//   - bounds: every device-state copy (NCCL_GIN_TS_COPY_MS=2000), every firmware-command phase of a round
+//     (NCCL_GIN_TS_FW_MS=3000: watchdog), the helper join of ncclCommAbort (NCCL_GIN_TS_ABORT_JOIN_MS=3000)
+//   - a round's re-post targets are all validated before any is posted
+//   - escalation: more than NCCL_GIN_TS_ESCALATE_ROUNDS=8 rounds within NCCL_GIN_TS_ESCALATE_WINDOW_MS=60000 declines,
+//     raises the async error and stops recovery on the context
+//   - NCCL_GIN_TS_PORT=<p> (default 0: ephemeral): the helper listen socket binds p (p+1 ... p+15 if taken)
+//   - counters: ncclGinGetRecoveryStats (nccl.h, experimental); one INFO summary line at teardown
+//   - test switches (research build only): NCCL_GIN_TS_TEST_LISTEN_GAP=<start ms>:<len ms> (close the listen socket
+//     for that window, then listen again on the same address), NCCL_GIN_TS_TEST_BAD_NONCE=<n> (the first n reconnect
+//     HELLOs or PROBEs this rank sends carry a wrong nonce), NCCL_GIN_TS_TEST_FW_DELAY=<ms>@<phase>,
+//     NCCL_GIN_TS_TEST_COPY_STALL=<ms> (the first round's stream is held by a host callback for <ms>),
+//     NCCL_GIN_TS_TEST_BAD_REPOST=<k> (the re-post plan rejects the k-th QP of the round)
+// The application's kernels and host code are unchanged. A helper thread per GDAKI context (not the
+// application) takes the device-classified fault from the Q4 mailbox, applies the policy (LOCAL_QP_ERR:
+// recover; RETRY_EXC: recover iff the peer's socket shows no FIN/RST; else decline), pauses the device
+// posters (gate in the QP padding), runs the existing Prepare/Commit (gin_recovery v1+v2) with the peer
+// over a library-owned TCP socket, learns from the peer's QPC how many of its WQEs the peer executed
+// (rmsn), re-posts the rest into the reset SQ, rings the doorbell from the host, and publishes a new
+// gate epoch with a logical base so device waiters that hold across the recovery rebase their ticket
+// (gin_gdaki.h tsPoll). Design and measurements: harness/gpu-initiated/gin_recovery/TRANSPARENT_S1.md.
+// ===========================================================================
+NCCL_PARAM(GinFaultTransparent, "GIN_FAULT_TRANSPARENT", 0);
+// gin-s2-close: with transparent recovery on, give a user devComm the communicator's device abort flag
+// (dev_runtime.cc), so ncclCommAbort releases its kernels' GIN waits, waitSignal included, as it does for NCCL's
+// own devComms. NCCL_GIN_TS_USER_ABORT=0 keeps the stock null flag.
+NCCL_PARAM(GinTsUserAbort, "GIN_TS_USER_ABORT", 1);
+bool ncclGinTsUserAbortEnabled() {
+  return ncclParamGinFaultRecovery() && ncclParamGinFaultTransparent() && ncclParamGinTsUserAbort() != 0;
+}
+NCCL_PARAM(GinTsHandshakeMs, "GIN_TS_HANDSHAKE_MS", 3000);
+NCCL_PARAM(GinTsHoldMs, "GIN_TS_HOLD_MS", 30000);
+NCCL_PARAM(GinTsQuiesceMs, "GIN_TS_QUIESCE_MS", 5000);
+NCCL_PARAM(GinTsConnectMs, "GIN_TS_CONNECT_MS", 15000);
+NCCL_PARAM(GinTsRoundMs, "GIN_TS_ROUND_MS", 25000);
+NCCL_PARAM(GinTsPathWaitMs, "GIN_TS_PATH_WAIT_MS", 30000);
+NCCL_PARAM(GinTsTieBreak, "GIN_TS_TIE_BREAK", 1);
+NCCL_PARAM(GinTsRescueLaps, "GIN_TS_RESCUE_LAPS", 32);
+NCCL_PARAM(GinTsReconnect, "GIN_TS_RECONNECT", 1);          // gin-reconnect
+NCCL_PARAM(GinTsReconnectMs, "GIN_TS_RECONNECT_MS", 10000); // gin-reconnect
+NCCL_PARAM(GinTsPairReset, "GIN_TS_PAIR_RESET", 1);         // gin-pair-reset
+NCCL_PARAM(GinTsPairCheck, "GIN_TS_PAIR_CHECK", 1);         // gin-pair-check
+NCCL_PARAM(GinTsFwMs, "GIN_TS_FW_MS", 3000);                       // gin-harden
+NCCL_PARAM(GinTsAbortJoinMs, "GIN_TS_ABORT_JOIN_MS", 3000);        // gin-harden
+NCCL_PARAM(GinTsAbortJoinMaxMs, "GIN_TS_ABORT_JOIN_MAX_MS", 15000); // gin-harden: when not in a firmware command
+NCCL_PARAM(GinTsEscalateRounds, "GIN_TS_ESCALATE_ROUNDS", 8);      // gin-harden (0: no cap)
+NCCL_PARAM(GinTsEscalateWindowMs, "GIN_TS_ESCALATE_WINDOW_MS", 60000);  // gin-harden
+NCCL_PARAM(GinTsPort, "GIN_TS_PORT", 0);                           // gin-harden
+#define GDAKI_TS_SOCK_RETRIES 3  // gin-harden: retries of one fault after a socket loss inside its round
+
+// ---- gin-harden: the user devComm abort word of a communicator ----
+// One host-pinned word per communicator (ncclCudaHostCalloc, read by the device through UVA), created for the first
+// user devComm (dev_runtime.cc) and freed with the communicator (init.cc commFree). Raised once, never cleared, always
+// with NCCL_DEVCOMM_ABORT_ERROR | why: every user wait of the communicator then returns an error, and a waiter parked
+// in a gate (gin_gdaki.h tsParkStable) fails without any copy or firmware command.
+enum { GDAKI_UA_ABORT = 1, GDAKI_UA_REVOKE = 2, GDAKI_UA_SHRINK = 3, GDAKI_UA_DECLINED = 4, GDAKI_UA_PEER_DEAD = 5,
+       GDAKI_UA_FW_WATCHDOG = 6 };
+static const char* gdakiUaName(int why) {
+  switch (why) {
+    case GDAKI_UA_ABORT: return "abort";
+    case GDAKI_UA_REVOKE: return "revoke";
+    case GDAKI_UA_SHRINK: return "shrink";
+    case GDAKI_UA_DECLINED: return "declined";
+    case GDAKI_UA_PEER_DEAD: return "peer-dead";
+    case GDAKI_UA_FW_WATCHDOG: return "fw-watchdog";
+    default: return "?";
+  }
+}
+struct gdakiUa {
+  void* comm;
+  int rank;
+  uint32_t* word;
+  int why;
+};
+static std::mutex gdakiUaMu;
+static std::vector<struct gdakiUa> gdakiUaReg;
+
+uint32_t* ncclGinTsUserAbortWord(void* comm, int rank) {
+  if (comm == nullptr || !ncclGinTsUserAbortEnabled()) return nullptr;
+  std::lock_guard<std::mutex> lk(gdakiUaMu);
+  uint32_t* w = nullptr;
+  for (auto& e : gdakiUaReg)
+    if (e.comm == comm) w = e.word;
+  if (w == nullptr) {
+    if (ncclCudaHostCalloc(&w, 1) != ncclSuccess || w == nullptr) return nullptr;
+    gdakiUaReg.push_back({comm, rank, w, 0});
+  }
+  {  // the recovery helpers of this communicator's contexts (those of this devComm included: they are registered by now)
+     // give the word to their gates, for parked posters (gdakiTsPosterWordStep)
+    std::lock_guard<std::mutex> rl(gdakiRecRegMu);
+    for (auto* r : gdakiRecReg)
+      if (r->commKey == comm) r->posterWord.store((uint64_t)(uintptr_t)w | 1ull, std::memory_order_release);
+  }
+  return w;
+}
+
+void ncclGinTsUserAbortRaise(void* comm, int why) {
+  if (comm == nullptr) return;
+  int rank = -1;
+  {
+    std::lock_guard<std::mutex> lk(gdakiUaMu);
+    struct gdakiUa* e = nullptr;
+    for (auto& x : gdakiUaReg)
+      if (x.comm == comm) e = &x;
+    if (e == nullptr || e->why != 0) return;
+    e->why = why;
+    rank = e->rank;
+    __atomic_store_n(e->word, NCCL_DEVCOMM_ABORT_ERROR | (uint32_t)why, __ATOMIC_RELEASE);
+  }
+  if (why == GDAKI_UA_ABORT || why == GDAKI_UA_REVOKE || why == GDAKI_UA_SHRINK)
+    GIN_TS_NOTE("GIN/TS: user devComm waits released rank=%d why=%s mono_ms=%.3f", rank, gdakiUaName(why), gdakiQ4MonoMs());
+  else
+    WARN("GIN/TS: user devComm waits released rank=%d why=%s mono_ms=%.3f", rank, gdakiUaName(why), gdakiQ4MonoMs());
+}
+
+void ncclGinTsUserAbortFree(void* comm) {
+  uint32_t* w = nullptr;
+  {
+    std::lock_guard<std::mutex> lk(gdakiUaMu);
+    for (size_t i = 0; i < gdakiUaReg.size(); i++)
+      if (gdakiUaReg[i].comm == comm) {
+        w = gdakiUaReg[i].word;
+        gdakiUaReg.erase(gdakiUaReg.begin() + i);
+        break;
+      }
+  }
+  if (w) (void)ncclCudaHostFree(w);
+}
+
+#define GDAKI_TS_MAGIC 0x31535447u  // "GTS1"
+#define GDAKI_TS_DIAG_NOREBASE 0x1u
+#define GDAKI_TS_DIAG_NORING 0x2u
+enum { GDAKI_TS_HELLO = 1, GDAKI_TS_REQ = 2, GDAKI_TS_ACK = 3, GDAKI_TS_NACK = 4, GDAKI_TS_DONE = 5, GDAKI_TS_FAIL = 6,
+       GDAKI_TS_HELLO_ACK = 7, GDAKI_TS_PROBE = 8,  // gin-oneway: reconnect confirmation, liveness probe
+       GDAKI_TS_PROBE_ACK = 9, GDAKI_TS_BYE = 10 };  // gin-harden: probe answer with the nonce; orderly leave
+
+static const char* gdakiTsMsgName(uint32_t t) {
+  switch (t) {
+  case GDAKI_TS_HELLO: return "HELLO";
+  case GDAKI_TS_REQ: return "REQ";
+  case GDAKI_TS_ACK: return "ACK";
+  case GDAKI_TS_NACK: return "NACK";
+  case GDAKI_TS_DONE: return "DONE";
+  case GDAKI_TS_FAIL: return "FAIL";
+  case GDAKI_TS_HELLO_ACK: return "HELLO_ACK";
+  case GDAKI_TS_PROBE: return "PROBE";
+  case GDAKI_TS_PROBE_ACK: return "PROBE_ACK";
+  case GDAKI_TS_BYE: return "BYE";
+  default: return "?";
+  }
+}
+
+// One fixed-size record on the helper socket.
+struct gdakiTsMsg {
+  uint32_t magic;
+  uint32_t type;
+  uint64_t round;  // initiator's round number (REQ/ACK/NACK/DONE of one round carry the same value)
+  int32_t from;
+  int32_t arg;     // REQ: fault class; NACK/FAIL: reason code
+  uint32_t nqp;
+  uint32_t pad;
+  ncclGinRecoverToken_t tok;                       // REQ/ACK: Prepare token of the sender
+  uint32_t executed[NCCL_GIN_RECOVERY_MAX_QPS];    // REQ/ACK: request messages of the receiver's QP (token
+                                                   // order) that the sender's QP executed in this incarnation
+  uint32_t nrp[NCCL_GIN_RECOVERY_MAX_QPS];         // REQ/ACK: sender's next_rcv_psn per QP (diagnostic)
+  double t[4];                                     // ACK: responder's quiesce/prepare/commit/total (us)
+  uint64_t nonce;                                  // gin-harden: the context's random nonce (every record)
+};
+
+struct gdakiTsPeer {
+  int fd = -1;
+  bool gone = false;      // FIN/RST seen: recovery with this peer is no longer possible
+  bool declined = false;  // terminal
+  size_t have = 0;        // bytes of a partial record in buf
+  struct gdakiTsMsg buf;
+  char closeCause[24] = {0};  // gin-s2-close: why gdakiTsPump last failed (FIN, BADMAGIC or the errno name)
+  // gin-reconnect: a socket lost without evidence of death (timeout, unreachable) is "unknown": it is closed and the
+  // lower rank re-dials while the higher rank re-accepts. `gone` stays the dead state (FIN, reset, refused re-dial...).
+  bool gated = false;         // this peer had a helper socket after setup (its QPs are gated)
+  bool unknown = false;       // no current socket, no evidence of death: waiting for a reconnect
+  char lostCause[24] = {0};   // the cause that made the peer unknown or dead
+  uint32_t gen = 0;           // generation of the current connection (0 = the one from setup)
+  double lostMs = 0;          // when the socket was lost (unknown)
+  int dialFd = -1;            // lower rank: re-dial in progress
+  double dialStartMs = 0, nextDialMs = 0;
+  int attempts = 0;           // re-dial attempts since the loss
+  bool haveAddr = false;      // the higher rank's listen address (setup all-gather), for the re-dial
+  union ncclSocketAddress addr;  // gin-oneway: kept for lower ranks too (the higher rank's probe)
+  // gin-oneway: the lower rank installs a re-dial only after the higher rank's HELLO-ACK; the higher rank probes an
+  // unknown lower rank's listen port (refused: dead).
+  int pendFd = -1;            // lower rank: re-dial whose HELLO was sent, waiting for the HELLO-ACK
+  double pendStartMs = 0;
+  uint32_t pendGen = 0;       // generation in that HELLO
+  uint32_t helloSeq = 0;      // last generation sent in a HELLO (grows with every attempt)
+  size_t pendHave = 0;
+  struct gdakiTsMsg pendBuf;
+  char pendCause[24] = {0};
+  int probeFd = -1;           // higher rank: probe connect in flight
+  double probeStartMs = 0, nextProbeMs = 0;
+  bool probeAnswered = false; // an answered probe was logged since the last loss
+  // gin-harden
+  int refusals = 0;           // refused connects (re-dial or probe) since the last connect that went through
+  double firstRefusalMs = 0;  // the first of them: death needs a second one at least 1000 ms later
+  bool left = false;          // the peer sent BYE (it left the communicator): its FIN is not death
+  bool deadJudged = false;    // judged dead, not yet declined (the helper declines it at once)
+  bool failPending = false;   // declined, but a gate could not be failed (copies blocked): gdakiTsScan retries it
+  bool probeWaiting = false;  // higher rank: the probe connected and sent PROBE; waiting for PROBE-ACK (500 ms)
+  double probeSentMs = 0;
+  size_t probeHave = 0;
+  struct gdakiTsMsg probeBuf;
+  char probeCause[24] = {0};
+};
+
+struct gdakiTsQp {        // host copy, per qp_idx
+  uint32_t epoch = 0;     // current stable (even) epoch of the gate
+  uint64_t lbase = 0;     // host copy of gate.lbase (logical index of physical WQE 0 of the stable epoch)
+  uint32_t handled = 0;   // highest record epoch + 2 the helper has taken (for the lost-record scan)
+  int lostScans = 0;      // consecutive scans that saw gate.reported ahead of `handled`
+  uint32_t rmsn0 = 0;     // responder MSN at the start of the current incarnation
+  void* rescue = nullptr; // S2: device rescue area of this QP (rescueLaps x sq_wqe_num x 64 B)
+};
+
+struct gdakiTsFault {
+  struct ncclGinGdakiQ4Record rec;
+  double monoMs;          // when the Q4 watcher read the record
+  bool full = false;      // gin-pair-reset: this round covers every context (gin-pair-check: see fullWhy)
+  int fullWhy = 0;        // gin-pair-check: 1 = the peer refused the narrowed scope, 2 = a second scope conflict
+  int conflicts = 0;      // gin-pair-check: scope conflicts this fault has met
+  int sockRetries = 0;    // gin-harden: rounds of this fault cancelled by a socket loss before the commit
+};
+
+struct gdakiTs {
+  std::thread th;
+  std::atomic<bool> stop{false};
+  std::mutex qMu;
+  std::vector<struct gdakiTsFault> faults;
+  std::vector<struct gdakiTsPeer> peers;  // by rank
+  std::vector<struct gdakiTsQp> qs;       // by qp_idx
+  uint32_t diag = 0;
+  int handshakeMs = 3000, holdMs = 30000, quiesceMs = 5000;
+  int pathWaitMs = 30000;                 // S2: bound on waiting for this rank's own address (GID) at a reconnect
+  int tieBreak = 1;                       // S2: simultaneous initiation resolved by rank (0: S1 NACK + decline)
+  char gidType[32] = {0};                 // S2: RoCE type of the local GID at context creation (sysfs)
+  int nYielded = 0;
+  uint32_t rescueLaps = 0;                // S2: NCCL_GIN_TS_RESCUE_LAPS
+  uint64_t round = 0;
+  int nRounds = 0, nRecovered = 0, nDeclined = 0, nStale = 0;
+  std::atomic<int> active{0};             // 1 once the helper runs (gdakiTsActive)
+  // Watchdog (read by the Q4 watcher thread, which is independent of the helper).
+  int roundMs = 25000;
+  std::atomic<int64_t> busySinceUs{0};    // start of the helper's current round, 0 when idle
+  std::atomic<int64_t> heartbeatUs{0};    // last helper loop iteration
+  std::atomic<int> nQueued{0};            // fault records queued and not yet taken by the helper
+  std::atomic<int> surfaced{0};           // 1 once the watchdog raised the error (the helper then declines)
+  // Test knobs (research build).
+  int stallMs = 0, stallStage = 0;        // stage 1 = after quiesce, 2 = after commit, 3 = after the commit point
+  int dieStage = 0;                       // 1 = helper thread exits after quiesce
+  int muteStartMs = -1, muteLenMs = 0;    // gin-s2-close: NCCL_GIN_TS_TEST_SOCK_MUTE=<start ms>:<length ms>
+  bool muteOn = false;                    // gin-reconnect: the mute is on (new sockets get the filter too)
+  int muteState = 0;                      // gin-reconnect: 0 before, 1 on, 2 off (kept here so that a fault's wait
+  double muteT0 = 0;                      //   for a reconnect also runs the mute schedule); origin of the schedule
+  int listenFd = -1;                      // gin-reconnect: the setup's listen socket, kept for re-accepts
+  uint32_t ctxSeq = 0;                    // gin-reconnect: helper creation order (equal on every rank), in HELLO.arg
+  int reconnect = 1;                      // gin-reconnect: NCCL_GIN_TS_RECONNECT
+  int reconnectMs = 10000;                // gin-reconnect: NCCL_GIN_TS_RECONNECT_MS (bound of the wait in a fault)
+  int pairReset = 1;                      // gin-pair-reset: NCCL_GIN_TS_PAIR_RESET
+  int pairCheck = 1;                      // gin-pair-check: NCCL_GIN_TS_PAIR_CHECK
+  int testRefuseHello = 0;                // gin-oneway (test switch): NCCL_GIN_TS_TEST_REFUSE_HELLO, HELLOs still to refuse
+  const std::vector<struct gdakiTsFault>* batch = nullptr;  // gin-pair-reset: the fault batch the helper is handling
+  size_t batchPos = 0;                                       //   and the position of the fault being initiated
+  std::atomic<int> dead{0};
+  struct ncclGinTsTest* test = nullptr;   // host-mapped (NCCL_GIN_TS_TEST_SPLIT)
+  struct ncclGinTsTest* testDev = nullptr;
+  std::thread testTh;
+  // Communicator teardown (ncclGinGdakiTsCommTeardown). ts is never deleted there: other threads read it
+  // without a lock (gdakiTsActive in ncclGinGdakiQueryLastError, reachable from ncclCommGetAsyncError at
+  // any time, including during ncclCommAbort); it goes with the context (gdakiRecFree).
+  bool stopped = false;                   // threads joined, sockets closed (gdakiTsStop)
+  std::atomic<int> tearing{0};            // 1 while the teardown runs
+  std::atomic<uint64_t> tdQueries{0};     // ncclGinGdakiQueryLastError calls that overlapped it (test evidence)
+  // gin-harden
+  uint64_t nonce = 0;                     // random per GDAKI context (all ranks' salts mixed); in every record
+  std::atomic<int> exited{0};             // the helper loop returned (bounded join, gdakiTsJoinBounded)
+  std::atomic<int> orphan{0};             // ncclCommAbort stopped waiting for it (detached; its context is kept)
+  // The helper's life: RUNNING -> EXITED (the helper, at its end) or RUNNING -> ORPHAN (a bounded join that gave up),
+  // one compare-and-swap each, so exactly one of them wins (gdakiTsJoinBounded, end of gdakiTsMain).
+  std::atomic<int> life{0};
+  // Serialises the helper's (and the watcher's) writes into the communicator (async error, user devComm word) with the
+  // orphaning: a teardown that gives up on the helper takes it before the communicator can be freed (gdakiTsToComm).
+  std::mutex outMu;
+  int fwMs = 3000, joinMs = 3000;         // NCCL_GIN_TS_FW_MS, NCCL_GIN_TS_ABORT_JOIN_MS
+  int joinMaxMs = 15000;                  // NCCL_GIN_TS_ABORT_JOIN_MAX_MS: bound when the helper is not in a firmware phase
+  int escRounds = 8, escWindowMs = 60000; // NCCL_GIN_TS_ESCALATE_ROUNDS, NCCL_GIN_TS_ESCALATE_WINDOW_MS
+  std::vector<double> roundStarts;        // helper only: start times of the rounds inside the window
+  std::atomic<bool> escalated{false};     // recovery stopped on this context (read by ncclGinGetRecoveryStats)
+  int listenPort = 0;
+  // ncclGinGetRecoveryStats (written by the helper and the watcher, read by any thread)
+  std::atomic<int> cRounds{0}, cRecovered{0}, cDeclined{0}, cReconnects{0}, cDeaths{0}, cEscalations{0}, cCancelled{0},
+    cFwOverruns{0};
+  // test switches (research build only; see the section header)
+  int gapStartMs = -1, gapLenMs = 0, gapState = 0;  // NCCL_GIN_TS_TEST_LISTEN_GAP
+  union ncclSocketAddress listenAddr;
+  int badNonce = 0;                       // NCCL_GIN_TS_TEST_BAD_NONCE: reconnect HELLOs/PROBEs still to spoil
+  int fwDelayMs = 0;                      // NCCL_GIN_TS_TEST_FW_DELAY
+  char fwDelayPhase[16] = {0};
+  std::atomic<int> fwDelayDone{0};
+  int copyStallMs = 0;                    // NCCL_GIN_TS_TEST_COPY_STALL
+  bool copyStallDone = false;
+  int badRepost = -1;                     // NCCL_GIN_TS_TEST_BAD_REPOST
+};
+
+static int64_t gdakiTsNowUs() {
+  struct timespec t;
+  clock_gettime(CLOCK_MONOTONIC, &t);
+  return (int64_t)t.tv_sec * 1000000 + t.tv_nsec / 1000;
+}
+
+// gin-harden: the helper's life (struct gdakiTs::life) and its writes into the communicator.
+#define GDAKI_TS_LIFE_RUNNING 0
+#define GDAKI_TS_LIFE_EXITED 1
+#define GDAKI_TS_LIFE_ORPHAN 2
+// Runs `f` (a short, non-blocking write into the communicator: the async error slot, the user devComm word) unless the
+// helper was orphaned; the teardown sets ORPHAN under the same lock before the communicator can be freed.
+template <typename F>
+static bool gdakiTsToComm(struct gdakiTs* ts, F f) {
+  std::lock_guard<std::mutex> lk(ts->outMu);
+  if (ts->life.load(std::memory_order_acquire) == GDAKI_TS_LIFE_ORPHAN) return false;
+  f();
+  return true;
+}
+
+// Marks the helper busy for one round (watchdog input); clears it on every exit path. The heartbeat is
+// refreshed first (release order: the watcher loads busySince with acquire, then the heartbeat), so the
+// end of a long round is never mistaken for a helper that stopped looping.
+struct gdakiTsBusy {
+  struct gdakiTs* ts;
+  explicit gdakiTsBusy(struct gdakiTs* t) : ts(t) { ts->busySinceUs.store(gdakiTsNowUs(), std::memory_order_release); }
+  ~gdakiTsBusy() {
+    if (ts->dead.load(std::memory_order_acquire)) return;
+    ts->heartbeatUs.store(gdakiTsNowUs(), std::memory_order_release);
+    ts->busySinceUs.store(0, std::memory_order_release);
+  }
+};
+
+// S2 (review): a bounded wait inside a round may not outlive the round. Returns min(wantMs, what is left of
+// NCCL_GIN_TS_ROUND_MS minus a margin for the decline path), at least 50 ms; wantMs outside a round.
+static int gdakiTsRoundLeftMs(struct gdakiTs* ts, int wantMs) {
+  const int64_t b = ts->busySinceUs.load(std::memory_order_acquire);
+  if (b == 0) return wantMs;
+  const int64_t left = (int64_t)ts->roundMs - (gdakiTsNowUs() - b) / 1000 - 500;
+  return (int)std::max<int64_t>(50, std::min<int64_t>(wantMs, left));
+}
+
+
+static uint32_t gdakiTsDiag() {
+#ifdef NCCL_GIN_TS_PRODUCTION
+  return 0;  // gin-harden: no negative controls in the production build
+#else
+  const char* e = getenv("NCCL_GIN_TS_DIAG");
+  if (e == nullptr) return 0;
+  uint32_t v = 0;
+  if (strstr(e, "norebase")) v |= GDAKI_TS_DIAG_NOREBASE;
+  if (strstr(e, "noring")) v |= GDAKI_TS_DIAG_NORING;
+  return v;
+#endif
+}
+
+// gin-harden test switch NCCL_GIN_TS_TEST_FW_DELAY=<ms>@<phase>: the first time the helper enters that firmware-command
+// phase it sleeps <ms> inside it, as a slow firmware command would (it does not end early on teardown: a firmware command
+// cannot be interrupted either).
+static void gdakiRecTestFwDelay(struct gdakiRecHost* r, const char* phase) {
+#ifndef NCCL_GIN_TS_PRODUCTION
+  if (!gdakiTsInHelper || r == nullptr || r->ts == nullptr) return;
+  struct gdakiTs* ts = r->ts;
+  if (ts->fwDelayMs <= 0 || strcmp(ts->fwDelayPhase, phase) != 0 || ts->fwDelayDone.exchange(1) != 0) return;
+  WARN("GIN/TS: TEST firmware delay rank=%d %d ms inside phase %s mono_ms=%.3f", r->ctx->rank, ts->fwDelayMs, phase,
+       gdakiQ4MonoMs());
+  std::this_thread::sleep_for(std::chrono::milliseconds(ts->fwDelayMs));
+#else
+  (void)r;
+  (void)phase;
+#endif
+}
+
+// gin-harden: the round must decline once a firmware-command phase overran NCCL_GIN_TS_FW_MS (the watchdog already
+// released the device threads with an error and surfaced the fault).
+static bool gdakiTsFwCheck(struct gdakiRecHost* r, const char** why) {
+  if (r->fwOverrun.load(std::memory_order_acquire) == 0) return false;
+  *why = "a firmware command phase exceeded NCCL_GIN_TS_FW_MS";
+  return true;
+}
+
+static bool gdakiTsActive(struct gdakiRecHost* r) {
+  return r != nullptr && r->ts != nullptr && r->ts->active.load(std::memory_order_acquire) != 0;
+}
+
+// Only faults on a gated QP (a peer with a helper socket) go to the helper.
+static bool gdakiTsRoutes(struct gdakiRecHost* r, const struct ncclGinGdakiQ4Record& rec) {
+  if (!gdakiTsActive(r)) return false;
+  const int p = (int)rec.peer;
+  return p >= 0 && p < (int)r->ts->peers.size() && p != r->ctx->rank && r->ts->peers[p].gated;
+}
+
+static void gdakiTsPushFault(struct gdakiRecHost* r, const struct ncclGinGdakiQ4Record& rec, double monoMs) {
+  std::lock_guard<std::mutex> lk(r->ts->qMu);
+  r->ts->faults.push_back({rec, monoMs});
+  r->ts->nQueued.fetch_add(1, std::memory_order_acq_rel);
+}
+
+// ---- gin-pair-reset: the scope of a round ----
+// Every GIN context with a QP to `peer` (bit c = context c).
+static uint32_t gdakiTsAllMask(struct gdakiRecHost* r, int peer) {
+  const int nranks = r->nranks;
+  uint32_t m = 0;
+  for (int c = 0; c < r->ctx->nContexts && c < 32; c++) {
+    const int i = peer + c * nranks;
+    if (i < (int)r->qps.size() && r->qps[i].used) m |= 1u << c;
+  }
+  return m;
+}
+// The scope as logged: the mask of the contexts a round walks.
+static uint32_t gdakiTsShownScope(struct gdakiRecHost* r, int peer, uint32_t scope) {
+  return scope == GDAKI_TS_SCOPE_ALL ? gdakiTsAllMask(r, peer) : scope;
+}
+// The helper thread's scope for one round; every return path gives the walks every context back.
+struct gdakiTsScopeGuard {
+  explicit gdakiTsScopeGuard(uint32_t s) { gdakiTsScope = s; }
+  ~gdakiTsScopeGuard() { gdakiTsScope = GDAKI_TS_SCOPE_ALL; }
+};
+// A fault put back into the queue (gdakiTsInitiate). gin-pair-check: fullWhy != 0 makes its next round a full reset
+// (1: the peer refused the narrowed scope; 2: a second scope conflict); fullWhy == 0 lets the next round decide its scope
+// again (a scope conflict). front: ahead of the other queued faults.
+static void gdakiTsRequeue(struct gdakiRecHost* r, const struct gdakiTsFault& f, int fullWhy, bool front, bool conflict) {
+  struct gdakiTsFault c = f;
+  if (conflict) c.conflicts++;
+  if (fullWhy != 0) {
+    c.full = true;
+    c.fullWhy = fullWhy;
+  }
+  std::lock_guard<std::mutex> lk(r->ts->qMu);
+  if (front) r->ts->faults.insert(r->ts->faults.begin(), c);
+  else r->ts->faults.push_back(c);
+  r->ts->nQueued.fetch_add(1, std::memory_order_acq_rel);
+}
+// The scope of a round this rank initiates for fault `f` (before the quiesce): the faulted GIN context alone when
+//   the switch is on, the fault was not requeued after a conflict, its context has a QP to the peer, no live fault record
+//   of another context for this peer is waiting (later in the batch being handled, or queued), and every other QP of
+//   this rank to the peer is RTS (QUERY_QP; a failed query counts as not RTS);
+// otherwise every context (GDAKI_TS_SCOPE_ALL). *reason names the first condition that failed ("pair" if none did).
+static uint32_t gdakiTsDecideScope(struct gdakiRecHost* r, const struct gdakiTsFault& f, const char** reason) {
+  struct gdakiTs* ts = r->ts;
+  struct gdaki_context* g = r->ctx;
+  const int nranks = r->nranks;
+  const int peer = (int)f.rec.peer;
+  const int c = (int)f.rec.ctx_id;
+  if (!ts->pairReset) {
+    *reason = "off";
+    return GDAKI_TS_SCOPE_ALL;
+  }
+  if (f.full) {
+    *reason = f.fullWhy == 1 ? "peer" : "requeued";
+    return GDAKI_TS_SCOPE_ALL;
+  }
+  if (c < 0 || c >= g->nContexts || c >= 32 || peer + c * nranks >= (int)r->qps.size() || !r->qps[peer + c * nranks].used) {
+    *reason = "ctx";
+    return GDAKI_TS_SCOPE_ALL;
+  }
+  auto live = [&](const struct gdakiTsFault& o) {  // another context's record for this peer that is not stale
+    if ((int)o.rec.peer != peer || (int)o.rec.ctx_id == c) return false;
+    const int qi = peer + (int)o.rec.ctx_id * nranks;
+    return qi < 0 || qi >= (int)ts->qs.size() || o.rec.ts_epoch >= ts->qs[qi].epoch;
+  };
+  bool queued = false;
+  if (ts->batch != nullptr)
+    for (size_t k = ts->batchPos + 1; k < ts->batch->size() && !queued; k++) queued = live((*ts->batch)[k]);
+  {
+    std::lock_guard<std::mutex> lk(ts->qMu);
+    for (const auto& o : ts->faults)
+      if (!queued) queued = live(o);
+  }
+  if (queued) {
+    *reason = "queued";
+    return GDAKI_TS_SCOPE_ALL;
+  }
+  bool notRts = false;
+  {
+    std::lock_guard<std::mutex> op(r->opMu);  // QUERY_QP never overlaps a QP state change (see gdakiTsQuiesce)
+    gdakiRecFwGuard fw(r, "QUERY_QP");        // gin-harden: firmware-command phase (watchdog)
+    gdakiRecForPeer(r, peer, [&](gdakiRecQp& rq, struct doca_gpu_verbs_qp_hl* q) {
+      if (notRts || rq.ctxIdx == c) return;
+      uint32_t st = 0;
+      gdakiRecFwMark(r);  // gin-harden: one firmware command
+      if (doca_verbs_qp_query_seq(q->qp, nullptr, nullptr, nullptr, &st) != DOCA_SUCCESS || st != 0x3u /* PRM RTS */)
+        notRts = true;
+    });
+  }
+  if (notRts) {
+    *reason = "qp_state";
+    return GDAKI_TS_SCOPE_ALL;
+  }
+  *reason = "pair";
+  // gin-pair-check: a single context's mask that is every context (one GIN context) is the full scope (sent as 0)
+  if ((1u << c) == gdakiTsAllMask(r, peer)) return GDAKI_TS_SCOPE_ALL;
+  return 1u << c;
+}
+
+// gin-pair-check: the answering rank's check of a narrowed scope from `peer`, before anything is paused. Returns 0 to
+// accept, 1 to refuse because a QP of this rank to `peer` outside the scope is not RTS (QUERY_QP; a failed query counts as
+// not RTS), 2 to refuse because this rank's own NCCL_GIN_TS_PAIR_RESET is 0. With NCCL_GIN_TS_PAIR_CHECK=0 it accepts
+// without a query (*checked = 0).
+static int gdakiTsCheckScope(struct gdakiRecHost* r, int peer, uint32_t scope, int* checked, int* notRts, double* us) {
+  struct gdakiTs* ts = r->ts;
+  *checked = 0;
+  *notRts = 0;
+  *us = 0;
+  if (!ts->pairReset) return 2;
+  if (!ts->pairCheck) return 0;
+  const double t0 = gdakiQ4MonoMs();
+  const uint32_t saved = gdakiTsScope;
+  gdakiTsScope = GDAKI_TS_SCOPE_ALL;
+  {
+    std::lock_guard<std::mutex> op(r->opMu);  // QUERY_QP never overlaps a QP state change (see gdakiTsQuiesce)
+    gdakiRecFwGuard fw(r, "QUERY_QP");        // gin-harden: firmware-command phase (watchdog)
+    gdakiRecForPeer(r, peer, [&](gdakiRecQp& rq, struct doca_gpu_verbs_qp_hl* q) {
+      if (rq.ctxIdx < 32 && (scope & (1u << rq.ctxIdx)) != 0) return;
+      (*checked)++;
+      uint32_t st = 0;
+      gdakiRecFwMark(r);  // gin-harden: one firmware command
+      if (doca_verbs_qp_query_seq(q->qp, nullptr, nullptr, nullptr, &st) != DOCA_SUCCESS || st != 0x3u /* PRM RTS */)
+        (*notRts)++;
+    });
+  }
+  gdakiTsScope = saved;
+  *us = (gdakiQ4MonoMs() - t0) * 1e3;
+  return *notRts ? 1 : 0;
+}
+static void gdakiTsCheckLog(struct gdakiRecHost* r, int peer, const struct gdakiTsMsg& req, int res, int checked, int notRts,
+                            double us) {
+  if (res == 0)
+    GIN_TS_NOTE("GIN/TS: rank %d: REQ round %lu from rank %d scope=%#x checked=%d not_rts=0 check_us=%.0f accepted mono_ms=%.3f",
+         r->ctx->rank, (unsigned long)req.round, peer, req.pad, checked, us, gdakiQ4MonoMs());
+  else
+    GIN_TS_NOTE("GIN/TS: rank %d: REQ round %lu from rank %d scope=%#x checked=%d not_rts=%d check_us=%.0f refused reason=%s "
+         "mono_ms=%.3f", r->ctx->rank, (unsigned long)req.round, peer, req.pad, checked, notRts, us,
+         res == 2 ? "off" : "not_rts", gdakiQ4MonoMs());
+}
+
+// Test knob (S2, NCCL_GIN_TS_TEST_SELF_REPORT=1): right after the fault hook fired on this rank, hand the helper a
+// LOCAL_QP_ERR record for its QPs to the first peer, as a device waiter would have. With the hook firing on both
+// ranks at once, both helpers then initiate a round within milliseconds of each other, which exercises the
+// simultaneous-initiation tie-break even when only one rank has traffic in flight.
+#ifndef NCCL_GIN_TS_PRODUCTION
+static void gdakiTsTestSelfReport(struct gdakiRecHost* r) {
+  const char* e = getenv("NCCL_GIN_TS_TEST_SELF_REPORT");
+  if (e == nullptr || atoi(e) == 0 || !gdakiTsActive(r)) return;
+  struct gdaki_context* g = r->ctx;
+  struct gdakiTs* ts = r->ts;
+  int peer = -1;
+  for (int p = 0; p < (int)ts->peers.size() && peer < 0; p++)
+    if (p != g->rank && ts->peers[p].gated) peer = p;
+  if (peer < 0 || peer >= (int)ts->qs.size()) return;
+  struct ncclGinGdakiQ4Record rec;
+  memset(&rec, 0, sizeof(rec));
+  rec.kind = NCCL_GIN_Q4_KIND_ERR_CQE;
+  rec.cls = NCCL_GIN_Q4_CLASS_LOCAL_QP_ERR;
+  rec.peer = (uint32_t)peer;
+  rec.ctx_id = 0;
+  rec.syndrome = 0x05;
+  rec.vendor_err = 0xf5;
+  rec.root_opcode = 0xd;
+  rec.ts_epoch = ts->qs[peer].epoch;  // context 0's QP to `peer`
+  WARN("GIN/TS: TEST self-report rank=%d peer=%d epoch=%u mono_ms=%.3f", g->rank, peer, rec.ts_epoch, gdakiQ4MonoMs());
+  gdakiTsPushFault(r, rec, gdakiQ4MonoMs());
+}
+#endif
+
+// Raise the fault on the host (ncclCommGetAsyncError), once.
+static void gdakiTsSurface(struct gdakiRecHost* r, const char* why) {
+  struct gdakiTs* ts = r->ts;
+  if (ts->surfaced.exchange(1) != 0) return;
+  struct gdakiQ4Host* q4 = r->ctx->q4;
+  // gin-handoff: a surface names no peer (before the flag; never after the communicator is freed)
+  (void)gdakiTsToComm(ts, [&] { gdakiBlameNote(q4->asyncResult, -1); });
+  q4->hasError.store(1, std::memory_order_release);
+  if (q4->asyncResult) {  // gin-harden: never after the communicator is freed (an orphaned helper)
+    (void)gdakiTsToComm(ts, [&] {
+      __atomic_store_n(q4->asyncResult, ncclRemoteError, __ATOMIC_RELEASE);
+      q4->setAsync.store(1, std::memory_order_release);
+    });
+  }
+  WARN("GIN/TS: watchdog rank=%d: %s; the fault surfaces (ncclRemoteError) mono_ms=%.3f", r->ctx->rank, why,
+       gdakiQ4MonoMs());
+}
+
+// Called by the Q4 watcher thread every poll (it does not depend on the helper): a round older than
+// NCCL_GIN_TS_ROUND_MS, or queued fault records with a helper that has not looped for a second,
+// surface the fault instead of letting it vanish with a stalled or dead helper.
+static void gdakiTsWatchdog(struct gdakiRecHost* r) {
+  if (!gdakiTsActive(r)) return;
+  struct gdakiTs* ts = r->ts;
+  // gin-harden: a firmware-command phase of the helper longer than NCCL_GIN_TS_FW_MS. The command cannot be
+  // interrupted: release the device threads now (the user devComm's own word, a CPU store), surface the fault; the
+  // round declines as soon as the command returns (gdakiTsFwCheck).
+  {
+    const int64_t f = r->fwSinceUs.load(std::memory_order_acquire);
+    const int64_t nowUs = gdakiTsNowUs();
+    if (f != 0 && nowUs - f > (int64_t)ts->fwMs * 1000 && r->fwOverrun.exchange(1) == 0) {
+      ts->cFwOverruns.fetch_add(1, std::memory_order_relaxed);
+      WARN("GIN/TS: watchdog rank=%d: firmware command phase %s has run %.0f ms, more than NCCL_GIN_TS_FW_MS=%d; device "
+           "waits are released with an error and the round declines when the command returns mono_ms=%.3f",
+           r->ctx->rank, r->fwPhase.load(std::memory_order_relaxed), (nowUs - f) / 1000.0, ts->fwMs, gdakiQ4MonoMs());
+      (void)gdakiTsToComm(ts, [&] { ncclGinTsUserAbortRaise(r->commKey, GDAKI_UA_FW_WATCHDOG); });
+      gdakiTsSurface(r, "a firmware command phase exceeded NCCL_GIN_TS_FW_MS");
+    }
+  }
+  if (ts->surfaced.load(std::memory_order_acquire)) return;
+  const int64_t now = gdakiTsNowUs();
+  const int64_t b = ts->busySinceUs.load(std::memory_order_acquire);
+  if (b != 0 && now - b > (int64_t)ts->roundMs * 1000) {
+    gdakiTsSurface(r, "a recovery round exceeded NCCL_GIN_TS_ROUND_MS (helper stalled or dead)");
+  } else if (b == 0 && ts->nQueued.load(std::memory_order_acquire) > 0 &&
+             now - ts->heartbeatUs.load(std::memory_order_acquire) > 1000000) {
+    gdakiTsSurface(r, "fault records are queued and the recovery helper is not running");
+  }
+}
+
+// ---- socket helpers (every fd is non-blocking; every wait is bounded) ----
+// gin-oneway (test switch): NCCL_GIN_TS_TEST_SOCK_UTO_MS replaces the helper sockets' TCP_USER_TIMEOUT (default
+// 5000 ms) in this process; keepalive is unchanged. Read once.
+static unsigned int gdakiTsTestUtoMs() {
+#ifdef NCCL_GIN_TS_PRODUCTION
+  return 5000u;  // gin-harden: no test switches in the production build
+#else
+  static const unsigned int v = [] {
+    const char* e = getenv("NCCL_GIN_TS_TEST_SOCK_UTO_MS");
+    const int x = (e && *e) ? atoi(e) : 0;
+    return x > 0 ? (unsigned int)x : 5000u;
+  }();
+  return v;
+#endif
+}
+
+static void gdakiTsSockOpts(int fd) {
+  int one = 1;
+  setsockopt(fd, IPPROTO_TCP, TCP_NODELAY, &one, sizeof(one));
+  // A host that dies without FIN/RST is detected by keepalive / user timeout within about 5 s.
+  setsockopt(fd, SOL_SOCKET, SO_KEEPALIVE, &one, sizeof(one));
+  int idle = 2, intvl = 1, cnt = 3;
+  unsigned int uto = gdakiTsTestUtoMs();  // gin-oneway: 5000 unless the test switch is set
+  setsockopt(fd, IPPROTO_TCP, TCP_KEEPIDLE, &idle, sizeof(idle));
+  setsockopt(fd, IPPROTO_TCP, TCP_KEEPINTVL, &intvl, sizeof(intvl));
+  setsockopt(fd, IPPROTO_TCP, TCP_KEEPCNT, &cnt, sizeof(cnt));
+  setsockopt(fd, IPPROTO_TCP, TCP_USER_TIMEOUT, &uto, sizeof(uto));
+  int fl = fcntl(fd, F_GETFL, 0);
+  if (fl >= 0) fcntl(fd, F_SETFL, fl | O_NONBLOCK);
+  // gin-harden: helper sockets are not inherited by a forked or exec'd child (a child holding the listen socket would
+  // keep a dead rank's port answering)
+  fl = fcntl(fd, F_GETFD, 0);
+  if (fl >= 0) fcntl(fd, F_SETFD, fl | FD_CLOEXEC);
+}
+
+static int gdakiTsSend(int fd, struct gdakiTsMsg* m, int timeoutMs) {
+  m->magic = GDAKI_TS_MAGIC;
+  const char* p = (const char*)m;
+  size_t off = 0;
+  const double deadline = gdakiQ4MonoMs() + timeoutMs;
+  while (off < sizeof(*m)) {
+    ssize_t k = send(fd, p + off, sizeof(*m) - off, MSG_NOSIGNAL | MSG_DONTWAIT);
+    if (k > 0) {
+      off += (size_t)k;
+      continue;
+    }
+    if (k < 0 && (errno == EAGAIN || errno == EWOULDBLOCK || errno == EINTR)) {
+      int rem = (int)(deadline - gdakiQ4MonoMs());
+      if (rem <= 0) return -1;
+      struct pollfd pf = {fd, POLLOUT, 0};
+      (void)poll(&pf, 1, std::min(rem, 5));
+      continue;
+    }
+    return -1;
+  }
+  return 0;
+}
+
+// gin-harden: every close of a connected helper socket by a rank that is not dying sends BYE first, so that the peer
+// reads the FIN that follows as "left" (never as death, which would fail a communicator that has no fault).
+static void gdakiTsByeClose(int fd, int from, uint64_t nonce) {
+  if (fd < 0) return;
+  struct gdakiTsMsg m;
+  memset(&m, 0, sizeof(m));
+  m.type = GDAKI_TS_BYE;
+  m.from = from;
+  m.nonce = nonce;
+  (void)gdakiTsSend(fd, &m, 50);
+  close(fd);
+}
+// A connection still in the listen backlog (a lower rank's re-dial or setup connect, a higher rank's probe) would be
+// reset by closing the listen socket; it gets BYE instead.
+static void gdakiTsCloseListen(int ls, int from, uint64_t nonce) {
+  if (ls < 0) return;
+  for (int k = 0; k < 64; k++) {
+    struct pollfd pf = {ls, POLLIN, 0};
+    if (poll(&pf, 1, 0) != 1 || !(pf.revents & POLLIN)) break;
+    const int fd = accept(ls, nullptr, nullptr);
+    if (fd < 0) break;
+    gdakiTsByeClose(fd, from, nonce);
+  }
+  close(ls);
+}
+// Every socket of the helper: BYE on the connected ones (and on a re-dial whose HELLO went out), then close.
+static void gdakiTsCloseAll(struct gdakiTs* ts, int rank) {
+  for (auto& pe : ts->peers) {
+    if (pe.fd >= 0) {
+      if (!pe.gone) gdakiTsByeClose(pe.fd, rank, ts->nonce);
+      else close(pe.fd);
+      pe.fd = -1;
+    }
+    if (pe.pendFd >= 0) {  // gin-oneway: the higher rank may have installed it already
+      gdakiTsByeClose(pe.pendFd, rank, ts->nonce);
+      pe.pendFd = -1;
+    }
+    if (pe.dialFd >= 0) {  // gin-reconnect: no HELLO sent yet
+      close(pe.dialFd);
+      pe.dialFd = -1;
+    }
+    if (pe.probeFd >= 0) {  // gin-oneway
+      close(pe.probeFd);
+      pe.probeFd = -1;
+    }
+  }
+  gdakiTsCloseListen(ts->listenFd, rank, ts->nonce);
+  ts->listenFd = -1;
+}
+
+// gin-s2-close: a short name for the errno that ended the helper socket (logged, not acted on).
+static const char* gdakiTsErrName(int e) {
+  switch (e) {
+    case ETIMEDOUT: return "ETIMEDOUT";
+    case ECONNRESET: return "ECONNRESET";
+    case EPIPE: return "EPIPE";
+    case EHOSTUNREACH: return "EHOSTUNREACH";
+    case ENETUNREACH: return "ENETUNREACH";
+    case ECONNREFUSED: return "ECONNREFUSED";
+    case ECONNABORTED: return "ECONNABORTED";
+    case ENOTCONN: return "ENOTCONN";
+    case EHOSTDOWN: return "EHOSTDOWN";  // gin-oneway
+    case ENONET: return "ENONET";        // gin-oneway
+    case EBADF: return "EBADF";
+    default: return nullptr;
+  }
+}
+
+// Reads what is available. 1: a whole record is in *out; 0: not yet; -1: FIN, error or bad magic
+// (pe.closeCause then says which).
+// gin-oneway: the same on any fd with its own partial-record state (the pending re-dial uses it too).
+static int gdakiTsPumpRaw(int fd, struct gdakiTsMsg* buf, size_t* have, struct gdakiTsMsg* out, char* cause, size_t clen) {
+  while (*have < sizeof(struct gdakiTsMsg)) {
+    ssize_t k = recv(fd, (char*)buf + *have, sizeof(struct gdakiTsMsg) - *have, MSG_DONTWAIT);
+    if (k == 0) {
+      snprintf(cause, clen, "FIN");
+      return -1;
+    }
+    if (k < 0) {
+      const int e = errno;
+      if (e == EAGAIN || e == EWOULDBLOCK || e == EINTR) return 0;
+      const char* n = gdakiTsErrName(e);
+      if (n) snprintf(cause, clen, "%s", n);
+      else snprintf(cause, clen, "errno%d", e);
+      return -1;
+    }
+    *have += (size_t)k;
+  }
+  *out = *buf;
+  *have = 0;
+  if (out->magic == GDAKI_TS_MAGIC) return 1;
+  snprintf(cause, clen, "BADMAGIC");
+  return -1;
+}
+
+static int gdakiTsPump(struct gdakiTsPeer& pe, struct gdakiTsMsg* out) {
+  return gdakiTsPumpRaw(pe.fd, &pe.buf, &pe.have, out, pe.closeCause, sizeof(pe.closeCause));
+}
+
+// Waits up to timeoutMs for one record. 1 record, 0 timeout, -1 FIN/error.
+static int gdakiTsRecv(struct gdakiTsPeer& pe, struct gdakiTsMsg* out, int timeoutMs, std::atomic<bool>* stop) {
+  const double deadline = gdakiQ4MonoMs() + timeoutMs;
+  while (true) {
+    int r = gdakiTsPump(pe, out);
+    if (r != 0) return r;
+    int rem = (int)(deadline - gdakiQ4MonoMs());
+    if (rem <= 0 || (stop && stop->load(std::memory_order_acquire))) return 0;
+    struct pollfd pf = {pe.fd, POLLIN, 0};
+    (void)poll(&pf, 1, std::min(rem, 5));
+  }
+}
+
+// gin-reconnect: liveness of a peer from its helper socket, three ways.
+// gin-oneway: a reset is no longer death by itself (after a one-way outage the kernel of the side that timed out first
+// resets a live connection). On an established socket:
+//   dead:        FIN, BADMAGIC, any other errno
+//   unknown:     ETIMEDOUT, EHOSTUNREACH, ENETUNREACH, EHOSTDOWN, ENONET, ECONNRESET, EPIPE, ECONNABORTED, ECONNREFUSED
+//                (the socket is closed; the lower rank re-dials, the higher rank probes)
+//   no evidence: EAGAIN, EWOULDBLOCK, EINTR (the socket is as good as before)
+// gin-harden:
+//   left:        any end of the socket after the peer's BYE (it left the communicator: not death, not surfaced)
+//   dead by connect refusal: only after two refused connects (re-dial or probe) at least 1000 ms apart; one refusal
+//                leaves the peer unknown (a firewall reject or a port that is being re-opened refuses once too)
+//   inside a round (before the commit) a FIN or reset cancels the round and leaves the peer unknown (gdakiTsCancelRound)
+enum { GDAKI_TS_LV_NOEVIDENCE = 0, GDAKI_TS_LV_UNKNOWN = 1, GDAKI_TS_LV_DEAD = 2, GDAKI_TS_LV_LEFT = 3 };
+
+static int gdakiTsCauseLiveness(const char* cause) {
+  static const char* const unknown[] = {"ETIMEDOUT", "EHOSTUNREACH", "ENETUNREACH", "EHOSTDOWN", "ENONET",
+                                        "ECONNRESET", "EPIPE", "ECONNABORTED", "ECONNREFUSED"};
+  for (const char* u : unknown)
+    if (!strcmp(cause, u)) return GDAKI_TS_LV_UNKNOWN;
+  return GDAKI_TS_LV_DEAD;
+}
+
+static void gdakiTsMuteFd(struct gdakiTs* ts, int fd);  // test knob, below
+static void gdakiTsTestMute(struct gdakiTs* ts, int rank);  // test knob, below
+
+// The peer is unknown from now: no socket, the lower rank re-dials and the higher rank probes (gin-reconnect, gin-oneway).
+static void gdakiTsMakeUnknown(struct gdakiTsPeer& pe) {
+  if (pe.fd >= 0) {
+    // gin-harden: with a reset, never a FIN: a peer that still holds this connection reads ECONNRESET (unknown), not
+    // FIN (death)
+    struct linger lg = {1, 0};
+    (void)setsockopt(pe.fd, SOL_SOCKET, SO_LINGER, &lg, sizeof(lg));
+    close(pe.fd);
+  }
+  pe.fd = -1;
+  pe.have = 0;
+  pe.unknown = true;
+  pe.gone = false;
+  pe.lostMs = gdakiQ4MonoMs();
+  pe.nextDialMs = pe.lostMs;
+  pe.attempts = 0;
+  pe.nextProbeMs = pe.lostMs;  // gin-oneway: the higher rank probes at once, then every 500 ms
+  pe.probeAnswered = false;
+}
+
+// The helper socket to `p` failed (pe.closeCause). Dead: recovery with this peer ends, and (gin-harden) the peer is
+// declined at once by the helper loop (pe.deadJudged), which raises the async error and releases the user waits. Unknown:
+// the socket is closed and the peer waits for a reconnect. Left (gin-harden): the peer said BYE first. One line each.
+static int gdakiTsSocketLost(struct gdakiRecHost* r, int p, bool connectRefused = false) {
+  struct gdakiTs* ts = r->ts;
+  struct gdakiTsPeer& pe = ts->peers[p];
+  const char* cause = pe.closeCause[0] ? pe.closeCause : "unknown";
+  int lv = connectRefused ? GDAKI_TS_LV_DEAD : gdakiTsCauseLiveness(cause);  // gin-oneway
+  if (pe.left) lv = GDAKI_TS_LV_LEFT;                                        // gin-harden
+  snprintf(pe.lostCause, sizeof(pe.lostCause), "%s", pe.left ? "BYE" : cause);
+  if (lv == GDAKI_TS_LV_UNKNOWN) {
+    gdakiTsMakeUnknown(pe);
+  } else {
+    if (pe.fd >= 0) {
+      close(pe.fd);
+      pe.fd = -1;
+      pe.have = 0;
+    }
+    pe.gone = true;
+    pe.unknown = false;
+  }
+  const char* lvName = lv == GDAKI_TS_LV_UNKNOWN ? "unknown" : lv == GDAKI_TS_LV_LEFT ? "left" : "dead";
+  if (lv == GDAKI_TS_LV_DEAD)
+    WARN("GIN/TS: rank %d: socket to rank %d closed cause=%s mono_ms=%.3f liveness=%s", r->ctx->rank, p, cause,
+         gdakiQ4MonoMs(), lvName);
+  else
+    GIN_TS_NOTE("GIN/TS: rank %d: socket to rank %d closed cause=%s mono_ms=%.3f liveness=%s", r->ctx->rank, p, cause,
+                gdakiQ4MonoMs(), lvName);
+  if (lv == GDAKI_TS_LV_DEAD && !pe.deadJudged && !pe.declined) {  // gin-harden: surfaces at once (gdakiTsMain)
+    pe.deadJudged = true;
+    ts->cDeaths.fetch_add(1, std::memory_order_relaxed);
+    WARN("GIN/TS: rank %d: rank %d judged dead (cause=%s) mono_ms=%.3f", r->ctx->rank, p, cause, gdakiQ4MonoMs());
+  }
+  return lv == GDAKI_TS_LV_LEFT ? GDAKI_TS_LV_DEAD : lv;  // a peer that left cannot take a round either
+}
+
+// gin-harden: a connect (the lower rank's re-dial or the higher rank's probe) to `p` was refused. The peer becomes dead
+// only on a second refusal at least 1000 ms after the first; until then the next attempt waits for that second.
+static void gdakiTsRefused(struct gdakiRecHost* r, int p, bool probe) {
+  struct gdakiTsPeer& pe = r->ts->peers[p];
+  if (pe.left) return;  // it said BYE: a closed listen socket is expected
+  const double now = gdakiQ4MonoMs();
+  if (pe.refusals == 0) pe.firstRefusalMs = now;
+  pe.refusals++;
+  const bool dead = pe.refusals >= 2 && now - pe.firstRefusalMs >= 1000.0;
+  if (probe)
+    GIN_TS_NOTE("GIN/TS: rank %d: probe of rank %d refused (ECONNREFUSED) mono_ms=%.3f refusal=%d", r->ctx->rank, p, now,
+                pe.refusals);
+  else
+    GIN_TS_NOTE("GIN/TS: rank %d: re-dial to rank %d refused (ECONNREFUSED) mono_ms=%.3f refusal=%d", r->ctx->rank, p,
+                now, pe.refusals);
+  if (dead) {
+    snprintf(pe.closeCause, sizeof(pe.closeCause), "ECONNREFUSED");
+    (void)gdakiTsSocketLost(r, p, true);
+    return;
+  }
+  const double next = pe.firstRefusalMs + 1000.0;
+  if (pe.nextDialMs < next) pe.nextDialMs = next;
+  if (pe.nextProbeMs < next) pe.nextProbeMs = next;
+}
+
+// Liveness of `p` now (a peek at the socket; a failure found here is recorded as by the idle loop).
+static int gdakiTsPeerLiveness(struct gdakiRecHost* r, int p, const char** cause) {
+  struct gdakiTsPeer& pe = r->ts->peers[p];
+  *cause = pe.lostCause[0] ? pe.lostCause : "no socket";
+  if (pe.gone) return GDAKI_TS_LV_DEAD;
+  if (pe.unknown) return GDAKI_TS_LV_UNKNOWN;
+  if (pe.fd < 0) return GDAKI_TS_LV_DEAD;
+  if (pe.have > 0) return GDAKI_TS_LV_NOEVIDENCE;
+  char c;
+  ssize_t k = recv(pe.fd, &c, 1, MSG_PEEK | MSG_DONTWAIT);
+  if (k > 0) return GDAKI_TS_LV_NOEVIDENCE;
+  if (k < 0 && (errno == EAGAIN || errno == EWOULDBLOCK || errno == EINTR)) return GDAKI_TS_LV_NOEVIDENCE;
+  if (k == 0) snprintf(pe.closeCause, sizeof(pe.closeCause), "FIN");
+  else {
+    const int e = errno;
+    const char* n = gdakiTsErrName(e);
+    if (n) snprintf(pe.closeCause, sizeof(pe.closeCause), "%s", n);
+    else snprintf(pe.closeCause, sizeof(pe.closeCause), "errno%d", e);
+  }
+  const int lv = gdakiTsSocketLost(r, p);
+  *cause = pe.lostCause;
+  return lv;
+}
+
+// gin-harden: inside a round, a peek that only reports (no liveness decision): true if the socket shows a FIN or an
+// error (pe.closeCause says which). A record already waiting counts as a live socket.
+static bool gdakiTsRoundPeekLost(struct gdakiTsPeer& pe) {
+  if (pe.fd < 0) {
+    if (!pe.closeCause[0]) snprintf(pe.closeCause, sizeof(pe.closeCause), "no socket");
+    return true;
+  }
+  if (pe.have > 0) return false;
+  char c;
+  ssize_t k = recv(pe.fd, &c, 1, MSG_PEEK | MSG_DONTWAIT);
+  if (k > 0) return false;
+  if (k < 0 && (errno == EAGAIN || errno == EWOULDBLOCK || errno == EINTR)) return false;
+  if (k == 0) snprintf(pe.closeCause, sizeof(pe.closeCause), "FIN");
+  else {
+    const int e = errno;
+    const char* n = gdakiTsErrName(e);
+    if (n) snprintf(pe.closeCause, sizeof(pe.closeCause), "%s", n);
+    else snprintf(pe.closeCause, sizeof(pe.closeCause), "errno%d", e);
+  }
+  return true;
+}
+
+// Install `fd` as the connection of generation `gen` to `p`.
+static void gdakiTsInstall(struct gdakiRecHost* r, int p, int fd, uint32_t gen, int attempts) {
+  struct gdakiTsPeer& pe = r->ts->peers[p];
+  if (pe.fd >= 0 && pe.fd != fd) close(pe.fd);
+  pe.fd = fd;
+  pe.have = 0;
+  pe.gen = gen;
+  pe.unknown = false;
+  pe.gone = false;
+  pe.closeCause[0] = '\0';
+  pe.refusals = 0;  // gin-harden
+  r->ts->cReconnects.fetch_add(1, std::memory_order_relaxed);
+  GIN_TS_NOTE("GIN/TS: rank %d: socket to rank %d reconnected gen=%u attempts=%d mono_ms=%.3f", r->ctx->rank, p, gen,
+              attempts, gdakiQ4MonoMs());
+}
+
+// gin-oneway: close with a reset, so that a peer that already installed this socket reads ECONNRESET (unknown), not FIN.
+static void gdakiTsAbortClose(int fd) {
+  struct linger lg = {1, 0};
+  (void)setsockopt(fd, SOL_SOCKET, SO_LINGER, &lg, sizeof(lg));
+  close(fd);
+}
+
+// gin-harden: the peer answered a pending re-dial or a probe with BYE (it is leaving: its listen socket closes next).
+// It left: no more re-dials or probes, never judged dead, not surfaced; a fault toward it later declines.
+static void gdakiTsLeftUninstalled(struct gdakiRecHost* r, int p) {
+  struct gdakiTsPeer& pe = r->ts->peers[p];
+  pe.left = true;
+  pe.unknown = false;
+  pe.gone = true;
+  snprintf(pe.lostCause, sizeof(pe.lostCause), "BYE");
+  GIN_TS_NOTE("GIN/TS: rank %d: rank %d left the communicator (BYE) mono_ms=%.3f", r->ctx->rank, p, gdakiQ4MonoMs());
+}
+
+// gin-oneway: the pending re-dial to `p` was not accepted; the peer stays unknown and is re-dialled.
+static void gdakiTsNotAccepted(struct gdakiRecHost* r, int p, const char* why) {
+  struct gdakiTsPeer& pe = r->ts->peers[p];
+  if (pe.pendFd >= 0) gdakiTsAbortClose(pe.pendFd);
+  pe.pendFd = -1;
+  pe.pendHave = 0;
+  GIN_TS_NOTE("GIN/TS: rank %d: re-dial to rank %d not accepted (%s) attempts=%d mono_ms=%.3f", r->ctx->rank, p, why,
+              pe.attempts, gdakiQ4MonoMs());
+}
+
+// gin-harden: the nonce this rank puts in a reconnect HELLO or a PROBE (test switch NCCL_GIN_TS_TEST_BAD_NONCE spoils
+// the first n of them).
+static uint64_t gdakiTsOutNonce(struct gdakiRecHost* r, int p, const char* what) {
+  struct gdakiTs* ts = r->ts;
+#ifndef NCCL_GIN_TS_PRODUCTION
+  if (ts->badNonce > 0) {
+    ts->badNonce--;
+    WARN("GIN/TS: TEST sent a wrong nonce in %s to rank %d mono_ms=%.3f", what, p, gdakiQ4MonoMs());
+    return ts->nonce ^ 0x5a5aa5a55a5aa5a5ull;
+  }
+#else
+  (void)p;
+  (void)what;
+#endif
+  return ts->nonce;
+}
+
+// One step of the reconnect machinery, never blocking for long (the helper loop and a fault's wait call it):
+//  - lower rank, for every unknown higher peer: a non-blocking re-dial every 500 ms, each connect bounded by 500 ms;
+//    connected -> HELLO (nonce, a new generation) -> wait up to 1000 ms for the HELLO-ACK -> installed
+//    (gin-oneway; anything else ends the attempt with a reset and the peer stays unknown); a refused re-dial
+//    (ECONNREFUSED) counts toward death (gin-harden: two refusals at least 1000 ms apart);
+//  - higher rank, for every unknown lower peer (gin-oneway): a probe connect at once and then every 500 ms, bounded by
+//    500 ms; connected -> PROBE (nonce) -> up to 500 ms for the PROBE-ACK with the same nonce: "answered" (gin-harden;
+//    the peer stays unknown, the lower rank re-dials); a foreign nonce or no answer: not answered; refused: counts toward
+//    death as above;
+//  - every rank: accept on the kept listen socket, read the first record (bounded); a PROBE with this context's nonce
+//    is answered with a PROBE-ACK, any other closed; a HELLO from a lower rank with this context's nonce and a newer
+//    generation is answered with a HELLO-ACK and installed (an old socket to that rank is replaced); a foreign nonce is
+//    refused (closed with a reset).
+static void gdakiTsReconnectStep(struct gdakiRecHost* r) {
+  struct gdakiTs* ts = r->ts;
+  const int rank = r->ctx->rank;
+  if (!ts->reconnect) return;
+  const double now = gdakiQ4MonoMs();
+  for (int p = rank + 1; p < (int)ts->peers.size(); p++) {
+    struct gdakiTsPeer& pe = ts->peers[p];
+    if (!pe.gated || !pe.unknown || pe.declined || !pe.haveAddr) continue;
+    if (pe.pendFd >= 0) {  // gin-oneway: HELLO sent, waiting for the HELLO-ACK
+      struct gdakiTsMsg a;
+      const int got = gdakiTsPumpRaw(pe.pendFd, &pe.pendBuf, &pe.pendHave, &a, pe.pendCause, sizeof(pe.pendCause));
+      if (got == 1 && a.type == GDAKI_TS_HELLO_ACK && a.from == p && a.nonce == ts->nonce &&
+          a.round == (uint64_t)pe.pendGen) {
+        const int fd = pe.pendFd;
+        pe.pendFd = -1;
+        pe.pendHave = 0;
+        gdakiTsInstall(r, p, fd, pe.pendGen, pe.attempts);
+        continue;
+      }
+      if (got == 1 && a.type == GDAKI_TS_BYE && a.from == p && a.nonce == ts->nonce) {  // gin-harden: the peer leaves
+        close(pe.pendFd);
+        pe.pendFd = -1;
+        pe.pendHave = 0;
+        gdakiTsLeftUninstalled(r, p);
+        continue;
+      }
+      if (got == 1 && a.type == GDAKI_TS_HELLO_ACK && a.nonce != ts->nonce) gdakiTsNotAccepted(r, p, "nonce mismatch");
+      else if (got == 1) gdakiTsNotAccepted(r, p, "unexpected reply");
+      else if (got < 0) gdakiTsNotAccepted(r, p, pe.pendCause[0] ? pe.pendCause : "closed");
+      else if (now - pe.pendStartMs >= 1000.0) gdakiTsNotAccepted(r, p, "no HELLO-ACK within 1000 ms");
+      else continue;
+    }
+    if (pe.dialFd >= 0) {
+      struct pollfd pf = {pe.dialFd, POLLOUT, 0};
+      const int pr = poll(&pf, 1, 0);
+      if (pr == 1) {
+        int err = 0;
+        socklen_t elen = sizeof(err);
+        if (getsockopt(pe.dialFd, SOL_SOCKET, SO_ERROR, &err, &elen) != 0) err = errno;
+        if (err == 0) {
+          pe.refusals = 0;  // gin-harden: the port answered
+          struct gdakiTsMsg h;
+          memset(&h, 0, sizeof(h));
+          h.type = GDAKI_TS_HELLO;
+          h.from = rank;
+          h.arg = (int32_t)ts->ctxSeq;
+          pe.helloSeq = std::max(pe.helloSeq, pe.gen) + 1;  // gin-oneway: a new number for every attempt
+          h.round = pe.helloSeq;
+          h.nonce = gdakiTsOutNonce(r, p, "HELLO");  // gin-harden
+          if (gdakiTsSend(pe.dialFd, &h, 200) == 0) {
+            pe.pendFd = pe.dialFd;  // gin-oneway: installed only on the HELLO-ACK
+            pe.dialFd = -1;
+            pe.pendGen = pe.helloSeq;
+            pe.pendStartMs = now;
+            pe.pendHave = 0;
+            pe.pendCause[0] = '\0';
+            continue;
+          }
+          gdakiTsAbortClose(pe.dialFd);
+          pe.dialFd = -1;
+        } else if (err == ECONNREFUSED) {
+          close(pe.dialFd);
+          pe.dialFd = -1;
+          gdakiTsRefused(r, p, false);  // gin-harden: dead only on a second refusal >= 1000 ms later
+          continue;
+        } else {
+          close(pe.dialFd);
+          pe.dialFd = -1;
+        }
+      } else if (now - pe.dialStartMs >= 500.0) {
+        close(pe.dialFd);
+        pe.dialFd = -1;
+      }
+    }
+    if (pe.dialFd < 0 && now >= pe.nextDialMs) {
+      const socklen_t alen = pe.addr.sa.sa_family == AF_INET6 ? sizeof(pe.addr.sin6) : sizeof(pe.addr.sin);
+      const int fd = socket(pe.addr.sa.sa_family, SOCK_STREAM, 0);
+      pe.nextDialMs = now + 500.0;
+      if (fd < 0) continue;
+      gdakiTsSockOpts(fd);
+      gdakiTsMuteFd(ts, fd);
+      pe.attempts++;
+      const int rc = connect(fd, &pe.addr.sa, alen);
+      if (rc == 0 || errno == EINPROGRESS) {
+        pe.dialFd = fd;
+        pe.dialStartMs = now;
+      } else if (errno == ECONNREFUSED) {
+        close(fd);
+        gdakiTsRefused(r, p, false);
+      } else {
+        close(fd);
+      }
+    }
+  }
+  // gin-oneway: the higher rank probes every unknown lower rank's listen port
+  for (int p = 0; p < rank && p < (int)ts->peers.size(); p++) {
+    struct gdakiTsPeer& pe = ts->peers[p];
+    if (!pe.gated || !pe.unknown || pe.declined || !pe.haveAddr) {
+      if (pe.probeFd >= 0) {
+        close(pe.probeFd);
+        pe.probeFd = -1;
+        pe.probeWaiting = false;
+      }
+      continue;
+    }
+    if (pe.probeFd >= 0 && pe.probeWaiting) {  // gin-harden: PROBE sent, waiting for the PROBE-ACK
+      struct gdakiTsMsg a;
+      const int got = gdakiTsPumpRaw(pe.probeFd, &pe.probeBuf, &pe.probeHave, &a, pe.probeCause, sizeof(pe.probeCause));
+      if (got == 0 && now - pe.probeSentMs < 500.0) continue;
+      const bool ok = got == 1 && a.type == GDAKI_TS_PROBE_ACK && a.from == p && a.nonce == ts->nonce;
+      close(pe.probeFd);
+      pe.probeFd = -1;
+      pe.probeWaiting = false;
+      if (got == 1 && a.type == GDAKI_TS_BYE && a.from == p && a.nonce == ts->nonce) {  // gin-harden: the peer leaves
+        gdakiTsLeftUninstalled(r, p);
+        continue;
+      }
+      if (ok) {
+        pe.refusals = 0;
+        if (!pe.probeAnswered) {
+          pe.probeAnswered = true;
+          GIN_TS_NOTE("GIN/TS: rank %d: probe of rank %d answered mono_ms=%.3f", rank, p, gdakiQ4MonoMs());
+        }
+      } else {
+        GIN_TS_NOTE("GIN/TS: rank %d: probe of rank %d not answered by the peer (%s) mono_ms=%.3f", rank, p,
+                    got == 1 ? (a.nonce != ts->nonce ? "nonce mismatch" : "unexpected reply")
+                             : got < 0 ? (pe.probeCause[0] ? pe.probeCause : "closed") : "no PROBE-ACK within 500 ms",
+                    gdakiQ4MonoMs());
+      }
+      continue;
+    }
+    if (pe.probeFd >= 0) {
+      struct pollfd pf = {pe.probeFd, POLLOUT, 0};
+      const int pr = poll(&pf, 1, 0);
+      if (pr == 1) {
+        int err = 0;
+        socklen_t elen = sizeof(err);
+        if (getsockopt(pe.probeFd, SOL_SOCKET, SO_ERROR, &err, &elen) != 0) err = errno;
+        if (err == 0) {
+          struct gdakiTsMsg m;
+          memset(&m, 0, sizeof(m));
+          m.type = GDAKI_TS_PROBE;
+          m.from = rank;
+          m.arg = (int32_t)ts->ctxSeq;
+          m.nonce = gdakiTsOutNonce(r, p, "PROBE");  // gin-harden
+          if (gdakiTsSend(pe.probeFd, &m, 50) == 0) {
+            pe.probeWaiting = true;
+            pe.probeSentMs = now;
+            pe.probeHave = 0;
+            pe.probeCause[0] = '\0';
+          } else {
+            close(pe.probeFd);
+            pe.probeFd = -1;
+          }
+        } else if (err == ECONNREFUSED) {
+          close(pe.probeFd);
+          pe.probeFd = -1;
+          gdakiTsRefused(r, p, true);  // gin-harden: dead only on a second refusal >= 1000 ms later
+          continue;
+        } else {
+          close(pe.probeFd);
+          pe.probeFd = -1;
+        }
+      } else if (now - pe.probeStartMs >= 500.0) {
+        close(pe.probeFd);
+        pe.probeFd = -1;
+      }
+    }
+    if (pe.probeFd < 0 && now >= pe.nextProbeMs) {
+      const socklen_t alen = pe.addr.sa.sa_family == AF_INET6 ? sizeof(pe.addr.sin6) : sizeof(pe.addr.sin);
+      const int fd = socket(pe.addr.sa.sa_family, SOCK_STREAM, 0);
+      pe.nextProbeMs = now + 500.0;
+      if (fd < 0) continue;
+      gdakiTsSockOpts(fd);
+      gdakiTsMuteFd(ts, fd);
+      const int rc = connect(fd, &pe.addr.sa, alen);
+      if (rc == 0 || errno == EINPROGRESS) {
+        pe.probeFd = fd;
+        pe.probeStartMs = now;
+        pe.probeWaiting = false;
+      } else if (errno == ECONNREFUSED) {
+        close(fd);
+        gdakiTsRefused(r, p, true);
+      } else {
+        close(fd);
+      }
+    }
+  }
+  if (ts->listenFd >= 0) {
+    struct pollfd pf = {ts->listenFd, POLLIN, 0};
+    while (poll(&pf, 1, 0) == 1 && (pf.revents & POLLIN)) {
+      const int fd = accept(ts->listenFd, nullptr, nullptr);
+      if (fd < 0) break;
+      gdakiTsSockOpts(fd);
+      gdakiTsMuteFd(ts, fd);
+      struct gdakiTsPeer tmp;
+      tmp.fd = fd;
+      struct gdakiTsMsg h;
+      memset(&h, 0, sizeof(h));
+      const int got = gdakiTsRecv(tmp, &h, 500, &ts->stop);
+      if (got == 1 && h.type == GDAKI_TS_PROBE) {  // gin-oneway: a peer's liveness probe
+        if (h.nonce == ts->nonce && h.from > rank && h.from < (int)ts->peers.size()) {  // gin-harden: answer it
+          struct gdakiTsMsg a;
+          memset(&a, 0, sizeof(a));
+          a.type = GDAKI_TS_PROBE_ACK;
+          a.from = rank;
+          a.arg = (int32_t)ts->ctxSeq;
+          a.nonce = ts->nonce;
+          (void)gdakiTsSend(fd, &a, 50);
+        } else {
+          GIN_TS_NOTE("GIN/TS: rank %d: probe from rank %d not answered (%s) mono_ms=%.3f", rank, h.from,
+                      h.nonce != ts->nonce ? "nonce mismatch" : "not a higher rank", gdakiQ4MonoMs());
+        }
+        close(fd);
+        continue;
+      }
+      const int from = h.from;
+      if (got == 1 && h.type == GDAKI_TS_HELLO && h.nonce != ts->nonce) {  // gin-harden: not this context's peer
+        GIN_TS_NOTE("GIN/TS: rank %d: refused a reconnect from rank %d (nonce mismatch) gen=%lu mono_ms=%.3f", rank, from,
+                    (unsigned long)h.round, gdakiQ4MonoMs());
+        gdakiTsAbortClose(fd);
+        continue;
+      }
+      if (got != 1 || h.type != GDAKI_TS_HELLO || from < 0 || from >= rank || from >= (int)ts->peers.size() ||
+          !ts->peers[from].gated || ts->peers[from].declined || h.round <= ts->peers[from].gen) {
+        INFO(NCCL_NET, "GIN/TS: rank %d: refused a reconnect (got=%d type=%u from=%d gen=%lu)", rank, got, h.type, from,
+             (unsigned long)h.round);
+        close(fd);
+        continue;
+      }
+#ifndef NCCL_GIN_TS_PRODUCTION
+      if (ts->testRefuseHello > 0) {  // gin-oneway (test switch): refuse as a failed check would
+        ts->testRefuseHello--;
+        WARN("GIN/TS: TEST refused a reconnect HELLO from rank %d gen=%lu mono_ms=%.3f", from, (unsigned long)h.round,
+             gdakiQ4MonoMs());
+        close(fd);
+        continue;
+      }
+#endif
+      struct gdakiTsMsg a;  // gin-oneway: confirm before installing
+      memset(&a, 0, sizeof(a));
+      a.type = GDAKI_TS_HELLO_ACK;
+      a.from = rank;
+      a.arg = (int32_t)ts->ctxSeq;
+      a.round = h.round;
+      a.nonce = ts->nonce;  // gin-harden
+      if (gdakiTsSend(fd, &a, 200) != 0) {
+        INFO(NCCL_NET, "GIN/TS: rank %d: cannot send the HELLO-ACK to rank %d", rank, from);
+        gdakiTsAbortClose(fd);
+        continue;
+      }
+      if (ts->peers[from].probeFd >= 0) {
+        close(ts->peers[from].probeFd);
+        ts->peers[from].probeFd = -1;
+        ts->peers[from].probeWaiting = false;
+      }
+      gdakiTsInstall(r, from, fd, (uint32_t)h.round, 0);
+    }
+  }
+}
+
+static bool gdakiTsTestStall(struct gdakiTs* ts, int ms, const char* where, int rank);  // test knob, below
+
+// ---- gate access (device QP padding) ----
+static uint8_t* gdakiTsGateDev(struct doca_gpu_verbs_qp* v) {
+  return (uint8_t*)v->qp_gpu + offsetof(struct doca_gpu_dev_verbs_qp, reserved2);
+}
+
+static ncclResult_t gdakiTsGateWrite(struct gdakiRecHost* r, struct doca_gpu_verbs_qp* v, size_t off, const void* src,
+                                     size_t n) {
+  memcpy(v->qp_cpu->reserved2 + off, src, n);  // host shadow stays equal to the device copy
+  return gdakiRecH2D(r, gdakiTsGateDev(v) + off, src, n);
+}
+
+static ncclResult_t gdakiTsGateRead(struct gdakiRecHost* r, struct doca_gpu_verbs_qp* v, size_t off, void* dst,
+                                    size_t n) {
+  return gdakiRecD2H(r, dst, gdakiTsGateDev(v) + off, n);
+}
+
+// S2: the gate word (reserved1): epoch half written by the host (4-byte copy), count half by the device.
+static uint8_t* gdakiTsWordDev(struct doca_gpu_verbs_qp* v) {
+  return (uint8_t*)v->qp_gpu + offsetof(struct doca_gpu_dev_verbs_qp, reserved1);
+}
+// Write the epoch half (bytes 4..7, little endian) only; the count half is the device's.
+static ncclResult_t gdakiTsWordHiWrite(struct gdakiRecHost* r, struct doca_gpu_verbs_qp* v, uint32_t hi) {
+  memcpy(v->qp_cpu->reserved1 + 4, &hi, 4);  // host shadow stays equal to the device copy
+  return gdakiRecH2D(r, gdakiTsWordDev(v) + 4, &hi, 4);
+}
+static ncclResult_t gdakiTsWordRead(struct gdakiRecHost* r, struct doca_gpu_verbs_qp* v, uint64_t* w) {
+  return gdakiRecD2H(r, w, gdakiTsWordDev(v), 8);
+}
+static inline uint32_t gdakiTsWordCount(uint64_t w) { return (uint32_t)w & NCCL_GIN_TS_W_COUNT_MASK; }
+static inline bool gdakiTsWordDevFailed(uint64_t w) { return ((uint32_t)w & NCCL_GIN_TS_W_DEV_FAILED) != 0; }
+
+// Fill device memory from pinned host memory with a copy (never a memset: that may be a kernel, which
+// cannot start while the application's kernels occupy the GPU).
+// gin-harden: bounded like every other device-state copy, and never while a late copy may still read the staging
+// buffer (gdakiRecCopyBlocked).
+static ncclResult_t gdakiTsZeroDev(struct gdakiRecHost* r, void* dst, size_t n, uint8_t byte) {
+  if (n > r->pinnedSize) return ncclInternalError;
+  if (gdakiRecCopyBlocked(r)) return ncclSystemError;
+  memset(r->pinned, byte, n);
+  gdakiRecFwMark(r);
+  CUDACHECK(cudaMemcpyAsync(dst, r->pinned, n, cudaMemcpyHostToDevice, r->stream));
+  NCCLCHECK(gdakiRecCopyWait(r, "fill", n));
+  return ncclSuccess;
+}
+
+// A device waiter of a QP to `peer` stopped waiting for the next stable epoch (tsGiveUp): the
+// application was told the operation failed, so this round must not publish (decline).
+static ncclResult_t gdakiTsAbandoned(struct gdakiRecHost* r, int peer, bool* any) {
+  ncclResult_t ret = ncclSuccess;
+  *any = false;
+  gdakiRecForPeer(r, peer, [&](gdakiRecQp& rq, struct doca_gpu_verbs_qp_hl* q) {
+    uint32_t ab = 0;
+    if (gdakiTsGateRead(r, q->qp_gverbs, offsetof(struct ncclGinTsGate, abandoned), &ab, sizeof(ab)) != ncclSuccess)
+      ret = ncclSystemError;
+    else if (ab >= r->ts->qs[rq.qpIdx].epoch + 2u) *any = true;
+  });
+  return ret;
+}
+
+// Commit point (Dekker with tsGiveUp): write commit = the epoch this round publishes on every QP to
+// `peer`, then read abandoned. Past this point a waiter that reaches its bound keeps waiting.
+static ncclResult_t gdakiTsCommitPoint(struct gdakiRecHost* r, int peer, bool* abandoned) {
+  ncclResult_t ret = ncclSuccess;
+  gdakiRecForPeer(r, peer, [&](gdakiRecQp& rq, struct doca_gpu_verbs_qp_hl* q) {
+    const uint32_t c = r->ts->qs[rq.qpIdx].epoch + 2u;
+    if (ret == ncclSuccess &&
+        gdakiTsGateWrite(r, q->qp_gverbs, offsetof(struct ncclGinTsGate, commit), &c, sizeof(c)) != ncclSuccess)
+      ret = ncclSystemError;
+  });
+  if (ret != ncclSuccess) return ret;
+  return gdakiTsAbandoned(r, peer, abandoned);
+}
+
+// Executed request messages (rmsn delta) of every QP to `peer`, in token order; also next_rcv_psn.
+static ncclResult_t gdakiTsExecuted(struct gdakiRecHost* r, int peer, uint32_t* executed, uint32_t* nrp,
+                                    uint32_t* nqp) {
+  ncclResult_t ret = ncclSuccess;
+  unsigned i = 0;
+  gdakiRecFwGuard fw(r, "QUERY_QP");  // gin-harden: firmware-command phase (watchdog)
+  gdakiRecForPeer(r, peer, [&](gdakiRecQp& rq, struct doca_gpu_verbs_qp_hl* q) {
+    uint32_t rmsn = 0, rcv = 0, st = 0;
+    gdakiRecFwMark(r);  // gin-harden: one firmware command
+    if (i >= NCCL_GIN_RECOVERY_MAX_QPS || doca_verbs_qp_query_seq(q->qp, &rmsn, &rcv, nullptr, &st) != DOCA_SUCCESS) {
+      ret = ncclSystemError;
+      return;
+    }
+    executed[i] = (rmsn - r->ts->qs[rq.qpIdx].rmsn0) & 0xffffffu;
+    nrp[i] = rcv;
+    i++;
+  });
+  *nqp = i;
+  return ret;
+}
+
+// After a commit, before any traffic of the new incarnation: the responder MSN baseline.
+static ncclResult_t gdakiTsBaseline(struct gdakiRecHost* r, int peer) {
+  ncclResult_t ret = ncclSuccess;
+  gdakiRecFwGuard fw(r, "QUERY_QP");  // gin-harden: firmware-command phase (watchdog)
+  gdakiRecForPeer(r, peer, [&](gdakiRecQp& rq, struct doca_gpu_verbs_qp_hl* q) {
+    uint32_t rmsn = 0;
+    gdakiRecFwMark(r);  // gin-harden: one firmware command
+    if (doca_verbs_qp_query_seq(q->qp, &rmsn, nullptr, nullptr, nullptr) != DOCA_SUCCESS) {
+      ret = ncclSystemError;  // a stale baseline would miscount the next round: the caller declines
+      return;
+    }
+    if (rmsn != 0)
+      INFO(NCCL_NET, "GIN/TS: qpn=%#x rmsn=%u after reconnect (not reset by 2RST); used as the baseline",
+           gdakiRecQpn(q), rmsn);
+    r->ts->qs[rq.qpIdx].rmsn0 = rmsn;
+  });
+  return ret;
+}
+
+// Ring the doorbell from the host (GPU_SM_DB: the doorbell record is in GPU memory; the UAR is also mapped on
+// the host, where DOCA's CPU proxy rings it): doorbell record first, then the UAR (the NIC reads the record
+// only on doorbell recovery; the 8-byte doorbell carries the producer index).
+static ncclResult_t gdakiTsRing(struct gdakiRecHost* r, struct doca_gpu_verbs_qp_hl* q, uint32_t pi) {
+  struct doca_gpu_verbs_qp* v = q->qp_gverbs;
+  const __be32 dbr = htobe32(pi & 0xffffu);
+  void* uar = nullptr;
+  if (gdakiRecH2D(r, v->qp_cpu->sq_dbrec, &dbr, sizeof(dbr)) != ncclSuccess ||
+      doca_verbs_qp_get_uar_addr(q->qp, &uar) != DOCA_SUCCESS || uar == nullptr)
+    return ncclSystemError;
+  struct doca_gpunetio_ib_mlx5_wqe_ctrl_seg ctrl;
+  memset(&ctrl, 0, sizeof(ctrl));
+  ctrl.opmod_idx_opcode = htobe32((pi & 0xffffu) << 8);  // the 16-bit WQE index only (no spill into opmod)
+  ctrl.qpn_ds = v->qp_cpu->sq_num_shift8_be;
+  std::atomic_thread_fence(std::memory_order_release);
+  reinterpret_cast<std::atomic<uint64_t>*>(uar)->store(*reinterpret_cast<uint64_t*>(&ctrl), std::memory_order_relaxed);
+#if defined(__x86_64__)
+  __builtin_ia32_sfence();  // flush a write-combining UAR mapping
+#endif
+  return ncclSuccess;
+}
+
+#ifndef NCCL_GIN_TS_PRODUCTION
+// gin-harden test switch NCCL_GIN_TS_TEST_COPY_STALL=<ms>: the first round's private stream is held by a host callback
+// for <ms> (a stalled copy), so the round's first device-state copy misses NCCL_GIN_TS_COPY_MS.
+static void CUDART_CB gdakiTsTestStallFn(void* arg) {
+  std::this_thread::sleep_for(std::chrono::milliseconds((int)(intptr_t)arg));
+}
+static void gdakiTsTestCopyStall(struct gdakiRecHost* r) {
+  struct gdakiTs* ts = r->ts;
+  if (ts->copyStallMs <= 0 || ts->copyStallDone) return;
+  ts->copyStallDone = true;
+  WARN("GIN/TS: TEST copy stall rank=%d: the recovery stream is held %d ms by a host callback mono_ms=%.3f", r->ctx->rank,
+       ts->copyStallMs, gdakiQ4MonoMs());
+  if (cudaLaunchHostFunc(r->stream, gdakiTsTestStallFn, (void*)(intptr_t)ts->copyStallMs) != cudaSuccess)
+    WARN("GIN/TS: TEST copy stall: cudaLaunchHostFunc failed");
+}
+#endif
+
+// Pause the posters of every QP to `peer` and wait until none is inside the gate.
+// S2: one write of the epoch half (odd) per QP, then read the gate word until its count is 0.
+static ncclResult_t gdakiTsQuiesce(struct gdakiRecHost* r, int peer, const char** why, uint32_t* hostRung) {
+  ncclResult_t ret = ncclSuccess;
+  *hostRung = 0;
+#ifndef NCCL_GIN_TS_PRODUCTION
+  gdakiTsTestCopyStall(r);  // gin-harden (test switch)
+#endif
+  gdakiRecForPeer(r, peer, [&](gdakiRecQp& rq, struct doca_gpu_verbs_qp_hl* q) {
+    if (ret != ncclSuccess) return;
+    struct gdakiTsQp& s = r->ts->qs[rq.qpIdx];
+    if (gdakiTsWordHiWrite(r, q->qp_gverbs, s.epoch | 1u) != ncclSuccess) {  // epoch odd: a recovery owns the QP
+      ret = ncclSystemError;
+      *why = "cannot write the gate";
+    }
+  });
+  if (ret != ncclSuccess) return ret;
+  // Stop the old incarnation now: posters blocked inside the gate (waiting for a free SQ slot) and
+  // waiters polling in the counted region only leave once their WQEs complete, which in ERR they do
+  // at once (flush CQEs). Prepare moves the QPs to ERR again (harmless). Every QP state change goes
+  // through opMu, like Prepare/Commit and the fault hook: two concurrent 2ERR_QP commands on one QP
+  // (helper + hook thread) hung the firmware command for ~100 s and leaked a command slot (measured).
+  {
+    std::lock_guard<std::mutex> op(r->opMu);
+    gdakiRecAllToErr(r, peer);
+  }
+  const double deadline = gdakiQ4MonoMs() + r->ts->quiesceMs;
+  gdakiRecForPeer(r, peer, [&](gdakiRecQp&, struct doca_gpu_verbs_qp_hl* q) {
+    while (ret == ncclSuccess) {
+      uint64_t w = 0;
+      if (gdakiTsWordRead(r, q->qp_gverbs, &w) != ncclSuccess) {
+        ret = ncclSystemError;
+        *why = "cannot read the gate";
+        break;
+      }
+      if (gdakiTsWordCount(w) == 0) break;
+      if (r->ts->stop.load(std::memory_order_acquire)) {  // teardown: decline now
+        ret = ncclSystemError;
+        *why = "the communicator is being destroyed";
+        break;
+      }
+      if (gdakiQ4MonoMs() > deadline) {
+        WARN("GIN/TS: qpn=%#x: %u thread(s) still inside the gate after %d ms", gdakiRecQpn(q), gdakiTsWordCount(w),
+             r->ts->quiesceMs);
+        ret = ncclSystemError;
+        *why = "posters/pollers did not leave the gate";
+        break;
+      }
+      std::this_thread::sleep_for(std::chrono::microseconds(20));
+    }
+  });
+  bool ab = false;
+  if (ret == ncclSuccess && (gdakiTsAbandoned(r, peer, &ab) != ncclSuccess || ab)) {
+    ret = ncclSystemError;
+    *why = "a device waiter already gave up (the application saw the error)";
+  }
+  if (ret != ncclSuccess) return ret;
+  // S2: aggregated posts (ncclGinOptFlagsAggregateRequests) leave WQEs reserved and ready but not rung
+  // (sq_wqe_pi < sq_ready_index) until a later post rings for them. With no poster left inside the gate,
+  // nobody else will: ring them from the host into the ERR QP, so the NIC flushes them (one CQE each, as
+  // every WQE on the ring CQ requests one) and Prepare's quiescence and drain hold. They were never
+  // executed, so the re-post covers them.
+  gdakiRecForPeer(r, peer, [&](gdakiRecQp&, struct doca_gpu_verbs_qp_hl* q) {
+    if (ret != ncclSuccess) return;
+    struct doca_gpu_verbs_qp* v = q->qp_gverbs;
+    uint64_t idx[3];
+    static_assert(offsetof(struct doca_gpu_dev_verbs_qp, sq_ready_index) == 8 &&
+                    offsetof(struct doca_gpu_dev_verbs_qp, sq_wqe_pi) == 16,
+                  "sq_rsvd_index/sq_ready_index/sq_wqe_pi must be contiguous");
+    if (gdakiRecD2H(r, idx, v->qp_gpu, sizeof(idx)) != ncclSuccess) {
+      ret = ncclSystemError;
+      *why = "cannot read the device indices";
+      return;
+    }
+    if (idx[0] != idx[1] || idx[2] > idx[1]) return;  // Prepare reports it (not quiescent)
+    if (idx[2] == idx[1]) return;
+    const uint64_t pi = idx[1];
+    if (gdakiTsRing(r, q, (uint32_t)pi) != ncclSuccess ||
+        gdakiRecH2D(r, (uint8_t*)v->qp_gpu + offsetof(struct doca_gpu_dev_verbs_qp, sq_wqe_pi), &pi, 8) != ncclSuccess) {
+      ret = ncclSystemError;
+      *why = "cannot ring the unrung WQEs";
+      return;
+    }
+    v->qp_cpu->sq_wqe_pi = pi;
+    *hostRung += (uint32_t)(idx[1] - idx[2]);
+  });
+  return ret;
+}
+
+// A WQE that is not one request message (or a READ) in the ending epoch of any QP to `peer`.
+static ncclResult_t gdakiTsNonMsg(struct gdakiRecHost* r, int peer, uint32_t* any) {
+  ncclResult_t ret = ncclSuccess;
+  *any = 0;
+  gdakiRecForPeer(r, peer, [&](gdakiRecQp&, struct doca_gpu_verbs_qp_hl* q) {
+    uint32_t nm = 0;
+    if (gdakiTsGateRead(r, q->qp_gverbs, offsetof(struct ncclGinTsGate, nonmsg), &nm, sizeof(nm)) != ncclSuccess)
+      ret = ncclSystemError;
+    *any |= nm;
+  });
+  return ret;
+}
+
+struct gdakiTsReplayStats {
+  unsigned nqp = 0;
+  uint64_t replayed = 0;
+  uint64_t rescued = 0;   // S2: WQEs taken from the rescue area (their slot had been reused)
+  uint64_t chunks = 0;    // S2: extra doorbells of a re-post larger than the ring
+  char detail[256] = {0};  // per QP: S/U/n
+};
+
+// After Commit (QPs in RTS, device indices 0, cqe_rsvd advanced): per QP to `peer`, WQEs [U, S) of the
+// ending epoch were not executed by the peer (U = S - in-flight, in-flight from the peer's rmsn).
+// Copy them to physical slots [0, n) with their ctrl index rewritten, set the device producer indices
+// to n, publish the logical base of the new epoch (lbase += U), ring the doorbell from
+// the host (GPU_SM_DB: the doorbell record is in GPU memory; the UAR is also mapped on the host), and
+// finally publish the new stable epoch and clear pause.
+// gin-harden: in two passes. The plan reads every QP's ring (and rescue area) and validates every WQE to re-post (range,
+// overwritten slot, opcode) for ALL QPs of the round before the commit point; a QP that fails declines the round with
+// nothing re-posted on any QP. Only then are the WQEs posted and the epochs published, QP by QP (a failure there is a
+// failed device copy or doorbell, not a rejected target).
+struct gdakiTsRepostPlan {
+  gdakiRecQp* rq = nullptr;
+  struct doca_gpu_verbs_qp_hl* q = nullptr;
+  uint64_t S = 0, U = 0;
+  uint32_t n = 0, ringN = 0, mask = 0, laps = 0, nRescued = 0;
+  std::vector<uint8_t> w;  // n re-posted WQEs, ctrl index already rewritten to physical [0, n)
+};
+
+static ncclResult_t gdakiTsReplayResume(struct gdakiRecHost* r, int peer, const uint32_t* executed, uint32_t nqp,
+                                        struct gdakiTsReplayStats* rs, const char** why) {
+  ncclResult_t ret = ncclSuccess;
+  size_t dl = 0;
+  bool ab = false;
+  if (r->ts->surfaced.load(std::memory_order_acquire)) {  // the watchdog already told the application
+    *why = "the watchdog surfaced the fault before the commit point";
+    return ncclSystemError;
+  }
+  if (r->ts->stop.load(std::memory_order_acquire)) {
+    *why = "the communicator is being destroyed";
+    return ncclSystemError;
+  }
+  // ---- gin-harden, pass 1: plan and validate every QP of the round ----
+  std::vector<struct gdakiTsRepostPlan> plans;
+  unsigned i = 0, total = 0;
+  int badIdx = -1;
+  gdakiRecForPeer(r, peer, [&](gdakiRecQp&, struct doca_gpu_verbs_qp_hl*) { total++; });
+  gdakiRecForPeer(r, peer, [&](gdakiRecQp& rq, struct doca_gpu_verbs_qp_hl* q) {
+    const unsigned idx = i++;
+    if (ret != ncclSuccess) return;
+    struct gdakiTsQp& s = r->ts->qs[rq.qpIdx];
+    if (idx >= nqp) {
+      ret = ncclInvalidUsage;
+      *why = "peer reported fewer QPs";
+      badIdx = (int)idx;
+      return;
+    }
+    struct gdakiTsRepostPlan pl;
+    pl.rq = &rq;
+    pl.q = q;
+    pl.S = rq.epochWqes;
+    const uint32_t inflight = ((uint32_t)(pl.S & 0xffffffu) - executed[idx]) & 0xffffffu;
+    pl.ringN = rq.snap.sq_wqe_num;
+    pl.mask = rq.snap.sq_wqe_mask;
+    pl.laps = s.rescue ? r->ts->rescueLaps : 0;
+    if ((uint64_t)inflight > pl.S || (uint64_t)inflight > (uint64_t)pl.ringN * (1 + pl.laps)) {
+      WARN("GIN/TS: qpn=%#x: peer executed %u of this epoch's %lu WQEs (mod 2^24): out of range (ring %u, rescue laps %u)",
+           gdakiRecQpn(q), executed[idx], (unsigned long)pl.S, pl.ringN, pl.laps);
+      ret = ncclInvalidUsage;
+      *why = "executed count out of range";
+      badIdx = (int)idx;
+      return;
+    }
+    pl.U = pl.S - inflight;
+    pl.n = inflight;
+#ifndef NCCL_GIN_TS_PRODUCTION
+    if (r->ts->badRepost == (int)idx) {  // test switch: reject this QP's plan
+      WARN("GIN/TS: TEST re-post plan of qp %u to rank %d rejected (NCCL_GIN_TS_TEST_BAD_REPOST) mono_ms=%.3f", idx, peer,
+           gdakiQ4MonoMs());
+      ret = ncclInvalidUsage;
+      *why = "a re-post target was rejected (test switch)";
+      badIdx = (int)idx;
+      return;
+    }
+#endif
+    // Read the ring once. A WQE's slot may have been reused by a poster that was blocked on a full ring when the QP
+    // failed (the NIC flushed the WQE, which freed the slot); that poster kept a copy in the rescue area first (the
+    // vendored DOCA slot wait). Each WQE is taken from its slot if the slot still holds it (ctrl index == its index),
+    // else from the rescue area, else the round declines.
+    if (pl.n > 0) {
+      std::vector<uint8_t> ring((size_t)pl.ringN * 64), resc;
+      pl.w.resize((size_t)pl.n * 64);
+      if (gdakiRecD2H(r, ring.data(), rq.snap.sq_wqe_daddr, ring.size()) != ncclSuccess) {
+        ret = ncclSystemError;
+        *why = "cannot read the send ring";
+        badIdx = (int)idx;
+        return;
+      }
+      for (uint32_t j = 0; j < pl.n && ret == ncclSuccess; j++) {
+        const uint64_t wi = pl.U + j;
+        const uint8_t* src = ring.data() + (size_t)(wi & pl.mask) * 64;
+        uint32_t w0;
+        memcpy(&w0, src, 4);
+        if (((be32toh(w0) >> 8) & 0xffffu) != (wi & 0xffffu)) {
+          if (pl.laps != 0 && resc.empty()) {
+            resc.resize((size_t)pl.laps * pl.ringN * 64);
+            const size_t chunk = std::min<size_t>(r->pinnedSize, 64 * 1024) & ~(size_t)63;
+            for (size_t o = 0; o < resc.size() && ret == ncclSuccess; o += chunk)
+              if (gdakiRecD2H(r, resc.data() + o, (uint8_t*)s.rescue + o, std::min(chunk, resc.size() - o)) != ncclSuccess)
+                ret = ncclSystemError;
+            if (ret != ncclSuccess) {
+              *why = "cannot read the rescue area";
+              break;
+            }
+          }
+          src = pl.laps ? resc.data() + (size_t)(wi % ((uint64_t)pl.laps * pl.ringN)) * 64 : nullptr;
+          if (src) memcpy(&w0, src, 4);
+          if (src == nullptr || ((be32toh(w0) >> 8) & 0xffffu) != (wi & 0xffffu)) {
+            WARN("GIN/TS: qpn=%#x: WQE %lu to re-post was overwritten (slot reused) and not rescued", gdakiRecQpn(q),
+                 (unsigned long)wi);
+            ret = ncclInvalidUsage;
+            *why = "a WQE to re-post was overwritten";
+            break;
+          }
+          pl.nRescued++;
+        }
+        uint8_t* wq = pl.w.data() + (size_t)j * 64;
+        memcpy(wq, src, 64);
+        memcpy(&w0, wq, 4);
+        w0 = be32toh(w0);
+        const uint8_t opc = w0 & 0xff;
+        // Re-posts RDMA WRITE (idempotent) and a non-fetching use of ATOMIC_FA (GIN's signal ADD, result to
+        // a sink) only; anything else declines.
+        if (opc != 0x08 && opc != 0x12) {
+          WARN("GIN/TS: qpn=%#x: WQE %lu to re-post has opcode %#x (re-posts RDMA_WRITE/ATOMIC_FA only)",
+               gdakiRecQpn(q), (unsigned long)wi, opc);
+          ret = ncclInvalidUsage;
+          *why = "unsupported opcode to re-post";
+          break;
+        }
+        w0 = (w0 & 0xff0000ffu) | ((j & 0xffffu) << 8);
+        w0 = htobe32(w0);
+        memcpy(wq, &w0, 4);
+      }
+      if (ret != ncclSuccess) {
+        badIdx = (int)idx;
+        return;
+      }
+    }
+    plans.push_back(std::move(pl));
+  });
+  if (ret != ncclSuccess) {
+    WARN("GIN/TS: rank %d: re-post plan to rank %d rejected at qp %d of %u (%s); nothing re-posted mono_ms=%.3f",
+         r->ctx->rank, peer, badIdx, total, *why ? *why : "?", gdakiQ4MonoMs());
+    return ret;
+  }
+  // ---- commit point ----
+  if (gdakiTsCommitPoint(r, peer, &ab) != ncclSuccess || ab) {  // before anything executes again
+    *why = "a device waiter gave up before the commit point";
+    return ncclSystemError;
+  }
+  // Test knob: a helper that stalls past its commit point (device give-ups now lose; waiters wait one
+  // more bound, then fail). Nothing has been re-posted yet, so a teardown here still declines.
+  if (r->ts->stallStage == 3 && gdakiTsTestStall(r->ts, r->ts->stallMs, "after the commit point", r->ctx->rank)) {
+    *why = "the communicator is being destroyed";
+    return ncclSystemError;
+  }
+  // A device thread that lost its give-up fails after one more bound. S2 closes the residual S1 left here
+  // with a second Dekker on the gate word: mark the round PUBLISHING (epoch half: odd | PUBLISHING), then
+  // read the word. A device failure ordered before the mark is seen now: the application was told the
+  // operation failed, so nothing is re-posted (decline). A device thread whose bound expires after the mark
+  // sees it and waits for the publication instead of failing (tsLateFail).
+  {
+    bool failed = false;
+    gdakiRecForPeer(r, peer, [&](gdakiRecQp& rq, struct doca_gpu_verbs_qp_hl* q) {
+      if (gdakiTsWordHiWrite(r, q->qp_gverbs, (r->ts->qs[rq.qpIdx].epoch | 1u) | NCCL_GIN_TS_W_PUBLISHING) !=
+          ncclSuccess)
+        failed = true;
+    });
+    gdakiRecForPeer(r, peer, [&](gdakiRecQp&, struct doca_gpu_verbs_qp_hl* q) {
+      uint64_t w = 0;
+      if (gdakiTsWordRead(r, q->qp_gverbs, &w) != ncclSuccess || gdakiTsWordDevFailed(w)) failed = true;
+    });
+    if (failed) {
+      *why = "a device thread failed the QP after the commit point (second hold expired)";
+      return ncclSystemError;
+    }
+  }
+  // Test knob: a helper that stalls after marking the round PUBLISHING (device threads whose second bound
+  // expires now wait for the publication instead of failing).
+  if (r->ts->stallStage == 4 && gdakiTsTestStall(r->ts, r->ts->stallMs, "after PUBLISHING", r->ctx->rank)) {
+    *why = "the communicator is being destroyed";
+    return ncclSystemError;
+  }
+  // ---- pass 2: post, ring and publish, QP by QP ----
+  unsigned idx = 0;
+  for (auto& pl : plans) {
+    if (ret != ncclSuccess) break;
+    gdakiRecQp& rq = *pl.rq;
+    struct doca_gpu_verbs_qp_hl* q = pl.q;
+    struct doca_gpu_verbs_qp* v = q->qp_gverbs;
+    struct gdakiTsQp& s = r->ts->qs[rq.qpIdx];
+    const uint64_t S = pl.S, U = pl.U;
+    const uint32_t n = pl.n, ringN = pl.ringN, mask = pl.mask, laps = pl.laps;
+    uint64_t consumed = 0;  // re-posted WQEs whose success CQE the host saw (chunked re-post only)
+    uint32_t nChunks = 0;
+    // n <= ring size: one copy and one doorbell. n > ring size: the first ring's worth, then more as the
+    // re-posted WQEs complete (the host reads their CQEs; the gate is still closed, so no device thread polls).
+    if (n > 0) {
+      // write re-posted WQEs [from, to) into their slots (physical index k -> slot k & mask; at most two runs)
+      auto put = [&](uint64_t from, uint64_t to) -> ncclResult_t {
+        while (from < to) {
+          const uint64_t slot = from & mask, run = std::min<uint64_t>(to - from, ringN - slot);
+          NCCLCHECK(gdakiRecH2D(r, rq.snap.sq_wqe_daddr + slot * 64, pl.w.data() + from * 64, run * 64));
+          from += run;
+        }
+        return ncclSuccess;
+      };
+      const bool ring1 = !(r->ts->diag & GDAKI_TS_DIAG_NORING);
+      const uint64_t first = std::min<uint64_t>(n, ringN);
+      if (put(0, first) != ncclSuccess || (ring1 && gdakiTsRing(r, q, (uint32_t)first) != ncclSuccess)) {
+        ret = ncclSystemError;
+      } else if (n > ringN) {
+        const struct doca_gpu_dev_verbs_cq& cq = rq.snap.cq_sq;
+        const uint64_t rsvd = v->qp_cpu->cq_sq.cqe_rsvd;  // the new epoch's CQ mapping (Commit)
+        std::vector<uint8_t> cqb((size_t)cq.cqe_num * DOCA_GPUNETIO_VERBS_CQE_SIZE);
+        uint64_t posted = first;
+        const double deadline = gdakiQ4MonoMs() + r->ts->quiesceMs;
+        while (posted < n && ret == ncclSuccess) {
+          if (gdakiRecD2H(r, cqb.data(), cq.cqe_daddr, cqb.size()) != ncclSuccess) {
+            ret = ncclSystemError;
+            break;
+          }
+          while (consumed < posted) {
+            const uint64_t pos = consumed + rsvd;
+            const uint8_t* c = cqb.data() + (pos & (cq.cqe_num - 1)) * DOCA_GPUNETIO_VERBS_CQE_SIZE;
+            if (!gdakiRecCqeCurrent(c, pos, cq.cqe_num, consumed)) break;
+            if ((c[63] >> 4) == 0xd || (c[63] >> 4) == 0xe) {
+              ret = ncclSystemError;
+              *why = "a re-posted WQE completed in error";
+              break;
+            }
+            consumed++;
+          }
+          if (ret != ncclSuccess) break;
+          const uint64_t lim = std::min<uint64_t>(n, consumed + ringN);
+          if (lim > posted) {
+            if (put(posted, lim) != ncclSuccess || gdakiTsRing(r, q, (uint32_t)lim) != ncclSuccess) ret = ncclSystemError;
+            posted = lim;
+            nChunks++;
+            continue;
+          }
+          if (gdakiQ4MonoMs() > deadline) {
+            ret = ncclSystemError;
+            *why = "the re-posted WQEs did not complete (chunked re-post)";
+            break;
+          }
+          std::this_thread::sleep_for(std::chrono::microseconds(20));
+        }
+        // CQEs [0, consumed) were success and are consumed: waiters holding those tickets are done, and the
+        // CQ window of the pollers starts after them.
+        const size_t ciOff = offsetof(struct doca_gpu_dev_verbs_qp, cq_sq) + offsetof(struct doca_gpu_dev_verbs_cq, cqe_ci);
+        if (ret == ncclSuccess && gdakiRecH2D(r, (uint8_t*)v->qp_gpu + ciOff, &consumed, 8) != ncclSuccess)
+          ret = ncclSystemError;
+        v->qp_cpu->cq_sq.cqe_ci = consumed;
+      }
+      if (ret != ncclSuccess) {
+        if (*why == nullptr) *why = "cannot re-post WQEs";
+        break;
+      }
+    }
+    // Rescue entries written in the ending epoch must not be found by a later one (the lookup matches only the
+    // 16-bit WQE index): clear the area, while no device thread is inside the gate.
+    if (s.rescue) {
+      uint32_t wr = 0;
+      if (gdakiTsGateRead(r, v, offsetof(struct ncclGinTsGate, rescueWrites), &wr, sizeof(wr)) != ncclSuccess) {
+        ret = ncclSystemError;
+        *why = "cannot read the rescue count";
+        break;
+      }
+      if (wr != 0) {
+        const size_t sz = (size_t)laps * ringN * 64, chunk = std::min<size_t>(r->pinnedSize, 64 * 1024);
+        const uint32_t zero = 0;
+        for (size_t o = 0; o < sz && ret == ncclSuccess; o += chunk)
+          if (gdakiTsZeroDev(r, (uint8_t*)s.rescue + o, std::min(chunk, sz - o), 0) != ncclSuccess) ret = ncclSystemError;
+        if (ret == ncclSuccess &&
+            gdakiTsGateWrite(r, v, offsetof(struct ncclGinTsGate, rescueWrites), &zero, sizeof(zero)) != ncclSuccess)
+          ret = ncclSystemError;
+        if (ret != ncclSuccess) {
+          *why = "cannot clear the rescue area";
+          break;
+        }
+      }
+    }
+    // (b) device producer indices: n reserved, ready and submitted (rung above).
+    const uint64_t idxs[3] = {n, n, n};
+    static_assert(offsetof(struct doca_gpu_dev_verbs_qp, sq_ready_index) == 8 &&
+                    offsetof(struct doca_gpu_dev_verbs_qp, sq_wqe_pi) == 16,
+                  "sq_rsvd_index/sq_ready_index/sq_wqe_pi must be contiguous");
+    if (gdakiRecH2D(r, v->qp_gpu, idxs, sizeof(idxs)) != ncclSuccess) {
+      ret = ncclSystemError;
+      *why = "cannot write the device indices";
+      break;
+    }
+    v->qp_cpu->sq_rsvd_index = n;
+    v->qp_cpu->sq_ready_index = n;
+    v->qp_cpu->sq_wqe_pi = n;
+    // (c) logical base of the new epoch.
+    const uint32_t eNew = s.epoch + 2u;
+    const uint64_t lNew = s.lbase + U;
+    s.lbase = lNew;
+    if (gdakiTsGateWrite(r, v, offsetof(struct ncclGinTsGate, lbase), &lNew, 8) != ncclSuccess) {
+      ret = ncclSystemError;
+      *why = "cannot write lbase";
+      break;
+    }
+    // (e) publish: nonmsg and the slot wait's error record cleared for the new epoch, then the new stable
+    // epoch with posters released.
+    const uint32_t zero = 0;
+    if (gdakiTsGateWrite(r, v, offsetof(struct ncclGinTsGate, nonmsg), &zero, sizeof(zero)) != ncclSuccess ||
+        gdakiTsGateWrite(r, v, offsetof(struct ncclGinTsGate, swErr), &zero, sizeof(zero)) != ncclSuccess) {
+      ret = ncclSystemError;
+      *why = "cannot clear nonmsg/swErr";
+      break;
+    }
+    if (gdakiTsWordHiWrite(r, v, eNew) != ncclSuccess) {  // S2: the epoch half, even: posters and waiters enter
+      ret = ncclSystemError;
+      *why = "cannot publish the epoch";
+      break;
+    }
+    s.epoch = eNew;
+    rs->nqp++;
+    rs->replayed += n;
+    if (dl < sizeof(rs->detail) - 1)
+      dl += snprintf(rs->detail + dl, sizeof(rs->detail) - dl, "%s%lu/%lu/%u", idx ? "," : "", (unsigned long)S,
+                     (unsigned long)U, n);
+    rs->rescued += pl.nRescued;
+    rs->chunks += nChunks;
+    idx++;
+  }
+  return ret;
+}
+
+// Terminal decline for `peer`: the error surfaces (device waiters and later waits return
+// ncclRemoteError; ncclCommGetAsyncError reports it) and the QPs stay in ERR, as without recovery.
+// gin-harden: the order makes a failed wait mean that the NIC no longer works on the peer's QPs, and keeps a stalled
+// copy stream from delaying the decline: first the QPs to ERR (firmware commands; a slow one trips the firmware-phase
+// watchdog, which raises the user devComm word and the async error itself), then, without any device copy, the user
+// devComm's own abort word (a CPU store: every user wait of the communicator, waitSignal included, returns an error;
+// the word is per communicator, so waits on QPs to healthy peers fail too while those QPs stay RTS), the async error,
+// the FAIL to the peer and the log line. Last the gates failed and the device error state (bounded copies); a gate that
+// cannot be written while copies are blocked is written again by gdakiTsScan.
+static void gdakiTsDecline(struct gdakiRecHost* r, int peer, const char* why, bool sendFail, int cls,
+                           int uaWhy = GDAKI_UA_DECLINED) {
+  struct gdakiTs* ts = r->ts;
+  gdakiTsScope = GDAKI_TS_SCOPE_ALL;  // gin-pair-reset: a decline covers every context's QPs to the peer, as before
+  struct gdakiTsPeer& pe = ts->peers[peer];
+  const bool first = !pe.declined;
+  pe.declined = true;
+  pe.deadJudged = false;  // gin-harden: handled
+  if (first) {
+    ts->nDeclined++;
+    ts->cDeclined.fetch_add(1, std::memory_order_relaxed);
+  }
+  if (r->state == 1 && r->preparedPeer == peer) (void)ncclGinRecoverAbort((ncclComm_t)r->commKey, peer);
+  {
+    std::lock_guard<std::mutex> op(r->opMu);  // QP state changes are serialized (see gdakiTsQuiesce)
+    gdakiRecAllToErr(r, peer);
+  }
+  struct gdakiQ4Host* q4 = r->ctx->q4;
+  (void)gdakiTsToComm(ts, [&] {  // never after the communicator is freed (an orphaned helper)
+    gdakiBlameNote(q4->asyncResult, peer);  // gin-handoff: the declined GIN peer, before the flags below
+    ncclGinTsUserAbortRaise(r->commKey, uaWhy);
+    if (q4->asyncResult) {
+      __atomic_store_n(q4->asyncResult, ncclRemoteError, __ATOMIC_RELEASE);
+      q4->setAsync.store(1, std::memory_order_release);
+    }
+  });
+  q4->hasError.store(1, std::memory_order_release);
+  if (sendFail && pe.fd >= 0 && !pe.gone) {
+    struct gdakiTsMsg m;
+    memset(&m, 0, sizeof(m));
+    m.type = GDAKI_TS_FAIL;
+    m.from = r->ctx->rank;
+    m.arg = cls;
+    (void)gdakiTsSend(pe.fd, &m, 200);
+  }
+  WARN("GIN/TS: declined rank=%d peer=%d reason=\"%s\" class=%d mono_ms=%.3f (error surfaces; QPs left in ERR)",
+       r->ctx->rank, peer, why, cls, gdakiQ4MonoMs());
+  bool gateFailed = true;
+  gdakiRecForPeer(r, peer, [&](gdakiRecQp& rq, struct doca_gpu_verbs_qp_hl* q) {
+    struct gdakiTsQp& s = ts->qs[rq.qpIdx];
+    s.epoch = (s.epoch | 1u) + 1u;  // even and newer than any epoch a waiter holds: holders wake, see the failure
+    if (gdakiTsWordHiWrite(r, q->qp_gverbs, NCCL_GIN_TS_W_HOST_FAILED | s.epoch) != ncclSuccess) gateFailed = false;
+  });
+  if (gdakiTsZeroDev(r, q4->dev->sticky, sizeof(q4->dev->sticky), 1) != ncclSuccess) {
+    WARN("GIN/TS: cannot set the device error state");
+    gateFailed = false;
+  }
+  pe.failPending = !gateFailed;  // gin-harden: gdakiTsScan writes both once copies are allowed again
+}
+
+static const char* gdakiTsClassName(int cls) {
+  return gdakiQ4Class((uint8_t)cls, 0).name;
+}
+
+// Test knob: sleep `ms` in steps, returning early (true) on teardown.
+static bool gdakiTsTestStall(struct gdakiTs* ts, int ms, const char* where, int rank) {
+#ifdef NCCL_GIN_TS_PRODUCTION
+  (void)ts;
+  (void)ms;
+  (void)where;
+  (void)rank;
+  return false;  // gin-harden: never reached (no test switches in the production build)
+#else
+  WARN("GIN/TS: TEST stall rank=%d %d ms %s mono_ms=%.3f", rank, ms, where, gdakiQ4MonoMs());
+  const double end = gdakiQ4MonoMs() + ms;
+  while (gdakiQ4MonoMs() < end) {
+    if (ts->stop.load(std::memory_order_acquire)) return true;
+    std::this_thread::sleep_for(std::chrono::milliseconds(10));
+  }
+  return false;
+#endif
+}
+
+// S2: before a reconnect, look this rank's own GID up again by value (the GID bytes and the RoCE type it had
+// at context creation). An address that is removed and re-added comes back at a new index when the kernel
+// still holds a reference to the old entry, and DOCA resolves the next hop from the index at RTR. If the
+// address is not in the table (not back yet), wait for it, bounded by NCCL_GIN_TS_PATH_WAIT_MS. Reads sysfs
+// only (no verbs call, so a missing entry is not an error message). IB link layer: nothing to do (LIDs).
+static bool gdakiTsSysfsGid(const char* dev, int port, int idx, uint8_t out[16], char* type, size_t typeLen) {
+  char path[256];
+  snprintf(path, sizeof(path), "/sys/class/infiniband/%s/ports/%d/gids/%d", dev, port, idx);
+  FILE* f = fopen(path, "r");
+  if (f == nullptr) return false;
+  unsigned int h[8];
+  const int n = fscanf(f, "%x:%x:%x:%x:%x:%x:%x:%x", &h[0], &h[1], &h[2], &h[3], &h[4], &h[5], &h[6], &h[7]);
+  fclose(f);
+  if (n != 8) return false;
+  for (int k = 0; k < 8; k++) {
+    out[2 * k] = (uint8_t)(h[k] >> 8);
+    out[2 * k + 1] = (uint8_t)(h[k] & 0xff);
+  }
+  type[0] = '\0';
+  snprintf(path, sizeof(path), "/sys/class/infiniband/%s/ports/%d/gid_attrs/types/%d", dev, port, idx);
+  f = fopen(path, "r");
+  if (f != nullptr) {
+    if (fgets(type, (int)typeLen, f) == nullptr) type[0] = '\0';
+    fclose(f);
+    type[strcspn(type, "\n")] = '\0';
+  }
+  return true;
+}
+
+static int gdakiTsFindGid(struct gdakiRecHost* r) {
+  struct gdaki_context* g = r->ctx;
+  struct gdakiTs* ts = r->ts;
+  uint8_t gid[16];
+  char type[32];
+  const int n = std::max(1, (int)g->port_attr.gid_tbl_len);
+  for (int k = -1; k < n; k++) {
+    const int idx = k < 0 ? g->gid_index : k;  // the current index first: the common case, nothing moved
+    if (k >= 0 && k == g->gid_index) continue;
+    if (!gdakiTsSysfsGid(g->ib_dev_name, g->port_num, idx, gid, type, sizeof(type))) continue;
+    if (memcmp(gid, g->rgid.raw, 16) == 0 && strcmp(type, ts->gidType) == 0) return idx;
+  }
+  return -1;
+}
+
+static ncclResult_t gdakiTsResolveGid(struct gdakiRecHost* r, double* waitedMs, int* oldIdx, const char** why) {
+  struct gdaki_context* g = r->ctx;
+  struct gdakiTs* ts = r->ts;
+  *oldIdx = g->gid_index;
+  *waitedMs = 0;
+  if (g->port_attr.link_layer != IBV_LINK_LAYER_ETHERNET || ts->gidType[0] == '\0') return ncclSuccess;
+  const double t0 = gdakiQ4MonoMs();
+  // Bounded by NCCL_GIN_TS_PATH_WAIT_MS (clamped at start-up below the watchdog's round bound and the device
+  // hold, gdakiTsStart) and, inside a round, by what is left of the round: a wait that fails must still leave
+  // time for the NACK/decline before the watchdog surfaces the round or the parked device threads give up.
+  const int boundMs = gdakiTsRoundLeftMs(ts, ts->pathWaitMs);
+  int idx;
+  while ((idx = gdakiTsFindGid(r)) < 0) {
+    if (ts->stop.load(std::memory_order_acquire)) {
+      *why = "the communicator is being destroyed";
+      return ncclSystemError;
+    }
+    if (gdakiQ4MonoMs() - t0 > boundMs) {
+      *waitedMs = gdakiQ4MonoMs() - t0;
+      WARN("GIN/TS: rank=%d local GID (type \"%s\") not back after %.1f ms (bound %d ms of NCCL_GIN_TS_PATH_WAIT_MS=%d)",
+           g->rank, ts->gidType, *waitedMs, boundMs, ts->pathWaitMs);
+      *why = "the local GID did not come back within NCCL_GIN_TS_PATH_WAIT_MS";
+      return ncclSystemError;
+    }
+    std::this_thread::sleep_for(std::chrono::milliseconds(20));
+  }
+  *waitedMs = gdakiQ4MonoMs() - t0;
+  if (idx != g->gid_index) {
+    if (doca_verbs_ah_attr_set_sgid_index(g->ah, idx) != DOCA_SUCCESS) {
+      *why = "cannot set the new GID index";
+      return ncclSystemError;
+    }
+    GIN_TS_NOTE("GIN/TS: rank=%d local GID moved from index %d to %d (looked up by value after %.1f ms); reconnecting with it",
+         g->rank, g->gid_index, idx, *waitedMs);
+    g->gid_index = idx;
+  }
+  return ncclSuccess;
+}
+
+// gin-harden: escalation. Returns true if this round must not start: more than NCCL_GIN_TS_ESCALATE_ROUNDS rounds
+// (either role) within NCCL_GIN_TS_ESCALATE_WINDOW_MS, now or earlier. Past the cap recovery stops on this context: the
+// caller declines (async error, user waits released with an error) and every later fault is declined too, so that an
+// upper layer (a framework watchdog) can remove the node. The WARN line names the cap (ncclGetLastError shows it).
+static bool gdakiTsEscalated(struct gdakiRecHost* r, char* why, size_t wl) {
+  struct gdakiTs* ts = r->ts;
+  if (ts->escalated) {
+    snprintf(why, wl, "recovery stopped on this communicator by the escalation cap");
+    return true;
+  }
+  if (ts->escRounds <= 0) return false;
+  const double now = gdakiQ4MonoMs();
+  auto& v = ts->roundStarts;
+  v.erase(std::remove_if(v.begin(), v.end(), [&](double t) { return now - t > (double)ts->escWindowMs; }), v.end());
+  if ((int)v.size() >= ts->escRounds) {
+    ts->escalated = true;
+    ts->cEscalations.fetch_add(1, std::memory_order_relaxed);
+    WARN("GIN/TS: escalated rank=%d: more than %d recovery rounds within %d ms (NCCL_GIN_TS_ESCALATE_ROUNDS=%d, "
+         "NCCL_GIN_TS_ESCALATE_WINDOW_MS=%d); recovery stops on this communicator mono_ms=%.3f",
+         r->ctx->rank, ts->escRounds, ts->escWindowMs, ts->escRounds, ts->escWindowMs, now);
+    snprintf(why, wl, "escalation: more than %d recovery rounds within %d ms", ts->escRounds, ts->escWindowMs);
+    return true;
+  }
+  v.push_back(now);
+  return false;
+}
+
+// gin-harden: the fault `f` goes back to the front of the queue for one more round after a socket loss (false: it was
+// already retried GDAKI_TS_SOCK_RETRIES times).
+static bool gdakiTsRequeueRetry(struct gdakiRecHost* r, const struct gdakiTsFault& f, int* retry) {
+  struct gdakiTs* ts = r->ts;
+  if (f.sockRetries >= GDAKI_TS_SOCK_RETRIES) return false;
+  struct gdakiTsFault g = f;
+  g.sockRetries++;
+  *retry = g.sockRetries;
+  std::lock_guard<std::mutex> lk(ts->qMu);
+  ts->faults.insert(ts->faults.begin(), g);
+  ts->nQueued.fetch_add(1, std::memory_order_acq_rel);
+  return true;
+}
+
+// gin-harden: the helper socket to `peer` failed (FIN or an error) inside this rank's round (initiator) before the peer
+// can have committed this round's token, or while waiting for its ACK. The round is cancelled: the prepared QPs are
+// released (still in ERR, gates closed), the peer becomes unknown (the lower rank re-dials, the higher rank probes) and
+// the fault goes back to the front of the queue, where it waits for the reconnect (NCCL_GIN_TS_RECONNECT_MS) and runs
+// again. A peer that declined meanwhile never reconnects (a declined higher rank refuses the HELLO, a declined lower
+// rank does not re-dial): the retried fault then waits out NCCL_GIN_TS_RECONNECT_MS and declines as unknown. Returns
+// false if the round must decline instead: the peer left (BYE), or this fault was already retried
+// GDAKI_TS_SOCK_RETRIES times. The retries and their reconnect waits can outlast NCCL_GIN_TS_HOLD_MS: a device thread
+// that gives up meanwhile makes the retried round decline (a device waiter gave up).
+static bool gdakiTsCancelRound(struct gdakiRecHost* r, int peer, const struct gdakiTsFault& f, uint64_t round,
+                               const char* stage) {
+  struct gdakiTs* ts = r->ts;
+  struct gdakiTsPeer& pe = ts->peers[peer];
+  char cause[24];
+  snprintf(cause, sizeof(cause), "%s", pe.closeCause[0] ? pe.closeCause : "unknown");
+  if (pe.left) return false;
+  snprintf(pe.lostCause, sizeof(pe.lostCause), "%s", cause);
+  gdakiTsMakeUnknown(pe);
+  GIN_TS_NOTE("GIN/TS: rank %d: socket to rank %d closed cause=%s mono_ms=%.3f liveness=unknown", r->ctx->rank, peer,
+              cause, gdakiQ4MonoMs());
+  (void)ncclGinRecoverAbort((ncclComm_t)r->commKey, peer);
+  struct gdakiTsFault g = f;
+  if (!gdakiTsRequeueRetry(r, f, &g.sockRetries)) return false;
+  ts->cCancelled.fetch_add(1, std::memory_order_relaxed);
+  WARN("GIN/TS: rank %d: round %lu with rank %d cancelled (%s, socket %s) before the commit; the fault is retried after "
+       "the reconnect (retry %d of %d) mono_ms=%.3f", r->ctx->rank, (unsigned long)round, peer, stage, cause,
+       g.sockRetries, GDAKI_TS_SOCK_RETRIES, gdakiQ4MonoMs());
+  return true;
+}
+
+// gin-harden: the responder's counterpart, before its Commit: release the prepared QPs (they stay in ERR, gates
+// closed: the device threads stay parked, bounded by NCCL_GIN_TS_HOLD_MS), mark the peer unknown, and let the
+// initiator retry the round after the reconnect. No decline. A higher rank that had yielded its own round to this one
+// (`yf`) requeues its own fault as well (it would otherwise depend on the lower rank's retry alone).
+static void gdakiTsCancelResponder(struct gdakiRecHost* r, int peer, uint64_t round,
+                                   const struct gdakiTsFault* yf = nullptr) {
+  struct gdakiTs* ts = r->ts;
+  struct gdakiTsPeer& pe = ts->peers[peer];
+  char cause[24];
+  snprintf(cause, sizeof(cause), "%s", pe.closeCause[0] ? pe.closeCause : "unknown");
+  (void)ncclGinRecoverAbort((ncclComm_t)r->commKey, peer);
+  snprintf(pe.lostCause, sizeof(pe.lostCause), "%s", cause);
+  gdakiTsMakeUnknown(pe);
+  GIN_TS_NOTE("GIN/TS: rank %d: socket to rank %d closed cause=%s mono_ms=%.3f liveness=unknown", r->ctx->rank, peer,
+              cause, gdakiQ4MonoMs());
+  ts->cCancelled.fetch_add(1, std::memory_order_relaxed);
+  WARN("GIN/TS: rank %d: round %lu from rank %d cancelled before the commit (socket %s); the initiator retries after "
+       "the reconnect mono_ms=%.3f", r->ctx->rank, (unsigned long)round, peer, cause, gdakiQ4MonoMs());
+  int retry = 0;
+  if (yf != nullptr && !gdakiTsRequeueRetry(r, *yf, &retry)) {
+    char why[96];
+    snprintf(why, sizeof(why), "socket to the peer lost in a yielded round (%s), retried %d times", cause,
+             GDAKI_TS_SOCK_RETRIES);
+    gdakiTsDecline(r, peer, why, false, yf->rec.cls);
+  }
+}
+
+// Responder part of a round once this rank's QPs to `peer` are quiesced and prepared: Commit with the
+// initiator's token, take the baseline, ACK with this rank's token and executed counts, wait for DONE (the
+// initiator reached RTR), then re-post from the initiator's counts. Used by a plain responder and (S2
+// tie-break) by an initiator of the higher rank that yields to the lower rank's simultaneous REQ: the lower
+// rank's round then recovers both directions, because each side re-posts its own unexecuted WQEs from the
+// other's counts. `yielded` = the round this rank abandoned (0: none).
+static void gdakiTsRespondPrepared(struct gdakiRecHost* r, int peer, const struct gdakiTsMsg& req,
+                                   const ncclGinRecoverToken_t& tok, const uint32_t* executed, const uint32_t* nrp,
+                                   uint32_t nqp, ncclGinRecoverStats_t* st, double t0, double tQ, double tP,
+                                   uint32_t hostRung, uint64_t yielded, const struct gdakiTsFault* yf = nullptr) {
+  struct gdakiTs* ts = r->ts;
+  struct gdaki_context* g = r->ctx;
+  const ncclComm_t comm = (ncclComm_t)r->commKey;
+  struct gdakiTsPeer& pe = ts->peers[peer];
+  struct gdakiTsMsg m;
+  auto nack = [&](int reason) {
+    memset(&m, 0, sizeof(m));
+    m.type = GDAKI_TS_NACK;
+    m.round = req.round;
+    m.from = g->rank;
+    m.arg = reason;
+    (void)gdakiTsSend(pe.fd, &m, 200);
+  };
+  const char* why = nullptr;
+  double gidWaitMs = 0;
+  int gidOld = g->gid_index;
+  struct gdakiTsReplayStats rs;
+  // gin-harden: last point at which this rank can back out without a decline. A socket that already shows a FIN or an
+  // error cancels the round (the initiator retries it after the reconnect); a firmware phase that overran declines.
+  if (gdakiTsFwCheck(r, &why)) {
+    nack(14);
+    return gdakiTsDecline(r, peer, why, false, req.arg);
+  }
+  if (gdakiTsRoundPeekLost(pe)) {
+    if (!pe.left) return gdakiTsCancelResponder(r, peer, req.round, yf);
+    return gdakiTsDecline(r, peer, "the peer left the communicator (BYE)", false, req.arg);
+  }
+  if (gdakiTsResolveGid(r, &gidWaitMs, &gidOld, &why) != ncclSuccess) {
+    nack(10);
+    return gdakiTsDecline(r, peer, why, false, req.arg);
+  }
+  const double tG = gdakiQ4MonoMs();
+  if (ncclGinRecoverCommit(comm, peer, &req.tok, st) != ncclSuccess) {
+    nack(7);
+    return gdakiTsDecline(r, peer, "commit failed", false, req.arg);
+  }
+  if (gdakiTsFwCheck(r, &why)) {  // gin-harden
+    nack(14);
+    return gdakiTsDecline(r, peer, why, false, req.arg);
+  }
+  if (gdakiTsBaseline(r, peer) != ncclSuccess) {
+    nack(8);
+    return gdakiTsDecline(r, peer, "QUERY_QP failed after commit", false, req.arg);
+  }
+  const double tC = gdakiQ4MonoMs();
+  memset(&m, 0, sizeof(m));
+  m.type = GDAKI_TS_ACK;
+  m.round = req.round;
+  m.from = g->rank;
+  m.nqp = nqp;
+  m.pad = req.pad;  // gin-pair-reset: the scope this rank used (the REQ's)
+  m.tok = tok;
+  for (uint32_t i = 0; i < nqp && i < NCCL_GIN_RECOVERY_MAX_QPS; i++) {
+    m.executed[i] = executed[i];
+    m.nrp[i] = nrp[i];
+  }
+  m.t[0] = (tQ - t0) * 1e3;
+  m.t[1] = (tP - tQ) * 1e3;
+  m.t[2] = (tC - tG) * 1e3;
+  m.t[3] = (tC - t0) * 1e3;
+  if (gdakiTsSend(pe.fd, &m, ts->handshakeMs) != 0) {
+    // after this rank's Commit: the commit cannot be undone, so this round declines (the initiator's retry, if any,
+    // is answered NACK 2)
+    char w[80];
+    const char* n = gdakiTsErrName(errno);
+    snprintf(w, sizeof(w), "cannot send ACK (%s)", n ? n : "send failed");
+    pe.gone = true;
+    return gdakiTsDecline(r, peer, w, false, req.arg);
+  }
+  // DONE: the initiator committed (its QPs are at RTR), so our own re-posted WQEs and new posts can go. The
+  // initiator may first wait for its own address (path wait). Bounded by what is left of the round.
+  struct gdakiTsMsg d;
+  const int got = gdakiTsRecv(pe, &d, gdakiTsRoundLeftMs(ts, 2 * ts->handshakeMs + ts->pathWaitMs), &ts->stop);
+  if (got < 0) {
+    char w[96];
+    snprintf(w, sizeof(w), "peer closed the socket before DONE (%s)", pe.closeCause[0] ? pe.closeCause : "unknown");
+    pe.gone = true;
+    return gdakiTsDecline(r, peer, w, false, req.arg);
+  }
+  if (got == 0) return gdakiTsDecline(r, peer, "DONE timeout", true, req.arg);
+  if (d.type == GDAKI_TS_BYE) {  // gin-harden
+    pe.left = true;
+    return gdakiTsDecline(r, peer, "the peer left the communicator (BYE)", false, req.arg);
+  }
+  if (d.type != GDAKI_TS_DONE || d.round != req.round)
+    return gdakiTsDecline(r, peer, d.type == GDAKI_TS_FAIL ? "peer FAIL before DONE" : "unexpected record before DONE",
+                          false, req.arg);
+  const double tD = gdakiQ4MonoMs();
+  if (gdakiTsReplayResume(r, peer, req.executed, req.nqp, &rs, &why) != ncclSuccess)
+    return gdakiTsDecline(r, peer, why ? why : "replay failed", true, req.arg);
+  const double tR = gdakiQ4MonoMs();
+  ts->nRecovered++;
+  ts->cRecovered.fetch_add(1, std::memory_order_relaxed);
+  GIN_TS_NOTE("GIN/TS: recovered rank=%d peer=%d role=responder round=%lu class=%s qps=%u scope=%#x S/U/n=[%s] replayed=%lu "
+       "rescued=%lu chunks=%lu rmsn0=%u nrp0=%#x host_rung=%u yielded=%lu gid=%d->%d gid_wait_ms=%.1f t_req=%.3f quiesce_us=%.0f "
+       "prepare_us=%.0f commit_us=%.0f ack_to_done_us=%.0f replay_us=%.0f total_us=%.0f t_resumed=%.3f",
+       g->rank, peer, (unsigned long)req.round, gdakiTsClassName(req.arg), rs.nqp,
+       gdakiTsShownScope(r, peer, gdakiTsScope), rs.detail,
+       (unsigned long)rs.replayed, (unsigned long)rs.rescued, (unsigned long)rs.chunks, executed[0], nrp[0], hostRung, (unsigned long)yielded, gidOld, g->gid_index,
+       gidWaitMs, t0, (tQ - t0) * 1e3, (tP - tQ) * 1e3, (tC - tG) * 1e3, (tD - tC) * 1e3, (tR - tD) * 1e3,
+       (tR - t0) * 1e3, tR);
+}
+
+static void gdakiTsRespond(struct gdakiRecHost* r, int peer, const struct gdakiTsMsg& req);  // gin-pair-reset: below
+
+// Initiator: the device reported a fault on a QP to rec.peer.
+static void gdakiTsInitiate(struct gdakiRecHost* r, const struct gdakiTsFault& f) {
+  struct gdakiTs* ts = r->ts;
+  struct gdaki_context* g = r->ctx;
+  const struct ncclGinGdakiQ4Record& rec = f.rec;
+  const int nranks = r->nranks;
+  const int peer = (int)rec.peer;
+  const ncclComm_t comm = (ncclComm_t)r->commKey;
+  if (peer < 0 || peer >= nranks || peer == g->rank) return;
+  struct gdakiTsPeer& pe = ts->peers[peer];
+  if (pe.declined) return;
+  const int qpIdx = peer + (int)rec.ctx_id * nranks;
+  if (qpIdx < (int)ts->qs.size()) ts->qs[qpIdx].handled = std::max(ts->qs[qpIdx].handled, rec.ts_epoch + 2u);
+  if (qpIdx < (int)ts->qs.size() && ts->qs[qpIdx].epoch > rec.ts_epoch) {  // an earlier round covered it
+    ts->nStale++;
+    INFO(NCCL_NET, "GIN/TS: stale fault record (epoch %u < %u) ignored", rec.ts_epoch, ts->qs[qpIdx].epoch);
+    return;
+  }
+  const double t0 = gdakiQ4MonoMs();
+  const int cls = rec.cls;
+  // Policy (as gin_recovery's driver did, now inside the library).
+  if (cls != NCCL_GIN_Q4_CLASS_RETRY_EXC && cls != NCCL_GIN_Q4_CLASS_LOCAL_QP_ERR) {
+    char why[64];
+    snprintf(why, sizeof(why), "class %s is not recoverable", gdakiTsClassName(cls));
+    return gdakiTsDecline(r, peer, why, true, cls);
+  }
+  if (ts->escalated) {  // gin-harden: recovery stopped on this context
+    char why[96];
+    (void)gdakiTsEscalated(r, why, sizeof(why));
+    return gdakiTsDecline(r, peer, why, true, cls);
+  }
+  {
+    // gin-reconnect: the helper socket's liveness, three ways. No evidence: go on. Dead: decline, naming the cause.
+    // Unknown: wait (bounded by NCCL_GIN_TS_RECONNECT_MS, before the round starts, heartbeat kept fresh) for the
+    // reconnect machinery; a reconnect means the peer answered; dead evidence or the bound ends the wait.
+    const bool retry = cls == NCCL_GIN_Q4_CLASS_RETRY_EXC;
+    const char* cause = nullptr;
+    int lv = gdakiTsPeerLiveness(r, peer, &cause);
+    if (lv == GDAKI_TS_LV_UNKNOWN) {
