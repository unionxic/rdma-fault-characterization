+static int64_t ncclParamGinQ4LateReadUs() { return 0; }
+#endif
+extern thread_local ncclResult_t* ncclGinQ4AsyncResult;  // gin/gin_host.cc
+extern "C" bool doca_gpu_gdrcopy_is_supported();          // doca-gpunetio/src/doca_gpunetio_gdrcopy.cpp
+
