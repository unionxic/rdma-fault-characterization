+
+// ---------------------------------------------------------------------------
+// GIN transparent recovery S2 (research build): device gate. The gate word (struct ncclGinTsGate2, in the
+// reserved1 padding of the device QP) carries the epoch (host) and the count of threads inside a counted
+// region (device); the other words (struct ncclGinTsGate, reserved2) are off the fast path. Off (flags ==
+// 0, the default): one plain load of the gate flags per post/flush/wait and nothing else; the slow paths
+// below are out of line so they do not change the code of the stock paths.
+// ---------------------------------------------------------------------------
+static_assert(offsetof(struct doca_gpu_dev_verbs_qp, reserved2) % 8 == 0, "gate must be 8-byte aligned");
+static_assert(sizeof(((struct doca_gpu_dev_verbs_qp*)0)->reserved2) == sizeof(struct ncclGinTsGate),
+              "gate must fill reserved2 exactly");
+static_assert(offsetof(struct doca_gpu_dev_verbs_qp, reserved1) % 8 == 0, "gate word must be 8-byte aligned");
+static_assert(sizeof(((struct doca_gpu_dev_verbs_qp*)0)->reserved1) == sizeof(struct ncclGinTsGate2),
+              "gate word must fill reserved1 exactly");
+static_assert(sizeof(struct doca_gpu_dev_verbs_qp) % 8 == 0, "device QP array stride must keep the gate aligned");
+#define NCCL_GIN_TS_EPOCH_ANY 0xffffffffu  // tsPollEnter: accept the current stable epoch
+#define NCCL_GIN_TS_EPOCH_BAD 0xfffffffeu  // request: no valid ticket (the QP failed)
+#define NCCL_GIN_TS_EPOCH_PENDING 0xfffffffdu  // request: a recovery was in progress; the wait takes the ticket
+
+NCCL_DEVICE_INLINE static struct ncclGinTsGate* tsGate(doca_gpu_dev_verbs_qp* qp) {
+  return reinterpret_cast<struct ncclGinTsGate*>(qp->reserved2);
+}
+NCCL_DEVICE_INLINE static unsigned long long* tsWord(doca_gpu_dev_verbs_qp* qp) {
+  return &reinterpret_cast<struct ncclGinTsGate2*>(qp->reserved1)->word;
+}
+// Written once by the host before any kernel can use the QP, so a plain (cacheable) load is enough.
+NCCL_DEVICE_INLINE static bool tsOn(doca_gpu_dev_verbs_qp* qp) { return (tsGate(qp)->flags & NCCL_GIN_TS_F_ON) != 0; }
+NCCL_DEVICE_INLINE static uint32_t tsLoadAcquireSys(uint32_t* p) {
+  uint32_t v;
+  asm volatile("ld.acquire.sys.global.u32 %0, [%1];" : "=r"(v) : "l"(p) : "memory");
+  return v;
+}
+NCCL_DEVICE_INLINE static uint32_t tsLoadRelaxedSys(uint32_t* p) {
+  uint32_t v;
+  asm volatile("ld.relaxed.sys.global.u32 %0, [%1];" : "=r"(v) : "l"(p) : "memory");
+  return v;
+}
+NCCL_DEVICE_INLINE static uint64_t tsLoadRelaxedSys64(uint64_t* p) {
+  uint64_t v;
+  asm volatile("ld.relaxed.sys.global.u64 %0, [%1];" : "=l"(v) : "l"(p) : "memory");
+  return v;
+}
+NCCL_DEVICE_INLINE static uint64_t tsNowNs() {
+  uint64_t t;
+  asm volatile("mov.u64 %0, %%globaltimer;" : "=l"(t));
+  return t;
+}
+
+// ---- the gate word ----
+// Entry: one atomic add of 1 with acquire semantics, performed at the GPU's L2, the coherence point that the
+// host's copy engine also writes through; the value it returns carries the epoch half. The acquire makes
+// the code inside the region read the QP state the host left before it published the epoch. Leave: a
+// release add of -1, so everything done inside (WQE writes, index atomics, doorbell record, CQ consumer
+// index) is visible before the host can read the count as 0. GPU scope: the other party is the host's copy
+// engine, which the PTX scopes do not describe (NCCL_GIN_TS_GATE_SYS selects system scope instead).
+#ifdef NCCL_GIN_TS_GATE_SYS
+#define NCCL_GIN_TS_SCOPE "sys"
+#else
+#define NCCL_GIN_TS_SCOPE "gpu"
+#endif
+NCCL_DEVICE_INLINE static unsigned long long tsWordEnter(unsigned long long* p) {
+  unsigned long long old;
+  asm volatile("atom.acquire." NCCL_GIN_TS_SCOPE ".global.add.u64 %0, [%1], 1;" : "=l"(old) : "l"(p) : "memory");
+  return old;
+}
+NCCL_DEVICE_INLINE static void tsWordLeave(unsigned long long* p) {
+  asm volatile("red.release." NCCL_GIN_TS_SCOPE ".global.add.u64 [%0], %1;" ::"l"(p), "l"(0xffffffffffffffffull)
+               : "memory");
+}
+NCCL_DEVICE_INLINE static unsigned long long tsWordLoad(unsigned long long* p) {
+  unsigned long long v;
+  asm volatile("ld.relaxed.sys.global.u64 %0, [%1];" : "=l"(v) : "l"(p) : "memory");
+  return v;
+}
+NCCL_DEVICE_INLINE static uint32_t tsWordHi(unsigned long long w) { return (uint32_t)(w >> 32); }
+NCCL_DEVICE_INLINE static uint32_t tsWordEpoch(unsigned long long w) { return tsWordHi(w) & NCCL_GIN_TS_W_EPOCH_MASK; }
+NCCL_DEVICE_INLINE static bool tsWordFailed(unsigned long long w) {
+  return ((tsWordHi(w) & NCCL_GIN_TS_W_HOST_FAILED) | ((uint32_t)w & NCCL_GIN_TS_W_DEV_FAILED)) != 0;
+}
+// Stable (even epoch) and not failed: the one test on the fast path.
+NCCL_DEVICE_INLINE static bool tsWordOpen(unsigned long long w) {
+  return ((tsWordHi(w) & (1u | NCCL_GIN_TS_W_HOST_FAILED)) | ((uint32_t)w & NCCL_GIN_TS_W_DEV_FAILED)) == 0;
+}
+
+// Results of the bounded waits below.
+#define NCCL_GIN_TS_OK 0       // proceed
+#define NCCL_GIN_TS_FAIL 1     // the QP failed (declined by the host, or a device give-up won): an error
+#define NCCL_GIN_TS_TIMEOUT 2  // the caller's own timeout expired first (not a failure: stock timeout semantics)
+
+// The caller's own deadline (clock64 based, as the stock timeout paths): cycles == 0 means none.
+// gin-harden: abortFlag = the waiter's devComm abort word (nullptr for posters, which have none). A parked waiter
+// fails as soon as that word carries NCCL_DEVCOMM_ABORT_ERROR (a user devComm's own word: decline, peer judged dead,
+// ncclCommAbort, an aborting shrink, a revoke, the firmware-phase watchdog). The host writes that word with a plain
+// CPU store, so parked device threads are released without any copy or firmware command. A local struct only: no
+// device/host layout changes.
+struct ncclGinTsDeadline {
+  uint64_t start;
+  uint64_t cycles;
+  uint32_t* abortFlag;
+};
+NCCL_DEVICE_INLINE static bool tsExpired(const struct ncclGinTsDeadline& d) {
+  return d.cycles != 0 && (uint64_t)clock64() - d.start >= d.cycles;
+}
+
+// Mark the QP failed from the device and raise the sticky context error (blocking flush()/wait() report
+// it). The failure bit is in the count half, which only the device writes, and it is only ever set, so a
+// host write of the epoch half can never clear it.
+NCCL_DEVICE_INLINE static void tsPoison(doca_gpu_dev_verbs_qp* qp, struct ncclGinGdakiQ4* q4, uint32_t ctxId) {
+  atomicOr(tsWord(qp), (unsigned long long)NCCL_GIN_TS_W_DEV_FAILED);
+  if (q4 != nullptr) {
+    const uint32_t c = ctxId < NCCL_GIN_GDAKI_Q4_MAX_CTX ? ctxId : NCCL_GIN_GDAKI_Q4_MAX_CTX - 1;
+    atomicExch(&q4->sticky[c], 1u);
+  }
+  __threadfence_system();
+}
+
+// A device thread whose bound expired while it waited for stable epoch `next`. Commit point with the
+// host (Dekker, slow path only): record `next` in abandoned, fence, read commit; the host writes commit =
+// next, then reads abandoned. Either the host sees the give-up (it declines: nothing of that round executes)
+// or the thread sees the commit (it keeps waiting: the round is publishing). Returns true if the give-up
+// won; the caller then poisons the QP, so later waits on it fail at once instead of each waiting for a
+// bound, and later posts are not made (the gate sees the failure bit); the host declines on seeing it.
+NCCL_DEVICE_INLINE static bool tsGiveUp(doca_gpu_dev_verbs_qp* qp, uint32_t next) {
+  atomicMax(&tsGate(qp)->abandoned, next);
+  __threadfence_system();
+  return tsLoadAcquireSys(&tsGate(qp)->commit) < next;
+}
+
+// A device thread whose second bound expired (its give-up lost: the host passed its commit point for `next`).
+// Second Dekker (S2, closes S1's post-commit residual), again on the gate word: set the failure bit with a CAS
+// unless the host already marked the round PUBLISHING, i.e. passed its last check and is re-posting now. The
+// host writes PUBLISHING, then reads the word and declines if the bit is set. So either the host sees the
+// failure (nothing is re-posted) or this thread sees PUBLISHING and waits for the publication instead of
+// failing (one more bound; returns false then). Returns true if the QP failed.
+NCCL_DEVICE_INLINE static bool tsLateFail(doca_gpu_dev_verbs_qp* qp, struct ncclGinGdakiQ4* q4, uint32_t ctxId,
+                                          uint32_t next) {
+  unsigned long long* p = tsWord(qp);
+  unsigned long long old = tsWordLoad(p);
+  while (true) {
+    if (tsWordFailed(old)) break;
+    const uint32_t hi = tsWordHi(old);
+    if ((hi & NCCL_GIN_TS_W_PUBLISHING) || ((hi & 1u) == 0 && tsWordEpoch(old) >= next)) return false;
+    const unsigned long long prev = atomicCAS(p, old, old | (unsigned long long)NCCL_GIN_TS_W_DEV_FAILED);
+    if (prev == old) break;
+    old = prev;
+  }
+  tsPoison(qp, q4, ctxId);
+  return true;
+}
+
+// Park until the epoch is stable and differs from `notEpoch` (NCCL_GIN_TS_EPOCH_ANY: any stable epoch),
+// bounded by the caller's deadline (TIMEOUT) and by the gate's waitMs: a give-up through the commit point;
+// after a lost give-up, one more bound, then a failure through the second Dekker (tsLateFail); if the host
+// is re-posting by then, one more bound for the publication, then failure regardless. No counter traffic
+// while parked, so a recovery in progress reads a count that only goes down.
+NCCL_DEVICE_INLINE static int tsParkStable(doca_gpu_dev_verbs_qp* qp, uint32_t notEpoch, struct ncclGinGdakiQ4* q4,
+                                           uint32_t ctxId, const struct ncclGinTsDeadline& dl) {
+  struct ncclGinTsGate* g = tsGate(qp);
+  const uint64_t holdNs = (uint64_t)tsLoadRelaxedSys(&g->waitMs) * 1000000ull;
+  uint64_t t0 = tsNowNs();
+  int stage = 0;  // 0 first bound, 1 after a lost give-up, 2 the host is re-posting (PUBLISHING seen)
+  uint32_t abortSteps = 0;
+  NVCC_PRAGMA_UNROLL_DISABLED
+  while (true) {
+    const unsigned long long w = tsWordLoad(tsWord(qp));
+    if (tsWordFailed(w)) return NCCL_GIN_TS_FAIL;
+    const uint32_t cur = tsWordEpoch(w);
+    if ((cur & 1u) == 0 && cur != notEpoch) return NCCL_GIN_TS_OK;
+    if (tsExpired(dl)) return NCCL_GIN_TS_TIMEOUT;
+    // gin-harden: the user devComm's own abort word with the error bit releases a parked waiter at once. The QP is
+    // failed from the device too (DEV_FAILED: the host then never publishes a round whose waiter saw an error).
+    if (dl.abortFlag != nullptr && (++abortSteps & 0x3fu) == 0 && nccl::utility::abortIsError(dl.abortFlag)) {
+      tsPoison(qp, q4, ctxId);
+      return NCCL_GIN_TS_FAIL;
+    }
+    if (tsNowNs() - t0 > holdNs) {
+      // The stable epoch we wait for: the next one after an odd epoch, else the one after notEpoch.
+      const uint32_t next = (cur & 1u) ? cur + 1u : notEpoch + 2u;
+      if (stage == 0) {
+        if (tsGiveUp(qp, next)) {  // the host has not passed its commit point: it will decline
+          tsPoison(qp, q4, ctxId);
+          return NCCL_GIN_TS_FAIL;
+        }
+      } else if (stage == 1) {
+        if (tsLateFail(qp, q4, ctxId, next)) return NCCL_GIN_TS_FAIL;
+      } else {
+        tsPoison(qp, q4, ctxId);  // the host stalled inside its re-post for a whole bound (residual)
+        return NCCL_GIN_TS_FAIL;
+      }
+      stage++;
+      t0 = tsNowNs();
+    }
+    __nanosleep(1000);
+  }
+}
+
+// Poster slow path (out of line): the entry add returned an odd epoch or a failure. Back out, park (bounded
+// by waitMs through the commit point, as waiters), and enter again once a new stable epoch is published.
+// Returns false if the post must not be made: the QP failed (the operation is not posted and every later
+// flush/wait on the QP reports ncclRemoteError).
+// gin-harden: the user devComm's own abort word for a parked poster: the host stores it in gate.test with bit 0 set
+// (the field holds the split test's pointer only under NCCL_GIN_TS_F_TEST_SPLIT); nullptr while it is not there (or
+// with an older library, which leaves the field 0): the poster is then bounded by waitMs as before.
+NCCL_DEVICE_INLINE static uint32_t* tsPosterAbortWord(doca_gpu_dev_verbs_qp* qp) {
+  struct ncclGinTsGate* g = tsGate(qp);
+  if (g->flags & NCCL_GIN_TS_F_TEST_SPLIT) return nullptr;
+  const uint64_t t = tsLoadRelaxedSys64(&g->test);
+  return (t & 1ull) ? (uint32_t*)(uintptr_t)(t & ~1ull) : nullptr;
+}
+
+__device__ __noinline__ static bool tsGateEnterSlow(doca_gpu_dev_verbs_qp* qp, struct ncclGinGdakiQ4* q4, uint32_t ctxId,
+                                                    unsigned long long w) {
+  unsigned long long* word = tsWord(qp);
+  struct ncclGinTsDeadline none;
+  none.start = 0;
+  none.cycles = 0;
+  none.abortFlag = tsPosterAbortWord(qp);  // gin-harden
+  while (true) {
+    tsWordLeave(word);
+    // A QP failed by a device give-up or at communicator teardown may still be healthy on the NIC, and
+    // must take no new post.
+    if (tsWordFailed(w)) {
+      tsPoison(qp, q4, ctxId);
+      return false;
+    }
+    // The epoch this poster waits for is the one after the odd epoch it saw (tsParkStable computes it
+    // from the odd epoch it reads; an even epoch there means the host already published: enter again).
+    const int pr = tsParkStable(qp, NCCL_GIN_TS_EPOCH_ANY, q4, ctxId, none);
+    if (pr != NCCL_GIN_TS_OK) {
+      tsPoison(qp, q4, ctxId);
+      return false;
+    }
+    w = tsWordEnter(word);
+    if (tsWordOpen(w)) return true;
+  }
+}
+// Enter the post critical section of `qp` (before a WQE slot is reserved): one atomic add; a parked poster
+// is uncounted and holds no WQE slot.
+NCCL_DEVICE_INLINE static bool tsGateEnter(doca_gpu_dev_verbs_qp* qp, struct ncclGinGdakiQ4* q4, uint32_t ctxId) {
+  const unsigned long long w = tsWordEnter(tsWord(qp));
+  if (tsWordOpen(w)) return true;
+  return tsGateEnterSlow(qp, q4, ctxId, w);
+}
+NCCL_DEVICE_INLINE static void tsGateLeave(doca_gpu_dev_verbs_qp* qp) { tsWordLeave(tsWord(qp)); }
+
+// S2 (review): the vendored slot wait records the first error CQE it sees (ncclGinTsGate::swErr) and the poster
+// reports it after its post (defined after q4Report below). Without this, a poster whose slot wait consumed the
+// error CQE of the WQE one ring behind would post, and its flush would then wait one ring past the CQ window's
+// stuck consumer index without anything ever being reported (measured: a kernel that never exits).
+__device__ __noinline__ static void tsSwErrReport(ncclGinCtx ctx, struct ncclGinGdakiQ4* q4, doca_gpu_dev_verbs_qp* qp,
+                                                  int peer);
+NCCL_DEVICE_INLINE static void tsPostLeave(ncclGinCtx ctx, struct ncclGinGdakiQ4* q4, doca_gpu_dev_verbs_qp* qp, int peer) {
+  tsGateLeave(qp);
+  if (*(volatile uint32_t*)&tsGate(qp)->swErr) tsSwErrReport(ctx, q4, qp, peer);
+}
+// A WQE that is not one request message at the responder (NOP, DUMP) or one S2 does not replay (READ)
+// was posted in this epoch: the host then declines, because it counts executed WQEs by the responder's
+// message sequence number.
+#define NCCL_GIN_TS_NONMSG_NOP 0x1u
+#define NCCL_GIN_TS_NONMSG_DUMP 0x2u
+#define NCCL_GIN_TS_NONMSG_READ 0x4u
+NCCL_DEVICE_INLINE static void tsMarkNonMsg(doca_gpu_dev_verbs_qp* qp, uint32_t bit) { atomicOr(&tsGate(qp)->nonmsg, bit); }
+
+// Counted poll region. A waiter polls (and may advance cq_sq.cqe_ci) only inside it, and only while the
+// epoch is stable and unchanged; the host makes the epoch odd, then waits for the count to reach 0 before
+// it rewrites cqe_ci, cqe_rsvd, the indices or lbase. Same single-word argument as the post gate. Callers
+// park (tsParkStable) after a failed attempt, so a recovery in progress sees no counter traffic from them.
+// *e: NCCL_GIN_TS_EPOCH_ANY (set to the current stable epoch) or the epoch that must still be current.
+NCCL_DEVICE_INLINE static void tsPollLeave(doca_gpu_dev_verbs_qp* qp) { tsWordLeave(tsWord(qp)); }
+NCCL_DEVICE_INLINE static bool tsPollEnter(doca_gpu_dev_verbs_qp* qp, uint32_t* e) {
+  const unsigned long long w = tsWordEnter(tsWord(qp));
+  const uint32_t cur = tsWordHi(w);
+  if (tsWordOpen(w) && (*e == NCCL_GIN_TS_EPOCH_ANY || cur == *e)) {
+    *e = cur;
+    return true;
+  }
+  tsPollLeave(qp);
+  return false;
+}
+
+// A logical ticket for everything posted so far on `qp`: *logicalCount = lbase + sq_rsvd_index, read
+// inside the counted region (where neither can change). stay = keep the region entered on success
+// (flush polls next; *epoch and *phys then describe the entered state). One attempt first (the fast path:
+// one atomic), then park and retry.
+template <enum doca_gpu_dev_verbs_resource_sharing_mode doca_sharing_mode>
+__device__ __noinline__ static int tsTicketSlow(doca_gpu_dev_verbs_qp* qp, uint32_t* epoch, uint64_t* phys,
+                                                uint64_t* logicalCount, bool stay, struct ncclGinGdakiQ4* q4,
+                                                uint32_t ctxId, struct ncclGinTsDeadline dl) {
+  struct ncclGinTsGate* g = tsGate(qp);
+  while (true) {
+    const int pr = tsParkStable(qp, NCCL_GIN_TS_EPOCH_ANY, q4, ctxId, dl);
+    if (pr != NCCL_GIN_TS_OK) return pr;
+    uint32_t e = NCCL_GIN_TS_EPOCH_ANY;
+    if (!tsPollEnter(qp, &e)) continue;  // went odd (or failed) in between: park again
+    const uint64_t n = doca_gpu_dev_verbs_atomic_read<uint64_t, doca_sharing_mode>(&qp->sq_rsvd_index);
+    *epoch = e;
+    *phys = n;
+    *logicalCount = tsLoadRelaxedSys64(&g->lbase) + n;
+    if (!stay) tsPollLeave(qp);
+    return NCCL_GIN_TS_OK;
+  }
+}
+template <enum doca_gpu_dev_verbs_resource_sharing_mode doca_sharing_mode>
+NCCL_DEVICE_INLINE static int tsTicket(doca_gpu_dev_verbs_qp* qp, uint32_t* epoch, uint64_t* phys,
+                                       uint64_t* logicalCount, bool stay, struct ncclGinGdakiQ4* q4, uint32_t ctxId,
+                                       struct ncclGinTsDeadline dl) {
+  uint32_t e = NCCL_GIN_TS_EPOCH_ANY;
+  if (tsPollEnter(qp, &e)) {
+    const uint64_t n = doca_gpu_dev_verbs_atomic_read<uint64_t, doca_sharing_mode>(&qp->sq_rsvd_index);
+    *epoch = e;
+    *phys = n;
+    *logicalCount = tsLoadRelaxedSys64(&tsGate(qp)->lbase) + n;
+    if (!stay) tsPollLeave(qp);
+    return NCCL_GIN_TS_OK;
+  }
+  return tsTicketSlow<doca_sharing_mode>(qp, epoch, phys, logicalCount, stay, q4, ctxId, dl);
+}
