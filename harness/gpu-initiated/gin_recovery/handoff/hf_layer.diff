+// gin-handoff: the readiness check of an aborting shrink (NCCL_SHRINK_ABORT). Stock ncclCommInitChildComm calls
+// ncclCommEnsureReady, which reports the parent's GIN async error, so stock NCCL can never shrink a communicator after a
+// GIN error, not even to drop the rank that caused it. Here the aborting shrink goes on when the parent's only pending
+// error is the GIN error of its GDAKI contexts and the GDAKI layer raised it only for GIN peers that are all excluded
+// (gin_host_gdaki.cc ncclGinTsBlameQuery). The child of an aborting shrink never shares the parent's resources
+// (ncclCommInitChildComm: shareResources is false for NCCL_SHRINK_ABORT): it gets its own shared resources, GIN state,
+// async result and abort flags, so it does not inherit the parent's GIN error; the parent keeps its error and still has
+// to be aborted or destroyed. Every other case keeps the stock answer and says why: NCCL_GIN_SHRINK_HANDOFF=0, an error
+// that is not ncclRemoteError or not from GIN (the communicator's or the proxy's async result), GIN progress threads
+// (their async result names no peer), a GIN state shared with another communicator, a GIN backend other than GDAKI, no
+// record, a raise without a peer, a peer that cannot be mapped or is not excluded. excludeRanksList is sorted.
+static double commMonoMs() {
+  struct timespec t;
+  clock_gettime(CLOCK_MONOTONIC, &t);
+  return t.tv_sec * 1e3 + t.tv_nsec * 1e-6;
+}
+
+static ncclResult_t commShrinkAbortReady(ncclComm_t comm, int* excludeRanksList, int excludeRanksCount) {
+  const ncclResult_t ret = ncclCommEnsureReady(comm);
+  if (ret == ncclSuccess || ret == ncclInvalidArgument) return ret;  // nothing to hand off; or used before its init ended
+  const int kMaxPeers = 64;
+  int peers[kMaxPeers], worlds[kMaxPeers];
+  int nPeers = 0;
+  char whyBuf[160];
+  const char* why = nullptr;
+  struct ncclGinState* gs = comm->sharedRes ? &comm->sharedRes->ginState : nullptr;
+  if (!ncclGinShrinkHandoffEnabled()) {
+    why = "NCCL_GIN_SHRINK_HANDOFF=0";
+  } else if (ret != ncclRemoteError) {
+    why = "the error is not ncclRemoteError";
+  } else if (COMPILER_ATOMIC_LOAD(&comm->asyncResult, std::memory_order_acquire) != ncclSuccess ||
+             (comm->proxyState &&
+              COMPILER_ATOMIC_LOAD(&comm->proxyState->asyncResult, std::memory_order_acquire) != ncclSuccess)) {
+    why = "the communicator or its proxy has an error of its own";
+  } else if (gs == nullptr || !gs->connected) {
+    why = "no GIN state";
+  } else if (gs->proxyThreadsCreated) {
+    why = "GIN progress threads (their error names no peer)";
+  } else if (comm->sharedRes->owner != comm || __atomic_load_n(&comm->sharedRes->refCount, __ATOMIC_ACQUIRE) != 1) {
+    why = "the GIN state is shared with another communicator";
+  } else {
+    {
+      std::shared_lock<std::shared_timed_mutex> rl(gs->devCommRwMutex);
+      for (struct ncclGinStateDevComm* dc = gs->devComms; dc != nullptr && why == nullptr; dc = dc->next)
+        if (gs->backends[dc->backendIndex].ncclGin != &ncclGinIbGdaki) why = "a GIN backend other than GDAKI";
+    }
+    if (why == nullptr) {
+      // the GIN ranks of the GDAKI contexts: the team ncclGinConnectOnce connects (gin/gin_host.cc)
+      const bool full = gs->ginConnectionType == NCCL_GIN_CONNECTION_FULL;
+      const int stride = full ? 1 : comm->contiguousRanksPerHost;
+      const int q = ncclGinTsBlameQuery(&gs->asyncResult, peers, kMaxPeers, &nPeers);
+      if (q == 0) why = "no record of the GIN error";
+      else if (q < 0) why = "a GIN error was raised without a peer";
+      else if (nPeers == 0) why = "no peer recorded";
+      else if (stride < 1 || stride == INT_MAX) why = "the GIN ranks cannot be mapped to communicator ranks";
+      for (int i = 0; why == nullptr && i < nPeers; i++) {
+        const int world = worlds[i] = comm->rank + (peers[i] - comm->rank / stride) * stride;
+        if (world < 0 || world >= comm->nRanks || world == comm->rank ||
+            bsearch(&world, excludeRanksList, excludeRanksCount, sizeof(int), compareInts) == nullptr) {
+          snprintf(whyBuf, sizeof(whyBuf), "it was raised for rank %d (GIN rank %d), which is not excluded", world,
+                   peers[i]);
+          why = whyBuf;
+        }
+      }
+    }
+  }
+  if (why != nullptr) {
+    WARN("GIN/TS: rank %d: aborting shrink keeps the parent's error (%s) mono_ms=%.3f", comm->rank, why, commMonoMs());
+    return ret;
+  }
+  char list[256];
+  int len = 0;
+  list[0] = '\0';
+  for (int i = 0; i < nPeers && len < (int)sizeof(list) - 16; i++)
+    len += snprintf(list + len, sizeof(list) - len, "%s%d", i ? "," : "", worlds[i]);
+#ifdef NCCL_GIN_TS_PRODUCTION
+  INFO(NCCL_INIT,
+#else
+  WARN(
+#endif
+       "GIN/TS: rank %d: aborting shrink proceeds past the parent's GIN error, raised for rank(s) %s, all excluded "
+       "mono_ms=%.3f", comm->rank, list, commMonoMs());
+  return ncclSuccess;
+}
