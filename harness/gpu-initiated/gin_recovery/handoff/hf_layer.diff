+// ---- gin-handoff: which GIN peers the GIN async error of a communicator was raised for ----
+// Every place in this file that makes ncclCommGetAsyncError report a GIN error (q4->hasError, read by
+// ncclGinGdakiQueryLastError; the GIN async result) first notes it here, keyed by the GIN async result slot of the
+// communicator's GIN state (&sharedRes->ginState.asyncResult = q4->asyncResult of each of its GDAKI contexts): the GIN
+// peer the error was raised for (a decline, a classified error CQE without transparent recovery), or no peer (a watchdog
+// surface, the QUERY_QP-based query without the classifier). An aborting ncclCommShrink (init.cc commShrinkAbortReady)
+// reads it: the parent's GIN error does not block that shrink when every peer it was raised for is excluded and no raise
+// lacked a peer. The note comes before the flag it explains, so a shrink that sees the flag also sees the note. A raise
+// that cannot be tied to a communicator (no slot) turns that rule off for the whole process. Entries are dropped when the
+// GIN state is freed (init.cc commFree); a stale entry can only add peers, never remove one.
+NCCL_PARAM(GinShrinkHandoff, "GIN_SHRINK_HANDOFF", 1);  // gin-handoff: 0 = stock (an aborting shrink fails on a GIN error)
+struct gdakiBlame {
+  const void* slot;
+  std::vector<int> peers;  // GIN ranks, each once
+  uint64_t noPeer;         // raises that named no peer
+};
+static std::mutex gdakiBlameMu;
+static std::vector<struct gdakiBlame> gdakiBlameReg;
+static std::atomic<int> gdakiBlameUnkeyed{0};
+
+static void gdakiBlameNote(const void* slot, int peer) {
+  if (slot == nullptr) {
+    gdakiBlameUnkeyed.store(1, std::memory_order_seq_cst);
+    return;
+  }
+  std::lock_guard<std::mutex> lk(gdakiBlameMu);
+  struct gdakiBlame* e = nullptr;
+  for (auto& x : gdakiBlameReg)
+    if (x.slot == slot) e = &x;
+  if (e == nullptr) {
+    gdakiBlameReg.push_back({slot, {}, 0});
+    e = &gdakiBlameReg.back();
+  }
+  if (peer < 0) e->noPeer++;
+  else if (std::find(e->peers.begin(), e->peers.end(), peer) == e->peers.end()) e->peers.push_back(peer);
+}
+
+// init.cc: 1 with the GIN peers (at most maxPeers) when every GIN error raise for `slot` named a peer; 0 when there is
+// no record for `slot`; -1 when a raise named no peer, a raise could not be tied to any communicator, or there are more
+// than maxPeers peers.
+int ncclGinTsBlameQuery(const void* slot, int* peers, int maxPeers, int* nPeers) {
+  *nPeers = 0;
+  if (gdakiBlameUnkeyed.load(std::memory_order_seq_cst)) return -1;
+  std::lock_guard<std::mutex> lk(gdakiBlameMu);
+  for (auto& x : gdakiBlameReg) {
+    if (x.slot != slot) continue;
+    if (x.noPeer != 0 || (int)x.peers.size() > maxPeers) return -1;
+    for (int p : x.peers) peers[(*nPeers)++] = p;
+    return 1;
+  }
+  return 0;
+}
+
+// init.cc commFree: the GIN state that owns `slot` is freed (another communicator may get the same address).
+void ncclGinTsBlameForget(const void* slot) {
+  std::lock_guard<std::mutex> lk(gdakiBlameMu);
+  for (size_t i = 0; i < gdakiBlameReg.size(); i++)
+    if (gdakiBlameReg[i].slot == slot) {
+      gdakiBlameReg.erase(gdakiBlameReg.begin() + i);
+      return;
+    }
+}
+
+int ncclGinShrinkHandoffEnabled() { return ncclParamGinShrinkHandoff() != 0 ? 1 : 0; }
