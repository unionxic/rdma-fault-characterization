+// creation in the log measurement mode.
+static bool gdakiRsPublish(struct gdakiRecHost* r, char* why, size_t whyLen) {
+  if (r->rsPublished.load(std::memory_order_acquire)) return true;
+  if (!r->rsPtrSet || r->ctx == nullptr || r->ctx->q4 == nullptr || r->ctx->q4->dev == nullptr) {
+    snprintf(why, whyLen, "no side table or no classification block");
+    return false;
+  }
+  int dev = -1;
+  if (cudaGetDevice(&dev) != cudaSuccess || (dev != r->ctx->cuda_id && cudaSetDevice(r->ctx->cuda_id) != cudaSuccess)) {
+    snprintf(why, whyLen, "cannot select CUDA device %d", r->ctx->cuda_id);
+    return false;
+  }
+  struct DevBack {
+    int d, want;
+    ~DevBack() { if (d >= 0 && d != want) (void)cudaSetDevice(d); }
+  } back{dev, r->ctx->cuda_id};
+  cudaStream_t st = nullptr;
+  struct ncclGinRsSide* side = (struct ncclGinRsSide*)r->rsBase;
+  bool ok = cudaStreamCreateWithFlags(&st, cudaStreamNonBlocking) == cudaSuccess;
+  ok = ok && cudaMemcpyAsync(&r->ctx->q4->dev->restore, &side, sizeof(side), cudaMemcpyHostToDevice, st) == cudaSuccess &&
+       cudaStreamSynchronize(st) == cudaSuccess;
+  if (st != nullptr) (void)cudaStreamDestroy(st);
+  if (!ok) {
+    snprintf(why, whyLen, "the write into the classification block failed");
+    return false;
+  }
+  r->rsPublished.store(true, std::memory_order_release);
+  return true;
+}
+static void gdakiRsPublishFor(void* comm, void* handle) {
+  std::lock_guard<std::mutex> lk(gdakiRecRegMu);  // the context stays registered (and its blocks allocated) while held
+  struct gdakiRecHost* r = nullptr;
+  for (auto* x : gdakiRecReg)
+    if (handle != nullptr && x->commKey == comm && x->ctx != nullptr && x->ctx->devHandle != nullptr &&
+        x->ctx->devHandle->handle == handle)
+      r = x;
+  if (r == nullptr) return;
+  char why[128] = {0};
+  if (gdakiRsPublish(r, why, sizeof(why)))
+    GIN_TS_NOTE("GIN/RS: rank %d: side table published to the device (ncclGinRestoreResume%s)", r->ctx->rank,
+                r->rsMeasureMs > 0 ? ", log measurement mode" : "");
+  else  // this rank's log never starts: its pauses refuse (gdakiRsLogPauseRead), so no peer is armed on it
+    WARN("GIN/RS: rank %d: the side table could not be published to the device (%s): this rank keeps no send-side log "
+         "and its checkpoint pauses refuse", r->ctx->rank, why);
+}
+static ncclResult_t gdakiRsLogNotReady(char* why, size_t whyLen) {
+  if (why && whyLen) snprintf(why, whyLen, "this context has no send-side log");
+  return ncclInvalidUsage;
+}
+// The identity words of positions [from, to) (to - from entries, one NIC read, not across the ring's end).
+static bool gdakiRsLogReadIds(struct gdakiRecHost* r, uint64_t from, uint64_t to, uint64_t* ids) {
+  struct gdakiRsLogHost* lh = r->rsLog;
+  const uint64_t n = lh->st.n, slot = from & (n - 1);
+  const size_t bytes = (size_t)(to - from) * sizeof(struct ncclGinRsLogEntry);
+  if (to <= from || slot + (to - from) > n || bytes > r->pinnedSize) return false;
+  if (gdakiLbXfer(r, false, lh->ringDev + slot * sizeof(struct ncclGinRsLogEntry), bytes) != ncclSuccess) return false;
+  for (uint64_t p = from; p < to; p++) memcpy(&ids[p - from], r->pinned + (size_t)(p - from) * sizeof(struct ncclGinRsLogEntry), 8);
+  return true;
+}
+// Entries per NIC read of the ring (whole entries within the staging buffer, at most 64 KiB).
+static uint64_t gdakiRsLogChunk(struct gdakiRecHost* r) {
+  const size_t b = std::min<size_t>(r->pinnedSize, 64 * 1024) / sizeof(struct ncclGinRsLogEntry);
+  return b > 0 ? b : 1;
+}
+static void gdakiRsLogCreate(struct gdakiRecHost* r, uint32_t nEntries, size_t ringOff) {
+  r->rsLog = new gdakiRsLogHost();
+  gdakiRsLogStateInit(&r->rsLog->st, nEntries, r->rsNqp, r->nranks);
+  r->rsLog->ringDev = (char*)r->rsBase + ringOff;
+  // work package 9: every QP's executed count starts at the setup's responder MSN baseline (taken before any traffic)
+  const size_t nq = (size_t)(r->rsNqp > 0 ? r->rsNqp : 0);
+  r->rsLog->exec.assign(nq, gdakiRsExecQp());
+  for (size_t i = 0; i < nq && r->ts != nullptr && i < r->ts->qs.size(); i++)
+    gdakiRsExecRebaseQp(r->rsLog->exec[i], r->ts->qs[i].rmsn0);
+  r->rsLog->budget.assign(nq, 0);
+  r->rsLog->budgetSet.assign(nq, 0);
+  r->rsLog->budgetSaid.assign(nq, 0);
+}
+static uint64_t gdakiRsLogTrimErrors(struct gdakiRecHost* r) {
+  return r->rsLog ? r->rsLog->st.trimErrors.load(std::memory_order_relaxed) : 0;
+}
+static void gdakiRsLogFree(struct gdakiRecHost* r) {
+  if (r->rsLog == nullptr) return;
+  if (r->rsLog->appStream != nullptr) (void)cudaStreamDestroy(r->rsLog->appStream);
+  delete r->rsLog;
+  r->rsLog = nullptr;
+}
+// The tail's advance (pure rule) and, when it moved, its write to the device.
+static ncclResult_t gdakiRsLogTrim(struct gdakiRecHost* r, uint64_t head) {
+  struct gdakiRsLogHost* lh = r->rsLog;
+  const uint64_t old = lh->st.tail;
+  bool failed = false;
+  const uint64_t t = gdakiRsLogStateAdvance(
+    &lh->st, head, gdakiRsLogChunk(r),
+    [&](uint64_t a, uint64_t b, uint64_t* ids) { return gdakiRsLogReadIds(r, a, b, ids); }, &failed);
+  if (t != old) {
+    memcpy(r->pinned, &t, sizeof(t));
+    if (gdakiLbXfer(r, true, &((struct ncclGinRsSide*)r->rsBase)->tail, sizeof(uint64_t)) != ncclSuccess) {
+      lh->st.tail = old;  // the device keeps the old tail: so does the host (the next trim writes again)
+      return ncclSystemError;
+    }
+  }
+  return failed ? ncclSystemError : ncclSuccess;
+}
+static ncclResult_t gdakiRsLogPauseRead(struct gdakiRecHost* r, int peer, struct gdakiRsLogPause* out, char* why,
+                                        size_t whyLen) {
+  if (!gdakiRsLogReady(r)) return gdakiRsLogNotReady(why, whyLen);
+  if (!r->rsPublished.load(std::memory_order_acquire)) {  // the device does not log before ncclGinRestoreResume succeeded
+    snprintf(why, whyLen, "the side table is not published to the device (ncclGinRestoreResume did not succeed here)");
+    return ncclInvalidUsage;
+  }
+  struct gdakiRsLogHost* lh = r->rsLog;
+  int idx[NCCL_GIN_RECOVERY_MAX_QPS];
+  const int n = gdakiRsQpsOfPeer(r, peer, idx);
+  if (n == 0) {
+    snprintf(why, whyLen, "no QP to rank %d", peer);
+    return ncclInvalidUsage;
+  }
+  for (int k = 0; k < n; k++) {  // the log of these QPs starts at this pause (before its even epoch is published)
+    if (lh->st.qp[(size_t)idx[k]].logs) continue;
+    const uint32_t one = 1;
+    memcpy(r->pinned, &one, sizeof(one));
+    if (gdakiLbXfer(r, true, &gdakiRsQpDev(r, idx[k])->logOn, sizeof(uint32_t)) != ncclSuccess) {
+      snprintf(why, whyLen, "cannot set logOn of qp %d over the NIC copy path", idx[k]);
+      return ncclSystemError;
+    }
+  }
+  struct ncclGinRsSide h;
+  std::vector<struct ncclGinRsQp> v;
+  const char* w = nullptr;
+  if (!gdakiRsReadSide(r, &h, &v, &w)) {
+    snprintf(why, whyLen, "%s", w ? w : "cannot read the side table");
+    return ncclSystemError;
+  }
+  *out = gdakiRsLogPause();
+  out->head = h.head;
+  out->nqp = n;
+  bool on = true;
+  uint64_t ovf[NCCL_GIN_RECOVERY_MAX_QPS], gets[NCCL_GIN_RECOVERY_MAX_QPS], msgs[NCCL_GIN_RECOVERY_MAX_QPS];
+  for (int k = 0; k < n; k++) {
+    const struct ncclGinRsQp& q = v[(size_t)idx[k]];
+    out->msgs[k] = msgs[k] = q.msgs;
+    out->ovf[k] = ovf[k] = q.ovfCount;
+    out->gets[k] = gets[k] = q.gets;
+    on = on && q.logOn == 1;
+  }
+  if (!on) {  // the read back: a logOn write that did not land is not a log that starts here
+    snprintf(why, whyLen, "logOn of a QP to rank %d did not read back as set", peer);
+    return ncclSystemError;
+  }
+  out->firstPause = gdakiRsLogStateNotePause(&lh->st, idx, n, h.head, ovf, gets, msgs) > 0;
+  out->logComplete = true;
+  lh->st.headSeen.store(h.head, std::memory_order_relaxed);
+  return ncclSuccess;
+}
+static ncclResult_t gdakiRsLogStable(struct gdakiRecHost* r, int peer, const struct gdakiRsLogPause* atPause,
+                                     char* why, size_t whyLen) {
+  if (!gdakiRsLogReady(r)) return gdakiRsLogNotReady(why, whyLen);
+  struct gdakiRsLogHost* lh = r->rsLog;
+  int idx[NCCL_GIN_RECOVERY_MAX_QPS];
+  const int n = gdakiRsQpsOfPeer(r, peer, idx);
+  if (n != atPause->nqp) {
+    snprintf(why, whyLen, "rank %d has %d QPs, the pause record %d", peer, n, atPause->nqp);
+    return ncclInvalidUsage;
+  }
+  struct ncclGinRsSide h;
+  std::vector<struct ncclGinRsQp> v;
+  const char* w = nullptr;
+  if (!gdakiRsReadSide(r, &h, &v, &w)) {
+    snprintf(why, whyLen, "%s", w ? w : "cannot read the side table");
+    return ncclSystemError;
+  }
+  struct gdakiRsPauseSnap at[NCCL_GIN_RECOVERY_MAX_QPS];
+  uint64_t ovfNow[NCCL_GIN_RECOVERY_MAX_QPS];
+  for (int k = 0; k < n; k++) {
+    at[k].head = atPause->head;
+    at[k].ovf = atPause->ovf[k];
+    at[k].gets = atPause->gets[k];
+    at[k].valid = true;
+    ovfNow[k] = v[(size_t)idx[k]].ovfCount;
+  }
+  const int broke = gdakiRsLogStateNoteStable(&lh->st, idx, n, at, ovfNow);
+  if (broke > 0) gdakiRsLogDisarmOnce(lh, peer);
+  lh->st.headSeen.store(h.head, std::memory_order_relaxed);
+  const bool trimmed = gdakiRsLogTrim(r, h.head) == ncclSuccess;
+  if (broke > 0) {  // the caller does not arm the peer on this checkpoint (review of work package 6, finding 2)
+    snprintf(why, whyLen, "the log toward rank %d lost an operation (ring full) after this checkpoint's pause: not armable",
+             peer);
+    return ncclInvalidUsage;
+  }
+  if (!trimmed) {
+    snprintf(why, whyLen, "the tail could not be moved over the NIC copy path (it is kept; the next trim retries)");
+    return ncclSystemError;
+  }
+  return ncclSuccess;
+}
+static ncclResult_t gdakiRsLogReadHead(struct gdakiRecHost* r, uint64_t* head) {
+  if (!gdakiRsLogReady(r)) return ncclInvalidUsage;
+  struct ncclGinRsSide h;
+  if (!gdakiRsReadSide(r, &h, nullptr)) return ncclSystemError;
+  *head = h.head;
+  r->rsLog->st.headSeen.store(h.head, std::memory_order_relaxed);
+  return ncclSuccess;
+}
+static ncclResult_t gdakiRsLogReadHeadApp(struct gdakiRecHost* r, uint64_t* head) {
+  if (!gdakiRsLogReady(r)) return ncclInvalidUsage;
+  struct gdakiRsLogHost* lh = r->rsLog;
+  std::lock_guard<std::mutex> lk(lh->appMu);
+  int dev = -1;  // the context's device for this thread's calls, then the thread's own back (review of package 6, note 7)
+  if (cudaGetDevice(&dev) != cudaSuccess || (dev != r->ctx->cuda_id && cudaSetDevice(r->ctx->cuda_id) != cudaSuccess))
+    return ncclUnhandledCudaError;
+  struct DevBack {
+    int d, want;
+    ~DevBack() { if (d != want) (void)cudaSetDevice(d); }
+  } back{dev, r->ctx->cuda_id};
+  if (lh->appStream == nullptr && cudaStreamCreateWithFlags(&lh->appStream, cudaStreamNonBlocking) != cudaSuccess) {
+    lh->appStream = nullptr;
+    return ncclUnhandledCudaError;
+  }
+  uint64_t v = 0;
+  if (cudaMemcpyAsync(&v, &((struct ncclGinRsSide*)r->rsBase)->head, sizeof(v), cudaMemcpyDeviceToHost, lh->appStream) !=
+        cudaSuccess ||
+      cudaStreamSynchronize(lh->appStream) != cudaSuccess)
+    return ncclUnhandledCudaError;
+  *head = v;
+  return ncclSuccess;
+}
+// The per-QP field `f` of the QPs to `peer` (helper).
+template <typename F>
+static ncclResult_t gdakiRsLogReadQpField(struct gdakiRecHost* r, int peer, uint64_t* vals, int* nqp, F f) {
+  if (!gdakiRsLogReady(r)) return ncclInvalidUsage;
+  int idx[NCCL_GIN_RECOVERY_MAX_QPS];
+  const int n = gdakiRsQpsOfPeer(r, peer, idx);
+  struct ncclGinRsSide h;
+  std::vector<struct ncclGinRsQp> v;
+  if (!gdakiRsReadSide(r, &h, &v)) return ncclSystemError;
+  for (int k = 0; k < n; k++) vals[k] = f(v[(size_t)idx[k]]);
+  *nqp = n;
+  return ncclSuccess;
+}
+static ncclResult_t gdakiRsLogReadMsgs(struct gdakiRecHost* r, int peer, uint64_t* msgs, int* nqp) {
+  return gdakiRsLogReadQpField(r, peer, msgs, nqp, [](const struct ncclGinRsQp& q) { return (uint64_t)q.msgs; });
+}
+static ncclResult_t gdakiRsLogReadSuppress(struct gdakiRecHost* r, int peer, uint64_t* left, int* nqp) {
+  return gdakiRsLogReadQpField(r, peer, left, nqp, [](const struct ncclGinRsQp& q) { return (uint64_t)q.suppress; });
+}
+static ncclResult_t gdakiRsLogReadGets(struct gdakiRecHost* r, int peer, uint64_t* gets, int* nqp) {
+  return gdakiRsLogReadQpField(r, peer, gets, nqp, [](const struct ncclGinRsQp& q) { return (uint64_t)q.gets; });
+}
+static uint64_t gdakiRsLogCoveredUpTo(struct gdakiRecHost* r) {
+  return gdakiRsLogReady(r) ? r->rsLog->st.coveredUpTo.load(std::memory_order_acquire) : GDAKI_RS_POS_INF;
+}
+// The number of user transparent-recovery GDAKI contexts of this communicator (their setup decisions; Resume counted the
+// same at its call): one ring per context is one ring per rank only while it is one (9.10.4).
+static int gdakiRsUserCtxCount(void* comm) {
+  std::lock_guard<std::mutex> lk(gdakiRsRegMu);
+  int n = 0;
+  for (const auto& x : gdakiRsReg)
+    if (x.comm == comm && x.setup && x.handle != nullptr) n++;
+  return n;
+}
+// gdakiRsLogPoll (the host branch's helper step, every 10 ms; nobody else calls it): the counts (overflow, gets) of every
+// QP that may log, a second user context, the tail's advance and an occupancy sample. Peers to DISARM go to *broke, each
+// once per cause.
+static ncclResult_t gdakiRsLogPoll(struct gdakiRecHost* r, std::vector<int>* broke) {
+  if (!gdakiRsLogReady(r)) return ncclInvalidUsage;
+  // nothing is logged before ncclGinRestoreResume published the side table: no NIC read (review of the trap removal,
+  // note 6; a hold process that never enables the restore pays no helper reads)
+  if (!r->rsPublished.load(std::memory_order_acquire)) return ncclSuccess;
+  struct gdakiRsLogHost* lh = r->rsLog;
+  const int nranks = r->nranks > 0 ? r->nranks : 1;
+  struct ncclGinRsSide h;
+  std::vector<struct ncclGinRsQp> v;
+  if (!gdakiRsReadSide(r, &h, &v)) return ncclSystemError;  // the DISARM list is kept for the next call
+  gdakiRsSuppressLines(r, v, false);  // work package 9: a spare's budget its replay used up
+  {
+    for (int i = 0; i < r->rsNqp; i++) {
+      if (!r->rsLogged[(size_t)i]) continue;
+      bool gotGet = false;
+      if (gdakiRsLogStateNoteCounts(&lh->st, i, v[(size_t)i].ovfCount, v[(size_t)i].gets, &gotGet) || gotGet)
+        gdakiRsLogDisarmOnce(lh, i % nranks);
+    }
+    lh->st.headSeen.store(h.head, std::memory_order_relaxed);
+    if (gdakiRsLogTrim(r, h.head) != ncclSuccess) lh->st.trimErrors.fetch_add(1, std::memory_order_relaxed);
+    const uint64_t occ = h.head >= lh->st.tail ? h.head - lh->st.tail : 0;
+    lh->st.samples.fetch_add(1, std::memory_order_relaxed);
+    lh->st.occSum.fetch_add(occ, std::memory_order_relaxed);
+    if (occ > lh->st.occMax.load(std::memory_order_relaxed)) lh->st.occMax.store(occ, std::memory_order_relaxed);
+  }
+  if (!lh->userCtxReported && gdakiRsUserCtxCount(r->commKey) > 1) {  // a second user context after Resume
+    lh->userCtxReported = true;
+    GIN_TS_NOTE("GIN/RS: rank %d: a second user transparent-recovery GDAKI context on this communicator: the send-side log "
+                "is no longer one ring per rank; every peer is reported for DISARM", r->ctx ? r->ctx->rank : -1);
+    for (int p = 0; p < nranks; p++)
+      if (r->ctx == nullptr || p != r->ctx->rank) gdakiRsLogDisarmOnce(lh, p);
+  }
+  for (int p : lh->disarm) broke->push_back(p);  // delivered with ncclSuccess only (the caller reads it then)
+  lh->disarm.clear();
+  return ncclSuccess;
+}
+static bool gdakiRsLogComplete(struct gdakiRecHost* r, int peer) {
+  return gdakiRsLogReady(r) && gdakiRsLogStateComplete(&r->rsLog->st, peer);
+}
+static ncclResult_t gdakiRsLogCollect(struct gdakiRecHost* r, int peer, uint64_t from, uint64_t to,
+                                      std::vector<struct ncclGinRsLogEntry>* out, char* why, size_t whyLen) {
+  if (!gdakiRsLogReady(r)) return gdakiRsLogNotReady(why, whyLen);
+  struct gdakiRsLogHost* lh = r->rsLog;
+  int idx[NCCL_GIN_RECOVERY_MAX_QPS];
+  const int n = gdakiRsQpsOfPeer(r, peer, idx);
+  struct ncclGinRsSide h;
+  std::vector<struct ncclGinRsQp> v;
+  if (!gdakiRsReadSide(r, &h, &v)) {
+    snprintf(why, whyLen, "cannot read the side table");
+    return ncclSystemError;
+  }
+  uint64_t ovfNow[NCCL_GIN_RECOVERY_MAX_QPS], getsNow[NCCL_GIN_RECOVERY_MAX_QPS];
+  for (int k = 0; k < n; k++) {
+    ovfNow[k] = v[(size_t)idx[k]].ovfCount;
+    getsNow[k] = v[(size_t)idx[k]].gets;
+  }
+  char cw[160];
+  if (!gdakiRsLogStateCanExport(&lh->st, idx, n, from, ovfNow, getsNow, cw, sizeof(cw))) {  // complete since `from`, now
+    snprintf(why, whyLen, "the log toward rank %d is not complete from position %lu: %s", peer, (unsigned long)from, cw);
+    return ncclInvalidUsage;
+  }
+  if (to > h.head || to < from) {
+    snprintf(why, whyLen, "positions [%lu, %lu) are not all in the ring (head %lu, tail %lu)", (unsigned long)from,
+             (unsigned long)to, (unsigned long)h.head, (unsigned long)lh->st.tail);
+    return ncclInvalidUsage;
+  }
+  out->clear();  // empty when the tail already passed `to` (the peer has no entry there: CanExport passed)
+  const uint64_t chunk = gdakiRsLogChunk(r);
+  for (uint64_t s = std::max(from, lh->st.tail); s < to;) {
+    const uint64_t slot = s & (uint64_t)(lh->st.n - 1);
+    uint64_t e = std::min<uint64_t>(to, s + chunk);
+    if (e > s + (lh->st.n - slot)) e = s + (lh->st.n - slot);
+    const size_t bytes = (size_t)(e - s) * sizeof(struct ncclGinRsLogEntry);
+    if (gdakiLbXfer(r, false, lh->ringDev + slot * sizeof(struct ncclGinRsLogEntry), bytes) != ncclSuccess) {
+      snprintf(why, whyLen, "cannot read the ring over the NIC copy path");
+      return ncclSystemError;
+    }
+    std::vector<uint64_t> ids((size_t)(e - s));
+    for (uint64_t p = s; p < e; p++)
+      memcpy(&ids[(size_t)(p - s)], r->pinned + (size_t)(p - s) * sizeof(struct ncclGinRsLogEntry), 8);
+    for (uint64_t p : gdakiRsLogStatePeerPositions(&lh->st, peer, s, e, ids.data())) {  // the tested filter
+      struct ncclGinRsLogEntry en;
+      memcpy(&en, r->pinned + (size_t)(p - s) * sizeof(en), sizeof(en));
+      out->push_back(en);
+    }
+    s = e;
+  }
+  return ncclSuccess;
+}
+static void gdakiRsLogOccupancy(struct gdakiRecHost* r, struct gdakiRsLogOcc* out) {
+  *out = gdakiRsLogOcc();
+  if (!gdakiRsLogReady(r)) return;
+  const struct gdakiRsLogState& s = r->rsLog->st;
+  out->nEntries = s.n;
+  out->samples = s.samples.load(std::memory_order_relaxed);
+  out->occSum = s.occSum.load(std::memory_order_relaxed);
+  out->occMax = s.occMax.load(std::memory_order_relaxed);
+  out->trims = s.trims.load(std::memory_order_relaxed);
+  out->tail = s.tailNow.load(std::memory_order_relaxed);
+  out->headSeen = s.headSeen.load(std::memory_order_relaxed);
+  out->blockedPending = s.blockedPending.load(std::memory_order_relaxed);
+}
+static uint64_t gdakiRsWinGoneCount(struct gdakiRecHost* r) {
+  if (r == nullptr || r->ctx == nullptr || !r->rsPtrSet) return 0;
+  std::lock_guard<std::mutex> lk(gdakiRsWinMu);
+  uint64_t n = 0;
+  for (const auto& w : gdakiRsWins)
+    if (w.coll == (void*)r->ctx->collComm && w.gone && w.goneSeq > r->rsWinSeq) n++;
+  return n;
+}
+// ---- work package 9 (EXPERIMENT.md 9.3, 9.6, 9.11.3 M2): the executed counts, the spare's suppress budgets and their
+// line, the plan that re-posts nothing, the log export and the spare's import. The pure parts are in the region above
+// ("log, suppress and replay, pure"). Wiring the other regions need (impl/notes_dev.md, integration): G7's hold body calls
+// gdakiRsExecObserve with the watch's rmsn; gdakiTsExecuted calls it with every rmsn it reads, gdakiTsBaseline calls
+// gdakiRsExecRebase with the rmsn0 it sets (in a process without the log both return at once). ----
+// impl/rs_ckpt_api.h's P record. The host branch's shared text defines it (with GDAKI_CKPT_MAGIC) before this region; this
+// branch alone has no checkpoint code, so the same record stands here for the import's signature (integration: removed).
+#ifndef GDAKI_CKPT_MAGIC
+struct gdakiCkptPeerP {
+  int32_t rank;
+  uint32_t nqp;
+  uint64_t p[64];
+};
+#endif
+static void gdakiRsExecObserve(struct gdakiRecHost* r, int qpIdx, uint32_t rmsn) {
+  if (!gdakiRsLogReady(r)) return;
+  struct gdakiRsLogHost* lh = r->rsLog;
+  std::lock_guard<std::mutex> lk(lh->execMu);
+  if (qpIdx >= 0 && qpIdx < (int)lh->exec.size()) gdakiRsExecStepQp(lh->exec[(size_t)qpIdx], rmsn);
+}
+static void gdakiRsExecRebase(struct gdakiRecHost* r, int qpIdx, uint32_t rmsn0) {
+  if (!gdakiRsLogReady(r)) return;
+  struct gdakiRsLogHost* lh = r->rsLog;
+  std::lock_guard<std::mutex> lk(lh->execMu);
+  if (qpIdx >= 0 && qpIdx < (int)lh->exec.size()) gdakiRsExecRebaseQp(lh->exec[(size_t)qpIdx], rmsn0);
+}
+static void gdakiRsExecInvalidate(struct gdakiRecHost* r, int qpIdx) {
+  if (!gdakiRsLogReady(r)) return;
+  struct gdakiRsLogHost* lh = r->rsLog;
+  std::lock_guard<std::mutex> lk(lh->execMu);
+  if (qpIdx >= 0 && qpIdx < (int)lh->exec.size()) lh->exec[(size_t)qpIdx].bad = true;
+}
+// One QUERY_QP per QP to the peer, under opMu as the watch's (the caller must not hold it), outside the firmware guard; the
+// reads are folded under opMu too, so they fold in the order they were taken with the watch's (review of work package 9,
+// note 4).
+static ncclResult_t gdakiRsExecRead(struct gdakiRecHost* r, int peer, uint64_t* cum, int* nqp) {
+  if (!gdakiRsLogReady(r)) return ncclInvalidUsage;
+  struct gdakiRsLogHost* lh = r->rsLog;
+  int idx[NCCL_GIN_RECOVERY_MAX_QPS];
+  const int n = gdakiRsQpsOfPeer(r, peer, idx);
+  if (n == 0) return ncclInvalidUsage;
+  uint32_t rmsn[NCCL_GIN_RECOVERY_MAX_QPS];
+  std::lock_guard<std::mutex> op(r->opMu);  // QUERY_QP never overlaps a QP state change (see gdakiTsQuiesce)
+  for (int k = 0; k < n; k++) {
+    struct doca_gpu_verbs_qp_hl* q = r->ctx->gqps[idx[k]];
+    if (q == nullptr || doca_verbs_qp_query_seq(q->qp, &rmsn[k], nullptr, nullptr, nullptr) != DOCA_SUCCESS)
+      return ncclSystemError;
+  }
+  std::lock_guard<std::mutex> lk(lh->execMu);
+  bool bad = false;
+  for (int k = 0; k < n; k++) {
+    struct gdakiRsExecQp& e = lh->exec[(size_t)idx[k]];
+    gdakiRsExecStepQp(e, rmsn[k]);
+    cum[k] = e.cum;
+    bad = bad || e.bad;
+  }
+  *nqp = n;
+  return bad ? ncclInvalidUsage : ncclSuccess;  // a lost read: this peer is not restored on this count
+}
+static void gdakiRsExecSetBase(struct gdakiRecHost* r, int qpIdx, uint64_t cum) {
+  if (!gdakiRsLogReady(r)) return;
+  struct gdakiRsLogHost* lh = r->rsLog;
+  std::lock_guard<std::mutex> lk(lh->execMu);
+  if (qpIdx >= 0 && qpIdx < (int)lh->exec.size()) lh->exec[(size_t)qpIdx].cum = cum;
+}
+// The application thread's CUDA access (the spare's import): the context's device for the call (the thread's own back
+// at the guard's end) and the log state's own non-blocking stream. lh->appMu held by the caller.
+struct gdakiRsDevGuard {
+  int d = -1, want = -1;
+  ~gdakiRsDevGuard() {
+    if (d >= 0 && d != want) (void)cudaSetDevice(d);
+  }
+};
+static bool gdakiRsAppStream(struct gdakiRecHost* r, struct gdakiRsDevGuard* g) {
+  struct gdakiRsLogHost* lh = r->rsLog;
+  if (cudaGetDevice(&g->d) != cudaSuccess) {
+    g->d = -1;
+    return false;
+  }
+  g->want = r->ctx->cuda_id;
+  if (g->d != g->want && cudaSetDevice(g->want) != cudaSuccess) return false;
+  if (lh->appStream == nullptr && cudaStreamCreateWithFlags(&lh->appStream, cudaStreamNonBlocking) != cudaSuccess) {
+    lh->appStream = nullptr;
+    return false;
+  }
+  return true;
+}
+// msgs = X and suppress = B of the QPs idx[0..n) (16 bytes each, then read back), and the budgets for the suppress line.
+// lh->appMu held, the stream set up (gdakiRsAppStream).
+static ncclResult_t gdakiRsSuppressWrite(struct gdakiRecHost* r, const int* idx, int n, const uint64_t* x,
+                                         const uint64_t* b, char* why, size_t whyLen) {
+  struct gdakiRsLogHost* lh = r->rsLog;
+  uint64_t v[NCCL_GIN_RECOVERY_MAX_QPS][2], back[NCCL_GIN_RECOVERY_MAX_QPS][2];
+  bool ok = true;
+  for (int k = 0; k < n; k++) {
+    v[k][0] = x[k];
+    v[k][1] = b[k];
+    ok = ok && cudaMemcpyAsync(&gdakiRsQpDev(r, idx[k])->msgs, v[k], sizeof(v[k]), cudaMemcpyHostToDevice,
+                               lh->appStream) == cudaSuccess;
+  }
+  for (int k = 0; k < n; k++)
+    ok = ok && cudaMemcpyAsync(back[k], &gdakiRsQpDev(r, idx[k])->msgs, sizeof(back[k]), cudaMemcpyDeviceToHost,
+                               lh->appStream) == cudaSuccess;
+  ok = ok && cudaStreamSynchronize(lh->appStream) == cudaSuccess;
+  for (int k = 0; ok && k < n; k++) ok = back[k][0] == v[k][0] && back[k][1] == v[k][1];
+  if (!ok) {
+    snprintf(why, whyLen, "the suppress budgets could not be written to the side table");
+    return ncclUnhandledCudaError;
+  }
+  std::lock_guard<std::mutex> el(lh->execMu);
+  for (int k = 0; k < n; k++) {
+    lh->budget[(size_t)idx[k]] = b[k];
+    lh->budgetSet[(size_t)idx[k]] = 1;
+    lh->budgetSaid[(size_t)idx[k]] = 0;
+  }
+  return ncclSuccess;
+}
+static ncclResult_t gdakiRsSuppressSet(struct gdakiRecHost* r, int peer, const uint64_t* x, const uint64_t* p, int nqp,
+                                       char* why, size_t whyLen) {
+  if (!gdakiRsLogReady(r)) return gdakiRsLogNotReady(why, whyLen);
+  struct gdakiRsLogHost* lh = r->rsLog;
+  int idx[NCCL_GIN_RECOVERY_MAX_QPS];
+  const int n = gdakiRsQpsOfPeer(r, peer, idx);
+  if (n == 0 || n != nqp) {
+    snprintf(why, whyLen, "rank %d has %d QPs here, %d counts given", peer, n, nqp);
+    return ncclInvalidUsage;
+  }
+  uint64_t b[NCCL_GIN_RECOVERY_MAX_QPS];
+  for (int k = 0; k < n; k++)
+    if (!gdakiRsBudgetOf(x[k], p[k], &b[k])) {
+      snprintf(why, whyLen, "qp %d: X %lu is below P %lu", idx[k], (unsigned long)x[k], (unsigned long)p[k]);
+      return ncclInvalidUsage;
+    }
+  std::lock_guard<std::mutex> lk(lh->appMu);
+  struct gdakiRsDevGuard g;
+  if (!gdakiRsAppStream(r, &g)) {
+    snprintf(why, whyLen, "no CUDA stream on device %d", r->ctx->cuda_id);
+    return ncclUnhandledCudaError;
+  }
+  return gdakiRsSuppressWrite(r, idx, n, x, b, why, whyLen);
+}
+// The suppress line (its format is fixed for the test branch, impl/notes_dev.md): one WARN per QP whose budget the spare
+// set, once its replay used it (left 0; the helper's gdakiRsLogPoll) or at the context's end (what is left). qp is the
+// side table's QP index (context x nranks + peer).
+static void gdakiRsSuppressLines(struct gdakiRecHost* r, const std::vector<struct ncclGinRsQp>& v, bool atClose) {
+  if (r == nullptr || r->rsLog == nullptr) return;
+  struct gdakiRsLogHost* lh = r->rsLog;
+  const int nranks = r->nranks > 0 ? r->nranks : 1;
+  std::lock_guard<std::mutex> el(lh->execMu);
+  for (size_t i = 0; i < lh->budgetSet.size() && i < v.size(); i++) {
+    if (!lh->budgetSet[i] || lh->budgetSaid[i]) continue;
+    const uint64_t left = v[i].suppress;
+    if (left != 0 && !atClose) continue;
+    lh->budgetSaid[i] = 1;
+    const uint64_t B = lh->budget[i], L = std::min(left, B);
+    WARN("GIN/RS: rank %d: suppress peer=%d qp=%zu budget=%lu suppressed=%lu left=%lu", r->ctx ? r->ctx->rank : -1,
+         (int)(i % (size_t)nranks), i, (unsigned long)B, (unsigned long)(B - L), (unsigned long)L);
+  }
+}
+static ncclResult_t gdakiRsLogReadGetRefused(struct gdakiRecHost* r, int peer, uint64_t* refused, int* nqp) {
+  return gdakiRsLogReadQpField(r, peer, refused, nqp, [](const struct ncclGinRsQp& q) { return (uint64_t)q.getRefused; });
+}
+// The plan that counts every WQE of the ending epoch executed (RL8; the dead rank's spare starts from the checkpoint and
+// the survivor's entries since the cut are applied to it, so nothing is re-posted): U = S, n = 0 per QP of the round's
+// scope, after the checks gdakiTsRepostPlanAll makes before it plans.
+static ncclResult_t gdakiRsPlanAllExecuted(struct gdakiRecHost* r, int peer, std::vector<struct gdakiTsRepostPlan>& plans,
+                                           const char** why) {
+  plans.clear();
+  if (r->ts == nullptr) {
+    *why = "transparent recovery is off";
+    return ncclInvalidUsage;
+  }
+  if (r->ts->surfaced.load(std::memory_order_acquire)) {  // as gdakiTsRepostPlanAll
+    *why = "the watchdog surfaced the fault before the commit point";
+    return ncclSystemError;
+  }
+  if (r->ts->stop.load(std::memory_order_acquire)) {
+    *why = "the communicator is being destroyed";
+    return ncclSystemError;
+  }
+  if (gdakiUaPeerRaised(r, peer)) {
+    *why = "the device waits on the peer were already released";
+    return ncclSystemError;
+  }
+  gdakiRecForPeer(r, peer, [&](gdakiRecQp& rq, struct doca_gpu_verbs_qp_hl* q) {
+    struct gdakiTsRepostPlan pl;
+    pl.rq = &rq;
+    pl.q = q;
+    pl.S = rq.epochWqes;
+    pl.U = pl.S;
+    pl.n = 0;
+    pl.ringN = rq.snap.sq_wqe_num;
+    pl.mask = rq.snap.sq_wqe_mask;
+    pl.laps = r->ts->qs[rq.qpIdx].rescue ? r->ts->rescueLaps : 0;
+    plans.push_back(std::move(pl));
+  });
+  if (plans.empty()) {
+    *why = "no QP to the peer in this round";
+    return ncclInvalidUsage;
+  }
+  GIN_TS_NOTE("GIN/RS: rank %d: re-post plan to rank %d: %u qp(s), every WQE of the ending epoch counted executed (U = S, "
+              "n = 0) mono_ms=%.3f", r->ctx->rank, peer, (unsigned)plans.size(), gdakiQ4MonoMs());
+  return ncclSuccess;
+}
+// The export (helper; the survivor's STATE toward the restored rank's spare). The entries come from gdakiRsLogCollect
+// (refused when the log is not whole since `cut`); their messages per QP must equal m (at the hold start) minus M at the
+// cut's pause; each put's source is read over the NIC copy path in chunks of the staging buffer, under the window
+// registry's lock, its window still registered (a deregistration waits for the chunk: gdakiRsWinGone takes the lock).
+// Returns ncclSuccess with a whole OK stream; ncclInvalidUsage (why) when the export is refused before the stream or the
+// stream ends with ok = 0 ("source buffer changed", a source gone); ncclSystemError when the stream or a read failed.
+static ncclResult_t gdakiRsLogExport(struct gdakiRecHost* r, int peer, uint64_t ckpt, uint64_t cut, uint64_t head,
+                                     uint32_t incarnation, const uint64_t* x, const uint64_t* m, int nqp,
+                                     bool (*put)(void* arg, const void* p, size_t n), void* arg, char* why,
+                                     size_t whyLen) {
+  if (!gdakiRsLogReady(r)) return gdakiRsLogNotReady(why, whyLen);
+  struct gdakiRsLogHost* lh = r->rsLog;
+  int idx[NCCL_GIN_RECOVERY_MAX_QPS];
+  const int n = gdakiRsQpsOfPeer(r, peer, idx);
+  if (n == 0 || n != nqp || r->ts == nullptr || put == nullptr) {
+    snprintf(why, whyLen, "rank %d has %d QPs here, %d counts given", peer, n, nqp);
+    return ncclInvalidUsage;
+  }
+  std::vector<struct ncclGinRsLogEntry> ents;
+  const ncclResult_t rc = gdakiRsLogCollect(r, peer, cut, head, &ents, why, whyLen);
+  if (rc != ncclSuccess) return rc;
+  uint64_t mCut[NCCL_GIN_RECOVERY_MAX_QPS];
+  for (int k = 0; k < n; k++)
+    if (!gdakiRsLogStateMsgsAt(&lh->st, idx[k], cut, &mCut[k])) {
+      snprintf(why, whyLen, "qp %d: no message count kept for the pause at position %lu", idx[k], (unsigned long)cut);
+      return ncclInvalidUsage;
+    }
+  char cw[200];
+  if (!gdakiRsLogXMsgsCheck(ents.data(), ents.size(), idx, n, m, mCut, cw, sizeof(cw))) {
+    snprintf(why, whyLen, "the log toward rank %d is not whole: %s", peer, cw);
+    return ncclInvalidUsage;
+  }
+  struct gdakiRsLogXHdr hdr;
+  memset(&hdr, 0, sizeof(hdr));
+  hdr.magic = GDAKI_RS_LOGX_MAGIC;
+  hdr.version = 1;
+  hdr.from = r->ctx->rank;
+  hdr.to = peer;
+  hdr.incarnation = incarnation;
+  hdr.nqp = (uint32_t)n;
+  hdr.nonce = r->ts->nonce;
+  hdr.ckpt = ckpt;
+  hdr.cut = cut;
+  hdr.head = head;
+  hdr.nEntries = ents.size();
+  for (int k = 0; k < n; k++) {
+    hdr.x[k] = x[k];
+    hdr.m[k] = m[k];
+  }
+  void* const coll = (void*)r->ctx->collComm;
+  uint64_t dataBytes = 0;
+  bool readFailed = false;
+  auto read = [&](const struct ncclGinRsLogEntry& e, uint64_t off, uint64_t len, const char** bad) -> const uint8_t* {
+    std::lock_guard<std::mutex> lk(gdakiRsWinMu);
+    const struct gdakiRsWin* w = nullptr;
+    for (const auto& c : gdakiRsWins)
+      if (c.coll == coll && !c.gone && c.id == e.srcWin) w = &c;
+    const uint64_t size = w ? (uint64_t)(w->hi - w->lo) : 0;
+    if (w == nullptr) *bad = "its source window is no longer registered";
+    else if (e.src > size || off > size - e.src || len > size - e.src - off) *bad = "its source range is outside its window";
+    else if (!gdakiLbOn(r) || gdakiLbXfer(r, false, (const void*)(w->lo + e.src + off), (size_t)len) != ncclSuccess) {
+      *bad = "its source could not be read over the NIC copy path";
+      readFailed = true;
+    } else {
+      dataBytes += len;
+      return r->pinned;
+    }
+    return nullptr;
+  };
+  auto putf = [&](const void* p, size_t k) { return put(arg, p, k); };
+  const uint64_t chunk = std::min<uint64_t>((uint64_t)r->pinnedSize, 1ull << 20);
+  const int b = gdakiRsLogXBuild(hdr, ents.data(), ents.size(), chunk, read, putf, why, whyLen);
+  GIN_TS_NOTE("GIN/RS: rank %d: log export to rank %d: checkpoint=%lu cut=%lu head=%lu entries=%zu data_bytes=%lu "
+              "incarnation=%u verdict=%s%s%s mono_ms=%.3f", r->ctx->rank, peer, (unsigned long)ckpt, (unsigned long)cut,
+              (unsigned long)head, ents.size(),
+              (unsigned long)dataBytes, incarnation,
+              b == GDAKI_RS_LOGX_OK ? "ok" : b == GDAKI_RS_LOGX_REFUSED ? "refused" : "stream_failed",
+              b == GDAKI_RS_LOGX_OK ? "" : " why=", b == GDAKI_RS_LOGX_OK ? "" : why, gdakiQ4MonoMs());
+  if (b == GDAKI_RS_LOGX_OK) return ncclSuccess;
+  return (b == GDAKI_RS_LOGX_REFUSED && !readFailed) ? ncclInvalidUsage : ncclSystemError;
+}
+// The spare's import (the application thread, inside the spare's ncclGinRestoreResume after its image is written and
+// before its kernels and its helper start). Every export is checked first (gdakiRsImportPlanOf); then, with the window
+// registry's lock held (the windows stay registered while their memory is written), the copies and the signal additions
+// on the log state's stream, the suppress budgets and counts (msgs = X, suppress = X - P), and the responder counts' base
+// (M). Refused with nothing applied when a check fails; refused part way (the restore falls back) when a copy fails.
+static ncclResult_t gdakiRsSpareImport(struct gdakiRecHost* r, const struct gdakiCkptPeerP* peerP, uint32_t nPeers,
+                                       const std::vector<std::vector<uint8_t>>& exports, uint64_t ckpt,
+                                       uint32_t incarnation, char* why, size_t whyLen) {
+  if (!gdakiRsLogReady(r)) return gdakiRsLogNotReady(why, whyLen);
+  struct gdakiRsLogHost* lh = r->rsLog;
+  if (r->ts == nullptr || r->nranks <= 0 || (peerP == nullptr && nPeers != 0)) {
+    snprintf(why, whyLen, "no transparent recovery state, or no P records");
+    return ncclInvalidUsage;
+  }
+  const int nranks = r->nranks, me = r->ctx->rank;
+  std::vector<int> nqpOf((size_t)nranks, 0);
+  for (int q = 0; q < nranks; q++) {
+    int idx[NCCL_GIN_RECOVERY_MAX_QPS];
+    nqpOf[(size_t)q] = q == me ? 0 : gdakiRsQpsOfPeer(r, q, idx);
+  }
+  std::vector<struct gdakiRsImportP> pp;
+  for (uint32_t i = 0; i < nPeers; i++) {
+    if (peerP[i].nqp > NCCL_GIN_RECOVERY_MAX_QPS) {
+      snprintf(why, whyLen, "rank %d's P record has %u QPs", peerP[i].rank, peerP[i].nqp);
+      return ncclInvalidUsage;
+    }
+    pp.push_back({peerP[i].rank, peerP[i].nqp, peerP[i].p});
+  }
+  void* const coll = (void*)r->ctx->collComm;
+  std::lock_guard<std::mutex> wl(gdakiRsWinMu);  // held until the copies are done
+  std::vector<struct gdakiRsImportWin> wins;
+  std::vector<uintptr_t> base;
+  for (const auto& w : gdakiRsWins)
+    if (w.coll == coll && !w.gone && w.id != 0) {
+      wins.push_back({w.id, (uint64_t)(w.hi - w.lo)});
+      base.push_back(w.lo);
+    }
+  uint8_t* sigBase = nullptr;
+  uint64_t sigBytes = 0;
+  if (r->ctx->signals_table != nullptr) {
+    sigBase = (uint8_t*)r->ctx->signals_table->gpu_ptr;
+    sigBytes = sigBase ? (uint64_t)r->ctx->signals_table->buffer_bytes() : 0;
+  }
+  struct gdakiRsImportPlan plan;
+  char pw[256];
+  if (!gdakiRsImportPlanOf(me, ckpt, incarnation, r->ts->nonce, nqpOf.data(), nranks, pp.data(), (int)pp.size(), exports,
+                           wins.data(), (int)wins.size(), sigBytes, &plan, pw, sizeof(pw))) {
+    snprintf(why, whyLen, "the log import was refused, nothing applied: %s", pw);
+    return ncclInvalidUsage;
+  }
+  auto addrOf = [&](uint32_t win, uint64_t off) -> uint8_t* {
+    if (win == 0) return sigBase + off;
+    for (size_t i = 0; i < wins.size(); i++)
+      if (wins[i].id == win) return (uint8_t*)base[i] + off;
+    return nullptr;  // not reached: the plan checked every target
+  };
+  std::lock_guard<std::mutex> al(lh->appMu);
+  struct gdakiRsDevGuard g;
+  if (!gdakiRsAppStream(r, &g)) {
+    snprintf(why, whyLen, "the log import was refused, nothing applied: no CUDA stream on device %d", r->ctx->cuda_id);
+    return ncclUnhandledCudaError;
+  }
+  // the image's copies (pageable cudaMemcpy may return before its DMA lands) are done before anything is read or written
+  // here, on a stream that is not ordered after them (review of work package 9, S1); the spare runs no kernel yet
+  if (cudaDeviceSynchronize() != cudaSuccess) {
+    snprintf(why, whyLen, "the log import was refused, nothing applied: the device did not synchronize");
+    return ncclUnhandledCudaError;
+  }
+  cudaStream_t st = lh->appStream;
+  bool ok = true;
+  for (const auto& c : plan.copies)
+    ok = ok && cudaMemcpyAsync(addrOf(c.win, c.off), c.data ? (const void*)c.data : (const void*)&c.value, (size_t)c.bytes,
+                               cudaMemcpyHostToDevice, st) == cudaSuccess;
+  std::vector<uint64_t> cur(plan.sigs.size(), 0);
+  for (size_t i = 0; i < plan.sigs.size(); i++)
+    ok = ok && cudaMemcpyAsync(&cur[i], addrOf(plan.sigs[i].win, plan.sigs[i].off), sizeof(uint64_t),
+                               cudaMemcpyDeviceToHost, st) == cudaSuccess;
+  ok = ok && cudaStreamSynchronize(st) == cudaSuccess;
+  for (size_t i = 0; ok && i < plan.sigs.size(); i++) {
+    cur[i] += plan.sigs[i].add;
+    ok = cudaMemcpyAsync(addrOf(plan.sigs[i].win, plan.sigs[i].off), &cur[i], sizeof(uint64_t), cudaMemcpyHostToDevice,
+                         st) == cudaSuccess;
+  }
+  ok = ok && cudaStreamSynchronize(st) == cudaSuccess;
+  if (!ok) {
+    snprintf(why, whyLen, "the log import failed part way (a CUDA copy); the restore falls back");
+    return ncclUnhandledCudaError;
+  }
+  for (const auto& pe : plan.peers) {
+    int idx[NCCL_GIN_RECOVERY_MAX_QPS];
+    const int n = gdakiRsQpsOfPeer(r, pe.rank, idx);
+    char sw[160];
+    if (n != pe.nqp || gdakiRsSuppressWrite(r, idx, n, pe.x, pe.budget, sw, sizeof(sw)) != ncclSuccess) {
+      snprintf(why, whyLen, "the log import failed part way (rank %d's budgets); the restore falls back", pe.rank);
+      return ncclUnhandledCudaError;
+    }
+    for (int k = 0; k < n; k++) gdakiRsExecSetBase(r, idx[k], pe.m[k]);
+  }
+  GIN_TS_NOTE("GIN/RS: rank %d: log import: checkpoint=%lu survivors=%zu entries=%lu data_bytes=%lu copies=%zu "
+              "signal_adds=%lu signal_targets=%zu incarnation=%u", me, (unsigned long)ckpt, plan.peers.size(),
