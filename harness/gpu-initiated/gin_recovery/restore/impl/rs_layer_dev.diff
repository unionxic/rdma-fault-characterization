+          r->ctx->devHandle->handle == key)
+        rFound = r;
+    if (rFound != nullptr && rFound->ts != nullptr) {
+      struct gdakiTs* ts = rFound->ts;
+      in.tsOn = ts->active.load(std::memory_order_acquire) != 0 && ts->dead.load(std::memory_order_acquire) == 0;
+      in.qpwatchMs = ts->detWatchMs;  // set in gdakiTsStart, before the helper ran
+      in.holdMs = ts->holdMs;         // set in gdakiTsSetup
+      in.escalated = ts->escalated.load(std::memory_order_acquire);
+      in.lbOn = rFound->lb != nullptr && __atomic_load_n(&rFound->lb->ok, __ATOMIC_ACQUIRE);
+      // work package 3 (set in gdakiTsStart before the helper ran)
+      in.sideOk = rFound->rsPtrSet;
+      snprintf(sideWhy, sizeof(sideWhy), "%s", rFound->rsSideWhy[0] ? rFound->rsSideWhy : "the process does not ask");
+      in.rsLbOk = rFound->rsLbOk;
+      snprintf(rsLbWhy, sizeof(rsLbWhy), "%s", rFound->rsLbWhy);
