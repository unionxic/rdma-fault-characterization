diff --git a/src/gin/gin_host.cc b/src/gin/gin_host.cc
index 2f8749f..b5f6cbc 100644
--- a/src/gin/gin_host.cc
+++ b/src/gin/gin_host.cc
@@ -14,6 +14,9 @@
 #include "gin/gin_host.h"
 #include "gin/gin_host_proxy.h"
 #include "compiler.h"
+#include "argcheck.h"  // gin-restore (rs): CommCheck for ncclGinRestoreResume
+#include "bootstrap.h"
+#include "group.h"  // gin-restore (rs): ncclGroupJobAbort, as ncclCommEnsureReady
 #include <cmath>
 
 NCCL_PARAM(GinEnable, "GIN_ENABLE", 1);
@@ -606,3 +609,82 @@ ncclResult_t ncclGinQueryLastError(struct ncclGinState* ginState, bool* hasError
   }
   return ncclSuccess;
 }
+
+// ---- gin-restore (rs, work package 2): the public restore API's entry (nccl.h; EXPERIMENT.md 9.10.8, user decisions
+// 2026-10-11 and 2026-10-12) ----
+// The one exception to "restore code only in the GDAKI host file": this entry reads the communicator's and the devComm's
+// facts, gives the GDAKI restore layer the communicator's bootstrap all-gather for the exchange every rank takes part in,
+// and the setter of the communicator's abort flags for an exchange that passes its bound (the bootstrap socket loops end on
+// that flag; the communicator must then be ended with ncclCommAbort). Every judgment and the decision are in
+// transport/net_ib/gdaki/gin_host_gdaki.cc. ncclGinRestoreStep and ncclGinRestoreRegister are there too (not built yet).
+static ncclResult_t ginRestoreExchange(void* c, void* data, int bytesPerRank) {
+  return bootstrapAllGather(((struct ncclComm*)c)->bootstrap, data, bytesPerRank);
+}
+static void ginRestoreAbortComm(void* c) {  // the first step of ncclCommAbort (init.cc setCommAbortFlags)
+  struct ncclComm* comm = (struct ncclComm*)c;
+  // runs on the bound's watcher thread: each pointer is read once (a split may change the child's concurrently)
+  uint32_t* const childFlag = COMPILER_ATOMIC_LOAD(&comm->childAbortFlag, std::memory_order_acquire);
+  uint32_t* const childFlagDev = COMPILER_ATOMIC_LOAD(&comm->childAbortFlagDev, std::memory_order_acquire);
+  if (childFlag != nullptr) COMPILER_ATOMIC_STORE(childFlag, 1u, std::memory_order_release);
+  if (childFlagDev != nullptr) COMPILER_ATOMIC_STORE(childFlagDev, 1u, std::memory_order_release);
+  COMPILER_ATOMIC_STORE(comm->abortFlag, 1u, std::memory_order_release);
+  COMPILER_ATOMIC_STORE(comm->abortFlagDev, 1u, std::memory_order_release);
+}
+NCCL_API(ncclResult_t, ncclGinRestoreResume, ncclComm_t comm, const struct ncclDevComm* devComm, unsigned long long* step,
+         void* blob, size_t* bytes);
+ncclResult_t ncclGinRestoreResume(ncclComm_t comm, const struct ncclDevComm* devComm, unsigned long long* step,
+                                  void* blob, size_t* bytes) {
+  NCCLCHECK(CommCheck(comm, "ncclGinRestoreResume", "comm"));
+  const bool aborted = COMPILER_ATOMIC_LOAD(comm->abortFlag, std::memory_order_acquire) != 0;
+  if (aborted) ncclGroupJobAbort(comm->groupJob);  // as ncclCommEnsureReady: a nonblocking job still running is joined
+  // A communicator whose initialization failed has no usable bootstrap: its error, at once (read after the join above).
+  const ncclResult_t initState = COMPILER_ATOMIC_LOAD(&comm->initState, std::memory_order_acquire);
+  if (initState != ncclSuccess && initState != ncclInProgress) {
+    WARN("ncclGinRestoreResume: the communicator's initialization failed (%s)", ncclGetErrorString(initState));
+    return initState;
+  }
+  // As ncclCommEnsureReady otherwise, but an asynchronous error does not return here: it is this rank's judgment and goes
+  // through the exchange, so every rank returns the same result (an early return would leave the others waiting for the
+  // bound). A failure of the query itself counts as such an error.
+  ncclResult_t asyncErr = ncclSuccess;
+  if (!aborted) {
+    const ncclResult_t q = ncclCommGetAsyncError(comm, &asyncErr);
+    if (q != ncclSuccess) asyncErr = q;
+    if (asyncErr == ncclInProgress) {  // a nonblocking operation still owns the communicator (and its bootstrap)
+      WARN("ncclGinRestoreResume: attempt to use the communicator before the previous operation returned ncclSuccess");
+      return ncclInvalidArgument;
+    }
+  }
+  struct ncclGinRestoreCommFacts f;
+  memset(&f, 0, sizeof(f));
+  f.rank = comm->rank;
+  f.nRanks = comm->nRanks;
+  f.commHash = comm->commHash;
+  f.bootstrap = comm->bootstrap;
+  f.asyncErr = (int)asyncErr;
+  f.argsOk = devComm != nullptr && step != nullptr && bytes != nullptr;
+  // a devComm written for device headers of another NCCL version has another layout (ncclDevCommDestroy converts it):
+  // its other fields are not read here, and the restore is refused
+  f.devCommVersion = devComm != nullptr ? (devComm->magic == NCCL_API_MAGIC ? (int)devComm->version : -1) : 0;
+  const bool layoutOk = devComm != nullptr && f.devCommVersion == NCCL_VERSION_CODE;
+  struct ncclGinState* gs = &comm->sharedRes->ginState;
+  f.commFull = gs->connected && gs->ginConnectionType == NCCL_GIN_CONNECTION_FULL;
+  f.lsaSize = 1;
+  f.ctxStride = 1;
+  if (layoutOk) {
+    f.nConn = std::min<int>(devComm->ginConnectionCount, NCCL_GIN_MAX_CONNECTIONS);
+    for (int c = 0; c < f.nConn; c++) f.handles[c] = devComm->ginHandles[c];
+    if (f.nConn > 0 && devComm->backendIndex < gs->numActiveBackends)
+      f.ginType = (int)gs->backends[devComm->backendIndex].ginType;
+    f.ctxStride = devComm->ginContextStride;
+    f.lsaSize = devComm->lsaSize;
+    if (devComm->resourceWindow != nullptr)  // this rank's address of it, as ncclDevCommCreate computes it (dev_runtime.cc)
+      f.resAddr = add4G(devComm->resourceWindow_inlined.lsaFlatBase,
+                        devComm->lsaRank * (int)devComm->resourceWindow_inlined.stride4G);
+  }
+  f.numRmaCtx = comm->config.numRmaCtx;
+  f.runtimeConn = comm->runtimeConn ? 1 : 0;
+  f.nvls = comm->nvlsSupport ? 1 : 0;
+  f.symGinDevComm = comm->symkState.initialized && comm->symkState.kcomm.devComm.ginConnectionCount > 0;
+  return ncclGinGdakiRestoreResume((void*)comm, &f, ginRestoreExchange, ginRestoreAbortComm, step, blob, bytes);
+}
