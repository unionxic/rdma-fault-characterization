+// The measurement mode (NCCL_GIN_RESTORE_LOG_MEASURE, EXPERIMENT.md 9.5), one helper step: every <ms>, the ring's
+// occupancy (head - tail) is sampled and its tail moved to the head it read, so the ring does not fill without
+// checkpoints. A post that reserved a position below that head may still be writing its entry: harmless here (the entries
+// are never read in this mode, and a slot is reused only after nEntries more reservations).
+static void gdakiRsMeasureStep(struct gdakiRecHost* r) {
+  if (r->rsMeasureMs <= 0 || r->rsEntries == 0) return;
+  const double now = gdakiQ4MonoMs();
+  if (now < r->rsMeasureNext) return;
+  r->rsMeasureNext = now + (double)r->rsMeasureMs;
+  struct ncclGinRsSide h;
+  if (!gdakiRsReadSide(r, &h, nullptr)) {
+    r->rsMeasureErrs++;
+    return;
+  }
+  r->rsMeasureRounds++;
+  const uint64_t occ = h.head >= h.tail ? h.head - h.tail : 0;
+  r->rsOccSamples++;
+  r->rsOccSum += occ;
+  if (occ > r->rsOccMax) r->rsOccMax = occ;
+  if (occ == 0) return;
+  memcpy(r->pinned, &h.head, sizeof(h.head));
+  if (gdakiLbXfer(r, true, &((struct ncclGinRsSide*)r->rsBase)->tail, sizeof(uint64_t)) != ncclSuccess)
+    r->rsMeasureErrs++;
+}
