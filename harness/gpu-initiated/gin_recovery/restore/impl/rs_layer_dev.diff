+    snprintf(told, sizeof(told), "the communicator has an asynchronous error: %s",
+             ncclGetErrorString((ncclResult_t)f->asyncErr));
+  else
+    gdakiRsTold(comm, asyncSet, told, sizeof(told));  // after gdakiRecRegMu is released
+  in.told = told[0] ? told : nullptr;
+  mine.localCode = gdakiRsLocalCheck(in, mine.localWhy, sizeof(mine.localWhy));
+  // the exchange over the communicator's bootstrap, bounded
+  const int n = f->nRanks;
+  std::vector<struct gdakiRsXRec> all((size_t)n);
+  all[(size_t)f->rank] = mine;
+  bool expired = false;
+  const long long boundMs = std::min<long long>((long long)ncclParamGinRestoreResumeMs(), 86400000LL);  // <= 1 day
+  const int xr = gdakiRsRunBounded([&] { return (int)exchange(comm, all.data(), (int)sizeof(struct gdakiRsXRec)); },
+                                   [&] { abortComm(comm); }, boundMs, &expired);
+  int verdict;
+  ncclResult_t rc;
+  if (expired || xr != (int)ncclSuccess) {
+    if (!expired) abortComm(comm);  // the bootstrap ring is out of step either way
+    verdict = GDAKI_RS_REFUSE;
+    rc = ncclSystemError;
+    snprintf(why, sizeof(why), "the Resume exchange did not complete within its bound (NCCL_GIN_RESTORE_RESUME_MS) or "
+             "failed: a rank did not call ncclGinRestoreResume, or the bootstrap failed; the communicator's abort flag "
+             "is set, end it with ncclCommAbort");
+  } else {
+    verdict = gdakiRsResumeDecide(n, all.data(), why, sizeof(why));
+    rc = verdict == GDAKI_RS_REFUSE ? ncclInvalidUsage : ncclSuccess;
+  }
+  // gin-restore (dev; user direction 2026-10-12): the side table goes to the device only now, on success (the log
+  // measurement mode published it at the context's creation)
+  if (rc == ncclSuccess && verdict == GDAKI_RS_ENABLE) gdakiRsPublishFor(comm, key);
+  {
+    std::lock_guard<std::mutex> lk(gdakiRsRegMu);
+    gdakiRsResumedReg.emplace_back();
+    struct gdakiRsResumed& e = gdakiRsResumedReg.back();
+    e.comm = comm;
+    e.commHash = f->commHash;
+    e.bootstrap = f->bootstrap;
+    e.rc = rc;
+    e.verdict = verdict;
+    snprintf(e.why, sizeof(e.why), "%s", why);
+  }
+  if (rc != ncclSuccess) {  // the reason, the same on every rank: ncclGetLastError(comm) returns this line's text
+    WARN("GIN/RS: ncclGinRestoreResume: the restore cannot be enabled on this communicator: %s", why);
+    return rc;
+  }
+  if (step != nullptr && bytes != nullptr) {  // the first incarnation: step 0, no host blob
+    *step = 0;
+    *bytes = 0;
+  }
+  if (verdict == GDAKI_RS_ENABLE)
+    GIN_TS_NOTE("GIN/RS: rank %d: ncclGinRestoreResume: the restore can be enabled (%s); first incarnation, step 0; this "
+                "build has no hold reaction yet: a fault still fails fast", f->rank, why);
+  else
+    INFO(NCCL_NET, "GIN/RS: rank %d: ncclGinRestoreResume: %s; the communicator stays fail-fast", f->rank, why);
+  return ncclSuccess;
+}
