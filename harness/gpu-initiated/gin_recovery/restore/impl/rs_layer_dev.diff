+ncclResult_t ncclGinGdakiRestoreResume(void* comm, const struct ncclGinRestoreCommFacts* f,
+                                       ncclResult_t (*exchange)(void* comm, void* data, int bytesPerRank),
+                                       void (*abortComm)(void* comm), unsigned long long* step, void* blob,
+                                       size_t* bytes) {
+  (void)blob;
+  void* const key = f->nConn > 0 ? f->handles[0] : nullptr;
+  char why[GDAKI_RS_RWHY_LEN];
+  {  // a second call on this communicator: the first call's result
+    bool again = false;
+    ncclResult_t rc = ncclSuccess;
+    {
+      std::lock_guard<std::mutex> lk(gdakiRsRegMu);
+      for (size_t i = 0; i < gdakiRsResumedReg.size(); i++) {
+        struct gdakiRsResumed& e = gdakiRsResumedReg[i];
+        if (e.comm != comm) continue;
+        if (e.commHash == f->commHash && e.bootstrap == f->bootstrap) {
+          again = true;
+          rc = e.rc;
+          snprintf(why, sizeof(why), "%s", e.why);
+        } else {  // a former communicator at this address
+          gdakiRsResumedReg.erase(gdakiRsResumedReg.begin() + i);
+        }
+        break;
+      }
+    }
+    if (again) {
+      if (rc != ncclSuccess) {
+        WARN("GIN/RS: ncclGinRestoreResume: the restore cannot be enabled on this communicator: %s", why);
+      } else if (step != nullptr && bytes != nullptr) {
+        *step = 0;
+        *bytes = 0;
+      }
+      INFO(NCCL_NET, "GIN/RS: rank %d: ncclGinRestoreResume called again: the first call's result, no exchange", f->rank);
+      return rc;
+    }
+  }
+  // this rank's judgment
+  const struct gdakiRsCfg& c = gdakiRsProc();
+  struct gdakiRsLocalIn in;
+  in.argsOk = f->argsOk != 0;
+  in.devCommVersion = (f->devCommVersion == 0 || f->devCommVersion == (int)NCCL_VERSION_CODE) ? 0 : f->devCommVersion;
+  in.spare = c.spare >= 0;
+  in.ginType = f->ginType;
+  in.nConn = f->nConn;
+  in.commFull = f->commFull != 0;
+  in.ctxStride = f->ctxStride;
+  in.numRmaCtx = f->numRmaCtx;
+  in.runtimeConn = f->runtimeConn != 0;
+  in.nvls = f->nvls != 0;
+  in.lsaSize = f->lsaSize;
+  in.symGinDevComm = f->symGinDevComm != 0;
+  in.reconnect = (long long)ncclParamGinTsReconnect();
+  in.restoreMs = (long long)ncclParamGinRestoreMs();
+  in.deviceBuilt = f->deviceBuilt != 0;  // gin-restore (dev; user direction 2026-10-12): the nccl.h wrapper's flag
+  struct gdakiRsXRec mine;
+  memset(&mine, 0, sizeof(mine));
+  mine.magic = GDAKI_RS_X_MAGIC;
+  mine.rank = f->rank;
+  mine.req = c.requested ? 1u : 0u;
+  mine.policy = (uint32_t)c.policy;
+  mine.setupVerdict = -1;
+  char offWhy[96] = {0};
+  {
+    std::lock_guard<std::mutex> lk(gdakiRsRegMu);
+    struct gdakiRsEntry* fatal = gdakiRsFindLocked(comm, nullptr);
+    struct gdakiRsEntry* e = key != nullptr ? gdakiRsFindLocked(comm, key) : nullptr;
+    if (fatal != nullptr && fatal->setup && fatal->verdict == GDAKI_RS_REFUSE_FATAL) e = fatal;  // the communicator ended
+    if (e != nullptr && e->setup) {
