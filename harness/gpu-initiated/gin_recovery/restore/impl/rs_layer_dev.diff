+  else if (!r->rsLbOk || !gdakiLbOn(r)) w = "the NIC copy path is off";
+  else if (n > r->pinnedSize) w = "the side table is larger than the staging buffer";
+  if (w == nullptr && gdakiLbXfer(r, false, r->rsBase, n) != ncclSuccess) w = "the read over the NIC copy path failed";
+  if (w != nullptr) {
+    if (why) *why = w;
+    return false;
+  }
+  memcpy(hdr, r->pinned, sizeof(*hdr));
+  if (qps) {
+    qps->resize((size_t)r->rsNqp);
+    memcpy(qps->data(), r->pinned + sizeof(struct ncclGinRsSide), n - sizeof(struct ncclGinRsSide));
+  }
