+// gin-restore (rs, work package 4): the side table (its header and, with qps, its QP entries) into the staging buffer
+// over the NIC copy path (no CUDA call). The helper only, or the application thread once the helper has stopped (the path
+// has one user at a time).
+static bool gdakiRsReadSide(struct gdakiRecHost* r, struct ncclGinRsSide* hdr, std::vector<struct ncclGinRsQp>* qps,
+                            const char** why = nullptr) {
+  const char* w = nullptr;
+  const size_t n = sizeof(struct ncclGinRsSide) + (qps ? (size_t)r->rsNqp * sizeof(struct ncclGinRsQp) : 0);
+  if (!r->rsPtrSet || r->rsNqp <= 0) w = "no side table";
+  else if (!r->rsLbOk || !gdakiLbOn(r)) w = "the NIC copy path is off";
+  else if (n > r->pinnedSize) w = "the side table is larger than the staging buffer";
+  if (w == nullptr && gdakiLbXfer(r, false, r->rsBase, n) != ncclSuccess) w = "the read over the NIC copy path failed";
+  if (w != nullptr) {
+    if (why) *why = w;
+    return false;
+  }
+  memcpy(hdr, r->pinned, sizeof(*hdr));
+  if (qps) {
+    qps->resize((size_t)r->rsNqp);
+    memcpy(qps->data(), r->pinned + sizeof(struct ncclGinRsSide), n - sizeof(struct ncclGinRsSide));
+  }
+  return true;
+}
+// The measurement mode (NCCL_GIN_RESTORE_LOG_MEASURE, EXPERIMENT.md 9.5), one helper step: every <ms>, the ring's
+// occupancy (head - tail) is sampled and its tail moved to the head it read, so the ring does not fill without
+// checkpoints. A post that reserved a position below that head may still be writing its entry: harmless here (the entries
+// are never read in this mode, and a slot is reused only after nEntries more reservations).
+static void gdakiRsMeasureStep(struct gdakiRecHost* r) {
+  if (r->rsMeasureMs <= 0 || r->rsEntries == 0) return;
+  const double now = gdakiQ4MonoMs();
+  if (now < r->rsMeasureNext) return;
+  r->rsMeasureNext = now + (double)r->rsMeasureMs;
+  struct ncclGinRsSide h;
+  if (!gdakiRsReadSide(r, &h, nullptr)) {
+    r->rsMeasureErrs++;
+    return;
+  }
+  r->rsMeasureRounds++;
+  const uint64_t occ = h.head >= h.tail ? h.head - h.tail : 0;
+  r->rsOccSamples++;
+  r->rsOccSum += occ;
+  if (occ > r->rsOccMax) r->rsOccMax = occ;
+  if (occ == 0) return;
+  memcpy(r->pinned, &h.head, sizeof(h.head));
+  if (gdakiLbXfer(r, true, &((struct ncclGinRsSide*)r->rsBase)->tail, sizeof(uint64_t)) != ncclSuccess)
+    r->rsMeasureErrs++;
+}
+// The readout when a context ends (a process that asks for the restore; after the helper stopped, before the NIC copy
+// path closes; EXPERIMENT.md 9.5): one line with the ring and the sums, and in the measurement mode one line per QP that
+// may log (its messages and overflows; the ring's occupancy is the rank's, not the QP's).
+static void gdakiRsTeardownLine(struct gdakiRecHost* r) {
+  if (!r->rsPtrSet) return;
+  const int rank = r->ctx ? r->ctx->rank : -1;
+  struct ncclGinRsSide h;
+  std::vector<struct ncclGinRsQp> v;
+  const char* why = "";
+  if (!gdakiRsReadSide(r, &h, &v, &why)) {
+    GIN_TS_NOTE("GIN/RS: rank %d: send-side log at close: not read (%s)", rank, why);
+    return;
+  }
+  const struct gdakiRsSums t = gdakiRsSumsOf(v.data(), r->rsNqp, r->rsLogged.data());
+  GIN_TS_NOTE("GIN/RS: rank %d: send-side log at close: ring_entries=%u logged_qps=%d head=%lu tail=%lu occupancy=%lu "
+              "overflow_ops=%lu overflow_qps=%d msgs=%lu get_refused=%d checksum=%s measure_ms=%lld measure_rounds=%lu "
+              "measure_errors=%lu occupancy_samples=%lu occupancy_avg=%.1f occupancy_max=%lu", rank, r->rsEntries,
+              t.logged, (unsigned long)h.head, (unsigned long)h.tail,
+              (unsigned long)(h.head >= h.tail ? h.head - h.tail : 0), (unsigned long)h.ovfCount, t.ovfQps,
+              (unsigned long)t.msgs, t.getRefused, gdakiRsCsumName(gdakiRsCsumScheme()), r->rsMeasureMs,
+              (unsigned long)r->rsMeasureRounds, (unsigned long)r->rsMeasureErrs, (unsigned long)r->rsOccSamples,
+              r->rsOccSamples ? (double)r->rsOccSum / (double)r->rsOccSamples : 0.0, (unsigned long)r->rsOccMax);
+  if (r->rsMeasureMs <= 0) return;
+  const int nranks = r->nranks > 0 ? r->nranks : 1;
+  for (int i = 0; i < r->rsNqp; i++) {
+    if (!r->rsLogged[(size_t)i]) continue;
+    GIN_TS_NOTE("GIN/RS: rank %d: send-side log qp=%d peer=%d ctx=%d msgs=%lu overflow_ops=%lu", rank, i, i % nranks,
+                i / nranks, (unsigned long)v[(size_t)i].msgs, (unsigned long)v[(size_t)i].ovfCount);
+  }
+}
