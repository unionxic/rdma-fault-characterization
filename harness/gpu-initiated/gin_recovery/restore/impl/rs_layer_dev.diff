+                                        void* blob, size_t* bytes, int deviceBuilt);
+/* Build-time opt-in of the device restore path (gin-restore, user direction 2026-10-12): a program that uses the restore
+ * compiles every translation unit of its device link unit with -DNCCL_GIN_RESTORE_DEVICE (on the command line, so that it
+ * is defined before this header). Its GIN kernels then carry the device restore path (the send-side log, the suppress
+ * budget, the key re-read), used only once ncclGinRestoreResume has succeeded. Compiled without it, the kernels are the
