@@ -0,0 +1,72 @@
+/*************************************************************************
+ * gin-restore feasibility spike B1 (EXPERIMENT.md 9.15.4): record the collective exchanges of a communicator's init,
+ * window registration and devComm creation, and replay them in a spare process without any peer. Research only; every
+ * hook is inert unless one of these is set:
+ *   NCCL_GIN_RESTORE_RECORD=<file>  record the first communicator of this process into <file> (created 0600, O_EXCL)
+ *   NCCL_GIN_RESTORE_REPLAY=<file>  answer every hooked exchange of the first communicator from <file>
+ *   NCCL_GIN_RESTORE_REPORT=1       only the "GIN/RS:" report lines (also on with RECORD or REPLAY)
+ *   NCCL_GIN_RESTORE_HKEY=<16 hex>  key of the hashes in the report lines (no key: no hashes are printed)
+ ************************************************************************/
+#ifndef NCCL_RS_SPIKE_H_
+#define NCCL_RS_SPIKE_H_
+
+#include "nccl.h"
+#include <functional>
+#include <stddef.h>
+#include <stdint.h>
+
+enum { RS_OFF = 0, RS_RECORD = 1, RS_REPLAY = 2 };
+enum { RS_SITE_NONE = 0, RS_SITE_PEERINFO = 1, RS_SITE_AG3 = 2, RS_SITE_GINCOUNT = 3, RS_SITE_SEGMENTS = 4 };
+enum {
+  RSK_AG = 1,
+  RSK_INTRA_AG = 2,
+  RSK_BARRIER = 3,
+  RSK_INTRA_BARRIER = 4,
+  RSK_SEND = 5,
+  RSK_RECV = 6,
+  RSK_BCAST = 7,
+  RSK_INTRA_BCAST = 8,
+  RSK_GIN_AG = 9,
+  RSK_MARK = 10
+};
+
+int rsMode();          // RS_OFF, RS_RECORD or RS_REPLAY (from the environment, once)
+bool rsReplaying();    // replay mode and a communicator is bound
+bool rsReportOn();     // report lines wanted
+// init.cc, before the commHash: record the commId (record) or put the recorded one in its place (replay). Binds the
+// first communicator of the process; later communicators are not hooked.
+ncclResult_t rsBeginComm(void* commId, size_t commIdBytes, int nranks, int rank);
+// bootstrap.cc: the bootstrap state of the bound communicator; the replay preconditions (RAS, OOB net, host RMA off)
+void rsBindState(void* state);
+bool rsStateHooked(void* state);
+ncclResult_t rsReplayPreconditions(int64_t rasEnable, int64_t oobNetEnable, int numRmaCtx);
+// the call site of the next hooked exchange (thread local): strict own-slot comparison with allowed byte ranges
+void rsSite(int site, int nAllowed = 0, const size_t* off = nullptr, const size_t* len = nullptr);
+// depth guard: only the outermost hooked call records or replays
+struct RsGuard {
+  bool hooked;
+  explicit RsGuard(void* state);
+  ~RsGuard();
+};
+// the hooks: `real` performs the original exchange (record mode, and every call that is not hooked)
+ncclResult_t rsAllGather(int kind, int myIdx, int n, void* buf, size_t elt, const std::function<ncclResult_t()>& real);
+ncclResult_t rsNoData(int kind, int tag, int n, const std::function<ncclResult_t()>& real);
+ncclResult_t rsSend(int peer, int tag, const void* data, size_t size, const std::function<ncclResult_t()>& real);
+ncclResult_t rsRecv(int peer, int tag, void* data, size_t size, const std::function<ncclResult_t()>& real);
+ncclResult_t rsBcast(int kind, int root, int myIdx, int n, void* data, size_t size,
+                     const std::function<ncclResult_t()>& real);
+// GIN collComm all-gather (transport/net_ib/gin.cc): recvBuf holds n slots of len bytes, srcBuf is this rank's slot
+ncclResult_t rsGinAllGather(int myIdx, int n, const void* srcBuf, void* recvBuf, size_t len,
+                            const std::function<ncclResult_t()>& real);
+bool rsGinHooked();
+// the recorded own slot of the next GIN all-gather (replay: the helper salt)
+ncclResult_t rsPeekGinOwn(void* out, size_t len);
+// window registration end ("win"), devComm creation end ("devcomm")
+ncclResult_t rsMark(const char* name);
+// keyed hash for the report lines; false (and 0) without a key
+bool rsHash(const void* p, size_t n, uint64_t* out);
+void rsHashStr(const void* p, size_t n, char* out, size_t outLen);  // "h:<16 hex>" or "nokey"
+uint32_t rsRandom24();
+void rsSummary(const char* where);  // entries used, divergences, own-slot differences, calls beyond the transcript
+
+#endif
