+std::vector<Entry> entries;  // replay
+size_t cursor = 0;
+long nRecorded = 0, nReplayed = 0, nDiverged = 0, nBeyond = 0, nStrictMismatch = 0;
+unsigned long long ownDiffBytes = 0;
+bool haveKey = false;
+uint64_t hkey = 0;
+thread_local int depth = 0;
+thread_local Site pendingSite;
+// gin-restore (rs, work package 8): the mode read once, without the lock afterwards, so a process without
+// NCCL_GIN_RESTORE_RECORD/REPLAY/REPORT pays no mutex per bootstrap call (-1: not read yet)
+std::atomic<int> modeFast{-1};
+
+void initOnce() {  // under mu
+  if (mode >= 0) return;
+  const char* rec = getenv("NCCL_GIN_RESTORE_RECORD");
+  const char* rep = getenv("NCCL_GIN_RESTORE_REPLAY");
+  const char* rpt = getenv("NCCL_GIN_RESTORE_REPORT");
+  const char* key = getenv("NCCL_GIN_RESTORE_HKEY");
+  mode = (rep && rep[0]) ? RS_REPLAY : (rec && rec[0]) ? RS_RECORD : RS_OFF;
+  report = mode != RS_OFF || (rpt && rpt[0] == '1');
+  modeFast.store(mode, std::memory_order_release);
+  if (key && strlen(key) == 16) {
+    hkey = strtoull(key, nullptr, 16);
+    haveKey = true;
+  }
+}
+uint64_t mix64(uint64_t z) {
+  z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9ull;
+  z = (z ^ (z >> 27)) * 0x94d049bb133111ebull;
+  return z ^ (z >> 31);
+}
+const char* kindName(uint32_t k) {
+  static const char* n[] = {"?", "allgather", "intra_allgather", "barrier", "intra_barrier", "send", "recv", "bcast",
+                            "intra_bcast", "gin_allgather", "mark"};
+  return k <= RSK_MARK ? n[k] : "?";
+}
+bool writeAll(FILE* f, const void* p, size_t n) { return n == 0 || fwrite(p, 1, n, f) == n; }
+ncclResult_t recordEntry(uint32_t kind, int site, int tag, int peer, int n, int myIdx, size_t elt, const void* data,
+                         size_t len) {
+  EntryHeader h;
+  memset(&h, 0, sizeof(h));
+  h.magic = kEntryMagic;
+  h.kind = kind;
+  h.site = site;
+  h.tag = tag;
+  h.peer = peer;
+  h.n = n;
+  h.myIdx = myIdx;
+  h.elt = elt;
+  h.payload = len;
+  if (!writeAll(recFile, &h, sizeof(h)) || !writeAll(recFile, data, len) || fflush(recFile) != 0) {
+    WARN("GIN/RS: cannot write the transcript entry %ld", nRecorded);
+    return ncclSystemError;
+  }
+  nRecorded++;
+  return ncclSuccess;
+}
+// the next replay entry; checks kind, site, tag, peer, n, myIdx, elt and the payload length
+ncclResult_t nextEntry(uint32_t kind, int site, int tag, int peer, int n, int myIdx, size_t elt, size_t len,
+                       const Entry** out) {
+  if (cursor >= entries.size()) {
+    nBeyond++;
+    WARN("GIN/RS: replay: a %s call after the end of the transcript (%zu entries); refused", kindName(kind),
+         entries.size());
+    return ncclSystemError;
+  }
+  const Entry& e = entries[cursor];
+  if (e.h.kind != kind || e.h.site != site || e.h.tag != tag || e.h.peer != peer || e.h.n != n || e.h.myIdx != myIdx ||
+      e.h.elt != elt || e.h.payload != len) {
+    nDiverged++;
+    WARN("GIN/RS: replay diverged at entry %zu: transcript %s site=%d tag=%d peer=%d n=%d idx=%d elt=%lu len=%lu; "
+         "call %s site=%d tag=%d peer=%d n=%d idx=%d elt=%zu len=%zu",
+         cursor, kindName(e.h.kind), e.h.site, e.h.tag, e.h.peer, e.h.n, e.h.myIdx, (unsigned long)e.h.elt,
+         (unsigned long)e.h.payload, kindName(kind), site, tag, peer, n, myIdx, elt, len);
+    return ncclSystemError;
+  }
+  *out = &e;
+  cursor++;
+  nReplayed++;
+  return ncclSuccess;
+}
+// own slot comparison: bytes that differ, and bytes that differ outside the allowed ranges of the site
+void compareOwn(const Site& s, const uint8_t* now, const uint8_t* rec, size_t len, size_t idx) {
+  size_t diff = 0, strict = 0;
+  for (size_t b = 0; b < len; b++) {
+    if (now[b] == rec[b]) continue;
+    diff++;
+    bool ok = s.site == RS_SITE_NONE;
+    for (auto& a : s.allowed)
+      if (b >= a.first && b < a.first + a.second) ok = true;
+    if (!ok) strict++;
+  }
+  ownDiffBytes += diff;
+  if (strict) {
+    nStrictMismatch++;
+    WARN("GIN/RS: replay entry %zu (site %d): %zu own-slot bytes differ from the recorded rank outside the allowed fields",
+         idx, s.site, strict);
+  }
+  if (report)
+    WARN("GIN/RS: replay entry %zu site=%d own_slot_bytes=%zu own_diff_bytes=%zu strict_diff_bytes=%zu", idx, s.site,
+         len, diff, strict);
+}
+Site takeSite() {
+  Site s = pendingSite;
+  pendingSite = Site();
+  return s;
+}
+// RS_OFF without taking the lock once the mode is known (the mode never changes after it is read)
+bool offFast() {
+  int m = modeFast.load(std::memory_order_acquire);
+  if (m < 0) {
+    std::lock_guard<std::mutex> lk(mu);
+    initOnce();
+    m = mode;
+  }
+  return m == RS_OFF;
+}
+}  // namespace
+
+int rsMode() {
+  std::lock_guard<std::mutex> lk(mu);
+  initOnce();
+  return mode;
+}
+bool rsReplaying() {
+  if (offFast()) return false;
+  std::lock_guard<std::mutex> lk(mu);
+  initOnce();
+  return mode == RS_REPLAY && bound;
+}
+bool rsReportOn() {
+  std::lock_guard<std::mutex> lk(mu);
+  initOnce();
+  return report;
+}
+bool rsGinHooked() {
+  if (offFast()) return false;
+  std::lock_guard<std::mutex> lk(mu);
+  initOnce();
+  return mode != RS_OFF && bound;
+}
+
+ncclResult_t rsBeginComm(void* commId, size_t bytes, int nranks, int rank) {
+  std::lock_guard<std::mutex> lk(mu);
+  initOnce();
+  if (mode == RS_OFF || bound) return ncclSuccess;
+  if (mode == RS_RECORD) {
+    const char* path = getenv("NCCL_GIN_RESTORE_RECORD");
+    const int fd = open(path, O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, 0600);
+    if (fd < 0) {
+      WARN("GIN/RS: record: cannot create the transcript (errno %d)", errno);
+      return ncclSystemError;
+    }
+    recFile = fdopen(fd, "wb");
+    FileHeader h = {kFileMagic, 1, nranks, rank, (uint64_t)bytes};
+    if (!recFile || !writeAll(recFile, &h, sizeof(h)) || !writeAll(recFile, commId, bytes) || fflush(recFile) != 0) {
+      WARN("GIN/RS: record: cannot write the transcript header");
+      return ncclSystemError;
+    }
+    bound = true;
+    WARN("GIN/RS: record ON rank=%d nranks=%d", rank, nranks);
+    return ncclSuccess;
+  }
+  // replay: read the whole transcript, check rank and nranks, put the recorded commId in place
+  const char* path = getenv("NCCL_GIN_RESTORE_REPLAY");
+  FILE* f = fopen(path, "rb");
+  if (!f) {
+    WARN("GIN/RS: replay: cannot open the transcript (errno %d)", errno);
+    return ncclSystemError;
+  }
+  FileHeader h;
+  bool ok = fread(&h, 1, sizeof(h), f) == sizeof(h) && h.magic == kFileMagic && h.version == 1 &&
+            h.commIdBytes == bytes;
+  if (ok) {
+    commIdRec.resize(bytes);
+    ok = fread(commIdRec.data(), 1, bytes, f) == bytes;
+  }
+  while (ok) {
+    Entry e;
+    const size_t got = fread(&e.h, 1, sizeof(e.h), f);
+    if (got == 0) break;
+    if (got != sizeof(e.h) || e.h.magic != kEntryMagic || e.h.payload > (1ull << 30)) {
+      WARN("GIN/RS: replay: transcript entry %zu is damaged or cut", entries.size());
+      ok = false;
+      break;
+    }
+    e.data.resize(e.h.payload);
+    if (e.h.payload && fread(e.data.data(), 1, e.h.payload, f) != e.h.payload) {
+      WARN("GIN/RS: replay: transcript entry %zu is cut", entries.size());
+      ok = false;
+      break;
+    }
+    entries.push_back(std::move(e));
+  }
+  fclose(f);
+  if (!ok) {
+    WARN("GIN/RS: replay: the transcript is not usable");
+    return ncclSystemError;
+  }
+  if (h.nranks != nranks || h.rank != rank) {
+    WARN("GIN/RS: replay: the transcript is rank %d of %d, the call asks for rank %d of %d", h.rank, h.nranks, rank,
+         nranks);
+    return ncclInvalidArgument;
+  }
+  memcpy(commId, commIdRec.data(), bytes);
+  bound = true;
+  WARN("GIN/RS: replay ON rank=%d nranks=%d entries=%zu", rank, nranks, entries.size());
+  return ncclSuccess;
+}
+void rsBindState(void* state) {
+  std::lock_guard<std::mutex> lk(mu);
+  if (bound && boundState == nullptr) boundState = state;
+}
+bool rsStateHooked(void* state) {
+  if (offFast()) return false;
+  std::lock_guard<std::mutex> lk(mu);
+  return mode != RS_OFF && bound && state != nullptr && state == boundState;
+}
+ncclResult_t rsReplayPreconditions(int64_t rasEnable, int64_t oobNetEnable, int numRmaCtx) {
+  if (!rsReplaying()) return ncclSuccess;
+  if (rasEnable != 0 || oobNetEnable != 0 || numRmaCtx != 0) {
+    WARN("GIN/RS: replay refused: needs NCCL_RAS_ENABLE=0 (is %ld), NCCL_OOB_NET_ENABLE=0 (is %ld) and no host RMA "
+         "(NCCL_NUM_RMA_CTX=0; numRmaCtx is %d)",
+         (long)rasEnable, (long)oobNetEnable, numRmaCtx);
+    return ncclInvalidUsage;
+  }
+  return ncclSuccess;
+}
+void rsSite(int site, int nAllowed, const size_t* off, const size_t* len) {
+  pendingSite = Site();
+  pendingSite.site = site;
+  for (int i = 0; i < nAllowed; i++) pendingSite.allowed.push_back({off[i], len[i]});
+}
+RsGuard::RsGuard(void* state) {
+  hooked = depth == 0 && rsStateHooked(state);
+  depth++;
+}
+RsGuard::~RsGuard() { depth--; }
+
+ncclResult_t rsAllGather(int kind, int myIdx, int n, void* buf, size_t elt, const std::function<ncclResult_t()>& real) {
+  const Site s = takeSite();
+  uint8_t* b = (uint8_t*)buf;
+  if (rsReplaying()) {
+    std::lock_guard<std::mutex> lk(mu);
+    const Entry* e = nullptr;
+    const size_t idx = cursor;
+    NCCLCHECK(nextEntry(kind, s.site, 0, -1, n, myIdx, elt, elt * n, &e));
+    compareOwn(s, b + elt * myIdx, e->data.data() + elt * myIdx, elt, idx);
+    for (int r = 0; r < n; r++)
+      if (r != myIdx) memcpy(b + elt * r, e->data.data() + elt * r, elt);
+    return ncclSuccess;
+  }
+  NCCLCHECK(real());
+  std::lock_guard<std::mutex> lk(mu);
+  return recordEntry(kind, s.site, 0, -1, n, myIdx, elt, buf, elt * n);
+}
+ncclResult_t rsNoData(int kind, int tag, int n, const std::function<ncclResult_t()>& real) {
+  const Site s = takeSite();
+  if (rsReplaying()) {
+    std::lock_guard<std::mutex> lk(mu);
+    const Entry* e = nullptr;
+    return nextEntry(kind, s.site, tag, -1, n, -1, 0, 0, &e);
+  }
+  NCCLCHECK(real());
+  std::lock_guard<std::mutex> lk(mu);
+  return recordEntry(kind, s.site, tag, -1, n, -1, 0, nullptr, 0);
+}
+ncclResult_t rsSend(int peer, int tag, const void* data, size_t size, const std::function<ncclResult_t()>& real) {
+  const Site s = takeSite();
+  if (rsReplaying()) {
+    std::lock_guard<std::mutex> lk(mu);
+    const Entry* e = nullptr;
+    const size_t idx = cursor;
+    NCCLCHECK(nextEntry(RSK_SEND, s.site, tag, peer, 0, -1, size, size, &e));
+    compareOwn(s, (const uint8_t*)data, e->data.data(), size, idx);
+    return ncclSuccess;
+  }
+  NCCLCHECK(real());
+  std::lock_guard<std::mutex> lk(mu);
+  return recordEntry(RSK_SEND, s.site, tag, peer, 0, -1, size, data, size);
+}
+ncclResult_t rsRecv(int peer, int tag, void* data, size_t size, const std::function<ncclResult_t()>& real) {
+  const Site s = takeSite();
+  if (rsReplaying()) {
+    std::lock_guard<std::mutex> lk(mu);
+    const Entry* e = nullptr;
+    NCCLCHECK(nextEntry(RSK_RECV, s.site, tag, peer, 0, -1, size, size, &e));
+    if (size) memcpy(data, e->data.data(), size);
+    return ncclSuccess;
+  }
+  NCCLCHECK(real());
+  std::lock_guard<std::mutex> lk(mu);
+  return recordEntry(RSK_RECV, s.site, tag, peer, 0, -1, size, data, size);
+}
+ncclResult_t rsBcast(int kind, int root, int myIdx, int n, void* data, size_t size,
+                     const std::function<ncclResult_t()>& real) {
+  const Site s = takeSite();
+  if (rsReplaying()) {
+    std::lock_guard<std::mutex> lk(mu);
+    const Entry* e = nullptr;
+    const size_t idx = cursor;
+    NCCLCHECK(nextEntry(kind, s.site, 0, root, n, myIdx, size, size, &e));
+    if (root == myIdx) compareOwn(s, (const uint8_t*)data, e->data.data(), size, idx);
+    else if (size) memcpy(data, e->data.data(), size);
+    return ncclSuccess;
+  }
+  NCCLCHECK(real());
+  std::lock_guard<std::mutex> lk(mu);
+  return recordEntry(kind, s.site, 0, root, n, myIdx, size, data, size);
+}
+ncclResult_t rsGinAllGather(int myIdx, int n, const void* srcBuf, void* recvBuf, size_t len,
+                            const std::function<ncclResult_t()>& real) {
+  const Site s = takeSite();
+  uint8_t* b = (uint8_t*)recvBuf;
+  if (rsReplaying()) {
+    std::lock_guard<std::mutex> lk(mu);
+    const Entry* e = nullptr;
+    const size_t idx = cursor;
+    NCCLCHECK(nextEntry(RSK_GIN_AG, s.site, 0, -1, n, myIdx, len, len * n, &e));
+    memcpy(b + len * myIdx, srcBuf, len);
+    compareOwn(s, b + len * myIdx, e->data.data() + len * myIdx, len, idx);
+    for (int r = 0; r < n; r++)
+      if (r != myIdx) memcpy(b + len * r, e->data.data() + len * r, len);
+    return ncclSuccess;
+  }
+  NCCLCHECK(real());
+  std::lock_guard<std::mutex> lk(mu);
+  return recordEntry(RSK_GIN_AG, s.site, 0, -1, n, myIdx, len, recvBuf, len * n);
+}
+ncclResult_t rsPeekGinOwn(void* out, size_t len) {
+  std::lock_guard<std::mutex> lk(mu);
+  if (cursor >= entries.size() || entries[cursor].h.kind != RSK_GIN_AG || entries[cursor].h.elt != len) {
+    WARN("GIN/RS: replay: the next transcript entry is not the helper all-gather");
+    return ncclSystemError;
+  }
+  const Entry& e = entries[cursor];
+  memcpy(out, e.data.data() + len * e.h.myIdx, len);
+  return ncclSuccess;
+}
+ncclResult_t rsMark(const char* name) {
+  std::lock_guard<std::mutex> lk(mu);
+  initOnce();
+  if (mode == RS_OFF || !bound) return ncclSuccess;
+  const size_t len = strlen(name);
+  if (mode == RS_REPLAY) {
+    const Entry* e = nullptr;
+    NCCLCHECK(nextEntry(RSK_MARK, RS_SITE_NONE, 0, -1, 0, -1, len, len, &e));
+    if (memcmp(e->data.data(), name, len) != 0) {
+      nDiverged++;
+      WARN("GIN/RS: replay diverged at the mark %s", name);
+      return ncclSystemError;
+    }
+    WARN("GIN/RS: replay mark=%s entry=%zu of %zu", name, cursor, entries.size());
+    return ncclSuccess;
+  }
+  WARN("GIN/RS: record mark=%s entry=%ld", name, nRecorded + 1);
+  return recordEntry(RSK_MARK, RS_SITE_NONE, 0, -1, 0, -1, len, name, len);
+}
+bool rsHash(const void* p, size_t n, uint64_t* out) {
+  {
+    std::lock_guard<std::mutex> lk(mu);
+    initOnce();
+  }
+  if (!haveKey) {
+    *out = 0;
+    return false;
+  }
+  uint64_t h = mix64(hkey ^ 0x6a09e667f3bcc909ull);
+  const uint8_t* b = (const uint8_t*)p;
+  for (size_t i = 0; i < n; i++) h = mix64(h ^ ((uint64_t)b[i] << ((i % 8) * 8)) ^ (i * 0x9e3779b97f4a7c15ull));
+  *out = mix64(h ^ hkey ^ n);
+  return true;
+}
+void rsHashStr(const void* p, size_t n, char* out, size_t outLen) {
+  uint64_t h;
+  if (rsHash(p, n, &h)) snprintf(out, outLen, "h:%016lx", (unsigned long)h);
+  else snprintf(out, outLen, "nokey");
+}
+uint32_t rsRandom24() {
+  std::random_device rd;
+  return ((uint32_t)rd()) & 0xffffffu;
+}
+void rsSummary(const char* where) {
+  std::lock_guard<std::mutex> lk(mu);
+  initOnce();
+  if (mode == RS_OFF) return;
+  WARN("GIN/RS: summary at %s mode=%s bound=%d recorded=%ld replayed=%ld transcript_entries=%zu diverged=%ld "
+       "beyond=%ld own_diff_bytes=%llu strict_mismatch=%ld",
+       where, mode == RS_RECORD ? "record" : "replay", bound ? 1 : 0, nRecorded, nReplayed, entries.size(), nDiverged,
+       nBeyond, ownDiffBytes, nStrictMismatch);
+}
