+// The spare process's per-(context, survivor peer) state, kept out of the shared gdakiTsPeer/gdakiRecHost structs so this
+// branch touches no struct the host or dev branches own: a small list under one mutex (peer counts are tiny). On the
+// survivor it holds the known incarnation of each peer and a parked REJOIN; on the spare it is not used (the spare drives
+// the dial-out itself). Entries are dropped when the communicator tears down (gdakiRsSpareForget).
+struct gdakiRsRejoinState {
+  struct gdakiRecHost* r = nullptr;
+  int peer = -1;
+  uint32_t knownInc = 0;              // the incarnation this rank knows for the peer (0 at setup; +1 per accepted REJOIN)
+  int parkedFd = -1;                  // a REJOIN read on the listen socket, not yet taken by the state machine
+  double parkedMs = 0;
+  struct gdakiTsMsg parkedMsg;        // its record
+  bool haveAccepted = false;          // an accepted REJOIN of knownInc is in effect (its endpoint/token are kept)
+  bool readyTaken = false;            // the spare's READY for knownInc was taken (gdakiRsTakeReady)
+  ncclGinRecoverToken_t rejoinTok;    // the spare's announced QPNs and send PSNs (and this rank's QPNs in remoteQpn)
+  struct gdakiRsEndpoint endpoint;    // the spare's endpoint (lid/gid/mtu/ordering/gid_index/listen address)
+};
+static std::mutex gdakiRsRejMu;
+static std::vector<struct gdakiRsRejoinState> gdakiRsRej;
+static struct gdakiRsRejoinState* gdakiRsRejFindLocked(struct gdakiRecHost* r, int peer) {
+  for (auto& e : gdakiRsRej)
+    if (e.r == r && e.peer == peer) return &e;
+  return nullptr;
+}
+static struct gdakiRsRejoinState* gdakiRsRejGetLocked(struct gdakiRecHost* r, int peer) {
+  struct gdakiRsRejoinState* e = gdakiRsRejFindLocked(r, peer);
+  if (e != nullptr) return e;
+  gdakiRsRej.emplace_back();
+  gdakiRsRej.back().r = r;
+  gdakiRsRej.back().peer = peer;
+  return &gdakiRsRej.back();
+}
+static void gdakiRsSpareForget(struct gdakiRecHost* r) {  // the communicator/context is gone (teardown)
+  std::lock_guard<std::mutex> lk(gdakiRsRejMu);
+  for (auto& e : gdakiRsRej)
+    if (e.r == r && e.parkedFd >= 0) { close(e.parkedFd); e.parkedFd = -1; }
+  gdakiRsRej.erase(std::remove_if(gdakiRsRej.begin(), gdakiRsRej.end(),
+                                  [&](const struct gdakiRsRejoinState& e) { return e.r == r; }),
+                   gdakiRsRej.end());
+}
+
+// rs_hold_api.h (host branch, read-only): true when `peer` is HELD on this context. Placeholder until that header is
+// merged: false, so this build (which has no hold state machine) accepts no REJOIN. The host branch deletes it.
+static bool gdakiRsHoldIsHeld(struct gdakiRecHost* r, int peer) {
+  (void)r;
+  (void)peer;
+  return false;
+}
+
+// The incarnation this rank knows for `peer` (rs_spare_api.h): 0 at setup, i + 1 after an accepted REJOIN.
+static uint32_t gdakiRsPeerInc(struct gdakiRecHost* r, int peer) {
+  std::lock_guard<std::mutex> lk(gdakiRsRejMu);
+  const struct gdakiRsRejoinState* e = gdakiRsRejFindLocked(r, peer);
+  return e != nullptr ? e->knownInc : 0u;
+}
+// This process's own incarnation (0 for a survivor, i + 1 for the spare restoring as i + 1): kept under this rank's own
+// slot. Carried in the pad of this rank's reconnect HELLO/HELLO-ACK/PROBE/PROBE-ACK so a restore-requesting peer ignores a
+// stale incarnation's reconnect (fencing, 9.11.1 D4).
+static uint32_t gdakiRsSelfInc(struct gdakiRecHost* r) { return gdakiRsPeerInc(r, r->ctx->rank); }
+static void gdakiRsSetPeerInc(struct gdakiRecHost* r, int peer, uint32_t inc) {
+  std::lock_guard<std::mutex> lk(gdakiRsRejMu);
+  gdakiRsRejGetLocked(r, peer)->knownInc = inc;
+}
+static void gdakiRsSetSelfInc(struct gdakiRecHost* r, uint32_t inc) {
+  std::lock_guard<std::mutex> lk(gdakiRsRejMu);
+  gdakiRsRejGetLocked(r, r->ctx->rank)->knownInc = inc;
+}
+// The pad a reconnect message carries: this rank's own incarnation in a restore-requesting process, 0 otherwise (the hk
+// wire). A restore-requesting receiver that knows the peer's incarnation (> 0, i.e. after a REJOIN) requires the pad to
+// equal it; before any restore (incarnation 0) and under fail-fast the check is a no-op, so hk behavior is unchanged.
+static uint32_t gdakiRsReconnectPad(struct gdakiRecHost* r) { return gdakiRsRequested() ? gdakiRsSelfInc(r) : 0u; }
+static bool gdakiRsReconnectIncOk(struct gdakiRecHost* r, int from, uint32_t pad) {
+  if (!gdakiRsRequested()) return true;
+  const uint32_t known = gdakiRsPeerInc(r, from);
+  return known == 0 || pad == known;
+}
+
+// This rank's QPNs to `peer`, in GIN-context order (gdakiRecForPeer); returns the count.
+static int gdakiRsOwnQpns(struct gdakiRecHost* r, int peer, uint32_t* out, int cap) {
+  int n = 0;
+  gdakiRecForPeer(r, peer, [&](gdakiRecQp&, struct doca_gpu_verbs_qp_hl* q) {
+    if (n < cap) out[n] = gdakiRecQpn(q);
+    n++;
+  });
+  return n;
+}
+
+// The spare's endpoint carried in a REJOIN <-> the executed[] words of a record (the pure pack is gdakiRsEndpoint).
+static void gdakiRsEndpointToMsg(const struct gdakiRsEndpoint& e, struct gdakiTsMsg* m) {
+  memcpy(&m->executed[2], &e, sizeof(e));
+}
+static void gdakiRsEndpointFromMsg(const struct gdakiTsMsg& m, struct gdakiRsEndpoint* e) {
+  memcpy(e, &m.executed[2], sizeof(*e));
+}
+// The spare's endpoint from a gdaki_exch_info (its own, filled by gdakiFillExchInfo) and a listen address.
+static void gdakiRsEndpointOf(const struct gdaki_exch_info& self, const union ncclSocketAddress& listen, uint64_t step,
+                              struct gdakiRsEndpoint* e) {
+  memset(e, 0, sizeof(*e));
+  e->lid = (uint32_t)self.lid;
+  e->activeMtu = (int32_t)self.active_mtu;
+  e->ordering = (int32_t)self.ordering_semantic;
+  e->gidIndex = (int32_t)self.gid_index;
+  memcpy(e->gid, self.gid.raw, 16);
+  memcpy(e->listenAddr, &listen, sizeof(union ncclSocketAddress) <= 32 ? sizeof(union ncclSocketAddress) : 32);
+  e->step = step;
+}
+// Build a gdaki_exch_info for one QP of the spare: the endpoint's address fields and the per-QP spare QPN. `base` keeps
+// the node/GPU names and the rank (same node and GPU, logical rank unchanged).
+static void gdakiRsExchOf(const struct gdakiRsEndpoint& e, const struct gdaki_exch_info& base, uint32_t spareQpn,
+                          struct gdaki_exch_info* out) {
+  *out = base;
+  out->lid = (int)e.lid;
+  out->qpn = (int)spareQpn;
+  memcpy(out->gid.raw, e.gid, 16);
+  memcpy(out->vgid.raw, e.gid, 16);
+  out->gid_index = e.gidIndex;
+  out->active_mtu = (enum ibv_mtu)e.activeMtu;
+  out->ordering_semantic = (enum doca_verbs_qp_ordering_semantic)e.ordering;
+}
+
+// Park a REJOIN read on the listen socket (the accept step calls this; the socket stays open and becomes the installed
+// one on acceptance). Replaces and closes an earlier un-taken REJOIN of the same peer.
+static void gdakiRsRejoinPark(struct gdakiRecHost* r, int from, int fd, const struct gdakiTsMsg& m) {
+  std::lock_guard<std::mutex> lk(gdakiRsRejMu);
+  struct gdakiRsRejoinState* e = gdakiRsRejGetLocked(r, from);
+  if (e->parkedFd >= 0 && e->parkedFd != fd) close(e->parkedFd);
+  e->parkedFd = fd;
+  e->parkedMsg = m;
+  e->parkedMs = gdakiQ4MonoMs();
+}
+// A parked REJOIN that nobody took within 1000 ms is closed (the spare dials again until its deadline). Called by the
+// reconnect step on every pass.
+static void gdakiRsRejoinExpire(struct gdakiRecHost* r) {
+  std::lock_guard<std::mutex> lk(gdakiRsRejMu);
+  const double now = gdakiQ4MonoMs();
+  for (auto& e : gdakiRsRej)
+    if (e.r == r && e.parkedFd >= 0 && now - e.parkedMs > 1000.0) {  // any un-taken REJOIN, also after an accepted one
+      close(e.parkedFd);
+      e.parkedFd = -1;
+    }
+}
+
+// The REJOIN acceptance entry point (rs_spare_api.h gdakiRsRejoinAccept). The hold state machine calls it on a held peer.
+// The state (known incarnation, death marks, address, endpoint) changes only once REJOIN_ACK went out: a REJOIN that
+// cannot be answered leaves everything as it was, so the spare's next REJOIN of the same incarnation still qualifies.
+[[maybe_unused]] static int gdakiRsRejoinAccept(struct gdakiRecHost* r, int peer, char* why, size_t whyLen) {
+  struct gdakiTs* ts = r->ts;
+  if (ts == nullptr || peer < 0 || peer >= (int)ts->peers.size() || peer == r->ctx->rank) {
+    snprintf(why, whyLen, "rank %d is not a peer of this context", peer);
+    return GDAKI_RS_REJOIN_NONE;
+  }
+  int fd = -1;
+  struct gdakiTsMsg m;
+  uint32_t knownInc = 0;
+  {
+    std::lock_guard<std::mutex> lk(gdakiRsRejMu);
+    struct gdakiRsRejoinState* e = gdakiRsRejFindLocked(r, peer);
+    if (e == nullptr || e->parkedFd < 0) { snprintf(why, whyLen, "no REJOIN parked for rank %d", peer); return GDAKI_RS_REJOIN_NONE; }
+    if (gdakiQ4MonoMs() - e->parkedMs > 1000.0) {  // older than the park limit: the spare may have given up on it
+      close(e->parkedFd);
+      e->parkedFd = -1;
+      snprintf(why, whyLen, "the REJOIN parked for rank %d expired", peer);
+      return GDAKI_RS_REJOIN_NONE;
+    }
+    fd = e->parkedFd;
+    e->parkedFd = -1;  // taken: from here this function owns fd (closes it or installs it)
+    m = e->parkedMsg;
+    knownInc = e->knownInc;
+  }
+  auto refuse = [&](const char* w) -> int {
+    snprintf(why, whyLen, "%s", w);
+    close(fd);  // FIN; the spare dials again until its deadline
+    return GDAKI_RS_REJOIN_REFUSED;
+  };
+  if (ts->peers[peer].declined) return refuse("the peer is declined");
+  if (!gdakiRsHoldIsHeld(r, peer)) return refuse("the peer is not HELD");
+  uint32_t ownQpn[NCCL_GIN_RECOVERY_MAX_QPS];
+  const int ownNqp = gdakiRsOwnQpns(r, peer, ownQpn, NCCL_GIN_RECOVERY_MAX_QPS);
+  if (ownNqp > NCCL_GIN_RECOVERY_MAX_QPS) return refuse("too many QPs to the peer");
+  char vwhy[192];
+  if (!gdakiRsRejoinValidate(m.executed[0], m.nonce, ts->nonce, m.pad, knownInc, (int)m.nqp, ownNqp, m.tok.remoteQpn,
+                             ownQpn, vwhy, sizeof(vwhy)))
+    return refuse(vwhy);
+  struct gdakiTsPeer& pe = ts->peers[peer];
+  const uint32_t gen = pe.gen + 1;
+  struct gdakiTsMsg ack;
+  memset(&ack, 0, sizeof(ack));
+  ack.type = GDAKI_TS_RS_REJOIN_ACK;
+  ack.from = r->ctx->rank;
+  ack.nonce = ts->nonce;
+  ack.pad = m.pad;
+  ack.round = gen;
+  ack.executed[0] = GDAKI_RS_WIRE_VERSION;
+  ack.executed[1] = gdakiRsSelfInc(r);  // the survivor's own incarnation
+  if (gdakiTsSend(fd, &ack, 200) != 0) return refuse("cannot send REJOIN_ACK");
+  // Accepted: this socket is the peer's helper socket now; clear the death marks and install it, bump the known
+  // incarnation, keep the endpoint and token for the swap.
+  struct gdakiRsEndpoint ep;
+  gdakiRsEndpointFromMsg(m, &ep);
+  {
+    std::lock_guard<std::mutex> lk(gdakiRsRejMu);
+    struct gdakiRsRejoinState* e = gdakiRsRejGetLocked(r, peer);
+    e->knownInc = m.pad;
+    e->haveAccepted = true;
+    e->readyTaken = false;
+    e->rejoinTok = m.tok;
+    e->endpoint = ep;
+  }
+  if (pe.dialFd >= 0) { close(pe.dialFd); pe.dialFd = -1; }
+  if (pe.pendFd >= 0) { close(pe.pendFd); pe.pendFd = -1; }
+  if (pe.probeFd >= 0) { close(pe.probeFd); pe.probeFd = -1; }
+  pe.probeWaiting = false;
+  pe.gone = pe.unknown = pe.left = pe.peerFailed = pe.failedPending = false;
+  pe.deadJudged = false;
+  pe.refusals = 0;
+  pe.deferredReq = false;
+  pe.lostCause[0] = pe.closeCause[0] = '\0';
+  memcpy(&pe.addr, ep.listenAddr, sizeof(union ncclSocketAddress) <= 32 ? sizeof(union ncclSocketAddress) : 32);
+  pe.haveAddr = true;
+  pe.helloSeq = std::max(pe.helloSeq, gen);
+  gdakiTsInstall(r, peer, fd, gen, 0);  // clears lostAfterCommit (gpu-detect hk)
+  snprintf(why, whyLen, "REJOIN accepted from rank %d incarnation %u gen %u", peer, m.pad, gen);
+  return GDAKI_RS_REJOIN_ACCEPTED;
+}
+
+// After ncclGinRecoverPrepare: send the survivor's token (rs_spare_api.h gdakiRsSendToken).
+[[maybe_unused]] static ncclResult_t gdakiRsSendToken(struct gdakiRecHost* r, int peer, const ncclGinRecoverToken_t* local) {
+  struct gdakiTs* ts = r->ts;
+  struct gdakiTsMsg m;
+  memset(&m, 0, sizeof(m));
+  m.type = GDAKI_TS_RS_TOKEN;
+  m.from = r->ctx->rank;
+  m.nonce = ts->nonce;
+  m.pad = gdakiRsPeerInc(r, peer);
+  m.nqp = local->nqp;
+  m.tok = *local;
+  m.executed[0] = GDAKI_RS_WIRE_VERSION;
+  return gdakiTsSend(ts->peers[peer].fd, &m, 1000) == 0 ? ncclSuccess : ncclSystemError;
+}
+
+// A READY record handed by the state machine (rs_spare_api.h gdakiRsTakeReady): the spare's QPs are RTS and its token
+// matches the one REJOIN announced (gdakiRsTokenMatch). Marks READY taken (the endpoint swap needs it).
+[[maybe_unused]] static bool gdakiRsTakeReady(struct gdakiRecHost* r, int peer, const struct gdakiTsMsg* m, char* why,
+                                              size_t whyLen) {
+  struct gdakiTs* ts = r->ts;
+  if (m->type != GDAKI_TS_RS_READY || m->from != peer || m->nonce != ts->nonce) { snprintf(why, whyLen, "not the spare's READY"); return false; }
+  std::lock_guard<std::mutex> lk(gdakiRsRejMu);
+  struct gdakiRsRejoinState* e = gdakiRsRejFindLocked(r, peer);
+  if (e == nullptr || !e->haveAccepted || m->pad != e->knownInc) { snprintf(why, whyLen, "READY for a stale incarnation"); return false; }
+  if (m->nqp > NCCL_GIN_RECOVERY_MAX_QPS ||
+      !gdakiRsTokenMatch(m->nqp, m->tok.qpn, m->tok.sqPsn, e->rejoinTok.nqp, e->rejoinTok.qpn, e->rejoinTok.sqPsn, why,
+                         whyLen))
+    return false;
+  e->readyTaken = true;
+  snprintf(why, whyLen, "READY taken (incarnation %u)", m->pad);
+  return true;
+}
+
+// The endpoint swap (rs_spare_api.h gdakiRsSwapEndpoint, RL7), under r->opMu, before ncclGinRecoverCommit. Needs the
+// accepted REJOIN, READY taken and the peer prepared; nothing changes when any is missing.
+[[maybe_unused]] static ncclResult_t gdakiRsSwapEndpoint(struct gdakiRecHost* r, int peer, ncclGinRecoverToken_t* remote,
+                                                         char* why, size_t whyLen) {
+  struct gdakiRsEndpoint ep;
+  ncclGinRecoverToken_t tok;
+  {
+    std::lock_guard<std::mutex> lk(gdakiRsRejMu);
+    const struct gdakiRsRejoinState* e = gdakiRsRejFindLocked(r, peer);
+    if (e == nullptr || !e->haveAccepted) { snprintf(why, whyLen, "no accepted REJOIN for rank %d", peer); return ncclInvalidUsage; }
+    if (!e->readyTaken) { snprintf(why, whyLen, "the spare's READY was not taken"); return ncclInvalidUsage; }
+    ep = e->endpoint;
+    tok = e->rejoinTok;
+  }
+  if (gdakiRecPrepared(r, peer) != 1) { snprintf(why, whyLen, "the peer is not prepared"); return ncclInvalidUsage; }
+  uint32_t ownQpn[NCCL_GIN_RECOVERY_MAX_QPS];
+  const int n = gdakiRsOwnQpns(r, peer, ownQpn, NCCL_GIN_RECOVERY_MAX_QPS);
+  if (n != (int)tok.nqp || n > NCCL_GIN_RECOVERY_MAX_QPS) { snprintf(why, whyLen, "the QP count changed"); return ncclInvalidUsage; }
+  memset(remote, 0, sizeof(*remote));
+  remote->magic = NCCL_GIN_RECOVERY_TOKEN_MAGIC;
+  remote->nqp = (unsigned)n;
+  gdakiRsBuildCommitToken((unsigned)n, tok.qpn, tok.sqPsn, ownQpn, remote->qpn, remote->remoteQpn, remote->sqPsn,
+                          remote->epochWqes);
+  std::lock_guard<std::mutex> op(r->opMu);
+  int i = 0;
+  gdakiRecForPeer(r, peer, [&](gdakiRecQp& rq, struct doca_gpu_verbs_qp_hl*) {
+    struct gdaki_exch_info ne;
+    gdakiRsExchOf(ep, rq.exch, tok.qpn[i], &ne);
+    rq.exch = ne;  // Commit's token check and reconnect read rq.exch
+    i++;
+  });
+  snprintf(why, whyLen, "endpoint swapped for rank %d (%d QPs)", peer, n);
+  return ncclSuccess;
+}
+
+// Read or write exactly n bytes on a non-blocking socket before an absolute deadline (gdakiQ4MonoMs).
+static bool gdakiRsIoAll(int fd, void* p, size_t n, bool write, double deadline) {
+  size_t off = 0;
+  while (off < n) {
+    const ssize_t k = write ? send(fd, (const char*)p + off, n - off, MSG_NOSIGNAL | MSG_DONTWAIT)
+                            : recv(fd, (char*)p + off, n - off, MSG_DONTWAIT);
+    if (k > 0) { off += (size_t)k; continue; }
+    if (k == 0 && !write) return false;
+    if (k < 0 && errno != EAGAIN && errno != EWOULDBLOCK && errno != EINTR) return false;
+    const int rem = (int)(deadline - gdakiQ4MonoMs());
+    if (rem <= 0) return false;
+    struct pollfd pf = {fd, (short)(write ? POLLOUT : POLLIN), 0};
+    (void)poll(&pf, 1, std::min(rem, 5));
+  }
+  return true;
+}
+
+// The rkey list handed over the data socket (rs_spare_api.h gdakiRsRkeysRecv): header + count entries, the whole within
+// timeoutMs.
+[[maybe_unused]] static ncclResult_t gdakiRsRkeysRecv(int fd, int timeoutMs, struct gdakiRsRkeys* out, char* why,
+                                                      size_t whyLen) {
+  const double deadline = gdakiQ4MonoMs() + timeoutMs;
+  struct gdakiRsRkeysHdr h;
+  if (!gdakiRsIoAll(fd, &h, sizeof(h), false, deadline) || h.magic != GDAKI_RS_RKEYS_MAGIC || h.version != 1u ||
+      h.count > GDAKI_RS_RKEYS_MAX) {
+    snprintf(why, whyLen, "the rkey list header is damaged, too large or late");
+    return ncclSystemError;
+  }
+  out->rank = h.rank;
+  out->incarnation = h.incarnation;
+  out->nonce = h.nonce;
+  out->e.resize(h.count);
+  if (h.count && !gdakiRsIoAll(fd, out->e.data(), sizeof(struct gdakiRsRkeyEntry) * h.count, false, deadline)) {
+    snprintf(why, whyLen, "the rkey list is cut or late");
+    return ncclSystemError;
+  }
+  snprintf(why, whyLen, "received %u rkey entries from rank %d", h.count, h.rank);
+  return ncclSuccess;
+}
+// The spare side: write the list on a data-socket fd within timeoutMs.
+static ncclResult_t gdakiRsRkeysSend(int fd, const struct gdakiRsRkeys& list, int timeoutMs) {
+  const double deadline = gdakiQ4MonoMs() + timeoutMs;
+  struct gdakiRsRkeysHdr h;
+  memset(&h, 0, sizeof(h));
+  h.magic = GDAKI_RS_RKEYS_MAGIC;
+  h.version = 1u;
+  h.rank = list.rank;
+  h.incarnation = list.incarnation;
+  h.nonce = list.nonce;
+  h.count = (uint32_t)list.e.size();
+  if (!gdakiRsIoAll(fd, &h, sizeof(h), true, deadline)) return ncclSystemError;
+  if (h.count && !gdakiRsIoAll(fd, (void*)list.e.data(), sizeof(struct gdakiRsRkeyEntry) * h.count, true, deadline))
+    return ncclSystemError;
+  return ncclSuccess;
+}
+// The spare's own rkey list: every window registered on its context's collComm (by number) with this process's rkey, the
+// signal table's and the counter table's rkey.
+static void gdakiRsSpareRkeys(struct gdakiRecHost* r, uint32_t incarnation, struct gdakiRsRkeys* out) {
+  struct gdaki_context* g = r->ctx;
+  out->rank = g->rank;
+  out->incarnation = incarnation;
+  out->nonce = r->ts->nonce;
+  out->e.clear();
+  {
+    std::lock_guard<std::mutex> lk(gdakiRsWinMu);
+    for (const auto& w : gdakiRsWins)
+      if (w.coll == (void*)g->collComm && !w.gone && w.mhandle != nullptr)
+        out->e.push_back({GDAKI_RS_RKEY_WINDOW, w.id, htobe32(((struct gdaki_mem_handle*)w.mhandle)->mr->rkey), 0});
+  }
+  if (g->signals_table != nullptr && g->signals_table->mr != nullptr)
+    out->e.push_back({GDAKI_RS_RKEY_SIGNALS, 0, htobe32(g->signals_table->mr->rkey), 0});
+  if (g->counters_table != nullptr && g->counters_table->mr != nullptr)
+    out->e.push_back({GDAKI_RS_RKEY_COUNTERS, 0, htobe32(g->counters_table->mr->rkey), 0});
+}
+
+// Write slot `peer` of one device rkey table (nranks big-endian entries) to `rkeyBe` over the NIC copy path, read it back
+// and compare (no CUDA call). `rkeysDev` points at the table's device base.
+static ncclResult_t gdakiRsWriteRkeySlot(struct gdakiRecHost* r, const __be32* rkeysDev, int peer, __be32 rkeyBe,
+                                         char* why, size_t whyLen) {
+  const void* dev = (const void*)(rkeysDev + peer);
+  memcpy(r->pinned, &rkeyBe, sizeof(__be32));
+  if (gdakiLbXfer(r, true, dev, sizeof(__be32)) != ncclSuccess) { snprintf(why, whyLen, "NIC write of the rkey slot failed"); return ncclSystemError; }
+  if (gdakiLbXfer(r, false, dev, sizeof(__be32)) != ncclSuccess) { snprintf(why, whyLen, "NIC read-back of the rkey slot failed"); return ncclSystemError; }
+  __be32 got = 0;
+  memcpy(&got, r->pinned, sizeof(__be32));
+  if (got != rkeyBe) { snprintf(why, whyLen, "the rkey slot read back does not match"); return ncclSystemError; }
+  return ncclSuccess;
+}
+
+// The rkey swap (rs_spare_api.h gdakiRsSwapRkeys, RL9), after Commit and gdakiTsBaseline, before the publish. The list must
+// be the accepted incarnation's, from that peer, for this context (nonce), and name every window still registered on this
+// context's collComm; a window's host copy of its rkey table is updated too (the signal and counter tables' host copies are
+// read only at setup and are left as they are).
+[[maybe_unused]] static ncclResult_t gdakiRsSwapRkeys(struct gdakiRecHost* r, int peer, const struct gdakiRsRkeys* list,
+                                                      char* why, size_t whyLen) {
+  struct gdaki_context* g = r->ctx;
+  if (list->rank != peer || list->nonce != r->ts->nonce) { snprintf(why, whyLen, "the rkey list is not this peer's for this context"); return ncclInvalidUsage; }
+  if (list->incarnation != gdakiRsPeerInc(r, peer)) { snprintf(why, whyLen, "the rkey list is for a stale incarnation"); return ncclInvalidUsage; }
+  if (!gdakiLbOn(r)) { snprintf(why, whyLen, "the NIC copy path is off"); return ncclSystemError; }
+  struct WinSlot { const __be32* rkeys; __be32* host; uint32_t id; bool seen; };
+  std::vector<struct WinSlot> wins;
+  {
+    std::lock_guard<std::mutex> lk(gdakiRsWinMu);
+    for (const auto& w : gdakiRsWins)
+      if (w.coll == (void*)g->collComm && !w.gone) {
+        struct gdaki_mem_handle* mh = (struct gdaki_mem_handle*)w.mhandle;
+        __be32* host = (mh != nullptr && mh->rkeys_hd_mhandle != nullptr) ? (__be32*)mh->rkeys_hd_mhandle->host_buf : nullptr;
+        wins.push_back({(const __be32*)w.rkeys, host, w.id, false});
+      }
+  }
+  for (const auto& en : list->e) {
+    if (en.kind == GDAKI_RS_RKEY_SIGNALS) {
+      if (g->signals_table == nullptr) continue;
+      if (gdakiRsWriteRkeySlot(r, (const __be32*)g->signals_table->get_rkeys_d(), peer, (__be32)en.rkeyBe, why, whyLen) != ncclSuccess) return ncclSystemError;
+    } else if (en.kind == GDAKI_RS_RKEY_COUNTERS) {
+      if (g->counters_table == nullptr) continue;
+      if (gdakiRsWriteRkeySlot(r, (const __be32*)g->counters_table->get_rkeys_d(), peer, (__be32)en.rkeyBe, why, whyLen) != ncclSuccess) return ncclSystemError;
+    } else if (en.kind == GDAKI_RS_RKEY_WINDOW) {
+      struct WinSlot* ws = nullptr;
+      for (auto& w : wins)
+        if (w.id == en.id) ws = &w;
+      if (ws == nullptr) { snprintf(why, whyLen, "window number %u of the rkey list is not registered here", en.id); return ncclInvalidUsage; }
+      if (gdakiRsWriteRkeySlot(r, ws->rkeys, peer, (__be32)en.rkeyBe, why, whyLen) != ncclSuccess) return ncclSystemError;
+      if (ws->host != nullptr) ws->host[peer] = (__be32)en.rkeyBe;
+      ws->seen = true;
+    }
+  }
+  for (const auto& w : wins)
+    if (!w.seen) { snprintf(why, whyLen, "window number %u is registered here but missing from the rkey list", w.id); return ncclInvalidUsage; }
+  snprintf(why, whyLen, "swapped %zu rkey slots for rank %d", list->e.size(), peer);
+  return ncclSuccess;
+}
+
+// After the publish: DONE_RS (rs_spare_api.h gdakiRsSendDone).
+[[maybe_unused]] static ncclResult_t gdakiRsSendDone(struct gdakiRecHost* r, int peer) {
+  struct gdakiTs* ts = r->ts;
+  struct gdakiTsMsg m;
+  memset(&m, 0, sizeof(m));
+  m.type = GDAKI_TS_RS_DONE;
+  m.from = r->ctx->rank;
+  m.nonce = ts->nonce;
+  m.pad = gdakiRsPeerInc(r, peer);
+  m.executed[0] = GDAKI_RS_WIRE_VERSION;
+  return gdakiTsSend(ts->peers[peer].fd, &m, 1000) == 0 ? ncclSuccess : ncclSystemError;
+}
+// A RESTORED record handed by the state machine (rs_spare_api.h gdakiRsTakeRestored).
+[[maybe_unused]] static bool gdakiRsTakeRestored(struct gdakiRecHost* r, int peer, const struct gdakiTsMsg* m) {
+  struct gdakiTs* ts = r->ts;
+  return m->type == GDAKI_TS_RS_RESTORED && m->from == peer && m->nonce == ts->nonce &&
+         m->pad == gdakiRsPeerInc(r, peer);
+}
+
+// ---- the spare process's side ----
+// Read /proc/<pid>/stat into a probe (state field and start-time field 22). The spare and the original share a node.
+static struct gdakiRsActProbe gdakiRsProbePid(long long pid) {
+  struct gdakiRsActProbe p;
+  if (pid <= 0) return p;
+  char path[64];
+  snprintf(path, sizeof(path), "/proc/%lld/stat", pid);
+  FILE* f = fopen(path, "r");
+  if (f == nullptr) return p;  // exists stays false
+  p.exists = true;
+  // "pid (comm) state ..." then fields; the comm can hold spaces and ')', so split on the last ')'.
+  char buf[1024];
+  const size_t n = fread(buf, 1, sizeof(buf) - 1, f);
+  fclose(f);
+  buf[n] = '\0';
+  const char* rp = strrchr(buf, ')');
+  if (rp == nullptr) return p;
+  const char* s = rp + 1;
+  while (*s == ' ') s++;
+  p.state = *s;
+  // field 22 (starttime) is the 20th whitespace-separated token after state
+  int field = 3;  // state is field 3 (1 = pid, 2 = comm)
+  const char* t = s;
+  while (*t && field < 22) {
+    while (*t && *t != ' ') t++;
+    while (*t == ' ') t++;
+    field++;
+  }
+  if (*t) p.start = strtoull(t, nullptr, 10);
+  return p;
+}
+
+// Send ACTIVATE to the spare's activation port and read its answer (rs_spare_api.h gdakiRsSendActivate). The buddy's
+// helper calls it (host branch); bounded. Returns the spare's answer kind, or -1.
+[[maybe_unused]] static int gdakiRsSendActivate(const void* spareAddr, const struct gdakiRsActivate* a, int timeoutMs) {
+  const union ncclSocketAddress* sa = (const union ncclSocketAddress*)spareAddr;
+  const socklen_t alen = sa->sa.sa_family == AF_INET6 ? sizeof(sa->sin6) : sizeof(sa->sin);
+  const int fd = socket(sa->sa.sa_family, SOCK_STREAM, 0);
+  if (fd < 0) return -1;
+  gdakiTsSockOpts(fd);
+  const double deadline = gdakiQ4MonoMs() + timeoutMs;
+  int rc = connect(fd, &sa->sa, alen);
+  if (rc != 0 && errno == EINPROGRESS) {
+    struct pollfd pf = {fd, POLLOUT, 0};
+    int err = 0;
+    socklen_t el = sizeof(err);
+    if (poll(&pf, 1, std::max(1, (int)(deadline - gdakiQ4MonoMs()))) != 1 ||
+        getsockopt(fd, SOL_SOCKET, SO_ERROR, &err, &el) != 0 || err != 0) { close(fd); return -1; }
+  } else if (rc != 0) { close(fd); return -1; }
+  size_t off = 0;
+  const char* p = (const char*)a;
+  while (off < sizeof(*a)) {
+    ssize_t k = send(fd, p + off, sizeof(*a) - off, MSG_NOSIGNAL | MSG_DONTWAIT);
+    if (k > 0) { off += (size_t)k; continue; }
+    if (k < 0 && (errno == EAGAIN || errno == EWOULDBLOCK || errno == EINTR)) {
+      if (gdakiQ4MonoMs() > deadline) { close(fd); return -1; }
+      struct pollfd pf = {fd, POLLOUT, 0};
+      (void)poll(&pf, 1, 5);
+      continue;
+    }
+    close(fd);
+    return -1;
+  }
+  struct gdakiRsActivate ans;
+  off = 0;
+  while (off < sizeof(ans)) {
+    ssize_t k = recv(fd, (char*)&ans + off, sizeof(ans) - off, MSG_DONTWAIT);
+    if (k > 0) { off += (size_t)k; continue; }
+    if (k == 0) { close(fd); return -1; }
+    if (k < 0 && (errno == EAGAIN || errno == EWOULDBLOCK || errno == EINTR)) {
+      if (gdakiQ4MonoMs() > deadline) { close(fd); return -1; }
+      struct pollfd pf = {fd, POLLIN, 0};
+      (void)poll(&pf, 1, 5);
+      continue;
+    }
+    close(fd);
+    return -1;
+  }
+  close(fd);
+  if (ans.magic != GDAKI_RS_ACT_MAGIC) return -1;
+  return (int)ans.kind;
+}
+
+// Blocking receive of one record on a bare fd (the spare dials the survivor; a temp peer gives the framing).
+static int gdakiRsRecvOn(int fd, struct gdakiTsMsg* out, int timeoutMs, std::atomic<bool>* stop) {
+  struct gdakiTsPeer tmp;
+  tmp.fd = fd;
+  return gdakiTsRecv(tmp, out, timeoutMs, stop);
+}
+
+// The spare gives up: every survivor socket it holds is closed with a plain close (a FIN, never BYE), marked gone, and its
+// listen socket is closed without the BYE drain, so the communicator's teardown (gdakiTsStop, gdakiTsCloseAll) has nothing
+// left to send BYE on. The survivors read death and fall back (rs_spare_api.h; 9.10.7 N2).
+static void gdakiRsSpareGiveUp(struct gdakiRecHost* r, int extraFd) {
+  struct gdakiTs* ts = r->ts;
+  if (extraFd >= 0) close(extraFd);
+  for (auto& pe : ts->peers) {
+    if (pe.fd >= 0) close(pe.fd);
+    pe.fd = -1;
+    pe.gone = true;
+    pe.have = 0;
+  }
+  if (ts->listenFd >= 0) close(ts->listenFd);
+  ts->listenFd = -1;
+}
+
+// The spare process's activation and REJOIN handshake (EXPERIMENT.md 9.3, 9.10.5, 9.11.3 M4). Runs on the spare after the
+// init replay, when the application resumes the restored communicator (the spare's ncclGinRestoreResume; integration
+// wires the call, none exists in this build: [[maybe_unused]]).
+//  (1) The activation socket on NCCL_GIN_RESTORE_SPARE_PORT: the buddy's ACTIVATE (its rank and the context's nonce must
+//      match) gives the new incarnation, the checkpoint step and the original's PID and start time; the gate
+//      (gdakiRsActExamine on /proc) answers ACCEPTED only when the original is gone. Bounded by activateWaitMs; each
+//      record read by 500 ms.
+//  (2) Every gated survivor, one after the other, within handshakeMs: dial its recorded listen address and send REJOIN (this
+//      spare's QPNs and fresh send PSNs, its recorded view of the survivor's QPNs, its endpoint); a closed connection or
+//      no REJOIN_ACK within 1500 ms means "not taken yet" and the spare dials again after 200 ms; FAIL or BYE means the
+//      survivor declined or leaves: gone, never dialled again, and the restore fails. (The spare waits 1500 ms for the
+//      REJOIN_ACK, longer than a survivor keeps a REJOIN parked, 1000 ms, so it never abandons a REJOIN that is
+//      accepted.) After REJOIN_ACK (whose round is the connection generation) the spare's rkey list goes on the data
+//      socket the caller gives (dataFd), then TOKEN ->
+//      connect each QP RTR/RTS (receive PSN = the survivor's new send PSN, send PSN = the announced one) -> READY ->
+//      DONE_RS.
+//  (3) RESTORED to every survivor, then the helper starts (it then owns the installed sockets).
+// Any failure ends without BYE (gdakiRsSpareGiveUp). *stepOut: the checkpoint step to restore from.
+[[maybe_unused]] static ncclResult_t gdakiRsSpareRun(struct gdakiRecHost* r, int activatePort, int activateWaitMs,
+                                                     int handshakeMs, int (*dataFd)(void* arg, int peer), void* dataArg,
+                                                     uint64_t* stepOut) {
+  struct gdakiTs* ts = r->ts;
+  struct gdaki_context* g = r->ctx;
+  const int rank = g->rank;
+  // (1) the activation socket and the gate
+  union ncclSocketAddress aAddr;
+  char ifName[MAX_IF_NAME_SIZE + 1];
+  int nIfs = 0;
+  if (ncclFindInterfaces(ifName, &aAddr, MAX_IF_NAME_SIZE, 1, &nIfs) != ncclSuccess || nIfs == 0) {
+    gdakiRsSpareGiveUp(r, -1);
+    return ncclSystemError;
+  }
+  if (aAddr.sa.sa_family == AF_INET6) aAddr.sin6.sin6_port = htons((uint16_t)activatePort);
+  else aAddr.sin.sin_port = htons((uint16_t)activatePort);
+  const socklen_t aLen = aAddr.sa.sa_family == AF_INET6 ? sizeof(aAddr.sin6) : sizeof(aAddr.sin);
+  int as = socket(aAddr.sa.sa_family, SOCK_STREAM, 0);
+  int one = 1;
+  if (as < 0 || setsockopt(as, SOL_SOCKET, SO_REUSEADDR, &one, sizeof(one)) != 0 || bind(as, &aAddr.sa, aLen) != 0 ||
+      listen(as, 4) != 0) {
+    if (as >= 0) close(as);
+    WARN("GIN/RS: spare rank %d: cannot open the activation socket on port %d", rank, activatePort);
+    gdakiRsSpareGiveUp(r, -1);
+    return ncclSystemError;
+  }
+  struct gdakiRsActivate act;
+  memset(&act, 0, sizeof(act));
+  bool activated = false;
+  const double actDeadline = gdakiQ4MonoMs() + activateWaitMs;
+  while (!activated && gdakiQ4MonoMs() < actDeadline) {
+    struct pollfd pf = {as, POLLIN, 0};
+    if (poll(&pf, 1, 100) != 1) continue;
+    const int fd = accept(as, nullptr, nullptr);
+    if (fd < 0) continue;
+    gdakiTsSockOpts(fd);
+    if (!gdakiRsIoAll(fd, &act, sizeof(act), false, gdakiQ4MonoMs() + 500.0) || act.magic != GDAKI_RS_ACT_MAGIC ||
+        act.kind != GDAKI_RS_ACT_ACTIVATE || act.nonce != ts->nonce || act.rank != rank) {
+      close(fd);
+      continue;
+    }
+    char why[192];
+    const struct gdakiRsActProbe probe = gdakiRsProbePid((long long)act.pid);
+    const int verdict = gdakiRsActExamine((long long)act.pid, act.pidStart, probe, why, sizeof(why));
+    struct gdakiRsActivate ans = act;
+    ans.kind = verdict == GDAKI_RS_ACT_GO ? GDAKI_RS_ACT_ACCEPTED : GDAKI_RS_ACT_REFUSED;
+    (void)gdakiRsIoAll(fd, &ans, sizeof(ans), true, gdakiQ4MonoMs() + 500.0);
+    close(fd);
+    if (verdict == GDAKI_RS_ACT_GO) {
+      WARN("GIN/RS: spare rank %d: activating incarnation %u from step %llu (%s)", rank, act.incarnation,
+           (unsigned long long)act.step, why);
+      activated = true;
+    } else {
+      WARN("GIN/RS: spare rank %d: activation refused (%s); waiting", rank, why);
+    }
+  }
+  close(as);
+  if (!activated) {
+    WARN("GIN/RS: spare rank %d: no usable ACTIVATE within %d ms", rank, activateWaitMs);
+    gdakiRsSpareGiveUp(r, -1);
+    return ncclSystemError;
+  }
+  const uint32_t incarnation = act.incarnation;
+  if (stepOut) *stepOut = act.step;
+  gdakiRsSetSelfInc(r, incarnation);  // carried in this spare's reconnect HELLO/PROBE pad (fencing)
+  // this spare's endpoint (the same for every QP of its context): its new helper listen address and its GID/LID
+  struct gdaki_exch_info self;
+  gdakiFillExchInfo(&self, g, g->gqps[rank]);
+  struct gdakiRsEndpoint ep;
+  gdakiRsEndpointOf(self, ts->listenAddr, act.step, &ep);
+  struct gdakiRsRkeys keys;
+  gdakiRsSpareRkeys(r, incarnation, &keys);
+  // (2) every gated survivor
+  const double deadline = gdakiQ4MonoMs() + handshakeMs;
+  auto rem = [&]() { return std::max(1, (int)(deadline - gdakiQ4MonoMs())); };
+  std::vector<int> xs(ts->peers.size(), GDAKI_RS_XS_HELD);  // this spare's mirror of each exchange's order
+  for (int p = 0; p < (int)ts->peers.size(); p++) {
+    struct gdakiTsPeer& pe = ts->peers[p];
+    if (!pe.gated || p == rank) continue;
+    struct gdakiTsMsg m;
+    memset(&m, 0, sizeof(m));
+    m.type = GDAKI_TS_RS_REJOIN;
+    m.from = rank;
+    m.nonce = ts->nonce;
+    m.pad = incarnation;
+    m.executed[0] = GDAKI_RS_WIRE_VERSION;
+    m.executed[1] = incarnation;
+    unsigned nqp = 0;
+    bool tooMany = false;
+    gdakiRecForPeer(r, p, [&](gdakiRecQp& rq, struct doca_gpu_verbs_qp_hl* q) {
+      if (nqp >= NCCL_GIN_RECOVERY_MAX_QPS) { tooMany = true; return; }
+      m.tok.qpn[nqp] = gdakiRecQpn(q);               // this spare's QPN
+      m.tok.remoteQpn[nqp] = (unsigned)rq.exch.qpn;  // the survivor's QPN (recorded)
+      m.tok.sqPsn[nqp] = r->rng() & 0xffffff;        // this spare's send PSN
+      nqp++;
+    });
+    if (tooMany) { gdakiRsSpareGiveUp(r, -1); return ncclSystemError; }
+    m.nqp = nqp;
+    m.tok.magic = NCCL_GIN_RECOVERY_TOKEN_MAGIC;
+    m.tok.nqp = nqp;
+    gdakiRsEndpointToMsg(ep, &m);
+    // dial and REJOIN until a REJOIN_ACK, a refusal (FAIL/BYE: gone) or the deadline
+    int fd = -1;
+    struct gdakiTsMsg in;
+    while (true) {
+      if (gdakiQ4MonoMs() >= deadline) {
+        WARN("GIN/RS: spare rank %d: rank %d did not take the REJOIN within the deadline", rank, p);
+        gdakiRsSpareGiveUp(r, fd);
+        return ncclSystemError;
+      }
+      const socklen_t alen = pe.addr.sa.sa_family == AF_INET6 ? sizeof(pe.addr.sin6) : sizeof(pe.addr.sin);
+      fd = socket(pe.addr.sa.sa_family, SOCK_STREAM, 0);
+      if (fd < 0) { gdakiRsSpareGiveUp(r, -1); return ncclSystemError; }
+      gdakiTsSockOpts(fd);
+      bool up = false;
+      const int rc = connect(fd, &pe.addr.sa, alen);
+      if (rc == 0) up = true;
+      else if (errno == EINPROGRESS) {
+        struct pollfd pf = {fd, POLLOUT, 0};
+        int err = 0;
+        socklen_t el = sizeof(err);
+        up = poll(&pf, 1, std::min(rem(), 500)) == 1 && getsockopt(fd, SOL_SOCKET, SO_ERROR, &err, &el) == 0 && err == 0;
+      }
+      int got = 0;
+      // wait longer (1500 ms) than a survivor keeps a REJOIN parked (1000 ms): an accepted REJOIN is never one this spare
+      // already gave up on
+      if (up && gdakiTsSend(fd, &m, std::min(rem(), 500)) == 0) got = gdakiRsRecvOn(fd, &in, std::min(rem(), 1500), &ts->stop);
+      if (got == 1 && (in.type == GDAKI_TS_FAIL || in.type == GDAKI_TS_BYE) && in.from == p && in.nonce == ts->nonce) {
+        WARN("GIN/RS: spare rank %d: rank %d answered the REJOIN with %s: it is gone for this restore", rank, p,
+             gdakiTsMsgName(in.type));
+        gdakiRsSpareGiveUp(r, fd);
+        return ncclSystemError;
+      }
+      if (got == 1 && in.type == GDAKI_TS_RS_REJOIN_ACK && in.from == p && in.nonce == ts->nonce && in.pad == incarnation)
+        break;
+      close(fd);  // not taken yet (closed, refused or late): dial again
+      fd = -1;
+      std::this_thread::sleep_for(std::chrono::milliseconds(200));
+    }
+    xs[p] = gdakiRsXchgStep(xs[p], GDAKI_RS_EV_REJOIN);
+    pe.fd = fd;  // held from here: a failure below closes it without BYE (gdakiRsSpareGiveUp)
+    pe.gone = pe.unknown = false;
+    pe.have = 0;
+    pe.gen = (uint32_t)in.round;  // the survivor's connection generation
+    pe.helloSeq = std::max(pe.helloSeq, pe.gen);
+    gdakiRsSetPeerInc(r, p, in.executed[1]);  // the survivor's own incarnation, for the HELLO/PROBE fencing
+    // the rkey list on the data socket (work package 5's; the caller gives it), before this spare waits for DONE_RS
+    const int dfd = dataFd != nullptr ? dataFd(dataArg, p) : -1;
+    if (dfd < 0 || gdakiRsRkeysSend(dfd, keys, rem()) != ncclSuccess) {
+      WARN("GIN/RS: spare rank %d: cannot hand its rkey list to rank %d (%s)", rank, p,
+           dfd < 0 ? "no data socket in this build" : "send failed");
+      gdakiRsSpareGiveUp(r, -1);
+      return ncclSystemError;
+    }
+    // TOKEN (the survivor's Prepare token: its QPNs and new send PSNs)
+    if (gdakiRsRecvOn(fd, &in, rem(), &ts->stop) != 1 || in.type != GDAKI_TS_RS_TOKEN || in.nonce != ts->nonce ||
+        in.from != p || in.pad != incarnation || in.nqp != nqp || in.tok.nqp != nqp) {
+      gdakiRsSpareGiveUp(r, -1);
+      return ncclSystemError;
+    }
+    for (unsigned i = 0; i < nqp; i++)
+      if (in.tok.qpn[i] != m.tok.remoteQpn[i]) { gdakiRsSpareGiveUp(r, -1); return ncclSystemError; }  // its QPNs as recorded
+    xs[p] = gdakiRsXchgStep(xs[p], GDAKI_RS_EV_PREPARE);
+    unsigned i = 0;
+    bool bad = false;
+    gdakiRecForPeer(r, p, [&](gdakiRecQp& rq, struct doca_gpu_verbs_qp_hl* q) {
+      if (bad || i >= nqp) return;
+      if (gdakiConnectQp(g, q, &rq.exch, rq.lag, in.tok.sqPsn[i], m.tok.sqPsn[i]) != ncclSuccess) bad = true;
+      uint32_t rmsn = 0, st = 0;  // the responder MSN baseline of this incarnation, now that the QP is RTS
+      if (!bad && doca_verbs_qp_query_seq(q->qp, &rmsn, nullptr, nullptr, &st) == DOCA_SUCCESS)
+        ts->qs[rq.qpIdx].rmsn0 = rmsn;
+      i++;
+    });
+    if (bad) { gdakiRsSpareGiveUp(r, -1); return ncclSystemError; }
+    xs[p] = gdakiRsXchgStep(xs[p], GDAKI_RS_EV_READY);
+    struct gdakiTsMsg ready;
+    memset(&ready, 0, sizeof(ready));
+    ready.type = GDAKI_TS_RS_READY;
+    ready.from = rank;
+    ready.nonce = ts->nonce;
+    ready.pad = incarnation;
+    ready.nqp = nqp;
+    ready.tok = m.tok;  // this spare's QPNs and send PSNs, as announced
+    ready.executed[0] = GDAKI_RS_WIRE_VERSION;
+    ready.executed[1] = incarnation;
+    if (gdakiTsSend(fd, &ready, rem()) != 0) { gdakiRsSpareGiveUp(r, -1); return ncclSystemError; }
+    // DONE_RS (the survivor committed, baselined, swapped rkeys and published)
+    if (gdakiRsRecvOn(fd, &in, rem(), &ts->stop) != 1 || in.type != GDAKI_TS_RS_DONE || in.nonce != ts->nonce ||
+        in.from != p || in.pad != incarnation || xs[p] != GDAKI_RS_XS_READY) {
+      gdakiRsSpareGiveUp(r, -1);
+      return ncclSystemError;
+    }
+  }
+  // (3) RESTORED to every survivor, then the helper (which then owns the sockets)
+  for (int p = 0; p < (int)ts->peers.size(); p++) {
+    if (!ts->peers[p].gated || p == rank || ts->peers[p].fd < 0) continue;
+    struct gdakiTsMsg done;
+    memset(&done, 0, sizeof(done));
+    done.type = GDAKI_TS_RS_RESTORED;
+    done.from = rank;
+    done.nonce = ts->nonce;
+    done.pad = incarnation;
+    done.executed[0] = GDAKI_RS_WIRE_VERSION;
+    done.executed[1] = incarnation;
