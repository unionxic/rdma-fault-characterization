+// the context array (qp index = peer + context * nranks), then the send-side log rings (one per logged QP). The send-side
+// log holds descriptors only (user decision 2026-10-12): replay re-reads the data from the sender's source window. Every
+// program is built with this layer's headers (the layout may change with later work packages).
+#define NCCL_GIN_RS_SIDE_MAGIC 0x32535352u  // "RSS2" (work package 4: descriptor-only log)
