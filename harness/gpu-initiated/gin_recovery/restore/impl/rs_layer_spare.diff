+}
+struct gdakiRsWin {
+  void* coll = nullptr;        // the GIN collComm it was registered on
+  void* mhandle = nullptr;     // its gdaki_mem_handle
+  uintptr_t lo = 0, hi = 0;    // the registered range
+  void* rkeys = nullptr;       // its rkey table (device), nranks entries
+  size_t rkeysBytes = 0;
+  uint64_t seq = 0;
+  bool gone = false;
+  uint64_t goneSeq = 0;        // the sequence when it was deregistered
+  uint32_t id = 0;             // work package 4: its number on its collComm (ncclGinGdakiMemHandle::rsWinId; log entries)
+  void* devHandle = nullptr;   // its device handle (the ncclGinWindow_t the device code gets)
+};
+static std::mutex gdakiRsWinMu;
+static std::vector<struct gdakiRsWin> gdakiRsWins;
+static uint64_t gdakiRsWinSeq = 0;  // gdakiRsWinMu
+// gdakiRsWinMu: per GIN collComm, the numbers given so far. A window's number is its registration order on its collComm
+// (from 1; a deregistration does not give a number back). Every rank registers the same windows on a collComm in the same
+// order (the registration is collective: its rkey all-gather), and a spare process replays that order, so the number of a
+// window is the same on every rank and the receiver of a log entry can name the window by it (EXPERIMENT.md 9.5).
+static std::vector<std::pair<void*, uint32_t>> gdakiRsWinIds;
+static uint32_t gdakiRsWinNextId(void* coll) {
+  std::lock_guard<std::mutex> lk(gdakiRsWinMu);
+  for (auto& c : gdakiRsWinIds)
+    if (c.first == coll) return c.second == 0xffffffffu ? 0u : ++c.second;  // exhausted: 0 (no number)
+  gdakiRsWinIds.emplace_back(coll, 1u);
+  return 1u;
+}
+static void gdakiRsWinNote(void* coll, void* mhandle, const void* data, size_t size, void* rkeys, size_t rkeysBytes,
+                           uint32_t id, void* devHandle) {
+  std::lock_guard<std::mutex> lk(gdakiRsWinMu);
+  struct gdakiRsWin w;
+  w.id = id;
+  w.devHandle = devHandle;
+  w.coll = coll;
+  w.mhandle = mhandle;
+  w.lo = (uintptr_t)data;
+  w.hi = (uintptr_t)data + size;
+  w.rkeys = rkeys;
+  w.rkeysBytes = rkeysBytes;
+  w.seq = ++gdakiRsWinSeq;
+  gdakiRsWins.push_back(w);
+}
+static void gdakiRsWinGone(void* mhandle) {
+  std::lock_guard<std::mutex> lk(gdakiRsWinMu);
+  for (auto& w : gdakiRsWins)
+    if (w.mhandle == mhandle && !w.gone) {
+      w.gone = true;
+      w.goneSeq = ++gdakiRsWinSeq;
+    }
+}
+static uint64_t gdakiRsWinSeqNow() {
+  std::lock_guard<std::mutex> lk(gdakiRsWinMu);
+  return gdakiRsWinSeq;
+}
+static void gdakiRsWinForgetColl(void* coll) {  // the collComm's last context is gone
+  std::lock_guard<std::mutex> lk(gdakiRsWinMu);
+  gdakiRsWins.erase(std::remove_if(gdakiRsWins.begin(), gdakiRsWins.end(),
+                                   [&](const struct gdakiRsWin& w) { return w.coll == coll; }),
+                    gdakiRsWins.end());
+  gdakiRsWinIds.erase(std::remove_if(gdakiRsWinIds.begin(), gdakiRsWinIds.end(),
+                                     [&](const std::pair<void*, uint32_t>& c) { return c.first == coll; }),
+                      gdakiRsWinIds.end());
+}
