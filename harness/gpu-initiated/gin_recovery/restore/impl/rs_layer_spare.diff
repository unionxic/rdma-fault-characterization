+// The readout when a context ends (a process that asks for the restore; after the helper stopped, before the NIC copy
+// path closes; EXPERIMENT.md 9.5): one line with the sums, and in the measurement mode one line per logged QP.
+static void gdakiRsTeardownLine(struct gdakiRecHost* r) {
+  if (!r->rsPtrSet) return;
+  const int rank = r->ctx ? r->ctx->rank : -1;
+  std::vector<struct ncclGinRsQp> v;
+  const char* why = "";
+  if (!gdakiRsReadQps(r, &v, &why)) {
+    GIN_TS_NOTE("GIN/RS: rank %d: send-side log at close: not read (%s)", rank, why);
+    return;
+  }
+  const struct gdakiRsSums t = gdakiRsSumsOf(v.data(), r->rsNqp, r->rsLogged.data());
+  GIN_TS_NOTE("GIN/RS: rank %d: send-side log at close: logged_qps=%d entries=%lu msgs=%lu overflow_ops=%lu "
+              "overflow_gap_qps=%d max_occupancy=%lu get_refused=%d checksum=%s measure_ms=%lld measure_rounds=%lu "
+              "measure_errors=%lu", rank, t.logged, (unsigned long)t.entries, (unsigned long)t.msgs,
+              (unsigned long)t.ovfCount, t.gaps, (unsigned long)t.maxOcc, t.getRefused,
+              gdakiRsCsumName(gdakiRsCsumScheme()), r->rsMeasureMs, (unsigned long)r->rsMeasureRounds,
+              (unsigned long)r->rsMeasureErrs);
+  if (r->rsMeasureMs <= 0) return;
+  const int nranks = r->nranks > 0 ? r->nranks : 1;
+  for (int i = 0; i < r->rsNqp; i++) {
+    if (!r->rsLogged[(size_t)i]) continue;
+    const gdakiRecHost::RsOcc& o = r->rsOcc[(size_t)i];
+    GIN_TS_NOTE("GIN/RS: rank %d: send-side log qp=%d peer=%d ctx=%d entries=%lu msgs=%lu overflow_ops=%lu samples=%lu "
+                "occupancy_avg=%.1f occupancy_max=%lu", rank, i, i % nranks, i / nranks, (unsigned long)v[(size_t)i].head,
+                (unsigned long)v[(size_t)i].msgs, (unsigned long)v[(size_t)i].ovfCount, (unsigned long)o.samples,
+                o.samples ? (double)o.sum / (double)o.samples : 0.0, (unsigned long)o.max);
+  }
+}
