+// ---- gin-restore (dev): log, suppress and replay (begin; work packages 6 and 9, impl/rs_log_api.h) ----
+// Work package 6 (EXPERIMENT.md 9.4, 9.5): the host management of the context's one log ring. The state is the pure
+// gdakiRsLogState (region "log, suppress and replay, pure"); these routines read and write the side table over the NIC
+// copy path (no CUDA call, helper thread only: the host branch's helper step calls gdakiRsLogPoll every 10 ms, its pause
+// gdakiRsLogPauseRead, its CKPT_STABLE gdakiRsLogStable), except gdakiRsLogReadHeadApp (the application thread, a CUDA
+// copy on a stream of its own) and the atomics (any thread). A process that does not ask for the restore, or runs the
+// measurement mode, has no log state (gdakiRsLogReady false).
+struct gdakiRsLogHost {
+  struct gdakiRsLogState st;
+  char* ringDev = nullptr;          // the ring's device address
+  std::vector<int> disarm;          // peers to DISARM found since the last gdakiRsLogPoll (overflow, get), each once
+  bool userCtxReported = false;     // a second user transparent-recovery context was reported (every peer, once)
+  std::mutex appMu;                 // the application thread's stream
+  cudaStream_t appStream = nullptr;
+  // work package 9 (execMu): per QP, the responder executed count, and the suppress budget the spare set (its line once)
+  std::mutex execMu;
+  std::vector<struct gdakiRsExecQp> exec;
+  std::vector<uint64_t> budget;
+  std::vector<uint8_t> budgetSet, budgetSaid;
+  // work package 9, option (b), A1: the loopback QP pair on the GIN protection domain (cComm->ib.pd) that adds the
+  // spare's signals with the GIN MRs the survivors' atomics use; set up in gdakiRsStart, then used by the import only (the
+  // spare's application thread before its helper starts); freed with the log state, before the GIN PD and the side table
+  struct ibv_cq* atCq = nullptr;
+  struct ibv_qp* atQa = nullptr;   // requester
+  struct ibv_qp* atQb = nullptr;   // responder (remote atomic access)
+  uint64_t* atStage = nullptr;     // 64 B host: the fetched old values and the self-test's read back
+  struct ibv_mr* atStageMr = nullptr;
+  struct ibv_mr* atSideMr = nullptr;  // the side table in the GIN PD (zero-based, as the GIN tables): the self-test
+  uint64_t atNextId = 1;
+  int atOutstanding = 0;           // signaled requests not completed (a late completion after a timeout)
+  bool atomicOk = false;           // set up, self-tested, no failed request since
+  int atomicCap = -1;
+  char atomicWhy[160] = "not set up";
+};
+static void gdakiRsLogDisarmOnce(struct gdakiRsLogHost* lh, int peer) {
+  for (int p : lh->disarm)
+    if (p == peer) return;
+  lh->disarm.push_back(peer);
+}
+static struct ncclGinRsQp* gdakiRsQpDev(struct gdakiRecHost* r, int qpIdx) {
+  return (struct ncclGinRsQp*)((char*)r->rsBase + sizeof(struct ncclGinRsSide)) + qpIdx;
+}
+// The QPs to `peer` in GIN-context order, every context (not narrowed by a round's scope, unlike gdakiRecForPeer).
+static int gdakiRsQpsOfPeer(struct gdakiRecHost* r, int peer, int* idx) {
+  int n = 0;
+  if (r->ctx == nullptr || peer < 0 || peer >= r->nranks) return 0;
+  for (int c = 0; c < r->ctx->nContexts && n < NCCL_GIN_RECOVERY_MAX_QPS; c++) {
+    const int i = peer + c * r->nranks;
+    if (i < (int)r->qps.size() && r->qps[(size_t)i].used && i < r->rsNqp) idx[n++] = i;
+  }
+  return n;
+}
+static bool gdakiRsLogReady(struct gdakiRecHost* r) { return r != nullptr && r->rsPtrSet && r->rsLog != nullptr; }
+// The side table's address into the classification block (ncclGinGdakiQ4::restore, one synchronous 8-byte write on a
+// stream of its own, on the context's device), once. The application thread, inside ncclGinRestoreResume before the
+// program's first launch (nccl.h: a kernel running then could read the pointer half way through it), or at the context's
+// creation in the log measurement mode.
+static bool gdakiRsPublish(struct gdakiRecHost* r, char* why, size_t whyLen) {
+  if (r->rsPublished.load(std::memory_order_acquire)) return true;
+  if (!r->rsPtrSet || r->ctx == nullptr || r->ctx->q4 == nullptr || r->ctx->q4->dev == nullptr) {
+    snprintf(why, whyLen, "no side table or no classification block");
+    return false;
+  }
+  int dev = -1;
+  if (cudaGetDevice(&dev) != cudaSuccess || (dev != r->ctx->cuda_id && cudaSetDevice(r->ctx->cuda_id) != cudaSuccess)) {
+    snprintf(why, whyLen, "cannot select CUDA device %d", r->ctx->cuda_id);
+    return false;
+  }
+  struct DevBack {
+    int d, want;
+    ~DevBack() { if (d >= 0 && d != want) (void)cudaSetDevice(d); }
+  } back{dev, r->ctx->cuda_id};
+  cudaStream_t st = nullptr;
+  struct ncclGinRsSide* side = (struct ncclGinRsSide*)r->rsBase;
+  bool ok = cudaStreamCreateWithFlags(&st, cudaStreamNonBlocking) == cudaSuccess;
+  ok = ok && cudaMemcpyAsync(&r->ctx->q4->dev->restore, &side, sizeof(side), cudaMemcpyHostToDevice, st) == cudaSuccess &&
+       cudaStreamSynchronize(st) == cudaSuccess;
+  if (st != nullptr) (void)cudaStreamDestroy(st);
+  if (!ok) {
+    snprintf(why, whyLen, "the write into the classification block failed");
+    return false;
+  }
+  r->rsPublished.store(true, std::memory_order_release);
+  return true;
+}
+static void gdakiRsPublishFor(void* comm, void* handle) {
+  std::lock_guard<std::mutex> lk(gdakiRecRegMu);  // the context stays registered (and its blocks allocated) while held
+  struct gdakiRecHost* r = nullptr;
+  for (auto* x : gdakiRecReg)
+    if (handle != nullptr && x->commKey == comm && x->ctx != nullptr && x->ctx->devHandle != nullptr &&
+        x->ctx->devHandle->handle == handle)
+      r = x;
+  if (r == nullptr) return;
+  char why[128] = {0};
+  if (gdakiRsPublish(r, why, sizeof(why)))
+    GIN_TS_NOTE("GIN/RS: rank %d: side table published to the device (ncclGinRestoreResume%s)", r->ctx->rank,
+                r->rsMeasureMs > 0 ? ", log measurement mode" : "");
+  else  // this rank's log never starts: its pauses refuse (gdakiRsLogPauseRead), so no peer is armed on it
+    WARN("GIN/RS: rank %d: the side table could not be published to the device (%s): this rank keeps no send-side log "
+         "and its checkpoint pauses refuse", r->ctx->rank, why);
+}
+static ncclResult_t gdakiRsLogNotReady(char* why, size_t whyLen) {
+  if (why && whyLen) snprintf(why, whyLen, "this context has no send-side log");
+  return ncclInvalidUsage;
+}
+// The identity words of positions [from, to) (to - from entries, one NIC read, not across the ring's end).
+static bool gdakiRsLogReadIds(struct gdakiRecHost* r, uint64_t from, uint64_t to, uint64_t* ids) {
+  struct gdakiRsLogHost* lh = r->rsLog;
+  const uint64_t n = lh->st.n, slot = from & (n - 1);
+  const size_t bytes = (size_t)(to - from) * sizeof(struct ncclGinRsLogEntry);
+  if (to <= from || slot + (to - from) > n || bytes > r->pinnedSize) return false;
+  if (gdakiLbXfer(r, false, lh->ringDev + slot * sizeof(struct ncclGinRsLogEntry), bytes) != ncclSuccess) return false;
+  for (uint64_t p = from; p < to; p++) memcpy(&ids[p - from], r->pinned + (size_t)(p - from) * sizeof(struct ncclGinRsLogEntry), 8);
+  return true;
+}
+// Entries per NIC read of the ring (whole entries within the staging buffer, at most 64 KiB).
+static uint64_t gdakiRsLogChunk(struct gdakiRecHost* r) {
+  const size_t b = std::min<size_t>(r->pinnedSize, 64 * 1024) / sizeof(struct ncclGinRsLogEntry);
+  return b > 0 ? b : 1;
+}
+static void gdakiRsLogCreate(struct gdakiRecHost* r, uint32_t nEntries, size_t ringOff) {
+  r->rsLog = new gdakiRsLogHost();
+  gdakiRsLogStateInit(&r->rsLog->st, nEntries, r->rsNqp, r->nranks);
+  r->rsLog->ringDev = (char*)r->rsBase + ringOff;
+  // work package 9: every QP's executed count starts at the setup's responder MSN baseline (taken before any traffic)
+  const size_t nq = (size_t)(r->rsNqp > 0 ? r->rsNqp : 0);
+  r->rsLog->exec.assign(nq, gdakiRsExecQp());
+  for (size_t i = 0; i < nq && r->ts != nullptr && i < r->ts->qs.size(); i++)
+    gdakiRsExecRebaseQp(r->rsLog->exec[i], r->ts->qs[i].rmsn0);
+  r->rsLog->budget.assign(nq, 0);
+  r->rsLog->budgetSet.assign(nq, 0);
+  r->rsLog->budgetSaid.assign(nq, 0);
+}
+static uint64_t gdakiRsLogTrimErrors(struct gdakiRecHost* r) {
+  return r->rsLog ? r->rsLog->st.trimErrors.load(std::memory_order_relaxed) : 0;
+}
+static void gdakiRsLogFree(struct gdakiRecHost* r) {
+  if (r->rsLog == nullptr) return;
+  struct gdakiRsLogHost* lh = r->rsLog;
+  if (lh->appStream != nullptr) (void)cudaStreamDestroy(lh->appStream);
+  // work package 9, A1: the GIN-PD loopback pair (before the side table's memory goes, gdakiRecFree; the GIN PD lives
+  // with the collComm, after the context)
+  if (lh->atQa != nullptr) (void)wrap_ibv_destroy_qp(lh->atQa);
+  if (lh->atQb != nullptr) (void)wrap_ibv_destroy_qp(lh->atQb);
+  if (lh->atCq != nullptr) (void)wrap_ibv_destroy_cq(lh->atCq);
+  if (lh->atStageMr != nullptr) (void)wrap_ibv_dereg_mr(lh->atStageMr);
+  if (lh->atSideMr != nullptr) (void)wrap_ibv_dereg_mr(lh->atSideMr);
+  free(lh->atStage);
+  delete r->rsLog;
+  r->rsLog = nullptr;
+}
+// The tail's advance (pure rule) and, when it moved, its write to the device.
+static ncclResult_t gdakiRsLogTrim(struct gdakiRecHost* r, uint64_t head) {
+  struct gdakiRsLogHost* lh = r->rsLog;
+  const uint64_t old = lh->st.tail;
+  bool failed = false;
+  const uint64_t t = gdakiRsLogStateAdvance(
+    &lh->st, head, gdakiRsLogChunk(r),
+    [&](uint64_t a, uint64_t b, uint64_t* ids) { return gdakiRsLogReadIds(r, a, b, ids); }, &failed);
+  if (t != old) {
+    memcpy(r->pinned, &t, sizeof(t));
+    if (gdakiLbXfer(r, true, &((struct ncclGinRsSide*)r->rsBase)->tail, sizeof(uint64_t)) != ncclSuccess) {
+      lh->st.tail = old;  // the device keeps the old tail: so does the host (the next trim writes again)
+      return ncclSystemError;
+    }
+  }
+  return failed ? ncclSystemError : ncclSuccess;
+}
+static ncclResult_t gdakiRsLogPauseRead(struct gdakiRecHost* r, int peer, struct gdakiRsLogPause* out, char* why,
+                                        size_t whyLen) {
+  if (!gdakiRsLogReady(r)) return gdakiRsLogNotReady(why, whyLen);
+  if (!r->rsPublished.load(std::memory_order_acquire)) {  // the device does not log before ncclGinRestoreResume succeeded
+    snprintf(why, whyLen, "the side table is not published to the device (ncclGinRestoreResume did not succeed here)");
+    return ncclInvalidUsage;
+  }
+  struct gdakiRsLogHost* lh = r->rsLog;
+  int idx[NCCL_GIN_RECOVERY_MAX_QPS];
+  const int n = gdakiRsQpsOfPeer(r, peer, idx);
+  if (n == 0) {
+    snprintf(why, whyLen, "no QP to rank %d", peer);
+    return ncclInvalidUsage;
+  }
+  for (int k = 0; k < n; k++) {  // the log of these QPs starts at this pause (before its even epoch is published)
+    if (lh->st.qp[(size_t)idx[k]].logs) continue;
+    const uint32_t one = 1;
+    memcpy(r->pinned, &one, sizeof(one));
+    if (gdakiLbXfer(r, true, &gdakiRsQpDev(r, idx[k])->logOn, sizeof(uint32_t)) != ncclSuccess) {
+      snprintf(why, whyLen, "cannot set logOn of qp %d over the NIC copy path", idx[k]);
+      return ncclSystemError;
+    }
+  }
+  struct ncclGinRsSide h;
+  std::vector<struct ncclGinRsQp> v;
+  const char* w = nullptr;
+  if (!gdakiRsReadSide(r, &h, &v, &w)) {
+    snprintf(why, whyLen, "%s", w ? w : "cannot read the side table");
+    return ncclSystemError;
+  }
+  *out = gdakiRsLogPause();
+  out->head = h.head;
+  out->nqp = n;
+  bool on = true;
+  uint64_t ovf[NCCL_GIN_RECOVERY_MAX_QPS], gets[NCCL_GIN_RECOVERY_MAX_QPS], msgs[NCCL_GIN_RECOVERY_MAX_QPS];
+  for (int k = 0; k < n; k++) {
+    const struct ncclGinRsQp& q = v[(size_t)idx[k]];
+    out->msgs[k] = msgs[k] = q.msgs;
+    out->ovf[k] = ovf[k] = q.ovfCount;
+    out->gets[k] = gets[k] = q.gets;
+    on = on && q.logOn == 1;
+  }
+  if (!on) {  // the read back: a logOn write that did not land is not a log that starts here
+    snprintf(why, whyLen, "logOn of a QP to rank %d did not read back as set", peer);
+    return ncclSystemError;
+  }
+  out->firstPause = gdakiRsLogStateNotePause(&lh->st, idx, n, h.head, ovf, gets, msgs) > 0;
+  out->logComplete = true;
+  lh->st.headSeen.store(h.head, std::memory_order_relaxed);
+  return ncclSuccess;
+}
+static ncclResult_t gdakiRsLogStable(struct gdakiRecHost* r, int peer, const struct gdakiRsLogPause* atPause,
+                                     char* why, size_t whyLen) {
+  if (!gdakiRsLogReady(r)) return gdakiRsLogNotReady(why, whyLen);
+  struct gdakiRsLogHost* lh = r->rsLog;
+  int idx[NCCL_GIN_RECOVERY_MAX_QPS];
+  const int n = gdakiRsQpsOfPeer(r, peer, idx);
+  if (n != atPause->nqp) {
+    snprintf(why, whyLen, "rank %d has %d QPs, the pause record %d", peer, n, atPause->nqp);
+    return ncclInvalidUsage;
+  }
+  struct ncclGinRsSide h;
+  std::vector<struct ncclGinRsQp> v;
+  const char* w = nullptr;
+  if (!gdakiRsReadSide(r, &h, &v, &w)) {
+    snprintf(why, whyLen, "%s", w ? w : "cannot read the side table");
+    return ncclSystemError;
+  }
+  struct gdakiRsPauseSnap at[NCCL_GIN_RECOVERY_MAX_QPS];
+  uint64_t ovfNow[NCCL_GIN_RECOVERY_MAX_QPS];
+  for (int k = 0; k < n; k++) {
+    at[k].head = atPause->head;
+    at[k].ovf = atPause->ovf[k];
+    at[k].gets = atPause->gets[k];
+    at[k].valid = true;
+    ovfNow[k] = v[(size_t)idx[k]].ovfCount;
+  }
+  const int broke = gdakiRsLogStateNoteStable(&lh->st, idx, n, at, ovfNow);
+  if (broke > 0) gdakiRsLogDisarmOnce(lh, peer);
+  lh->st.headSeen.store(h.head, std::memory_order_relaxed);
+  const bool trimmed = gdakiRsLogTrim(r, h.head) == ncclSuccess;
+  if (broke > 0) {  // the caller does not arm the peer on this checkpoint (review of work package 6, finding 2)
+    snprintf(why, whyLen, "the log toward rank %d lost an operation (ring full) after this checkpoint's pause: not armable",
+             peer);
+    return ncclInvalidUsage;
+  }
+  if (!trimmed) {
+    snprintf(why, whyLen, "the tail could not be moved over the NIC copy path (it is kept; the next trim retries)");
+    return ncclSystemError;
+  }
+  return ncclSuccess;
+}
+static ncclResult_t gdakiRsLogReadHead(struct gdakiRecHost* r, uint64_t* head) {
+  if (!gdakiRsLogReady(r)) return ncclInvalidUsage;
+  struct ncclGinRsSide h;
+  if (!gdakiRsReadSide(r, &h, nullptr)) return ncclSystemError;
+  *head = h.head;
+  r->rsLog->st.headSeen.store(h.head, std::memory_order_relaxed);
+  return ncclSuccess;
+}
+static ncclResult_t gdakiRsLogReadHeadApp(struct gdakiRecHost* r, uint64_t* head) {
+  if (!gdakiRsLogReady(r)) return ncclInvalidUsage;
+  struct gdakiRsLogHost* lh = r->rsLog;
+  std::lock_guard<std::mutex> lk(lh->appMu);
+  int dev = -1;  // the context's device for this thread's calls, then the thread's own back (review of package 6, note 7)
+  if (cudaGetDevice(&dev) != cudaSuccess || (dev != r->ctx->cuda_id && cudaSetDevice(r->ctx->cuda_id) != cudaSuccess))
+    return ncclUnhandledCudaError;
+  struct DevBack {
+    int d, want;
+    ~DevBack() { if (d != want) (void)cudaSetDevice(d); }
+  } back{dev, r->ctx->cuda_id};
+  if (lh->appStream == nullptr && cudaStreamCreateWithFlags(&lh->appStream, cudaStreamNonBlocking) != cudaSuccess) {
+    lh->appStream = nullptr;
+    return ncclUnhandledCudaError;
+  }
+  uint64_t v = 0;
+  if (cudaMemcpyAsync(&v, &((struct ncclGinRsSide*)r->rsBase)->head, sizeof(v), cudaMemcpyDeviceToHost, lh->appStream) !=
+        cudaSuccess ||
+      cudaStreamSynchronize(lh->appStream) != cudaSuccess)
+    return ncclUnhandledCudaError;
+  *head = v;
+  return ncclSuccess;
+}
+// The per-QP field `f` of the QPs to `peer` (helper).
+template <typename F>
+static ncclResult_t gdakiRsLogReadQpField(struct gdakiRecHost* r, int peer, uint64_t* vals, int* nqp, F f) {
+  if (!gdakiRsLogReady(r)) return ncclInvalidUsage;
+  int idx[NCCL_GIN_RECOVERY_MAX_QPS];
+  const int n = gdakiRsQpsOfPeer(r, peer, idx);
+  struct ncclGinRsSide h;
+  std::vector<struct ncclGinRsQp> v;
+  if (!gdakiRsReadSide(r, &h, &v)) return ncclSystemError;
+  for (int k = 0; k < n; k++) vals[k] = f(v[(size_t)idx[k]]);
+  *nqp = n;
+  return ncclSuccess;
+}
+static ncclResult_t gdakiRsLogReadMsgs(struct gdakiRecHost* r, int peer, uint64_t* msgs, int* nqp) {
+  return gdakiRsLogReadQpField(r, peer, msgs, nqp, [](const struct ncclGinRsQp& q) { return (uint64_t)q.msgs; });
+}
+static ncclResult_t gdakiRsLogReadSuppress(struct gdakiRecHost* r, int peer, uint64_t* left, int* nqp) {
+  return gdakiRsLogReadQpField(r, peer, left, nqp, [](const struct ncclGinRsQp& q) { return (uint64_t)q.suppress; });
+}
+static ncclResult_t gdakiRsLogReadGets(struct gdakiRecHost* r, int peer, uint64_t* gets, int* nqp) {
+  return gdakiRsLogReadQpField(r, peer, gets, nqp, [](const struct ncclGinRsQp& q) { return (uint64_t)q.gets; });
+}
+static uint64_t gdakiRsLogCoveredUpTo(struct gdakiRecHost* r) {
+  return gdakiRsLogReady(r) ? r->rsLog->st.coveredUpTo.load(std::memory_order_acquire) : GDAKI_RS_POS_INF;
+}
+// The number of user transparent-recovery GDAKI contexts of this communicator (their setup decisions; Resume counted the
+// same at its call): one ring per context is one ring per rank only while it is one (9.10.4).
+static int gdakiRsUserCtxCount(void* comm) {
+  std::lock_guard<std::mutex> lk(gdakiRsRegMu);
+  int n = 0;
+  for (const auto& x : gdakiRsReg)
+    if (x.comm == comm && x.setup && x.handle != nullptr) n++;
+  return n;
+}
+// gdakiRsLogPoll (the host branch's helper step, every 10 ms; nobody else calls it): the counts (overflow, gets) of every
+// QP that may log, a second user context, the tail's advance and an occupancy sample. Peers to DISARM go to *broke, each
+// once per cause.
+static ncclResult_t gdakiRsLogPoll(struct gdakiRecHost* r, std::vector<int>* broke) {
+  if (!gdakiRsLogReady(r)) return ncclInvalidUsage;
+  // nothing is logged before ncclGinRestoreResume published the side table: no NIC read (review of the trap removal,
+  // note 6; a hold process that never enables the restore pays no helper reads)
+  if (!r->rsPublished.load(std::memory_order_acquire)) return ncclSuccess;
+  struct gdakiRsLogHost* lh = r->rsLog;
+  const int nranks = r->nranks > 0 ? r->nranks : 1;
+  struct ncclGinRsSide h;
+  std::vector<struct ncclGinRsQp> v;
+  if (!gdakiRsReadSide(r, &h, &v)) return ncclSystemError;  // the DISARM list is kept for the next call
+  gdakiRsSuppressLines(r, v, false);  // work package 9: a spare's budget its replay used up
+  {
+    for (int i = 0; i < r->rsNqp; i++) {
+      if (!r->rsLogged[(size_t)i]) continue;
+      bool gotGet = false;
+      if (gdakiRsLogStateNoteCounts(&lh->st, i, v[(size_t)i].ovfCount, v[(size_t)i].gets, &gotGet) || gotGet)
+        gdakiRsLogDisarmOnce(lh, i % nranks);
+    }
+    lh->st.headSeen.store(h.head, std::memory_order_relaxed);
+    if (gdakiRsLogTrim(r, h.head) != ncclSuccess) lh->st.trimErrors.fetch_add(1, std::memory_order_relaxed);
+    const uint64_t occ = h.head >= lh->st.tail ? h.head - lh->st.tail : 0;
+    lh->st.samples.fetch_add(1, std::memory_order_relaxed);
+    lh->st.occSum.fetch_add(occ, std::memory_order_relaxed);
+    if (occ > lh->st.occMax.load(std::memory_order_relaxed)) lh->st.occMax.store(occ, std::memory_order_relaxed);
+  }
+  if (!lh->userCtxReported && gdakiRsUserCtxCount(r->commKey) > 1) {  // a second user context after Resume
+    lh->userCtxReported = true;
+    GIN_TS_NOTE("GIN/RS: rank %d: a second user transparent-recovery GDAKI context on this communicator: the send-side log "
+                "is no longer one ring per rank; every peer is reported for DISARM", r->ctx ? r->ctx->rank : -1);
+    for (int p = 0; p < nranks; p++)
+      if (r->ctx == nullptr || p != r->ctx->rank) gdakiRsLogDisarmOnce(lh, p);
+  }
+  for (int p : lh->disarm) broke->push_back(p);  // delivered with ncclSuccess only (the caller reads it then)
+  lh->disarm.clear();
+  return ncclSuccess;
+}
+static bool gdakiRsLogComplete(struct gdakiRecHost* r, int peer) {
+  return gdakiRsLogReady(r) && gdakiRsLogStateComplete(&r->rsLog->st, peer);
+}
+static ncclResult_t gdakiRsLogCollect(struct gdakiRecHost* r, int peer, uint64_t from, uint64_t to,
+                                      std::vector<struct ncclGinRsLogEntry>* out, char* why, size_t whyLen) {
+  if (!gdakiRsLogReady(r)) return gdakiRsLogNotReady(why, whyLen);
+  struct gdakiRsLogHost* lh = r->rsLog;
+  int idx[NCCL_GIN_RECOVERY_MAX_QPS];
+  const int n = gdakiRsQpsOfPeer(r, peer, idx);
+  struct ncclGinRsSide h;
+  std::vector<struct ncclGinRsQp> v;
+  if (!gdakiRsReadSide(r, &h, &v)) {
+    snprintf(why, whyLen, "cannot read the side table");
+    return ncclSystemError;
+  }
+  uint64_t ovfNow[NCCL_GIN_RECOVERY_MAX_QPS], getsNow[NCCL_GIN_RECOVERY_MAX_QPS];
+  for (int k = 0; k < n; k++) {
+    ovfNow[k] = v[(size_t)idx[k]].ovfCount;
+    getsNow[k] = v[(size_t)idx[k]].gets;
+  }
+  char cw[160];
+  if (!gdakiRsLogStateCanExport(&lh->st, idx, n, from, ovfNow, getsNow, cw, sizeof(cw))) {  // complete since `from`, now
+    snprintf(why, whyLen, "the log toward rank %d is not complete from position %lu: %s", peer, (unsigned long)from, cw);
+    return ncclInvalidUsage;
+  }
+  if (to > h.head || to < from) {
+    snprintf(why, whyLen, "positions [%lu, %lu) are not all in the ring (head %lu, tail %lu)", (unsigned long)from,
+             (unsigned long)to, (unsigned long)h.head, (unsigned long)lh->st.tail);
+    return ncclInvalidUsage;
+  }
+  out->clear();  // empty when the tail already passed `to` (the peer has no entry there: CanExport passed)
+  const uint64_t chunk = gdakiRsLogChunk(r);
+  for (uint64_t s = std::max(from, lh->st.tail); s < to;) {
+    const uint64_t slot = s & (uint64_t)(lh->st.n - 1);
+    uint64_t e = std::min<uint64_t>(to, s + chunk);
+    if (e > s + (lh->st.n - slot)) e = s + (lh->st.n - slot);
+    const size_t bytes = (size_t)(e - s) * sizeof(struct ncclGinRsLogEntry);
+    if (gdakiLbXfer(r, false, lh->ringDev + slot * sizeof(struct ncclGinRsLogEntry), bytes) != ncclSuccess) {
+      snprintf(why, whyLen, "cannot read the ring over the NIC copy path");
+      return ncclSystemError;
+    }
+    std::vector<uint64_t> ids((size_t)(e - s));
+    for (uint64_t p = s; p < e; p++)
+      memcpy(&ids[(size_t)(p - s)], r->pinned + (size_t)(p - s) * sizeof(struct ncclGinRsLogEntry), 8);
+    for (uint64_t p : gdakiRsLogStatePeerPositions(&lh->st, peer, s, e, ids.data())) {  // the tested filter
+      struct ncclGinRsLogEntry en;
+      memcpy(&en, r->pinned + (size_t)(p - s) * sizeof(en), sizeof(en));
+      out->push_back(en);
+    }
+    s = e;
+  }
+  return ncclSuccess;
+}
+static void gdakiRsLogOccupancy(struct gdakiRecHost* r, struct gdakiRsLogOcc* out) {
+  *out = gdakiRsLogOcc();
+  if (!gdakiRsLogReady(r)) return;
+  const struct gdakiRsLogState& s = r->rsLog->st;
+  out->nEntries = s.n;
+  out->samples = s.samples.load(std::memory_order_relaxed);
+  out->occSum = s.occSum.load(std::memory_order_relaxed);
+  out->occMax = s.occMax.load(std::memory_order_relaxed);
+  out->trims = s.trims.load(std::memory_order_relaxed);
+  out->tail = s.tailNow.load(std::memory_order_relaxed);
+  out->headSeen = s.headSeen.load(std::memory_order_relaxed);
+  out->blockedPending = s.blockedPending.load(std::memory_order_relaxed);
+}
+static uint64_t gdakiRsWinGoneCount(struct gdakiRecHost* r) {
+  if (r == nullptr || r->ctx == nullptr || !r->rsPtrSet) return 0;
+  std::lock_guard<std::mutex> lk(gdakiRsWinMu);
+  uint64_t n = 0;
+  for (const auto& w : gdakiRsWins)
+    if (w.coll == (void*)r->ctx->collComm && w.gone && w.goneSeq > r->rsWinSeq) n++;
+  return n;
+}
+// ---- work package 9 (EXPERIMENT.md 9.3, 9.6, 9.11.3 M2): the executed counts, the spare's suppress budgets and their
+// line, the plan that re-posts nothing, the log export and the spare's import. The pure parts are in the region above
+// ("log, suppress and replay, pure"). Wiring the other regions need (impl/notes_dev.md, integration): G7's hold body calls
+// gdakiRsExecObserve with the watch's rmsn; gdakiTsExecuted calls it with every rmsn it reads, gdakiTsBaseline calls
+// gdakiRsExecRebase with the rmsn0 it sets (in a process without the log both return at once). ----
+static void gdakiRsExecObserve(struct gdakiRecHost* r, int qpIdx, uint32_t rmsn) {
+  if (!gdakiRsLogReady(r)) return;
+  struct gdakiRsLogHost* lh = r->rsLog;
