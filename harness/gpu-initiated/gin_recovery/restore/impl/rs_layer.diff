+  // gin-restore (rs): the side table, null unless this process asks for the restore. Appended without a context-layout
+  // version change (user decision 2026-10-12, EXPERIMENT.md 9.11.5): a program must be built with these headers; one built
+  // with older headers and more than one context would misread contexts from index 1 on (not supported). Written once,
+  // before the context is handed out; no device code reads it in this build.
+  struct ncclGinRsSide* restore;
 };
 
