+    return rc;
+  }
+  if (step != nullptr && bytes != nullptr) {  // the first incarnation: step 0, no host blob
+    *step = 0;
+    *bytes = 0;
+  }
+  if (verdict == GDAKI_RS_ENABLE)
+    GIN_TS_NOTE("GIN/RS: rank %d: ncclGinRestoreResume: the restore can be enabled (%s); first incarnation, step 0; this "
+                "build has no hold reaction yet: the communicator stays fail-fast", f->rank, why);
+  else
+    INFO(NCCL_NET, "GIN/RS: rank %d: ncclGinRestoreResume: %s; the communicator stays fail-fast", f->rank, why);
+  return ncclSuccess;
+}
