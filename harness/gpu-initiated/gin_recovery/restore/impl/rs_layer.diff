+}
+// One QUERY_QP per QP to the peer, under opMu as the watch's (the caller must not hold it), outside the firmware guard; the
+// reads are folded under opMu too, so they fold in the order they were taken with the watch's (review of work package 9,
+// note 4).
+static ncclResult_t gdakiRsExecRead(struct gdakiRecHost* r, int peer, uint64_t* cum, int* nqp) {
+  if (!gdakiRsLogReady(r)) return ncclInvalidUsage;
+  struct gdakiRsLogHost* lh = r->rsLog;
+  int idx[NCCL_GIN_RECOVERY_MAX_QPS];
+  const int n = gdakiRsQpsOfPeer(r, peer, idx);
+  if (n == 0) return ncclInvalidUsage;
+  uint32_t rmsn[NCCL_GIN_RECOVERY_MAX_QPS];
+  std::lock_guard<std::mutex> op(r->opMu);  // QUERY_QP never overlaps a QP state change (see gdakiTsQuiesce)
+  for (int k = 0; k < n; k++) {
+    struct doca_gpu_verbs_qp_hl* q = r->ctx->gqps[idx[k]];
+    if (q == nullptr || doca_verbs_qp_query_seq(q->qp, &rmsn[k], nullptr, nullptr, nullptr) != DOCA_SUCCESS)
+      return ncclSystemError;
+  }
+  std::lock_guard<std::mutex> lk(lh->execMu);
+  bool bad = false;
+  for (int k = 0; k < n; k++) {
+    struct gdakiRsExecQp& e = lh->exec[(size_t)idx[k]];
+    gdakiRsExecStepQp(e, rmsn[k]);
+    cum[k] = e.cum;
+    bad = bad || e.bad;
+  }
+  *nqp = n;
+  return bad ? ncclInvalidUsage : ncclSuccess;  // a lost read: this peer is not restored on this count
+}
+static void gdakiRsExecSetBase(struct gdakiRecHost* r, int qpIdx, uint64_t cum) {
+  if (!gdakiRsLogReady(r)) return;
+  struct gdakiRsLogHost* lh = r->rsLog;
+  std::lock_guard<std::mutex> lk(lh->execMu);
+  if (qpIdx >= 0 && qpIdx < (int)lh->exec.size()) lh->exec[(size_t)qpIdx].cum = cum;
+}
+// The application thread's CUDA access (the spare's import): the context's device for the call (the thread's own back
+// at the guard's end) and the log state's own non-blocking stream. lh->appMu held by the caller.
+struct gdakiRsDevGuard {
+  int d = -1, want = -1;
+  ~gdakiRsDevGuard() {
+    if (d >= 0 && d != want) (void)cudaSetDevice(d);
+  }
+};
+static bool gdakiRsAppStream(struct gdakiRecHost* r, struct gdakiRsDevGuard* g) {
+  struct gdakiRsLogHost* lh = r->rsLog;
+  if (cudaGetDevice(&g->d) != cudaSuccess) {
+    g->d = -1;
+    return false;
+  }
+  g->want = r->ctx->cuda_id;
+  if (g->d != g->want && cudaSetDevice(g->want) != cudaSuccess) return false;
+  if (lh->appStream == nullptr && cudaStreamCreateWithFlags(&lh->appStream, cudaStreamNonBlocking) != cudaSuccess) {
+    lh->appStream = nullptr;
+    return false;
+  }
+  return true;
+}
+// msgs = X and suppress = B of the QPs idx[0..n) (16 bytes each, then read back), and the budgets for the suppress line.
+// lh->appMu held, the stream set up (gdakiRsAppStream).
+static ncclResult_t gdakiRsSuppressWrite(struct gdakiRecHost* r, const int* idx, int n, const uint64_t* x,
+                                         const uint64_t* b, char* why, size_t whyLen) {
+  struct gdakiRsLogHost* lh = r->rsLog;
+  uint64_t v[NCCL_GIN_RECOVERY_MAX_QPS][2], back[NCCL_GIN_RECOVERY_MAX_QPS][2];
+  bool ok = true;
+  for (int k = 0; k < n; k++) {
+    v[k][0] = x[k];
+    v[k][1] = b[k];
+    ok = ok && cudaMemcpyAsync(&gdakiRsQpDev(r, idx[k])->msgs, v[k], sizeof(v[k]), cudaMemcpyHostToDevice,
+                               lh->appStream) == cudaSuccess;
+  }
+  for (int k = 0; k < n; k++)
+    ok = ok && cudaMemcpyAsync(back[k], &gdakiRsQpDev(r, idx[k])->msgs, sizeof(back[k]), cudaMemcpyDeviceToHost,
+                               lh->appStream) == cudaSuccess;
+  ok = ok && cudaStreamSynchronize(lh->appStream) == cudaSuccess;
+  for (int k = 0; ok && k < n; k++) ok = back[k][0] == v[k][0] && back[k][1] == v[k][1];
+  if (!ok) {
+    snprintf(why, whyLen, "the suppress budgets could not be written to the side table");
+    return ncclUnhandledCudaError;
+  }
+  std::lock_guard<std::mutex> el(lh->execMu);
+  for (int k = 0; k < n; k++) {
+    lh->budget[(size_t)idx[k]] = b[k];
+    lh->budgetSet[(size_t)idx[k]] = 1;
+    lh->budgetSaid[(size_t)idx[k]] = 0;
+  }
+  return ncclSuccess;
+}
+static ncclResult_t gdakiRsSuppressSet(struct gdakiRecHost* r, int peer, const uint64_t* x, const uint64_t* p, int nqp,
+                                       char* why, size_t whyLen) {
+  if (!gdakiRsLogReady(r)) return gdakiRsLogNotReady(why, whyLen);
+  struct gdakiRsLogHost* lh = r->rsLog;
+  int idx[NCCL_GIN_RECOVERY_MAX_QPS];
+  const int n = gdakiRsQpsOfPeer(r, peer, idx);
+  if (n == 0 || n != nqp) {
+    snprintf(why, whyLen, "rank %d has %d QPs here, %d counts given", peer, n, nqp);
+    return ncclInvalidUsage;
+  }
+  uint64_t b[NCCL_GIN_RECOVERY_MAX_QPS];
+  for (int k = 0; k < n; k++)
+    if (!gdakiRsBudgetOf(x[k], p[k], &b[k])) {
+      snprintf(why, whyLen, "qp %d: X %lu is below P %lu", idx[k], (unsigned long)x[k], (unsigned long)p[k]);
+      return ncclInvalidUsage;
+    }
+  std::lock_guard<std::mutex> lk(lh->appMu);
+  struct gdakiRsDevGuard g;
+  if (!gdakiRsAppStream(r, &g)) {
+    snprintf(why, whyLen, "no CUDA stream on device %d", r->ctx->cuda_id);
+    return ncclUnhandledCudaError;
+  }
+  return gdakiRsSuppressWrite(r, idx, n, x, b, why, whyLen);
+}
+// The suppress line (its format is fixed for the test branch, impl/notes_dev.md): one WARN per QP whose budget the spare
+// set, once its replay used it (left 0; the helper's gdakiRsLogPoll) or at the context's end (what is left). qp is the
+// side table's QP index (context x nranks + peer).
+static void gdakiRsSuppressLines(struct gdakiRecHost* r, const std::vector<struct ncclGinRsQp>& v, bool atClose) {
+  if (r == nullptr || r->rsLog == nullptr) return;
+  struct gdakiRsLogHost* lh = r->rsLog;
+  const int nranks = r->nranks > 0 ? r->nranks : 1;
+  std::lock_guard<std::mutex> el(lh->execMu);
+  for (size_t i = 0; i < lh->budgetSet.size() && i < v.size(); i++) {
+    if (!lh->budgetSet[i] || lh->budgetSaid[i]) continue;
+    const uint64_t left = v[i].suppress;
+    if (left != 0 && !atClose) continue;
+    lh->budgetSaid[i] = 1;
+    const uint64_t B = lh->budget[i], L = std::min(left, B);
+    WARN("GIN/RS: rank %d: suppress peer=%d qp=%zu budget=%lu suppressed=%lu left=%lu", r->ctx ? r->ctx->rank : -1,
+         (int)(i % (size_t)nranks), i, (unsigned long)B, (unsigned long)(B - L), (unsigned long)L);
+  }
+}
+static ncclResult_t gdakiRsLogReadGetRefused(struct gdakiRecHost* r, int peer, uint64_t* refused, int* nqp) {
+  return gdakiRsLogReadQpField(r, peer, refused, nqp, [](const struct ncclGinRsQp& q) { return (uint64_t)q.getRefused; });
+}
+// ---- work package 9, option (b) (the main session's decision of 2026-10-12 on review finding B1), with A1 ----
+// The spare's import adds the logged signals with NIC fetch-and-add, not with a host read-add-write: the survivors that
+// published before the import (the spare serves them one at a time, impl/rs_spare_api.h) send their signal atomics to the
+// same words. Review finding A1 (decided the same day): the fetch-and-adds go through a loopback QP pair of their own on the
+// GIN protection domain (cComm->ib.pd) and name the very GIN MRs the survivors' atomics name (the signal table's
+// signals_table->mr, a window's gdaki_mem_handle::mr; zero-based offsets), so the HCA sees one memory key and one location
+// for both; no second registration of the signal memory takes part. With atomic_cap >= IBV_ATOMIC_HCA the atomics of all
+// the HCA's QPs are atomic with respect to each other; the pair is on the GIN context's ibv context (the GIN QPs' HCA), and
+// this process's HCA executes both kinds as the responder, so they also add in the same byte order.
+static_assert(GDAKI_RS_ATOMIC_HCA == IBV_ATOMIC_HCA, "the Resume condition's constant is IBV_ATOMIC_HCA");
+// One request on the pair, completed: a fetch-and-add of `add` (old value back through the staging word) or, with
+// `read`, an 8-byte RDMA READ into it. Zero-based `off` in the MR of `rkey`. Bounded by NCCL_GIN_TS_COPY_MS. A failed post
+// or an error completion marks the pair broken (its QP is in ERR; the restore is then refused on this rank); the NIC copy
+// path is not touched. The pair's single user: the setup, or the spare's application thread before its helper starts.
+static ncclResult_t gdakiRsAtomicOp(struct gdakiRecHost* r, bool read, uint64_t off, uint32_t rkey, uint64_t add,
+                                    uint64_t* val, char* why, size_t whyLen) {
+  struct gdakiRsLogHost* lh = r->rsLog;
+  auto broken = [&](const char* text) {
+    lh->atomicOk = false;
+    snprintf(lh->atomicWhy, sizeof(lh->atomicWhy), "%.150s", text);
+    snprintf(why, whyLen, "%.150s", text);
+    return ncclSystemError;
+  };
+  auto poll = [&](uint64_t want, bool* got) -> bool {  // false: an error completion
+    struct ibv_wc wc[4];
+    int n = 0;
+    if (wrap_ibv_poll_cq(lh->atCq, 4, wc, &n) != ncclSuccess || n < 0) return false;
+    bool okc = true;
+    for (int k = 0; k < n; k++) {
+      if (wc[k].status != IBV_WC_SUCCESS) {
+        okc = false;
+        continue;
+      }
+      lh->atOutstanding--;
+      if (wc[k].wr_id == want) *got = true;
+    }
+    return okc;
+  };
+  if (lh->atQa == nullptr) return broken("the loopback atomic pair is not set up");
+  if ((off & 7) != 0) {
+    snprintf(why, whyLen, "offset %#lx is not 8-byte aligned", (unsigned long)off);
+    return ncclInvalidUsage;
+  }
+  if (lh->atOutstanding > 0) {  // a late completion of an earlier request (a timeout)
+    bool dummy = false;
+    if (!poll(0, &dummy)) return broken("a late request on the loopback atomic pair completed in error");
+    if (lh->atOutstanding > 0) {
+      snprintf(why, whyLen, "a late request on the loopback atomic pair is still outstanding");
+      return ncclSystemError;
+    }
+  }
+  const uint64_t id = lh->atNextId++;
+  struct ibv_sge sg;
+  struct ibv_send_wr wr, *bad = nullptr;
+  memset(&wr, 0, sizeof(wr));
+  sg.addr = (uint64_t)(uintptr_t)lh->atStage;
+  sg.length = 8;
+  sg.lkey = lh->atStageMr->lkey;
+  wr.wr_id = id;
+  wr.sg_list = &sg;
+  wr.num_sge = 1;
+  wr.send_flags = IBV_SEND_SIGNALED;
+  if (read) {
+    wr.opcode = IBV_WR_RDMA_READ;
+    wr.wr.rdma.remote_addr = off;
+    wr.wr.rdma.rkey = rkey;
+  } else {
+    wr.opcode = IBV_WR_ATOMIC_FETCH_AND_ADD;
+    wr.wr.atomic.remote_addr = off;
+    wr.wr.atomic.compare_add = add;
+    wr.wr.atomic.rkey = rkey;
+  }
+  if (wrap_ibv_post_send(lh->atQa, &wr, &bad) != ncclSuccess) return broken("posting to the loopback atomic pair failed");
+  lh->atOutstanding++;
+  const double t0 = gdakiQ4MonoMs();
+  bool got = false;
+  while (!got) {
+    if (!poll(id, &got)) return broken(read ? "a READ on the loopback atomic pair completed in error"
+                                            : "a fetch-and-add on the loopback atomic pair completed in error");
+    if (got) break;
+    const double el = gdakiQ4MonoMs() - t0;
+    if (el > (double)r->copyMs) {
+      snprintf(why, whyLen, "a request on the loopback atomic pair did not complete in %d ms (NCCL_GIN_TS_COPY_MS)",
+               r->copyMs);
+      return ncclSystemError;
+    }
+    if (el < 2.0) std::this_thread::yield();
+    else std::this_thread::sleep_for(std::chrono::microseconds(50));
+  }
+  memcpy(val, lh->atStage, sizeof(*val));
+  return ncclSuccess;
+}
+// Setup (gdakiRsStart, single-threaded, after the NIC copy path chose its loopback address; a process that asks for the
+// restore and keeps a log). A failure leaves atomicOk false with why: Resume refuses on this rank with it.
+static void gdakiRsAtomicSetup(struct gdakiRecHost* r) {
+  struct gdakiRsLogHost* lh = r->rsLog;
+  struct gdaki_context* g = r->ctx;
+  if (lh == nullptr || g == nullptr) return;  // no log (measurement mode, nothing logs): no import, Resume refuses
+  auto fail = [&](const char* text) { snprintf(lh->atomicWhy, sizeof(lh->atomicWhy), "%.150s", text); };
+  lh->atomicCap = (int)g->ib_dev_attr.atomic_cap;
+  if (lh->atomicCap < IBV_ATOMIC_HCA) return fail("the HCA's atomic capability is below IBV_ATOMIC_HCA");
+  struct ibv_context* ictx = g->collComm ? g->collComm->ib.context : nullptr;
+  struct ibv_pd* pd = g->collComm ? g->collComm->ib.pd : nullptr;
+  if (ictx == nullptr || pd == nullptr) return fail("no GIN protection domain");
+  if (!gdakiLbOn(r)) return fail("the NIC copy path is off (its loopback address is the pair's)");
+  union ibv_gid gid;
+  memset(&gid, 0, sizeof(gid));
+  const bool roce = g->port_attr.link_layer == IBV_LINK_LAYER_ETHERNET;
+  if (roce && (r->lb->gidIndex < 0 || wrap_ibv_query_gid(ictx, g->port_num, r->lb->gidIndex, &gid) != ncclSuccess))
+    return fail("the loopback GID could not be read");
+  if (wrap_ibv_create_cq(&lh->atCq, ictx, 16, nullptr, nullptr, 0) != ncclSuccess) {
+    lh->atCq = nullptr;
+    return fail("cannot create the pair's CQ");
+  }
+  struct ibv_qp_init_attr ia;
+  memset(&ia, 0, sizeof(ia));
+  ia.send_cq = lh->atCq;
+  ia.recv_cq = lh->atCq;
+  ia.qp_type = IBV_QPT_RC;
+  ia.cap.max_send_wr = 4;
+  ia.cap.max_recv_wr = 1;
+  ia.cap.max_send_sge = 1;
+  ia.cap.max_recv_sge = 1;
+  if (wrap_ibv_create_qp(&lh->atQa, pd, &ia) != ncclSuccess) {
+    lh->atQa = nullptr;
+    return fail("cannot create the pair's QPs");
+  }
+  if (wrap_ibv_create_qp(&lh->atQb, pd, &ia) != ncclSuccess) {
+    lh->atQb = nullptr;
+    return fail("cannot create the pair's QPs");
+  }
+  if (posix_memalign((void**)&lh->atStage, 64, 64) != 0) {
+    lh->atStage = nullptr;
+    return fail("no staging word");
+  }
+  memset(lh->atStage, 0, 64);
+  lh->atStageMr = wrap_direct_ibv_reg_mr(pd, lh->atStage, 64, IBV_ACCESS_LOCAL_WRITE);
+  if (lh->atStageMr == nullptr) return fail("cannot register the pair's staging word");
+  // the self-test's target: the side table registered in the GIN PD by GIN's own routine (as the signal table: zero-based,
+  // strict), its first reserved word (offset 32; nothing else uses it)
+  if (gdakiRegMr(&lh->atSideMr, pd, r->rsBase, r->rsBytes,
+                 IBV_ACCESS_LOCAL_WRITE | IBV_ACCESS_REMOTE_READ | IBV_ACCESS_REMOTE_WRITE | IBV_ACCESS_REMOTE_ATOMIC,
+                 true) != ncclSuccess) {
+    lh->atSideMr = nullptr;
+    return fail("cannot register the side table in the GIN protection domain");
+  }
+  // connect atQa -> atQb (and back): the loopback route the NIC copy path proved (its GID or the port's LID)
+  auto connect = [&](struct ibv_qp* q, uint32_t dest) -> bool {
+    struct ibv_qp_attr a;
+    memset(&a, 0, sizeof(a));
+    a.qp_state = IBV_QPS_INIT;
+    a.pkey_index = (uint16_t)g->pkey_index;
+    a.port_num = g->port_num;
+    a.qp_access_flags = IBV_ACCESS_REMOTE_READ | IBV_ACCESS_REMOTE_WRITE | IBV_ACCESS_LOCAL_WRITE | IBV_ACCESS_REMOTE_ATOMIC;
+    if (wrap_ibv_modify_qp(q, &a, IBV_QP_STATE | IBV_QP_PKEY_INDEX | IBV_QP_PORT | IBV_QP_ACCESS_FLAGS) != ncclSuccess)
+      return false;
+    memset(&a, 0, sizeof(a));
+    a.qp_state = IBV_QPS_RTR;
+    a.path_mtu = g->port_attr.active_mtu;
+    a.dest_qp_num = dest;
+    a.rq_psn = 0;
+    a.max_dest_rd_atomic = 1;
+    a.min_rnr_timer = 12;
+    a.ah_attr.port_num = g->port_num;
+    if (roce) {
+      a.ah_attr.is_global = 1;
+      a.ah_attr.grh.dgid = gid;
+      a.ah_attr.grh.sgid_index = (uint8_t)r->lb->gidIndex;
+      a.ah_attr.grh.hop_limit = 255;
+    } else {
+      a.ah_attr.dlid = g->port_attr.lid;
+    }
+    if (wrap_ibv_modify_qp(q, &a, IBV_QP_STATE | IBV_QP_AV | IBV_QP_PATH_MTU | IBV_QP_DEST_QPN | IBV_QP_RQ_PSN |
+                                    IBV_QP_MAX_DEST_RD_ATOMIC | IBV_QP_MIN_RNR_TIMER) != ncclSuccess)
+      return false;
+    memset(&a, 0, sizeof(a));
+    a.qp_state = IBV_QPS_RTS;
+    a.timeout = 14;
+    a.retry_cnt = 7;
+    a.rnr_retry = 7;
+    a.sq_psn = 0;
+    a.max_rd_atomic = 1;
+    return wrap_ibv_modify_qp(q, &a, IBV_QP_STATE | IBV_QP_TIMEOUT | IBV_QP_RETRY_CNT | IBV_QP_RNR_RETRY | IBV_QP_SQ_PSN |
+                                       IBV_QP_MAX_QP_RD_ATOMIC) == ncclSuccess;
+  };
+  if (!connect(lh->atQa, lh->atQb->qp_num) || !connect(lh->atQb, lh->atQa->qp_num))
+    return fail("the pair's QPs could not be connected");
+  // the self-test (the word is 0): +1 must give old 0 and read back 1 (the HCA adds in host byte order, as the survivors'
+  // atomics on the GIN tables), then -1 must give old 1 and restore 0
+  const uint64_t off = 32;
+  const uint32_t rkey = lh->atSideMr->rkey;
+  uint64_t old = ~0ull, now = ~0ull;
+  char w[160];
+  lh->atomicOk = true;  // gdakiRsAtomicOp marks it broken on a failed request
+  if (gdakiRsAtomicOp(r, false, off, rkey, 1, &old, w, sizeof(w)) != ncclSuccess ||
+      gdakiRsAtomicOp(r, true, off, rkey, 0, &now, w, sizeof(w)) != ncclSuccess) {
+    lh->atomicOk = false;
+    return fail(w);
+  }
+  if (old != 0 || now != 1) {
+    lh->atomicOk = false;
+    snprintf(w, sizeof(w), "the self-test's fetch-and-add of 1 to 0 read %#lx then %#lx (not host byte order?)",
+             (unsigned long)old, (unsigned long)now);
+    return fail(w);
+  }
+  if (gdakiRsAtomicOp(r, false, off, rkey, ~0ull, &old, w, sizeof(w)) != ncclSuccess ||
+      gdakiRsAtomicOp(r, true, off, rkey, 0, &now, w, sizeof(w)) != ncclSuccess) {
+    lh->atomicOk = false;
+    return fail(w);
+  }
+  if (old != 1 || now != 0) {
+    lh->atomicOk = false;
+    return fail("the self-test's fetch-and-add of -1 did not restore 0");
+  }
+  snprintf(lh->atomicWhy, sizeof(lh->atomicWhy), "ready");
+}
+static bool gdakiRsAtomicReady(struct gdakiRecHost* r, char* why, size_t whyLen) {
+  if (r == nullptr || r->rsLog == nullptr) {
+    snprintf(why, whyLen, "no send-side log on this rank");
+    return false;
+  }
+  snprintf(why, whyLen, "%s", r->rsLog->atomicWhy);
+  return r->rsLog->atomicOk;
+}
+// The plan that counts every WQE of the ending epoch executed (RL8; the dead rank's spare starts from the checkpoint and
+// the survivor's entries since the cut are applied to it, so nothing is re-posted): U = S, n = 0 per QP of the round's
+// scope, after the checks gdakiTsRepostPlanAll makes before it plans.
+static ncclResult_t gdakiRsPlanAllExecuted(struct gdakiRecHost* r, int peer, std::vector<struct gdakiTsRepostPlan>& plans,
+                                           const char** why) {
+  plans.clear();
+  if (r->ts == nullptr) {
+    *why = "transparent recovery is off";
+    return ncclInvalidUsage;
+  }
+  if (r->ts->surfaced.load(std::memory_order_acquire)) {  // as gdakiTsRepostPlanAll
+    *why = "the watchdog surfaced the fault before the commit point";
+    return ncclSystemError;
+  }
+  if (r->ts->stop.load(std::memory_order_acquire)) {
+    *why = "the communicator is being destroyed";
+    return ncclSystemError;
+  }
+  if (gdakiUaPeerRaised(r, peer)) {
+    *why = "the device waits on the peer were already released";
+    return ncclSystemError;
+  }
+  gdakiRecForPeer(r, peer, [&](gdakiRecQp& rq, struct doca_gpu_verbs_qp_hl* q) {
+    struct gdakiTsRepostPlan pl;
+    pl.rq = &rq;
+    pl.q = q;
+    pl.S = rq.epochWqes;
+    pl.U = pl.S;
+    pl.n = 0;
+    pl.ringN = rq.snap.sq_wqe_num;
+    pl.mask = rq.snap.sq_wqe_mask;
+    pl.laps = r->ts->qs[rq.qpIdx].rescue ? r->ts->rescueLaps : 0;
+    plans.push_back(std::move(pl));
+  });
+  if (plans.empty()) {
+    *why = "no QP to the peer in this round";
+    return ncclInvalidUsage;
+  }
+  GIN_TS_NOTE("GIN/RS: rank %d: re-post plan to rank %d: %u qp(s), every WQE of the ending epoch counted executed (U = S, "
+              "n = 0) mono_ms=%.3f", r->ctx->rank, peer, (unsigned)plans.size(), gdakiQ4MonoMs());
+  return ncclSuccess;
+}
+// The export (helper; the survivor's STATE toward the restored rank's spare). The entries come from gdakiRsLogCollect
+// (refused when the log is not whole since `cut`); their messages per QP must equal m (at the hold start) minus M at the
+// cut's pause; each put's source is read over the NIC copy path in chunks of the staging buffer, under the window
+// registry's lock, its window still registered (a deregistration waits for the chunk: gdakiRsWinGone takes the lock).
+// Returns ncclSuccess with a whole OK stream; ncclInvalidUsage (why) when the export is refused before the stream or the
+// stream ends with ok = 0 ("source buffer changed", a source gone); ncclSystemError when the stream or a read failed.
+static ncclResult_t gdakiRsLogExport(struct gdakiRecHost* r, int peer, uint64_t ckpt, uint64_t cut, uint64_t head,
+                                     uint32_t incarnation, const uint64_t* x, const uint64_t* m, int nqp,
+                                     bool (*put)(void* arg, const void* p, size_t n), void* arg, char* why,
+                                     size_t whyLen) {
+  if (!gdakiRsLogReady(r)) return gdakiRsLogNotReady(why, whyLen);
+  struct gdakiRsLogHost* lh = r->rsLog;
+  int idx[NCCL_GIN_RECOVERY_MAX_QPS];
+  const int n = gdakiRsQpsOfPeer(r, peer, idx);
+  if (n == 0 || n != nqp || r->ts == nullptr || put == nullptr) {
+    snprintf(why, whyLen, "rank %d has %d QPs here, %d counts given", peer, n, nqp);
+    return ncclInvalidUsage;
+  }
+  std::vector<struct ncclGinRsLogEntry> ents;
+  const ncclResult_t rc = gdakiRsLogCollect(r, peer, cut, head, &ents, why, whyLen);
+  if (rc != ncclSuccess) return rc;
+  uint64_t mCut[NCCL_GIN_RECOVERY_MAX_QPS];
+  for (int k = 0; k < n; k++)
+    if (!gdakiRsLogStateMsgsAt(&lh->st, idx[k], cut, &mCut[k])) {
+      snprintf(why, whyLen, "qp %d: no message count kept for the pause at position %lu", idx[k], (unsigned long)cut);
+      return ncclInvalidUsage;
+    }
+  char cw[200];
+  if (!gdakiRsLogXMsgsCheck(ents.data(), ents.size(), idx, n, m, mCut, cw, sizeof(cw))) {
+    snprintf(why, whyLen, "the log toward rank %d is not whole: %s", peer, cw);
+    return ncclInvalidUsage;
+  }
+  struct gdakiRsLogXHdr hdr;
+  memset(&hdr, 0, sizeof(hdr));
+  hdr.magic = GDAKI_RS_LOGX_MAGIC;
+  hdr.version = 1;
+  hdr.from = r->ctx->rank;
+  hdr.to = peer;
+  hdr.incarnation = incarnation;
+  hdr.nqp = (uint32_t)n;
+  hdr.nonce = r->ts->nonce;
+  hdr.ckpt = ckpt;
+  hdr.cut = cut;
+  hdr.head = head;
+  hdr.nEntries = ents.size();
+  for (int k = 0; k < n; k++) {
+    hdr.x[k] = x[k];
+    hdr.m[k] = m[k];
+  }
+  void* const coll = (void*)r->ctx->collComm;
+  uint64_t dataBytes = 0;
+  bool readFailed = false;
+  auto read = [&](const struct ncclGinRsLogEntry& e, uint64_t off, uint64_t len, const char** bad) -> const uint8_t* {
+    std::lock_guard<std::mutex> lk(gdakiRsWinMu);
+    const struct gdakiRsWin* w = nullptr;
+    for (const auto& c : gdakiRsWins)
+      if (c.coll == coll && !c.gone && c.id == e.srcWin) w = &c;
+    const uint64_t size = w ? (uint64_t)(w->hi - w->lo) : 0;
+    if (w == nullptr) *bad = "its source window is no longer registered";
+    else if (e.src > size || off > size - e.src || len > size - e.src - off) *bad = "its source range is outside its window";
+    else if (!gdakiLbOn(r) || gdakiLbXfer(r, false, (const void*)(w->lo + e.src + off), (size_t)len) != ncclSuccess) {
+      *bad = "its source could not be read over the NIC copy path";
+      readFailed = true;
+    } else {
+      dataBytes += len;
+      return r->pinned;
+    }
+    return nullptr;
+  };
+  auto putf = [&](const void* p, size_t k) { return put(arg, p, k); };
+  const uint64_t chunk = std::min<uint64_t>((uint64_t)r->pinnedSize, 1ull << 20);
+  const int b = gdakiRsLogXBuild(hdr, ents.data(), ents.size(), chunk, read, putf, why, whyLen);
+  GIN_TS_NOTE("GIN/RS: rank %d: log export to rank %d: checkpoint=%lu cut=%lu head=%lu entries=%zu data_bytes=%lu "
+              "incarnation=%u verdict=%s%s%s mono_ms=%.3f", r->ctx->rank, peer, (unsigned long)ckpt, (unsigned long)cut,
+              (unsigned long)head, ents.size(),
+              (unsigned long)dataBytes, incarnation,
+              b == GDAKI_RS_LOGX_OK ? "ok" : b == GDAKI_RS_LOGX_REFUSED ? "refused" : "stream_failed",
+              b == GDAKI_RS_LOGX_OK ? "" : " why=", b == GDAKI_RS_LOGX_OK ? "" : why, gdakiQ4MonoMs());
+  if (b == GDAKI_RS_LOGX_OK) return ncclSuccess;
+  return (b == GDAKI_RS_LOGX_REFUSED && !readFailed) ? ncclInvalidUsage : ncclSystemError;
+}
+// The spare's import (the application thread, inside the spare's ncclGinRestoreResume after its image is written and
+// before its kernels and its helper start; the GIN-PD loopback pair's only user then). Checked first, nothing applied when
+// a check fails: the plan (gdakiRsImportPlanOf), the signal additions against the entries again (gdakiRsImportSigCheck),
+// the pair (set up and self-tested), every signal target 8-byte aligned inside the GIN MR the survivors name. Then, with
+// the window registry's lock held (the windows and their GIN MRs stay registered while their memory is written), in this
+// order (option (b), 2026-10-12): (1) the data copies on the log state's stream, waited for; (2) the signal additions as
+// NIC fetch-and-add on the pair through those GIN MRs, one completed before the next; (3) the suppress budgets and counts
+// (msgs = X, suppress = X - P) and the responder counts' base (M). Data before signals as the device posts them; budgets
+// last, so a failure part way leaves none (the restore falls back).
+static ncclResult_t gdakiRsSpareImport(struct gdakiRecHost* r, const struct gdakiCkptPeerP* peerP, uint32_t nPeers,
+                                       const std::vector<std::vector<uint8_t>>& exports, uint64_t ckpt,
+                                       uint32_t incarnation, char* why, size_t whyLen) {
+  if (!gdakiRsLogReady(r)) return gdakiRsLogNotReady(why, whyLen);
+  struct gdakiRsLogHost* lh = r->rsLog;
+  if (r->ts == nullptr || r->nranks <= 0 || (peerP == nullptr && nPeers != 0)) {
+    snprintf(why, whyLen, "no transparent recovery state, or no P records");
+    return ncclInvalidUsage;
+  }
+  const int nranks = r->nranks, me = r->ctx->rank;
+  std::vector<int> nqpOf((size_t)nranks, 0);
+  for (int q = 0; q < nranks; q++) {
+    int idx[NCCL_GIN_RECOVERY_MAX_QPS];
+    nqpOf[(size_t)q] = q == me ? 0 : gdakiRsQpsOfPeer(r, q, idx);
+  }
+  std::vector<struct gdakiRsImportP> pp;
+  for (uint32_t i = 0; i < nPeers; i++) {
+    if (peerP[i].nqp > NCCL_GIN_RECOVERY_MAX_QPS) {
+      snprintf(why, whyLen, "rank %d's P record has %u QPs", peerP[i].rank, peerP[i].nqp);
+      return ncclInvalidUsage;
+    }
+    pp.push_back({peerP[i].rank, peerP[i].nqp, peerP[i].p});
+  }
+  void* const coll = (void*)r->ctx->collComm;
+  std::lock_guard<std::mutex> wl(gdakiRsWinMu);  // held until the copies are done
+  std::vector<struct gdakiRsImportWin> wins;
+  std::vector<uintptr_t> base;
+  std::vector<struct ibv_mr*> winMr;  // the window's GIN MR (the survivors' atomics name it), A1
+  for (const auto& w : gdakiRsWins)
+    if (w.coll == coll && !w.gone && w.id != 0) {
+      wins.push_back({w.id, (uint64_t)(w.hi - w.lo)});
+      base.push_back(w.lo);
+      winMr.push_back(w.mhandle ? ((struct gdaki_mem_handle*)w.mhandle)->mr : nullptr);
+    }
+  uint8_t* sigBase = nullptr;
+  uint64_t sigBytes = 0;
+  if (r->ctx->signals_table != nullptr) {
+    sigBase = (uint8_t*)r->ctx->signals_table->gpu_ptr;
+    sigBytes = sigBase ? (uint64_t)r->ctx->signals_table->buffer_bytes() : 0;
+  }
+  struct gdakiRsImportPlan plan;
+  char pw[256];
+  if (!gdakiRsImportPlanOf(me, ckpt, incarnation, r->ts->nonce, nqpOf.data(), nranks, pp.data(), (int)pp.size(), exports,
+                           wins.data(), (int)wins.size(), sigBytes, &plan, pw, sizeof(pw))) {
+    snprintf(why, whyLen, "the log import was refused, nothing applied: %s", pw);
+    return ncclInvalidUsage;
+  }
+  auto addrOf = [&](uint32_t win, uint64_t off) -> uint8_t* {
+    if (win == 0) return sigBase + off;
+    for (size_t i = 0; i < wins.size(); i++)
+      if (wins[i].id == win) return (uint8_t*)base[i] + off;
+    return nullptr;  // not reached: the plan checked every target
+  };
+  uint64_t sigTotal = 0;
+  if (!gdakiRsImportSigCheck(exports, plan, &sigTotal, pw, sizeof(pw))) {
+    snprintf(why, whyLen, "the log import was refused, nothing applied: the signal additions do not match the entries: %s",
+             pw);
+    return ncclInvalidUsage;
+  }
+  // per target: the GIN MR the survivors' signal atomics name (the signal table's, or the VA signal window's) and the
+  // zero-based offset in it (A1: one memory key and one location for both)
+  std::vector<std::pair<uint64_t, uint32_t>> sigAt(plan.sigs.size());  // (offset in the GIN MR, its rkey)
+  if (!plan.sigs.empty() && !lh->atomicOk) {
+    snprintf(why, whyLen, "the log import was refused, nothing applied: this rank cannot add signals with NIC atomics (%s)",
+             lh->atomicWhy);
+    return ncclInvalidUsage;
+  }
+  for (size_t i = 0; i < plan.sigs.size(); i++) {
+    const struct gdakiRsImportSig& t = plan.sigs[i];
+    struct ibv_mr* mr = nullptr;
+    if (t.win == 0) {
+      mr = r->ctx->signals_table != nullptr ? r->ctx->signals_table->mr : nullptr;
+    } else {
+      for (size_t k = 0; k < wins.size(); k++)
+        if (wins[k].id == t.win) mr = winMr[k];
+    }
+    const uintptr_t a = (uintptr_t)addrOf(t.win, t.off);
+    if (mr == nullptr || t.off + 8 > (uint64_t)mr->length || (t.off & 7) != 0 || (a & 7) != 0) {
+      snprintf(why, whyLen, "the log import was refused, nothing applied: signal %s %u offset %lu is %s",
+               t.win ? "window" : "table", t.win, (unsigned long)t.off,
+               mr == nullptr ? "in no GIN MR" : (t.off & 7) != 0 || (a & 7) != 0 ? "not 8-byte aligned" : "outside its MR");
+      return ncclInvalidUsage;
+    }
+    sigAt[i] = {t.off, mr->rkey};
+  }
+  std::lock_guard<std::mutex> al(lh->appMu);
+  struct gdakiRsDevGuard g;
+  if (!gdakiRsAppStream(r, &g)) {
+    snprintf(why, whyLen, "the log import was refused, nothing applied: no CUDA stream on device %d", r->ctx->cuda_id);
+    return ncclUnhandledCudaError;
+  }
+  // the image's copies (pageable cudaMemcpy may return before its DMA lands) are done before anything is read or written
+  // here, on a stream that is not ordered after them (review of work package 9, S1); the spare runs no kernel yet
+  if (cudaDeviceSynchronize() != cudaSuccess) {
+    snprintf(why, whyLen, "the log import was refused, nothing applied: the device did not synchronize");
+    return ncclUnhandledCudaError;
+  }
+  cudaStream_t st = lh->appStream;
+  bool ok = true;
+  // (1) the data copies, landed before the first signal is added
+  for (const auto& c : plan.copies)
+    ok = ok && cudaMemcpyAsync(addrOf(c.win, c.off), c.data ? (const void*)c.data : (const void*)&c.value, (size_t)c.bytes,
+                               cudaMemcpyHostToDevice, st) == cudaSuccess;
+  ok = ok && cudaStreamSynchronize(st) == cudaSuccess;
+  if (!ok) {
+    snprintf(why, whyLen, "the log import failed part way (a CUDA copy); the restore falls back");
+    return ncclUnhandledCudaError;
+  }
+  // (2) the signal additions: NIC fetch-and-add on the GIN-PD pair through the survivors' own GIN MRs, atomic with their
+  // signal atomics on this HCA; what is posted must add up to the entries' total (checked above per target)
+  uint64_t posted = 0;
+  for (size_t i = 0; i < plan.sigs.size(); i++) {
+    uint64_t old = 0;
+    char aw[200];
+    if (gdakiRsAtomicOp(r, false, sigAt[i].first, sigAt[i].second, plan.sigs[i].add, &old, aw, sizeof(aw)) != ncclSuccess) {
+      snprintf(why, whyLen, "the log import failed part way (signal %zu of %zu: %s); the restore falls back", i,
+               plan.sigs.size(), aw);
+      return ncclSystemError;
+    }
+    posted += plan.sigs[i].add;
+  }
+  if (posted != sigTotal) {  // not reachable after the check above
+    snprintf(why, whyLen, "the log import failed part way (the signal additions posted %lu, the entries %lu)",
+             (unsigned long)posted, (unsigned long)sigTotal);
+    return ncclInternalError;
+  }
+  // (3) below: the suppress budgets and counts, then the responder counts' base
+  for (const auto& pe : plan.peers) {
+    int idx[NCCL_GIN_RECOVERY_MAX_QPS];
+    const int n = gdakiRsQpsOfPeer(r, pe.rank, idx);
+    char sw[160];
+    if (n != pe.nqp || gdakiRsSuppressWrite(r, idx, n, pe.x, pe.budget, sw, sizeof(sw)) != ncclSuccess) {
+      snprintf(why, whyLen, "the log import failed part way (rank %d's budgets); the restore falls back", pe.rank);
+      return ncclUnhandledCudaError;
+    }
+    for (int k = 0; k < n; k++) gdakiRsExecSetBase(r, idx[k], pe.m[k]);
+  }
+  GIN_TS_NOTE("GIN/RS: rank %d: log import: checkpoint=%lu survivors=%zu entries=%lu data_bytes=%lu copies=%zu "
+              "signal_adds=%lu signal_targets=%zu signal_sum=%lu (NIC fetch-and-add) incarnation=%u", me,
+              (unsigned long)ckpt, plan.peers.size(), (unsigned long)plan.entries, (unsigned long)plan.dataBytes,
+              plan.copies.size(), (unsigned long)plan.sigAdds, plan.sigs.size(), (unsigned long)sigTotal, incarnation);
+  return ncclSuccess;
+}
