+             in.devCommVersion);
+  GDAKI_RS_L(in.told != nullptr, "a fault already reached the application on this communicator (%s)", in.told);
+  GDAKI_RS_L(in.spare, "this build cannot run a spare process yet");
+  GDAKI_RS_L(in.nConn <= 0, "the devComm has no GIN connection");
+  GDAKI_RS_L(in.ginType != 3, "the devComm's GIN backend is not GDAKI (type %d)", in.ginType);
+  GDAKI_RS_L(!in.commFull, "the communicator's GIN connection is not FULL");
+  GDAKI_RS_L(in.ctxStride != 1, "the devComm's GIN rank stride is %d, not 1", in.ctxStride);
+  GDAKI_RS_L(in.nConn != 1, "the devComm has %d GIN connections (NCCL_GIN_NCONNECTIONS), the restore needs one", in.nConn);
+  GDAKI_RS_L(in.numRmaCtx != 0, "host RMA is on (%d contexts; NCCL_NUM_RMA_CTX=0 turns it off)", in.numRmaCtx);
+  GDAKI_RS_L(!in.runtimeConn, "runtime connect is off (NCCL_RUNTIME_CONNECT)");
+  GDAKI_RS_L(in.nvls, "NVLS is on (NCCL_NVLS_ENABLE)");
+  GDAKI_RS_L(in.lsaSize != 1, "the devComm's LSA team has %d ranks, the restore needs 1", in.lsaSize);
+  GDAKI_RS_L(in.symGinDevComm, "NCCL's symmetric kernels made their own GIN devComm on this communicator");
+  GDAKI_RS_L(!in.haveSetup, "transparent recovery is off for this devComm (NCCL_GIN_FAULT_RECOVERY, "
+             "NCCL_GIN_FAULT_TRANSPARENT and NCCL_GIN_FAULT_CLASSIFY must be 1)");
+  GDAKI_RS_L(in.nUserCtx != 1, "the communicator has %d GDAKI contexts with transparent recovery, the restore needs one",
+             in.nUserCtx);
+  GDAKI_RS_L(!in.tsOn, "transparent recovery went off on this rank after the setup agreement (%s)",
+             in.offWhy && *in.offWhy ? in.offWhy : "the helper is not running");
+  GDAKI_RS_L(in.reconnect != 1, "NCCL_GIN_TS_RECONNECT is not 1");
+  GDAKI_RS_L(in.qpwatchMs <= 0, "the QP watch is off (NCCL_GIN_TS_QPWATCH_MS)");
+  GDAKI_RS_L(in.restoreMs <= 0 || in.restoreMs >= in.holdMs,
+             "NCCL_GIN_RESTORE_MS (%lld) is not between 0 and NCCL_GIN_TS_HOLD_MS (%lld)", in.restoreMs, in.holdMs);
+  GDAKI_RS_L(!in.lbOn, "the NIC copy path is off (its setup or self-test failed, or it was turned off)");
+  GDAKI_RS_L(!in.sideOk, "the side table is not set up on this rank (%s)", in.sideWhy ? in.sideWhy : "unknown");
+  GDAKI_RS_L(!in.rsLbOk, "the restore buffers are not in the NIC copy path (%s)", in.rsLbWhy ? in.rsLbWhy : "unknown");
+  GDAKI_RS_L(in.winsAfter > 0, "%d window(s) were registered after the devComm's GDAKI context (their rkey tables are "
+             "not in the NIC copy path)", in.winsAfter);
+  GDAKI_RS_L(in.winsGone > 0, "%d window(s) of this context's restore buffers were deregistered", in.winsGone);
+  GDAKI_RS_L(!in.resOk, "the devComm's resource window could not be added to the NIC copy path (%s)",
