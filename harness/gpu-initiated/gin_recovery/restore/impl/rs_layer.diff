+// ---- gin-restore (integration, 2026-10-12): the spare process's ncclGinRestoreResume (impl/rs_spare_api.h's driver,
+// impl/rs_ckpt_api.h's FETCH and STATE, impl/rs_log_api.h's import) ----
+// A spare (NCCL_GIN_RESTORE_SPARE) replayed its rank's init and its Resume exchange from the transcript, so the decision
+// above is its rank's. Here it waits for its activation, takes the survivors one at a time (REJOIN, the data socket: the
+// image from its buddy at the first survivor, then each survivor's log export; its rkey list back; TOKEN, READY, DONE_RS),
+// sends RESTORED and starts its helper (gdakiRsSpareRun). The log import (gdakiRsSpareImport, the dev branch's) needs every
+// survivor's export and must run before the helper starts and before RESTORED (its documented order: before the spare's
+// kernels and helper), so it runs in the data call of the last survivor the driver takes (rank order), after that
+// survivor's export arrived and before its round. Any failure ends the spare without BYE (the driver's no-BYE exit); the
+// survivors then fall back. On success the communicator is armed as the first incarnation's Resume arms it, and Resume
+// returns the checkpoint's step and the blob its rank passed to ncclGinRestoreStep.
+NCCL_PARAM(GinRestoreSparePort, "GIN_RESTORE_SPARE_PORT", 0);              // the spare's activation port (required)
+NCCL_PARAM(GinRestoreSpareWaitMs, "GIN_RESTORE_SPARE_WAIT_MS", 3600000);   // how long a spare waits for its activation
+struct gdakiRsSpareResumeArg {
+  struct gdakiCkptSpareData d;
+  int lastPeer = -1;      // the last survivor the driver takes (rank order): its data call runs the import
+  size_t blobCap = 0;     // ncclGinRestoreResume's *bytes in
+  bool imported = false;
+};
+static int gdakiRsSpareDataFdImport(void* arg, int peer) {
+  struct gdakiRsSpareResumeArg* a = (struct gdakiRsSpareResumeArg*)arg;
+  const int fd = gdakiCkptSpareDataFd(&a->d, peer);  // the image first (once), then this survivor's export
+  if (fd < 0) return -1;
+  struct gdakiRecHost* r = a->d.r;
+  if (a->d.blob.size() > a->blobCap) {
+    WARN("GIN/RS: spare rank %d: the checkpoint's blob (%zu bytes) does not fit ncclGinRestoreResume's buffer (%zu bytes)",
+         r->ctx->rank, a->d.blob.size(), a->blobCap);
+    return -1;
+  }
+  if (peer != a->lastPeer || a->imported) return fd;
+  char why[384];  // the import's refusal: its own prefix and a reason of up to 255 bytes
+  const struct gdakiCkptHdr& h = a->d.hdr[0];  // gdakiCkptSpareDataFd returns a socket only after a fetch that succeeded
+  if (gdakiRsSpareImport(r, h.peerP, h.nPeers, a->d.exports, h.ckpt, gdakiRsPeerInc(r, r->ctx->rank), why,
+                         sizeof(why)) != ncclSuccess) {
+    WARN("GIN/RS: spare rank %d: %s", r->ctx->rank, why);
+    return -1;
+  }
+  a->imported = true;
+  return fd;
+}
+static ncclResult_t gdakiRsSpareResume(const struct ncclGinRestoreCommFacts* f, struct gdakiRecHost* r, void* resMh,
+                                       unsigned long long* step, void* blob, size_t* bytes) {
+  const long long port = (long long)ncclParamGinRestoreSparePort();
+  const char* bad = r == nullptr || r->ts == nullptr || r->ctx == nullptr ? "no GDAKI context with transparent recovery"
+                    : r->hold == nullptr                                  ? "no hold state on its context"
+                    : port <= 0 || port > 65535                           ? "NCCL_GIN_RESTORE_SPARE_PORT is not a port"
+                    : step == nullptr || bytes == nullptr                 ? "a NULL step or bytes"
+                    : !r->rsPublished.load(std::memory_order_acquire)
+                        ? "its side table is not on the device (its replay would post the suppressed messages again)"
+                        : nullptr;
+  if (bad != nullptr) {  // nothing was answered: the buddy's ACTIVATE finds no port and the survivors fall back
+    WARN("GIN/RS: spare rank %d: ncclGinRestoreResume cannot run the restore: %s", f->rank, bad);
+    return ncclInvalidUsage;
+  }
+  struct gdakiRsSpareResumeArg a;
+  uint64_t ckptStep = 0;  // set by the driver at the activation, before its first data call
+  a.d.r = r;
+  a.d.step = &ckptStep;
+  // one transfer, and the whole handshake: every survivor has fallen back by NCCL_GIN_TS_HOLD_MS after its gates went odd
+  const int hsMs = std::max(1000, r->ts->holdMs);
+  a.d.timeoutMs = hsMs;
+  a.blobCap = blob != nullptr ? *bytes : 0;
+  for (int p = 0; p < (int)r->ts->peers.size(); p++)
+    if (r->ts->peers[p].gated && p != r->ctx->rank) a.lastPeer = p;
+  const int waitMs = (int)std::min<long long>(std::max<long long>(1, (long long)ncclParamGinRestoreSpareWaitMs()), INT_MAX);
+  GIN_TS_NOTE("GIN/RS: spare rank %d: ncclGinRestoreResume: waiting for the activation (port %lld, at most %d ms)",
+              f->rank, port, waitMs);
+  const ncclResult_t rr = gdakiRsSpareRun(r, (int)port, waitMs, hsMs, gdakiRsSpareDataFdImport, &a, &ckptStep);
+  gdakiCkptSpareDataDone(&a.d);  // the data sockets are this path's (the driver never closes them)
+  if (rr != ncclSuccess || !a.imported) {
+    WARN("GIN/RS: spare rank %d: the restore failed (%s); this spare ended without BYE", f->rank,
+         rr != ncclSuccess ? "the activation or a survivor's handshake" : "no survivor's export was imported");
+    return rr != ncclSuccess ? rr : ncclSystemError;
+  }
+  bool armed = false;
+  {
+    std::lock_guard<std::mutex> lk(gdakiRecRegMu);  // the context stays registered (its hold state alive), as above
+    for (auto* x : gdakiRecReg)
+      if (x == r && x->hold != nullptr) {
+        gdakiHoldOnResume(x, resMh);
+        armed = true;
+      }
+  }
+  *step = (unsigned long long)ckptStep;
+  if (blob != nullptr && !a.d.blob.empty()) memcpy(blob, a.d.blob.data(), a.d.blob.size());
+  *bytes = a.d.blob.size();
+  GIN_TS_NOTE("GIN/RS: spare rank %d: ncclGinRestoreResume: restored as incarnation %u from checkpoint %llu (blob %zu "
+              "bytes); the communicator is %s mono_ms=%.3f", f->rank, gdakiRsPeerInc(r, r->ctx->rank),
+              (unsigned long long)ckptStep, a.d.blob.size(), armed ? "armed" : "not armed: no hold state on this context",
+              gdakiQ4MonoMs());
+  return ncclSuccess;
+}
