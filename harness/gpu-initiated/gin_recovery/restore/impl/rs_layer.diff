+// gin-restore (rs, work package 4): the side table (its header and, with qps, its QP entries) into the staging buffer
+// over the NIC copy path (no CUDA call). The helper only, or the application thread once the helper has stopped (the path
+// has one user at a time).
+static bool gdakiRsReadSide(struct gdakiRecHost* r, struct ncclGinRsSide* hdr, std::vector<struct ncclGinRsQp>* qps,
+                            const char** why = nullptr) {
+  const char* w = nullptr;
+  const size_t n = sizeof(struct ncclGinRsSide) + (qps ? (size_t)r->rsNqp * sizeof(struct ncclGinRsQp) : 0);
+  if (!r->rsPtrSet || r->rsNqp <= 0) w = "no side table";
+  else if (!r->rsLbOk || !gdakiLbOn(r)) w = "the NIC copy path is off";
+  else if (n > r->pinnedSize) w = "the side table is larger than the staging buffer";
+  if (w == nullptr && gdakiLbXfer(r, false, r->rsBase, n) != ncclSuccess) w = "the read over the NIC copy path failed";
+  if (w != nullptr) {
+    if (why) *why = w;
+    return false;
+  }
+  memcpy(hdr, r->pinned, sizeof(*hdr));
+  if (qps) {
+    qps->resize((size_t)r->rsNqp);
+    memcpy(qps->data(), r->pinned + sizeof(struct ncclGinRsSide), n - sizeof(struct ncclGinRsSide));
+  }
+  return true;
