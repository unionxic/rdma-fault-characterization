+      resRkeysBytes = src[(size_t)wc.res]->rkeysBytes;
+    }
+  }
+  if (!resFound) {
+    in.resOk = false;
+    snprintf(resWhy, sizeof(resWhy), "it is not among this process's GDAKI windows");
+  } else if (resRkeys != nullptr && c.requested && in.tsOn && in.sideOk && in.rsLbOk && in.lbOn) {
+    std::lock_guard<std::mutex> lk(gdakiRecRegMu);  // rFound stays registered (and its NIC path alive) while held
+    bool still = false;
+    for (auto* r : gdakiRecReg) still = still || r == rFound;
+    struct gdakiLb* lb = still ? rFound->lb : nullptr;
+    if (lb == nullptr || !lb->rsShared) {
+      in.resOk = false;
+      snprintf(resWhy, sizeof(resWhy), "the NIC copy path is gone");
+    } else {
+      std::lock_guard<std::mutex> ml(lb->mrsMu);
+      if (gdakiLbFindLocked(lb, (uintptr_t)resRkeys, resRkeysBytes) == nullptr) {
+        if (lb->mrs.size() >= lb->mrs.capacity()) {  // its entries must not move: the helper may hold a pointer to one
+          in.resOk = false;
+          snprintf(resWhy, sizeof(resWhy), "the NIC copy path's MR list is full");
+        } else if (gdakiLbAddRange(lb, resRkeys, resRkeysBytes, "resource window rkey table", resWhy, sizeof(resWhy)) !=
+                   ncclSuccess) {
+          in.resOk = false;
+        }
+      }
+    }
+  }
+  in.resWhy = resWhy;
+  if (f->asyncErr != (int)ncclSuccess)  // the communicator's asynchronous error (ncclCommGetAsyncError, the entry)
+    snprintf(told, sizeof(told), "the communicator has an asynchronous error: %s",
+             ncclGetErrorString((ncclResult_t)f->asyncErr));
+  else
+    gdakiRsTold(comm, asyncSet, told, sizeof(told));  // after gdakiRecRegMu is released
+  in.told = told[0] ? told : nullptr;
+  mine.localCode = gdakiRsLocalCheck(in, mine.localWhy, sizeof(mine.localWhy));
+  // the exchange over the communicator's bootstrap, bounded
+  const int n = f->nRanks;
+  std::vector<struct gdakiRsXRec> all((size_t)n);
+  all[(size_t)f->rank] = mine;
+  bool expired = false;
+  const long long boundMs = std::min<long long>((long long)ncclParamGinRestoreResumeMs(), 86400000LL);  // <= 1 day
+  const int xr = gdakiRsRunBounded([&] { return (int)exchange(comm, all.data(), (int)sizeof(struct gdakiRsXRec)); },
+                                   [&] { abortComm(comm); }, boundMs, &expired);
