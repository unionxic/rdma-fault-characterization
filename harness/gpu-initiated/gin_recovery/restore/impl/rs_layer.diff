+// ---- gin-restore hold: pure functions (begin; impl/rs_unit_host.cc compiles this region on the CPU) ----
+// The decisions of the hold state machine (EXPERIMENT.md 9.10.5, 9.10.7), as functions of plain values: what a decline,
+// a record, a REQ, a helper-socket record, the watcher's clock, the helper's step and an arming ask do to one peer's
+// state. The host code (region "hold machine") reads the facts, asks these, and makes the moves (compare-and-swap on the
+// cell, the decline, the records it sends). impl/rs_unit_host.cc checks every state against every event.
+
+// G2: a decline toward a peer (gdakiTsDecline's first statement).
+enum {
+  GDAKI_HOLD_D_PASS = 0,         // the decline runs as hk's (fail-fast); nothing else
+  GDAKI_HOLD_D_PASS_NOHOLD = 1,  // the decline runs; the peer was ARMED: OFF, and NOHOLD(p, i) to every rank (N4, Q1)
+  GDAKI_HOLD_D_START = 2,        // the hold starts instead of the decline (the decline is taken)
+  GDAKI_HOLD_D_FALLBACK = 3,     // the peer is held: any decline is its fallback (V1: PeerDead, PEER_DEAD; taken)
+};
+struct gdakiHoldDeclineIn {
+  uint32_t state = GDAKI_HOLD_OFF;  // the peer's state
+  bool policyHold = false;          // this context's effective policy is hold (all ranks asked, the setup agreed)
+  bool commArmed = false;           // ncclGinRestoreResume enabled the restore and its conditions still hold
+  bool deathEvidence = false;       // the decline's uaWhy is GDAKI_UA_PEER_DEAD
+  bool strongCause = false;         // the death was judged on a FIN without BYE or on two refused connects (9.10.5)
+  bool lostAfterCommit = false;     // the peer's socket was lost after this rank's commit (weak: never held)
+  bool told = false;                // something already reached the application (9.10.5 TOLD)
+  bool otherHeld = false;           // another peer of this context is held (one held peer per communicator)
+  bool buddyReachable = false;      // the peer's buddy is this rank or has an installed helper socket
+  bool stopping = false;            // the helper is asked to stop (teardown) or is dead: no new hold
+};
+// *why: the reason of a PASS_NOHOLD (a static string). *fallbackOther: another peer is held and this decline concerns a
+// different peer: that hold falls back too (9.10.5: a second failure during a restore ends it; single failure scope).
+static int gdakiHoldDeclineAction(const struct gdakiHoldDeclineIn& in, const char** why, bool* fallbackOther) {
+  *why = "";
+  *fallbackOther = false;
+  if (gdakiHoldIsHeldState(in.state)) return GDAKI_HOLD_D_FALLBACK;
+  *fallbackOther = in.otherHeld;
+  if (in.state != GDAKI_HOLD_ARMED) return GDAKI_HOLD_D_PASS;
+  if (in.stopping) *why = "the helper is stopping (teardown)";
+  else if (!in.policyHold) *why = "the context's policy is not hold";
+  else if (!in.commArmed) *why = "the communicator is not armed";
+  else if (!in.deathEvidence) *why = "the decline is not a death";
+  else if (in.lostAfterCommit) *why = "the socket was lost after this rank's commit (weak evidence)";
+  else if (!in.strongCause) *why = "weak death evidence (not a FIN without BYE, not two refused connects)";
+  else if (in.told) *why = "a fault already reached the application";
+  else if (in.otherHeld) *why = "another peer is held";
+  else if (!in.buddyReachable) *why = "the peer's buddy has no helper socket";
+  else return GDAKI_HOLD_D_START;
+  return GDAKI_HOLD_D_PASS_NOHOLD;
+}
+// The death causes that are strong evidence (9.10.5, F9, V11): gdakiTsSocketLost's lostCause "FIN" (a FIN without BYE:
+// after a BYE it is "BYE") and "ECONNREFUSED" (the second refused connect 1000-5000 ms after the first; an established
+// socket's ECONNREFUSED is an unknown liveness, never a death).
+static bool gdakiHoldStrongCause(const char* lostCause) {
+  return lostCause != nullptr && (strcmp(lostCause, "FIN") == 0 || strcmp(lostCause, "ECONNREFUSED") == 0);
+}
+
+// A helper-socket record of the host branch (or the spare's RESTORED) about subject p, from another rank.
+enum {
+  GDAKI_HOLD_M_NONE = 0,         // nothing for this state (stale incarnation, or not about a hold this rank has)
+  GDAKI_HOLD_M_OFF = 1,          // ARMED -> OFF (DISARM, NOHOLD, a FALLBACK of an incarnation this rank did not hold)
+  GDAKI_HOLD_M_FALLBACK = 2,     // the held peer's fallback
+  GDAKI_HOLD_M_DECLINE = 3,      // this rank revived that incarnation (it took its RESTORED): decline it (P2)
+  GDAKI_HOLD_M_RESTORED = 4,     // PUBLISHED or TIMED_OUT_PUBLISHED -> ARMED or OFF of incarnation i + 1
+  GDAKI_HOLD_M_DISARM_LATER = 5, // a DISARM of a held peer: applied at its RESTORED (P5)
+  GDAKI_HOLD_M_HOLDING = 6,      // the buddy counts a holder
+};
+struct gdakiHoldMsgIn {
+  uint32_t type = 0;               // GDAKI_TS_DISARM, NOHOLD, HOLDING, FALLBACK, or the spare's RESTORED (restored = true)
+  bool restored = false;           // the record is the spare's RESTORED (impl/rs_spare_api.h type 37)
+  uint32_t state = GDAKI_HOLD_OFF;
+  uint32_t inc = 0;                // the incarnation the state concerns
+  uint32_t msgInc = 0;             // the record's: DISARM, NOHOLD, HOLDING, FALLBACK: round; RESTORED: pad (= i + 1)
+  bool revivedFromValid = false;   // this rank took a RESTORED for p (cell then ARMED or OFF of revivedFrom + 1)
+  uint32_t revivedFrom = 0;        // the incarnation whose death that restore covered
+};
+static int gdakiHoldMsgAction(const struct gdakiHoldMsgIn& in) {
+  const bool held = gdakiHoldIsHeldState(in.state);
+  if (in.restored) {
+    if ((in.state == GDAKI_HOLD_PUBLISHED || in.state == GDAKI_HOLD_TIMED_OUT_PUBLISHED) && in.msgInc == in.inc + 1u)
+      return GDAKI_HOLD_M_RESTORED;
+    return GDAKI_HOLD_M_NONE;
+  }
+  switch (in.type) {
+    case GDAKI_TS_DISARM:  // whatever incarnation the sender knows: conservative (until the peer's next stable checkpoint)
+      if (held) return GDAKI_HOLD_M_DISARM_LATER;
+      return in.state == GDAKI_HOLD_ARMED ? GDAKI_HOLD_M_OFF : GDAKI_HOLD_M_NONE;
+    case GDAKI_TS_NOHOLD:
+      if (in.msgInc != in.inc) return GDAKI_HOLD_M_NONE;
+      if (held) return GDAKI_HOLD_M_FALLBACK;
+      return in.state == GDAKI_HOLD_ARMED ? GDAKI_HOLD_M_OFF : GDAKI_HOLD_M_NONE;
+    case GDAKI_TS_HOLDING:
+      return GDAKI_HOLD_M_HOLDING;
+    case GDAKI_TS_FALLBACK: {
+      // P2: this rank revived that incarnation (took its RESTORED): the new one is declined; when this rank already
+      // holds the new one (it died again), that is the held peer's fallback
+      const bool revived = in.revivedFromValid && in.revivedFrom == in.msgInc && in.inc == in.msgInc + 1u;
+      if (held) return (in.msgInc == in.inc || revived) ? GDAKI_HOLD_M_FALLBACK : GDAKI_HOLD_M_NONE;
+      if ((in.state == GDAKI_HOLD_ARMED || in.state == GDAKI_HOLD_OFF) && revived) return GDAKI_HOLD_M_DECLINE;
+      if (in.state == GDAKI_HOLD_ARMED && in.msgInc == in.inc) return GDAKI_HOLD_M_OFF;  // Q1: not held here: OFF only
+      return GDAKI_HOLD_M_NONE;
+    }
+    default:
+      return GDAKI_HOLD_M_NONE;
+  }
+}
+
+// G8 (the Q4 watcher): the deadline of the held peer. COMMITTING is never touched (N1).
+enum { GDAKI_HOLD_W_NONE = 0, GDAKI_HOLD_W_TIMEOUT_HELD = 1, GDAKI_HOLD_W_TIMEOUT_PUBLISHED = 2 };
+static int gdakiHoldWatchdogAction(uint32_t state, int64_t deadlineUs, int64_t nowUs) {
+  if (deadlineUs == 0 || nowUs < deadlineUs) return GDAKI_HOLD_W_NONE;
+  if (state == GDAKI_HOLD_HELD) return GDAKI_HOLD_W_TIMEOUT_HELD;
+  if (state == GDAKI_HOLD_PUBLISHED) return GDAKI_HOLD_W_TIMEOUT_PUBLISHED;
+  return GDAKI_HOLD_W_NONE;
+}
+// The deadlines (9.2, 9.11.4 T4, 9.10.7 P1, Q2). HELD: the restore deadline from the hold start, and before the parked
+// device threads give up (their clock starts when the gate first went odd: gateOdd + holdMs), less the share of the
+// restore round after its compare-and-swap and a margin (the device bound). PUBLISHED: from the publish, with no hold term
+// (the gates are even), never shorter than a round and a handshake (RESTORED must be readable while the helper is in
+// another round).
+// The spare's driver serves the survivors one at a time, in rank order (impl/rs_spare_api.h): a survivor's turn (its
+// REJOIN accepted) may start late, after every earlier survivor's round, and RESTORED comes only after the last one's.
+// So (a) at its REJOIN a survivor's HELD deadline becomes at least its REJOIN + one turn (the turn's own bounds: the state
+// transfer and the TOKEN/READY exchange a handshake each, Prepare and Commit a firmware bound each), never past the device
+// bound (gdakiHoldTurnDeadlineUs); (b) a survivor's PUBLISHED deadline also covers every later survivor: each of them
+// held before the activation, which came before this survivor's REJOIN, so each one's gates went odd before it and its
+// publish comes before its gateOdd + holdMs; RESTORED follows the last one within a handshake (rejoin + holdMs +
+// handshake).
+static int64_t gdakiHoldDeviceBoundUs(int64_t gateOddUs, int64_t holdMs, int64_t shareMs, int64_t marginMs) {
+  return gateOddUs + (holdMs - shareMs - marginMs) * 1000;
+}
+static int64_t gdakiHoldHeldDeadlineUs(int64_t holdStartUs, int64_t gateOddUs, int64_t restoreMs, int64_t holdMs,
+                                       int64_t shareMs, int64_t marginMs) {
+  const int64_t a = holdStartUs + restoreMs * 1000;
+  const int64_t b = gdakiHoldDeviceBoundUs(gateOddUs, holdMs, shareMs, marginMs);
+  return a < b ? a : b;
+}
+static int64_t gdakiHoldTurnMs(int64_t handshakeMs, int64_t fwMs) { return 2 * handshakeMs + 2 * fwMs; }
+// (a): the HELD deadline at the REJOIN; never earlier than it was, never past the device bound.
+static int64_t gdakiHoldTurnDeadlineUs(int64_t heldDeadlineUs, int64_t deviceBoundUs, int64_t rejoinUs, int64_t turnMs) {
+  const int64_t t = rejoinUs + turnMs * 1000;
+  const int64_t want = t > heldDeadlineUs ? t : heldDeadlineUs;
+  return want < deviceBoundUs ? want : (heldDeadlineUs > deviceBoundUs ? heldDeadlineUs : deviceBoundUs);
+}
+// (b): rejoinUs 0: no REJOIN known (no later survivor's term).
+static int64_t gdakiHoldPublishedDeadlineUs(int64_t publishUs, int64_t restoreMs, int64_t roundMs, int64_t handshakeMs,
+                                            int64_t rejoinUs, int64_t holdMs) {
+  const int64_t m = restoreMs > roundMs + handshakeMs ? restoreMs : roundMs + handshakeMs;
+  const int64_t a = publishUs + m * 1000;
+  const int64_t b = rejoinUs > 0 ? rejoinUs + (holdMs + handshakeMs) * 1000 : 0;
+  return a > b ? a : b;
+}
+
+// G4: a fault record of a QP to the peer.
+enum { GDAKI_HOLD_R_ROUTE = 0, GDAKI_HOLD_R_ABSORB = 1, GDAKI_HOLD_R_STALE = 2, GDAKI_HOLD_R_FALLBACK = 3 };
+static int gdakiHoldRouteAction(uint32_t state, uint32_t recEpoch, uint32_t coveredEpoch) {
+  if (gdakiHoldIsQuietState(state)) return GDAKI_HOLD_R_ABSORB;  // the QPs are in ERR on purpose (the hold's 2ERR)
+  if (state == GDAKI_HOLD_PUBLISHED || state == GDAKI_HOLD_TIMED_OUT_PUBLISHED)  // Q3: older than the publish: stale
+    return recEpoch < coveredEpoch ? GDAKI_HOLD_R_STALE : GDAKI_HOLD_R_FALLBACK;  // P3: else the restore failed
+  return GDAKI_HOLD_R_ROUTE;
+}
+// RL20 (gdakiTsRespond's first statement, after the peer's parked records are applied): a REQ from the peer.
+enum { GDAKI_HOLD_Q_ANSWER = 0, GDAKI_HOLD_Q_NACK = 1, GDAKI_HOLD_Q_NACK_FALLBACK = 2 };
+static int gdakiHoldReqAction(uint32_t state) {
+  if (state == GDAKI_HOLD_PUBLISHED || state == GDAKI_HOLD_TIMED_OUT_PUBLISHED) return GDAKI_HOLD_Q_NACK_FALLBACK;
+  return gdakiHoldIsHeldState(state) ? GDAKI_HOLD_Q_NACK : GDAKI_HOLD_Q_ANSWER;
+}
+// The helper's step for the held peer (RL4).
+enum {
+  GDAKI_HOLD_S_NONE = 0,     // not held
+  GDAKI_HOLD_S_CANCEL = 1,   // abort, revoke or an aborting shrink: CANCELLED, no decline (every word is up already)
+  GDAKI_HOLD_S_FALLBACK = 2, // give it up now
+  GDAKI_HOLD_S_RESTORED_FIRST = 3,  // TIMED_OUT_PUBLISHED: read the spare's socket and the parked records for RESTORED
+                                    // first (Q2), then the fallback if none
+  GDAKI_HOLD_S_DRIVE = 4,    // go on with the restore
+};
+struct gdakiHoldStepIn {
+  uint32_t state = GDAKI_HOLD_OFF;
+  bool cancelled = false;        // every word of the communicator was raised by the application (allWhy)
+  bool told = false;             // the communicator's async error, word [0], the peer's word, or a degraded raise
+  bool pendingFallback = false;  // another event asked for the fallback (a second death, a lost arming condition)
+  bool commLost = false;         // this communicator lost an arming condition after Resume
+};
+// 9.10.5's order, the top wins: the application's choice (cancel), then what reached the application (TOLD) and the
+// other reasons to give up a restore in progress (a second failure, a lost arming condition), then the deadline (a
+// RESTORED read first still wins over a timed-out publish, Q2, but not over the reasons above). The helper asks this
+// before it hands the held peer's parked records over (a parked RESTORED does not outrun TOLD; gdakiHoldStep) and again
+// after.
+static int gdakiHoldStepAction(const struct gdakiHoldStepIn& in, const char** why) {
+  *why = "";
+  if (!gdakiHoldIsHeldState(in.state)) return GDAKI_HOLD_S_NONE;
+  if (in.cancelled) {
+    *why = "the application aborted, revoked or shrank the communicator";
+    return GDAKI_HOLD_S_CANCEL;
+  }
+  if (in.told) {
+    *why = "a fault reached the application meanwhile";
+    return GDAKI_HOLD_S_FALLBACK;
+  }
+  if (in.pendingFallback) {
+    *why = "asked by another event";
+    return GDAKI_HOLD_S_FALLBACK;
+  }
+  if (in.commLost) {
+    *why = "the communicator lost an arming condition";
+    return GDAKI_HOLD_S_FALLBACK;
+  }
+  if (in.state == GDAKI_HOLD_TIMED_OUT_HELD) {
+    *why = "the restore deadline passed (NCCL_GIN_RESTORE_MS, or the parked waits' bound)";
+    return GDAKI_HOLD_S_FALLBACK;
+  }
+  if (in.state == GDAKI_HOLD_TIMED_OUT_PUBLISHED) return GDAKI_HOLD_S_RESTORED_FIRST;
+  if (in.state == GDAKI_HOLD_COMMITTING) {  // the helper is the one in COMMITTING: its round returned without moving on
+    *why = "the restore round left the peer in COMMITTING";
+    return GDAKI_HOLD_S_FALLBACK;
+  }
+  return GDAKI_HOLD_S_DRIVE;
+}
+// Whether the step's action is taken before the held peer's parked records are handed over (gdakiHoldStep): a cancel
+// or a fallback (no parked record can change them: RESTORED applies to PUBLISHED and TIMED_OUT_PUBLISHED only, and the
+// reasons above outrank it).
+static bool gdakiHoldStepBeforeRecords(int action) {
+  return action == GDAKI_HOLD_S_CANCEL || action == GDAKI_HOLD_S_FALLBACK;
+}
+// gdakiHoldArm: ARMED(inc) or the reason not.
+static bool gdakiHoldArmOk(uint32_t state, uint32_t curInc, uint32_t inc, bool declined, bool commArmed,
+                           uint64_t disarmSeqNow, uint64_t disarmSeqAtPause, const char** why) {
+  *why = "";
+  if (gdakiHoldIsHeldState(state)) *why = "the peer is held";
+  else if (state == GDAKI_HOLD_FALLBACK || state == GDAKI_HOLD_CANCELLED) *why = "the peer's restore ended (final)";
+  else if (declined) *why = "this rank declined the peer";
+  else if (!commArmed) *why = "the communicator is not armed";
+  else if (disarmSeqNow != disarmSeqAtPause) *why = "a DISARM of the peer arrived after the checkpoint's input pause";
+  else if (inc < curInc) *why = "an older incarnation";
+  else return true;
+  return false;
+}
+// RESTORED (P5): ARMED of the new incarnation only when the communicator is still armed, no DISARM of the peer arrived
+// while it was held, and its new spare is registered at the buddy (work package 5); else OFF.
+static uint32_t gdakiHoldRestoredState(bool commArmed, bool disarmDuringHold, bool respareRegistered) {
+  return (commArmed && !disarmDuringHold && respareRegistered) ? GDAKI_HOLD_ARMED : GDAKI_HOLD_OFF;
+}
+
+// ---- the cell's moves: every compare-and-swap the host code makes (the unit test runs these same functions) ----
+// The end of a hold: any held state -> `to` (FALLBACK or CANCELLED), whatever the watcher moved meanwhile (HELD or
+// PUBLISHED to their timed-out states: still this move). True when it moved; *from and *inc: the state it left (or found,
+// when it did not move) and its incarnation.
+static bool gdakiHoldEndMove(struct gdakiHoldCell& c, uint32_t to, uint32_t* from, uint32_t* inc) {
+  uint64_t v = gdakiHoldLoad(c);
+  bool moved = false;
+  while (gdakiHoldIsHeldState(gdakiHoldStateOf(v)))
+    if (gdakiHoldCas(c, v, gdakiHoldPack(to, gdakiHoldIncOf(v)))) {
+      moved = true;
+      break;
+    }
+  *from = gdakiHoldStateOf(v);
+  *inc = gdakiHoldIncOf(v);
+  return moved;
+}
+// The restore round's compare-and-swap (N1), right after the released-waits check and before the commit point: a peer
+// that is not held is not a restore round (go on); a held one goes on only from HELD -> COMMITTING (false: the watcher's
+// deadline won, or the hold is not in HELD: nothing may be published).
+static bool gdakiHoldCommitMove(struct gdakiHoldCell& c) {
+  uint64_t v = gdakiHoldLoad(c);
+  const uint32_t s = gdakiHoldStateOf(v);
+  if (!gdakiHoldIsHeldState(s)) return true;
+  return s == GDAKI_HOLD_HELD && gdakiHoldCas(c, v, gdakiHoldPack(GDAKI_HOLD_COMMITTING, gdakiHoldIncOf(v)));
+}
+// After the restore round's last publish (P1): COMMITTING -> PUBLISHED, its deadline stored first (release; the watcher
+// loads the state, then the deadline). False: not COMMITTING (not a restore round), nothing written.
+static bool gdakiHoldPublishMove(struct gdakiHoldCell& c, int64_t deadlineUs) {
+  uint64_t v = gdakiHoldLoad(c);
+  if (gdakiHoldStateOf(v) != GDAKI_HOLD_COMMITTING) return false;
+  c.deadlineUs.store(deadlineUs, std::memory_order_release);
+  return gdakiHoldCas(c, v, gdakiHoldPack(GDAKI_HOLD_PUBLISHED, gdakiHoldIncOf(v)));  // only the helper moves COMMITTING
+}
+// The watcher (G8): the move its deadline makes, only when its compare-and-swap wins (W_TIMEOUT_HELD: the caller then
+// makes the CPU writes; W_TIMEOUT_PUBLISHED: the state alone; W_NONE: nothing, also when the helper moved first).
+static int gdakiHoldWatchMove(struct gdakiHoldCell& c, int64_t nowUs, uint32_t* inc) {
+  uint64_t v = gdakiHoldLoad(c);
+  const int a = gdakiHoldWatchdogAction(gdakiHoldStateOf(v), c.deadlineUs.load(std::memory_order_acquire), nowUs);
+  *inc = gdakiHoldIncOf(v);
+  if (a == GDAKI_HOLD_W_TIMEOUT_HELD)
+    return gdakiHoldCas(c, v, gdakiHoldPack(GDAKI_HOLD_TIMED_OUT_HELD, gdakiHoldIncOf(v))) ? a : GDAKI_HOLD_W_NONE;
+  if (a == GDAKI_HOLD_W_TIMEOUT_PUBLISHED)
+    return gdakiHoldCas(c, v, gdakiHoldPack(GDAKI_HOLD_TIMED_OUT_PUBLISHED, gdakiHoldIncOf(v))) ? a : GDAKI_HOLD_W_NONE;
+  return GDAKI_HOLD_W_NONE;
+}
+// The spare's RESTORED with pad = i + 1 (Q2): PUBLISHED or TIMED_OUT_PUBLISHED of incarnation i -> `next` (ARMED or OFF,
+// gdakiHoldRestoredState) of i + 1; when the watcher moves PUBLISHED meanwhile, decided again on what it holds. True when
+// it moved; *from and *inc as in gdakiHoldEndMove.
+static bool gdakiHoldRestoreMove(struct gdakiHoldCell& c, uint32_t pad, uint32_t next, uint32_t* from, uint32_t* inc) {
+  uint64_t v = gdakiHoldLoad(c);
+  for (;;) {
+    struct gdakiHoldMsgIn in;
+    in.restored = true;
+    in.state = gdakiHoldStateOf(v);
+    in.inc = gdakiHoldIncOf(v);
+    in.msgInc = pad;
+    *from = in.state;
+    *inc = in.inc;
+    if (gdakiHoldMsgAction(in) != GDAKI_HOLD_M_RESTORED) return false;
+    if (gdakiHoldCas(c, v, gdakiHoldPack(next, in.inc + 1u))) return true;
+  }
+}
+
+// The records of a peer's park the state machine handles itself, in arrival order (R1): DISARM, NOHOLD, HOLDING, a
+// FALLBACK about another rank, and the spare's RESTORED (its type: restoredType). A FALLBACK about this rank (a spare
+// process told by a survivor) and every other type stay parked for their owners.
+static bool gdakiHoldDrainTakes(uint32_t type, int arg, int me, uint32_t restoredType) {
+  return type == GDAKI_TS_DISARM || type == GDAKI_TS_NOHOLD || type == GDAKI_TS_HOLDING ||
+         (type == GDAKI_TS_FALLBACK && arg != me) || type == restoredType;
+}
+
+// A wait for one record that parks the restore's records (rs_hold_api.h's rule, M1): the first receive gets firstMs
+// unchanged (hk's bound); after a parked record the wait goes on to the same end (what is left, rounded up). recv(ms):
+// 1 a record, 0 none in time, < 0 the socket failed; park(): true if the record just read was parked. Without hold
+// state park() is always false: the first record decides, as hk.
+template <typename Recv, typename Park, typename Now>
+static int gdakiHoldRecvParked(int firstMs, Recv recv, Park park, Now nowMs) {
+  const double end = nowMs() + firstMs;
+  int got = recv(firstMs);
+  while (got == 1 && park()) {
+    const double left = end - nowMs();
+    got = recv(left > 0 ? (int)left + (left > (double)(int)left ? 1 : 0) : 0);
+  }
+  return got;
+}
+
+// The time the parked device threads of the peer started their clock (the HELD deadline's second term): the earliest of
+// the quiesce of the hold start, the oldest fault record of the peer still in the helper's hands (device waiters park at
+// their error CQE, before any gate goes odd), and, when the gates were already odd at the hold start, the time they went
+// odd (a quiesce of an earlier round: oddSinceMs) or the checkpoint pause's start. 0 for "none" in the optional inputs.
+// < 0: the gates were odd and nothing says since when (the caller falls back).
+static double gdakiHoldGateOddMs(double quiesceMs, bool wasOdd, double oldestRecordMs, double oddSinceMs, double pauseMs) {
+  double t = quiesceMs;
+  if (oldestRecordMs > 0 && oldestRecordMs < t) t = oldestRecordMs;
+  if (!wasOdd) return t;
+  if (oddSinceMs <= 0 && pauseMs <= 0) return -1.0;
+  if (oddSinceMs > 0 && oddSinceMs < t) t = oddSinceMs;
+  if (pauseMs > 0 && pauseMs < t) t = pauseMs;
+  return t;
+}
+
+// The records parked for one peer (the rule of rs_hold_api.h), in arrival order. M: the record type (gdakiTsMsg in the
+// host file), with a `type` field.
+template <typename M>
+struct gdakiHoldPark {
+  struct Item {
+    M m;
+    double atMs;
+  };
+  std::vector<struct Item> q;
+  uint64_t dropped = 0;
+  // false: the park was full and its oldest record was dropped to make room (*droppedType: its type)
+  bool push(const M& m, double nowMs, uint32_t* droppedType) {
+    bool ok = true;
+    if (q.size() >= (size_t)GDAKI_HOLD_PARK_MAX) {
+      *droppedType = q.front().m.type;
+      q.erase(q.begin());
+      dropped++;
+      ok = false;
+    }
+    q.push_back({m, nowMs});
+    return ok;
+  }
+  // the oldest record for which pick(m) is true
+  template <typename P>
+  bool takeIf(P pick, M* out) {
+    for (size_t i = 0; i < q.size(); i++)
+      if (pick(q[i].m)) {
+        *out = q[i].m;
+        q.erase(q.begin() + (long)i);
+        return true;
+      }
+    return false;
+  }
+  bool take(uint32_t type, M* out) {
+    return takeIf([&](const M& m) { return m.type == type; }, out);
+  }
+  // drop records older than ageMs; returns how many (*oneType: the type of one of them)
+  int expire(double nowMs, double ageMs, uint32_t* oneType) {
+    int n = 0;
+    for (size_t i = 0; i < q.size();)
+      if (nowMs - q[i].atMs > ageMs) {
+        *oneType = q[i].m.type;
+        q.erase(q.begin() + (long)i);
+        n++;
+        dropped++;
+      } else {
+        i++;
+      }
+    return n;
+  }
+};
+
+// The buddy's count of the survivors that hold subject p (9.10.5 "모두 함께": activation only once every survivor holds
+// it). A HOLDING of a newer incarnation starts the count again; an older one is stale.
+struct gdakiHoldHolders {
+  bool any = false;
+  uint32_t inc = 0;
+  std::vector<uint8_t> by;  // by rank
+  bool activated = false;   // the spare was activated for inc
+};
+static bool gdakiHoldHoldersAdd(struct gdakiHoldHolders& h, int nranks, int holder, uint32_t inc) {
+  if (holder < 0 || holder >= nranks) return false;
+  if (h.any && inc < h.inc) return false;
+  if (!h.any || inc > h.inc) {
+    h.any = true;
+    h.inc = inc;
+    h.by.assign((size_t)nranks, 0);
+    h.activated = false;
+  }
+  h.by[(size_t)holder] = 1;
+  return true;
+}
+static bool gdakiHoldHoldersComplete(const struct gdakiHoldHolders& h, int nranks, int subject) {
+  if (!h.any || (int)h.by.size() != nranks) return false;
+  for (int s = 0; s < nranks; s++)
+    if (s != subject && !h.by[(size_t)s]) return false;
+  return true;
+}
+// ---- gin-restore hold: pure functions (end) ----
+
+// The hold state of one GDAKI context (= one communicator: the restore needs exactly one transparent-recovery context per
+// communicator, 9.10.4). Only a process that asks for the restore has one (gdakiTsStart, before the helper and the
+// watcher look at it; freed in gdakiRecFree after both stopped). The cells are atomics (see rs_hold_api.h); everything in
+// gdakiHoldPeer is the helper thread's alone.
+struct gdakiRsRkeys;  // impl/rs_spare_api.h (the spare's rkey list, taken by work package 5's state transfer)
+enum {
+  GDAKI_HOLD_P_REJOIN = 0,     // HELD: waiting for the spare's REJOIN (gdakiRsRejoinAccept)
+  GDAKI_HOLD_P_TRANSFER = 1,   // HELD: the state transfer to the spare (work package 5: the log export, its rkey list)
+  GDAKI_HOLD_P_PREPARE = 2,    // HELD: Prepare and the token to the spare
+  GDAKI_HOLD_P_READY = 3,      // HELD: waiting for the spare's READY; then the commit round (Commit .. publish, DONE_RS)
+  GDAKI_HOLD_P_PUBLISHED = 4,  // PUBLISHED: waiting for the spare's RESTORED
+};
+struct gdakiHoldPeer {
+  struct gdakiHoldPark<struct gdakiTsMsg> park;  // restore records from this peer (rs_hold_api.h's rule)
+  // the hold of this peer (valid while it is held)
+  double holdStartMs = 0, gateOddMs = 0, rejoinMs = 0, publishMs = 0, pauseStartMs = 0;
+  // when a quiesce made the gates of the peer odd (gdakiHoldGateOdd from gdakiTsQuiesce; 0 once a publish made them even)
+  double oddSinceMs = 0;
+  int64_t deviceBoundUs = 0;  // the hold's device bound (gdakiHoldDeviceBoundUs), for the turn's deadline at the REJOIN
+  uint64_t quiesceSeq = 0;    // quiesces of the peer's gates so far (gdakiHoldGateOdd): a round since a pause moves it
+  int phase = GDAKI_HOLD_P_REJOIN;
+  bool pendingFallback = false;  // another event asked for this hold's fallback (the helper step makes it)
+  char pendingWhy[160] = {0};
+  bool disarmDuringHold = false; // a DISARM of the peer arrived while it was held (P5: applied at RESTORED)
+  // the counts read at the hold start, the QPs quiesced (work package 9's state transfer; dev's rs_log_api.h)
+  bool countsRead = false;
+  int nqp = 0;
+  uint64_t xAtHold[NCCL_GIN_RECOVERY_MAX_QPS] = {};  // X: cumulative executed count of the peer's messages, after the 2ERR
+  uint64_t mAtHold[NCCL_GIN_RECOVERY_MAX_QPS] = {};  // M: messages this rank posted to the peer
+  uint64_t headAtHold = 0;                           // the send-side log ring's head
+  ncclGinRecoverToken_t tok;                         // this rank's Prepare token of the restore round
+  struct gdakiRsRkeys* rkeys = nullptr;              // the spare's rkeys (work package 5), owned here
+  // work package 5's state transfer across helper steps: the data socket to the spare and its answer so far (the helper
+  // does not block on the answer: the spare may first fetch its image from this rank, the buddy, whose accept step must
+  // run meanwhile)
+  int xferFd = -1;
+  size_t xferHave = 0;
+  struct gdakiTsMsg xferAns;
+  // after a restore this rank took part in (P2: a FALLBACK of the incarnation it revived declines the new one)
+  bool revivedFromValid = false;
+  uint32_t revivedFrom = 0;
+  uint64_t disarmSeq = 0;        // DISARMs of this peer received or made (gdakiHoldArm)
+  // as the peer's buddy (gdakiHoldBuddyOf): who holds it, and the activation of its spare
+  struct gdakiHoldHolders holders;
+  double nextActivateMs = 0, firstActivateFailMs = 0;
+  int activateFails = 0;
+};
+// The end of a hold (or the free): a state transfer in progress is closed.
+static inline void gdakiHoldXferClose(struct gdakiHoldPeer& hp) {
+  if (hp.xferFd >= 0) close(hp.xferFd);
+  hp.xferFd = -1;
+  hp.xferHave = 0;
+}
+struct gdakiHold {
+  int rank = -1, nranks = 0;
+  struct gdakiHoldCell* cells = nullptr;  // by peer (new[nranks])
+  std::vector<struct gdakiHoldPeer> peers;
+  std::atomic<int> commArmed{0};   // ncclGinRestoreResume enabled the restore on this communicator (application thread)
+  std::atomic<int> heldPeer{-1};   // the one held peer (helper writes; the watcher reads)
+  std::atomic<void*> resWin{nullptr};  // the devComm's resource window (Resume added it to the NIC copy path)
+  bool commLost = false;           // an arming condition was lost after Resume (helper; final)
+  char commLostWhy[160] = {0};
+  uint64_t winGoneSeen = 0;        // gdakiRsWinGoneCount at the last check (a change DISARMs every peer, not final)
+  double nextLogPollMs = 0;        // work package 5: the send-side log's poll (gdakiRsLogPoll)
+  double nextCommCheckMs = 0, nextExpireMs = 0;
+  bool lineDone = false;
+  bool selfEnded = false;          // integration: this restored process ended its part (gdakiHoldSelfEnd)
+  bool getCheckDone = false;       // integration: the restored process's budgets are used up and no get was refused
+  struct gdakiCkpt* ckpt = nullptr;  // work package 5: the checkpoint state (gdakiCkptCreate, with the hold state)
+  std::atomic<int> nHolds{0}, nFallbacks{0}, nRestored{0}, nTimeouts{0}, nNoHold{0}, nNack{0}, nAbsorbed{0},
+    nParked{0}, nCancelled{0}, nDisarmSent{0};
+  ~gdakiHold() { delete[] cells; }
+};
+static inline struct gdakiHold* gdakiHoldOf(struct gdakiRecHost* r) { return r != nullptr ? r->hold : nullptr; }
+// Defined in the region "hold machine" (they need hk's helper functions, defined later in this file).
+static bool gdakiHoldOnDecline(struct gdakiRecHost* r, int peer, const char* why, gdakiCause cause, int uaWhy);
+static bool gdakiHoldRoute(struct gdakiRecHost* r, const struct gdakiTsFault& f);
+static void gdakiHoldWatchdog(struct gdakiRecHost* r);
+static bool gdakiHoldOnReq(struct gdakiRecHost* r, int peer, const struct gdakiTsMsg& req);
+static bool gdakiHoldBeforeCommitPoint(struct gdakiRecHost* r, int peer, const char** why);
+static void gdakiHoldAfterPublish(struct gdakiRecHost* r, int peer);
+static void gdakiHoldStep(struct gdakiRecHost* r);
+static void gdakiHoldGateOdd(struct gdakiRecHost* r, int peer);
+// ==== gin-restore (rs, work package 7): hold state (end) ====
+
+// ==== gin-restore (rs, work package 5): checkpoint state (begin) ====
+// The checkpoint's state (EXPERIMENT.md 9.4): first the text of impl/rs_ckpt_api.h between its "shared text" fences,
+// verbatim, then the decisions and the bookkeeping as pure functions (unit-tested on the CPU), then the per-context
+// checkpoint state. The moves are in the region "checkpoint machine".
+// ---- shared text (begin) ----
+#include <stddef.h>
+#include <stdint.h>
+
+// helper-socket record types of the host branch (rs_hold_api.h has 11..19): the data socket's first record
+#define GDAKI_TS_DATA 20u
+enum : uint32_t { GDAKI_CKPT_UPLOAD = 1, GDAKI_CKPT_FETCH = 2, GDAKI_CKPT_STATE = 3 };  // GDAKI_TS_DATA's pad
+
+// The checkpoint records' fields (helper socket; from, nonce as every record):
+//   CKPT_PAUSE   r -> q: arg = r, round = the checkpoint
+//   PAUSED       q -> r: arg = r, round = the checkpoint, pad = GDAKI_CKPT_PAUSED_*, nqp = q's QPs to r (GIN-context
+//                order); per QP i: tok.epochWqes[i] = M (request messages q posted to r), executed[i] and nrp[i] = the low
+//                and high 32 bits of P (q's cumulative executed count of r's messages)
+//   BUSY         q -> r: arg = r, round = the checkpoint, pad = GDAKI_CKPT_BUSY_* (r skips this checkpoint)
+//   CKPT_RESUME  r -> q: arg = r, round = the checkpoint, pad = 1 when r gave the checkpoint up (q unpauses either way and
+//                does not confirm)
+//   PAUSED again q -> r, the confirmation after CKPT_RESUME: pad = GDAKI_CKPT_PAUSED_HELD, nqp = 0; or BUSY (VOIDED)
+//   CKPT_STABLE  r -> every rank: arg = r, round = the checkpoint, pad = GDAKI_CKPT_STABLE_ARMABLE when every PAUSED was
+//                armable and the buddy holds r's spare registration
+#define GDAKI_CKPT_PAUSED_ARMABLE 0x1u   // q can take part in restoring r (its arming conditions, its log toward r complete)
+#define GDAKI_CKPT_PAUSED_FIRST 0x2u     // this pause started q's log toward r
+#define GDAKI_CKPT_PAUSED_HELD 0x4u      // the confirmation: q's pause held until CKPT_RESUME; its empty round is published
+enum : uint32_t {
+  GDAKI_CKPT_BUSY_HOLD = 1,      // q holds a peer (a restore runs)
+  GDAKI_CKPT_BUSY_SUPPRESS = 2,  // q is a restored rank still holding back replayed messages (P4)
+  GDAKI_CKPT_BUSY_DECLINED = 3,  // q declined r, or a fault already reached the application on q
+  GDAKI_CKPT_BUSY_PAUSE = 4,     // q's pause failed (quiesce, the log's or the executed count's read)
+  GDAKI_CKPT_BUSY_OFF = 5,       // q has no hold state (it does not ask for the restore)
+  GDAKI_CKPT_BUSY_VOIDED = 6,    // q's pause did not hold until CKPT_RESUME (a round or a decline with r, or its bound
+                                 // NCCL_GIN_RESTORE_PAUSE_MS ended it): the checkpoint is discarded
+  GDAKI_CKPT_BUSY_ROUND = 7,     // q has a round with r pending (gates odd from an earlier quiesce, or a queued fault)
+};
+#define GDAKI_CKPT_STABLE_ARMABLE 0x1u
+
+// The data socket's image stream (UPLOAD, FETCH). The image is the concatenation of the regions in this order, each
+// starting at a 256-byte boundary of the image; blocks are GDAKI_CKPT_BLOCK bytes of the image (the last one shorter).
+#define GDAKI_CKPT_MAGIC 0x43535247u  // "GRSC"
+#define GDAKI_CKPT_VERSION 1u
+#define GDAKI_CKPT_BLOCK (64u * 1024u)
+#define GDAKI_CKPT_MAX_REGIONS 64
+#define GDAKI_CKPT_MAX_PEERS 64
+#define GDAKI_CKPT_MAX_BLOB (1u << 20)
+#define GDAKI_CKPT_QPS 64             // NCCL_GIN_RECOVERY_MAX_QPS
+enum : uint32_t {
+  GDAKI_CKPT_REGION_WINDOW = 1,     // a window registered on the context's collComm: id = its number (rsWinId)
+  GDAKI_CKPT_REGION_REGISTERED = 2, // an ncclGinRestoreRegister buffer: id = its registration order on the communicator
+  GDAKI_CKPT_REGION_SIGNALS = 3,    // the context's signal table (this rank's part): id 0
+  GDAKI_CKPT_REGION_COUNTERS = 4,   // the context's counter table: id 0
+};
+struct gdakiCkptRegion {
+  uint32_t kind, id;
+  uint64_t offset;  // in the image (256-byte aligned)
+  uint64_t bytes;
+};
+struct gdakiCkptPeerP {  // what PAUSED told r: per QP of q to r, P (q's executed count of r's messages at the cut)
+  int32_t rank;
+  uint32_t nqp;
+  uint64_t p[GDAKI_CKPT_QPS];
+};
+struct gdakiCkptHdr {
+  uint32_t magic, version;          // GDAKI_CKPT_MAGIC, GDAKI_CKPT_VERSION
+  int32_t rank;                     // r
+  uint32_t incarnation;             // r's incarnation
+  uint64_t nonce;                   // the GIN context's nonce
+  uint64_t ckpt;                    // the checkpoint (= the step it was taken at)
+  uint64_t baseCkpt;                // UPLOAD: the stable checkpoint the changed blocks apply to (~0: none, every block)
+  uint64_t imageBytes;
+  uint32_t blockBytes;              // GDAKI_CKPT_BLOCK
+  uint32_t nRegions;
+  uint64_t nChanged;                // blocks that follow
+  uint32_t blobBytes;               // the application's blob (after the blocks, before the end record)
+  uint32_t nPeers;                  // entries of peerP used
+  uint8_t spareAddr[32];            // r's spare (NCCL_GIN_RESTORE_SPARE_ADDR), a union ncclSocketAddress (zero: none)
+  int64_t pid;                      // r's process (the spare's PID check)
+  uint64_t pidStart;                // its start time, /proc/<pid>/stat field 22
+  struct gdakiCkptRegion region[GDAKI_CKPT_MAX_REGIONS];
+  struct gdakiCkptPeerP peerP[GDAKI_CKPT_MAX_PEERS];
+};
+struct gdakiCkptEnd {
+  uint32_t magic, ok;               // GDAKI_CKPT_MAGIC; 1
+  uint64_t imageHash;               // FETCH: a hash of the whole image (gdakiCkptHash over imageBytes)
+};
+struct gdakiCkptAck {
+  uint32_t magic, ok;               // GDAKI_CKPT_MAGIC; 1: stored (UPLOAD) / 0: refused (FETCH: no such checkpoint)
+  uint64_t ckpt;
+  char why[112];
+};
+// The block hash (64 bits, FNV-1a over 8-byte words, then a finalizer); the uploader sends the blocks whose hash
+// differs from the last stable image's, and the FETCH end record carries the hash of the whole image.
+static inline uint64_t gdakiCkptHash(const void* p, size_t n, uint64_t h) {
+  const unsigned char* b = (const unsigned char*)p;
+  size_t i = 0;
+  for (; i + 8 <= n; i += 8) {
+    uint64_t w = 0;
+    for (int k = 0; k < 8; k++) w |= (uint64_t)b[i + k] << (8 * k);
+    h = (h ^ w) * 0x100000001b3ULL;
+  }
+  for (; i < n; i++) h = (h ^ b[i]) * 0x100000001b3ULL;
+  h ^= h >> 33;
+  h *= 0xff51afd7ed558ccdULL;
+  h ^= h >> 33;
+  return h;
+}
+#define GDAKI_CKPT_HASH_SEED 0xcbf29ce484222325ULL
+#define GDAKI_CKPT_STATE_MAX (1ULL << 30)  // a STATE's export, bytes at most
+// ---- shared text (end) ----
+
+// ---- gin-restore ckpt: pure functions (begin; impl/rs_unit_host.cc compiles this region on the CPU) ----
+// The checkpoint's decisions and bookkeeping (EXPERIMENT.md 9.4, 9.11.9 C1, M3), as functions of plain values.
+
+// The checkpoint's helper-socket records (CKPT_PAUSE .. CKPT_STABLE): the hold machine's drain hands them over in arrival
+// order per peer (with its own types, R1).
+static bool gdakiCkptIsRecord(uint32_t type) { return type >= GDAKI_TS_CKPT_PAUSE && type <= GDAKI_TS_CKPT_STABLE; }
+
+// Step(step) takes a checkpoint at the first call and then once `interval` steps passed since the last one taken (the
+// caller adds the back-off after a skipped one: a quarter interval).
+static bool gdakiCkptDue(uint64_t step, bool haveLast, uint64_t lastStep, uint64_t interval) {
+  if (!haveLast) return true;
+  if (interval == 0) interval = 1;
+  return step >= lastStep && step - lastStep >= interval;
+}
+// The drain check of the checkpointing rank r (9.4 step 3, 9.6): per QP of peer q's to r, r's cumulative executed count
+// of q's messages (x) against what q posted (m, its PAUSED). Every x == m: drained. Some x < m: wait. Some x > m: the
+// counts do not match (a baseline went wrong, or q posted after its pause): the checkpoint is void.
+enum { GDAKI_CKPT_DRAINED = 0, GDAKI_CKPT_DRAIN_WAIT = 1, GDAKI_CKPT_DRAIN_VOID = 2 };
+static int gdakiCkptDrainVerdict(const uint64_t* x, const uint64_t* m, int n) {
+  bool wait = false;
+  for (int i = 0; i < n; i++) {
+    if (x[i] > m[i]) return GDAKI_CKPT_DRAIN_VOID;
+    if (x[i] < m[i]) wait = true;
+  }
+  return wait ? GDAKI_CKPT_DRAIN_WAIT : GDAKI_CKPT_DRAINED;
+}
+// The image's layout: region i at off[i] (256-byte aligned), the total size; false when too large (1 TiB).
+static bool gdakiCkptLayout(const uint64_t* bytes, int n, uint64_t* off, uint64_t* total) {
+  uint64_t o = 0;
+  for (int i = 0; i < n; i++) {
+    o = (o + 255) & ~(uint64_t)255;
+    off[i] = o;
+    if (bytes[i] > (1ULL << 40) || o + bytes[i] > (1ULL << 40)) return false;
+    o += bytes[i];
+  }
+  *total = o;
+  return true;
+}
+static uint64_t gdakiCkptNBlocks(uint64_t imageBytes) {
+  return (imageBytes + GDAKI_CKPT_BLOCK - 1) / GDAKI_CKPT_BLOCK;
+}
+static uint64_t gdakiCkptBlockLen(uint64_t i, uint64_t imageBytes) {
+  const uint64_t o = i * GDAKI_CKPT_BLOCK;
+  if (o >= imageBytes) return 0;
+  return imageBytes - o < GDAKI_CKPT_BLOCK ? imageBytes - o : GDAKI_CKPT_BLOCK;
+}
+// The blocks to upload: those whose hash differs from the base's (every block without a base or with another size).
+static std::vector<uint64_t> gdakiCkptChanged(const std::vector<uint64_t>& base, bool haveBase,
+                                              const std::vector<uint64_t>& cur) {
+  std::vector<uint64_t> v;
+  const bool full = !haveBase || base.size() != cur.size();
+  for (uint64_t i = 0; i < (uint64_t)cur.size(); i++)
+    if (full || base[(size_t)i] != cur[(size_t)i]) v.push_back(i);
+  return v;
+}
+// PAUSED carries P (64 bits) per QP in two 32-bit fields
+static void gdakiCkptPackP(uint64_t p, uint32_t* lo, uint32_t* hi) {
+  *lo = (uint32_t)p;
+  *hi = (uint32_t)(p >> 32);
+}
+static uint64_t gdakiCkptUnpackP(uint32_t lo, uint32_t hi) { return ((uint64_t)hi << 32) | lo; }
+
+// q's answer to CKPT_PAUSE from r (9.11.9 C1, P4, V18): 0 = pause; else a GDAKI_CKPT_BUSY_* reason.
+// roundPending: a round with r is pending (its gates are odd from an earlier quiesce not published yet, or a fault record
+// of a QP to r waits in the helper's queue): 9.4 step 2, "q가 라운드 중이면 BUSY".
+static uint32_t gdakiCkptBusyReason(bool hasHoldState, bool holdActive, bool suppressLeft, bool declined, bool told,
+                                    bool roundPending) {
+  if (!hasHoldState) return GDAKI_CKPT_BUSY_OFF;
+  if (declined || told) return GDAKI_CKPT_BUSY_DECLINED;
+  if (holdActive) return GDAKI_CKPT_BUSY_HOLD;
+  if (roundPending) return GDAKI_CKPT_BUSY_ROUND;
+  if (suppressLeft) return GDAKI_CKPT_BUSY_SUPPRESS;
+  return 0;
+}
+// q's answer to CKPT_RESUME (9.11.9 C1): publish the empty round and confirm (the pause held), or VOIDED (a round or a
+// decline with r since the pause, or the pause's bound ended it early), or nothing (no pause of that checkpoint, or r gave
+// it up: unpause without a confirmation).
+enum { GDAKI_CKPT_R_IGNORE = 0, GDAKI_CKPT_R_HELD = 1, GDAKI_CKPT_R_VOIDED = 2, GDAKI_CKPT_R_UNPAUSE = 3 };
+static int gdakiCkptResumeVerdict(bool paused, uint64_t pausedCkpt, uint64_t ckpt, bool rGaveUp, bool declined,
+                                  bool epochUnchanged, bool gateStillOdd) {
+  if (!paused || pausedCkpt != ckpt) return GDAKI_CKPT_R_IGNORE;
+  if (rGaveUp) return (declined || !epochUnchanged || !gateStillOdd) ? GDAKI_CKPT_R_IGNORE : GDAKI_CKPT_R_UNPAUSE;
+  if (declined || !epochUnchanged || !gateStillOdd) return GDAKI_CKPT_R_VOIDED;
+  return GDAKI_CKPT_R_HELD;
+}
+// The gates of a peer against its input pause (9.11.9 C1; gdakiCkptPauseState reads the facts): ENDED when something
+// else ended the pause (a decline, a round since: every round quiesces the peer first; a changed epoch; or no gate was
+// ever made odd), INTACT when every gate still shows the pause's odd epoch, BROKEN when a gate could not be read or only
+// some gates show it (nothing else will publish them: the caller declines).
+enum { GDAKI_CKPT_P_INTACT = 0, GDAKI_CKPT_P_ENDED = 1, GDAKI_CKPT_P_BROKEN = 2 };
+static int gdakiCkptPauseVerdict(bool declined, bool roundSince, bool epochSame, bool readFail, bool allOdd, bool anyOdd) {
+  if (declined || roundSince || !epochSame) return GDAKI_CKPT_P_ENDED;
+  if (readFail) return GDAKI_CKPT_P_BROKEN;
+  if (allOdd) return GDAKI_CKPT_P_INTACT;
+  return anyOdd ? GDAKI_CKPT_P_BROKEN : GDAKI_CKPT_P_ENDED;
+}
+
+// G6 (M3): the covered epoch of a QP. An empty round (the end of a checkpoint's input pause) publishes epoch + 2 without
+// covering a fault: the covered epoch stays where it was. Every other publish (a real round, a decline) changes the epoch to
+// a value no empty round made, so it is covered again. emptyTop: the epoch the last empty round published; emptyBase: the
+// covered epoch then.
+static uint32_t gdakiCkptCovered(uint32_t epoch, bool emptyValid, uint32_t emptyTop, uint32_t emptyBase) {
+  return (emptyValid && epoch == emptyTop) ? emptyBase : epoch;
+}
+// After an empty round from `before` (even): the new bookkeeping (a run of empty rounds keeps the first base).
+static void gdakiCkptAfterEmpty(uint32_t before, bool* emptyValid, uint32_t* emptyTop, uint32_t* emptyBase) {
+  const uint32_t base = gdakiCkptCovered(before, *emptyValid, *emptyTop, *emptyBase);
+  *emptyValid = true;
+  *emptyTop = before + 2u;
+  *emptyBase = base;
+}
+
+// The checkpointing rank's view of one checkpoint's replies (helper thread): every peer answers PAUSED or BUSY once,
+// then (after CKPT_RESUME) confirms (HELD) or voids.
+struct gdakiCkptReplies {
+  int n = 0;  // ranks (this rank's slot stays "replied")
+  std::vector<uint8_t> state;  // 0 waiting, 1 paused, 2 busy, 3 confirmed held, 4 voided
+  std::vector<uint8_t> armable;
+  std::vector<uint8_t> sent;   // CKPT_PAUSE went to it (a give-up releases every such peer that did not answer BUSY)
+  void reset(int nranks, int self) {
+    n = nranks;
+    state.assign((size_t)nranks, 0);
+    armable.assign((size_t)nranks, 0);
+    sent.assign((size_t)nranks, 0);
+    if (self >= 0 && self < nranks) state[(size_t)self] = 3, armable[(size_t)self] = 1;
+  }
+  bool allPausedOrBusy() const {
+    for (int q = 0; q < n; q++)
+      if (state[(size_t)q] == 0) return false;
+    return true;
+  }
+  bool anyBusy() const {
+    for (int q = 0; q < n; q++)
+      if (state[(size_t)q] == 2 || state[(size_t)q] == 4) return true;
+    return false;
+  }
+  bool allConfirmed() const {
+    for (int q = 0; q < n; q++)
+      if (state[(size_t)q] != 3) return false;
+    return true;
+  }
+  bool allArmable() const {
+    for (int q = 0; q < n; q++)
+      if (!armable[(size_t)q]) return false;
+    return true;
+  }
+  // a give-up sends CKPT_RESUME(given up) to q: it was sent CKPT_PAUSE and did not answer BUSY (it is paused, or its
+  // PAUSED is on the way)
+  bool releaseOnAbort(int q) const {
+    return q >= 0 && q < n && sent[(size_t)q] && (state[(size_t)q] == 0 || state[(size_t)q] == 1);
+  }
+};
+// The application's stable step (9.4, 9.7 12): Step(t) records (t, the log head read then); step t is stable once every
+// entry below that head is covered (dev's gdakiRsStableStepOf). The list keeps the records not yet stable and the last
+// stable step; at most `cap` records (the oldest go: a later step then reports stable instead, never an earlier one wrongly).
+struct gdakiCkptStepLog {
+  std::vector<uint64_t> steps, heads;
+  bool haveStable = false;
+  uint64_t stable = 0;
+  void add(uint64_t step, uint64_t head, size_t cap) {
+    steps.push_back(step);
+    heads.push_back(head);
+    if (steps.size() > cap) {
+      steps.erase(steps.begin());
+      heads.erase(heads.begin());
+    }
+  }
+  // drop the records up to and including the stable one `s` (when s is one of them), remember s
+  void settle(uint64_t s, uint64_t none) {
+    if (s == none) return;
+    haveStable = true;
+    stable = s;
+    size_t k = 0;
+    while (k < steps.size() && steps[k] <= s) k++;
+    steps.erase(steps.begin(), steps.begin() + (long)k);
+    heads.erase(heads.begin(), heads.begin() + (long)k);
+  }
+};
+
+// The buddy's images of one subject (9.4 "어디에"): the last stable one and the one being received. An upload applies its
+// changed blocks onto a copy of the stable image it names as its base (no base: every block comes); the image becomes
+// stable only with the subject's CKPT_STABLE (the restore then uses the newest stable image). Bytes only: no sockets.
+struct gdakiCkptImage {
+  bool complete = false;
+  uint64_t ckpt = 0;
+  struct gdakiCkptHdr hdr;          // as uploaded (nChanged = the upload's)
+  std::vector<uint8_t> data;        // imageBytes
+  std::vector<uint8_t> blob;
+};
+struct gdakiCkptStore {
+  bool haveStable = false;
+  struct gdakiCkptImage stable;
+  bool havePending = false;
+  struct gdakiCkptImage pending;
+  // an upload's header: false (why) when its base is not the stable image or the sizes do not hold together
+  bool begin(const struct gdakiCkptHdr& h, const char** why) {
+    *why = "";
+    if (h.magic != GDAKI_CKPT_MAGIC || h.version != GDAKI_CKPT_VERSION || h.blockBytes != GDAKI_CKPT_BLOCK ||
+        h.nRegions > GDAKI_CKPT_MAX_REGIONS || h.nPeers > GDAKI_CKPT_MAX_PEERS || h.blobBytes > GDAKI_CKPT_MAX_BLOB ||
+        h.imageBytes > (1ULL << 40) || h.nChanged > gdakiCkptNBlocks(h.imageBytes)) {
+      *why = "a malformed checkpoint header";
+      return false;
+    }
+    const bool full = h.baseCkpt == ~0ULL;
+    if (!full && (!haveStable || stable.ckpt != h.baseCkpt || stable.data.size() != h.imageBytes)) {
+      *why = "the upload's base is not the stable image here";
+      return false;
+    }
+    if (full && h.nChanged != gdakiCkptNBlocks(h.imageBytes)) {
+      *why = "an upload without a base must carry every block";
+      return false;
+    }
+    havePending = true;
+    pending.complete = false;
+    pending.ckpt = h.ckpt;
+    pending.hdr = h;
+    try {  // a header's size is the sender's word: no memory for it refuses the upload, it never ends the process
+      if (full) pending.data.assign((size_t)h.imageBytes, 0);
+      else pending.data = stable.data;
+    } catch (const std::bad_alloc&) {
+      havePending = false;
+      pending.data.clear();
+      *why = "no host memory for the image";
+      return false;
+    }
+    pending.blob.clear();
+    return true;
+  }
+  bool block(uint64_t idx, const uint8_t* p, uint64_t len) {
+    if (!havePending || len != gdakiCkptBlockLen(idx, pending.data.size()) || len == 0) return false;
+    memcpy(pending.data.data() + idx * GDAKI_CKPT_BLOCK, p, (size_t)len);
+    return true;
+  }
+  void finish(const uint8_t* blob, uint32_t blobBytes) {
+    pending.blob.assign(blob, blob + blobBytes);
+    pending.complete = true;
+  }
+  // the subject's CKPT_STABLE: the pending image of that checkpoint becomes the stable one
+  bool markStable(uint64_t ckpt) {
+    if (!havePending || !pending.complete || pending.ckpt != ckpt) return false;
+    stable = std::move(pending);
+    haveStable = true;
+    havePending = false;
+    pending = gdakiCkptImage();
+    return true;
+  }
+};
+
+// A peer's cuts toward one subject r (q's side): the cuts of every checkpoint it confirmed since its last stable one,
+// newest last (a restore may name a confirmed checkpoint whose CKPT_STABLE did not reach q). R: what a cut keeps (the
+// host code: the dev branch's pause record with the arming facts of that pause).
+template <typename R>
+struct gdakiCkptCut {
+  uint64_t ckpt = 0;
+  R rec;
+  bool stable = false;
+};
+template <typename R>
+struct gdakiCkptCuts {
+  std::vector<struct gdakiCkptCut<R>> v;  // confirmed cuts, oldest first; v.front() is the last stable when any is
+  // a confirmed cut of checkpoint ckpt (the pause held until CKPT_RESUME)
+  void confirmed(uint64_t ckpt, const R& rec) {
+    struct gdakiCkptCut<R> c;
+    c.ckpt = ckpt;
+    c.rec = rec;
+    v.push_back(c);
+    if (v.size() > 8) v.erase(v.begin() + (v.front().stable ? 1 : 0));  // never the last stable one
+  }
+  // CKPT_STABLE(ckpt): that cut becomes the last stable one, older cuts go; false: no such confirmed cut
+  bool markStable(uint64_t ckpt) {
+    for (size_t i = 0; i < v.size(); i++)
+      if (v[i].ckpt == ckpt) {
+        v.erase(v.begin(), v.begin() + (long)i);
+        v.front().stable = true;
+        return true;
+      }
+    return false;
+  }
+  const struct gdakiCkptCut<R>* find(uint64_t ckpt) const {
+    for (const auto& c : v)
+      if (c.ckpt == ckpt) return &c;
+    return nullptr;
+  }
+};
+
+// The spare's FETCH (impl/rs_ckpt_api.h): the buddy's answer starts with GDAKI_CKPT_MAGIC and a second 32-bit word that is
+// the header's version (an image follows) or a refusal's ok = 0 (a gdakiCkptAck follows). 1: a header, 0: a refusal,
+// -1: neither (a damaged stream).
+static int gdakiCkptFetchAnswer(uint32_t magic, uint32_t second) {
+  if (magic != GDAKI_CKPT_MAGIC) return -1;
+  if (second == GDAKI_CKPT_VERSION) return 1;
+  return second == 0 ? 0 : -1;
+}
+// The spare's regions against its image's: every region of the image names one of this process's regions of the same
+// kind, number and size, and the two lists have the same length (the spare replayed the same registrations; the
+// application registered the same ncclGinRestoreRegister buffers before Resume). map[i]: the local index of image region
+// i. False: why (nothing may be written then).
+static bool gdakiCkptRegionMatch(const struct gdakiCkptRegion* img, int nImg, const uint32_t* kind, const uint32_t* id,
+                                 const uint64_t* bytes, int nLocal, int* map, const char** why) {
+  *why = "";
