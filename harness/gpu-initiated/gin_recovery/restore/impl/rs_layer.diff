+// ---- life ----
+static void gdakiCkptCreate(struct gdakiRecHost* r) {
+  struct gdakiHold* h = r->hold;
+  if (h == nullptr || h->ckpt != nullptr) return;
+  struct gdakiCkpt* ck = new gdakiCkpt();
+  ck->peers.resize((size_t)r->nranks);
+  ck->store.resize((size_t)r->nranks);
+  ck->nqp.assign((size_t)r->nranks, 0);
+  h->ckpt = ck;
+  (void)gdakiCkptSelfOf();  // NCCL_GIN_RESTORE_SPARE_ADDR resolved here (the application thread), never on the helper
+  ck->serveTh = std::thread(gdakiCkptServeMain, r);
+  ck->upTh = std::thread(gdakiCkptUploadMain, r);
+}
+// Before the helper's state goes (every data thread's wait is bounded by NCCL_GIN_TS_HANDSHAKE_MS and sees `stop`).
+static void gdakiCkptStop(struct gdakiRecHost* r) {
+  struct gdakiCkpt* ck = gdakiCkptOf(r);
+  if (ck == nullptr) return;
+  ck->stop.store(true, std::memory_order_release);
+  ck->cv.notify_all();
+  if (ck->serveTh.joinable()) ck->serveTh.join();
+  if (ck->upTh.joinable()) ck->upTh.join();
+  std::lock_guard<std::mutex> lk(ck->mu);
+  for (auto& c : ck->incoming) close(c.first);
+  ck->incoming.clear();
+}
+static void gdakiCkptFree(struct gdakiRecHost* r) {
+  struct gdakiCkpt* ck = gdakiCkptOf(r);
+  if (ck == nullptr) return;
+  gdakiCkptStop(r);
+  if (ck->devCopy) (void)cudaFree(ck->devCopy);
+  if (ck->hostCopy) (void)cudaFreeHost(ck->hostCopy);
+  if (ck->copyStream) (void)cudaStreamDestroy(ck->copyStream);
+  if (ck->upStream) (void)cudaStreamDestroy(ck->upStream);
+  delete ck;
+  r->hold->ckpt = nullptr;
+}
+static void gdakiCkptTeardownLine(struct gdakiRecHost* r) {
+  struct gdakiCkpt* ck = gdakiCkptOf(r);
+  if (ck == nullptr) return;
+  GIN_TS_NOTE("GIN/RS: rank %d checkpoints at close: taken=%d stable=%d skipped=%d void=%d paused_for_peers=%d busy_sent=%d "
+              "uploads=%d upload_bytes=%lld served=%d pause_ms_mean=%.2f pause_ms_max=%.2f", r->ctx->rank, ck->nTaken.load(),
+              ck->nStable.load(), ck->nSkipped.load(), ck->nVoid.load(), ck->nPausedFor.load(), ck->nBusySent.load(),
+              ck->nUploads.load(), ck->nUploadBytes.load(), ck->nServed.load(),
+              ck->pauseCount ? ck->pauseMsSum / (double)ck->pauseCount : 0.0, ck->pauseMsMax);
+}
