+        if (map[i] >= 0) {
+          *why = "two regions of this process have the same kind and number";
+          return false;
+        }
+        map[i] = j;
+      }
+    if (map[i] < 0) {
+      *why = "a region of the image has no region of the same kind and number here";
+      return false;
+    }
+    if (used[map[i]]) {
+      *why = "two regions of the image have the same kind and number";
+      return false;
+    }
+    used[map[i]] = true;
+    if (bytes[map[i]] != img[i].bytes) {
