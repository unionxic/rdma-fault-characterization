@@ -219,6 +219,37 @@ struct ncclGinGdakiQ4 {
   uint32_t sticky[NCCL_GIN_GDAKI_Q4_MAX_CTX];   // per GIN context: 1 once an error CQE was classified
 };
 
+// gin-restore (rs, work package 3; EXPERIMENT.md 9.9, 9.11.5): the side table of one GDAKI context, in device memory,
+// zeroed at creation. Only a process that asks for the restore has one; elsewhere ncclGinGdakiGPUContext::restore is null.
+// A 64-byte header, then one ncclGinRsQp per QP of the context array (qp index = peer + context * nranks). The QP's
+// send-side log follows the format of the study's prototype (its LogRing: 64-byte entries and a payload ring). This build
+// allocates and zeroes it; the device code reads it from work package 4 on, the helper from work package 5 on (the layout
+// may change with them: every program is built with this layer's headers).
+#define NCCL_GIN_RS_SIDE_MAGIC 0x31535352u  // "RSS1"
+struct ncclGinRsSide {
+  uint32_t magic;
+  uint32_t nqp;
+  uint64_t fence;        // the 8-byte READ target of the checkpoint's drain check (9.4 step 3; in the strict loopback MR)
+  uint64_t reserved[6];
+};
+struct ncclGinRsQp {
+  uint64_t head;         // log entries reserved (device, atomic add)
+  uint64_t payHead;      // log payload bytes reserved (device, atomic add)
+  uint64_t msgs;         // request messages logged (device, atomic add)
+  uint64_t tail;         // first entry kept (host, at the peer's stable checkpoint)
+  uint64_t payTail;      // first payload byte kept (host)
+  uint64_t ovfSeq;       // 1 + the highest entry number that could not be logged (0: none)
+  void* entries;         // nEntries entries of 64 bytes (null: this QP has no log, e.g. this rank's own)
+  void* pay;             // payBytes bytes
+  uint64_t payBytes;     // power of two
+  uint32_t nEntries;     // power of two
+  uint32_t logOn;        // the helper sets it in the QP's first checkpoint input pause; the device logs only then
+  uint64_t suppress;     // request messages the spare process still holds back on this QP (0 otherwise)
+  uint64_t reserved[5];
+};
+static_assert(sizeof(struct ncclGinRsSide) == 64, "the side table header is 64 bytes");
+static_assert(sizeof(struct ncclGinRsQp) == 128, "a side table QP entry is 128 bytes");
+
 struct ncclGinGdakiGPUContext {
   struct doca_gpu_dev_verbs_qp* gdqp;
   struct doca_gpu_dev_verbs_qp* companion_gdqp;
@@ -233,6 +264,11 @@ struct ncclGinGdakiGPUContext {
