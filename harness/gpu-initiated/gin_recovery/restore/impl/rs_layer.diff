+    else if (x.why != 0) snprintf(out, outLen, "the devComm wait word raised: %s", gdakiUaName(x.why));
+    else if (x.degradedAtMs != 0) snprintf(out, outLen, "degraded scheduled after rank %d was judged dead", x.degradedPeer);
+    else
+      for (int p = 0; p < (int)x.peerWhy.size(); p++)
+        if (x.peerWhy[p] != 0) {
+          snprintf(out, outLen, "rank %d's wait word raised: %s", p, gdakiUaName(x.peerWhy[p]));
+          break;
+        }
+    return;
+  }
