+// ---- the application's calls (ncclGinRestoreStep, ncclGinRestoreRegister; gin/gin_host.cc's entries) ----
+static struct gdakiRecHost* gdakiCkptFindComm(void* comm) {
+  std::lock_guard<std::mutex> lk(gdakiRecRegMu);
+  for (auto* r : gdakiRecReg)
+    if (r->commKey == comm && r->hold != nullptr && r->hold->ckpt != nullptr) return r;
+  return nullptr;
+}
+// The regions of this rank's image now (application thread): its windows on the context's collComm (in registration
+// order), its ncclGinRestoreRegister buffers, its signal and counter tables.
+static bool gdakiCkptRegions(struct gdakiRecHost* r, std::vector<struct gdakiCkptRegionSrc>* out) {
+  struct gdakiCkpt* ck = gdakiCkptOf(r);
+  out->clear();
+  {
+    std::lock_guard<std::mutex> lk(gdakiRsWinMu);
+    for (const auto& w : gdakiRsWins)
+      if (w.coll == (void*)r->ctx->collComm && !w.gone && w.hi > w.lo)
+        out->push_back({GDAKI_CKPT_REGION_WINDOW, w.id, (const void*)w.lo, (uint64_t)(w.hi - w.lo)});
+  }
+  if (ck != nullptr) {
+    std::lock_guard<std::mutex> lk(ck->mu);
+    for (size_t i = 0; i < ck->registered.size(); i++)
+      out->push_back({GDAKI_CKPT_REGION_REGISTERED, (uint32_t)i, ck->registered[i].first, ck->registered[i].second});
+  }
+  struct gdaki_context* g = r->ctx;
+  if (g->signals_table && g->signals_table->buffer_bytes())
+    out->push_back({GDAKI_CKPT_REGION_SIGNALS, 0, g->signals_table->gpu_ptr, g->signals_table->buffer_bytes()});
+  if (g->counters_table && g->counters_table->buffer_bytes())
+    out->push_back({GDAKI_CKPT_REGION_COUNTERS, 0, g->counters_table->gpu_ptr, g->counters_table->buffer_bytes()});
+  return out->size() <= GDAKI_CKPT_MAX_REGIONS;
+}
+// One checkpoint (application thread): the regions and the copy buffers, the ask to the helper, the copy once drained.
+static void gdakiCkptTake(struct gdakiRecHost* r, uint64_t step, const void* blob, size_t bytes) {
+  struct gdakiCkpt* ck = gdakiCkptOf(r);
+  {
+    std::lock_guard<std::mutex> lk(ck->mu);
+    // the previous one still runs (the helper not idle, its upload): no wait on the application thread, tried again later
+    if (ck->req != GDAKI_CKPT_REQ_NONE || ck->up.pending || ck->up.running || ck->phasePub != GDAKI_CKPT_I_IDLE) return;
+  }
+  auto backOff = [&]() {  // a checkpoint this rank cannot even ask for: tried again a quarter interval later
+    std::lock_guard<std::mutex> lk(ck->mu);
+    ck->haveRetry = true;
+    ck->retryAtStep = step + (uint64_t)std::max<int64_t>(1, ncclParamGinRestoreCkptSteps() / 4);
+  };
+  std::vector<struct gdakiCkptRegionSrc> regs;
+  uint64_t off[GDAKI_CKPT_MAX_REGIONS] = {}, sizes[GDAKI_CKPT_MAX_REGIONS] = {}, total = 0;
+  if (!gdakiCkptRegions(r, &regs)) {
+    WARN("GIN/RS: rank %d: more than %d checkpoint regions; no checkpoint", r->ctx->rank, GDAKI_CKPT_MAX_REGIONS);
+    return backOff();
+  }
+  for (size_t i = 0; i < regs.size(); i++) sizes[i] = regs[i].bytes;
+  if (!gdakiCkptLayout(sizes, (int)regs.size(), off, &total) || total == 0) return backOff();
+  if (ck->copyStream == nullptr && cudaStreamCreateWithFlags(&ck->copyStream, cudaStreamNonBlocking) != cudaSuccess) {
+    ck->copyStream = nullptr;
+    return backOff();
+  }
+  if (ck->upStream == nullptr && cudaStreamCreateWithFlags(&ck->upStream, cudaStreamNonBlocking) != cudaSuccess) {
+    ck->upStream = nullptr;
+    return backOff();
+  }
+  if (ck->devCopyBytes < total) {
+    if (ck->devCopy) (void)cudaFree(ck->devCopy);
+    ck->devCopy = nullptr;
+    ck->devCopyBytes = 0;
+    if (cudaMalloc(&ck->devCopy, (size_t)total) != cudaSuccess) {
+      ck->devCopy = nullptr;
+      WARN("GIN/RS: rank %d: cannot allocate %lu bytes of GPU memory for the checkpoint copy", r->ctx->rank,
+           (unsigned long)total);
+      return backOff();
+    }
+    ck->devCopyBytes = total;
+  }
+  if (ck->hostCopyBytes < total) {
+    if (ck->hostCopy) (void)cudaFreeHost(ck->hostCopy);
+    ck->hostCopy = nullptr;
+    ck->hostCopyBytes = 0;
+    if (cudaHostAlloc((void**)&ck->hostCopy, (size_t)total, cudaHostAllocDefault) != cudaSuccess) {
+      ck->hostCopy = nullptr;
+      WARN("GIN/RS: rank %d: cannot allocate %lu bytes of host memory for the checkpoint upload", r->ctx->rank,
+           (unsigned long)total);
+      return backOff();
+    }
+    ck->hostCopyBytes = total;
+  }
+  {
+    std::lock_guard<std::mutex> lk(ck->mu);
+    ck->regions = regs;
+    for (size_t i = 0; i < regs.size(); i++) ck->regionOff[i] = off[i];
+    ck->imageBytes = total;
+    ck->blob.assign((const uint8_t*)blob, (const uint8_t*)blob + bytes);
+    ck->req = GDAKI_CKPT_REQ_ASKED;
+    ck->reqCkpt = step;
+    ck->reqOk = false;
+    ck->reqWhy[0] = '\0';
+  }
+  ck->cv.notify_all();
+  const double t0 = gdakiQ4MonoMs();
+  const auto bound = std::chrono::milliseconds(gdakiCkptPauseMs() + ncclParamGinRestoreDrainMs() + 1000);
+  int got;
+  {
+    std::unique_lock<std::mutex> lk(ck->mu);
+    ck->cv.wait_for(lk, bound,
+                    [&] { return ck->req == GDAKI_CKPT_REQ_DRAINED || ck->req == GDAKI_CKPT_REQ_SKIPPED; });
+    got = ck->req;
+    if (got != GDAKI_CKPT_REQ_DRAINED) {  // skipped, or the helper did not answer in time: tried again a quarter later
+      ck->req = GDAKI_CKPT_REQ_NONE;
+      ck->haveRetry = true;
+      ck->retryAtStep = step + (uint64_t)std::max<int64_t>(1, ncclParamGinRestoreCkptSteps() / 4);
+    } else {
+      ck->haveRetry = false;
+    }
+  }
+  if (got != GDAKI_CKPT_REQ_DRAINED) return;
+  bool ok = true;
+  for (size_t i = 0; i < regs.size() && ok; i++)
+    ok = cudaMemcpyAsync((uint8_t*)ck->devCopy + off[i], regs[i].src, (size_t)regs[i].bytes, cudaMemcpyDefault,
+                         ck->copyStream) == cudaSuccess;
+  ok = ok && cudaStreamSynchronize(ck->copyStream) == cudaSuccess;
+  {
+    std::lock_guard<std::mutex> lk(ck->mu);
+    // the helper may have given this checkpoint up meanwhile (its copy bound): then nothing is waiting for the copy, and
+    // a COPIED left behind would block every later checkpoint
+    if (ck->req == GDAKI_CKPT_REQ_DRAINED) {
+      ck->req = GDAKI_CKPT_REQ_COPIED;
+      ck->reqOk = ok;
+    } else {
+      ck->req = GDAKI_CKPT_REQ_NONE;
+    }
+    ck->haveLast = true;
+    ck->lastCkpt = step;
+  }
+  ck->cv.notify_all();
+  ck->nTaken.fetch_add(1, std::memory_order_relaxed);
+  INFO(NCCL_NET, "GIN/RS: rank %d: checkpoint %lu copied (%lu bytes, %zu regions) in %.2f ms", r->ctx->rank,
+       (unsigned long)step, (unsigned long)total, regs.size(), gdakiQ4MonoMs() - t0);
+}
+ncclResult_t ncclGinGdakiRestoreStep(void* comm, unsigned long long step, const void* blob, size_t bytes,
+                                     unsigned long long* stableStep) {
+  struct gdakiRecHost* r = gdakiCkptFindComm(comm);
+  if ((blob == nullptr && bytes != 0) || bytes > GDAKI_CKPT_MAX_BLOB) {
+    WARN("GIN/RS: ncclGinRestoreStep: a blob of %zu bytes (at most %u, not NULL when not empty)", bytes,
+         GDAKI_CKPT_MAX_BLOB);
+    return ncclInvalidArgument;
+  }
+  // a communicator the restore is not enabled on retains nothing: every step is stable at once (9.4)
+  if (r == nullptr || !gdakiHoldCommArmedNow(r->hold) || !gdakiRsLogReady(r)) {
+    if (stableStep) *stableStep = step;
+    return ncclSuccess;
+  }
+  struct gdakiCkpt* ck = gdakiCkptOf(r);
+  uint64_t head = 0;
+  const bool headOk = gdakiRsLogReadHeadApp(r, &head) == ncclSuccess;
+  bool due;
+  {
+    std::lock_guard<std::mutex> lk(ck->mu);
+    if (headOk) ck->steps.add(step, head, GDAKI_CKPT_STEPLOG_CAP);
+    due = gdakiCkptDue(step, ck->haveLast, ck->lastCkpt, (uint64_t)std::max<int64_t>(1, ncclParamGinRestoreCkptSteps())) &&
+          (!ck->haveRetry || step >= ck->retryAtStep);
+  }
+  if (due) gdakiCkptTake(r, step, blob, bytes);
+  const uint64_t covered = gdakiRsLogCoveredUpTo(r);
+  std::lock_guard<std::mutex> lk(ck->mu);
+  const uint64_t s = gdakiRsStableStepOf(ck->steps.steps.data(), ck->steps.heads.data(), (int)ck->steps.steps.size(),
+                                         covered, NCCL_GIN_RESTORE_STEP_NONE);
+  ck->steps.settle(s, NCCL_GIN_RESTORE_STEP_NONE);
+  if (stableStep) *stableStep = ck->steps.haveStable ? ck->steps.stable : NCCL_GIN_RESTORE_STEP_NONE;
+  return ncclSuccess;
+}
+ncclResult_t ncclGinGdakiRestoreRegister(void* comm, void* buff, size_t size) {
+  if (buff == nullptr || size == 0) return ncclInvalidArgument;
+  struct gdakiRecHost* r = gdakiCkptFindComm(comm);
+  if (r == nullptr) return ncclSuccess;  // no restore on this communicator: nothing to keep
+  struct gdakiCkpt* ck = gdakiCkptOf(r);
+  std::lock_guard<std::mutex> lk(ck->mu);
+  for (const auto& b : ck->registered)
+    if (b.first == buff && b.second == size) return ncclSuccess;
+  ck->registered.push_back(std::make_pair(buff, (uint64_t)size));
+  return ncclSuccess;
+}
