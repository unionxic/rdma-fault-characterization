+    }
+    if (rFound != nullptr && rFound->ctx != nullptr && rFound->ctx->q4 != nullptr &&
+        rFound->ctx->q4->asyncResult != nullptr)
+      asyncSet = __atomic_load_n(rFound->ctx->q4->asyncResult, __ATOMIC_ACQUIRE) != ncclSuccess;
+  }
+  in.sideWhy = sideWhy;
+  in.rsLbWhy = rsLbWhy;
+  // work package 3: the windows of this context's collComm since the context started, and the devComm's resource window
+  // (registered after the context by ncclDevCommCreate, 9.10.8): added to the NIC copy path's MRs here, under the list's
+  // lock (the helper reads the list), only when everything before it is in place on this rank
+  void* resRkeys = nullptr;
