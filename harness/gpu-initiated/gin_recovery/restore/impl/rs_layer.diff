+// The exchange with a bound: exchange() runs on the calling thread; if it has not returned after ms milliseconds, a
+// watcher thread calls abortFn() once, which must make exchange() return (the communicator's abort flag ends the bootstrap
+// socket loops). *expired tells whether the bound passed; ms <= 0: no bound. Returns exchange()'s result.
+template <typename X, typename A>
+static int gdakiRsRunBounded(X exchange, A abortFn, long long ms, bool* expired) {
+  *expired = false;
+  if (ms <= 0) return exchange();
+  std::mutex mu;
+  std::condition_variable cv;
+  bool done = false;
+  std::thread watcher([&] {
+    std::unique_lock<std::mutex> lk(mu);
+    if (!cv.wait_for(lk, std::chrono::milliseconds(ms), [&] { return done; })) {
+      *expired = true;  // decided under the lock: the caller reads it after the join
+      abortFn();
+    }
+  });
+  const int rc = exchange();
+  {
+    std::lock_guard<std::mutex> lk(mu);
+    done = true;
+  }
+  cv.notify_all();
+  watcher.join();
+  return rc;
+}
