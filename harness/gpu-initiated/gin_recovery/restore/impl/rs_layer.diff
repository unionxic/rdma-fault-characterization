+// gin-restore (rs, work package 2): what the public entry ncclGinRestoreResume (gin/gin_host.cc) tells the GDAKI restore
+// layer (transport/net_ib/gdaki/gin_host_gdaki.cc), which judges, runs the bounded exchange through `exchange` (the
+// communicator's bootstrap all-gather) and decides; `abortComm` sets the communicator's abort flags.
+struct ncclGinRestoreCommFacts {
+  int rank, nRanks;           // in the communicator
+  uint64_t commHash;          // with bootstrap: which communicator this is (a later one may reuse its address)
+  void* bootstrap;
+  int asyncErr;               // the communicator's asynchronous error (ncclCommGetAsyncError; 0: none)
+  int argsOk;                 // devComm, step and bytes are not NULL
+  int devCommVersion;         // the devComm's device-code version (-1: unversioned; 0: no devComm)
+  int ginType;                // the devComm's GIN backend (NCCL_GIN_TYPE_*; 0: none)
+  int nConn;                  // the devComm's GIN connections
+  void* handles[NCCL_GIN_MAX_CONNECTIONS];  // the devComm's GIN handles (ncclDevComm::ginHandles)
+  int commFull;               // the communicator's GIN connection is FULL
+  int ctxStride;              // the devComm's GIN context stride
+  int numRmaCtx;              // host RMA contexts (comm->config.numRmaCtx)
+  int runtimeConn;            // runtime connect is on
+  int nvls;                   // NVLS support is on
+  int lsaSize;                // the devComm's LSA team size
+  int symGinDevComm;          // NCCL's symmetric kernels have a GIN devComm on this communicator
+};
+ncclResult_t ncclGinGdakiRestoreResume(void* comm, const struct ncclGinRestoreCommFacts* facts,
+                                       ncclResult_t (*exchange)(void* comm, void* data, int bytesPerRank),
+                                       void (*abortComm)(void* comm), unsigned long long* step, void* blob,
+                                       size_t* bytes);
+
 #endif
diff --git a/src/nccl.h.in b/src/nccl.h.in
index f2149a2..209145c 100644
--- a/src/nccl.h.in
+++ b/src/nccl.h.in
@@ -1100,6 +1100,36 @@ typedef struct {
 ncclResult_t  ncclGinGetRecoveryStats(ncclComm_t comm, ncclGinRecoveryStats_t* stats);
 ncclResult_t pncclGinGetRecoveryStats(ncclComm_t comm, ncclGinRecoveryStats_t* stats);
 
+/*
+ * GIN GDAKI restore (research build, gin-restore). EXPERIMENTAL: the calls and their meaning may change.
+ * ncclGinRestoreResume: every rank of the communicator calls it, in the same order relative to the communicator's other
+ * calls, after ncclDevCommCreate of the devComm its kernels use and before their first launch. Every rank contributes its
+ * own judgment and the ranks decide together over the communicator's bootstrap, so every rank returns the same result:
+ *   ncclSuccess: the restore can be enabled, or no rank asks for it (NCCL_GIN_FAULT_POLICY is not hold, or
+ *     NCCL_GIN_RESTORE=0). A first incarnation gets *step = 0 and *bytes = 0 (*bytes in: the capacity of blob).
+ *   ncclInvalidUsage: the restore is asked for and cannot be enabled; ncclGetLastError(comm), read right after the
+ *     call, holds the reason, the same on every rank.
+ *   ncclSystemError: the exchange did not complete within NCCL_GIN_RESTORE_RESUME_MS (default 30000 ms, the same on every
+ *     rank; <= 0: no bound) or failed: a rank did not call it. The communicator's abort flag is set (it is shared with
+ *     communicators split from or into it with shared resources, which then end too): end it with ncclCommAbort. A rank
+ *     that arrives just as the bound expires may complete while others do not.
+ * Before the exchange it returns at once only for an invalid comm, a communicator whose initialization failed (that
+ * error), or one still busy with a nonblocking operation (ncclInvalidArgument); every rank of such a job should see the
+ * same. Do not call it between ncclGroupStart and ncclGroupEnd. ncclGetLastError is
+ * process-wide: another thread's warning can replace the reason before it is read. A second call returns the first
+ * call's result. This build has no hold reaction yet: the communicator stays fail-fast.
+ * ncclGinRestoreStep and ncclGinRestoreRegister are not implemented in this build: they return ncclInvalidUsage.
+ */
+struct ncclDevComm;
+ncclResult_t  ncclGinRestoreResume(ncclComm_t comm, const struct ncclDevComm* devComm, unsigned long long* step,
+                                   void* blob, size_t* bytes);
+ncclResult_t pncclGinRestoreResume(ncclComm_t comm, const struct ncclDevComm* devComm, unsigned long long* step,
+                                   void* blob, size_t* bytes);
+ncclResult_t  ncclGinRestoreStep(ncclComm_t comm, unsigned long long step, const void* blob, size_t bytes);
+ncclResult_t pncclGinRestoreStep(ncclComm_t comm, unsigned long long step, const void* blob, size_t bytes);
+ncclResult_t  ncclGinRestoreRegister(ncclComm_t comm, void* buff, size_t size);
+ncclResult_t pncclGinRestoreRegister(ncclComm_t comm, void* buff, size_t size);
+
 #ifdef __cplusplus
 } // end extern "C"
 #endif
