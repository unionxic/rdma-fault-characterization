+  GDAKI_CKPT_REQ_NONE = 0,
+  GDAKI_CKPT_REQ_ASKED = 1,    // application: take checkpoint reqCkpt
+  GDAKI_CKPT_REQ_DRAINED = 2,  // helper: every peer paused and drained: copy now
