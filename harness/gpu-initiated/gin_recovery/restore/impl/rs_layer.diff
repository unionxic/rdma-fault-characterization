+// gin-restore (rs, work packages 3 and 4; EXPERIMENT.md 9.5, 9.6, 9.9, 9.11.5): the side table of one GDAKI context, in
+// device memory, zeroed at creation. Only a process that asks for the restore has one; the device reaches it through
+// ncclGinGdakiQ4::restore, which stays null until ncclGinRestoreResume succeeds, and only code compiled with
+// NCCL_GIN_RESTORE_DEVICE reads it. A 128-byte header (its second half: the send-side
+// log ring's control words), then one ncclGinRsQp per QP of the context array (qp index = peer + context * nranks), then
+// the send-side log: ONE ring for every QP of the context (user decision 2026-10-12: its memory follows the operations
+// between checkpoints, not the number of peers; the restore needs one such context per communicator, so it is one ring per
+// rank). The log holds descriptors only (user decision 2026-10-12): replay re-reads the data from the sender's source
+// window. Every program is built with this layer's headers (the layout may change with later work packages); the host
+// interface is impl/rs_log_api.h of gin-restore.
+#define NCCL_GIN_RS_SIDE_MAGIC 0x33535352u  // "RSS3" (one ring per context)
+// Overwrite detection of a put's source (NCCL_GIN_RESTORE_CHECKSUM): the scheme the sending thread uses.
+#define NCCL_GIN_RS_CSUM_OFF 0u
+#define NCCL_GIN_RS_CSUM_SAMPLED 1u  // the first 64 bytes of every 4 KiB of the data and its last 64 bytes
+#define NCCL_GIN_RS_CSUM_FULL 2u     // every byte
+// The header. Written by the host before the context is handed out (plain device loads): magic, nqp, csum, nEntries,
+// entries. The ring's control words: head (device: CAS inside the gate), tail (host, over the NIC; device: system-scope
+// relaxed loads), ovfCount (device, on overflow only); the host reads them over the NIC.
+struct ncclGinRsSide {
+  uint32_t magic;
+  uint32_t nqp;          // QP entries that follow (the device skips the side table for an index at or above it)
+  uint64_t fence;        // the 8-byte READ target of the checkpoint's drain check (9.4 step 3; in the strict loopback MR)
+  uint32_t csum;         // NCCL_GIN_RS_CSUM_* (host, before the context is handed out)
+  uint32_t nEntries;     // ring entries, a power of two (0: no ring)
+  void* entries;         // the ring: nEntries entries of 64 bytes; position p in slot p mod nEntries
+  uint64_t reserved0[4];
+  uint64_t head;         // positions reserved so far. A post takes position `head` with a CAS only when it fits
+                         // (head - tail < nEntries): every position below head is written once its post leaves the gate,
+                         // and an overflow takes no position (no gap the tail could not pass)
+  uint64_t tail;         // first position kept (host: the stable cuts of the peers; the measurement mode's helper)
+  uint64_t ovfCount;     // operations of every QP not logged because the ring was full (device atomic add, overflow only)
+  uint64_t reserved1[5];
+};
+// One QP's entry. Written by the host over the NIC while the device runs: logOn, suppress (device: system-scope relaxed
+// loads inside the gate). Written by the device: msgs, ovfCount, ovfHead, getRefused, gets (atomics, inside the gate; the host
+// reads them over the NIC, exactly once the gate is odd and its count is 0).
+struct ncclGinRsQp {
+  uint64_t msgs;         // request messages the hold path posted on this QP (device, atomic add, every post logOn or not;
+                         // a get's READ counts, a 0-byte put's NOP and a suppressed operation do not): 9.4's M_q
+  uint64_t suppress;     // request messages the spare process still holds back on this QP (host sets it before the
+                         // replay; the device takes it with a CAS inside the gate; 0 elsewhere)
+  uint64_t ovfCount;     // this QP's operations not logged because the ring was full (device atomic add, overflow only)
+  uint64_t ovfHead;      // 1 + the ring's head when this QP last overflowed (device atomic max; 0: never; diagnostic)
+  uint32_t logOn;        // the helper sets it in a checkpoint input pause toward the peer; the device logs only then
+  uint32_t getRefused;   // device: a get was asked while suppress was not 0 (not posted; the QP failed from the device)
+  uint64_t gets;         // gets with data the hold path posted on this QP (device atomic add): a survivor's get toward a
+                         // peer it may have to restore DISARMs that peer (EXPERIMENT.md 9.7 item 8, 9.10.4)
+  uint64_t reserved[10];
+};
+static_assert(sizeof(struct ncclGinRsSide) == 128, "the side table header is 128 bytes");
+static_assert(offsetof(struct ncclGinRsSide, fence) == 8 && offsetof(struct ncclGinRsSide, csum) == 16 &&
+                offsetof(struct ncclGinRsSide, nEntries) == 20 && offsetof(struct ncclGinRsSide, entries) == 24 &&
+                offsetof(struct ncclGinRsSide, head) == 64 && offsetof(struct ncclGinRsSide, tail) == 72 &&
+                offsetof(struct ncclGinRsSide, ovfCount) == 80,
+              "the side table header layout (the host reads it over the NIC by these offsets)");
+static_assert(sizeof(struct ncclGinRsQp) == 128, "a side table QP entry is 128 bytes");
+static_assert(offsetof(struct ncclGinRsQp, msgs) == 0 && offsetof(struct ncclGinRsQp, suppress) == 8 &&
+                offsetof(struct ncclGinRsQp, ovfCount) == 16 && offsetof(struct ncclGinRsQp, ovfHead) == 24 &&
+                offsetof(struct ncclGinRsQp, logOn) == 32 && offsetof(struct ncclGinRsQp, getRefused) == 36 &&
+                offsetof(struct ncclGinRsQp, gets) == 40,
+              "the side table QP entry layout (the host reads it over the NIC by these offsets)");
+
+// One send-side log entry (64 bytes, EXPERIMENT.md 9.5): the description of one operation as it was posted. Its first 8
+// bytes are its identity, written in one store: the low 32 bits of its position and the QP, kind and flags word. A slot
+// whose `pos` is not the position asked for holds an older entry or one still being written (the ring is shared by every
+// QP: a pause quiesces one peer's QPs only, so another peer's entry below the cut may still be in flight).
+#define NCCL_GIN_RS_LOG_PUT 1u       // put with data (with or without a signal)
+#define NCCL_GIN_RS_LOG_PUTVALUE 2u  // putValue (the value is in `src`)
+#define NCCL_GIN_RS_LOG_SIGNAL 3u    // a signal alone (a put without windows, or the signal of a split put)
+#define NCCL_GIN_RS_LOGF_SIGNAL 0x01u  // the operation carries a signal (sigWin, sigOff, sigVal)
+#define NCCL_GIN_RS_LOGF_SPLIT 0x02u   // the suppress budget held back the first messages: only the rest was posted
+#define NCCL_GIN_RS_LOGF_NOBASE 0x04u  // the source window has no address in its handle: no checksum
+#define NCCL_GIN_RS_LOGF_CSUM_SHIFT 3  // flag bits 3..4: the NCCL_GIN_RS_CSUM_* scheme of `csum`
+#define NCCL_GIN_RS_QP_BITS 24         // the QP index field (a QP number is 24 bits: no context array has more QPs)
+#define NCCL_GIN_RS_QP_MASK 0xffffffu
+struct ncclGinRsLogEntry {
+  uint32_t pos;          // low 32 bits of the entry's position (identity, with qpKf: one 8-byte store)
+  uint32_t qpKf;         // qp index (bits 0..23) | kind (bits 24..25) | flags (bits 26..31)
+  uint32_t csum;         // checksum of the data as posted (0 with the scheme off)
+  uint32_t sigWin;       // the signal's window: 0 = the context's signal table (an indexed signal), else the VA signal
+                         // window's number (ncclGinGdakiMemHandle::rsWinId); 0 also without a signal
+  uint32_t dstWin;       // target window's number (ncclGinGdakiMemHandle::rsWinId; 0: none)
+  uint32_t srcWin;       // put: source window's number (0: none)
+  uint64_t dstOff;       // target offset (as posted)
+  uint64_t bytes;        // put: bytes posted; putValue: the value's size
+  uint64_t src;          // put: source offset (as posted); putValue: the value (zero-extended)
+  uint64_t sigOff;       // the signal's offset (as posted)
+  uint64_t sigVal;       // the value added
+};
+static_assert(sizeof(struct ncclGinRsLogEntry) == 64, "a send-side log entry is 64 bytes");
+static_assert(offsetof(struct ncclGinRsLogEntry, qpKf) == 4 && offsetof(struct ncclGinRsLogEntry, csum) == 8 &&
+                offsetof(struct ncclGinRsLogEntry, sigWin) == 12 && offsetof(struct ncclGinRsLogEntry, dstWin) == 16 &&
+                offsetof(struct ncclGinRsLogEntry, srcWin) == 20 && offsetof(struct ncclGinRsLogEntry, dstOff) == 24 &&
+                offsetof(struct ncclGinRsLogEntry, bytes) == 32 && offsetof(struct ncclGinRsLogEntry, src) == 40 &&
+                offsetof(struct ncclGinRsLogEntry, sigOff) == 48 && offsetof(struct ncclGinRsLogEntry, sigVal) == 56,
+              "the send-side log entry layout (EXPERIMENT.md 9.5, impl/rs_log_api.h)");
+
+// ---- gin-restore: functions the device send path and the host share (work package 4) ----
+#if defined(__CUDACC__)
+#define NCCL_GIN_RS_HD __host__ __device__ inline
+#define NCCL_GIN_RS_UNROLL _Pragma("unroll")
+#else
+#define NCCL_GIN_RS_HD inline
+#define NCCL_GIN_RS_UNROLL
+#endif
+// The request messages one operation posts on its QP (EXPERIMENT.md 9.6): data messages first (DOCA splits a put into one
+// RDMA WRITE per 1 GiB, a 0-byte put is one NOP, which is not a message; putValue is one inline WRITE), then the signal.
+// A get is one READ per 1 GiB (0 bytes: a NOP) as well.
+#define NCCL_GIN_RS_CHUNK_SHIFT 30  // DOCA_GPUNETIO_VERBS_MAX_TRANSFER_SIZE_SHIFT
+NCCL_GIN_RS_HD uint64_t ncclGinRsDataMsgs(bool hasData, uint64_t bytes) {
+  return hasData ? ((bytes + ((1ull << NCCL_GIN_RS_CHUNK_SHIFT) - 1)) >> NCCL_GIN_RS_CHUNK_SHIFT) : 0;
+}
+// Of an operation of m messages, how many the suppress budget b holds back: the first min(b, m) (RC executes in order).
+NCCL_GIN_RS_HD uint64_t ncclGinRsTake(uint64_t b, uint64_t m) { return b < m ? b : m; }
+// What is left to post of a put (hasData: it has windows; bytes; hasSignal) once its first `skip` messages are held back:
+// the data chunks from chunk `skip` on (adv bytes later), then the signal. all: nothing is left.
+struct ncclGinRsPlan {
+  uint64_t m;      // the operation's messages
+  uint64_t mPost;  // messages left to post
+  uint64_t adv;    // bytes to skip at the start of the data (whole 1 GiB chunks)
+  bool postData;   // data (or a 0-byte put's NOP) is still posted
+  bool all;        // everything is held back
+};
+NCCL_GIN_RS_HD struct ncclGinRsPlan ncclGinRsPlanOf(bool hasData, uint64_t bytes, bool hasSignal, uint64_t skip) {
+  struct ncclGinRsPlan p;
+  const uint64_t nData = ncclGinRsDataMsgs(hasData, bytes);
+  p.m = nData + (hasSignal ? 1u : 0u);
+  if (skip > p.m) skip = p.m;
+  p.mPost = p.m - skip;
+  p.all = skip != 0 && skip == p.m;
+  p.postData = hasData && (skip == 0 || skip < nData);
+  p.adv = (skip != 0 && skip < nData) ? skip << NCCL_GIN_RS_CHUNK_SHIFT : 0;
+  return p;
+}
+// A log reservation: position `slot` of a ring of n (a power of two) whose first kept position is `tail`. False: the ring
+// is full. Signed: the device reads the head, then the tail; the measurement mode's helper may move the tail to a newer
+// head in between (then the CAS on the old head fails and the post reads both again).
+NCCL_GIN_RS_HD bool ncclGinRsLogFits(uint64_t slot, uint64_t tail, uint32_t n) {
+  return (int64_t)(slot - tail) < (int64_t)n;
+}
+// The entry's identity word (its first 8 bytes, little-endian): the position's low 32 bits and the qp, kind, flags word.
+NCCL_GIN_RS_HD uint32_t ncclGinRsQpKf(uint32_t qp, uint32_t kind, uint32_t flags) {
+  return (qp & NCCL_GIN_RS_QP_MASK) | ((kind & 3u) << 24) | ((flags & 0x3fu) << 26);
+}
+NCCL_GIN_RS_HD uint64_t ncclGinRsIdWord(uint64_t pos, uint32_t qpKf) {
+  return (uint64_t)(uint32_t)pos | ((uint64_t)qpKf << 32);
+}
+NCCL_GIN_RS_HD uint32_t ncclGinRsEntryQp(uint32_t qpKf) { return qpKf & NCCL_GIN_RS_QP_MASK; }
+NCCL_GIN_RS_HD uint32_t ncclGinRsEntryKind(uint32_t qpKf) { return (qpKf >> 24) & 3u; }
+NCCL_GIN_RS_HD uint32_t ncclGinRsEntryFlags(uint32_t qpKf) { return qpKf >> 26; }
+// Whether the identity word read from slot (pos mod n) is the entry of position `pos`: the low 32 bits of the position and a
+// kind (every written entry has kind 1..3; the ring starts zeroed, and a zeroed slot must not read as position 0).
+NCCL_GIN_RS_HD bool ncclGinRsIdIs(uint64_t idWord, uint64_t pos) {
+  return (uint32_t)idWord == (uint32_t)pos && ncclGinRsEntryKind((uint32_t)(idWord >> 32)) != 0;
+}
+// The entry's second and third words (little-endian): the checksum and the signal's window; the target and source
+// windows' numbers (the device writes them as such; the host reads the struct).
+NCCL_GIN_RS_HD uint64_t ncclGinRsWord1(uint32_t csum, uint32_t sigWin) { return (uint64_t)csum | ((uint64_t)sigWin << 32); }
+NCCL_GIN_RS_HD uint64_t ncclGinRsWord2(uint32_t dstWin, uint32_t srcWin) { return (uint64_t)dstWin | ((uint64_t)srcWin << 32); }
+// The request messages an entry's operation posted (EXPERIMENT.md 9.6's units; the entry keeps what was posted, so the
+// data messages of a split put are those of its remaining chunks).
+NCCL_GIN_RS_HD uint64_t ncclGinRsEntryMsgs(uint32_t qpKf, uint64_t bytes) {
+  const uint32_t kind = ncclGinRsEntryKind(qpKf);
+  const uint64_t data = kind == NCCL_GIN_RS_LOG_PUT        ? ncclGinRsDataMsgs(true, bytes)
+                        : kind == NCCL_GIN_RS_LOG_PUTVALUE ? 1u
+                                                           : 0u;
+  return data + ((ncclGinRsEntryFlags(qpKf) & NCCL_GIN_RS_LOGF_SIGNAL) ? 1u : 0u);
+}
+
+// The checksum of a put's data (EXPERIMENT.md 9.5). The data is read as 4-byte little-endian words u_j (the last one
+// zero-padded); the scheme picks the words: FULL every word, SAMPLED the words with j mod 1024 < 16 (the first 64 bytes of
+// every 4 KiB counted from the data's first byte) and the last 16 words, each word once. Every picked word adds to two
+// 32-bit lanes; a sum, so the order in which words are read does not matter. The result is the two lanes mixed with the
+// byte count and the scheme, folded to 32 bits. One definition for both sides: the device reads the source through L2
+// (ncclGinRsCsumWalk with aligned loads), the host a copy of it (ncclGinRsCsumBuf).
+NCCL_GIN_RS_HD void ncclGinRsCsumStep(uint32_t u, uint64_t j, uint32_t& a, uint32_t& b) {
+  const uint32_t x = u ^ ((uint32_t)j * 0x9E3779B1u);
+  a += x * 0x85EBCA77u;
+  b += (x ^ (x >> 15)) * 0xC2B2AE3Du;
+}
+NCCL_GIN_RS_HD uint32_t ncclGinRsCsumFinal(uint32_t a, uint32_t b, uint64_t bytes, uint32_t scheme) {
+  uint64_t h = (((uint64_t)b << 32) | a) ^ (bytes * 0x9E3779B97F4A7C15ull) ^ ((uint64_t)scheme << 56);
+  h ^= h >> 30;
+  h *= 0xBF58476D1CE4E5B9ull;
+  h ^= h >> 27;
+  h *= 0x94D049BB133111EBull;
+  h ^= h >> 31;
+  return (uint32_t)(h ^ (h >> 32));
+}
+struct ncclGinRsQuad { uint32_t x, y, z, w; };  // four words of one 16-byte load, in address order
+#ifndef NCCL_GIN_RS_CSUM_QUADS
+#define NCCL_GIN_RS_CSUM_QUADS 4  // 16-byte loads in flight per step of the aligned walk (64 bytes: one sampled block)
+#endif
+// Words [j0, j1) of the data at p (bytes long). L supplies the loads: w4(q) a 4-byte-aligned word, w16(q) a 16-byte-aligned
+// quad, b1(q) a byte. Only aligned loads inside [p, p + bytes) are made: 16-byte loads when p is 16-byte aligned, words when
+// it is 4-byte aligned, else bytes; the partial last word byte by byte.
+template <typename L>
+NCCL_GIN_RS_HD void ncclGinRsCsumRange(const uint8_t* p, uint64_t bytes, uint64_t j0, uint64_t j1, uint32_t& a,
+                                       uint32_t& b, const L& ld) {
+  const uint64_t whole = bytes >> 2;
+  const uint64_t jw = j1 < whole ? j1 : whole;
+  uint64_t j = j0;
+  const uintptr_t pa = (uintptr_t)p;
+  if ((pa & 3) == 0) {
+    if ((pa & 15) == 0) {
+      while (j < jw && (j & 3) != 0) {
+        ncclGinRsCsumStep(ld.w4(p + 4 * j), j, a, b);
+        j++;
+      }
+      // NCCL_GIN_RS_CSUM_QUADS independent 16-byte loads in flight (one thread reads). Few on purpose: under whole-program
+      // compilation the device's register count of every kernel that can reach this covers it, fail-fast kernels too.
+      while (j + 4 * NCCL_GIN_RS_CSUM_QUADS <= jw) {
+        struct ncclGinRsQuad v[NCCL_GIN_RS_CSUM_QUADS];
+NCCL_GIN_RS_UNROLL
+        for (int k = 0; k < NCCL_GIN_RS_CSUM_QUADS; k++) v[k] = ld.w16(p + 4 * (j + 4 * (uint64_t)k));
+NCCL_GIN_RS_UNROLL
+        for (int k = 0; k < NCCL_GIN_RS_CSUM_QUADS; k++) {
+          const uint64_t i = j + 4 * (uint64_t)k;
+          ncclGinRsCsumStep(v[k].x, i, a, b);
+          ncclGinRsCsumStep(v[k].y, i + 1, a, b);
+          ncclGinRsCsumStep(v[k].z, i + 2, a, b);
+          ncclGinRsCsumStep(v[k].w, i + 3, a, b);
+        }
+        j += 4 * NCCL_GIN_RS_CSUM_QUADS;
+      }
+      while (j + 4 <= jw) {
+        const struct ncclGinRsQuad v = ld.w16(p + 4 * j);
+        ncclGinRsCsumStep(v.x, j, a, b);
+        ncclGinRsCsumStep(v.y, j + 1, a, b);
+        ncclGinRsCsumStep(v.z, j + 2, a, b);
+        ncclGinRsCsumStep(v.w, j + 3, a, b);
+        j += 4;
+      }
+    }
+    while (j < jw) {
+      ncclGinRsCsumStep(ld.w4(p + 4 * j), j, a, b);
+      j++;
+    }
+  } else {
+    while (j < jw) {
+      const uint8_t* q = p + 4 * j;
+      ncclGinRsCsumStep((uint32_t)ld.b1(q) | ((uint32_t)ld.b1(q + 1) << 8) | ((uint32_t)ld.b1(q + 2) << 16) |
+                          ((uint32_t)ld.b1(q + 3) << 24),
+                        j, a, b);
+      j++;
+    }
+  }
+  if (j < j1 && 4 * j < bytes) {  // the partial last word (j == whole), zero-padded
+    uint32_t u = 0;
+    for (uint64_t k = 0; 4 * j + k < bytes; k++) u |= (uint32_t)ld.b1(p + 4 * j + k) << (8 * k);
+    ncclGinRsCsumStep(u, j, a, b);
+  }
+}
+template <typename L>
+NCCL_GIN_RS_HD uint32_t ncclGinRsCsumWalk(uint32_t scheme, const uint8_t* p, uint64_t bytes, const L& ld) {
+  uint32_t a = 0, b = 0;
+  const uint64_t n = (bytes + 3) >> 2;
+  if (scheme == NCCL_GIN_RS_CSUM_FULL) {
+    ncclGinRsCsumRange(p, bytes, 0, n, a, b, ld);
+  } else if (scheme == NCCL_GIN_RS_CSUM_SAMPLED) {
+    for (uint64_t s = 0; s < n; s += 1024) ncclGinRsCsumRange(p, bytes, s, s + 16 < n ? s + 16 : n, a, b, ld);
+    uint64_t j = n > 16 ? n - 16 : 0;  // the last 16 words, without those a 4 KiB head already took
+    while (j < n) {
+      const uint64_t r = j & 1023;
+      if (r < 16) {
+        j += 16 - r;
+        continue;
+      }
+      const uint64_t e = (j - r + 1024) < n ? (j - r + 1024) : n;
+      ncclGinRsCsumRange(p, bytes, j, e, a, b, ld);
+      j = e;
+    }
+  } else {
+    return 0;
+  }
+  return ncclGinRsCsumFinal(a, b, bytes, scheme);
+}
+// The host side: a copy of the source in host memory (the helper's staging buffer after a NIC loopback read; tests).
+struct ncclGinRsCsumHostLoad {
+  NCCL_GIN_RS_HD uint8_t b1(const uint8_t* q) const { return *q; }
+  NCCL_GIN_RS_HD uint32_t w4(const uint8_t* q) const {
+    return (uint32_t)q[0] | ((uint32_t)q[1] << 8) | ((uint32_t)q[2] << 16) | ((uint32_t)q[3] << 24);
+  }
+  NCCL_GIN_RS_HD struct ncclGinRsQuad w16(const uint8_t* q) const {
+    struct ncclGinRsQuad v;
+    v.x = w4(q);
+    v.y = w4(q + 4);
+    v.z = w4(q + 8);
+    v.w = w4(q + 12);
+    return v;
+  }
+};
+NCCL_GIN_RS_HD uint32_t ncclGinRsCsumBuf(uint32_t scheme, const void* p, uint64_t bytes) {
+  return ncclGinRsCsumWalk(scheme, (const uint8_t*)p, bytes, ncclGinRsCsumHostLoad());
+}
