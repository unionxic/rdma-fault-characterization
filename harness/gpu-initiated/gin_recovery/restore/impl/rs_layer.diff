+// ---- gin-restore (rs, work package 2): ncclGinRestoreResume's judgment and decision (nccl.h; the entry is in
+// gin/gin_host.cc, which passes the communicator's facts, the bootstrap all-gather and the abort-flag setter) ----
+// Every rank of the communicator calls it (user decision 2026-10-12, EXPERIMENT.md 9.10.8). This rank's judgment reads the
+// GDAKI context under gdakiRecRegMu (as ncclGinGetRecoveryStats) and only fields fixed before its helper started, atomics,
+// or (the NIC copy path's flag) an atomic load; the abort words under gdakiUaMu. It writes nothing the helper reads.
+// A second call returns the first call's result without an exchange.
+// Whether a fault already reached the application on this communicator (the TOLD of 9.10.5 (a), (b)); "" if not. Takes
+// gdakiUaMu alone (ncclGinTsUserAbortWord takes gdakiUaMu, then gdakiRecRegMu: never hold them the other way round).
+static void gdakiRsTold(void* comm, bool asyncSet, char* out, size_t outLen) {
+  out[0] = '\0';
+  if (asyncSet) {
+    snprintf(out, outLen, "the communicator's GIN asynchronous error is set");
+    return;
+  }
+  std::lock_guard<std::mutex> lk(gdakiUaMu);
+  for (auto& x : gdakiUaReg) {
+    if (x.comm != comm) continue;
+    if (x.allWhy != 0) snprintf(out, outLen, "every wait word raised: %s", gdakiUaName(x.allWhy));
+    else if (x.why != 0) snprintf(out, outLen, "the devComm wait word raised: %s", gdakiUaName(x.why));
+    else if (x.degradedAtMs != 0) snprintf(out, outLen, "degraded scheduled after rank %d was judged dead", x.degradedPeer);
+    else
+      for (int p = 0; p < (int)x.peerWhy.size(); p++)
+        if (x.peerWhy[p] != 0) {
+          snprintf(out, outLen, "rank %d's wait word raised: %s", p, gdakiUaName(x.peerWhy[p]));
+          break;
+        }
+    return;
+  }
+}
