+                     // registration is collective, so a window has the same number on every rank: log entries name windows
+                     // by it
+  void* rsBase;      // this rank's address of the registered range: the sending thread reads a put's source there for
+                     // its checksum (the MR is registered with IOVA 0, so the device otherwise knows only the offset)
 };
+static_assert(offsetof(struct ncclGinGdakiMemHandle, rkeys) == 0 && offsetof(struct ncclGinGdakiMemHandle, lkey) == 8 &&
+                offsetof(struct ncclGinGdakiMemHandle, rsWinId) == 12 && offsetof(struct ncclGinGdakiMemHandle, rsBase) == 16,
+              "hk's window handle fields keep their offsets");
 
 #endif /* _NCCL_DEVICE_GIN_GDAKI_DEVICE_HOST_COMMON_H_ */
