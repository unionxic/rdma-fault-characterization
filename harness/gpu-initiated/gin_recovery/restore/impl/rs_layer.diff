+    else if (strcmp(policyEnv, "failfast") != 0) c.policyBad = true;
+  }
+  if (c.policy == GDAKI_POLICY_HOLD) c.restoreOn = restoreVar() != 0;
+  if (spareEnv && *spareEnv) {
+    char* end = nullptr;
+    const long v = strtol(spareEnv, &end, 10);
+    if (spareEnv[0] >= '0' && spareEnv[0] <= '9' && *end == '\0' && v <= 0x7fffffffL) c.spare = (int)v;
+    else c.spareBad = true;
+  }
+  c.requested = c.restoreOn || c.spare >= 0;
+  c.forceStrict = c.requested;  // this library forces strict ordering for every process that asks for the restore
+  return c;
+}
+// The ordering a GDAKI window MR gets: strict when the window flags ask for it (NCCL_WIN_STRICT_ORDERING) or when this
+// process asks for the restore. Fail-fast: the flags alone, as hk.
+static bool gdakiRsWinStrict(bool flagStrict, const struct gdakiRsCfg& c) { return flagStrict || c.forceStrict; }
+
+// The setup record's policyPad (hk: 0): what this rank asks for and the facts that keep the restore off. Only a rank that
+// asks for the restore fills it; a fail-fast rank sends 0, as hk.
+enum : uint32_t {
+  GDAKI_RS_REQ = 1u << 0,      // this rank asks for the restore
+  GDAKI_RS_STRICT = 1u << 1,   // this rank registers every GDAKI window MR of its process strict
+  GDAKI_RS_SPARE = 1u << 2,    // this rank runs as a spare process
+  GDAKI_RS_RECOFF = 1u << 3,   // a local check turned this rank's transparent recovery off before the all-gather
+  GDAKI_RS_GINTYPE = 1u << 8,  // NCCL_GIN_TYPE is not 3 (the GDAKI backend only)
+  GDAKI_RS_RMA = 1u << 9,      // NCCL_RMA_DISABLE is 0 (the host RMA proxy would connect outside the GIN setup)
+  GDAKI_RS_SYMGIN = 1u << 10,  // NCCL_SYM_GIN_KERNELS_ENABLE is not 0 (NCCL's symmetric kernels make their own GIN devComm)
+  GDAKI_RS_STRIDE = 1u << 11,  // this devComm's GIN contexts do not reach every rank (rank stride above 1)
+};
+static uint32_t gdakiRsMineBits(const struct gdakiRsCfg& c, long long ginType, long long rmaDisable, long long symGin,
+                                int rankStride, bool recOff) {
+  if (!c.requested) return 0;
+  uint32_t b = GDAKI_RS_REQ;
+  if (c.forceStrict) b |= GDAKI_RS_STRICT;
+  if (c.spare >= 0) b |= GDAKI_RS_SPARE;
+  if (recOff) b |= GDAKI_RS_RECOFF;
+  if (ginType != 3) b |= GDAKI_RS_GINTYPE;  // NCCL_GIN_TYPE_GDAKI
+  if (rmaDisable == 0) b |= GDAKI_RS_RMA;
+  if (symGin != 0) b |= GDAKI_RS_SYMGIN;
+  if (rankStride != 1) b |= GDAKI_RS_STRIDE;
+  return b;
+}
+// Rank p's transparent recovery was on when it sent its record: hk's magic (the listen socket is open and the local checks
+// passed), unless the record says a later local check (the responder MSN baselines) turned it off. hk keeps the magic in
+// that case; a rank that asks for the restore says so in its policyPad, so the wire record of a fail-fast rank is hk's.
+static uint8_t gdakiRsRecOn(bool magicOk, uint32_t bits) { return (magicOk && !(bits & GDAKI_RS_RECOFF)) ? 1 : 0; }
+
+// The decision every rank takes right after the setup all-gather (9.10.8, K15), from the n records alone: no argument says
+// which rank decides, so the same records give the same verdict and the same reason on every rank. recOn[p]: see
+// gdakiRsRecOn. Checked in this order, each at its lowest rank: nobody asks; the request differs between ranks; a rank that
+// asks does not register strict (the one verdict that ends the GDAKI context's creation, 9.10.8: ncclInternalError and a
+// WARN); transparent recovery off; a spare inside a live setup; the variables the restore needs. A failure after the
+// all-gather (the helper sockets' connect) is not in the records: that rank's own report says so (gdakiTsSetup).
+enum { GDAKI_RS_NOT_REQUESTED = 0, GDAKI_RS_ENABLE = 1, GDAKI_RS_REFUSE = 2, GDAKI_RS_REFUSE_FATAL = 3 };
+#define GDAKI_RS_WHY_LEN 224
+static const char* gdakiRsVerdictName(int v) {
+  return v == GDAKI_RS_ENABLE ? "can be enabled" : v == GDAKI_RS_NOT_REQUESTED ? "not requested" : "refused";
+}
+// The reason when rank a asks for the restore and rank b does not (the setup decision and the Resume exchange both use it)
+static void gdakiRsWhyRequestDiffers(char* why, size_t whyLen, int a, int b, uint32_t policyB) {
+  snprintf(why, whyLen, "the restore request differs across ranks (rank %d asks for it, rank %d does not: %s)", a, b,
+           policyB == GDAKI_POLICY_HOLD ? "hold with NCCL_GIN_RESTORE=0" : "failfast policy");
+}
+static int gdakiRsDecide(int n, const uint32_t* policy, const uint32_t* bits, const uint8_t* recOn, char* why,
+                         size_t whyLen) {
+  int nReq = 0, a = -1, b = -1;
+  for (int p = 0; p < n; p++) {
+    if (bits[p] & GDAKI_RS_REQ) { nReq++; if (a < 0) a = p; }
+    else if (b < 0) b = p;
+  }
+  if (nReq == 0) {
+    snprintf(why, whyLen, "the restore is not requested on any rank");
+    return GDAKI_RS_NOT_REQUESTED;
+  }
+  if (nReq < n) {  // b does not ask: fail-fast, or hold with NCCL_GIN_RESTORE=0 (a library without this layer is not
+                   // supported, 9.10.8 K16: its hold rank would read as the latter)
+    gdakiRsWhyRequestDiffers(why, whyLen, a, b, policy[b]);
+    return GDAKI_RS_REFUSE;
+  }
+  for (int p = 0; p < n; p++)
+    if (!(bits[p] & GDAKI_RS_STRICT)) {
+      snprintf(why, whyLen, "rank %d asks for the restore but does not register its GDAKI window MRs strict (a library "
+               "without the strict forcing)", p);
+      return GDAKI_RS_REFUSE_FATAL;
+    }
+  for (int p = 0; p < n; p++)
+    if (!recOn[p]) {
+      snprintf(why, whyLen, "transparent recovery is off on rank %d", p);
+      return GDAKI_RS_REFUSE;
+    }
+  for (int p = 0; p < n; p++)
+    if (bits[p] & GDAKI_RS_SPARE) {
+      snprintf(why, whyLen, "rank %d runs as a spare process (NCCL_GIN_RESTORE_SPARE) inside a live setup", p);
+      return GDAKI_RS_REFUSE;
+    }
+  static const struct { uint32_t bit; const char* text; } facts[] = {
+    {GDAKI_RS_GINTYPE, "NCCL_GIN_TYPE is not 3 (the restore needs the GDAKI backend only)"},
+    {GDAKI_RS_RMA, "NCCL_RMA_DISABLE is not set (the host RMA proxy would connect outside the GIN setup)"},
+    {GDAKI_RS_SYMGIN, "NCCL_SYM_GIN_KERNELS_ENABLE is not 0 (NCCL's symmetric kernels would make their own GIN devComm)"},
+    {GDAKI_RS_STRIDE, "the devComm's GIN rank stride is above 1 (its contexts do not reach every rank)"},
+  };
+  for (const auto& f : facts)
+    for (int p = 0; p < n; p++)
+      if (bits[p] & f.bit) {
+        snprintf(why, whyLen, "%s on rank %d", f.text, p);
+        return GDAKI_RS_REFUSE;
+      }
+  snprintf(why, whyLen, "every rank asks for the restore and meets its conditions");
+  return GDAKI_RS_ENABLE;
+}
+
+// ---- ncclGinRestoreResume (work package 2; user decision 2026-10-12, EXPERIMENT.md 9.10.8) ----
+// Resume is a call every rank of the communicator makes. Each rank judges locally whether it can enable the restore
+// (gdakiRsLocalCheck), puts that with its request and its setup decision into one fixed-size record, and the records are
+// all-gathered over the communicator's bootstrap; every rank then decides from the same records (gdakiRsResumeDecide).
+// What one rank sees, with the facts it is judged on. The decision adds "rank p: " to this rank's text; the text names no
+// rank of its own except inside `told` (a peer whose wait word was raised), which the record carries as it is.
+#define GDAKI_RS_ATOMIC_HCA 1  // IBV_ATOMIC_HCA of enum ibv_atomic_cap (the dev host region static_asserts it)
+struct gdakiRsLocalIn {
+  bool argsOk = true;            // devComm, step and bytes are not NULL
+  int devCommVersion = 0;        // the devComm's device-code version when it is not this library's (0: it is)
+  const char* told = nullptr;    // a fault already reached the application on this communicator (what), nullptr: none
+  bool spare = false;            // a spare process that did not replay an init transcript (work package 8: a replaying
+                                 // spare is judged like any rank)
+  int ginType = 0, nConn = 0;    // the devComm's GIN backend (3: GDAKI) and its GIN connections
+  bool commFull = true;          // the communicator's GIN connection is FULL
+  int ctxStride = 1;             // the devComm's GIN context stride (1: every rank)
+  int numRmaCtx = 0;             // host RMA contexts of the communicator
+  bool runtimeConn = true;       // runtime connect is on
+  bool nvls = false;             // NVLS is on
+  int lsaSize = 1;               // the devComm's LSA team size
+  bool symGinDevComm = false;    // NCCL's symmetric kernels have a GIN devComm on this communicator
+  bool haveSetup = false;        // this devComm's GDAKI context ran the setup with transparent recovery's variables on
+  int nUserCtx = 0;              // GDAKI contexts of this communicator that ran that setup (every user devComm, connection)
+  bool tsOn = false;             // this devComm's context still has transparent recovery on this rank
+  const char* offWhy = nullptr;  // why it went off after the setup agreement, when known
+  long long reconnect = 1;       // NCCL_GIN_TS_RECONNECT
+  long long qpwatchMs = 10;      // the QP watch period (NCCL_GIN_TS_QPWATCH_MS)
+  long long restoreMs = 20000;   // NCCL_GIN_RESTORE_MS
+  long long holdMs = 30000;      // NCCL_GIN_TS_HOLD_MS as the context uses it
+  bool lbOn = true;              // the NIC copy path is set up and self-tested
+  // work package 3: the side table and the restore buffers in the NIC copy path's MRs
+  bool sideOk = true;            // the side table was set up and its pointer written into every context
+  const char* sideWhy = nullptr; // why not
+  bool rsLbOk = true;            // the restore buffers are in the NIC copy path's MRs (and the side table read back)
+  const char* rsLbWhy = nullptr; // why not
+  int winsAfter = 0;             // user windows registered after this context (the devComm's resource window excepted)
+  int winsGone = 0;              // windows of this context's MRs deregistered since
+  bool resOk = true;             // the devComm's resource window was added to the NIC copy path's MRs (or it has none)
+  const char* resWhy = nullptr;  // why not
+  bool escalated = false;        // the round cap stopped recovery on this context
+  // work package 4: the send-side log's measurement mode (NCCL_GIN_RESTORE_LOG_MEASURE) logs from the context's start and
+  // trims outside any checkpoint: such a log does not start at a cut
+  bool logMeasure = false;
+  // user direction 2026-10-12: the program that calls Resume was compiled with NCCL_GIN_RESTORE_DEVICE (the nccl.h
+  // wrapper passes it); its kernels have the device restore path
+  bool deviceBuilt = true;
+  // work package 8: the original incarnation records its init transcript (NCCL_GIN_RESTORE_RECORD), which a spare replays;
+  // without it no spare can stand in for this rank
+  bool transcriptOk = true;
+  // work package 8: a spare's replay of the transcript was clean (no divergence, nothing past its end, no own-slot mismatch
+  // outside the allowed fields); why not
+  bool replayClean = true;
+  const char* replayWhy = nullptr;
+  // work package 9, option (b) (2026-10-12): the HCA's atomic capability (ibv_device_attr::atomic_cap); the spare's import
+  // adds signals with NIC atomics that must be atomic with the survivors' signal atomics on the same HCA
+  int atomicCap = GDAKI_RS_ATOMIC_HCA;
+  bool atomicOk = true;            // the loopback QP pair on the GIN protection domain passed its atomic self-test
+  const char* atomicWhy = nullptr; // why not
+};
+enum { GDAKI_RS_L_OK = 0 };
+// The first local condition that keeps the restore off on this rank, in a fixed order (0: none). The conditions are the
+// arming conditions of 9.10.4 that can be judged at Resume, and the facts of 9.10.8 and 9.14 (work package 2). Work package
+// 3 adds the side table, the restore buffers in the loopback MR and the user windows registered after the user context.
+static int gdakiRsLocalCheck(const struct gdakiRsLocalIn& in, char* why, size_t whyLen) {
+  int code = 0;
+#define GDAKI_RS_L(cond, ...)                 \
+  do {                                        \
+    code++;                                   \
+    if (cond) {                               \
+      snprintf(why, whyLen, __VA_ARGS__);     \
+      return code;                            \
+    }                                         \
+  } while (0)
+  GDAKI_RS_L(!in.argsOk, "ncclGinRestoreResume got a NULL devComm, step or bytes");
+  GDAKI_RS_L(in.devCommVersion != 0, "the devComm was written for device headers of another NCCL version (%d)",
+             in.devCommVersion);
+  GDAKI_RS_L(in.told != nullptr, "a fault already reached the application on this communicator (%s)", in.told);
+  GDAKI_RS_L(in.spare, "this spare process did not replay an init transcript (NCCL_GIN_RESTORE_REPLAY)");
+  GDAKI_RS_L(in.nConn <= 0, "the devComm has no GIN connection");
+  GDAKI_RS_L(in.ginType != 3, "the devComm's GIN backend is not GDAKI (type %d)", in.ginType);
+  GDAKI_RS_L(!in.commFull, "the communicator's GIN connection is not FULL");
+  GDAKI_RS_L(in.ctxStride != 1, "the devComm's GIN rank stride is %d, not 1", in.ctxStride);
+  GDAKI_RS_L(in.nConn != 1, "the devComm has %d GIN connections (NCCL_GIN_NCONNECTIONS), the restore needs one", in.nConn);
+  GDAKI_RS_L(in.numRmaCtx != 0, "host RMA is on (%d contexts; NCCL_NUM_RMA_CTX=0 turns it off)", in.numRmaCtx);
+  GDAKI_RS_L(!in.runtimeConn, "runtime connect is off (NCCL_RUNTIME_CONNECT)");
+  GDAKI_RS_L(in.nvls, "NVLS is on (NCCL_NVLS_ENABLE)");
+  GDAKI_RS_L(in.lsaSize != 1, "the devComm's LSA team has %d ranks, the restore needs 1", in.lsaSize);
+  GDAKI_RS_L(in.symGinDevComm, "NCCL's symmetric kernels made their own GIN devComm on this communicator");
+  GDAKI_RS_L(!in.haveSetup, "transparent recovery is off for this devComm (NCCL_GIN_FAULT_RECOVERY, "
+             "NCCL_GIN_FAULT_TRANSPARENT and NCCL_GIN_FAULT_CLASSIFY must be 1)");
+  GDAKI_RS_L(in.nUserCtx != 1, "the communicator has %d GDAKI contexts with transparent recovery, the restore needs one",
+             in.nUserCtx);
+  GDAKI_RS_L(!in.tsOn, "transparent recovery went off on this rank after the setup agreement (%s)",
+             in.offWhy && *in.offWhy ? in.offWhy : "the helper is not running");
+  GDAKI_RS_L(in.reconnect != 1, "NCCL_GIN_TS_RECONNECT is not 1");
+  GDAKI_RS_L(in.qpwatchMs <= 0, "the QP watch is off (NCCL_GIN_TS_QPWATCH_MS)");
+  GDAKI_RS_L(in.restoreMs <= 0 || in.restoreMs >= in.holdMs,
+             "NCCL_GIN_RESTORE_MS (%lld) is not between 0 and NCCL_GIN_TS_HOLD_MS (%lld)", in.restoreMs, in.holdMs);
+  GDAKI_RS_L(!in.lbOn, "the NIC copy path is off (its setup or self-test failed, or it was turned off)");
+  GDAKI_RS_L(!in.sideOk, "the side table is not set up on this rank (%s)", in.sideWhy ? in.sideWhy : "unknown");
+  GDAKI_RS_L(!in.rsLbOk, "the restore buffers are not in the NIC copy path (%s)", in.rsLbWhy ? in.rsLbWhy : "unknown");
+  GDAKI_RS_L(in.winsAfter > 0, "%d window(s) were registered after the devComm's GDAKI context (their rkey tables are "
+             "not in the NIC copy path)", in.winsAfter);
+  GDAKI_RS_L(in.winsGone > 0, "%d window(s) of this context's restore buffers were deregistered", in.winsGone);
+  GDAKI_RS_L(!in.resOk, "the devComm's resource window could not be added to the NIC copy path (%s)",
+             in.resWhy ? in.resWhy : "unknown");
+  GDAKI_RS_L(in.escalated, "the round cap stopped recovery on this context (NCCL_GIN_TS_ESCALATE_ROUNDS)");
+  GDAKI_RS_L(in.logMeasure, "the send-side log measurement mode is on (NCCL_GIN_RESTORE_LOG_MEASURE): the log does not "
+             "start at a checkpoint's cut");
+  GDAKI_RS_L(!in.deviceBuilt, "program not built with NCCL_GIN_RESTORE_DEVICE (its kernels have no device restore path)");
+  GDAKI_RS_L(!in.transcriptOk, "this rank does not record its init transcript (NCCL_GIN_RESTORE_RECORD): no spare could "
+             "replay it");
+  GDAKI_RS_L(!in.replayClean, "this spare's replay of the init transcript was not clean (%s)",
+             in.replayWhy ? in.replayWhy : "unknown");
+  GDAKI_RS_L(in.atomicCap < GDAKI_RS_ATOMIC_HCA, "the HCA's atomic capability is below IBV_ATOMIC_HCA (atomic_cap %d): a "
+             "restore adds the logged signals with NIC atomics", in.atomicCap);
+  GDAKI_RS_L(!in.atomicOk, "the NIC atomics of the restore are not ready on this rank (%s)",
+             in.atomicWhy ? in.atomicWhy : "unknown");
+#undef GDAKI_RS_L
+  snprintf(why, whyLen, "this rank can enable the restore");
+  return GDAKI_RS_L_OK;
+}
+
+// The layout of one allocation that holds the side table (a 128-byte header, nqp QP entries of 128 bytes) and, when any
+// QP may log (nLogged > 0), the context's one log ring of nEntries x 64 bytes (work package 4 redone 2026-10-12: one ring
+// per context, which is one per rank in a restorable communicator; descriptors only): nEntries is rounded down to a power
+// of two and bounded (64 .. 2^20), the ring starts 256-byte aligned, the whole is whole pages. Per rank:
+// pages(256-aligned(128 + 128 x nqp) + 64 x nEntries). False: too large, or more QPs than a log entry's QP field holds.
+struct gdakiRsSideLayout {
+  size_t qpOff = 0, ringsOff = 0, ringBytes = 0, bytes = 0;
+  uint32_t nEntries = 0;
+};
+static uint64_t gdakiRsPow2Floor(uint64_t v) {
+  uint64_t p = 1;
+  while (p <= v / 2) p <<= 1;
+  return p;
+}
+static bool gdakiRsSideLayoutOf(int nqp, int nLogged, long long entriesVar, struct gdakiRsSideLayout* L) {
+  if (nqp < 0 || nLogged < 0 || nLogged > nqp || (uint64_t)nqp > (uint64_t)NCCL_GIN_RS_QP_MASK + 1) return false;
+  const uint64_t e = gdakiRsPow2Floor((uint64_t)std::min<long long>(std::max<long long>(entriesVar, 64), 1LL << 20));
+  L->nEntries = nLogged > 0 ? (uint32_t)e : 0u;
+  L->qpOff = sizeof(struct ncclGinRsSide);
+  L->ringsOff = (L->qpOff + (size_t)nqp * sizeof(struct ncclGinRsQp) + 255) & ~(size_t)255;
+  L->ringBytes = (size_t)L->nEntries * sizeof(struct ncclGinRsLogEntry);
+  const unsigned long long total = (unsigned long long)L->ringsOff + (unsigned long long)L->ringBytes;
+  if (total > (1ULL << 40)) return false;
+  L->bytes = (size_t)((total + 4095) & ~4095ULL);  // whole pages (the NIC copy path registers pages)
+  return true;
+}
+
+// Resume's view of the windows of a context's collComm (work package 3): windows registered after the context (seq above
+// ctxSeq, still registered; the devComm's resource window excepted), windows the context covered that were deregistered
+// since, and the resource window, found by an address inside its range (resAddr 0: the devComm has none). res >= 0: the
+// resource window was registered after the context (Resume adds its rkey table to the NIC copy path's MRs).
+struct gdakiRsWinView {
+  uintptr_t lo, hi;
+  uint64_t seq, goneSeq;
+  bool gone;
+};
+struct gdakiRsWinCount {
+  int after = 0, goneSince = 0;
+  bool resFound = false;
+  int res = -1;
+};
+static struct gdakiRsWinCount gdakiRsCountWins(const struct gdakiRsWinView* w, int n, uint64_t ctxSeq, uintptr_t resAddr) {
+  struct gdakiRsWinCount c;
+  c.resFound = resAddr == 0;
+  for (int i = 0; i < n; i++) {
+    const bool isRes = resAddr != 0 && resAddr >= w[i].lo && resAddr < w[i].hi && !w[i].gone;
+    if (isRes) {
+      c.resFound = true;
+      if (w[i].seq > ctxSeq) c.res = i;
+    } else if (w[i].seq > ctxSeq && !w[i].gone) {
+      c.after++;
+    } else if (w[i].seq <= ctxSeq && w[i].gone && w[i].goneSeq > ctxSeq) {
+      c.goneSince++;
+    }
+  }
+  return c;
+}
+
+// One rank's record in the Resume exchange (fixed size; every rank runs the same library, 9.10.8 K16).
+#define GDAKI_RS_X_MAGIC 0x32535247u  // "GRS2"
+struct gdakiRsXRec {
+  uint32_t magic;
+  int32_t rank;
+  uint32_t req;           // 1: this process asks for the restore
+  uint32_t policy;        // GDAKI_POLICY_*
+  int32_t setupVerdict;   // this devComm's setup decision on this rank (GDAKI_RS_*), -1: none
+  int32_t localCode;      // gdakiRsLocalCheck (0: can enable)
+  char setupWhy[GDAKI_RS_WHY_LEN];
+  char localWhy[GDAKI_RS_WHY_LEN];
+};
+static_assert(sizeof(struct gdakiRsXRec) == 24 + 2 * GDAKI_RS_WHY_LEN, "the Resume exchange record has no padding");
+#define GDAKI_RS_RWHY_LEN (GDAKI_RS_WHY_LEN + 32)  // a Resume reason: a prefix ("rank p: ", "setup agreement: ") + a field
+// The decision every rank takes from the n exchanged records (no argument says which rank decides): nobody asks
+// (success, the communicator stays fail-fast); the request differs; a setup decision that refused; a rank whose local
+// judgment refuses; else the restore can be enabled. Each refusal names the lowest rank that has it.
+static int gdakiRsResumeDecide(int n, const struct gdakiRsXRec* x, char* why, size_t whyLen) {
+  for (int p = 0; p < n; p++)
+    if (x[p].magic != GDAKI_RS_X_MAGIC || x[p].rank != p) {
+      snprintf(why, whyLen, "rank %d sent no valid restore record (a different library?)", p);
+      return GDAKI_RS_REFUSE;
+    }
+  int nReq = 0, a = -1, b = -1;
+  for (int p = 0; p < n; p++) {
+    if (x[p].req) { nReq++; if (a < 0) a = p; }
+    else if (b < 0) b = p;
+  }
+  if (nReq == 0) {
+    snprintf(why, whyLen, "the restore is not requested on any rank");
+    return GDAKI_RS_NOT_REQUESTED;
+  }
+  if (nReq < n) {
+    gdakiRsWhyRequestDiffers(why, whyLen, a, b, x[b].policy);
+    return GDAKI_RS_REFUSE;
+  }
+  for (int p = 0; p < n; p++)
+    if (x[p].setupVerdict == GDAKI_RS_REFUSE || x[p].setupVerdict == GDAKI_RS_REFUSE_FATAL) {
+      snprintf(why, whyLen, "setup agreement: %.*s", (int)sizeof(x[p].setupWhy), x[p].setupWhy);
+      return GDAKI_RS_REFUSE;
+    }
+  for (int p = 0; p < n; p++)
+    if (x[p].localCode != GDAKI_RS_L_OK) {
+      snprintf(why, whyLen, "rank %d: %.*s", p, (int)sizeof(x[p].localWhy), x[p].localWhy);
+      return GDAKI_RS_REFUSE;
+    }
+  snprintf(why, whyLen, "every rank asks for the restore and can enable it");
+  return GDAKI_RS_ENABLE;
+}
+
+// The exchange with a bound: exchange() runs on the calling thread; if it has not returned after ms milliseconds, a
+// watcher thread calls abortFn() once, which must make exchange() return (the communicator's abort flag ends the bootstrap
+// socket loops). *expired tells whether the bound passed; ms <= 0: no bound. Returns exchange()'s result.
+template <typename X, typename A>
+static int gdakiRsRunBounded(X exchange, A abortFn, long long ms, bool* expired) {
+  *expired = false;
+  if (ms <= 0) return exchange();
+  std::mutex mu;
+  std::condition_variable cv;
+  bool done = false;
+  std::thread watcher([&] {
+    std::unique_lock<std::mutex> lk(mu);
+    if (!cv.wait_for(lk, std::chrono::milliseconds(ms), [&] { return done; })) {
+      *expired = true;  // decided under the lock: the caller reads it after the join
+      abortFn();
+    }
+  });
+  const int rc = exchange();
+  {
+    std::lock_guard<std::mutex> lk(mu);
+    done = true;
+  }
+  cv.notify_all();
+  watcher.join();
+  return rc;
+}
+// Work package 4: NCCL_GIN_RESTORE_CHECKSUM (off, sampled, full or 0, 1, 2; unset: off). False: another value (off then).
+static bool gdakiRsCsumSchemeOf(const char* v, uint32_t* scheme) {
+  *scheme = NCCL_GIN_RS_CSUM_OFF;
+  if (v == nullptr || *v == '\0' || strcmp(v, "off") == 0 || strcmp(v, "0") == 0) return true;
+  if (strcmp(v, "sampled") == 0 || strcmp(v, "1") == 0) {
+    *scheme = NCCL_GIN_RS_CSUM_SAMPLED;
+    return true;
+  }
+  if (strcmp(v, "full") == 0 || strcmp(v, "2") == 0) {
+    *scheme = NCCL_GIN_RS_CSUM_FULL;
+    return true;
+  }
+  return false;
+}
+static const char* gdakiRsCsumName(uint32_t s) {
+  return s == NCCL_GIN_RS_CSUM_SAMPLED ? "sampled" : s == NCCL_GIN_RS_CSUM_FULL ? "full" : "off";
+}
+// What a copy of the side table's QP entries says (the readout when a context ends; the ring's head, tail and overflow
+// count are in the header): over all QPs, the request messages and the gets refused under a suppress budget; over the QPs
+// that may log, how many there are, their overflowed operations and how many QPs overflowed.
+struct gdakiRsSums {
+  int logged = 0, ovfQps = 0, getRefused = 0;
+  uint64_t msgs = 0, ovfOps = 0;
+};
+static struct gdakiRsSums gdakiRsSumsOf(const struct ncclGinRsQp* q, int nqp, const uint8_t* logged) {
+  struct gdakiRsSums s;
+  for (int i = 0; i < nqp; i++) {
+    s.msgs += q[i].msgs;
+    if (q[i].getRefused) s.getRefused++;
+    if (!logged[i]) continue;
+    s.logged++;
+    s.ovfOps += q[i].ovfCount;
+    if (q[i].ovfCount != 0) s.ovfQps++;
+  }
+  return s;
+}
+// ---- gin-restore: pure functions (end) ----
+
+// ---- gin-restore (dev): log, suppress and replay, pure (begin; impl/rs_unit_dev.cc compiles this region on the CPU) ----
+// Work package 6 (EXPERIMENT.md 9.4, 9.5; impl/rs_log_api.h): the sender's host state of its one log ring per context.
+// The "covered" mark of an entry (user decision 2026-10-12: the peers' different checkpoint times are erased by marking
+// entries) is kept here, not in device memory: the device never reads it, a mark written over the NIC would cost a WQE per
+// entry and could race with the device writing the next slot. An entry at position s of QP q is covered when s is below
+// q's cut (the head read at the pause of the peer's checkpoint that the log is kept from), or always while q's log is
+// broken past its last pause (an overflow after it: until the next pause). The identity word read from a slot says which
+// QP's entry it is. The tail moves over covered entries in position order and stops at the first entry that is not
+// covered, or at a slot whose identity word is not yet its position's (an entry of another peer still being written: a
+// pause quiesces one peer's QPs only). All of it runs on the helper thread, except the atomics (any thread).
+// Assumption (review of work package 6, note 5): an entry the tail may pass without its peer's pause (a QP that covers all
+// after a break, or one whose logOn landed in a failed pause) may show its identity word before its other seven words; its
+// slot is reused only n reservations later, which no single store window spans in practice.
+struct gdakiRsPauseSnap {     // what a pause toward a peer read, per QP
+  uint64_t head = 0, ovf = 0, gets = 0;
+  bool valid = false;
+};
+struct gdakiRsLogQpState {
+  bool logs = false;       // a pause set this QP's logOn: its operations are logged
+  bool stable = false;     // `cut` is a stable checkpoint's pause head (the log since it is complete so far)
+  bool coverAll = false;   // an overflow after the last pause: every entry is covered until the next pause
+  bool getReported = false;  // a get since the stable cut was reported (once per cut)
+  uint64_t cut = 0;        // entries below it are covered
+  uint64_t ovfAtCut = 0;   // the device's overflow count of the QP at the pause of `cut`
+  uint64_t getsAtCut = 0;  // its get count then
+  uint64_t ovfSeen = 0;    // the last overflow count read
+  struct gdakiRsPauseSnap last;  // the latest pause toward the peer
+  std::vector<std::pair<uint64_t, uint64_t>> msgsAt;  // work package 9: (head, M) of each pause from the cut on
+};
+struct gdakiRsLogState {
+  uint32_t n = 0;          // ring entries (a power of two)
+  int nqp = 0, nranks = 1;
+  uint64_t tail = 0;       // the tail this host last wrote to the device
+  std::vector<uint64_t> slotId;  // per slot: the identity word last read there (~0: none)
+  std::vector<struct gdakiRsLogQpState> qp;
+  std::atomic<uint64_t> coveredUpTo{~0ull};  // every logged entry below it is covered (any thread)
+  std::atomic<uint64_t> samples{0}, occSum{0}, occMax{0}, trims{0}, blockedPending{0}, headSeen{0}, tailNow{0},
+    trimErrors{0};
+};
+static void gdakiRsLogStateInit(struct gdakiRsLogState* L, uint32_t n, int nqp, int nranks) {
+  L->n = n;
+  L->nqp = nqp > 0 ? nqp : 0;
+  L->nranks = nranks > 0 ? nranks : 1;
+  L->tail = 0;
+  L->slotId.assign(n, ~0ull);
+  L->qp.assign((size_t)L->nqp, gdakiRsLogQpState());
+  L->coveredUpTo.store(~0ull, std::memory_order_release);
+}
+// Work package 9: the message count M of each pause from the cut on (the export checks its entries against M at its cut,
+// review of work package 6, note 6). At most 1024 pauses are kept (an export from an older one is refused).
+static void gdakiRsLogQpPruneMsgs(struct gdakiRsLogQpState& q) {
+  size_t k = 0;
+  while (k < q.msgsAt.size() && q.msgsAt[k].first < q.cut) k++;
+  if (k != 0) q.msgsAt.erase(q.msgsAt.begin(), q.msgsAt.begin() + (long)k);
+}
+static void gdakiRsLogQpNoteMsgs(struct gdakiRsLogQpState& q, uint64_t head, uint64_t msgs) {
+  if (!q.msgsAt.empty() && q.msgsAt.back().first == head) q.msgsAt.back().second = msgs;
+  else q.msgsAt.emplace_back(head, msgs);
+  if (q.msgsAt.size() > 1024) q.msgsAt.erase(q.msgsAt.begin());
+  gdakiRsLogQpPruneMsgs(q);
+}
+static bool gdakiRsLogStateMsgsAt(const struct gdakiRsLogState* L, int qpIdx, uint64_t head, uint64_t* msgs) {
+  if (qpIdx < 0 || qpIdx >= L->nqp) return false;
+  for (const auto& h : L->qp[(size_t)qpIdx].msgsAt)
+    if (h.first == head) {
+      *msgs = h.second;
+      return true;
+    }
+  return false;
+}
+static bool gdakiRsLogQpCovers(const struct gdakiRsLogQpState& q, uint64_t pos) {
+  return !q.logs || q.coverAll || pos < q.cut;
+}
+// max(tail, the lowest cut over the QPs whose log is kept): every logged entry below it is covered (~0: no QP keeps a log).
+static uint64_t gdakiRsLogStateCoveredOf(const struct gdakiRsLogState* L) {
+  uint64_t m = ~0ull;
+  for (const auto& q : L->qp)
+    if (q.logs && !q.coverAll && q.cut < m) m = q.cut;
+  return m == ~0ull ? m : (m > L->tail ? m : L->tail);
+}
+static void gdakiRsLogStatePublish(struct gdakiRsLogState* L) {
+  L->coveredUpTo.store(gdakiRsLogStateCoveredOf(L), std::memory_order_release);
+  L->tailNow.store(L->tail, std::memory_order_release);
+}
+// A QP's log lost an operation (its overflow count passed the count at its cut's pause): keep what can be kept. If the
+// latest pause came after its cut and nothing overflowed since that pause, the log is good from that pause on: cover below
+// its head and wait for that checkpoint's stability. Else cover everything until the next pause.
+static void gdakiRsLogQpBreak(struct gdakiRsLogQpState& q, uint64_t ovfNow) {
+  q.stable = false;
+  if (q.last.valid && q.last.head >= q.cut && q.last.ovf == ovfNow) {
+    q.cut = q.last.head;
+    q.ovfAtCut = q.last.ovf;
+    q.getsAtCut = q.last.gets;
+    q.coverAll = false;
+    gdakiRsLogQpPruneMsgs(q);
+  } else {
+    q.coverAll = true;
+    q.msgsAt.clear();
+  }
+}
+// A pause toward a peer (its QPs `qps`, n of them, quiesced; the caller has set their logOn): the head and the QPs'
+// overflow, get and message counts as read then. A QP that did not log starts its log at the head; a QP whose log was
+// broken past its last pause restarts at the head. Returns how many QPs started their log now.
+static int gdakiRsLogStateNotePause(struct gdakiRsLogState* L, const int* qps, int n, uint64_t head, const uint64_t* ovf,
+                                    const uint64_t* gets, const uint64_t* msgs) {
+  int started = 0;
+  for (int k = 0; k < n; k++) {
+    if (qps[k] < 0 || qps[k] >= L->nqp) continue;
+    struct gdakiRsLogQpState& q = L->qp[(size_t)qps[k]];
+    if (ovf[k] > q.ovfSeen) q.ovfSeen = ovf[k];
+    if (!q.logs || q.coverAll) {
+      if (!q.logs) started++;
+      q.logs = true;
+      q.coverAll = false;
+      q.stable = false;
+      q.cut = head;  // entries before it: none (not logged) or useless (the break)
+      q.ovfAtCut = ovf[k];
+      q.getsAtCut = gets[k];
+      q.getReported = false;
+      q.msgsAt.clear();
+    }
+    gdakiRsLogQpNoteMsgs(q, head, msgs[k]);
+    q.last.head = head;
+    q.last.ovf = ovf[k];
+    q.last.gets = gets[k];
+    q.last.valid = true;
+  }
+  gdakiRsLogStatePublish(L);
+  return started;
+}
+// The checkpoint taken at a pause (its per-QP snapshots `at`, as gdakiRsLogStateNotePause got them) is stable now:
+// each QP's entries below that pause's head are covered, unless the QP overflowed after that pause (ovfNow above the
+// pause's count: its log since there lost an operation; the break rule above). A stable of an older pause than the cut
+// (a later checkpoint already moved the cut) changes nothing. Returns how many QPs broke now.
+static int gdakiRsLogStateNoteStable(struct gdakiRsLogState* L, const int* qps, int n, const struct gdakiRsPauseSnap* at,
+                                     const uint64_t* ovfNow) {
+  int broke = 0;
+  for (int k = 0; k < n; k++) {
+    if (qps[k] < 0 || qps[k] >= L->nqp) continue;
+    struct gdakiRsLogQpState& q = L->qp[(size_t)qps[k]];
+    if (ovfNow[k] > q.ovfSeen) q.ovfSeen = ovfNow[k];
+    if (!q.logs || !at[k].valid || q.coverAll || at[k].head < q.cut) continue;
+    if (ovfNow[k] > at[k].ovf) {
+      gdakiRsLogQpBreak(q, ovfNow[k]);
+      broke++;
+      continue;
+    }
+    q.cut = at[k].head;
+    q.ovfAtCut = at[k].ovf;
+    q.getsAtCut = at[k].gets;
+    q.stable = true;
+    q.getReported = false;
+    gdakiRsLogQpPruneMsgs(q);
+  }
+  gdakiRsLogStatePublish(L);
+  return broke;
+}
+// The periodic poll's counts of one QP: true once per break when the QP's log lost an operation since its cut (the caller
+// DISARMs its peer); *gotGet once per cut when a get with data was posted on it since its stable cut's pause.
+static bool gdakiRsLogStateNoteCounts(struct gdakiRsLogState* L, int qpIdx, uint64_t ovfNow, uint64_t getsNow,
+                                      bool* gotGet) {
+  *gotGet = false;
+  if (qpIdx < 0 || qpIdx >= L->nqp) return false;
+  struct gdakiRsLogQpState& q = L->qp[(size_t)qpIdx];
+  bool broke = false;
+  if (ovfNow > q.ovfSeen) q.ovfSeen = ovfNow;
+  // checked whoever saw the count first (a pause or a stable raises ovfSeen too): once per break, as QpBreak covers all
+  // or moves the cut and its count to the last pause's (review of work package 6, finding 1)
+  if (q.logs && !q.coverAll && ovfNow > q.ovfAtCut) {
+    gdakiRsLogQpBreak(q, ovfNow);
+    broke = true;
+  }
+  if (q.logs && q.stable && !q.getReported && getsNow > q.getsAtCut) {
+    q.getReported = true;
+    *gotGet = true;
+  }
+  if (broke) gdakiRsLogStatePublish(L);
+  return broke;
+}
+// Whether the peer's log is complete since its stable cut: every QP to it that logs has a stable cut and no break, no get
+// since that cut, and at least one QP logs.
+static bool gdakiRsLogStateComplete(const struct gdakiRsLogState* L, int peer) {
+  bool any = false;
+  for (int i = peer; i >= 0 && i < L->nqp; i += L->nranks) {
+    const struct gdakiRsLogQpState& q = L->qp[(size_t)i];
+    if (!q.logs) continue;
+    any = true;
+    if (!q.stable || q.coverAll || q.getReported) return false;
+  }
+  return any;
+}
+// The tail's advance from L->tail toward `head`: readIds(from, to, ids) fills the identity words of positions [from, to)
+// (one read of whole entries, to - from <= chunk, never across the ring's end) and returns false on a failed read. The
+// tail stops at the first slot whose identity is not its position's (still being written) or whose entry is not covered.
+// Sets L->tail to the new tail (the caller writes it to the device) and returns it.
+template <typename R>
+static uint64_t gdakiRsLogStateAdvance(struct gdakiRsLogState* L, uint64_t head, uint64_t chunk, R readIds,
+                                       bool* readFailed) {
+  *readFailed = false;
+  uint64_t t = L->tail;
+  std::vector<uint64_t> ids;
+  if (chunk == 0) chunk = 1;
+  while (t < head) {
+    const uint64_t slot = t & (uint64_t)(L->n - 1);
+    if (!ncclGinRsIdIs(L->slotId[(size_t)slot], t) ||
+        (uint32_t)(L->slotId[(size_t)slot] >> 32) == ~0u) {  // not read yet, or read before it was written: read from t
+      uint64_t e = head < t + chunk ? head : t + chunk;
+      const uint64_t wrap = t + (L->n - slot);
+      if (e > wrap) e = wrap;
+      ids.assign((size_t)(e - t), ~0ull);
+      if (!readIds(t, e, ids.data())) {
+        *readFailed = true;
+        break;
+      }
+      for (uint64_t p = t; p < e; p++) L->slotId[(size_t)(p & (uint64_t)(L->n - 1))] = ids[(size_t)(p - t)];
+      if (!ncclGinRsIdIs(L->slotId[(size_t)slot], t)) {
+        L->blockedPending.fetch_add(1, std::memory_order_relaxed);
+        break;
+      }
+    }
+    const uint32_t qpIdx = ncclGinRsEntryQp((uint32_t)(L->slotId[(size_t)slot] >> 32));
+    if (qpIdx >= (uint32_t)L->nqp || !gdakiRsLogQpCovers(L->qp[qpIdx], t)) break;
+    t++;
+  }
+  if (t != L->tail) L->trims.fetch_add(1, std::memory_order_relaxed);
+  L->tail = t;
+  gdakiRsLogStatePublish(L);
+  return t;
+}
+// The positions of `peer`'s entries in [from, to) given the identity words of those positions (ids[i] for from + i): the
+// entries whose identity is their position's and whose QP goes to the peer.
+static std::vector<uint64_t> gdakiRsLogStatePeerPositions(const struct gdakiRsLogState* L, int peer, uint64_t from,
+                                                          uint64_t to, const uint64_t* ids) {
+  std::vector<uint64_t> out;
+  for (uint64_t p = from; p < to; p++) {
+    const uint64_t id = ids[(size_t)(p - from)];
+    if (!ncclGinRsIdIs(id, p)) continue;
+    const uint32_t qpIdx = ncclGinRsEntryQp((uint32_t)(id >> 32));
+    if (qpIdx < (uint32_t)L->nqp && (int)(qpIdx % (uint32_t)L->nranks) == peer) out.push_back(p);
+  }
+  return out;
+}
+// Whether the peer's entries from position `from` on are all kept and complete (the export to its spare, 9.6): for each
+// of its QPs (qps, n; their overflow and get counts read now), the QP logs, its entries are not all covered, `from` is at or
+// above its cut (a checkpoint the survivor confirmed but whose CKPT_STABLE it did not get has a later cut than the stable
+// one: its entries are kept too), and nothing was lost nor a get posted since that cut. False: why.
+static bool gdakiRsLogStateCanExport(const struct gdakiRsLogState* L, const int* qps, int n, uint64_t from,
+                                     const uint64_t* ovfNow, const uint64_t* getsNow, char* why, size_t whyLen) {
+  if (n <= 0) {
+    snprintf(why, whyLen, "no QP to the peer");
+    return false;
+  }
+  for (int k = 0; k < n; k++) {
+    if (qps[k] < 0 || qps[k] >= L->nqp) {
+      snprintf(why, whyLen, "qp %d is outside the side table", qps[k]);
+      return false;
+    }
+    const struct gdakiRsLogQpState& q = L->qp[(size_t)qps[k]];
+    if (!q.logs) snprintf(why, whyLen, "qp %d does not log (no pause toward the peer yet)", qps[k]);
+    else if (q.coverAll) snprintf(why, whyLen, "qp %d lost an operation (ring full) since its last pause", qps[k]);
+    else if (from < q.cut) snprintf(why, whyLen, "qp %d keeps entries from position %lu only, not %lu", qps[k],
+                                    (unsigned long)q.cut, (unsigned long)from);
+    else if (ovfNow[k] != q.ovfAtCut) snprintf(why, whyLen, "qp %d lost an operation (ring full) since its cut", qps[k]);
+    else if (getsNow[k] != q.getsAtCut) snprintf(why, whyLen, "qp %d posted a get to the peer since its cut", qps[k]);
+    else continue;
+    return false;
+  }
+  return true;
+}
+// The highest step whose head (read at ncclGinRestoreStep) is covered, over n (step, head) pairs; `none` if none.
+static uint64_t gdakiRsStableStepOf(const uint64_t* steps, const uint64_t* heads, int n, uint64_t coveredUpTo,
+                                    uint64_t none) {
+  uint64_t best = none;
+  for (int i = 0; i < n; i++)
+    if (heads[i] <= coveredUpTo && (best == none || steps[i] > best)) best = steps[i];
+  return best;
+}
+// ---- work package 9 (EXPERIMENT.md 9.3, 9.6, 9.11.3 M2; impl/rs_log_api.h): the executed counts, the suppress budget,
+// the log export's stream and the spare's import plan; nothing here needs the spare's endpoints or the hold state ----
+// The cumulative responder executed count of one QP (RL13): a QP's responder MSN is 24 bits and restarts with each
+// incarnation's connection (2RST may or may not zero it: gdakiTsBaseline takes what it reads as rmsn0). Every rmsn read
+// of the QP (G7's watch sample, gdakiTsExecuted, gdakiRsExecRead) adds (rmsn - last) mod 2^24; a Baseline after a Commit
+// restarts `last` at the new rmsn0 without a step. More than 2^23 messages between two reads of one QP would be lost (the
+// watch reads every NCCL_GIN_TS_QPWATCH_MS; EXPERIMENT.md 9.11.3 V14: an arming limit).
+struct gdakiRsExecQp {
+  bool on = false;
+  uint32_t last = 0;  // the last rmsn read (24 bits)
+  uint64_t cum = 0;   // messages executed since the context started (or since the base a spare was given)
+  bool bad = false;   // a read was lost (gdakiRsExecInvalidate): the count is not used again
+};
+static void gdakiRsExecStepQp(struct gdakiRsExecQp& e, uint32_t rmsn) {
+  rmsn &= 0xffffffu;
+  if (e.on) e.cum += (uint64_t)((rmsn - e.last) & 0xffffffu);
+  e.on = true;
+  e.last = rmsn;
+}
+static void gdakiRsExecRebaseQp(struct gdakiRsExecQp& e, uint32_t rmsn0) {
+  e.on = true;
+  e.last = rmsn0 & 0xffffffu;
+}
+// The suppress budget of one QP of the spare (9.6): B = X - P (X: the survivor's cumulative executed count of the dead
+// rank's messages at the hold start, P: the same count at the checkpoint's pause). X < P cannot happen with one consistent
+// count: refused.
+static bool gdakiRsBudgetOf(uint64_t x, uint64_t p, uint64_t* b) {
+  if (x < p) return false;
+  *b = x - p;
+  return true;
+}
+// An entry the spare can apply: a known kind; a put names its target and source windows and moves at most 1 TiB; a
+// putValue names its target and holds 1..8 bytes; a signal alone carries its signal flag.
+static const char* gdakiRsEntryCheck(const struct ncclGinRsLogEntry& e) {
+  const uint32_t kind = ncclGinRsEntryKind(e.qpKf), flags = ncclGinRsEntryFlags(e.qpKf);
+  const bool sig = (flags & NCCL_GIN_RS_LOGF_SIGNAL) != 0;
+  if (kind == NCCL_GIN_RS_LOG_PUT) {
+    if (e.dstWin == 0 || e.srcWin == 0) return "a put entry without its window numbers";
+    if (e.bytes > (1ull << 40)) return "a put entry larger than 1 TiB";
+  } else if (kind == NCCL_GIN_RS_LOG_PUTVALUE) {
+    if (e.dstWin == 0) return "a putValue entry without its window number";
+    if (e.bytes == 0 || e.bytes > 8) return "a putValue entry whose value is not 1 to 8 bytes";
+  } else if (kind == NCCL_GIN_RS_LOG_SIGNAL) {
+    if (!sig) return "a signal entry without its signal";
+  } else {
+    return "an entry of an unknown kind";
+  }
+  return nullptr;
+}
+// The checksum scheme an entry's data was counted with (OFF: none, or no source address on the device).
+static uint32_t gdakiRsEntryCsumScheme(uint32_t qpKf) {
+  const uint32_t f = ncclGinRsEntryFlags(qpKf);
+  if (ncclGinRsEntryKind(qpKf) != NCCL_GIN_RS_LOG_PUT || (f & NCCL_GIN_RS_LOGF_NOBASE) != 0) return NCCL_GIN_RS_CSUM_OFF;
+  return (f >> NCCL_GIN_RS_LOGF_CSUM_SHIFT) & 3u;
+}
+// The checksum of a put's data counted in chunks (the survivor's helper reads the source over the NIC copy path into its
+// staging buffer, a chunk at a time): the same words and lanes as ncclGinRsCsumWalk, words counted from the data's first
+// byte. A chunk starts at a multiple of 4 bytes of the data and ends at one, or at the data's end; the caller adds every
+// chunk once, in any order, then calls ncclGinRsCsumFinal(a, b, bytes, scheme). False: a chunk that breaks the rule.
+static bool gdakiRsCsumPicked(uint32_t scheme, uint64_t j, uint64_t nWords) {
+  return scheme == NCCL_GIN_RS_CSUM_FULL || (scheme == NCCL_GIN_RS_CSUM_SAMPLED && ((j & 1023) < 16 || j + 16 >= nWords));
+}
+static bool gdakiRsCsumChunk(uint32_t scheme, uint64_t bytes, uint64_t off, const uint8_t* p, uint64_t len, uint32_t& a,
+                             uint32_t& b) {
+  if ((off & 3) != 0 || len > bytes || off > bytes - len || ((len & 3) != 0 && off + len != bytes)) return false;
+  const uint64_t nWords = (bytes + 3) >> 2;
+  for (uint64_t j = off >> 2; 4 * j < off + len; j++) {
+    if (!gdakiRsCsumPicked(scheme, j, nWords)) continue;
+    uint32_t u = 0;
+    for (uint64_t k = 0; k < 4 && 4 * j + k < bytes; k++) u |= (uint32_t)p[4 * j + k - off] << (8 * k);
+    ncclGinRsCsumStep(u, j, a, b);
+  }
+  return true;
+}
+// The export's stream (impl/rs_log_api.h): the header, then per entry the entry and a put's data, then the trailer.
+// read(entry, off, len, &bad) returns the address of the put's bytes [off, off + len) (len at most `chunk`, rounded down
+// to a multiple of 4) or null with *bad set; put(p, n) writes and returns false when the stream failed. A put's data is
+// counted again with the entry's scheme and compared with its checksum. A mismatch or a failed read ends the stream there
+// with the trailer's ok = 0 (the receiver reads the trailer first and applies nothing). Returns GDAKI_RS_LOGX_OK, _REFUSED
+// (the stream is whole, its trailer says why) or _STREAM (put failed: the stream is cut).
+enum { GDAKI_RS_LOGX_OK = 0, GDAKI_RS_LOGX_REFUSED = 1, GDAKI_RS_LOGX_STREAM = 2 };
+template <typename Read, typename Put>
+static int gdakiRsLogXBuild(const struct gdakiRsLogXHdr& hdr, const struct ncclGinRsLogEntry* e, size_t n, uint64_t chunk,
+                            Read read, Put put, char* why, size_t whyLen) {
+  struct gdakiRsLogXEnd end;
+  memset(&end, 0, sizeof(end));
+  end.magic = GDAKI_RS_LOGX_MAGIC;
+  end.ok = 1;
+  chunk &= ~(uint64_t)3;
+  if (chunk == 0) chunk = 4;
+  auto cut = [&]() {
+    snprintf(why, whyLen, "the stream failed");
+    return GDAKI_RS_LOGX_STREAM;
+  };
+  if (!put(&hdr, sizeof(hdr))) return cut();
+  for (size_t i = 0; i < n && end.ok; i++) {
+    if (!put(&e[i], sizeof(e[i]))) return cut();
+    if (ncclGinRsEntryKind(e[i].qpKf) != NCCL_GIN_RS_LOG_PUT || e[i].bytes == 0) continue;
+    const uint32_t scheme = gdakiRsEntryCsumScheme(e[i].qpKf);
+    uint32_t a = 0, b = 0;
+    for (uint64_t off = 0; off < e[i].bytes; off += chunk) {
+      const uint64_t len = std::min<uint64_t>(chunk, e[i].bytes - off);
+      const char* bad = nullptr;
+      const uint8_t* p = read(e[i], off, len, &bad);
+      if (p == nullptr) {
+        end.ok = 0;
+        snprintf(end.why, sizeof(end.why), "entry %zu: %s", i, bad ? bad : "its source could not be read");
+        break;
+      }
+      if (scheme != NCCL_GIN_RS_CSUM_OFF) (void)gdakiRsCsumChunk(scheme, e[i].bytes, off, p, len, a, b);
+      if (!put(p, (size_t)len)) return cut();
+    }
+    if (end.ok && scheme != NCCL_GIN_RS_CSUM_OFF && ncclGinRsCsumFinal(a, b, e[i].bytes, scheme) != e[i].csum) {
+      end.ok = 0;
+      snprintf(end.why, sizeof(end.why), "source buffer changed (entry %zu, window %u, offset %lu, %lu bytes)", i,
+               e[i].srcWin, (unsigned long)e[i].src, (unsigned long)e[i].bytes);
+    }
+  }
+  if (!put(&end, sizeof(end))) return cut();
+  if (!end.ok) {
+    snprintf(why, whyLen, "%.*s", (int)sizeof(end.why), end.why);
+    return GDAKI_RS_LOGX_REFUSED;
+  }
+  return GDAKI_RS_LOGX_OK;
+}
+// The export's message check (review of work package 6, note 6): per QP k of the peer (qps[k], GIN-context order), the
+// request messages its entries post equal M at the hold start minus M at the cut's pause. An entry lost or not yet
+// written shows as a smaller sum.
+static bool gdakiRsLogXMsgsCheck(const struct ncclGinRsLogEntry* e, size_t n, const int* qps, int nqp,
+                                 const uint64_t* mHold, const uint64_t* mCut, char* why, size_t whyLen) {
+  for (int k = 0; k < nqp; k++) {
+    uint64_t sum = 0;
+    for (size_t i = 0; i < n; i++)
+      if ((int)ncclGinRsEntryQp(e[i].qpKf) == qps[k]) sum += ncclGinRsEntryMsgs(e[i].qpKf, e[i].bytes);
+    if (mHold[k] < mCut[k] || sum != mHold[k] - mCut[k]) {
+      snprintf(why, whyLen, "qp %d: its entries since the cut post %lu messages, the counts say %lu - %lu", qps[k],
+               (unsigned long)sum, (unsigned long)mHold[k], (unsigned long)mCut[k]);
+      return false;
+    }
+  }
+  return true;
+}
+// The stream parsed and checked without applying anything (the spare checks every survivor's export first). The trailer
+// is read first: a survivor's refusal is reported as such.
+struct gdakiRsLogXItem {
+  struct ncclGinRsLogEntry e;
+  size_t dataOff = 0;  // a put's data in the stream (0: none)
+};
+struct gdakiRsLogXParsed {
+  struct gdakiRsLogXHdr hdr;
+  struct gdakiRsLogXEnd end;
+  std::vector<struct gdakiRsLogXItem> items;
+};
+static bool gdakiRsLogXParse(const uint8_t* p, size_t n, struct gdakiRsLogXParsed* out, char* why, size_t whyLen) {
+  out->items.clear();
+  if (p == nullptr || n < sizeof(struct gdakiRsLogXHdr) + sizeof(struct gdakiRsLogXEnd)) {
+    snprintf(why, whyLen, "the export is shorter than its header and trailer (%zu bytes)", n);
+    return false;
+  }
+  memcpy(&out->hdr, p, sizeof(out->hdr));
+  const size_t endOff = n - sizeof(struct gdakiRsLogXEnd);
+  memcpy(&out->end, p + endOff, sizeof(out->end));
+  if (out->hdr.magic != GDAKI_RS_LOGX_MAGIC || out->hdr.version != 1 || out->end.magic != GDAKI_RS_LOGX_MAGIC) {
+    snprintf(why, whyLen, "the export's header or trailer is not one");
+    return false;
+  }
+  if (out->hdr.nqp == 0 || out->hdr.nqp > NCCL_GIN_RECOVERY_MAX_QPS || out->hdr.head < out->hdr.cut ||
+      out->hdr.nEntries > out->hdr.head - out->hdr.cut) {
+    snprintf(why, whyLen, "the export's header is out of range (nqp %u, cut %lu, head %lu, entries %lu)", out->hdr.nqp,
+             (unsigned long)out->hdr.cut, (unsigned long)out->hdr.head, (unsigned long)out->hdr.nEntries);
+    return false;
+  }
+  if (out->end.ok != 1) {
+    snprintf(why, whyLen, "the survivor refused its export: %.*s", (int)sizeof(out->end.why), out->end.why);
+    return false;
+  }
+  size_t off = sizeof(struct gdakiRsLogXHdr);
+  for (uint64_t i = 0; i < out->hdr.nEntries; i++) {
+    struct gdakiRsLogXItem it;
+    if (endOff - off < sizeof(it.e)) {
+      snprintf(why, whyLen, "the export ends inside entry %lu", (unsigned long)i);
+      return false;
+    }
+    memcpy(&it.e, p + off, sizeof(it.e));
+    off += sizeof(it.e);
+    const char* bad = gdakiRsEntryCheck(it.e);
+    if (bad != nullptr) {
+      snprintf(why, whyLen, "entry %lu: %s", (unsigned long)i, bad);
+      return false;
+    }
+    if (ncclGinRsEntryKind(it.e.qpKf) == NCCL_GIN_RS_LOG_PUT && it.e.bytes != 0) {
+      if (it.e.bytes > (uint64_t)(endOff - off)) {
+        snprintf(why, whyLen, "the export ends inside the data of entry %lu", (unsigned long)i);
+        return false;
+      }
+      it.dataOff = off;
+      off += (size_t)it.e.bytes;
+    }
+    out->items.push_back(it);
+  }
+  if (off != endOff) {
+    snprintf(why, whyLen, "%zu bytes between the last entry and the trailer", endOff - off);
+    return false;
+  }
+  return true;
+}
+// The spare's import plan (9.6), every export checked before anything is applied. nqpOf[q]: this rank's QPs to rank q
+// (0: no GIN QP, this rank included); an export is expected from every rank with QPs and from no other. P per QP of each
+// survivor (pp: the checkpoint's PAUSED counts, impl/rs_ckpt_api.h's gdakiCkptPeerP in neutral form); wins: this
+// process's windows on the context's collComm by number with their sizes; sigBytes: its signal table's size. The plan:
+// the data copies (survivor rank order, then stream order: single assignment, 9.7 item 3, makes the order immaterial; it is
+// fixed so that two runs apply the same sequence), the signal additions summed per target (additive), and per survivor
+// its counts (B = X - P, X, M per QP). The copies go first, then the signals: a put or putValue whose target overlaps a
+// signal word would make the order matter, which single assignment excludes; such an import is refused.
+struct gdakiRsImportP {
+  int32_t rank;
+  uint32_t nqp;
+  const uint64_t* p;
+};
+struct gdakiRsImportWin {
+  uint32_t id;
+  uint64_t bytes;
+};
+struct gdakiRsImportCopy {
+  uint32_t win;
+  uint64_t off, bytes;
+  const uint8_t* data;  // a put's data in its export; null: a putValue (value)
+  uint64_t value;
+};
+struct gdakiRsImportSig {
+  uint32_t win;  // 0: the signal table
+  uint64_t off, add;
+};
+struct gdakiRsImportPeer {
+  int32_t rank = -1;
+  int nqp = 0;
+  uint64_t budget[NCCL_GIN_RECOVERY_MAX_QPS] = {}, x[NCCL_GIN_RECOVERY_MAX_QPS] = {}, m[NCCL_GIN_RECOVERY_MAX_QPS] = {};
+};
+struct gdakiRsImportPlan {
+  std::vector<struct gdakiRsImportCopy> copies;
+  std::vector<struct gdakiRsImportSig> sigs;
+  std::vector<struct gdakiRsImportPeer> peers;
+  uint64_t entries = 0, dataBytes = 0, sigAdds = 0;
+};
+static bool gdakiRsImportRange(uint64_t off, uint64_t n, uint64_t size) { return n <= size && off <= size - n; }
+static bool gdakiRsImportPlanOf(int me, uint64_t ckpt, uint32_t incarnation, uint64_t nonce, const int* nqpOf,
+                                int nranks, const struct gdakiRsImportP* pp, int nP,
+                                const std::vector<std::vector<uint8_t>>& exports, const struct gdakiRsImportWin* wins,
+                                int nWins, uint64_t sigBytes, struct gdakiRsImportPlan* out, char* why, size_t whyLen) {
+  *out = gdakiRsImportPlan();
+  if ((int)exports.size() > nranks) {
+    snprintf(why, whyLen, "%zu exports for %d ranks", exports.size(), nranks);
+    return false;
+  }
+  for (int i = 0; i < nWins; i++)
+    for (int j = 0; j < i; j++)
+      if (wins[i].id == wins[j].id) {
+        snprintf(why, whyLen, "two windows numbered %u", wins[i].id);
+        return false;
+      }
+  auto winBytes = [&](uint32_t id, uint64_t* bytes) {
+    for (int i = 0; i < nWins; i++)
+      if (wins[i].id == id) {
+        *bytes = wins[i].bytes;
+        return true;
+      }
+    return false;
+  };
+  std::vector<struct gdakiRsImportSig> sig;  // every addition, summed per target at the end
+  for (int q = 0; q < nranks; q++) {
+    const bool has = q < (int)exports.size() && !exports[(size_t)q].empty();
+    const int nq = q == me ? 0 : nqpOf[q];
+    if (nq <= 0) {
+      if (has) {
+        snprintf(why, whyLen, "an export from rank %d, which has no QP to this rank", q);
+        return false;
+      }
+      continue;
+    }
+    if (!has) {
+      snprintf(why, whyLen, "no log export from rank %d", q);
+      return false;
+    }
+    const std::vector<uint8_t>& x = exports[(size_t)q];
+    struct gdakiRsLogXParsed px;
+    char pw[200];
+    if (!gdakiRsLogXParse(x.data(), x.size(), &px, pw, sizeof(pw))) {
+      snprintf(why, whyLen, "rank %d's export: %s", q, pw);
+      return false;
+    }
+    const struct gdakiRsLogXHdr& h = px.hdr;
+    if (h.from != q || h.to != me || h.ckpt != ckpt || h.incarnation != incarnation || h.nonce != nonce ||
+        (int)h.nqp != nq) {
+      snprintf(why, whyLen, "rank %d's export is not for this restore (from %d, to %d, checkpoint %lu, incarnation %u, nqp "
+               "%u; expected %d, %d, %lu, %u, %d; nonce %s)", q, h.from, h.to, (unsigned long)h.ckpt, h.incarnation, h.nqp,
+               q, me, (unsigned long)ckpt, incarnation, nq, h.nonce == nonce ? "matches" : "differs");
+      return false;
+    }
+    const struct gdakiRsImportP* P = nullptr;
+    for (int i = 0; i < nP; i++)
+      if (pp[i].rank == q) {
+        if (P != nullptr) {
+          snprintf(why, whyLen, "two P records for rank %d", q);
+          return false;
+        }
+        P = &pp[i];
+      }
+    if (P == nullptr || (int)P->nqp != nq || P->p == nullptr) {
+      snprintf(why, whyLen, "no P of rank %d's %d QPs in the checkpoint", q, nq);
+      return false;
+    }
+    struct gdakiRsImportPeer pe;
+    pe.rank = q;
+    pe.nqp = nq;
+    for (int k = 0; k < nq; k++) {
+      if (!gdakiRsBudgetOf(h.x[k], P->p[k], &pe.budget[k])) {
+        snprintf(why, whyLen, "rank %d qp %d: executed %lu at the hold start, %lu at the checkpoint", q, k,
+                 (unsigned long)h.x[k], (unsigned long)P->p[k]);
+        return false;
+      }
+      pe.x[k] = h.x[k];
+      pe.m[k] = h.m[k];
+    }
+    for (size_t i = 0; i < px.items.size(); i++) {
+      const struct ncclGinRsLogEntry& e = px.items[i].e;
+      const uint32_t kind = ncclGinRsEntryKind(e.qpKf);
+      uint64_t size = 0;
+      if (kind == NCCL_GIN_RS_LOG_PUT || kind == NCCL_GIN_RS_LOG_PUTVALUE) {
+        if (!winBytes(e.dstWin, &size) || !gdakiRsImportRange(e.dstOff, e.bytes, size)) {
+          snprintf(why, whyLen, "rank %d's entry %zu: window %u offset %lu, %lu bytes is not a window of this process", q, i,
+                   e.dstWin, (unsigned long)e.dstOff, (unsigned long)e.bytes);
+          return false;
+        }
+        if (e.bytes != 0) {
+          struct gdakiRsImportCopy c;
+          c.win = e.dstWin;
+          c.off = e.dstOff;
+          c.bytes = e.bytes;
+          c.data = kind == NCCL_GIN_RS_LOG_PUT ? x.data() + px.items[i].dataOff : nullptr;
+          c.value = kind == NCCL_GIN_RS_LOG_PUT ? 0 : e.src;
+          out->copies.push_back(c);
+          out->dataBytes += e.bytes;
+        }
+      }
+      if (ncclGinRsEntryFlags(e.qpKf) & NCCL_GIN_RS_LOGF_SIGNAL) {
+        if (e.sigWin == 0) size = sigBytes;
+        else if (!winBytes(e.sigWin, &size)) size = 0;
+        if ((e.sigOff & 7) != 0 || !gdakiRsImportRange(e.sigOff, 8, size)) {
+          snprintf(why, whyLen, "rank %d's entry %zu: signal %s %u offset %lu is not in this process", q, i,
+                   e.sigWin ? "window" : "table", e.sigWin, (unsigned long)e.sigOff);
+          return false;
+        }
+        sig.push_back({e.sigWin, e.sigOff, e.sigVal});
+        out->sigAdds++;
+      }
+      out->entries++;
+    }
+    out->peers.push_back(pe);
+  }
+  std::stable_sort(sig.begin(), sig.end(), [](const struct gdakiRsImportSig& a, const struct gdakiRsImportSig& b) {
+    return a.win != b.win ? a.win < b.win : a.off < b.off;
+  });
+  // no signal word inside a data target: the data ranges per window, sorted, against every signal target
+  std::vector<struct gdakiRsImportCopy> byWin(out->copies);
+  std::sort(byWin.begin(), byWin.end(), [](const struct gdakiRsImportCopy& a, const struct gdakiRsImportCopy& b) {
+    return a.win != b.win ? a.win < b.win : a.off < b.off;
+  });
+  {
+    size_t c = 0;
+    uint64_t reach = 0;  // the furthest end of the data ranges of this window seen so far
+    uint32_t win = 0;
+    bool any = false;
+    for (const auto& g : sig) {  // both sorted by (window, offset): one pass
+      if (!any || g.win != win) {
+        win = g.win;
+        reach = 0;
+        any = true;
+        while (c < byWin.size() && byWin[c].win < win) c++;
+      }
+      while (c < byWin.size() && byWin[c].win == win && byWin[c].off < g.off + 8) {
+        reach = std::max<uint64_t>(reach, byWin[c].off + byWin[c].bytes);
+        c++;
+      }
+      if (reach > g.off) {
+        snprintf(why, whyLen, "a put's target overlaps the signal word at window %u offset %lu (single assignment)", g.win,
+                 (unsigned long)g.off);
+        return false;
+      }
+    }
+  }
+  for (const auto& s : sig) {
+    if (!out->sigs.empty() && out->sigs.back().win == s.win && out->sigs.back().off == s.off) out->sigs.back().add += s.add;
+    else out->sigs.push_back(s);
+  }
+  return true;
+}
+// The CPU-side check of the signal additions before the import posts them as NIC atomics (option (b) of review finding
+// B1, 2026-10-12): every export is parsed again and its signal values summed in a second pass, independent of the plan's
+// merge; the plan's additions must equal them per target (targets in strictly increasing order, none missing, none extra)
+// and in total (mod 2^64, as the NIC adds). *total: the sum of every signal entry's value.
+static bool gdakiRsImportSigCheck(const std::vector<std::vector<uint8_t>>& exports, const struct gdakiRsImportPlan& plan,
+                                  uint64_t* total, char* why, size_t whyLen) {
+  std::vector<struct gdakiRsImportSig> all;
+  uint64_t sum = 0;
+  for (size_t q = 0; q < exports.size(); q++) {
+    if (exports[q].empty()) continue;
+    struct gdakiRsLogXParsed px;
+    char pw[200];
+    if (!gdakiRsLogXParse(exports[q].data(), exports[q].size(), &px, pw, sizeof(pw))) {
+      snprintf(why, whyLen, "rank %zu's export: %s", q, pw);
+      return false;
+    }
+    for (const auto& it : px.items)
+      if (ncclGinRsEntryFlags(it.e.qpKf) & NCCL_GIN_RS_LOGF_SIGNAL) {
+        all.push_back({it.e.sigWin, it.e.sigOff, it.e.sigVal});
+        sum += it.e.sigVal;
+      }
+  }
+  if ((uint64_t)all.size() != plan.sigAdds) {
+    snprintf(why, whyLen, "%zu signal entries, the plan counted %lu", all.size(), (unsigned long)plan.sigAdds);
+    return false;
+  }
+  uint64_t planSum = 0;
+  for (size_t k = 0; k < plan.sigs.size(); k++) {
+    planSum += plan.sigs[k].add;
+    if (k > 0 && !(plan.sigs[k - 1].win < plan.sigs[k].win ||
+                   (plan.sigs[k - 1].win == plan.sigs[k].win && plan.sigs[k - 1].off < plan.sigs[k].off))) {
+      snprintf(why, whyLen, "the plan's signal targets are not in strictly increasing order at %zu", k);
+      return false;
+    }
+  }
+  if (planSum != sum) {
+    snprintf(why, whyLen, "the plan adds %lu in total, the entries %lu", (unsigned long)planSum, (unsigned long)sum);
+    return false;
+  }
+  std::sort(all.begin(), all.end(), [](const struct gdakiRsImportSig& a, const struct gdakiRsImportSig& b) {
+    return a.win != b.win ? a.win < b.win : a.off < b.off;
+  });
+  size_t i = 0;
+  for (size_t k = 0; k < plan.sigs.size(); k++) {
+    const struct gdakiRsImportSig& t = plan.sigs[k];
+    uint64_t got = 0;
+    size_t n = 0;
+    for (; i < all.size() && all[i].win == t.win && all[i].off == t.off; i++, n++) got += all[i].add;
+    if (n == 0 || got != t.add) {
+      snprintf(why, whyLen, "signal window %u offset %lu: the plan adds %lu, its %zu entries %lu", t.win,
+               (unsigned long)t.off, (unsigned long)t.add, n, (unsigned long)got);
+      return false;
+    }
+  }
+  if (i != all.size()) {
+    snprintf(why, whyLen, "signal window %u offset %lu has entries but no addition in the plan", all[i].win,
+             (unsigned long)all[i].off);
+    return false;
+  }
+  *total = sum;
+  return true;
+}
+// ---- gin-restore (dev): log, suppress and replay, pure (end) ----
+
+// ==== gin-restore (rs, work package 8, spare branch): pure functions (begin) ====
+// Self-contained (no gdakiTsMsg, no gdaki_exch_info, no socket): the CPU unit test (impl/rs_spare_unit.cc) and this file
+// compile the same text. The non-pure spare region (after gdakiTsReconnectStep) converts the library structs to and from
+// these. EXPERIMENT.md 9.3 (the spare and endpoint indirection), 9.10.5 (the activation gate), 9.11.3 M4 (the two-sided
+// token exchange).
+
+// The activation gate (9.10.5 "잘못된 죽음 판정의 막" (1)): the spare examines the original process (same node) before it
+// activates, and never activates while the original lives. The buddy's ACTIVATE carries the original PID and its start
+// time (/proc/<pid>/stat field 22, recorded when the rank first registered). What /proc shows now:
+struct gdakiRsActProbe {
+  bool exists = false;         // /proc/<pid> is there
+  char state = '?';            // /proc/<pid>/stat state field (R, S, D, Z, X, ...)
+  unsigned long long start = 0; // its field-22 start time
+};
+enum { GDAKI_RS_ACT_GO = 0, GDAKI_RS_ACT_WAIT = 1 };
+// GO: the original is gone (absent, a zombie/dead not-yet-reaped, or the PID was reused by a process with another start
+// time). WAIT: it is alive with the recorded start time, or the gate cannot tell (no PID, no start time): conservative, the
+// spare refuses and everyone falls back. The ACTIVATE record must carry the original's PID and start time.
+static int gdakiRsActExamine(long long pid, unsigned long long expectedStart, const struct gdakiRsActProbe& now,
+                             char* why, size_t whyLen) {
+  if (pid <= 0) {
+    snprintf(why, whyLen, "no PID of the original process to check: cannot confirm it is gone");
+    return GDAKI_RS_ACT_WAIT;
+  }
+  if (!now.exists) {
+    snprintf(why, whyLen, "the original process %lld is gone (/proc absent)", pid);
+    return GDAKI_RS_ACT_GO;
+  }
+  if (now.state == 'Z' || now.state == 'X') {
+    snprintf(why, whyLen, "the original process %lld is a %s (not reaped)", pid,
+             now.state == 'Z' ? "zombie" : "dead task");
+    return GDAKI_RS_ACT_GO;
+  }
+  if (expectedStart != 0 && now.start != expectedStart) {
+    snprintf(why, whyLen, "PID %lld was reused (start time %llu, recorded %llu): the original is gone", pid, now.start,
+             expectedStart);
+    return GDAKI_RS_ACT_GO;
+  }
+  if (expectedStart == 0) {
+    snprintf(why, whyLen, "PID %lld is alive and no start time was recorded: cannot confirm it is gone", pid);
+    return GDAKI_RS_ACT_WAIT;
+  }
+  snprintf(why, whyLen, "the original process %lld is still alive (start time %llu, state %c)", pid, now.start,
+           now.state);
+  return GDAKI_RS_ACT_WAIT;
+}
+
+// REJOIN record validation (survivor side, RL6): a parked REJOIN of `peer` qualifies when its wire version and nonce are
+// this context's, its restored-rank incarnation is the one this rank knows for the peer plus one, and the QP count and
+// the recorded view of this rank's QPNs match this rank's QPs to the peer (in GIN-context order). Arrays of nqp QPNs:
+// recSurvivorQpn is the spare's view (from the transcript), ownQpn is this rank's live QPNs.
+static bool gdakiRsRejoinValidate(uint32_t wireVer, uint64_t recNonce, uint64_t ctxNonce, uint32_t recInc,
+                                  uint32_t knownInc, int recNqp, int ownNqp, const uint32_t* recSurvivorQpn,
+                                  const uint32_t* ownQpn, char* why, size_t whyLen) {
+  if (wireVer != 1u) { snprintf(why, whyLen, "REJOIN wire version %u (expected 1)", wireVer); return false; }
+  if (recNonce != ctxNonce) { snprintf(why, whyLen, "REJOIN nonce mismatch (a foreign connection)"); return false; }
+  if (recInc != knownInc + 1u) {
+    snprintf(why, whyLen, "REJOIN incarnation %u (expected %u = known %u + 1)", recInc, knownInc + 1u, knownInc);
+    return false;
+  }
+  if (recNqp != ownNqp) {
+    snprintf(why, whyLen, "REJOIN QP count %d (this rank has %d QPs to the peer)", recNqp, ownNqp);
+    return false;
+  }
+  for (int i = 0; i < ownNqp; i++)
+    if (recSurvivorQpn[i] != ownQpn[i]) {
+      snprintf(why, whyLen, "REJOIN QP %d: the spare's view of this rank's QPN (%#x) is not this rank's (%#x)", i,
+               recSurvivorQpn[i], ownQpn[i]);
+      return false;
+    }
+  snprintf(why, whyLen, "REJOIN valid (incarnation %u, %d QPs)", recInc, recNqp);
+  return true;
+}
