+// The buddy's images of one subject (9.4 "어디에"): the last stable one and the one being received. An upload applies its
+// changed blocks onto a copy of the stable image it names as its base (no base: every block comes); the image becomes
+// stable only with the subject's CKPT_STABLE (the restore then uses the newest stable image). Bytes only: no sockets.
+struct gdakiCkptImage {
+  bool complete = false;
+  uint64_t ckpt = 0;
+  struct gdakiCkptHdr hdr;          // as uploaded (nChanged = the upload's)
+  std::vector<uint8_t> data;        // imageBytes
+  std::vector<uint8_t> blob;
+};
+struct gdakiCkptStore {
+  bool haveStable = false;
+  struct gdakiCkptImage stable;
+  bool havePending = false;
+  struct gdakiCkptImage pending;
+  // an upload's header: false (why) when its base is not the stable image or the sizes do not hold together
+  bool begin(const struct gdakiCkptHdr& h, const char** why) {
+    *why = "";
+    if (h.magic != GDAKI_CKPT_MAGIC || h.version != GDAKI_CKPT_VERSION || h.blockBytes != GDAKI_CKPT_BLOCK ||
+        h.nRegions > GDAKI_CKPT_MAX_REGIONS || h.nPeers > GDAKI_CKPT_MAX_PEERS || h.blobBytes > GDAKI_CKPT_MAX_BLOB ||
+        h.imageBytes > (1ULL << 40) || h.nChanged > gdakiCkptNBlocks(h.imageBytes)) {
+      *why = "a malformed checkpoint header";
+      return false;
+    }
+    const bool full = h.baseCkpt == ~0ULL;
+    if (!full && (!haveStable || stable.ckpt != h.baseCkpt || stable.data.size() != h.imageBytes)) {
+      *why = "the upload's base is not the stable image here";
+      return false;
+    }
+    if (full && h.nChanged != gdakiCkptNBlocks(h.imageBytes)) {
+      *why = "an upload without a base must carry every block";
+      return false;
+    }
+    havePending = true;
+    pending.complete = false;
+    pending.ckpt = h.ckpt;
+    pending.hdr = h;
+    try {  // a header's size is the sender's word: no memory for it refuses the upload, it never ends the process
+      if (full) pending.data.assign((size_t)h.imageBytes, 0);
+      else pending.data = stable.data;
+    } catch (const std::bad_alloc&) {
+      havePending = false;
+      pending.data.clear();
+      *why = "no host memory for the image";
+      return false;
+    }
+    pending.blob.clear();
+    return true;
+  }
+  bool block(uint64_t idx, const uint8_t* p, uint64_t len) {
+    if (!havePending || len != gdakiCkptBlockLen(idx, pending.data.size()) || len == 0) return false;
+    memcpy(pending.data.data() + idx * GDAKI_CKPT_BLOCK, p, (size_t)len);
+    return true;
+  }
+  void finish(const uint8_t* blob, uint32_t blobBytes) {
+    pending.blob.assign(blob, blob + blobBytes);
+    pending.complete = true;
+  }
+  // the subject's CKPT_STABLE: the pending image of that checkpoint becomes the stable one
+  bool markStable(uint64_t ckpt) {
+    if (!havePending || !pending.complete || pending.ckpt != ckpt) return false;
+    stable = std::move(pending);
+    haveStable = true;
+    havePending = false;
+    pending = gdakiCkptImage();
+    return true;
+  }
+};
