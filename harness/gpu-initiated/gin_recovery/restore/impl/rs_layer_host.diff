+ *   signal this rank made in steps <= s is covered by its receiver's stable checkpoint. The send-side log holds
+ *   descriptors only and a restore re-reads a put's source window, so the source buffer of a put made in step t must stay
+ *   unchanged until a call reports *stableStep >= t; buffers of puts made in steps <= *stableStep may be reused. Do not
+ *   block waiting for it inside the hook (a receiver may skip a checkpoint). NCCL_GIN_RESTORE_STEP_NONE: no step is
+ *   covered yet. On a communicator where no rank asks for the restore: *stableStep = step (nothing is retained). With
+ *   NCCL_GIN_RESTORE_CHECKSUM=sampled|full the library records a checksum of each put's source and refuses a restore whose
+ *   source changed (detection only).
+ * Step takes a checkpoint every NCCL_GIN_RESTORE_CKPT_STEPS steps (the first call takes one): the peers pause their sends
+ * to this rank for a few milliseconds while it copies its windows, its ncclGinRestoreRegister buffers and its signal and
+ * counter tables on the GPU; the copy then goes to its buddy rank's host memory in the background. A checkpoint a peer
+ * cannot pause for (a restore runs, a fault already reached the application) is skipped and tried again a quarter of
+ * NCCL_GIN_RESTORE_CKPT_STEPS later; a call while the previous checkpoint is still being confirmed returns at once.
+ * It returns ncclInvalidArgument for a blob larger than 1 MiB (or NULL with bytes > 0), else ncclSuccess.
+ * ncclGinRestoreRegister(comm, buff, size): a device buffer that holds state the next steps depend on, besides the
+ *   windows; every rank registers its own in the same order (the restore names them by that order), before
+ *   ncclGinRestoreResume (a spare process gets its state back inside Resume). Not a GIN window.
+ */
+struct ncclDevComm;
+ncclResult_t  ncclGinRestoreResume(ncclComm_t comm, const struct ncclDevComm* devComm, unsigned long long* step,
+                                   void* blob, size_t* bytes);
+ncclResult_t pncclGinRestoreResume(ncclComm_t comm, const struct ncclDevComm* devComm, unsigned long long* step,
+                                   void* blob, size_t* bytes);
+#define NCCL_GIN_RESTORE_STEP_NONE (~0ULL)
+ncclResult_t  ncclGinRestoreStep(ncclComm_t comm, unsigned long long step, const void* blob, size_t bytes,
+                                 unsigned long long* stableStep);
+ncclResult_t pncclGinRestoreStep(ncclComm_t comm, unsigned long long step, const void* blob, size_t bytes,
+                                 unsigned long long* stableStep);
+ncclResult_t  ncclGinRestoreRegister(ncclComm_t comm, void* buff, size_t size);
+ncclResult_t pncclGinRestoreRegister(ncclComm_t comm, void* buff, size_t size);
+
 #ifdef __cplusplus
 } // end extern "C"
 #endif
