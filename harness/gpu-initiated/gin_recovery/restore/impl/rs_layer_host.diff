+static bool gdakiRsReadQps(struct gdakiRecHost* r, std::vector<struct ncclGinRsQp>* out, const char** why = nullptr) {
+  const char* w = nullptr;
+  const size_t n = (size_t)r->rsNqp * sizeof(struct ncclGinRsQp);
+  if (!r->rsPtrSet || r->rsNqp <= 0) w = "no side table";
+  else if (!r->rsLbOk || !gdakiLbOn(r)) w = "the NIC copy path is off";
+  else if (n > r->pinnedSize) w = "the QP entries are larger than the staging buffer";
+  if (w == nullptr && gdakiLbXfer(r, false, (const char*)r->rsBase + sizeof(struct ncclGinRsSide), n) != ncclSuccess)
+    w = "the read over the NIC copy path failed";
+  if (w != nullptr) {
+    if (why) *why = w;
+    return false;
+  }
+  out->resize((size_t)r->rsNqp);
+  memcpy(out->data(), r->pinned, n);
+  return true;
+}
+// The measurement mode (NCCL_GIN_RESTORE_LOG_MEASURE, EXPERIMENT.md 9.5), one helper step: every <ms>, each logged QP's
+// occupancy (head - tail) is sampled and its tail moved to the head it read, so the ring does not fill without
+// checkpoints. A post that reserved a slot below that head may still be writing its entry: harmless here (the entries
+// are never read in this mode, and a slot is reused only after nEntries more reservations).
+static void gdakiRsMeasureStep(struct gdakiRecHost* r) {
+  if (r->rsMeasureMs <= 0) return;
+  const double now = gdakiQ4MonoMs();
+  if (now < r->rsMeasureNext) return;
+  r->rsMeasureNext = now + (double)r->rsMeasureMs;
+  std::vector<struct ncclGinRsQp> v;
+  if (!gdakiRsReadQps(r, &v)) {
+    r->rsMeasureErrs++;
+    return;
+  }
+  r->rsMeasureRounds++;
+  struct ncclGinRsQp* dev = (struct ncclGinRsQp*)((char*)r->rsBase + sizeof(struct ncclGinRsSide));
+  for (int i = 0; i < r->rsNqp; i++) {
+    if (!r->rsLogged[(size_t)i]) continue;
+    const uint64_t head = v[(size_t)i].head, tail = v[(size_t)i].tail;
+    const uint64_t occ = head >= tail ? head - tail : 0;
+    gdakiRecHost::RsOcc& o = r->rsOcc[(size_t)i];
+    o.samples++;
+    o.sum += occ;
+    if (occ > o.max) o.max = occ;
+    if (occ == 0) continue;
+    memcpy(r->pinned, &head, sizeof(head));
+    if (gdakiLbXfer(r, true, &dev[i].tail, sizeof(uint64_t)) != ncclSuccess) {
+      r->rsMeasureErrs++;
+      return;
+    }
+  }
+}
