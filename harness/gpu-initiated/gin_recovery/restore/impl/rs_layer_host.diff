+// gin-restore (rs, work package 2): what the public entry ncclGinRestoreResume (gin/gin_host.cc) tells the GDAKI restore
+// layer (transport/net_ib/gdaki/gin_host_gdaki.cc), which judges, runs the bounded exchange through `exchange` (the
+// communicator's bootstrap all-gather) and decides; `abortComm` sets the communicator's abort flags.
+struct ncclGinRestoreCommFacts {
+  int rank, nRanks;           // in the communicator
+  uint64_t commHash;          // with bootstrap: which communicator this is (a later one may reuse its address)
+  void* bootstrap;
+  int asyncErr;               // the communicator's asynchronous error (ncclCommGetAsyncError; 0: none)
+  int argsOk;                 // devComm, step and bytes are not NULL
+  int devCommVersion;         // the devComm's device-code version (-1: unversioned; 0: no devComm)
+  int ginType;                // the devComm's GIN backend (NCCL_GIN_TYPE_*; 0: none)
+  int nConn;                  // the devComm's GIN connections
+  void* handles[NCCL_GIN_MAX_CONNECTIONS];  // the devComm's GIN handles (ncclDevComm::ginHandles)
+  int commFull;               // the communicator's GIN connection is FULL
+  int ctxStride;              // the devComm's GIN context stride
+  int numRmaCtx;              // host RMA contexts (comm->config.numRmaCtx)
+  int runtimeConn;            // runtime connect is on
+  int nvls;                   // NVLS support is on
+  int lsaSize;                // the devComm's LSA team size
+  int symGinDevComm;          // NCCL's symmetric kernels have a GIN devComm on this communicator
+  void* resAddr;              // the devComm's resource window, this rank's address (null: none)
+};
+ncclResult_t ncclGinGdakiRestoreResume(void* comm, const struct ncclGinRestoreCommFacts* facts,
+                                       ncclResult_t (*exchange)(void* comm, void* data, int bytesPerRank),
+                                       void (*abortComm)(void* comm), unsigned long long* step, void* blob,
+                                       size_t* bytes);
+// gin-restore (rs, work package 5): ncclGinRestoreStep's and ncclGinRestoreRegister's bodies (the GDAKI restore layer)
+ncclResult_t ncclGinGdakiRestoreStep(void* comm, unsigned long long step, const void* blob, size_t bytes,
+                                     unsigned long long* stableStep);
+ncclResult_t ncclGinGdakiRestoreRegister(void* comm, void* buff, size_t size);
+
 #endif
diff --git a/src/include/nccl_device/gin/gdaki/gin_gdaki.h b/src/include/nccl_device/gin/gdaki/gin_gdaki.h
index d158067..962eccf 100644
--- a/src/include/nccl_device/gin/gdaki/gin_gdaki.h
+++ b/src/include/nccl_device/gin/gdaki/gin_gdaki.h
@@ -454,16 +454,348 @@ __device__ __noinline__ static bool tsTestSplitPut(doca_gpu_dev_verbs_qp* qp, do
   return true;
 }
 
+// ---------------------------------------------------------------------------
+// gin-restore (rs, work package 4; EXPERIMENT.md 9.5, 9.6, 9.11.5 A1, 9.11.9 C2 and C6): the hold path. put, putValue and
+// get read the GPU context's side-table pointer once (ncclGinGdakiGPUContext::restore) and, when it is not null (a process
+// that asks for the restore: NCCL_GIN_FAULT_POLICY=hold with NCCL_GIN_RESTORE != 0, or a spare process), call the not
+// inlined functions below instead of hk's body. Fail-fast (null): hk's body runs unchanged; the cost is that load and its
+// branch (and, in put and putValue, the signal key's address passed along as one more internal argument).
+// Inside the gate, in this order: the suppress budget (the spare process holds back what the survivor already executed;
+// in the side table, not in the gate word, so hk's shared gate, wait, flush and park code is unchanged), the remote keys
+// read after the gate entry (a restore rewrites them while the gate is odd), the request-message count (every post), the
+// post, then the send-side log entry (only once the helper set the QP's logOn; after the post so that few values are live
+// across its call: the checksum then reads the source while the NIC may read it too, which is harmless). The gate's
+// release on leave covers the entry write, so a quiesced gate (odd, count 0) means every entry of every post before it is
+// written; no order between the entry and the WQE is needed. The cost: under whole-program compilation a kernel's
+// register count covers these functions too (EXPERIMENT.md 12, the machine-code comparison of work package 4).
+// ---------------------------------------------------------------------------
+NCCL_DEVICE_INLINE static struct ncclGinRsQp* rsQpOf(struct ncclGinRsSide* rs, const ncclGinCtx& ctx, int peer) {
+  const uint32_t i = (uint32_t)ctx.contextId * (uint32_t)ctx.nRanks + (uint32_t)peer;  // the host's qp index
+  if (i >= nccl::utility::loadConst(&rs->nqp)) return nullptr;
+  return reinterpret_cast<struct ncclGinRsQp*>(reinterpret_cast<char*>(rs) + sizeof(struct ncclGinRsSide)) + i;
+}
+// Take up to m request messages from the QP's suppress budget (CAS inside the gate; one program order per QP in the spare,
+// 9.7 item 5). Returns how many of the operation's first messages are held back. The common case (no budget): one load.
+NCCL_DEVICE_INLINE static uint64_t rsTakeBudget(struct ncclGinRsQp* q, uint64_t m) {
+  if (m == 0) return 0;
+  unsigned long long b = tsLoadRelaxedSys64(&q->suppress);
+  while (b != 0) {
+    const unsigned long long t = ncclGinRsTake(b, m);
+    const unsigned long long prev = atomicCAS(reinterpret_cast<unsigned long long*>(&q->suppress), b, b - t);
+    if (prev == b) return t;
+    b = prev;
+  }
+  return 0;
+}
+// The QP logs (the helper set logOn in its first checkpoint input pause; system-scope load: written over the NIC).
+NCCL_DEVICE_INLINE static bool rsLogOn(struct ncclGinRsQp* q) {
+  return nccl::utility::loadConst(&q->entries) != nullptr && tsLoadRelaxedSys(&q->logOn) != 0;
+}
+// The checksum's loads on the device: through L2 (ld.global.cg), the copy the NIC reads; aligned only (ncclGinRsCsumRange
+// asks for nothing else). Host stubs only keep the walk a __host__ __device__ template without cross-space calls.
+struct rsCsumDevLoad {
+  __host__ __device__ __forceinline__ uint8_t b1(const uint8_t* q) const {
+#ifdef __CUDA_ARCH__
+    return __ldcg(q);
+#else
+    (void)q;
+    return 0;
+#endif
+  }
+  __host__ __device__ __forceinline__ uint32_t w4(const uint8_t* q) const {
+#ifdef __CUDA_ARCH__
+    return __ldcg(reinterpret_cast<const unsigned int*>(q));
+#else
+    (void)q;
+    return 0;
+#endif
+  }
+  __host__ __device__ __forceinline__ struct ncclGinRsQuad w16(const uint8_t* q) const {
+    struct ncclGinRsQuad r;
+#ifdef __CUDA_ARCH__
+    const uint4 v = __ldcg(reinterpret_cast<const uint4*>(q));
+    r.x = v.x, r.y = v.y, r.z = v.z, r.w = v.w;
+#else
+    (void)q;
+    r.x = r.y = r.z = r.w = 0;
+#endif
+    return r;
+  }
+};
+// One send-side log entry (EXPERIMENT.md 9.5), written by the sending thread inside the gate after its post: the checksum
+// of a put's data (when the scheme is on), a slot (or an overflow: no entry, the highest lost number and one more overflow;
+// the post is never held up), then the eight words. Not inlined, and the hold functions call it last, with few values
+// live: under whole-program compilation a kernel's register count covers its whole call graph (fail-fast included).
+// head is the kind byte | flags << 8 | messages << 16 (the checksum fills bits 32..63).
+template <int Unused = 0>
+__device__ __noinline__ static void rsLogPut(struct ncclGinRsSide* rs, struct ncclGinRsQp* q, uint32_t head,
+                                             ncclGinWindow_t dstWin, ncclGinWindow_t srcWin, uint64_t dstOff,
+                                             uint64_t bytes, uint64_t src, const __be32* sigSlot, uint64_t sigOff,
+                                             uint64_t sigVal) {
+  using nccl::utility::loadConst;
+  ncclGinGdakiMemHandle* const dstMh = (ncclGinGdakiMemHandle*)dstWin;
+  ncclGinGdakiMemHandle* const srcMh = (ncclGinGdakiMemHandle*)srcWin;
+  uint32_t csum = 0;
+  if ((head & 0xffu) == NCCL_GIN_RS_LOG_PUT && bytes != 0) {  // a put's data: its checksum
+    const uint32_t scheme = loadConst(&rs->csum);
+    if (scheme != NCCL_GIN_RS_CSUM_OFF) {
+      const uint8_t* base = reinterpret_cast<const uint8_t*>(loadConst(&srcMh->rsBase));
+      if (base == nullptr) {
+        head |= NCCL_GIN_RS_LOGF_NOBASE << 8;
+      } else {
+        head |= ((scheme & 3u) << NCCL_GIN_RS_LOGF_CSUM_SHIFT) << 8;
+        csum = ncclGinRsCsumWalk(scheme, base + src, bytes, rsCsumDevLoad());
+      }
+    }
+  }
+  struct ncclGinRsLogEntry* const ring = reinterpret_cast<struct ncclGinRsLogEntry*>(loadConst(&q->entries));
+  const uint32_t n = loadConst(&q->nEntries);
+  const unsigned long long slot = atomicAdd(reinterpret_cast<unsigned long long*>(&q->head), 1ull);
+  if (!ncclGinRsLogFits(slot, tsLoadRelaxedSys64(&q->tail), n)) {
+    atomicMax(reinterpret_cast<unsigned long long*>(&q->ovfSeq), slot + 1ull);
+    atomicAdd(reinterpret_cast<unsigned long long*>(&q->ovfCount), 1ull);
+    return;
+  }
+  uint64_t* const w = reinterpret_cast<uint64_t*>(ring + (slot & (unsigned long long)(n - 1)));
+  const uint32_t kind = head & 0xffu;
+  w[0] = (uint64_t)head | ((uint64_t)csum << 32);
+  w[1] = (kind == NCCL_GIN_RS_LOG_SIGNAL ? 0ull : (uint64_t)loadConst(&dstMh->rsWinId)) |
+         ((kind == NCCL_GIN_RS_LOG_PUT ? (uint64_t)loadConst(&srcMh->rsWinId) : 0ull) << 32);
+  w[2] = dstOff;
+  w[3] = bytes;
+  w[4] = src;
+  w[5] = (uint64_t)(uintptr_t)sigSlot;
+  w[6] = sigOff;
+  w[7] = sigVal;
+}
+NCCL_DEVICE_INLINE static uint32_t rsLogHead(uint32_t kind, uint32_t flags, uint64_t msgs) {
+  return kind | (flags << 8) | ((uint32_t)(msgs < 0xffffu ? msgs : 0xffffu) << 16);
+}
+
+// The hold path of put (and of a signal alone: HasWins false). Specialized by HasWins and HasSignal, as hk's inlined body
+// is by constant propagation, so a kernel's call graph holds only the variant it uses. sigVal: the value the signal adds
+// (Inc already resolved by the caller); sysFence: the system-scope release hk adds (required system, given wider).
+// Counters (companion QPs) never reach it: transparent recovery, which the side table needs, is off with companion QPs.
+template <enum doca_gpu_dev_verbs_resource_sharing_mode resource_sharing_mode, bool HasWins, bool HasSignal>
+__device__ __noinline__ static void rsPutHold(ncclGinCtx ctx, int peer, ncclGinWindow_t dstWin, size_t dstOff,
+                                              ncclGinWindow_t srcWin, size_t srcOff, size_t bytes, size_t signalOffset,
+                                              const __be32* signalKeyAddr, uint64_t sigVal, bool hasCounter,
+                                              bool sysFence, uint32_t optFlags, struct ncclGinRsSide* rs) {
+  using nccl::utility::loadConst;
+  if (hasCounter) __trap();  // not reachable (above); hk would post to a null companion QP
+  if (HasSignal && signalKeyAddr == nullptr) __trap();  // a signal without a descriptor (invalid use; hk posts garbage)
+  ncclGinGdakiGPUContext* gdaki = &((struct ncclGinGdakiGPUContext*)ctx.handle)[ctx.contextId];
+  doca_gpu_dev_verbs_qp* qp = loadConst(&gdaki->gdqp) + peer;
+  struct ncclGinGdakiQ4* const q4 = loadConst(&gdaki->fault);
+  const bool ts = tsOn(qp);
+  struct ncclGinRsQp* q = nullptr;
+  bool postData = HasWins;  // false: the suppress budget held the data back, only the signal is left
+  bool split = false;
+  uint64_t mPost = 0;       // request messages this post makes
+  if (ts) {
+    // A false gate means the QP failed while this poster was parked: not posted (as hk).
+    if (!tsGateEnter(qp, q4, ctx.contextId)) return;
+    q = rsQpOf(rs, ctx, peer);
+    if (q != nullptr) {
+      const uint64_t skip = rsTakeBudget(q, ncclGinRsPlanOf(HasWins, bytes, HasSignal, 0).m);
+      const struct ncclGinRsPlan pl = ncclGinRsPlanOf(HasWins, bytes, HasSignal, skip);
+      if (pl.all) {  // all of it executed before the death: nothing posted, counted or logged (EXPERIMENT.md 9.6)
+        tsGateLeave(qp);
+        return;
+      }
+      split = skip != 0;
+      postData = pl.postData;
+      dstOff += pl.adv;  // a put above 1 GiB: the remaining chunks
+      srcOff += pl.adv;
+      bytes -= pl.adv;
+      mPost = pl.mPost;
+    }
+  }
+  const uint32_t codeOpt = q4CollapsedCodeOpt(qp, nccl::gin::gdaki::docaOptFlagsFromGinOptFlags(optFlags));
+  // the remote keys: after the gate entry on a gated QP (EXPERIMENT.md 9.11.5 A1, decision (나)), system scope, not
+  // through L1 (a restore rewrites them over the NIC while the gate is odd); an ungated QP reads them as hk does
+  doca_gpu_dev_verbs_addr raddr, laddr, sig_raddr, sig_laddr;
+  if (HasWins) {
+    ncclGinGdakiMemHandle* dstMh = (ncclGinGdakiMemHandle*)dstWin;
+    ncclGinGdakiMemHandle* srcMh = (ncclGinGdakiMemHandle*)srcWin;
+    raddr.addr = dstOff;
+    if (postData) {
+      __be32* const k = loadConst(&dstMh->rkeys) + peer;
+      raddr.key = ts ? tsLoadRelaxedSys(reinterpret_cast<uint32_t*>(k)) : loadConst(k);
+    }
+    laddr.addr = srcOff, laddr.key = loadConst(&srcMh->lkey);
+  }
+  if (HasSignal) {
+    sig_raddr.addr = signalOffset;
+    sig_raddr.key = ts ? tsLoadRelaxedSys((uint32_t*)signalKeyAddr) : loadConst(signalKeyAddr);
+    sig_laddr.addr = 0;
+    sig_laddr.key = loadConst(&gdaki->sink_buffer_lkey);
+  }
+  // cuda::thread_scope_system has the lowest value
+  // DOCA guarantees SCOPE_GPU. Only add another release if SCOPE_SYSTEM is required.
+  if (sysFence) doca_gpu_dev_verbs_fence_release<DOCA_GPUNETIO_VERBS_SYNC_SCOPE_SYS>();
+  if (q != nullptr && mPost != 0) atomicAdd(reinterpret_cast<unsigned long long*>(&q->msgs), (unsigned long long)mPost);
+
+  if (HasWins && postData) {
+    if (HasSignal) {
+      if (!(ts && (tsGate(qp)->flags & NCCL_GIN_TS_F_TEST_SPLIT) &&
+            tsTestSplitPut<resource_sharing_mode>(qp, raddr, laddr, bytes, sig_raddr, sig_laddr, sigVal, codeOpt)))
+        doca_gpu_dev_verbs_put_signal<DOCA_GPUNETIO_VERBS_SIGNAL_OP_ADD, resource_sharing_mode>(
+          qp, raddr, laddr, bytes, sig_raddr, sig_laddr, sigVal, codeOpt);
+    } else {
+      doca_gpu_dev_verbs_put<resource_sharing_mode>(qp, raddr, laddr, bytes, codeOpt);
+    }
+  } else if (HasSignal || !HasWins) {  // a signal alone (hk posts one for a put without windows), or a split put's signal
+    doca_gpu_dev_verbs_signal<DOCA_GPUNETIO_VERBS_SIGNAL_OP_ADD, resource_sharing_mode>(qp, sig_raddr, sig_laddr, sigVal,
+                                                                                        codeOpt);
+  }
+  if (ts) {
+    if (q != nullptr && mPost != 0 && rsLogOn(q)) {
+      const bool data = HasWins && postData;
+      rsLogPut(rs, q,
+               rsLogHead(data ? NCCL_GIN_RS_LOG_PUT : NCCL_GIN_RS_LOG_SIGNAL,
+                         (HasSignal ? NCCL_GIN_RS_LOGF_SIGNAL : 0u) | (split ? NCCL_GIN_RS_LOGF_SPLIT : 0u), mPost),
