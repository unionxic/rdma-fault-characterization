+// G2: a decline toward a peer (gdakiTsDecline's first statement).
+enum {
+  GDAKI_HOLD_D_PASS = 0,         // the decline runs as hk's (fail-fast); nothing else
+  GDAKI_HOLD_D_PASS_NOHOLD = 1,  // the decline runs; the peer was ARMED: OFF, and NOHOLD(p, i) to every rank (N4, Q1)
+  GDAKI_HOLD_D_START = 2,        // the hold starts instead of the decline (the decline is taken)
+  GDAKI_HOLD_D_FALLBACK = 3,     // the peer is held: any decline is its fallback (V1: PeerDead, PEER_DEAD; taken)
+};
+struct gdakiHoldDeclineIn {
+  uint32_t state = GDAKI_HOLD_OFF;  // the peer's state
+  bool policyHold = false;          // this context's effective policy is hold (all ranks asked, the setup agreed)
+  bool commArmed = false;           // ncclGinRestoreResume enabled the restore and its conditions still hold
+  bool deathEvidence = false;       // the decline's uaWhy is GDAKI_UA_PEER_DEAD
+  bool strongCause = false;         // the death was judged on a FIN without BYE or on two refused connects (9.10.5)
+  bool lostAfterCommit = false;     // the peer's socket was lost after this rank's commit (weak: never held)
+  bool told = false;                // something already reached the application (9.10.5 TOLD)
+  bool otherHeld = false;           // another peer of this context is held (one held peer per communicator)
+  bool buddyReachable = false;      // the peer's buddy is this rank or has an installed helper socket
+  bool stopping = false;            // the helper is asked to stop (teardown) or is dead: no new hold
+};
+// *why: the reason of a PASS_NOHOLD (a static string). *fallbackOther: another peer is held and this decline concerns a
+// different peer: that hold falls back too (9.10.5: a second failure during a restore ends it; single failure scope).
+static int gdakiHoldDeclineAction(const struct gdakiHoldDeclineIn& in, const char** why, bool* fallbackOther) {
+  *why = "";
+  *fallbackOther = false;
+  if (gdakiHoldIsHeldState(in.state)) return GDAKI_HOLD_D_FALLBACK;
+  *fallbackOther = in.otherHeld;
+  if (in.state != GDAKI_HOLD_ARMED) return GDAKI_HOLD_D_PASS;
+  if (in.stopping) *why = "the helper is stopping (teardown)";
+  else if (!in.policyHold) *why = "the context's policy is not hold";
+  else if (!in.commArmed) *why = "the communicator is not armed";
+  else if (!in.deathEvidence) *why = "the decline is not a death";
+  else if (in.lostAfterCommit) *why = "the socket was lost after this rank's commit (weak evidence)";
+  else if (!in.strongCause) *why = "weak death evidence (not a FIN without BYE, not two refused connects)";
+  else if (in.told) *why = "a fault already reached the application";
+  else if (in.otherHeld) *why = "another peer is held";
+  else if (!in.buddyReachable) *why = "the peer's buddy has no helper socket";
+  else return GDAKI_HOLD_D_START;
+  return GDAKI_HOLD_D_PASS_NOHOLD;
+}
+// The death causes that are strong evidence (9.10.5, F9, V11): gdakiTsSocketLost's lostCause "FIN" (a FIN without BYE:
+// after a BYE it is "BYE") and "ECONNREFUSED" (the second refused connect 1000-5000 ms after the first; an established
+// socket's ECONNREFUSED is an unknown liveness, never a death).
+static bool gdakiHoldStrongCause(const char* lostCause) {
+  return lostCause != nullptr && (strcmp(lostCause, "FIN") == 0 || strcmp(lostCause, "ECONNREFUSED") == 0);
+}
+
+// A helper-socket record of the host branch (or the spare's RESTORED) about subject p, from another rank.
+enum {
+  GDAKI_HOLD_M_NONE = 0,         // nothing for this state (stale incarnation, or not about a hold this rank has)
+  GDAKI_HOLD_M_OFF = 1,          // ARMED -> OFF (DISARM, NOHOLD, a FALLBACK of an incarnation this rank did not hold)
+  GDAKI_HOLD_M_FALLBACK = 2,     // the held peer's fallback
+  GDAKI_HOLD_M_DECLINE = 3,      // this rank revived that incarnation (it took its RESTORED): decline it (P2)
+  GDAKI_HOLD_M_RESTORED = 4,     // PUBLISHED or TIMED_OUT_PUBLISHED -> ARMED or OFF of incarnation i + 1
+  GDAKI_HOLD_M_DISARM_LATER = 5, // a DISARM of a held peer: applied at its RESTORED (P5)
+  GDAKI_HOLD_M_HOLDING = 6,      // the buddy counts a holder
+};
+struct gdakiHoldMsgIn {
+  uint32_t type = 0;               // GDAKI_TS_DISARM, NOHOLD, HOLDING, FALLBACK, or the spare's RESTORED (restored = true)
+  bool restored = false;           // the record is the spare's RESTORED (impl/rs_spare_api.h type 37)
+  uint32_t state = GDAKI_HOLD_OFF;
+  uint32_t inc = 0;                // the incarnation the state concerns
+  uint32_t msgInc = 0;             // the record's: DISARM, NOHOLD, HOLDING, FALLBACK: round; RESTORED: pad (= i + 1)
+  bool revivedFromValid = false;   // this rank took a RESTORED for p (cell then ARMED or OFF of revivedFrom + 1)
+  uint32_t revivedFrom = 0;        // the incarnation whose death that restore covered
+};
+static int gdakiHoldMsgAction(const struct gdakiHoldMsgIn& in) {
+  const bool held = gdakiHoldIsHeldState(in.state);
+  if (in.restored) {
+    if ((in.state == GDAKI_HOLD_PUBLISHED || in.state == GDAKI_HOLD_TIMED_OUT_PUBLISHED) && in.msgInc == in.inc + 1u)
+      return GDAKI_HOLD_M_RESTORED;
+    return GDAKI_HOLD_M_NONE;
+  }
+  switch (in.type) {
+    case GDAKI_TS_DISARM:  // whatever incarnation the sender knows: conservative (until the peer's next stable checkpoint)
+      if (held) return GDAKI_HOLD_M_DISARM_LATER;
+      return in.state == GDAKI_HOLD_ARMED ? GDAKI_HOLD_M_OFF : GDAKI_HOLD_M_NONE;
+    case GDAKI_TS_NOHOLD:
+      if (in.msgInc != in.inc) return GDAKI_HOLD_M_NONE;
+      if (held) return GDAKI_HOLD_M_FALLBACK;
+      return in.state == GDAKI_HOLD_ARMED ? GDAKI_HOLD_M_OFF : GDAKI_HOLD_M_NONE;
+    case GDAKI_TS_HOLDING:
+      return GDAKI_HOLD_M_HOLDING;
+    case GDAKI_TS_FALLBACK: {
+      // P2: this rank revived that incarnation (took its RESTORED): the new one is declined; when this rank already
+      // holds the new one (it died again), that is the held peer's fallback
+      const bool revived = in.revivedFromValid && in.revivedFrom == in.msgInc && in.inc == in.msgInc + 1u;
+      if (held) return (in.msgInc == in.inc || revived) ? GDAKI_HOLD_M_FALLBACK : GDAKI_HOLD_M_NONE;
+      if ((in.state == GDAKI_HOLD_ARMED || in.state == GDAKI_HOLD_OFF) && revived) return GDAKI_HOLD_M_DECLINE;
+      if (in.state == GDAKI_HOLD_ARMED && in.msgInc == in.inc) return GDAKI_HOLD_M_OFF;  // Q1: not held here: OFF only
+      return GDAKI_HOLD_M_NONE;
+    }
+    default:
+      return GDAKI_HOLD_M_NONE;
+  }
+}
+
+// G8 (the Q4 watcher): the deadline of the held peer. COMMITTING is never touched (N1).
+enum { GDAKI_HOLD_W_NONE = 0, GDAKI_HOLD_W_TIMEOUT_HELD = 1, GDAKI_HOLD_W_TIMEOUT_PUBLISHED = 2 };
+static int gdakiHoldWatchdogAction(uint32_t state, int64_t deadlineUs, int64_t nowUs) {
+  if (deadlineUs == 0 || nowUs < deadlineUs) return GDAKI_HOLD_W_NONE;
+  if (state == GDAKI_HOLD_HELD) return GDAKI_HOLD_W_TIMEOUT_HELD;
+  if (state == GDAKI_HOLD_PUBLISHED) return GDAKI_HOLD_W_TIMEOUT_PUBLISHED;
+  return GDAKI_HOLD_W_NONE;
+}
+// The deadlines (9.2, 9.11.4 T4, 9.10.7 P1, Q2). HELD: the restore deadline from the hold start, and before the parked
+// device threads give up (their clock starts when the gate first went odd: gateOdd + holdMs), less the share of the
+// restore round after its compare-and-swap and a margin (the device bound). PUBLISHED: from the publish, with no hold term
+// (the gates are even), never shorter than a round and a handshake (RESTORED must be readable while the helper is in
+// another round).
+// The spare's driver serves the survivors one at a time, in rank order (impl/rs_spare_api.h): a survivor's turn (its
+// REJOIN accepted) may start late, after every earlier survivor's round, and RESTORED comes only after the last one's.
+// So (a) at its REJOIN a survivor's HELD deadline becomes at least its REJOIN + one turn (the turn's own bounds: the state
+// transfer and the TOKEN/READY exchange a handshake each, Prepare and Commit a firmware bound each), never past the device
+// bound (gdakiHoldTurnDeadlineUs); (b) a survivor's PUBLISHED deadline also covers every later survivor: each of them
+// held before the activation, which came before this survivor's REJOIN, so each one's gates went odd before it and its
+// publish comes before its gateOdd + holdMs; RESTORED follows the last one within a handshake (rejoin + holdMs +
+// handshake).
+static int64_t gdakiHoldDeviceBoundUs(int64_t gateOddUs, int64_t holdMs, int64_t shareMs, int64_t marginMs) {
+  return gateOddUs + (holdMs - shareMs - marginMs) * 1000;
+}
+static int64_t gdakiHoldHeldDeadlineUs(int64_t holdStartUs, int64_t gateOddUs, int64_t restoreMs, int64_t holdMs,
+                                       int64_t shareMs, int64_t marginMs) {
+  const int64_t a = holdStartUs + restoreMs * 1000;
+  const int64_t b = gdakiHoldDeviceBoundUs(gateOddUs, holdMs, shareMs, marginMs);
+  return a < b ? a : b;
+}
+static int64_t gdakiHoldTurnMs(int64_t handshakeMs, int64_t fwMs) { return 2 * handshakeMs + 2 * fwMs; }
+// (a): the HELD deadline at the REJOIN; never earlier than it was, never past the device bound.
+static int64_t gdakiHoldTurnDeadlineUs(int64_t heldDeadlineUs, int64_t deviceBoundUs, int64_t rejoinUs, int64_t turnMs) {
+  const int64_t t = rejoinUs + turnMs * 1000;
+  const int64_t want = t > heldDeadlineUs ? t : heldDeadlineUs;
+  return want < deviceBoundUs ? want : (heldDeadlineUs > deviceBoundUs ? heldDeadlineUs : deviceBoundUs);
+}
+// (b): rejoinUs 0: no REJOIN known (no later survivor's term).
+static int64_t gdakiHoldPublishedDeadlineUs(int64_t publishUs, int64_t restoreMs, int64_t roundMs, int64_t handshakeMs,
+                                            int64_t rejoinUs, int64_t holdMs) {
+  const int64_t m = restoreMs > roundMs + handshakeMs ? restoreMs : roundMs + handshakeMs;
+  const int64_t a = publishUs + m * 1000;
+  const int64_t b = rejoinUs > 0 ? rejoinUs + (holdMs + handshakeMs) * 1000 : 0;
+  return a > b ? a : b;
+}
+
+// G4: a fault record of a QP to the peer.
+enum { GDAKI_HOLD_R_ROUTE = 0, GDAKI_HOLD_R_ABSORB = 1, GDAKI_HOLD_R_STALE = 2, GDAKI_HOLD_R_FALLBACK = 3 };
+static int gdakiHoldRouteAction(uint32_t state, uint32_t recEpoch, uint32_t coveredEpoch) {
+  if (gdakiHoldIsQuietState(state)) return GDAKI_HOLD_R_ABSORB;  // the QPs are in ERR on purpose (the hold's 2ERR)
+  if (state == GDAKI_HOLD_PUBLISHED || state == GDAKI_HOLD_TIMED_OUT_PUBLISHED)  // Q3: older than the publish: stale
+    return recEpoch < coveredEpoch ? GDAKI_HOLD_R_STALE : GDAKI_HOLD_R_FALLBACK;  // P3: else the restore failed
+  return GDAKI_HOLD_R_ROUTE;
+}
+// RL20 (gdakiTsRespond's first statement, after the peer's parked records are applied): a REQ from the peer.
+enum { GDAKI_HOLD_Q_ANSWER = 0, GDAKI_HOLD_Q_NACK = 1, GDAKI_HOLD_Q_NACK_FALLBACK = 2 };
+static int gdakiHoldReqAction(uint32_t state) {
+  if (state == GDAKI_HOLD_PUBLISHED || state == GDAKI_HOLD_TIMED_OUT_PUBLISHED) return GDAKI_HOLD_Q_NACK_FALLBACK;
+  return gdakiHoldIsHeldState(state) ? GDAKI_HOLD_Q_NACK : GDAKI_HOLD_Q_ANSWER;
+}
+// The helper's step for the held peer (RL4).
+enum {
+  GDAKI_HOLD_S_NONE = 0,     // not held
+  GDAKI_HOLD_S_CANCEL = 1,   // abort, revoke or an aborting shrink: CANCELLED, no decline (every word is up already)
+  GDAKI_HOLD_S_FALLBACK = 2, // give it up now
+  GDAKI_HOLD_S_RESTORED_FIRST = 3,  // TIMED_OUT_PUBLISHED: read the spare's socket and the parked records for RESTORED
+                                    // first (Q2), then the fallback if none
+  GDAKI_HOLD_S_DRIVE = 4,    // go on with the restore
+};
+struct gdakiHoldStepIn {
+  uint32_t state = GDAKI_HOLD_OFF;
+  bool cancelled = false;        // every word of the communicator was raised by the application (allWhy)
+  bool told = false;             // the communicator's async error, word [0], the peer's word, or a degraded raise
+  bool pendingFallback = false;  // another event asked for the fallback (a second death, a lost arming condition)
+  bool commLost = false;         // this communicator lost an arming condition after Resume
+};
+// 9.10.5's order, the top wins: the application's choice (cancel), then what reached the application (TOLD) and the
+// other reasons to give up a restore in progress (a second failure, a lost arming condition), then the deadline (a
+// RESTORED read first still wins over a timed-out publish, Q2, but not over the reasons above). The helper asks this
+// before it hands the held peer's parked records over (a parked RESTORED does not outrun TOLD; gdakiHoldStep) and again
+// after.
+static int gdakiHoldStepAction(const struct gdakiHoldStepIn& in, const char** why) {
+  *why = "";
+  if (!gdakiHoldIsHeldState(in.state)) return GDAKI_HOLD_S_NONE;
+  if (in.cancelled) {
+    *why = "the application aborted, revoked or shrank the communicator";
+    return GDAKI_HOLD_S_CANCEL;
+  }
+  if (in.told) {
+    *why = "a fault reached the application meanwhile";
+    return GDAKI_HOLD_S_FALLBACK;
+  }
+  if (in.pendingFallback) {
+    *why = "asked by another event";
+    return GDAKI_HOLD_S_FALLBACK;
+  }
+  if (in.commLost) {
+    *why = "the communicator lost an arming condition";
+    return GDAKI_HOLD_S_FALLBACK;
+  }
+  if (in.state == GDAKI_HOLD_TIMED_OUT_HELD) {
+    *why = "the restore deadline passed (NCCL_GIN_RESTORE_MS, or the parked waits' bound)";
+    return GDAKI_HOLD_S_FALLBACK;
+  }
+  if (in.state == GDAKI_HOLD_TIMED_OUT_PUBLISHED) return GDAKI_HOLD_S_RESTORED_FIRST;
+  if (in.state == GDAKI_HOLD_COMMITTING) {  // the helper is the one in COMMITTING: its round returned without moving on
+    *why = "the restore round left the peer in COMMITTING";
+    return GDAKI_HOLD_S_FALLBACK;
+  }
+  return GDAKI_HOLD_S_DRIVE;
+}
+// Whether the step's action is taken before the held peer's parked records are handed over (gdakiHoldStep): a cancel
+// or a fallback (no parked record can change them: RESTORED applies to PUBLISHED and TIMED_OUT_PUBLISHED only, and the
+// reasons above outrank it).
+static bool gdakiHoldStepBeforeRecords(int action) {
+  return action == GDAKI_HOLD_S_CANCEL || action == GDAKI_HOLD_S_FALLBACK;
+}
+// gdakiHoldArm: ARMED(inc) or the reason not.
+static bool gdakiHoldArmOk(uint32_t state, uint32_t curInc, uint32_t inc, bool declined, bool commArmed,
+                           uint64_t disarmSeqNow, uint64_t disarmSeqAtPause, const char** why) {
+  *why = "";
+  if (gdakiHoldIsHeldState(state)) *why = "the peer is held";
+  else if (state == GDAKI_HOLD_FALLBACK || state == GDAKI_HOLD_CANCELLED) *why = "the peer's restore ended (final)";
+  else if (declined) *why = "this rank declined the peer";
+  else if (!commArmed) *why = "the communicator is not armed";
+  else if (disarmSeqNow != disarmSeqAtPause) *why = "a DISARM of the peer arrived after the checkpoint's input pause";
+  else if (inc < curInc) *why = "an older incarnation";
+  else return true;
+  return false;
+}
+// RESTORED (P5): ARMED of the new incarnation only when the communicator is still armed, no DISARM of the peer arrived
+// while it was held, and its new spare is registered at the buddy (work package 5); else OFF.
+static uint32_t gdakiHoldRestoredState(bool commArmed, bool disarmDuringHold, bool respareRegistered) {
+  return (commArmed && !disarmDuringHold && respareRegistered) ? GDAKI_HOLD_ARMED : GDAKI_HOLD_OFF;
+}
+
+// ---- the cell's moves: every compare-and-swap the host code makes (the unit test runs these same functions) ----
+// The end of a hold: any held state -> `to` (FALLBACK or CANCELLED), whatever the watcher moved meanwhile (HELD or
+// PUBLISHED to their timed-out states: still this move). True when it moved; *from and *inc: the state it left (or found,
+// when it did not move) and its incarnation.
+static bool gdakiHoldEndMove(struct gdakiHoldCell& c, uint32_t to, uint32_t* from, uint32_t* inc) {
+  uint64_t v = gdakiHoldLoad(c);
+  bool moved = false;
+  while (gdakiHoldIsHeldState(gdakiHoldStateOf(v)))
+    if (gdakiHoldCas(c, v, gdakiHoldPack(to, gdakiHoldIncOf(v)))) {
+      moved = true;
+      break;
+    }
+  *from = gdakiHoldStateOf(v);
+  *inc = gdakiHoldIncOf(v);
+  return moved;
+}
+// The restore round's compare-and-swap (N1), right after the released-waits check and before the commit point: a peer
+// that is not held is not a restore round (go on); a held one goes on only from HELD -> COMMITTING (false: the watcher's
+// deadline won, or the hold is not in HELD: nothing may be published).
+static bool gdakiHoldCommitMove(struct gdakiHoldCell& c) {
+  uint64_t v = gdakiHoldLoad(c);
+  const uint32_t s = gdakiHoldStateOf(v);
+  if (!gdakiHoldIsHeldState(s)) return true;
+  return s == GDAKI_HOLD_HELD && gdakiHoldCas(c, v, gdakiHoldPack(GDAKI_HOLD_COMMITTING, gdakiHoldIncOf(v)));
+}
+// After the restore round's last publish (P1): COMMITTING -> PUBLISHED, its deadline stored first (release; the watcher
+// loads the state, then the deadline). False: not COMMITTING (not a restore round), nothing written.
+static bool gdakiHoldPublishMove(struct gdakiHoldCell& c, int64_t deadlineUs) {
+  uint64_t v = gdakiHoldLoad(c);
+  if (gdakiHoldStateOf(v) != GDAKI_HOLD_COMMITTING) return false;
+  c.deadlineUs.store(deadlineUs, std::memory_order_release);
+  return gdakiHoldCas(c, v, gdakiHoldPack(GDAKI_HOLD_PUBLISHED, gdakiHoldIncOf(v)));  // only the helper moves COMMITTING
+}
+// The watcher (G8): the move its deadline makes, only when its compare-and-swap wins (W_TIMEOUT_HELD: the caller then
+// makes the CPU writes; W_TIMEOUT_PUBLISHED: the state alone; W_NONE: nothing, also when the helper moved first).
+static int gdakiHoldWatchMove(struct gdakiHoldCell& c, int64_t nowUs, uint32_t* inc) {
+  uint64_t v = gdakiHoldLoad(c);
+  const int a = gdakiHoldWatchdogAction(gdakiHoldStateOf(v), c.deadlineUs.load(std::memory_order_acquire), nowUs);
+  *inc = gdakiHoldIncOf(v);
+  if (a == GDAKI_HOLD_W_TIMEOUT_HELD)
+    return gdakiHoldCas(c, v, gdakiHoldPack(GDAKI_HOLD_TIMED_OUT_HELD, gdakiHoldIncOf(v))) ? a : GDAKI_HOLD_W_NONE;
+  if (a == GDAKI_HOLD_W_TIMEOUT_PUBLISHED)
+    return gdakiHoldCas(c, v, gdakiHoldPack(GDAKI_HOLD_TIMED_OUT_PUBLISHED, gdakiHoldIncOf(v))) ? a : GDAKI_HOLD_W_NONE;
+  return GDAKI_HOLD_W_NONE;
+}
+// The spare's RESTORED with pad = i + 1 (Q2): PUBLISHED or TIMED_OUT_PUBLISHED of incarnation i -> `next` (ARMED or OFF,
+// gdakiHoldRestoredState) of i + 1; when the watcher moves PUBLISHED meanwhile, decided again on what it holds. True when
+// it moved; *from and *inc as in gdakiHoldEndMove.
+static bool gdakiHoldRestoreMove(struct gdakiHoldCell& c, uint32_t pad, uint32_t next, uint32_t* from, uint32_t* inc) {
+  uint64_t v = gdakiHoldLoad(c);
+  for (;;) {
+    struct gdakiHoldMsgIn in;
+    in.restored = true;
+    in.state = gdakiHoldStateOf(v);
+    in.inc = gdakiHoldIncOf(v);
+    in.msgInc = pad;
+    *from = in.state;
+    *inc = in.inc;
+    if (gdakiHoldMsgAction(in) != GDAKI_HOLD_M_RESTORED) return false;
+    if (gdakiHoldCas(c, v, gdakiHoldPack(next, in.inc + 1u))) return true;
+  }
+}
+
+// The records of a peer's park the state machine handles itself, in arrival order (R1): DISARM, NOHOLD, HOLDING, a
+// FALLBACK about another rank, and the spare's RESTORED (its type: restoredType). A FALLBACK about this rank (a spare
+// process told by a survivor) and every other type stay parked for their owners.
+static bool gdakiHoldDrainTakes(uint32_t type, int arg, int me, uint32_t restoredType) {
+  return type == GDAKI_TS_DISARM || type == GDAKI_TS_NOHOLD || type == GDAKI_TS_HOLDING ||
+         (type == GDAKI_TS_FALLBACK && arg != me) || type == restoredType;
+}
+
+// A wait for one record that parks the restore's records (rs_hold_api.h's rule, M1): the first receive gets firstMs
+// unchanged (hk's bound); after a parked record the wait goes on to the same end (what is left, rounded up). recv(ms):
+// 1 a record, 0 none in time, < 0 the socket failed; park(): true if the record just read was parked. Without hold
+// state park() is always false: the first record decides, as hk.
+template <typename Recv, typename Park, typename Now>
+static int gdakiHoldRecvParked(int firstMs, Recv recv, Park park, Now nowMs) {
+  const double end = nowMs() + firstMs;
+  int got = recv(firstMs);
+  while (got == 1 && park()) {
+    const double left = end - nowMs();
+    got = recv(left > 0 ? (int)left + (left > (double)(int)left ? 1 : 0) : 0);
+  }
+  return got;
+}
+
+// The time the parked device threads of the peer started their clock (the HELD deadline's second term): the earliest of
+// the quiesce of the hold start, the oldest fault record of the peer still in the helper's hands (device waiters park at
+// their error CQE, before any gate goes odd), and, when the gates were already odd at the hold start, the time they went
+// odd (a quiesce of an earlier round: oddSinceMs) or the checkpoint pause's start. 0 for "none" in the optional inputs.
+// < 0: the gates were odd and nothing says since when (the caller falls back).
+static double gdakiHoldGateOddMs(double quiesceMs, bool wasOdd, double oldestRecordMs, double oddSinceMs, double pauseMs) {
+  double t = quiesceMs;
+  if (oldestRecordMs > 0 && oldestRecordMs < t) t = oldestRecordMs;
+  if (!wasOdd) return t;
+  if (oddSinceMs <= 0 && pauseMs <= 0) return -1.0;
+  if (oddSinceMs > 0 && oddSinceMs < t) t = oddSinceMs;
+  if (pauseMs > 0 && pauseMs < t) t = pauseMs;
+  return t;
+}
+
+// The records parked for one peer (the rule of rs_hold_api.h), in arrival order. M: the record type (gdakiTsMsg in the
+// host file), with a `type` field.
+template <typename M>
+struct gdakiHoldPark {
+  struct Item {
+    M m;
+    double atMs;
+  };
+  std::vector<struct Item> q;
+  uint64_t dropped = 0;
+  // false: the park was full and its oldest record was dropped to make room (*droppedType: its type)
+  bool push(const M& m, double nowMs, uint32_t* droppedType) {
+    bool ok = true;
+    if (q.size() >= (size_t)GDAKI_HOLD_PARK_MAX) {
+      *droppedType = q.front().m.type;
+      q.erase(q.begin());
+      dropped++;
+      ok = false;
+    }
+    q.push_back({m, nowMs});
+    return ok;
+  }
+  // the oldest record for which pick(m) is true
+  template <typename P>
+  bool takeIf(P pick, M* out) {
+    for (size_t i = 0; i < q.size(); i++)
+      if (pick(q[i].m)) {
+        *out = q[i].m;
+        q.erase(q.begin() + (long)i);
+        return true;
+      }
+    return false;
+  }
+  bool take(uint32_t type, M* out) {
+    return takeIf([&](const M& m) { return m.type == type; }, out);
+  }
+  // drop records older than ageMs; returns how many (*oneType: the type of one of them)
+  int expire(double nowMs, double ageMs, uint32_t* oneType) {
+    int n = 0;
+    for (size_t i = 0; i < q.size();)
+      if (nowMs - q[i].atMs > ageMs) {
+        *oneType = q[i].m.type;
+        q.erase(q.begin() + (long)i);
+        n++;
+        dropped++;
+      } else {
+        i++;
+      }
+    return n;
+  }
+};
+
+// The buddy's count of the survivors that hold subject p (9.10.5 "모두 함께": activation only once every survivor holds
+// it). A HOLDING of a newer incarnation starts the count again; an older one is stale.
+struct gdakiHoldHolders {
+  bool any = false;
+  uint32_t inc = 0;
+  std::vector<uint8_t> by;  // by rank
+  bool activated = false;   // the spare was activated for inc
+};
+static bool gdakiHoldHoldersAdd(struct gdakiHoldHolders& h, int nranks, int holder, uint32_t inc) {
+  if (holder < 0 || holder >= nranks) return false;
+  if (h.any && inc < h.inc) return false;
+  if (!h.any || inc > h.inc) {
+    h.any = true;
+    h.inc = inc;
+    h.by.assign((size_t)nranks, 0);
+    h.activated = false;
+  }
+  h.by[(size_t)holder] = 1;
+  return true;
+}
