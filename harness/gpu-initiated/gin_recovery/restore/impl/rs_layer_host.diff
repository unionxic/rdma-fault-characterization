+// fail-fast (hk's G1), whatever the decision.
+NCCL_PARAM(GinRestore, "GIN_RESTORE", 1);       // gin-restore: 0 = no restore under hold (hold, never armed)
+extern int64_t ncclParamRMADisable();           // rma/rma.cc
+extern int64_t ncclParamSymGinKernelsEnable();  // sym_kernels.cc
