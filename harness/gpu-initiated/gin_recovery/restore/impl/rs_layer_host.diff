+    {GDAKI_RS_SYMGIN, "NCCL_SYM_GIN_KERNELS_ENABLE is not 0 (NCCL's symmetric kernels would make their own GIN devComm)"},
+    {GDAKI_RS_STRIDE, "the devComm's GIN rank stride is above 1 (its contexts do not reach every rank)"},
+  };
+  for (const auto& f : facts)
