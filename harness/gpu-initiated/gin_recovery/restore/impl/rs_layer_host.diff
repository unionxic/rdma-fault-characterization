+// helper-socket record types of the host branch (rs_hold_api.h has 11..19): the data socket's first record
+#define GDAKI_TS_DATA 20u
+enum : uint32_t { GDAKI_CKPT_UPLOAD = 1, GDAKI_CKPT_FETCH = 2, GDAKI_CKPT_STATE = 3 };  // GDAKI_TS_DATA's pad
+
+// The checkpoint records' fields (helper socket; from, nonce as every record):
+//   CKPT_PAUSE   r -> q: arg = r, round = the checkpoint
+//   PAUSED       q -> r: arg = r, round = the checkpoint, pad = GDAKI_CKPT_PAUSED_*, nqp = q's QPs to r (GIN-context
+//                order); per QP i: tok.epochWqes[i] = M (request messages q posted to r), executed[i] and nrp[i] = the low
+//                and high 32 bits of P (q's cumulative executed count of r's messages)
+//   BUSY         q -> r: arg = r, round = the checkpoint, pad = GDAKI_CKPT_BUSY_* (r skips this checkpoint)
+//   CKPT_RESUME  r -> q: arg = r, round = the checkpoint, pad = 1 when r gave the checkpoint up (q unpauses either way and
+//                does not confirm)
+//   PAUSED again q -> r, the confirmation after CKPT_RESUME: pad = GDAKI_CKPT_PAUSED_HELD, nqp = 0; or BUSY (VOIDED)
+//   CKPT_STABLE  r -> every rank: arg = r, round = the checkpoint, pad = GDAKI_CKPT_STABLE_ARMABLE when every PAUSED was
+//                armable and the buddy holds r's spare registration
+#define GDAKI_CKPT_PAUSED_ARMABLE 0x1u   // q can take part in restoring r (its arming conditions, its log toward r complete)
+#define GDAKI_CKPT_PAUSED_FIRST 0x2u     // this pause started q's log toward r
+#define GDAKI_CKPT_PAUSED_HELD 0x4u      // the confirmation: q's pause held until CKPT_RESUME; its empty round is published
+enum : uint32_t {
+  GDAKI_CKPT_BUSY_HOLD = 1,      // q holds a peer (a restore runs)
+  GDAKI_CKPT_BUSY_SUPPRESS = 2,  // q is a restored rank still holding back replayed messages (P4)
+  GDAKI_CKPT_BUSY_DECLINED = 3,  // q declined r, or a fault already reached the application on q
+  GDAKI_CKPT_BUSY_PAUSE = 4,     // q's pause failed (quiesce, the log's or the executed count's read)
+  GDAKI_CKPT_BUSY_OFF = 5,       // q has no hold state (it does not ask for the restore)
+  GDAKI_CKPT_BUSY_VOIDED = 6,    // q's pause did not hold until CKPT_RESUME (a round or a decline with r, or its bound
+                                 // NCCL_GIN_RESTORE_PAUSE_MS ended it): the checkpoint is discarded
+  GDAKI_CKPT_BUSY_ROUND = 7,     // q has a round with r pending (gates odd from an earlier quiesce, or a queued fault)
+};
+#define GDAKI_CKPT_STABLE_ARMABLE 0x1u
+
+// The data socket's image stream (UPLOAD, FETCH). The image is the concatenation of the regions in this order, each
+// starting at a 256-byte boundary of the image; blocks are GDAKI_CKPT_BLOCK bytes of the image (the last one shorter).
+#define GDAKI_CKPT_MAGIC 0x43535247u  // "GRSC"
+#define GDAKI_CKPT_VERSION 1u
+#define GDAKI_CKPT_BLOCK (64u * 1024u)
+#define GDAKI_CKPT_MAX_REGIONS 64
+#define GDAKI_CKPT_MAX_PEERS 64
+#define GDAKI_CKPT_MAX_BLOB (1u << 20)
+#define GDAKI_CKPT_QPS 64             // NCCL_GIN_RECOVERY_MAX_QPS
+enum : uint32_t {
+  GDAKI_CKPT_REGION_WINDOW = 1,     // a window registered on the context's collComm: id = its number (rsWinId)
+  GDAKI_CKPT_REGION_REGISTERED = 2, // an ncclGinRestoreRegister buffer: id = its registration order on the communicator
+  GDAKI_CKPT_REGION_SIGNALS = 3,    // the context's signal table (this rank's part): id 0
+  GDAKI_CKPT_REGION_COUNTERS = 4,   // the context's counter table: id 0
+};
+struct gdakiCkptRegion {
+  uint32_t kind, id;
+  uint64_t offset;  // in the image (256-byte aligned)
+  uint64_t bytes;
+};
+struct gdakiCkptPeerP {  // what PAUSED told r: per QP of q to r, P (q's executed count of r's messages at the cut)
+  int32_t rank;
+  uint32_t nqp;
+  uint64_t p[GDAKI_CKPT_QPS];
+};
+struct gdakiCkptHdr {
+  uint32_t magic, version;          // GDAKI_CKPT_MAGIC, GDAKI_CKPT_VERSION
+  int32_t rank;                     // r
+  uint32_t incarnation;             // r's incarnation
+  uint64_t nonce;                   // the GIN context's nonce
+  uint64_t ckpt;                    // the checkpoint (= the step it was taken at)
+  uint64_t baseCkpt;                // UPLOAD: the stable checkpoint the changed blocks apply to (~0: none, every block)
+  uint64_t imageBytes;
+  uint32_t blockBytes;              // GDAKI_CKPT_BLOCK
+  uint32_t nRegions;
+  uint64_t nChanged;                // blocks that follow
+  uint32_t blobBytes;               // the application's blob (after the blocks, before the end record)
+  uint32_t nPeers;                  // entries of peerP used
+  uint8_t spareAddr[32];            // r's spare (NCCL_GIN_RESTORE_SPARE_ADDR), a union ncclSocketAddress (zero: none)
+  int64_t pid;                      // r's process (the spare's PID check)
+  uint64_t pidStart;                // its start time, /proc/<pid>/stat field 22
+  struct gdakiCkptRegion region[GDAKI_CKPT_MAX_REGIONS];
+  struct gdakiCkptPeerP peerP[GDAKI_CKPT_MAX_PEERS];
+};
+struct gdakiCkptEnd {
+  uint32_t magic, ok;               // GDAKI_CKPT_MAGIC; 1
+  uint64_t imageHash;               // FETCH: a hash of the whole image (gdakiCkptHash over imageBytes)
+};
+struct gdakiCkptAck {
+  uint32_t magic, ok;               // GDAKI_CKPT_MAGIC; 1: stored (UPLOAD) / 0: refused (FETCH: no such checkpoint)
+  uint64_t ckpt;
+  char why[112];
+};
+// The block hash (64 bits, FNV-1a over 8-byte words, then a finalizer); the uploader sends the blocks whose hash
+// differs from the last stable image's, and the FETCH end record carries the hash of the whole image.
+static inline uint64_t gdakiCkptHash(const void* p, size_t n, uint64_t h) {
+  const unsigned char* b = (const unsigned char*)p;
+  size_t i = 0;
+  for (; i + 8 <= n; i += 8) {
+    uint64_t w = 0;
+    for (int k = 0; k < 8; k++) w |= (uint64_t)b[i + k] << (8 * k);
+    h = (h ^ w) * 0x100000001b3ULL;
+  }
+  for (; i < n; i++) h = (h ^ b[i]) * 0x100000001b3ULL;
+  h ^= h >> 33;
+  h *= 0xff51afd7ed558ccdULL;
+  h ^= h >> 33;
+  return h;
+}
+#define GDAKI_CKPT_HASH_SEED 0xcbf29ce484222325ULL
+#define GDAKI_CKPT_STATE_MAX (1ULL << 30)  // a STATE's export, bytes at most
+// ---- shared text (end) ----
+
+// ---- gin-restore ckpt: pure functions (begin; impl/rs_unit_host.cc compiles this region on the CPU) ----
+// The checkpoint's decisions and bookkeeping (EXPERIMENT.md 9.4, 9.11.9 C1, M3), as functions of plain values.
+
+// The checkpoint's helper-socket records (CKPT_PAUSE .. CKPT_STABLE): the hold machine's drain hands them over in arrival
+// order per peer (with its own types, R1).
+static bool gdakiCkptIsRecord(uint32_t type) { return type >= GDAKI_TS_CKPT_PAUSE && type <= GDAKI_TS_CKPT_STABLE; }
+
+// Step(step) takes a checkpoint at the first call and then once `interval` steps passed since the last one taken (the
+// caller adds the back-off after a skipped one: a quarter interval).
+static bool gdakiCkptDue(uint64_t step, bool haveLast, uint64_t lastStep, uint64_t interval) {
+  if (!haveLast) return true;
+  if (interval == 0) interval = 1;
+  return step >= lastStep && step - lastStep >= interval;
+}
+// The drain check of the checkpointing rank r (9.4 step 3, 9.6): per QP of peer q's to r, r's cumulative executed count
+// of q's messages (x) against what q posted (m, its PAUSED). Every x == m: drained. Some x < m: wait. Some x > m: the
+// counts do not match (a baseline went wrong, or q posted after its pause): the checkpoint is void.
+enum { GDAKI_CKPT_DRAINED = 0, GDAKI_CKPT_DRAIN_WAIT = 1, GDAKI_CKPT_DRAIN_VOID = 2 };
+static int gdakiCkptDrainVerdict(const uint64_t* x, const uint64_t* m, int n) {
+  bool wait = false;
+  for (int i = 0; i < n; i++) {
+    if (x[i] > m[i]) return GDAKI_CKPT_DRAIN_VOID;
+    if (x[i] < m[i]) wait = true;
+  }
+  return wait ? GDAKI_CKPT_DRAIN_WAIT : GDAKI_CKPT_DRAINED;
+}
+// The image's layout: region i at off[i] (256-byte aligned), the total size; false when too large (1 TiB).
+static bool gdakiCkptLayout(const uint64_t* bytes, int n, uint64_t* off, uint64_t* total) {
+  uint64_t o = 0;
+  for (int i = 0; i < n; i++) {
+    o = (o + 255) & ~(uint64_t)255;
+    off[i] = o;
+    if (bytes[i] > (1ULL << 40) || o + bytes[i] > (1ULL << 40)) return false;
+    o += bytes[i];
+  }
+  *total = o;
+  return true;
+}
+static uint64_t gdakiCkptNBlocks(uint64_t imageBytes) {
+  return (imageBytes + GDAKI_CKPT_BLOCK - 1) / GDAKI_CKPT_BLOCK;
+}
+static uint64_t gdakiCkptBlockLen(uint64_t i, uint64_t imageBytes) {
+  const uint64_t o = i * GDAKI_CKPT_BLOCK;
+  if (o >= imageBytes) return 0;
+  return imageBytes - o < GDAKI_CKPT_BLOCK ? imageBytes - o : GDAKI_CKPT_BLOCK;
+}
+// The blocks to upload: those whose hash differs from the base's (every block without a base or with another size).
+static std::vector<uint64_t> gdakiCkptChanged(const std::vector<uint64_t>& base, bool haveBase,
+                                              const std::vector<uint64_t>& cur) {
+  std::vector<uint64_t> v;
+  const bool full = !haveBase || base.size() != cur.size();
+  for (uint64_t i = 0; i < (uint64_t)cur.size(); i++)
+    if (full || base[(size_t)i] != cur[(size_t)i]) v.push_back(i);
+  return v;
+}
+// PAUSED carries P (64 bits) per QP in two 32-bit fields
+static void gdakiCkptPackP(uint64_t p, uint32_t* lo, uint32_t* hi) {
+  *lo = (uint32_t)p;
+  *hi = (uint32_t)(p >> 32);
+}
+static uint64_t gdakiCkptUnpackP(uint32_t lo, uint32_t hi) { return ((uint64_t)hi << 32) | lo; }
+
+// q's answer to CKPT_PAUSE from r (9.11.9 C1, P4, V18): 0 = pause; else a GDAKI_CKPT_BUSY_* reason.
+// roundPending: a round with r is pending (its gates are odd from an earlier quiesce not published yet, or a fault record
+// of a QP to r waits in the helper's queue): 9.4 step 2, "q가 라운드 중이면 BUSY".
+static uint32_t gdakiCkptBusyReason(bool hasHoldState, bool holdActive, bool suppressLeft, bool declined, bool told,
+                                    bool roundPending) {
+  if (!hasHoldState) return GDAKI_CKPT_BUSY_OFF;
+  if (declined || told) return GDAKI_CKPT_BUSY_DECLINED;
+  if (holdActive) return GDAKI_CKPT_BUSY_HOLD;
+  if (roundPending) return GDAKI_CKPT_BUSY_ROUND;
+  if (suppressLeft) return GDAKI_CKPT_BUSY_SUPPRESS;
+  return 0;
+}
+// q's answer to CKPT_RESUME (9.11.9 C1): publish the empty round and confirm (the pause held), or VOIDED (a round or a
+// decline with r since the pause, or the pause's bound ended it early), or nothing (no pause of that checkpoint, or r gave
+// it up: unpause without a confirmation).
+enum { GDAKI_CKPT_R_IGNORE = 0, GDAKI_CKPT_R_HELD = 1, GDAKI_CKPT_R_VOIDED = 2, GDAKI_CKPT_R_UNPAUSE = 3 };
+static int gdakiCkptResumeVerdict(bool paused, uint64_t pausedCkpt, uint64_t ckpt, bool rGaveUp, bool declined,
+                                  bool epochUnchanged, bool gateStillOdd) {
+  if (!paused || pausedCkpt != ckpt) return GDAKI_CKPT_R_IGNORE;
+  if (rGaveUp) return (declined || !epochUnchanged || !gateStillOdd) ? GDAKI_CKPT_R_IGNORE : GDAKI_CKPT_R_UNPAUSE;
+  if (declined || !epochUnchanged || !gateStillOdd) return GDAKI_CKPT_R_VOIDED;
+  return GDAKI_CKPT_R_HELD;
+}
+// The gates of a peer against its input pause (9.11.9 C1; gdakiCkptPauseState reads the facts): ENDED when something
+// else ended the pause (a decline, a round since: every round quiesces the peer first; a changed epoch; or no gate was
+// ever made odd), INTACT when every gate still shows the pause's odd epoch, BROKEN when a gate could not be read or only
+// some gates show it (nothing else will publish them: the caller declines).
+enum { GDAKI_CKPT_P_INTACT = 0, GDAKI_CKPT_P_ENDED = 1, GDAKI_CKPT_P_BROKEN = 2 };
+static int gdakiCkptPauseVerdict(bool declined, bool roundSince, bool epochSame, bool readFail, bool allOdd, bool anyOdd) {
+  if (declined || roundSince || !epochSame) return GDAKI_CKPT_P_ENDED;
+  if (readFail) return GDAKI_CKPT_P_BROKEN;
+  if (allOdd) return GDAKI_CKPT_P_INTACT;
+  return anyOdd ? GDAKI_CKPT_P_BROKEN : GDAKI_CKPT_P_ENDED;
+}
+
+// G6 (M3): the covered epoch of a QP. An empty round (the end of a checkpoint's input pause) publishes epoch + 2 without
+// covering a fault: the covered epoch stays where it was. Every other publish (a real round, a decline) changes the epoch to
+// a value no empty round made, so it is covered again. emptyTop: the epoch the last empty round published; emptyBase: the
+// covered epoch then.
+static uint32_t gdakiCkptCovered(uint32_t epoch, bool emptyValid, uint32_t emptyTop, uint32_t emptyBase) {
+  return (emptyValid && epoch == emptyTop) ? emptyBase : epoch;
+}
+// After an empty round from `before` (even): the new bookkeeping (a run of empty rounds keeps the first base).
+static void gdakiCkptAfterEmpty(uint32_t before, bool* emptyValid, uint32_t* emptyTop, uint32_t* emptyBase) {
+  const uint32_t base = gdakiCkptCovered(before, *emptyValid, *emptyTop, *emptyBase);
+  *emptyValid = true;
+  *emptyTop = before + 2u;
+  *emptyBase = base;
+}
+
+// The checkpointing rank's view of one checkpoint's replies (helper thread): every peer answers PAUSED or BUSY once,
+// then (after CKPT_RESUME) confirms (HELD) or voids.
+struct gdakiCkptReplies {
+  int n = 0;  // ranks (this rank's slot stays "replied")
+  std::vector<uint8_t> state;  // 0 waiting, 1 paused, 2 busy, 3 confirmed held, 4 voided
+  std::vector<uint8_t> armable;
+  std::vector<uint8_t> sent;   // CKPT_PAUSE went to it (a give-up releases every such peer that did not answer BUSY)
+  void reset(int nranks, int self) {
+    n = nranks;
+    state.assign((size_t)nranks, 0);
+    armable.assign((size_t)nranks, 0);
+    sent.assign((size_t)nranks, 0);
+    if (self >= 0 && self < nranks) state[(size_t)self] = 3, armable[(size_t)self] = 1;
+  }
+  bool allPausedOrBusy() const {
+    for (int q = 0; q < n; q++)
+      if (state[(size_t)q] == 0) return false;
+    return true;
+  }
+  bool anyBusy() const {
+    for (int q = 0; q < n; q++)
+      if (state[(size_t)q] == 2 || state[(size_t)q] == 4) return true;
+    return false;
+  }
+  bool allConfirmed() const {
+    for (int q = 0; q < n; q++)
+      if (state[(size_t)q] != 3) return false;
+    return true;
+  }
+  bool allArmable() const {
+    for (int q = 0; q < n; q++)
+      if (!armable[(size_t)q]) return false;
+    return true;
+  }
+  // a give-up sends CKPT_RESUME(given up) to q: it was sent CKPT_PAUSE and did not answer BUSY (it is paused, or its
+  // PAUSED is on the way)
+  bool releaseOnAbort(int q) const {
+    return q >= 0 && q < n && sent[(size_t)q] && (state[(size_t)q] == 0 || state[(size_t)q] == 1);
+  }
+};
+// The application's stable step (9.4, 9.7 12): Step(t) records (t, the log head read then); step t is stable once every
+// entry below that head is covered (dev's gdakiRsStableStepOf). The list keeps the records not yet stable and the last
+// stable step; at most `cap` records (the oldest go: a later step then reports stable instead, never an earlier one wrongly).
+struct gdakiCkptStepLog {
+  std::vector<uint64_t> steps, heads;
+  bool haveStable = false;
+  uint64_t stable = 0;
+  void add(uint64_t step, uint64_t head, size_t cap) {
+    steps.push_back(step);
+    heads.push_back(head);
+    if (steps.size() > cap) {
+      steps.erase(steps.begin());
+      heads.erase(heads.begin());
+    }
+  }
+  // drop the records up to and including the stable one `s` (when s is one of them), remember s
+  void settle(uint64_t s, uint64_t none) {
+    if (s == none) return;
+    haveStable = true;
+    stable = s;
+    size_t k = 0;
+    while (k < steps.size() && steps[k] <= s) k++;
+    steps.erase(steps.begin(), steps.begin() + (long)k);
+    heads.erase(heads.begin(), heads.begin() + (long)k);
+  }
+};
