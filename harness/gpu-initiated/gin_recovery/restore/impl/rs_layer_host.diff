+}
+// gdakiTsQuiesce's first statement (helper): the gates of `peer` go odd now unless they are odd already (a quiesce of a
+// round that was cancelled keeps them odd until a publish makes them even: gdakiHoldAfterPublish clears it). No hold
+// state: nothing.
+static void gdakiHoldGateOdd(struct gdakiRecHost* r, int peer) {
+  struct gdakiHold* h = gdakiHoldOf(r);
+  if (!gdakiHoldPeerOk(h, peer)) return;
+  h->peers[peer].quiesceSeq++;
+  if (h->peers[peer].oddSinceMs == 0) h->peers[peer].oddSinceMs = gdakiQ4MonoMs();
+}
+// The hold start (9.10.7 "hold의 시작", F8, V10), inside gdakiTsBusy, with a heartbeat at each step:
+//   0 the state HELD first (so G9 charges a firmware overrun of the 2ERR below to PeerDead, N3), the deadline not yet set;
+//   1 scope: every context; 2 a prepared round with the peer is aborted; 3 gdakiTsQuiesce as it is (gate odd, 2ERR, count
+//   0, held WQEs rung, abandoned checked); 4 deadJudged and failedPending cleared; 5 the time the gate first went odd, the
+//   counts the state transfer needs (X, M, the log's head; the QPs quiesced), the deadline; 6 HOLDING(p, i) to the buddy
+//   (after a last look at the state: the deadline may have won). Any failure is the fallback. Nothing reaches the
+//   application: no word, no async error, no degraded raise, no decline line (the death's own lines stay: detection).
+static void gdakiHoldStart(struct gdakiRecHost* r, int p, const char* why, uint64_t v) {
+  struct gdakiHold* h = gdakiHoldOf(r);
+  struct gdakiTs* ts = r->ts;
+  struct gdakiTsPeer& pe = ts->peers[p];
+  struct gdakiHoldPeer& hp = h->peers[p];
+  const uint32_t inc = gdakiHoldIncOf(v);
+  gdakiTsBusy busy(ts);
+  h->cells[p].deadlineUs.store(0, std::memory_order_release);
+  uint64_t e = v;
+  if (!gdakiHoldCas(h->cells[p], e, gdakiHoldPack(GDAKI_HOLD_HELD, inc))) {  // only the helper moves ARMED: cannot happen
+    WARN("GIN/RS: rank %d: rank %d's state changed under the hold start (%s); declined as hk", h->rank, p,
+         gdakiHoldStateName(gdakiHoldStateOf(e)));
+    gdakiTsDecline(r, p, why, false, 0, gdakiCause::PeerDead, GDAKI_UA_PEER_DEAD);
+    return;
+  }
+  h->heldPeer.store(p, std::memory_order_release);
+  const double t0 = gdakiQ4MonoMs();
+  hp.holdStartMs = t0;
+  hp.gateOddMs = 0;
+  hp.rejoinMs = hp.publishMs = 0;
+  hp.phase = GDAKI_HOLD_P_REJOIN;
+  gdakiHoldXferClose(hp);
+  hp.pendingFallback = false;
+  hp.disarmDuringHold = false;
+  hp.countsRead = false;
+  delete hp.rkeys;  // a list of an earlier restore is never used for this one
+  hp.rkeys = nullptr;
+  h->nHolds.fetch_add(1, std::memory_order_relaxed);
+  GIN_TS_NOTE("GIN/RS: rank %d: rank %d (incarnation %u) is held for a restore instead of a decline (%s; cause=%s) "
+              "mono_ms=%.3f", h->rank, p, inc, why, pe.lostCause, t0);
+  gdakiTsScope = GDAKI_TS_SCOPE_ALL;  // 1, as the decline does
+  bool wasOdd = false, readOk = true;
+  gdakiRecForPeer(r, p, [&](gdakiRecQp&, struct doca_gpu_verbs_qp_hl* q) {
+    uint64_t w = 0;
+    if (gdakiTsWordRead(r, q->qp_gverbs, &w) != ncclSuccess) readOk = false;
+    else if ((((uint32_t)(w >> 32)) & 1u) != 0) wasOdd = true;
+  });
+  if (!readOk) return gdakiHoldFallback(r, p, "a gate of the peer could not be read at the hold start");
+  const double oddBefore = hp.oddSinceMs;  // what an earlier quiesce recorded (gdakiTsQuiesce below records tQ if 0)
+  if (gdakiRecPrepared(r, p) == 1) (void)ncclGinRecoverAbort((ncclComm_t)r->commKey, p);  // 2
+  ts->heartbeatUs.store(gdakiTsNowUs(), std::memory_order_release);
+  const double tQ = gdakiQ4MonoMs();
+  const char* qwhy = nullptr;
+  uint32_t rung = 0;
+  if (gdakiTsQuiesce(r, p, &qwhy, &rung) != ncclSuccess)  // 3
+    return gdakiHoldFallback(r, p, qwhy ? qwhy : "the quiesce failed");
+  ts->heartbeatUs.store(gdakiTsNowUs(), std::memory_order_release);
+  pe.deadJudged = false;  // 4
+  pe.failedPending = false;
+  gdakiCkptOnHoldStart(r, p);  // work package 5: an input pause toward the peer ends here (the hold owns its gates)
+  // 5: the parked device threads' clock (the oddSinceMs read before this quiesce set it, if the gates were even)
+  hp.gateOddMs = gdakiHoldGateOddMs(tQ, wasOdd, gdakiHoldOldestRecordMs(r, p), oddBefore, hp.pauseStartMs);
+  hp.pauseStartMs = 0;  // used: a later hold of this peer starts from its own facts
+  if (hp.gateOddMs < 0)
+    return gdakiHoldFallback(r, p, "the peer's gates were odd at the hold start and nothing says since when");
+  {
+    uint64_t m[NCCL_GIN_RECOVERY_MAX_QPS] = {}, x[NCCL_GIN_RECOVERY_MAX_QPS] = {};
+    int nm = 0, nx = 0;
+    uint64_t head = 0;
+    if (gdakiRsExecRead(r, p, x, &nx) != ncclSuccess || gdakiRsLogReadMsgs(r, p, m, &nm) != ncclSuccess ||
+        gdakiRsLogReadHead(r, &head) != ncclSuccess || nx != nm || nx <= 0 || nx > NCCL_GIN_RECOVERY_MAX_QPS)
+      return gdakiHoldFallback(r, p, "the counts of the hold start (executed, sent, the log's head) could not be read");
+    hp.nqp = nx;
+    memcpy(hp.xAtHold, x, sizeof(x));
+    memcpy(hp.mAtHold, m, sizeof(m));
+    hp.headAtHold = head;
+    hp.countsRead = true;
+  }
+  ts->heartbeatUs.store(gdakiTsNowUs(), std::memory_order_release);
+  const int64_t shareMs = std::min<int64_t>(ts->roundMs / 2, 4LL * r->copyMs);
+  const int64_t dl = gdakiHoldHeldDeadlineUs((int64_t)(t0 * 1000.0), (int64_t)(hp.gateOddMs * 1000.0),
+                                             (int64_t)ncclParamGinRestoreMs(), ts->holdMs, shareMs, 1000);
+  hp.deviceBoundUs = gdakiHoldDeviceBoundUs((int64_t)(hp.gateOddMs * 1000.0), ts->holdMs, shareMs, 1000);
+  if (dl <= (int64_t)(gdakiQ4MonoMs() * 1000.0))
+    return gdakiHoldFallback(r, p, "no time left before the parked device threads' bound (NCCL_GIN_TS_HOLD_MS)");
+  h->cells[p].deadlineUs.store(dl, std::memory_order_release);
+  if (gdakiHoldStateOf(gdakiHoldLoad(h->cells[p])) != GDAKI_HOLD_HELD)  // 6: the watcher's deadline won meanwhile
+    return gdakiHoldFallback(r, p, "the restore deadline passed during the hold start");
+  const int b = gdakiHoldBuddyOf(p, h->nranks);
+  if (b == h->rank) {
+    (void)gdakiHoldHoldersAdd(hp.holders, h->nranks, h->rank, inc);
+  } else {
+    struct gdakiTsMsg m;
+    gdakiHoldMsgInit(&m, GDAKI_TS_HOLDING, p, inc);
+    if (gdakiHoldSend(r, b, &m) != 0) return gdakiHoldFallback(r, p, "HOLDING could not be sent to the peer's buddy");
+  }
+  GIN_TS_NOTE("GIN/RS: rank %d: hold of rank %d started: gates odd since %.1f ms before the start, %u WQE(s) rung, "
+              "deadline in %.0f ms, HOLDING to buddy rank %d, %d QP(s) (executed/sent at the hold: %lu/%lu) mono_ms=%.3f",
+              h->rank, p, t0 - hp.gateOddMs, rung, (double)(dl - (int64_t)(gdakiQ4MonoMs() * 1000.0)) / 1000.0, b, hp.nqp,
+              (unsigned long)hp.xAtHold[0], (unsigned long)hp.mAtHold[0], gdakiQ4MonoMs());
+}
+
+// G2 (gdakiTsDecline's first statement).
+static bool gdakiHoldOnDecline(struct gdakiRecHost* r, int peer, const char* why, gdakiCause cause, int uaWhy) {
+  (void)cause;
+  struct gdakiHold* h = gdakiHoldOf(r);
+  if (!gdakiHoldPeerOk(h, peer) || r->ts == nullptr) return false;
+  struct gdakiTs* ts = r->ts;
+  struct gdakiTsPeer& pe = ts->peers[peer];
+  gdakiCkptPauseGatesEnded(r, peer);  // work package 5: a decline (or a hold start) ends an input pause's length here
+  const uint64_t v = gdakiHoldLoad(h->cells[peer]);
+  const int held = h->heldPeer.load(std::memory_order_acquire);
+  struct gdakiHoldDeclineIn in;
+  in.state = gdakiHoldStateOf(v);
+  in.policyHold = ts->policyEff == GDAKI_POLICY_HOLD;
+  // the NIC copy path too (the gate reads below and every copy of the hold go over it: no CUDA call on a survivor)
+  in.commArmed = h->commArmed.load(std::memory_order_acquire) != 0 && !h->commLost && gdakiLbOn(r);
+  in.deathEvidence = uaWhy == GDAKI_UA_PEER_DEAD;
+  in.strongCause = !pe.left && gdakiHoldStrongCause(pe.lostCause);
+  in.lostAfterCommit = pe.lostAfterCommit;
+  in.otherHeld = held >= 0 && held != peer;
+  const int b = gdakiHoldBuddyOf(peer, h->nranks);
+  in.buddyReachable = b == h->rank ||
+                      (b >= 0 && b < (int)ts->peers.size() && ts->peers[b].fd >= 0 && !ts->peers[b].gone &&
+                       !ts->peers[b].declined);
+  in.stopping = gdakiHoldStopping(r);
+  const char* toldWhy = "";
+  // TOLD last (it reads the peer's gates over the copy path): only when everything else would start a hold
+  if (in.state == GDAKI_HOLD_ARMED && !in.stopping && in.policyHold && in.commArmed && in.deathEvidence &&
+      !in.lostAfterCommit && in.strongCause && !in.otherHeld && in.buddyReachable)
+    in.told = gdakiHoldTold(r, peer, true, &toldWhy);
+  const char* nwhy = "";
+  bool fbOther = false;
+  const int a = gdakiHoldDeclineAction(in, &nwhy, &fbOther);
+  if (fbOther) {
+    char w[160];
+    snprintf(w, sizeof(w), "rank %d was declined meanwhile (%.80s): a second failure ends the restore", peer, why);
+    gdakiHoldMarkFallback(r, held, w);
+  }
+  switch (a) {
+    case GDAKI_HOLD_D_FALLBACK: gdakiHoldFallback(r, peer, why); return true;
+    case GDAKI_HOLD_D_START: gdakiHoldStart(r, peer, why, v); return true;
+    case GDAKI_HOLD_D_PASS_NOHOLD:
+      gdakiHoldNoHold(r, peer, v, in.told ? toldWhy : nwhy, why);
+      return false;
+    default: return false;
+  }
+}
+
+
+// ---- arming (rs_hold_api.h; work packages 5 and 9) ----
+static bool gdakiHoldCommArmedNow(struct gdakiHold* h) {
+  return h->commArmed.load(std::memory_order_acquire) != 0 && !h->commLost;
+}
+static uint64_t gdakiHoldDisarmSeq(struct gdakiRecHost* r, int peer) {
+  struct gdakiHold* h = gdakiHoldOf(r);
+  return gdakiHoldPeerOk(h, peer) ? h->peers[peer].disarmSeq : 0;
+}
+static bool gdakiHoldArm(struct gdakiRecHost* r, int peer, uint32_t inc, uint64_t disarmSeq, const char** why) {
+  struct gdakiHold* h = gdakiHoldOf(r);
+  const char* w = "this process does not ask for the restore";
+  bool ok = false;
+  if (gdakiHoldPeerOk(h, peer) && r->ts != nullptr) {
+    uint64_t v = gdakiHoldLoad(h->cells[peer]);
+    ok = gdakiHoldArmOk(gdakiHoldStateOf(v), gdakiHoldIncOf(v), inc, r->ts->peers[peer].declined,
+                        gdakiHoldCommArmedNow(h) && r->ts->policyEff == GDAKI_POLICY_HOLD, h->peers[peer].disarmSeq,
+                        disarmSeq, &w);
+    // OFF or ARMED: only the helper writes them (the watcher moves HELD and PUBLISHED only)
+    if (ok && !gdakiHoldCas(h->cells[peer], v, gdakiHoldPack(GDAKI_HOLD_ARMED, inc))) {
+      ok = false;
+      w = "the peer's state changed";
+    }
+  }
+  if (why) *why = ok ? "" : w;
+  return ok;
+}
+static void gdakiHoldDisarm(struct gdakiRecHost* r, int peer, const char* why, bool broadcast) {
+  struct gdakiHold* h = gdakiHoldOf(r);
+  if (!gdakiHoldPeerOk(h, peer)) return;
+  struct gdakiHoldPeer& hp = h->peers[peer];
+  hp.disarmSeq++;
+  uint64_t v = gdakiHoldLoad(h->cells[peer]);
+  const uint32_t s = gdakiHoldStateOf(v);
+  if (s == GDAKI_HOLD_ARMED) (void)gdakiHoldCas(h->cells[peer], v, gdakiHoldPack(GDAKI_HOLD_OFF, gdakiHoldIncOf(v)));
+  else if (gdakiHoldIsHeldState(s)) hp.disarmDuringHold = true;  // P5: applied at its RESTORED
+  int n = 0;
+  if (broadcast) {
+    n = gdakiHoldBroadcast(r, GDAKI_TS_DISARM, peer, gdakiHoldIncOf(v), -1);
+    h->nDisarmSent.fetch_add(1, std::memory_order_relaxed);
+  }
+  if (broadcast || s == GDAKI_HOLD_ARMED)
+    GIN_TS_NOTE("GIN/RS: rank %d: rank %d disarmed (%s; was %s; DISARM sent to %d rank(s)) mono_ms=%.3f", h->rank, peer,
+                why, gdakiHoldStateName(s), n, gdakiQ4MonoMs());
+}
+// This rank about itself (the post-restore DISARM of 9.10.7): every other rank sets this rank OFF until this rank's next
+// stable checkpoint. This rank's own incarnation: the spare branch's count (gdakiRsPeerInc of its own rank).
+static void gdakiHoldDisarmSelf(struct gdakiRecHost* r, const char* why) {
+  struct gdakiHold* h = gdakiHoldOf(r);
+  if (h == nullptr) return;
+  const int n = gdakiHoldBroadcast(r, GDAKI_TS_DISARM, h->rank, gdakiRsPeerInc(r, h->rank), -1);
+  h->nDisarmSent.fetch_add(1, std::memory_order_relaxed);
+  GIN_TS_NOTE("GIN/RS: rank %d: DISARM of this rank sent to %d rank(s) (%s) mono_ms=%.3f", h->rank, n, why,
+              gdakiQ4MonoMs());
+}
+
+// ---- the restore records of the host branch, and the spare's RESTORED ----
+// P2: this rank revived incarnation `from` of `peer` (it took its RESTORED) and a FALLBACK of that incarnation came: the
+// new incarnation is declined (PeerDead) and never held.
+static void gdakiHoldDeclineRevived(struct gdakiRecHost* r, int peer, uint64_t v, int fromRank) {
+  struct gdakiHold* h = gdakiHoldOf(r);
+  uint64_t e = v;
+  if (!gdakiHoldCas(h->cells[peer], e, gdakiHoldPack(GDAKI_HOLD_FALLBACK, gdakiHoldIncOf(v)))) return;
+  h->nFallbacks.fetch_add(1, std::memory_order_relaxed);
+  gdakiCkptPeerReset(r, peer);  // work package 5
+  struct gdakiTsPeer& pe = r->ts->peers[peer];
+  WARN("GIN/RS: rank %d: FALLBACK of incarnation %u of rank %d from rank %d after this rank took its RESTORED: incarnation "
+       "%u is declined as dead (PeerDead) mono_ms=%.3f", h->rank, gdakiHoldIncOf(v) - 1u, peer, fromRank,
+       gdakiHoldIncOf(v), gdakiQ4MonoMs());
+  gdakiTsDecline(r, peer, "restore fallback announced by another rank after RESTORED", pe.fd >= 0 && !pe.gone, 0,
+                 gdakiCause::PeerDead, GDAKI_UA_PEER_DEAD);
+}
+// The spare's RESTORED (impl/rs_spare_api.h): PUBLISHED or TIMED_OUT_PUBLISHED (Q2: RESTORED wins over the deadline when
+// read first) -> ARMED or OFF of incarnation i + 1 (P5). Then this rank's own post-restore DISARM (9.10.7: every survivor
+// is not armed until its own next stable checkpoint: its cut toward the revived rank is older than the log there).
+static void gdakiHoldApplyRestored(struct gdakiRecHost* r, int peer, const struct gdakiTsMsg& m) {
+  struct gdakiHold* h = gdakiHoldOf(r);
+  struct gdakiHoldPeer& hp = h->peers[peer];
+  {  // the state first: a RESTORED this rank cannot apply is not handed to the spare branch
+    const uint64_t v = gdakiHoldLoad(h->cells[peer]);
+    struct gdakiHoldMsgIn in;
+    in.restored = true;
+    in.state = gdakiHoldStateOf(v);
+    in.inc = gdakiHoldIncOf(v);
+    in.msgInc = m.pad;
+    if (gdakiHoldMsgAction(in) != GDAKI_HOLD_M_RESTORED) {
+      GIN_TS_NOTE("GIN/RS: rank %d: a RESTORED (incarnation %u) from rank %d ignored in state %s (incarnation %u) "
+                  "mono_ms=%.3f", h->rank, m.pad, peer, gdakiHoldStateName(in.state), in.inc, gdakiQ4MonoMs());
+      return;
+    }
+  }
+  if (!gdakiRsTakeRestored(r, peer, &m)) {
+    GIN_TS_NOTE("GIN/RS: rank %d: a RESTORED from rank %d not taken (not the spare's for the accepted incarnation) "
+                "mono_ms=%.3f", h->rank, peer, gdakiQ4MonoMs());
+    return;
+  }
+  const uint32_t ns = gdakiHoldRestoredState(gdakiHoldCommArmedNow(h), hp.disarmDuringHold,
+                                             gdakiHoldRespareRegistered(r, peer));
+  uint32_t from = 0, inc = 0;
+  // the watcher may move PUBLISHED -> TIMED_OUT_PUBLISHED meanwhile: decided again on what it holds (Q2)
+  if (!gdakiHoldRestoreMove(h->cells[peer], m.pad, ns, &from, &inc)) {
+    GIN_TS_NOTE("GIN/RS: rank %d: a RESTORED (incarnation %u) from rank %d ignored in state %s (incarnation %u) "
+                "mono_ms=%.3f", h->rank, m.pad, peer, gdakiHoldStateName(from), inc, gdakiQ4MonoMs());
+    return;
+  }
+  h->cells[peer].deadlineUs.store(0, std::memory_order_release);
+  int e = peer;
+  h->heldPeer.compare_exchange_strong(e, -1, std::memory_order_acq_rel);
+  hp.revivedFromValid = true;
+  hp.revivedFrom = inc;
+  hp.phase = GDAKI_HOLD_P_REJOIN;
+  gdakiHoldXferClose(hp);
+  gdakiCkptPeerReset(r, peer);  // work package 5
+  h->nRestored.fetch_add(1, std::memory_order_relaxed);
+  GIN_TS_NOTE("GIN/RS: rank %d: rank %d restored as incarnation %u (%s; %.1f ms after the hold start, %.1f ms after the "
+              "publish); state %s mono_ms=%.3f", h->rank, peer, inc + 1u,
+              from == GDAKI_HOLD_TIMED_OUT_PUBLISHED ? "read before the timed-out publish fell back" : "on time",
+              gdakiQ4MonoMs() - hp.holdStartMs, gdakiQ4MonoMs() - hp.publishMs, gdakiHoldStateName(ns), gdakiQ4MonoMs());
+  gdakiHoldDisarmSelf(r, "this rank took part in a restore: armed again at its own next stable checkpoint");
+}
+// One record of the host branch's types (or the spare's RESTORED) from `from`, about its subject (arg; RESTORED: from).
+static void gdakiHoldOnMsg(struct gdakiRecHost* r, int from, const struct gdakiTsMsg& m) {
+  struct gdakiHold* h = gdakiHoldOf(r);
+  if (m.type >= GDAKI_TS_CKPT_PAUSE && m.type <= GDAKI_TS_CKPT_STABLE) return gdakiCkptOnMsg(r, from, m);  // package 5
+  const bool restored = m.type == GDAKI_TS_RS_RESTORED;
+  const int p = restored ? from : m.arg;
+  if (!gdakiHoldPeerOk(h, p)) {
+    INFO(NCCL_NET, "GIN/RS: rank %d: %s from rank %d about rank %d ignored", h->rank, gdakiHoldMsgName(m.type), from, p);
+    return;
+  }
+  if (restored) return gdakiHoldApplyRestored(r, p, m);
+  struct gdakiHoldPeer& hp = h->peers[p];
+  const uint64_t v = gdakiHoldLoad(h->cells[p]);
+  struct gdakiHoldMsgIn in;
+  in.type = m.type;
+  in.state = gdakiHoldStateOf(v);
+  in.inc = gdakiHoldIncOf(v);
+  in.msgInc = (uint32_t)m.round;
+  in.revivedFromValid = hp.revivedFromValid;
+  in.revivedFrom = hp.revivedFrom;
+  if (m.type == GDAKI_TS_DISARM) hp.disarmSeq++;  // every DISARM counts for gdakiHoldArm
+  char w[128];
+  switch (gdakiHoldMsgAction(in)) {
+    case GDAKI_HOLD_M_OFF: {
+      uint64_t e = v;
+      if (gdakiHoldCas(h->cells[p], e, gdakiHoldPack(GDAKI_HOLD_OFF, in.inc)))
+        GIN_TS_NOTE("GIN/RS: rank %d: rank %d (incarnation %u) not armed any more: %s from rank %d mono_ms=%.3f", h->rank,
+                    p, in.inc, gdakiHoldMsgName(m.type), from, gdakiQ4MonoMs());
+      break;
+    }
+    case GDAKI_HOLD_M_DISARM_LATER: hp.disarmDuringHold = true; break;
+    case GDAKI_HOLD_M_FALLBACK:
+      snprintf(w, sizeof(w), "%s(rank %d, incarnation %u) from rank %d", gdakiHoldMsgName(m.type), p, in.msgInc, from);
+      gdakiHoldFallback(r, p, w);
+      break;
+    case GDAKI_HOLD_M_DECLINE: gdakiHoldDeclineRevived(r, p, v, from); break;
+    case GDAKI_HOLD_M_HOLDING:
+      if (gdakiHoldBuddyOf(p, h->nranks) == h->rank) (void)gdakiHoldHoldersAdd(hp.holders, h->nranks, from, in.msgInc);
+      break;
+    default: break;
+  }
+}
+// The host branch's parked records of `peer`, in arrival order (R1): the hold's own types (DISARM, NOHOLD, HOLDING, a
+// FALLBACK about another rank), the checkpoint's (work package 5) and the spare's RESTORED. A FALLBACK about this rank (a spare process told by a survivor)
+// and every other type stay parked for their owners.
+static void gdakiHoldDrain(struct gdakiRecHost* r, int peer) {
+  struct gdakiHold* h = gdakiHoldOf(r);
+  if (h == nullptr || peer < 0 || peer >= h->nranks) return;
+  const int me = h->rank;
+  auto mine = [me](const struct gdakiTsMsg& m) {
+    return gdakiHoldDrainTakes(m.type, m.arg, me, (uint32_t)GDAKI_TS_RS_RESTORED) ||
+           gdakiCkptIsRecord(m.type);  // work package 5
+  };
+  struct gdakiTsMsg m;
+  while (h->peers[peer].park.takeIf(mine, &m)) gdakiHoldOnMsg(r, peer, m);
+}
+
+// G4: a fault record of the helper's queue.
+static bool gdakiHoldRoute(struct gdakiRecHost* r, const struct gdakiTsFault& f) {
+  struct gdakiHold* h = gdakiHoldOf(r);
+  const int p = (int)f.rec.peer;
+  if (!gdakiHoldPeerOk(h, p) || r->ts == nullptr) return true;
+  struct gdakiTs* ts = r->ts;
+  const int qi = p + (int)f.rec.ctx_id * r->nranks;
+  const bool qOk = qi >= 0 && qi < (int)ts->qs.size();
+  int a = gdakiHoldRouteAction(gdakiHoldStateOf(gdakiHoldLoad(h->cells[p])), f.rec.ts_epoch,
+                               qOk ? gdakiTsCoveredEpoch(ts->qs[qi]) : 0u);
+  if (a == GDAKI_HOLD_R_FALLBACK) {  // the peer's parked records first (a RESTORED may wait there: R1, Q2)
+    gdakiHoldDrain(r, p);
+    a = gdakiHoldRouteAction(gdakiHoldStateOf(gdakiHoldLoad(h->cells[p])), f.rec.ts_epoch,
+                             qOk ? gdakiTsCoveredEpoch(ts->qs[qi]) : 0u);
+  }
+  switch (a) {
+    case GDAKI_HOLD_R_ABSORB:
+    case GDAKI_HOLD_R_STALE:
+      if (qOk) ts->qs[qi].handled = std::max(ts->qs[qi].handled, f.rec.ts_epoch + 2u);  // as gdakiTsInitiate marks it
+      if (a == GDAKI_HOLD_R_STALE) ts->nStale++;
+      else h->nAbsorbed.fetch_add(1, std::memory_order_relaxed);
+      return false;
+    case GDAKI_HOLD_R_FALLBACK: {
+      char w[96];
+      snprintf(w, sizeof(w), "a fault record (class %s) on a QP to the peer after the restore round's publish",
+               gdakiTsClassName(f.rec.cls));
+      gdakiHoldFallback(r, p, w);
+      return false;
+    }
+    default: return true;
+  }
+}
+// RL20 (gdakiTsRespond's first statement): the peer's parked records first (R1, Q5), then a REQ from a held peer is
+// answered NACK 17; from PUBLISHED (a spare that started a round before its RESTORED) the restore falls back too.
+static bool gdakiHoldOnReq(struct gdakiRecHost* r, int peer, const struct gdakiTsMsg& req) {
+  struct gdakiHold* h = gdakiHoldOf(r);
+  if (!gdakiHoldPeerOk(h, peer) || r->ts == nullptr) return false;
+  gdakiHoldDrain(r, peer);
+  const int a = gdakiHoldReqAction(gdakiHoldStateOf(gdakiHoldLoad(h->cells[peer])));
+  if (a == GDAKI_HOLD_Q_ANSWER) return false;
+  struct gdakiTsMsg n;
+  memset(&n, 0, sizeof(n));
+  n.type = GDAKI_TS_NACK;
+  n.round = req.round;
+  n.arg = GDAKI_TS_NACK_RESTORING;
+  n.pad = gdakiTsCausePad(gdakiCause::Unknown);
+  (void)gdakiHoldSend(r, peer, &n);
+  h->nNack.fetch_add(1, std::memory_order_relaxed);
+  GIN_TS_NOTE("GIN/RS: rank %d: REQ round %lu from held rank %d answered NACK %d (restoring) mono_ms=%.3f", h->rank,
+              (unsigned long)req.round, peer, GDAKI_TS_NACK_RESTORING, gdakiQ4MonoMs());
+  if (a == GDAKI_HOLD_Q_NACK_FALLBACK) gdakiHoldFallback(r, peer, "a REQ from the restored rank before its RESTORED");
+  return true;
+}
+// gdakiTsRepostApply's hooks (N1): right after its check of the released waits and before its commit point, the restore
+// round takes HELD -> COMMITTING (a lost compare-and-swap: the watcher's deadline won; the round fails and falls back).
+// Any other round is not held: true at once. After its last publish, COMMITTING -> PUBLISHED with its own deadline (P1).
+static bool gdakiHoldBeforeCommitPoint(struct gdakiRecHost* r, int peer, const char** why) {
+  struct gdakiHold* h = gdakiHoldOf(r);
+  if (!gdakiHoldPeerOk(h, peer) || gdakiHoldCommitMove(h->cells[peer])) return true;
+  *why = "the restore deadline passed before the commit point";
+  return false;
+}
+// After every successful publish of a round with `peer` (its gates are even again): the record of when they went odd is
+// cleared; a restore round moves COMMITTING -> PUBLISHED.
+static void gdakiHoldAfterPublish(struct gdakiRecHost* r, int peer) {
+  struct gdakiHold* h = gdakiHoldOf(r);
+  if (!gdakiHoldPeerOk(h, peer) || r->ts == nullptr) return;
+  struct gdakiHoldPeer& hp = h->peers[peer];
+  hp.oddSinceMs = 0;
+  gdakiCkptPauseGatesEnded(r, peer);  // work package 5: an input pause toward it ended here
+  if (gdakiHoldStateOf(gdakiHoldLoad(h->cells[peer])) != GDAKI_HOLD_COMMITTING) return;
+  hp.publishMs = gdakiQ4MonoMs();
+  (void)gdakiHoldPublishMove(h->cells[peer],
+                             gdakiHoldPublishedDeadlineUs((int64_t)(hp.publishMs * 1000.0),
+                                                          (int64_t)ncclParamGinRestoreMs(), r->ts->roundMs,
+                                                          r->ts->handshakeMs, (int64_t)(hp.rejoinMs * 1000.0),
+                                                          r->ts->holdMs));
+}
+
+// ---- the communicator's arming conditions after Resume (9.10.4: "Resume 뒤에 잃는 조건"; final once lost) ----
+static bool gdakiHoldCommCheck(struct gdakiRecHost* r, char* why, size_t whyLen) {
+  struct gdakiHold* h = gdakiHoldOf(r);
+  struct gdakiTs* ts = r->ts;
+  if (ts->escalated.load(std::memory_order_acquire)) {
+    snprintf(why, whyLen, "the round cap stopped recovery on this context");
+    return false;
+  }
+  if (!gdakiLbOn(r)) {
+    snprintf(why, whyLen, "the NIC copy path went off");
+    return false;
+  }
+  void* const coll = (void*)r->ctx->collComm;
+  void* const res = h->resWin.load(std::memory_order_acquire);
+  {
+    std::lock_guard<std::mutex> lk(gdakiRsWinMu);
+    for (const auto& w : gdakiRsWins) {
+      if (w.coll != coll) continue;
+      if (w.seq > r->rsWinSeq && !w.gone && w.mhandle != res) {
+        snprintf(why, whyLen, "a window was registered after the devComm's context (its rkey table is not in the NIC "
+                 "copy path)");
+        return false;
+      }
+    }  // a deregistered window is not final: gdakiHoldWinGoneStep
+  }
+  int n = 0;
+  {
+    std::lock_guard<std::mutex> lk(gdakiRecRegMu);
+    for (auto* x : gdakiRecReg)
+      if (x->commKey == r->commKey) n++;
+  }
+  if (n > 1) {
+    snprintf(why, whyLen, "the communicator has %d GDAKI contexts with transparent recovery now", n);
+    return false;
+  }
+  return true;
+}
+// A window of the context deregistered since the last check (rs_log_api.h gdakiRsWinGoneCount; 9.11.4 T5, 9.11.9 C2):
+// every peer is DISARMed until its next stable checkpoint (a covered log entry may name the window as a put source), not
+// final. A held peer keeps its hold (its export checks every source window; the DISARM is applied at its RESTORED). The
+// usual deregistration before ncclCommDestroy lands here too: a log line, no warning.
+static void gdakiHoldWinGoneStep(struct gdakiRecHost* r) {
+  struct gdakiHold* h = gdakiHoldOf(r);
+  const uint64_t n = gdakiRsWinGoneCount(r);
+  if (n == h->winGoneSeen) return;
+  GIN_TS_NOTE("GIN/RS: rank %d: %lu window(s) of the context deregistered since the last check: every peer is disarmed "
+              "until its next stable checkpoint mono_ms=%.3f", h->rank, (unsigned long)(n - h->winGoneSeen),
+              gdakiQ4MonoMs());
+  h->winGoneSeen = n;
+  for (int p = 0; p < h->nranks; p++)
+    if (p != h->rank) gdakiHoldDisarm(r, p, "a window of a survivor was deregistered", true);
+}
+static void gdakiHoldCommLost(struct gdakiRecHost* r, const char* why) {
+  struct gdakiHold* h = gdakiHoldOf(r);
+  h->commLost = true;
+  snprintf(h->commLostWhy, sizeof(h->commLostWhy), "%.159s", why);
+  WARN("GIN/RS: rank %d: this communicator is not armed for the restore any more (%s); every peer is disarmed "
+       "mono_ms=%.3f", h->rank, why, gdakiQ4MonoMs());
+  for (int p = 0; p < h->nranks; p++) {
+    if (p == h->rank) continue;
+    char w[224];
+    snprintf(w, sizeof(w), "rank %d lost an arming condition: %.160s", h->rank, why);
+    gdakiHoldDisarm(r, p, w, true);
+    if (gdakiHoldIsHeldState(gdakiHoldStateOf(gdakiHoldLoad(h->cells[p])))) gdakiHoldMarkFallback(r, p, w);
+  }
+}
+
+// ---- the buddy: once every survivor holds `peer`, the spare's activation (impl/rs_spare_api.h gdakiRsSendActivate) ----
+// No spare registered, or one that refuses (it saw the old process alive: never two processes for one rank), or one that
+// does not answer twice at least 1000 ms apart (as gdakiTsRefused judges a death): the fallback (9.2: a failure inside
+// the deadline takes the same way as the deadline).
+static void gdakiHoldActivate(struct gdakiRecHost* r, int peer) {
+  struct gdakiHold* h = gdakiHoldOf(r);
+  struct gdakiHoldPeer& hp = h->peers[peer];
+  const uint64_t v = gdakiHoldLoad(h->cells[peer]);
+  if (gdakiHoldStateOf(v) != GDAKI_HOLD_HELD || gdakiHoldIncOf(v) != hp.holders.inc) return;
+  const double now = gdakiQ4MonoMs();
+  if (now < hp.nextActivateMs) return;
+  struct gdakiRsActivate a;
+  memset(&a, 0, sizeof(a));
+  char addr[64] = {0};
+  if (!gdakiHoldSpareOf(r, peer, &a, addr, sizeof(addr)))
+    return gdakiHoldFallback(r, peer, "no spare process is registered for the peer at its buddy");
+  if (a.pid == 0)  // impl/rs_spare_api.h: the spare refuses an ACTIVATE without the original's PID
+    return gdakiHoldFallback(r, peer, "the peer's registration has no PID of the original process");
+  a.magic = GDAKI_RS_ACT_MAGIC;
+  a.version = 1;
+  a.kind = GDAKI_RS_ACT_ACTIVATE;
+  a.rank = peer;
+  a.incarnation = hp.holders.inc + 1u;
+  a.nonce = r->ts->nonce;
+  const int ans = gdakiRsSendActivate(addr, &a, 500);
+  if (ans == GDAKI_RS_ACT_ACCEPTED) {
+    hp.holders.activated = true;
+    GIN_TS_NOTE("GIN/RS: rank %d: every survivor holds rank %d: its spare activated (incarnation %u, %.1f ms after this "
+                "rank's hold start) mono_ms=%.3f", h->rank, peer, a.incarnation, now - hp.holdStartMs, gdakiQ4MonoMs());
+    return;
+  }
+  if (ans == GDAKI_RS_ACT_REFUSED) return gdakiHoldFallback(r, peer, "the peer's spare refused the activation");
+  if (hp.activateFails == 0) hp.firstActivateFailMs = now;
+  hp.activateFails++;
+  hp.nextActivateMs = now + 500.0;
+  if (hp.activateFails >= 2 && now - hp.firstActivateFailMs >= 1000.0)
+    gdakiHoldFallback(r, peer, "the peer's spare does not answer the activation");
+}
+
+// ---- the restore of the held peer, driven from the helper step (9.3, 9.11.3 M4; impl/rs_spare_api.h's order) ----
+// The commit round: X again (the QPs ran nothing since the hold start's 2ERR), the endpoint swap, Commit with the spare's
+// token, the baseline, the rkey swap, every old WQE counted executed (U = S, n = 0) and the publish through
+// gdakiTsRepostApply (its hooks: HELD -> COMMITTING before the commit point, PUBLISHED after), DONE_RS. Inside
+// gdakiTsBusy as a round, every context in scope, a firmware round of its own. Any failure: the fallback.
+static void gdakiHoldCommitRound(struct gdakiRecHost* r, int p) {
+  struct gdakiHold* h = gdakiHoldOf(r);
+  struct gdakiTs* ts = r->ts;
+  struct gdakiHoldPeer& hp = h->peers[p];
+  gdakiTsBusy busy(ts);
+  gdakiTsScopeGuard scopeGuard(GDAKI_TS_SCOPE_ALL);
+  r->fwRound.fetch_add(1, std::memory_order_acq_rel);
+  const double t0 = gdakiQ4MonoMs();
+  char w[160] = {0};
+  const char* cw = nullptr;
+  if (gdakiHoldStopping(r)) return gdakiHoldFallback(r, p, "the communicator is being destroyed");
+  if (!gdakiLbOn(r)) return gdakiHoldFallback(r, p, "the NIC copy path went off");  // no CUDA copy on a survivor
+  if (hp.rkeys == nullptr) return gdakiHoldFallback(r, p, "the spare's rkey list did not arrive");
+  {
+    uint64_t x[NCCL_GIN_RECOVERY_MAX_QPS] = {};
+    int n = 0;
+    if (gdakiRsExecRead(r, p, x, &n) != ncclSuccess || n != hp.nqp)
+      return gdakiHoldFallback(r, p, "the executed counts could not be read before the Commit");
+    for (int i = 0; i < n; i++)
+      if (x[i] != hp.xAtHold[i]) {
+        snprintf(w, sizeof(w), "QP %d executed %lu messages of the peer since the hold start (%lu then)", i,
+                 (unsigned long)x[i], (unsigned long)hp.xAtHold[i]);
+        return gdakiHoldFallback(r, p, w);
+      }
+  }
+  // the plan first, as hk validates its plan before its Commit (U = S, n = 0 needs nothing from after the Commit)
+  std::vector<struct gdakiTsRepostPlan> plans;
+  if (gdakiRsPlanAllExecuted(r, p, plans, &cw) != ncclSuccess)
+    return gdakiHoldFallback(r, p, cw ? cw : "the plan that counts every old WQE executed was refused");
+  ncclGinRecoverToken_t remote;
+  memset(&remote, 0, sizeof(remote));
+  // impl/rs_spare_api.h: it takes opMu itself (nothing of this branch holds it here); Commit after it returns
+  if (gdakiRsSwapEndpoint(r, p, &remote, w, sizeof(w)) != ncclSuccess) return gdakiHoldFallback(r, p, w);
+  ncclGinRecoverStats_t st;
+  memset(&st, 0, sizeof(st));
+  if (ncclGinRecoverCommit((ncclComm_t)r->commKey, p, &remote, &st) != ncclSuccess)
+    return gdakiHoldFallback(r, p, "the Commit with the spare's token failed");
+  cw = nullptr;
+  if (gdakiTsFwCheck(r, &cw)) return gdakiHoldFallback(r, p, cw);
+  if (gdakiTsBaseline(r, p) != ncclSuccess) return gdakiHoldFallback(r, p, "QUERY_QP failed after the Commit");
+  if (gdakiTsFwCheck(r, &cw)) return gdakiHoldFallback(r, p, cw);
+  if (gdakiRsSwapRkeys(r, p, hp.rkeys, w, sizeof(w)) != ncclSuccess) return gdakiHoldFallback(r, p, w);
+  struct gdakiTsReplayStats rs;
+  cw = nullptr;
+  if (gdakiTsRepostApply(r, p, plans, &rs, &cw) != ncclSuccess)
+    return gdakiHoldFallback(r, p, cw ? cw : "the publish failed");
+  if (gdakiHoldStateOf(gdakiHoldLoad(h->cells[p])) != GDAKI_HOLD_PUBLISHED)
+    return gdakiHoldFallback(r, p, "the publish did not reach PUBLISHED");
+  if (gdakiRsSendDone(r, p) != ncclSuccess) return gdakiHoldFallback(r, p, "DONE_RS could not be sent to the spare");
+  hp.phase = GDAKI_HOLD_P_PUBLISHED;
+  GIN_TS_NOTE("GIN/RS: rank %d: restore round with rank %d published (%u QP(s), S/U/n=[%s]; %.1f ms; %.1f ms after the hold "
+              "start); waiting for its RESTORED mono_ms=%.3f", h->rank, p, rs.nqp, rs.detail, gdakiQ4MonoMs() - t0,
+              gdakiQ4MonoMs() - hp.holdStartMs, gdakiQ4MonoMs());
+}
+// One step of the restore of the held peer (non-blocking but for the Prepare and the commit round, which are rounds).
+static void gdakiHoldDrive(struct gdakiRecHost* r, int p) {
+  struct gdakiHold* h = gdakiHoldOf(r);
+  struct gdakiHoldPeer& hp = h->peers[p];
+  const uint64_t v = gdakiHoldLoad(h->cells[p]);
+  if (gdakiHoldStateOf(v) != GDAKI_HOLD_HELD) return;  // PUBLISHED: its RESTORED is a parked record (gdakiHoldDrain)
+  const uint32_t inc = gdakiHoldIncOf(v);
+  char w[160] = {0};
+  switch (hp.phase) {
+    case GDAKI_HOLD_P_REJOIN: {
+      const int rc = gdakiRsRejoinAccept(r, p, w, sizeof(w));
+      if (rc == GDAKI_RS_REJOIN_REFUSED)
+        GIN_TS_NOTE("GIN/RS: rank %d: a REJOIN of rank %d refused (%s); its spare dials again mono_ms=%.3f", h->rank, p, w,
+                    gdakiQ4MonoMs());
+      if (rc != GDAKI_RS_REJOIN_ACCEPTED) return;
+      if (gdakiRsPeerInc(r, p) != inc + 1u) {
+        snprintf(w, sizeof(w), "the accepted REJOIN made incarnation %u, not %u", gdakiRsPeerInc(r, p), inc + 1u);
+        return gdakiHoldFallback(r, p, w);
+      }
+      hp.rejoinMs = gdakiQ4MonoMs();
+      hp.phase = GDAKI_HOLD_P_TRANSFER;
+      {  // the spare serves one survivor at a time: this survivor's turn starts now (gdakiHoldTurnDeadlineUs)
+        const int64_t old = h->cells[p].deadlineUs.load(std::memory_order_acquire);
+        const int64_t dl = gdakiHoldTurnDeadlineUs(old, hp.deviceBoundUs, (int64_t)(hp.rejoinMs * 1000.0),
+                                                   gdakiHoldTurnMs(r->ts->handshakeMs, r->ts->fwMs));
+        // the watcher reads the state, then the deadline: a later one stored while HELD only delays its compare-and-swap
+        if (dl > old && gdakiHoldStateOf(gdakiHoldLoad(h->cells[p])) == GDAKI_HOLD_HELD)
+          h->cells[p].deadlineUs.store(dl, std::memory_order_release);
+      }
+      GIN_TS_NOTE("GIN/RS: rank %d: rank %d's spare rejoined as incarnation %u (%.1f ms after the hold start; deadline in "
+                  "%.0f ms) mono_ms=%.3f", h->rank, p, inc + 1u, hp.rejoinMs - hp.holdStartMs,
+                  (double)(h->cells[p].deadlineUs.load(std::memory_order_acquire) - gdakiTsNowUs()) / 1000.0,
+                  gdakiQ4MonoMs());
+      return;
+    }
+    case GDAKI_HOLD_P_TRANSFER: {
+      const int rc = gdakiHoldTransferStep(r, p, w, sizeof(w));
+      if (rc < 0) return gdakiHoldFallback(r, p, w);
+      if (rc == 0) hp.phase = GDAKI_HOLD_P_PREPARE;
+      return;
+    }
+    case GDAKI_HOLD_P_PREPARE: {
+      gdakiTsBusy busy(r->ts);
+      gdakiTsScopeGuard scopeGuard(GDAKI_TS_SCOPE_ALL);
+      r->fwRound.fetch_add(1, std::memory_order_acq_rel);
+      ncclGinRecoverStats_t st;
+      memset(&st, 0, sizeof(st));
+      memset(&hp.tok, 0, sizeof(hp.tok));
+      if (gdakiHoldStopping(r)) return gdakiHoldFallback(r, p, "the communicator is being destroyed");
+      if (ncclGinRecoverPrepare((ncclComm_t)r->commKey, p, &hp.tok, &st) != ncclSuccess)
+        return gdakiHoldFallback(r, p, "the restore round's Prepare declined");
+      const char* cw = nullptr;
+      if (gdakiTsFwCheck(r, &cw)) return gdakiHoldFallback(r, p, cw);
+      uint32_t nm = 0;
+      if (gdakiTsNonMsg(r, p, &nm) != ncclSuccess || nm != 0) {  // 9.3 step 2: a READ or a DUMP cannot count as executed
+        snprintf(w, sizeof(w), "the ending epoch posted a READ or a WQE that is not a message (mask %#x)", nm);
+        return gdakiHoldFallback(r, p, w);
+      }
+      if (gdakiRsSendToken(r, p, &hp.tok) != ncclSuccess)
+        return gdakiHoldFallback(r, p, "the token could not be sent to the spare");
+      hp.phase = GDAKI_HOLD_P_READY;
+      return;
+    }
+    case GDAKI_HOLD_P_READY: {
+      struct gdakiTsMsg m;
+      if (!h->peers[p].park.take(GDAKI_TS_RS_READY, &m)) return;
+      if (!gdakiRsTakeReady(r, p, &m, w, sizeof(w))) return gdakiHoldFallback(r, p, w);
+      return gdakiHoldCommitRound(r, p);
+    }
+    default: return;
+  }
+}
+// Q2: before a timed-out publish falls back, what the spare's socket holds now (a RESTORED wins).
+static void gdakiHoldReadSpare(struct gdakiRecHost* r, int p) {
+  struct gdakiTsPeer& pe = r->ts->peers[p];
+  struct gdakiTsMsg m;
+  int got = 0;
+  while (pe.fd >= 0 && !pe.gone && (got = gdakiTsPump(pe, &m)) == 1) {
+    if (gdakiHoldDefer(r, p, &m)) continue;
+    if (m.type == GDAKI_TS_REQ && m.from == p) gdakiTsRespond(r, p, m);  // RL20: NACK 17 and the fallback
+    else if (m.type == GDAKI_TS_FAIL) {
+      if (!pe.declined) gdakiTsDecline(r, p, "the peer declined", false, m.arg, gdakiTsRemoteCause(m));
+    } else if (m.type == GDAKI_TS_BYE) pe.left = true;
+  }
+  if (got < 0 && !pe.gone && pe.fd >= 0) (void)gdakiTsSocketLost(r, p);
+  gdakiHoldDrain(r, p);
+}
+static void gdakiHoldCancel(struct gdakiRecHost* r, int p, const char* why) {
+  struct gdakiHold* h = gdakiHoldOf(r);
+  uint32_t from = 0, inc = 0;
+  if (!gdakiHoldEndMove(h->cells[p], GDAKI_HOLD_CANCELLED, &from, &inc)) return;
+  h->cells[p].deadlineUs.store(0, std::memory_order_release);
+  gdakiHoldXferClose(h->peers[p]);
+  int e = p;
+  h->heldPeer.compare_exchange_strong(e, -1, std::memory_order_acq_rel);
+  if (gdakiRecPrepared(r, p) == 1) (void)ncclGinRecoverAbort((ncclComm_t)r->commKey, p);
+  h->nCancelled.fetch_add(1, std::memory_order_relaxed);
+  GIN_TS_NOTE("GIN/RS: rank %d: the restore of rank %d (incarnation %u) is cancelled in state %s (%s) mono_ms=%.3f", h->rank,
+              p, inc, gdakiHoldStateName(from), why, gdakiQ4MonoMs());
+}
+
+#define GDAKI_HOLD_LOG_POLL_MS 10.0  // the send-side log's poll interval (tail advance, overflow and get checks)
+// RL4: the hold's step of the helper loop (after the sockets and the deaths, before the fault records). Nothing once the
+// teardown asked the helper to stop (no new round, no new firmware command; the state stays as it is).
+static void gdakiHoldStepFor(struct gdakiRecHost* r, int p, int action, const char* why, const struct gdakiHoldStepIn& in,
+                             const char* toldWhy) {
+  struct gdakiHold* h = gdakiHoldOf(r);
+  struct gdakiHoldPeer& hp = h->peers[p];
+  switch (action) {
+    case GDAKI_HOLD_S_CANCEL: return gdakiHoldCancel(r, p, why);
+    case GDAKI_HOLD_S_FALLBACK: {
+      char w[224];
+      snprintf(w, sizeof(w), "%.60s%s%.159s", why, in.told ? ": " : in.pendingFallback ? ": " : "",
+               in.told ? toldWhy : in.pendingFallback ? hp.pendingWhy : "");
+      return gdakiHoldFallback(r, p, w);
+    }
+    case GDAKI_HOLD_S_RESTORED_FIRST:
+      gdakiHoldReadSpare(r, p);
+      if (gdakiHoldStateOf(gdakiHoldLoad(h->cells[p])) == GDAKI_HOLD_TIMED_OUT_PUBLISHED)
+        gdakiHoldFallback(r, p, "no RESTORED from the spare before the deadline after the restore round's publish");
+      return;
+    case GDAKI_HOLD_S_DRIVE: return gdakiHoldDrive(r, p);
+    default: return;
+  }
+}
+static void gdakiHoldStep(struct gdakiRecHost* r) {
+  struct gdakiHold* h = gdakiHoldOf(r);
+  if (h == nullptr || gdakiHoldStopping(r)) return;
+  const double now = gdakiQ4MonoMs();
+  const int held = h->heldPeer.load(std::memory_order_acquire);
+  for (int p = 0; p < h->nranks; p++)  // the other peers' records first (a FALLBACK or NOHOLD about the held peer)
+    if (p != held) gdakiHoldDrain(r, p);
+  // work package 5: the held peer's checkpoint records before the buddy's activation (in HELD only: from COMMITTING on,
+  // its records keep their arrival order against its RESTORED)
+  if (gdakiHoldPeerOk(h, held) && gdakiHoldStateOf(gdakiHoldLoad(h->cells[held])) == GDAKI_HOLD_HELD) {
+    // (its last CKPT_STABLE may sit in front of its FIN: the activation must name that checkpoint)
+    auto ckptRec = [](const struct gdakiTsMsg& m) { return gdakiCkptIsRecord(m.type); };
+    struct gdakiTsMsg m;
+    while (h->peers[held].park.takeIf(ckptRec, &m)) gdakiCkptOnMsg(r, held, m);
+  }
+  if (now >= h->nextExpireMs) {  // records nobody took
+    h->nextExpireMs = now + 1000.0;
+    for (int p = 0; p < h->nranks; p++) {
+      uint32_t t = 0;
+      const int n = h->peers[p].park.expire(now, GDAKI_HOLD_PARK_MS, &t);
+      if (n > 0)
+        GIN_TS_NOTE("GIN/RS: rank %d: %d restore record(s) from rank %d dropped after %.0f ms unclaimed (one: %s) "
+                    "mono_ms=%.3f", h->rank, n, p, GDAKI_HOLD_PARK_MS, gdakiHoldMsgName(t), now);
+    }
+  }
+  if (h->commArmed.load(std::memory_order_acquire) && !h->commLost && now >= h->nextCommCheckMs) {
+    h->nextCommCheckMs = now + 100.0;
+    char w[160];
+    if (!gdakiHoldCommCheck(r, w, sizeof(w))) gdakiHoldCommLost(r, w);
+    else gdakiHoldWinGoneStep(r);
+  }
+  // work package 5: the send-side log's poll (impl/rs_log_api.h): every peer whose log toward it overflowed, or toward
+  // which this rank posted a get, since its last stable cut is DISARMed (until its next stable checkpoint after this)
+  if (now >= h->nextLogPollMs && gdakiRsLogReady(r)) {
+    h->nextLogPollMs = now + GDAKI_HOLD_LOG_POLL_MS;
+    std::vector<int> broke;
+    if (gdakiRsLogPoll(r, &broke) == ncclSuccess)
+      for (int q : broke) gdakiHoldDisarm(r, q, "the log toward it overflowed, or a get was posted to it", true);
+  }
+  for (int p = 0; p < h->nranks; p++) {  // as the buddy
+    struct gdakiHoldPeer& hp = h->peers[p];
+    if (p != h->rank && hp.holders.any && !hp.holders.activated &&
+        gdakiHoldHoldersComplete(hp.holders, h->nranks, p))
+      gdakiHoldActivate(r, p);
+  }
+  gdakiCkptStep(r);  // work package 5: this rank's checkpoint and its pauses for others
+  const int p = h->heldPeer.load(std::memory_order_acquire);
+  if (!gdakiHoldPeerOk(h, p)) {
+    if (gdakiHoldPeerOk(h, held)) gdakiHoldDrain(r, held);  // its hold ended above: its records as any peer's
+    return;
+  }
+  struct gdakiHoldStepIn in;
+  in.cancelled = gdakiHoldAppAborted(r);
+  const char* tw = "";
+  in.told = !in.cancelled && gdakiHoldTold(r, p, false, &tw);
+  in.pendingFallback = h->peers[p].pendingFallback;
+  in.commLost = h->commLost;
+  in.state = gdakiHoldStateOf(gdakiHoldLoad(h->cells[p]));
+  const char* why = "";
+  int a = gdakiHoldStepAction(in, &why);
+  if (!gdakiHoldStepBeforeRecords(a)) {  // 9.10.5: a parked RESTORED does not outrun a cancel or a fallback
+    gdakiHoldDrain(r, p);
+    in.state = gdakiHoldStateOf(gdakiHoldLoad(h->cells[p]));
+    a = gdakiHoldStepAction(in, &why);
+  }
+  gdakiHoldStepFor(r, p, a, why, in, tw);
+}
+
+// G8 (the Q4 watcher thread; independent of the helper): the deadline of the held peer (N1, P1, V5). HELD: the
+// compare-and-swap HELD -> TIMED_OUT_HELD, and only when it wins, the CPU writes the decline would make first (the peer's
+// word PEER_DEAD with its degraded raise, the async error, the blame PeerDead; inside gdakiTsToComm as hw's watchdog): the
+// QPs are in ERR (hold start) or unused (Q4), so "QPs to ERR, then the word" holds. The helper declines next (gates, FAIL:
+// a second decline is harmless). PUBLISHED: the state alone (its QPs are RTS: the helper's decline moves them to ERR first).
+// COMMITTING: never touched.
+static void gdakiHoldWatchdog(struct gdakiRecHost* r) {
+  struct gdakiHold* h = gdakiHoldOf(r);
+  if (h == nullptr) return;
+  const int p = h->heldPeer.load(std::memory_order_acquire);
+  if (!gdakiHoldPeerOk(h, p)) return;
+  uint32_t inc = 0;
+  const int a = gdakiHoldWatchMove(h->cells[p], gdakiTsNowUs(), &inc);  // only when its compare-and-swap won
+  if (a == GDAKI_HOLD_W_TIMEOUT_HELD) {
+    h->nTimeouts.fetch_add(1, std::memory_order_relaxed);
+    struct gdakiQ4Host* q4 = r->ctx->q4;
+    (void)gdakiTsToComm(r->ts, [&] {
+      gdakiBlameNote(q4->asyncResult, p, gdakiCause::PeerDead);  // before the flags below
+      gdakiUaRaisePeer(r->commKey, p, GDAKI_UA_PEER_DEAD);        // the peer's word; the degraded raise from now
+      if (q4->asyncResult) {
+        __atomic_store_n(q4->asyncResult, ncclRemoteError, __ATOMIC_RELEASE);
+        q4->setAsync.store(1, std::memory_order_release);
+      }
+    });
+    q4->hasError.store(1, std::memory_order_release);
+    WARN("GIN/RS: rank %d: the restore of rank %d (incarnation %u) passed its deadline while held: its waits are released "
+         "as dead (PEER_DEAD), the asynchronous error is raised; the helper declines it next mono_ms=%.3f", h->rank, p,
+         inc, gdakiQ4MonoMs());
+  } else if (a == GDAKI_HOLD_W_TIMEOUT_PUBLISHED) {
+    h->nTimeouts.fetch_add(1, std::memory_order_relaxed);
+    GIN_TS_NOTE("GIN/RS: rank %d: the restore of rank %d (incarnation %u) passed its deadline after its publish without "
+                "RESTORED; the helper falls back unless it reads RESTORED first mono_ms=%.3f", h->rank, p, inc,
+                gdakiQ4MonoMs());
+  }
+}
+
+// ---- life of the hold state ----
+// gdakiTsStart, before the helper and the watcher can look at it (a process that asks for the restore only).
+static void gdakiHoldCreate(struct gdakiRecHost* r) {
+  if (!gdakiRsRequested() || r->ts == nullptr || r->hold != nullptr) return;
+  struct gdakiHold* h = new gdakiHold();
+  h->rank = r->ctx->rank;
+  h->nranks = r->nranks;
+  h->cells = new struct gdakiHoldCell[(size_t)std::max(1, r->nranks)];
+  h->peers.resize((size_t)r->nranks);
+  r->hold = h;
+  gdakiCkptCreate(r);  // work package 5: the checkpoint state and its two data threads
+}
+// ncclGinRestoreResume, every rank decided "the restore can be enabled" (application thread, under gdakiRecRegMu with the
+// context registered): this communicator is armed; resWin is the devComm's resource window Resume added (or null).
+static void gdakiHoldOnResume(struct gdakiRecHost* r, void* resWin) {
+  struct gdakiHold* h = gdakiHoldOf(r);
+  if (h == nullptr) return;
+  h->resWin.store(resWin, std::memory_order_release);
+  h->commArmed.store(1, std::memory_order_release);
+}
+// Once per context, after the helper stopped: what the hold did (a process that asks for the restore only).
+static void gdakiHoldTeardownLine(struct gdakiRecHost* r) {
+  struct gdakiHold* h = gdakiHoldOf(r);
+  if (h == nullptr || h->lineDone) return;
+  h->lineDone = true;
+  GIN_TS_NOTE("GIN/RS: rank %d hold at close: armed_comm=%d comm_lost=%d holds=%d restored=%d fallbacks=%d timeouts=%d "
+              "cancelled=%d nohold=%d nack17=%d absorbed=%d parked=%d disarm_sent=%d%s%s", h->rank,
+              h->commArmed.load(), (int)h->commLost, h->nHolds.load(), h->nRestored.load(), h->nFallbacks.load(),
+              h->nTimeouts.load(), h->nCancelled.load(), h->nNoHold.load(), h->nNack.load(), h->nAbsorbed.load(),
+              h->nParked.load(), h->nDisarmSent.load(), h->commLost ? " why=" : "", h->commLost ? h->commLostWhy : "");
+}
+static void gdakiHoldFree(struct gdakiRecHost* r) {
+  if (r == nullptr || r->hold == nullptr) return;
+  gdakiCkptFree(r);  // work package 5 (its data threads stopped first)
+  for (auto& hp : r->hold->peers) {
+    delete hp.rkeys;
+    gdakiHoldXferClose(hp);
+  }
+  delete r->hold;
+  r->hold = nullptr;
+}
+// ==== gin-restore (rs, work package 7): hold machine (end) ====
+
+// ==== gin-restore (rs, work package 5): checkpoint machine (begin) ====
+// The checkpoint (EXPERIMENT.md 9.4, 9.11.9 C1; impl/rs_ckpt_api.h): the step hook of the application's thread, the input
+// pause on both sides (helper), the drain check, the in-GPU copy, the upload to the buddy and the buddy's store (two data
+// threads), the stable checkpoint (the log's trim and the arming), the stable step, and the restore's part (the state
+// transfer to a spare, the spare's registration at the buddy). A process that does not ask for the restore has none of it.
+NCCL_PARAM(GinRestoreCkptSteps, "GIN_RESTORE_CKPT_STEPS", 20);       // steps between checkpoints (9.4)
+NCCL_PARAM(GinRestorePauseMs, "GIN_RESTORE_PAUSE_MS", 2000);         // the initiator's wait for PAUSED; x4: a peer's pause bound
+NCCL_PARAM(GinRestoreDrainMs, "GIN_RESTORE_DRAIN_MS", 500);          // the drain check's bound
+NCCL_PARAM(GinRestoreDrainQueries, "GIN_RESTORE_DRAIN_QUERIES", 400);  // QUERY_QP per checkpoint, at most (9.15: rain's slots)
+#define GDAKI_CKPT_STEPLOG_CAP 65536
+// The pause bound every side uses: NCCL_GIN_RESTORE_PAUSE_MS, never below the drain's bound (the initiator's phases fit
+// inside the peers' 4 x bound: PAUSED within 1 x, the drain within 1 x, the copy within the 3rd).
+static int64_t gdakiCkptPauseMs() {
+  return std::max<int64_t>(std::max<int64_t>(1, ncclParamGinRestorePauseMs()), ncclParamGinRestoreDrainMs());
+}
+
+static struct gdakiCkpt* gdakiCkptOf(struct gdakiRecHost* r) {
+  return (r != nullptr && r->hold != nullptr) ? r->hold->ckpt : nullptr;
+}
+// ---- bounded socket I/O on a non-blocking descriptor (the data socket) ----
+static bool gdakiCkptSendAll(int fd, const void* p, size_t n, int timeoutMs, const std::atomic<bool>* stop) {
+  const char* b = (const char*)p;
+  size_t off = 0;
+  const double deadline = gdakiQ4MonoMs() + timeoutMs;
+  while (off < n) {
+    const ssize_t k = send(fd, b + off, n - off, MSG_NOSIGNAL | MSG_DONTWAIT);
+    if (k > 0) {
+      off += (size_t)k;
+      continue;
+    }
+    if (k < 0 && errno != EAGAIN && errno != EWOULDBLOCK && errno != EINTR) return false;
+    const int rem = (int)(deadline - gdakiQ4MonoMs());
+    if (rem <= 0 || (stop && stop->load(std::memory_order_acquire))) return false;
+    struct pollfd pf = {fd, POLLOUT, 0};
+    (void)poll(&pf, 1, std::min(rem, 20));
+  }
+  return true;
+}
+static bool gdakiCkptRecvAll(int fd, void* p, size_t n, int timeoutMs, const std::atomic<bool>* stop) {
+  char* b = (char*)p;
+  size_t off = 0;
+  const double deadline = gdakiQ4MonoMs() + timeoutMs;
+  while (off < n) {
+    const ssize_t k = recv(fd, b + off, n - off, MSG_DONTWAIT);
+    if (k > 0) {
+      off += (size_t)k;
+      continue;
+    }
+    if (k == 0 || (k < 0 && errno != EAGAIN && errno != EWOULDBLOCK && errno != EINTR)) return false;
+    const int rem = (int)(deadline - gdakiQ4MonoMs());
+    if (rem <= 0 || (stop && stop->load(std::memory_order_acquire))) return false;
+    struct pollfd pf = {fd, POLLIN, 0};
+    (void)poll(&pf, 1, std::min(rem, 20));
+  }
+  return true;
+}
+// A connected data socket to `a` (non-blocking, the helper sockets' options), or -1.
+static int gdakiCkptDial(const union ncclSocketAddress& a, int timeoutMs) {
+  const socklen_t alen = a.sa.sa_family == AF_INET6 ? sizeof(a.sin6) : sizeof(a.sin);
+  const int fd = socket(a.sa.sa_family, SOCK_STREAM, 0);
+  if (fd < 0) return -1;
+  gdakiTsSockOpts(fd);
+  const int rc = connect(fd, &a.sa, alen);
+  if (rc != 0 && errno != EINPROGRESS) {
+    close(fd);
+    return -1;
+  }
+  if (rc != 0) {
+    struct pollfd pf = {fd, POLLOUT, 0};
+    int err = 0;
+    socklen_t elen = sizeof(err);
+    if (poll(&pf, 1, std::max(1, timeoutMs)) != 1 || getsockopt(fd, SOL_SOCKET, SO_ERROR, &err, &elen) != 0 || err != 0) {
+      close(fd);
+      return -1;
+    }
+  }
+  return fd;
+}
+// The first record of a data connection.
+static bool gdakiCkptSendFirst(struct gdakiRecHost* r, int fd, uint32_t purpose, int subject, uint64_t round,
+                               int timeoutMs) {
+  struct gdakiTsMsg m;
+  memset(&m, 0, sizeof(m));
+  m.type = GDAKI_TS_DATA;
+  m.from = r->ctx->rank;
+  m.nonce = r->ts->nonce;
+  m.arg = subject;
+  m.round = round;
+  m.pad = purpose;
+  return gdakiTsSend(fd, &m, timeoutMs) == 0;
+}
+// This rank's spare (NCCL_GIN_RESTORE_SPARE_ADDR=<host>:<port>), its PID and start time, read once.
+struct gdakiCkptSelf {
+  bool haveSpare = false;
+  union ncclSocketAddress spare;
+  int64_t pid = 0;
+  uint64_t pidStart = 0;
+};
+static const struct gdakiCkptSelf& gdakiCkptSelfOf() {
+  static const struct gdakiCkptSelf s = [] {
+    struct gdakiCkptSelf v;
+    const char* e = getenv("NCCL_GIN_RESTORE_SPARE_ADDR");
+    if (e && *e) {
+      memset(&v.spare, 0, sizeof(v.spare));
+      if (ncclSocketGetAddrFromString(&v.spare, e) == ncclSuccess) v.haveSpare = true;
+      else WARN("GIN/RS: NCCL_GIN_RESTORE_SPARE_ADDR is not <host>:<port>; no spare is registered");  // the value unprinted
+    }
+    v.pid = (int64_t)getpid();
+    FILE* f = fopen("/proc/self/stat", "r");
+    if (f) {
+      char buf[1024];
+      const size_t n = fread(buf, 1, sizeof(buf) - 1, f);
+      fclose(f);
+      buf[n] = '\0';
+      const char* q = strrchr(buf, ')');  // the command name may hold spaces: count the fields after its ')'
+      int field = 2;
+      for (; q && *q; q++)
+        if (*q == ' ' && ++field == 22) {
+          v.pidStart = strtoull(q + 1, nullptr, 10);
+          break;
+        }
+    }
+    return v;
+  }();
+  return s;
+}
+
+// ---- the peer side: the input pause toward subject r (helper) ----
+// gdakiTsQuiesce without the 2ERR (9.4 step 2, F20): the gates odd, the count 0 (posters waiting for a slot leave as
+// their WQEs complete: the QPs stay RTS), the abandoned check, the held WQEs rung (so they execute and r's drain ends).
+static ncclResult_t gdakiCkptQuiesce(struct gdakiRecHost* r, int peer, const char** why, uint32_t* hostRung) {
+  ncclResult_t ret = ncclSuccess;
+  *hostRung = 0;
+  gdakiHoldGateOdd(r, peer);  // when the gates went odd (the hold start's deadline term)
+  gdakiRecForPeer(r, peer, [&](gdakiRecQp& rq, struct doca_gpu_verbs_qp_hl* q) {
+    if (ret != ncclSuccess) return;
+    if (gdakiTsWordHiWrite(r, q->qp_gverbs, r->ts->qs[rq.qpIdx].epoch | 1u) != ncclSuccess) {
+      ret = ncclSystemError;
+      *why = "cannot write the gate";
+    }
+  });
+  if (ret != ncclSuccess) return ret;
+  const double deadline = gdakiQ4MonoMs() + r->ts->quiesceMs;
+  gdakiRecForPeer(r, peer, [&](gdakiRecQp&, struct doca_gpu_verbs_qp_hl* q) {
+    while (ret == ncclSuccess) {
+      uint64_t w = 0;
+      if (gdakiTsWordRead(r, q->qp_gverbs, &w) != ncclSuccess) {
+        ret = ncclSystemError;
+        *why = "cannot read the gate";
+        break;
+      }
+      if (gdakiTsWordCount(w) == 0) break;
+      if (r->ts->stop.load(std::memory_order_acquire)) {
+        ret = ncclSystemError;
+        *why = "the communicator is being destroyed";
+        break;
+      }
+      if (gdakiQ4MonoMs() > deadline) {
+        ret = ncclSystemError;
+        *why = "posters/pollers did not leave the gate";
+        break;
+      }
+      std::this_thread::sleep_for(std::chrono::microseconds(20));
+    }
+  });
+  bool ab = false;
+  if (ret == ncclSuccess && (gdakiTsAbandoned(r, peer, &ab) != ncclSuccess || ab)) {
+    ret = ncclSystemError;
+    *why = "a device waiter already gave up (the application saw the error)";
+  }
+  if (ret != ncclSuccess) return ret;
+  gdakiRecForPeer(r, peer, [&](gdakiRecQp&, struct doca_gpu_verbs_qp_hl* q) {
+    if (ret != ncclSuccess) return;
+    struct doca_gpu_verbs_qp* v = q->qp_gverbs;
+    uint64_t idx[3];
+    if (gdakiRecD2H(r, idx, v->qp_gpu, sizeof(idx)) != ncclSuccess) {
+      ret = ncclSystemError;
+      *why = "cannot read the device indices";
+      return;
+    }
+    if (idx[0] != idx[1] || idx[2] >= idx[1]) return;
+    const uint64_t pi = idx[1];
+    if (gdakiTsRing(r, q, (uint32_t)pi) != ncclSuccess ||
+        gdakiRecH2D(r, (uint8_t*)v->qp_gpu + offsetof(struct doca_gpu_dev_verbs_qp, sq_wqe_pi), &pi, 8) != ncclSuccess) {
+      ret = ncclSystemError;
+      *why = "cannot ring the held WQEs";
+      return;
+    }
+    v->qp_cpu->sq_wqe_pi = pi;
+    *hostRung += (uint32_t)(idx[1] - idx[2]);
+  });
+  return ret;
+}
+// The end of an input pause (M3, 9.11.9 C1): the empty round. The commit point first (a device thread that gave up
+// meanwhile told the application: then nothing is published, the caller declines); then every QP to the peer gets epoch
+// + 2 (lbase, nonmsg and swErr unchanged: V17) and the covered epoch stays (G6).
+static bool gdakiCkptEmptyRound(struct gdakiRecHost* r, int peer, const char** why) {
+  bool ab = false;
+  if (gdakiTsCommitPoint(r, peer, &ab) != ncclSuccess) {
+    *why = "cannot write the commit word";
+    return false;
+  }
+  if (ab) {
+    *why = "a parked device thread gave up during the pause";
+    return false;
+  }
+  bool ok = true;
+  gdakiRecForPeer(r, peer, [&](gdakiRecQp& rq, struct doca_gpu_verbs_qp_hl* q) {
+    if (!ok) return;
+    struct gdakiTsQp& s = r->ts->qs[rq.qpIdx];
+    const uint32_t before = s.epoch;
+    if (gdakiTsWordHiWrite(r, q->qp_gverbs, before + 2u) != ncclSuccess) {
+      ok = false;
+      *why = "cannot publish the empty round";
+      return;
+    }
+    gdakiCkptAfterEmpty(before, &s.rsEmptyValid, &s.rsEmptyTop, &s.rsEmptyBase);
+    s.epoch = before + 2u;
+  });
+  if (ok) r->hold->peers[peer].oddSinceMs = 0;  // the gates are even again (as gdakiHoldAfterPublish after a round)
+  return ok;
+}
+// The gates of the peer against the pause of `ps`: the facts for gdakiCkptPauseVerdict (a round since: the peer's quiesce
+// count moved after the pause's own quiesce, also for a round the socket loss cancelled).
+static int gdakiCkptPauseState(struct gdakiRecHost* r, int peer, const struct gdakiCkptPeerSide& ps) {
+  const bool declined = r->ts->peers[peer].declined, roundSince = r->hold->peers[peer].quiesceSeq != ps.quiesceSeqAt;
+  if (declined || roundSince) return gdakiCkptPauseVerdict(declined, roundSince, true, false, false, false);
+  bool epochSame = true, allOdd = true, anyOdd = false, readFail = false;
+  int i = 0;
+  gdakiRecForPeer(r, peer, [&](gdakiRecQp& rq, struct doca_gpu_verbs_qp_hl* q) {
+    const uint32_t e = r->ts->qs[rq.qpIdx].epoch;
+    if (i >= ps.nqp || e != ps.epochAt[i]) epochSame = false;
+    uint64_t w = 0;
+    if (gdakiTsWordRead(r, q->qp_gverbs, &w) != ncclSuccess) readFail = true;
+    else if ((uint32_t)(w >> 32) == (e | 1u)) anyOdd = true;
+    else allOdd = false;
+    i++;
+  });
+  return gdakiCkptPauseVerdict(false, false, epochSame && i == ps.nqp, readFail, allOdd, anyOdd);
+}
+// A round's publish or a decline toward `peer` ended an input pause toward it (its gates are even or failed now): the
+// pause's length ends here (gdakiHoldAfterPublish, gdakiHoldOnDecline).
+static void gdakiCkptPauseGatesEnded(struct gdakiRecHost* r, int peer) {
+  struct gdakiCkpt* ck = gdakiCkptOf(r);
+  if (ck == nullptr || peer < 0 || peer >= (int)ck->peers.size()) return;
+  struct gdakiCkptPeerSide& ps = ck->peers[(size_t)peer];
+  if (ps.paused && ps.endedMs == 0) ps.endedMs = gdakiQ4MonoMs();
+}
+// The end of an input pause toward subject `s` (every way it ends): its length from the CKPT_PAUSE's arrival to the gates'
+// end of the pause (the empty round, or whatever else ended it), one line each (the test's pause_us), and the counters.
+static void gdakiCkptPauseLine(struct gdakiRecHost* r, int s, const struct gdakiCkptPeerSide& ps, const char* how) {
+  struct gdakiCkpt* ck = gdakiCkptOf(r);
+  const double ms = (ps.endedMs > 0 ? ps.endedMs : gdakiQ4MonoMs()) - ps.startMs;
+  ck->pauseMsMax = std::max(ck->pauseMsMax, ms);
+  ck->pauseMsSum += ms;
+  ck->pauseCount++;
+  GIN_TS_NOTE("GIN/RS: rank %d: input pause for rank %d's checkpoint %lu ended (%s) pause_us=%.0f mono_ms=%.3f",
+              r->ctx->rank, s, (unsigned long)ps.ckpt, how, ms * 1000.0, gdakiQ4MonoMs());
+}
+static void gdakiCkptReply(struct gdakiRecHost* r, int to, uint32_t type, uint64_t ckpt, uint32_t pad) {
+  struct gdakiTsMsg m;
+  gdakiHoldMsgInit(&m, type, to, (uint32_t)0);
+  m.round = ckpt;
+  m.pad = pad;
+  (void)gdakiHoldSend(r, to, &m);
+}
+// The end of a pause that is not confirmed: the empty round (a failure there, or gates nothing else will publish: the peer
+// is declined, as a failed round), the pause record cleared.
+static void gdakiCkptEndPause(struct gdakiRecHost* r, int subject, const char* what) {
+  struct gdakiCkpt* ck = gdakiCkptOf(r);
+  struct gdakiCkptPeerSide& ps = ck->peers[subject];
+  if (!ps.paused) return;
+  ps.paused = false;
+  r->hold->peers[subject].pauseStartMs = 0;
+  const int st = gdakiCkptPauseState(r, subject, ps);
+  if (st == GDAKI_CKPT_P_ENDED) {  // a round or a decline ended the gates' pause already, or no gate was made odd
+    // no round since and not declined: only this pause recorded the gates' odd time (a pause starts only when none is
+    // recorded: BUSY ROUND), and no gate is odd now (a first gate write that failed): forget it
+    if (!r->ts->peers[subject].declined && r->hold->peers[subject].quiesceSeq == ps.quiesceSeqAt)
+      r->hold->peers[subject].oddSinceMs = 0;
+    gdakiCkptPauseLine(r, subject, ps, what);
+    return;
+  }
+  const char* why = "a gate of the pause could not be read, or only some show it";
+  const bool ok = st == GDAKI_CKPT_P_INTACT && gdakiCkptEmptyRound(r, subject, &why);
+  gdakiCkptPauseLine(r, subject, ps, what);
+  if (!ok) {
+    char w[192];
+    snprintf(w, sizeof(w), "the end of a checkpoint pause (%.40s) failed: %.100s", what, why ? why : "?");
+    gdakiTsDecline(r, subject, w, true, 0, gdakiCause::Local);
+  }
+}
+// A restored rank still holding back replayed messages toward any peer answers BUSY and takes no checkpoint (P4, V18;
+// impl/rs_log_api.h gdakiRsLogReadSuppress, over the NIC). A failed read counts as "left" (no checkpoint on a doubt).
+static bool gdakiCkptSuppressLeft(struct gdakiRecHost* r) {
+  if (!gdakiRsLogReady(r)) return false;  // no side table: nothing is held back
+  for (int q = 0; q < r->nranks; q++) {
+    if (q == r->ctx->rank) continue;
+    uint64_t left[NCCL_GIN_RECOVERY_MAX_QPS] = {};
+    int n = 0;
+    if (gdakiRsLogReadSuppress(r, q, left, &n) != ncclSuccess || n < 0 || n > NCCL_GIN_RECOVERY_MAX_QPS) return true;
+    for (int i = 0; i < n; i++)
+      if (left[i] != 0) return true;
+  }
+  return false;
+}
+// CKPT_PAUSE from r (9.4 step 2).
+static void gdakiCkptOnPause(struct gdakiRecHost* r, int from, const struct gdakiTsMsg& m) {
+  struct gdakiHold* h = r->hold;
+  struct gdakiCkpt* ck = gdakiCkptOf(r);
+  const int s = from;  // the subject: the checkpointing rank itself
+  const uint64_t k = m.round;
+  struct gdakiCkptPeerSide& ps = ck->peers[s];
+  if (ps.paused) gdakiCkptEndPause(r, s, "a newer pause of the same rank");  // its CKPT_RESUME got lost: cannot happen
+  struct gdakiTsPeer& pe = r->ts->peers[s];
+  const char* tw = "";
+  const uint32_t busy = gdakiCkptBusyReason(true, h->heldPeer.load(std::memory_order_acquire) >= 0,
+                                            gdakiCkptSuppressLeft(r), pe.declined || pe.gone,
+                                            gdakiHoldTold(r, s, false, &tw),
+                                            h->peers[s].oddSinceMs != 0 || gdakiDetQueued(r, s));
+  if (busy != 0) {
+    gdakiCkptReply(r, s, GDAKI_TS_BUSY, k, busy);
+    ck->nBusySent.fetch_add(1, std::memory_order_relaxed);
+    return;
+  }
+  gdakiTsBusy b(r->ts);
+  const double t0 = gdakiQ4MonoMs();
+  const char* why = nullptr;
+  uint32_t rung = 0;
+  ps.paused = true;  // from here every failure ends the pause (gdakiCkptEndPause)
+  ps.ckpt = k;
+  ps.startMs = t0;
+  ps.endedMs = 0;
+  ps.nqp = 0;
+  gdakiRecForPeer(r, s, [&](gdakiRecQp& rq, struct doca_gpu_verbs_qp_hl*) {
+    if (ps.nqp < NCCL_GIN_RECOVERY_MAX_QPS) ps.epochAt[ps.nqp++] = r->ts->qs[rq.qpIdx].epoch;
+  });
+  h->peers[s].pauseStartMs = t0;
+  char w[160] = {0};
+  uint64_t P[NCCL_GIN_RECOVERY_MAX_QPS] = {};
+  int np = 0;
+  const ncclResult_t qr = gdakiCkptQuiesce(r, s, &why, &rung);
+  ps.quiesceSeqAt = h->peers[s].quiesceSeq;  // after the pause's own quiesce (it moved the count once)
+  if (qr != ncclSuccess ||
+      gdakiRsLogPauseRead(r, s, &ps.pause, w, sizeof(w)) != ncclSuccess ||
+      gdakiRsExecRead(r, s, P, &np) != ncclSuccess || np != ps.nqp || ps.pause.nqp != ps.nqp) {
+    GIN_TS_NOTE("GIN/RS: rank %d: the input pause for rank %d's checkpoint %lu failed (%s) mono_ms=%.3f", h->rank, s,
+                (unsigned long)k, why ? why : w[0] ? w : "the counts could not be read", gdakiQ4MonoMs());
+    gdakiCkptEndPause(r, s, "a failed pause");
+    gdakiCkptReply(r, s, GDAKI_TS_BUSY, k, GDAKI_CKPT_BUSY_PAUSE);
+    ck->nBusySent.fetch_add(1, std::memory_order_relaxed);
+    return;
+  }
+  ps.disarmSeq = h->peers[s].disarmSeq;
+  const uint32_t st = gdakiHoldStateOf(gdakiHoldLoad(h->cells[s]));
+  ps.armable = gdakiHoldCommArmedNow(h) && r->ts->policyEff == GDAKI_POLICY_HOLD && gdakiLbOn(r) &&
+               ps.pause.logComplete && !pe.declined && st != GDAKI_HOLD_FALLBACK && st != GDAKI_HOLD_CANCELLED;
+  struct gdakiTsMsg a;
+  gdakiHoldMsgInit(&a, GDAKI_TS_PAUSED, s, 0);
+  a.round = k;
+  a.pad = (ps.armable ? GDAKI_CKPT_PAUSED_ARMABLE : 0u) | (ps.pause.firstPause ? GDAKI_CKPT_PAUSED_FIRST : 0u);
+  a.nqp = (uint32_t)ps.nqp;
+  for (int i = 0; i < ps.nqp; i++) {
+    a.tok.epochWqes[i] = ps.pause.msgs[i];
+    gdakiCkptPackP(P[i], &a.executed[i], &a.nrp[i]);
+  }
+  if (gdakiHoldSend(r, s, &a) != 0) {
+    gdakiCkptEndPause(r, s, "PAUSED could not be sent");
+    return;
+  }
+  ck->nPausedFor.fetch_add(1, std::memory_order_relaxed);
+}
+// CKPT_RESUME from r: confirm (the empty round) or void (9.11.9 C1).
+static void gdakiCkptOnResume(struct gdakiRecHost* r, int from, const struct gdakiTsMsg& m) {
+  struct gdakiCkpt* ck = gdakiCkptOf(r);
+  const int s = from;
+  struct gdakiCkptPeerSide& ps = ck->peers[s];
+  const int st = ps.paused ? gdakiCkptPauseState(r, s, ps) : GDAKI_CKPT_P_ENDED;
+  if (ps.paused && ps.ckpt == m.round && st == GDAKI_CKPT_P_BROKEN) {  // gates nothing else will publish: as a failed round
+    ps.paused = false;
+    r->hold->peers[s].pauseStartMs = 0;
+    gdakiCkptPauseLine(r, s, ps, "a gate could not be read, or only some show the pause");
+    if (!(m.pad & 1u)) gdakiCkptReply(r, s, GDAKI_TS_BUSY, m.round, GDAKI_CKPT_BUSY_VOIDED);
+    char w[128];
+    snprintf(w, sizeof(w), "the gates of checkpoint %lu's pause are not as it left them", (unsigned long)m.round);
+    gdakiTsDecline(r, s, w, true, 0, gdakiCause::Local);
+    return;
+  }
+  const bool intact = st == GDAKI_CKPT_P_INTACT;
+  const int v = gdakiCkptResumeVerdict(ps.paused, ps.ckpt, m.round, (m.pad & 1u) != 0, r->ts->peers[s].declined, intact,
+                                       intact);
+  switch (v) {
+    case GDAKI_CKPT_R_UNPAUSE: gdakiCkptEndPause(r, s, "the checkpoint was given up"); return;
+    case GDAKI_CKPT_R_VOIDED:
+      ps.paused = false;
+      r->hold->peers[s].pauseStartMs = 0;
+      gdakiCkptPauseLine(r, s, ps, "voided: a round or a decline came first");
+      gdakiCkptReply(r, s, GDAKI_TS_BUSY, m.round, GDAKI_CKPT_BUSY_VOIDED);
+      return;
+    case GDAKI_CKPT_R_HELD: {
+      const char* why = nullptr;
+      ps.paused = false;
+      r->hold->peers[s].pauseStartMs = 0;
+      const bool ok = gdakiCkptEmptyRound(r, s, &why);
+      gdakiCkptPauseLine(r, s, ps, ok ? "held, empty round" : "the empty round failed");
+      if (!ok) {
+        char w[160];
+        snprintf(w, sizeof(w), "the end of checkpoint %lu's pause failed: %s", (unsigned long)m.round, why ? why : "?");
+        gdakiCkptReply(r, s, GDAKI_TS_BUSY, m.round, GDAKI_CKPT_BUSY_VOIDED);
+        gdakiTsDecline(r, s, w, true, 0, gdakiCause::Local);
+        return;
+      }
+      struct gdakiCkptCutRec c;
+      c.pause = ps.pause;
+      c.disarmSeq = ps.disarmSeq;
+      c.armable = ps.armable;
+      ps.cuts.confirmed(m.round, c);
+      gdakiCkptReply(r, s, GDAKI_TS_PAUSED, m.round, GDAKI_CKPT_PAUSED_HELD);
+      return;
+    }
+    default:
+      if (ps.paused && ps.ckpt == m.round) {  // r gave up and the pause ended otherwise already
+        ps.paused = false;
+        r->hold->peers[s].pauseStartMs = 0;
+        gdakiCkptPauseLine(r, s, ps, "given up, already ended otherwise");
+      }
+      return;
+  }
+}
+// CKPT_STABLE from r: the buddy marks its image stable; every peer trims its log toward r to that cut and arms r.
+static void gdakiCkptOnStable(struct gdakiRecHost* r, int from, const struct gdakiTsMsg& m) {
+  struct gdakiHold* h = r->hold;
+  struct gdakiCkpt* ck = gdakiCkptOf(r);
+  const int s = from;
+  if (gdakiHoldBuddyOf(s, h->nranks) == h->rank) {
+    bool marked;
+    {
+      std::lock_guard<std::mutex> lk(ck->storeMu);
+      marked = ck->store[s].markStable(m.round);
+    }
+    if (!marked) {  // no image of k here while the others trim to k: no restore of r can work until its next one
+      GIN_TS_NOTE("GIN/RS: rank %d: CKPT_STABLE %lu of rank %d, but no complete upload of it here; not trimmed, not armed "
+                  "mono_ms=%.3f", h->rank, (unsigned long)m.round, s, gdakiQ4MonoMs());
+      gdakiHoldDisarm(r, s, "its buddy has no image of its stable checkpoint", true);
+      return;
+    }
+  }
+  struct gdakiCkptPeerSide& ps = ck->peers[s];
+  const struct gdakiCkptCut<struct gdakiCkptCutRec>* c = ps.cuts.find(m.round);
+  if (c == nullptr) {
+    GIN_TS_NOTE("GIN/RS: rank %d: CKPT_STABLE %lu of rank %d without a confirmed cut here; ignored mono_ms=%.3f",
+                h->rank, (unsigned long)m.round, s, gdakiQ4MonoMs());
+    return;
+  }
+  const struct gdakiCkptCutRec rec = c->rec;
+  char w[160] = {0};
+  if (gdakiRsLogStable(r, s, &rec.pause, w, sizeof(w)) != ncclSuccess) {
+    GIN_TS_NOTE("GIN/RS: rank %d: the log toward rank %d could not be trimmed at checkpoint %lu (%s); not armed "
+                "mono_ms=%.3f", h->rank, s, (unsigned long)m.round, w, gdakiQ4MonoMs());
+    return;
+  }
+  (void)ps.cuts.markStable(m.round);
+  if (!(m.pad & GDAKI_CKPT_STABLE_ARMABLE) || !rec.armable) {
+    // the older cut an earlier arming stood on is gone: not armed until a stable checkpoint that is armable (local only:
+    // every peer reads the same CKPT_STABLE)
+    if (gdakiHoldPeerState(r, s, nullptr) == GDAKI_HOLD_ARMED)
+      gdakiHoldDisarm(r, s, "its stable checkpoint is not armable", false);
+    return;
+  }
+  {
+    uint32_t inc = 0;
+    (void)gdakiHoldPeerState(r, s, &inc);
+    const char* why = "";
+    if (gdakiHoldArm(r, s, inc, rec.disarmSeq, &why))
+      GIN_TS_NOTE("GIN/RS: rank %d: rank %d armed at its stable checkpoint %lu mono_ms=%.3f", h->rank, s,
+                  (unsigned long)m.round, gdakiQ4MonoMs());
+    else
+      GIN_TS_NOTE("GIN/RS: rank %d: rank %d not armed at its stable checkpoint %lu (%s) mono_ms=%.3f", h->rank, s,
+                  (unsigned long)m.round, why, gdakiQ4MonoMs());
+  }
+}
+
+// ---- the checkpointing rank (helper) ----
+static void gdakiCkptOnReply(struct gdakiRecHost* r, int from, const struct gdakiTsMsg& m) {
+  struct gdakiCkpt* ck = gdakiCkptOf(r);
+  if (from < 0 || from >= r->nranks || from == r->ctx->rank) return;
+  // a pause this rank does not wait for (a given-up checkpoint, an older one): release it at once (it is never confirmed)
+  const bool pauseAnswer = m.type == GDAKI_TS_PAUSED && !(m.pad & GDAKI_CKPT_PAUSED_HELD);
+  const bool current = m.round == ck->ckpt && from < (int)ck->rep.state.size() && ck->phase != GDAKI_CKPT_I_IDLE;
+  if (pauseAnswer && !current) {
+    struct gdakiTsMsg u;
+    gdakiHoldMsgInit(&u, GDAKI_TS_CKPT_RESUME, r->ctx->rank, 0);
+    u.round = m.round;
+    u.pad = 1;  // given up
+    (void)gdakiHoldSend(r, from, &u);
+    return;
+  }
+  if (!current) return;
+  uint8_t& st = ck->rep.state[(size_t)from];
+  if (ck->phase == GDAKI_CKPT_I_PAUSING && st == 0) {
+    if (m.type == GDAKI_TS_BUSY) {
+      st = 2;
+      GIN_TS_NOTE("GIN/RS: rank %d: rank %d answered BUSY (%u) to checkpoint %lu mono_ms=%.3f", r->ctx->rank, from, m.pad,
+                  (unsigned long)m.round, gdakiQ4MonoMs());
+    } else if (m.type == GDAKI_TS_PAUSED && !(m.pad & GDAKI_CKPT_PAUSED_HELD) && m.nqp <= NCCL_GIN_RECOVERY_MAX_QPS) {
+      st = 1;
+      ck->rep.armable[(size_t)from] = (m.pad & GDAKI_CKPT_PAUSED_ARMABLE) ? 1 : 0;
+      ck->nqp[(size_t)from] = (int)m.nqp;
+      for (uint32_t i = 0; i < m.nqp; i++) {
+        ck->m[(size_t)from * NCCL_GIN_RECOVERY_MAX_QPS + i] = m.tok.epochWqes[i];
+        ck->p[(size_t)from * NCCL_GIN_RECOVERY_MAX_QPS + i] = gdakiCkptUnpackP(m.executed[i], m.nrp[i]);
+      }
+    }
+  } else if ((ck->phase == GDAKI_CKPT_I_CONFIRMING || ck->phase == GDAKI_CKPT_I_COPYING) && st == 1) {
+    if (ck->phase == GDAKI_CKPT_I_CONFIRMING && m.type == GDAKI_TS_PAUSED && (m.pad & GDAKI_CKPT_PAUSED_HELD)) st = 3;
+    else if (m.type == GDAKI_TS_BUSY) st = 4;  // its pause ended early: the checkpoint is void
+  }
+}
+// The drain check (9.4 step 3): every peer's messages executed here (the cumulative count of every QP equals what its
+// PAUSED said; QUERY_QP outside the firmware guard, at least 50 us apart, at most NCCL_GIN_RESTORE_DRAIN_QUERIES), then
+// the side table's fence word READ over the NIC loopback (strict MR: every earlier write of the NIC to this GPU is
+// visible).
+static bool gdakiCkptDrain(struct gdakiRecHost* r, bool readFence, char* why, size_t whyLen) {
+  struct gdakiCkpt* ck = gdakiCkptOf(r);
+  const int n = r->nranks, me = r->ctx->rank;
+  std::vector<uint8_t> done((size_t)n, 0);
+  done[(size_t)me] = 1;
+  int queries = 0;
+  const double t0 = gdakiQ4MonoMs();
+  const int64_t budget = std::max<int64_t>(1, ncclParamGinRestoreDrainQueries());
+  for (;;) {
+    bool all = true;
+    for (int q = 0; q < n; q++) {
+      if (done[(size_t)q]) continue;
+      uint64_t x[NCCL_GIN_RECOVERY_MAX_QPS] = {};
+      int nx = 0;
+      if (gdakiRsExecRead(r, q, x, &nx) != ncclSuccess || nx != ck->nqp[(size_t)q]) {
+        snprintf(why, whyLen, "the executed counts of rank %d's messages could not be read", q);
+        return false;
+      }
+      queries += nx;
+      const int v = gdakiCkptDrainVerdict(x, &ck->m[(size_t)q * NCCL_GIN_RECOVERY_MAX_QPS], nx);
+      if (v == GDAKI_CKPT_DRAIN_VOID) {
+        snprintf(why, whyLen, "rank %d's messages executed here exceed what it posted (a count went wrong)", q);
+        return false;
+      }
+      if (v == GDAKI_CKPT_DRAINED) done[(size_t)q] = 1;
+      else all = false;
+    }
+    if (all) break;
+    if (gdakiQ4MonoMs() - t0 > (double)ncclParamGinRestoreDrainMs() || queries >= budget) {
+      snprintf(why, whyLen, "not drained within NCCL_GIN_RESTORE_DRAIN_MS or NCCL_GIN_RESTORE_DRAIN_QUERIES (%d queries)",
+               queries);
+      return false;
+    }
+    r->ts->heartbeatUs.store(gdakiTsNowUs(), std::memory_order_release);
+    std::this_thread::sleep_for(std::chrono::microseconds(50));
+  }
+  if (!readFence) return true;
+  const struct ncclGinRsSide* side = (const struct ncclGinRsSide*)r->rsBase;
+  if (side == nullptr || !gdakiLbOn(r) || gdakiLbXfer(r, false, &side->fence, sizeof(uint64_t)) != ncclSuccess) {
+    snprintf(why, whyLen, "the fence READ over the NIC loopback failed");
+    return false;
+  }
+  return true;
+}
+static void gdakiCkptPhase(struct gdakiCkpt* ck, int ph) {
+  ck->phase = ph;
+  std::lock_guard<std::mutex> lk(ck->mu);
+  ck->phasePub = ph;
+}
+// Gives the checkpoint up: CKPT_RESUME(given up) to every peer that was sent CKPT_PAUSE and did not answer BUSY (paused,
+// or its PAUSED still on the way: the socket delivers in order, so it reads the RESUME after it paused and unpauses).
+static void gdakiCkptAbort(struct gdakiRecHost* r, const char* why) {
+  struct gdakiCkpt* ck = gdakiCkptOf(r);
+  for (int q = 0; q < ck->rep.n; q++)
+    if (q != r->ctx->rank && ck->rep.releaseOnAbort(q)) {
+      struct gdakiTsMsg m;
+      gdakiHoldMsgInit(&m, GDAKI_TS_CKPT_RESUME, r->ctx->rank, 0);
+      m.round = ck->ckpt;
+      m.pad = 1;  // given up
+      (void)gdakiHoldSend(r, q, &m);
+    }
+  {
+    std::lock_guard<std::mutex> lk(ck->mu);
+    if (ck->req == GDAKI_CKPT_REQ_ASKED || ck->req == GDAKI_CKPT_REQ_DRAINED) {
+      ck->req = GDAKI_CKPT_REQ_SKIPPED;
+      snprintf(ck->reqWhy, sizeof(ck->reqWhy), "%s", why);
+    }
+  }
+  ck->cv.notify_all();
+  ck->nSkipped.fetch_add(1, std::memory_order_relaxed);
+  GIN_TS_NOTE("GIN/RS: rank %d: checkpoint %lu not taken: %s mono_ms=%.3f", r->ctx->rank, (unsigned long)ck->ckpt, why,
+              gdakiQ4MonoMs());
+  gdakiCkptPhase(ck, GDAKI_CKPT_I_IDLE);
+}
+// One step of this rank's own checkpoint (helper).
+static void gdakiCkptVoid(struct gdakiRecHost* r, const char* why) {
+  struct gdakiCkpt* ck = gdakiCkptOf(r);
+  ck->nVoid.fetch_add(1, std::memory_order_relaxed);
+  GIN_TS_NOTE("GIN/RS: rank %d: checkpoint %lu is void (%s) mono_ms=%.3f", r->ctx->rank, (unsigned long)ck->ckpt, why,
+              gdakiQ4MonoMs());
+  gdakiCkptPhase(ck, GDAKI_CKPT_I_IDLE);
+}
+static void gdakiCkptInitStep(struct gdakiRecHost* r) {
+  struct gdakiCkpt* ck = gdakiCkptOf(r);
+  struct gdakiHold* h = r->hold;
+  const double now = gdakiQ4MonoMs();
+  const double pauseMs = (double)gdakiCkptPauseMs();
+  int req;
+  uint64_t reqCkpt;
+  bool reqOk;
+  {
+    std::lock_guard<std::mutex> lk(ck->mu);
+    if (ck->phase == GDAKI_CKPT_I_IDLE && ck->req == GDAKI_CKPT_REQ_COPIED) ck->req = GDAKI_CKPT_REQ_NONE;  // stray
+    req = ck->req;
+    reqCkpt = ck->reqCkpt;
+    reqOk = ck->reqOk;
+  }
+  const int n = r->nranks, me = r->ctx->rank;
+  switch (ck->phase) {
+    case GDAKI_CKPT_I_IDLE: {
+      if (req != GDAKI_CKPT_REQ_ASKED) return;
+      ck->ckpt = reqCkpt;
+      ck->rep.reset(n, me);
+      ck->m.assign((size_t)n * NCCL_GIN_RECOVERY_MAX_QPS, 0);
+      ck->p.assign((size_t)n * NCCL_GIN_RECOVERY_MAX_QPS, 0);
+      ck->nqp.assign((size_t)n, 0);
+      const char* tw = "";
+      bool upBusy;
+      {
+        std::lock_guard<std::mutex> lk(ck->mu);
+        upBusy = ck->up.pending || ck->up.running;
+      }
+      const char* no = h->heldPeer.load(std::memory_order_acquire) >= 0 ? "a restore runs"
+                       : gdakiHoldTold(r, -1, false, &tw)                ? "a fault already reached the application"
+                       : gdakiCkptSuppressLeft(r)                        ? "replayed messages are still held back"
+                       : !gdakiLbOn(r)                                   ? "the NIC copy path is off"
+                       : gdakiHoldBuddyOf(me, n) < 0                     ? "no buddy"
+                       : upBusy                                          ? "the previous upload still runs"
+                                                                         : nullptr;
+      gdakiCkptPhase(ck, GDAKI_CKPT_I_PAUSING);
+      ck->pausingStartMs = now;
+      if (no) return gdakiCkptAbort(r, no);
+      for (int q = 0; q < n; q++) {
+        if (q == me) continue;
+        struct gdakiTsMsg m;
+        gdakiHoldMsgInit(&m, GDAKI_TS_CKPT_PAUSE, me, 0);
+        m.round = ck->ckpt;
+        ck->rep.sent[(size_t)q] = 1;  // also on a failed send: the abort's CKPT_RESUME is harmless if it never paused
+        if (gdakiHoldSend(r, q, &m) != 0) {
+          char w[96];
+          snprintf(w, sizeof(w), "CKPT_PAUSE could not be sent to rank %d", q);
+          return gdakiCkptAbort(r, w);
+        }
+      }
+      ck->phaseUntilMs = now + pauseMs;
+      return;
+    }
+    case GDAKI_CKPT_I_PAUSING: {
+      if (req != GDAKI_CKPT_REQ_ASKED) return gdakiCkptAbort(r, "the application stopped waiting");
+      if (ck->rep.anyBusy()) return gdakiCkptAbort(r, "a peer answered BUSY");
+      if (!ck->rep.allPausedOrBusy()) {
+        if (now > ck->phaseUntilMs) return gdakiCkptAbort(r, "no PAUSED from every peer within NCCL_GIN_RESTORE_PAUSE_MS");
+        return;
+      }
+      char w[160] = {0};
+      {
+        gdakiTsBusy b(r->ts);
+        if (!gdakiCkptDrain(r, true, w, sizeof(w))) return gdakiCkptAbort(r, w);
+      }
+      bool gone;
+      {  // decided under the lock; the abort (it takes the lock itself) after it
+        std::lock_guard<std::mutex> lk(ck->mu);
+        gone = ck->req != GDAKI_CKPT_REQ_ASKED;
+        if (!gone) ck->req = GDAKI_CKPT_REQ_DRAINED;
+      }
+      if (gone) return gdakiCkptAbort(r, "the application stopped waiting");
+      ck->cv.notify_all();
+      gdakiCkptPhase(ck, GDAKI_CKPT_I_COPYING);
+      // before the peers' own bound (4 x NCCL_GIN_RESTORE_PAUSE_MS from their pause, which began after pausingStartMs)
+      ck->phaseUntilMs = ck->pausingStartMs + 3.0 * pauseMs;
+      return;
+    }
+    case GDAKI_CKPT_I_COPYING: {
+      if (ck->rep.anyBusy()) return gdakiCkptAbort(r, "a peer's pause ended early");
+      if (req != GDAKI_CKPT_REQ_COPIED) {
+        if (req == GDAKI_CKPT_REQ_DRAINED && now <= ck->phaseUntilMs) return;
+        return gdakiCkptAbort(r, "the application's copy did not end in time");
+      }
+      char w[160] = {0};
+      bool valid = reqOk;
+      if (!valid) snprintf(w, sizeof(w), "the copy failed");
+      if (valid) {  // the counts again: nothing of a peer executed here since the drain (else the copy may hold it)
+        gdakiTsBusy b(r->ts);
+        valid = gdakiCkptDrain(r, false, w, sizeof(w));
+      }
+      for (int q = 0; q < n; q++) {
+        if (q == me || ck->rep.state[(size_t)q] != 1) continue;
+        struct gdakiTsMsg m;
+        gdakiHoldMsgInit(&m, GDAKI_TS_CKPT_RESUME, me, 0);
+        m.round = ck->ckpt;
+        m.pad = valid ? 0u : 1u;
+        (void)gdakiHoldSend(r, q, &m);
+      }
+      if (valid) gdakiCkptStartUpload(r);  // before the application may ask for the next one (it reads this one's data)
+      {
+        std::lock_guard<std::mutex> lk(ck->mu);
+        ck->req = GDAKI_CKPT_REQ_NONE;
+      }
+      if (!valid) return gdakiCkptVoid(r, w);
+      gdakiCkptPhase(ck, GDAKI_CKPT_I_CONFIRMING);
+      ck->phaseUntilMs = gdakiQ4MonoMs() + (double)std::max<int64_t>(30000, 4 * gdakiCkptPauseMs());
+      return;
+    }
+    case GDAKI_CKPT_I_CONFIRMING: {
+      bool done, ok;
+      {
+        std::lock_guard<std::mutex> lk(ck->mu);
+        done = ck->up.done;
+        ok = ck->up.ok;
+      }
+      if (ck->rep.anyBusy()) return gdakiCkptVoid(r, "a peer's pause did not hold");
+      for (int q = 0; q < n; q++)  // a peer that died or is held never confirms
+        if (q != me && ck->rep.state[(size_t)q] == 1 &&
+            (r->ts->peers[q].declined || gdakiHoldIsHeldState(gdakiHoldPeerState(r, q, nullptr))))
+          return gdakiCkptVoid(r, "a peer was declined or is held before it confirmed");
+      if (!done || !ck->rep.allConfirmed()) {
+        if (now > ck->phaseUntilMs) gdakiCkptVoid(r, "no confirmation or upload in time");
+        return;
+      }
+      if (!ok) return gdakiCkptVoid(r, "the upload failed");
+      // stable: the buddy first (a peer that saw CKPT_STABLE implies the buddy has it before any later FIN), then the
+      // rest; no buddy, no stable checkpoint
+      const bool armable = ck->rep.allArmable() && gdakiCkptSelfOf().haveSpare;
+      const int b = gdakiHoldBuddyOf(me, n);
+      struct gdakiTsMsg m;
+      gdakiHoldMsgInit(&m, GDAKI_TS_CKPT_STABLE, me, 0);
+      m.round = ck->ckpt;
+      m.pad = armable ? GDAKI_CKPT_STABLE_ARMABLE : 0u;
+      if (gdakiHoldSend(r, b, &m) != 0) return gdakiCkptVoid(r, "CKPT_STABLE could not be sent to the buddy");
+      {  // this image is the next upload's base (the buddy marked it stable with the CKPT_STABLE above)
+        std::lock_guard<std::mutex> lk(ck->mu);
+        ck->haveBase = true;
+        ck->baseCkpt = ck->ckpt;
+        ck->baseHashes = ck->curHashes;
+      }
+      for (int q = 0; q < n; q++) {
+        if (q == me || q == b) continue;
+        gdakiHoldMsgInit(&m, GDAKI_TS_CKPT_STABLE, me, 0);
+        m.round = ck->ckpt;
+        m.pad = armable ? GDAKI_CKPT_STABLE_ARMABLE : 0u;
+        (void)gdakiHoldSend(r, q, &m);
+      }
+      gdakiCkptPhase(ck, GDAKI_CKPT_I_IDLE);
+      ck->nStable.fetch_add(1, std::memory_order_relaxed);
+      GIN_TS_NOTE("GIN/RS: rank %d: checkpoint %lu stable at buddy rank %d (%s) mono_ms=%.3f", me, (unsigned long)ck->ckpt, b,
+                  armable ? "armable" : "not armable", gdakiQ4MonoMs());
+      return;
+    }
+    default: return;
+  }
+}
+// The peers' side, every helper loop: a pause that outlived its bound (4 x NCCL_GIN_RESTORE_PAUSE_MS: the checkpointing
+// rank is gone or stuck) ends early and voids its checkpoint; not toward a held peer (the hold keeps its gates odd).
+static void gdakiCkptPeerStep(struct gdakiRecHost* r) {
+  struct gdakiCkpt* ck = gdakiCkptOf(r);
+  const double now = gdakiQ4MonoMs();
+  for (int s = 0; s < (int)ck->peers.size(); s++) {
+    struct gdakiCkptPeerSide& ps = ck->peers[s];
+    if (!ps.paused || now - ps.startMs <= 4.0 * (double)gdakiCkptPauseMs()) continue;
+    if (gdakiHoldIsHeldState(gdakiHoldStateOf(gdakiHoldLoad(r->hold->cells[s])))) continue;
+    GIN_TS_NOTE("GIN/RS: rank %d: the pause for rank %d's checkpoint %lu ended early (%.0f ms) mono_ms=%.3f", r->ctx->rank, s,
+                (unsigned long)ps.ckpt, now - ps.startMs, now);
+    const uint64_t k = ps.ckpt;
+    gdakiCkptEndPause(r, s, "its bound");
+    gdakiCkptReply(r, s, GDAKI_TS_BUSY, k, GDAKI_CKPT_BUSY_VOIDED);
+  }
+}
+// A hold of `peer` starts: an input pause toward it ends without an empty round (the hold's quiesce owns the gates).
+static void gdakiCkptOnHoldStart(struct gdakiRecHost* r, int peer) {
+  struct gdakiCkpt* ck = gdakiCkptOf(r);
+  if (ck == nullptr || peer < 0 || peer >= (int)ck->peers.size() || !ck->peers[peer].paused) return;
+  ck->peers[peer].paused = false;
+  gdakiCkptPauseLine(r, peer, ck->peers[peer], "a hold of that rank took its gates");
+}
+// A hold of `peer` ended (its RESTORED, or a fallback): the cuts toward it belong to the incarnation that died (a new one
+// numbers its checkpoints by its steps again; an old cut of the same step must never be found).
+static void gdakiCkptPeerReset(struct gdakiRecHost* r, int peer) {
+  struct gdakiCkpt* ck = gdakiCkptOf(r);
+  if (ck == nullptr || peer < 0 || peer >= (int)ck->peers.size()) return;
+  ck->peers[(size_t)peer].cuts = gdakiCkptCuts<struct gdakiCkptCutRec>();
+}
+// The checkpoint's records (gdakiHoldOnMsg hands them over, in arrival order per peer).
+static void gdakiCkptOnMsg(struct gdakiRecHost* r, int from, const struct gdakiTsMsg& m) {
+  struct gdakiCkpt* ck = gdakiCkptOf(r);
+  // CKPT_PAUSE, CKPT_RESUME, CKPT_STABLE name their sender (the checkpointing rank); PAUSED and BUSY name this rank
+  const bool toMe = m.type == GDAKI_TS_PAUSED || m.type == GDAKI_TS_BUSY;
+  if (ck == nullptr || from < 0 || from >= r->nranks || from == r->ctx->rank || m.arg != (toMe ? r->ctx->rank : from))
+    return;
+  switch (m.type) {
+    case GDAKI_TS_CKPT_PAUSE: return gdakiCkptOnPause(r, from, m);
+    case GDAKI_TS_CKPT_RESUME: return gdakiCkptOnResume(r, from, m);
+    case GDAKI_TS_CKPT_STABLE: return gdakiCkptOnStable(r, from, m);
+    case GDAKI_TS_PAUSED:
+    case GDAKI_TS_BUSY: return gdakiCkptOnReply(r, from, m);
+    default: return;
+  }
+}
+static void gdakiCkptStep(struct gdakiRecHost* r) {
+  if (gdakiCkptOf(r) == nullptr) return;
+  gdakiCkptPeerStep(r);
+  gdakiCkptInitStep(r);
+}
+
+// ---- the data threads (impl/rs_ckpt_api.h's data socket) ----
+// The helper hands this rank's upload of checkpoint ck->ckpt (its header: regions, the peers' P, the spare) to the upload
+// thread, which copies the GPU copy to host memory, hashes its blocks, sends the changed ones to the buddy and waits for
+// the buddy's acknowledgement.
+static void gdakiCkptStartUpload(struct gdakiRecHost* r) {
+  struct gdakiCkpt* ck = gdakiCkptOf(r);
+  const int me = r->ctx->rank, n = r->nranks, b = gdakiHoldBuddyOf(me, n);
+  const struct gdakiCkptSelf& self = gdakiCkptSelfOf();
+  std::lock_guard<std::mutex> lk(ck->mu);
+  struct gdakiCkptUpload& u = ck->up;
+  u = gdakiCkptUpload();
+  u.pending = true;
+  u.ckpt = ck->ckpt;
+  u.buddyRank = b;
+  u.buddy = r->ts->peers[b].addr;
+  struct gdakiCkptHdr& h = u.hdr;
+  memset(&h, 0, sizeof(h));
+  h.magic = GDAKI_CKPT_MAGIC;
+  h.version = GDAKI_CKPT_VERSION;
+  h.rank = me;
+  h.incarnation = gdakiRsPeerInc(r, me);
+  h.nonce = r->ts->nonce;
+  h.ckpt = ck->ckpt;
+  h.imageBytes = ck->imageBytes;
+  h.blockBytes = GDAKI_CKPT_BLOCK;
+  h.nRegions = (uint32_t)ck->regions.size();
+  for (size_t i = 0; i < ck->regions.size(); i++) {
+    h.region[i].kind = ck->regions[i].kind;
+    h.region[i].id = ck->regions[i].id;
+    h.region[i].offset = ck->regionOff[i];
+    h.region[i].bytes = ck->regions[i].bytes;
+  }
+  h.blobBytes = (uint32_t)ck->blob.size();
+  for (int q = 0; q < n && h.nPeers < GDAKI_CKPT_MAX_PEERS; q++) {
+    if (q == me) continue;
+    struct gdakiCkptPeerP& pp = h.peerP[h.nPeers++];
+    pp.rank = q;
+    pp.nqp = (uint32_t)ck->nqp[(size_t)q];
+    for (uint32_t i = 0; i < pp.nqp; i++) pp.p[i] = ck->p[(size_t)q * NCCL_GIN_RECOVERY_MAX_QPS + i];
+  }
+  if (self.haveSpare) memcpy(h.spareAddr, &self.spare, std::min(sizeof(h.spareAddr), sizeof(self.spare)));
+  h.pid = self.pid;
+  h.pidStart = self.pidStart;
+  u.blob = ck->blob;
+  ck->cv.notify_all();
+}
+static void gdakiCkptUploadOne(struct gdakiRecHost* r, struct gdakiCkptUpload& u, char* why, size_t whyLen, bool* ok) {
+  struct gdakiCkpt* ck = gdakiCkptOf(r);
+  const int toMs = r->ts->handshakeMs;
+  *ok = false;
+  // the GPU copy to host memory (this thread's own stream; bounded)
+  const uint64_t bytes = u.hdr.imageBytes;
+  if (bytes > ck->hostCopyBytes || ck->hostCopy == nullptr ||
+      cudaMemcpyAsync(ck->hostCopy, ck->devCopy, (size_t)bytes, cudaMemcpyDeviceToHost, ck->upStream) != cudaSuccess) {
+    snprintf(why, whyLen, "the copy to host memory could not be started");
+    return;
+  }
+  const double t0 = gdakiQ4MonoMs();
+  for (;;) {
+    const cudaError_t e = cudaStreamQuery(ck->upStream);
+    if (e == cudaSuccess) break;
+    if (e != cudaErrorNotReady || gdakiQ4MonoMs() - t0 > 10000.0 || ck->stop.load(std::memory_order_acquire)) {
+      snprintf(why, whyLen, "the copy to host memory did not end");
+      return;
+    }
+    std::this_thread::sleep_for(std::chrono::microseconds(200));
+  }
+  const uint64_t nb = gdakiCkptNBlocks(bytes);
+  std::vector<uint64_t> hashes((size_t)nb);
+  for (uint64_t i = 0; i < nb; i++)
+    hashes[(size_t)i] = gdakiCkptHash(ck->hostCopy + i * GDAKI_CKPT_BLOCK, (size_t)gdakiCkptBlockLen(i, bytes),
+                                      GDAKI_CKPT_HASH_SEED);
+  bool haveBase;
+  uint64_t base;
+  std::vector<uint64_t> baseHashes;
+  {
+    std::lock_guard<std::mutex> lk(ck->mu);
+    haveBase = ck->haveBase;
+    base = ck->baseCkpt;
+    baseHashes = ck->baseHashes;
+  }
+  const std::vector<uint64_t> changed = gdakiCkptChanged(baseHashes, haveBase, hashes);
+  struct gdakiCkptHdr h = u.hdr;
+  h.baseCkpt = (haveBase && baseHashes.size() == hashes.size()) ? base : ~0ULL;
+  h.nChanged = changed.size();
+  const int fd = gdakiCkptDial(u.buddy, toMs);
+  if (fd < 0) {
+    snprintf(why, whyLen, "the buddy rank %d's helper socket could not be reached", u.buddyRank);
+    return;
+  }
+  bool sent = gdakiCkptSendFirst(r, fd, GDAKI_CKPT_UPLOAD, r->ctx->rank, u.ckpt, toMs) &&
+              gdakiCkptSendAll(fd, &h, sizeof(h), toMs, &ck->stop);
+  uint64_t sentBytes = sizeof(h);
+  for (size_t k = 0; sent && k < changed.size(); k++) {
+    const uint64_t i = changed[k], len = gdakiCkptBlockLen(i, bytes);
+    sent = gdakiCkptSendAll(fd, &i, sizeof(i), toMs, &ck->stop) &&
+           gdakiCkptSendAll(fd, ck->hostCopy + i * GDAKI_CKPT_BLOCK, (size_t)len, toMs, &ck->stop);
+    sentBytes += sizeof(i) + len;
+  }
+  struct gdakiCkptEnd end;
+  memset(&end, 0, sizeof(end));
+  end.magic = GDAKI_CKPT_MAGIC;
+  end.ok = 1;
+  if (sent && !u.blob.empty()) sent = gdakiCkptSendAll(fd, u.blob.data(), u.blob.size(), toMs, &ck->stop);
+  if (sent) sent = gdakiCkptSendAll(fd, &end, sizeof(end), toMs, &ck->stop);
+  struct gdakiCkptAck ack;
+  memset(&ack, 0, sizeof(ack));
+  const bool got = sent && gdakiCkptRecvAll(fd, &ack, sizeof(ack), 4 * toMs, &ck->stop);
+  close(fd);
+  if (!got || ack.magic != GDAKI_CKPT_MAGIC || ack.ckpt != u.ckpt) {
+    snprintf(why, whyLen, "the upload to buddy rank %d was not acknowledged", u.buddyRank);
+    return;
+  }
+  if (!ack.ok) {
+    snprintf(why, whyLen, "buddy rank %d refused the upload: %.100s", u.buddyRank, ack.why);
+    std::lock_guard<std::mutex> lk(ck->mu);
+    ck->haveBase = false;  // the next upload carries every block
+    return;
+  }
+  {
+    std::lock_guard<std::mutex> lk(ck->mu);
+    ck->curHashes = hashes;  // the base once this checkpoint is stable (the helper takes it then)
+  }
+  ck->nUploads.fetch_add(1, std::memory_order_relaxed);
+  ck->nUploadBytes.fetch_add((long long)sentBytes, std::memory_order_relaxed);
+  *ok = true;
+}
+static void gdakiCkptUploadMain(struct gdakiRecHost* r) {
+  struct gdakiCkpt* ck = gdakiCkptOf(r);
+  if (cudaSetDevice(r->ctx->cuda_id) != cudaSuccess) WARN("GIN/RS: upload thread cannot select CUDA device");
+  for (;;) {
+    struct gdakiCkptUpload u;
+    {
+      std::unique_lock<std::mutex> lk(ck->mu);
+      ck->cv.wait(lk, [&] { return ck->stop.load(std::memory_order_acquire) || ck->up.pending; });
+      if (ck->stop.load(std::memory_order_acquire)) return;
+      ck->up.pending = false;
+      ck->up.running = true;
+      u = ck->up;
+    }
+    char why[160] = {0};
+    bool ok = false;
+    gdakiCkptUploadOne(r, u, why, sizeof(why), &ok);
+    {
+      std::lock_guard<std::mutex> lk(ck->mu);
+      if (ck->up.ckpt == u.ckpt) {
+        ck->up.running = false;
+        ck->up.done = true;
+        ck->up.ok = ok;
+        snprintf(ck->up.why, sizeof(ck->up.why), "%s", why);
+      }
+    }
+    if (!ok)
+      GIN_TS_NOTE("GIN/RS: rank %d: the upload of checkpoint %lu failed: %s mono_ms=%.3f", r->ctx->rank,
+                  (unsigned long)u.ckpt, why, gdakiQ4MonoMs());
+  }
+}
+// The buddy's side of an UPLOAD, and a FETCH (the serve thread; one connection at a time, every read bounded).
+static void gdakiCkptServeUpload(struct gdakiRecHost* r, int fd, const struct gdakiTsMsg& first) {
+  struct gdakiCkpt* ck = gdakiCkptOf(r);
+  const int toMs = r->ts->handshakeMs, s = first.from;
+  struct gdakiCkptAck ack;
+  memset(&ack, 0, sizeof(ack));
+  ack.magic = GDAKI_CKPT_MAGIC;
+  ack.ckpt = first.round;
+  struct gdakiCkptHdr* h = new gdakiCkptHdr();
+  const char* why = "";
+  struct gdakiCkptStore st;  // the subject's images as they are now (only the stable base is needed)
+  bool ok = gdakiCkptRecvAll(fd, h, sizeof(*h), toMs, &ck->stop) && h->rank == s && h->ckpt == first.round &&
+            h->nonce == r->ts->nonce;
+  if (!ok) why = "a header that does not match its connection";
+  if (ok) {
+    std::lock_guard<std::mutex> lk(ck->storeMu);
+    st.haveStable = ck->store[(size_t)s].haveStable;
+    try {
+      if (st.haveStable && h->baseCkpt != ~0ULL) st.stable = ck->store[(size_t)s].stable;
+      ok = st.begin(*h, &why);
+    } catch (const std::bad_alloc&) {
+      ok = false;
+      why = "no host memory for the image";
+    }
+  }
+  std::vector<uint8_t> buf(GDAKI_CKPT_BLOCK);
+  for (uint64_t k = 0; ok && k < h->nChanged; k++) {
+    uint64_t i = 0;
+    ok = gdakiCkptRecvAll(fd, &i, sizeof(i), toMs, &ck->stop);
+    const uint64_t len = ok ? gdakiCkptBlockLen(i, h->imageBytes) : 0;
+    ok = ok && len != 0 && gdakiCkptRecvAll(fd, buf.data(), (size_t)len, toMs, &ck->stop) && st.block(i, buf.data(), len);
+    if (!ok) why = "a block did not arrive whole";
+  }
+  std::vector<uint8_t> blob;
+  struct gdakiCkptEnd end;
+  if (ok) {
+    blob.resize(h->blobBytes);
+    ok = (blob.empty() || gdakiCkptRecvAll(fd, blob.data(), blob.size(), toMs, &ck->stop)) &&
+         gdakiCkptRecvAll(fd, &end, sizeof(end), toMs, &ck->stop) && end.magic == GDAKI_CKPT_MAGIC && end.ok == 1;
+    if (!ok) why = "the blob or the end record did not arrive";
+  }
+  if (ok) {
+    st.finish(blob.data(), (uint32_t)blob.size());
+    std::lock_guard<std::mutex> lk(ck->storeMu);
+    struct gdakiCkptStore& dst = ck->store[(size_t)s];
+    dst.havePending = true;
+    dst.pending = std::move(st.pending);  // complete; the subject's CKPT_STABLE makes it the stable one
+  }
+  ack.ok = ok ? 1 : 0;
+  snprintf(ack.why, sizeof(ack.why), "%s", why);
+  (void)gdakiCkptSendAll(fd, &ack, sizeof(ack), toMs, &ck->stop);
+  if (ok) ck->nServed.fetch_add(1, std::memory_order_relaxed);
+  else
+    GIN_TS_NOTE("GIN/RS: rank %d: an upload of rank %d's checkpoint %lu refused: %s mono_ms=%.3f", r->ctx->rank, s,
+                (unsigned long)first.round, why, gdakiQ4MonoMs());
+  delete h;
+}
+static void gdakiCkptServeFetch(struct gdakiRecHost* r, int fd, const struct gdakiTsMsg& first) {
+  struct gdakiCkpt* ck = gdakiCkptOf(r);
+  const int toMs = r->ts->handshakeMs, s = first.arg;
+  struct gdakiCkptImage img;
+  bool have = false, noMem = false;
+  {
+    std::lock_guard<std::mutex> lk(ck->storeMu);
+    const struct gdakiCkptStore& st = ck->store[(size_t)s];
+    if (st.haveStable && st.stable.ckpt == first.round) {
+      try {
+        img = st.stable;
+        have = true;
+      } catch (const std::bad_alloc&) {
+        noMem = true;
+      }
+    }
+  }
+  if (!have) {
+    struct gdakiCkptAck ack;
+    memset(&ack, 0, sizeof(ack));
+    ack.magic = GDAKI_CKPT_MAGIC;
+    ack.ckpt = first.round;
+    if (noMem)
+      snprintf(ack.why, sizeof(ack.why), "no host memory to serve checkpoint %lu of rank %d", (unsigned long)first.round, s);
+    else snprintf(ack.why, sizeof(ack.why), "no stable checkpoint %lu of rank %d here", (unsigned long)first.round, s);
+    (void)gdakiCkptSendAll(fd, &ack, sizeof(ack), toMs, &ck->stop);
+    return;
+  }
+  struct gdakiCkptHdr h = img.hdr;
+  h.baseCkpt = ~0ULL;
+  h.nChanged = gdakiCkptNBlocks(img.data.size());
+  h.blobBytes = (uint32_t)img.blob.size();
+  bool ok = gdakiCkptSendAll(fd, &h, sizeof(h), toMs, &ck->stop);
+  for (uint64_t i = 0; ok && i < h.nChanged; i++)
+    ok = gdakiCkptSendAll(fd, &i, sizeof(i), toMs, &ck->stop) &&
+         gdakiCkptSendAll(fd, img.data.data() + i * GDAKI_CKPT_BLOCK, (size_t)gdakiCkptBlockLen(i, img.data.size()), toMs,
+                          &ck->stop);
+  if (ok && !img.blob.empty()) ok = gdakiCkptSendAll(fd, img.blob.data(), img.blob.size(), toMs, &ck->stop);
+  struct gdakiCkptEnd end;
+  memset(&end, 0, sizeof(end));
+  end.magic = GDAKI_CKPT_MAGIC;
+  end.ok = 1;
+  end.imageHash = gdakiCkptHash(img.data.data(), img.data.size(), GDAKI_CKPT_HASH_SEED);
+  if (ok) ok = gdakiCkptSendAll(fd, &end, sizeof(end), toMs, &ck->stop);
+  GIN_TS_NOTE("GIN/RS: rank %d: checkpoint %lu of rank %d %s to its spare (%zu bytes) mono_ms=%.3f", r->ctx->rank,
+              (unsigned long)first.round, s, ok ? "served" : "could not be served", img.data.size(), gdakiQ4MonoMs());
+}
+static void gdakiCkptServeMain(struct gdakiRecHost* r) {
+  struct gdakiCkpt* ck = gdakiCkptOf(r);
+  for (;;) {
+    std::pair<int, struct gdakiTsMsg> c;
+    {
+      std::unique_lock<std::mutex> lk(ck->mu);
+      ck->cv.wait(lk, [&] { return ck->stop.load(std::memory_order_acquire) || !ck->incoming.empty(); });
+      if (ck->stop.load(std::memory_order_acquire)) return;
+      c = ck->incoming.front();
+      ck->incoming.erase(ck->incoming.begin());
+    }
+    if (c.second.pad == GDAKI_CKPT_UPLOAD) gdakiCkptServeUpload(r, c.first, c.second);
+    else gdakiCkptServeFetch(r, c.first, c.second);
+    close(c.first);
+  }
+}
+// The helper's accept step: a data connection's first record (GDAKI_TS_DATA) goes to the serve thread. UPLOAD only from
+// the rank this one is the buddy of (about itself), FETCH only about such a rank (its spare); anything else is refused.
+// False: not this layer's (the caller handles it as hk does).
+static bool gdakiCkptAccept(struct gdakiRecHost* r, int fd, const struct gdakiTsMsg& h) {
+  struct gdakiCkpt* ck = gdakiCkptOf(r);
+  if (ck == nullptr || h.type != GDAKI_TS_DATA) return false;
+  const int me = r->ctx->rank, n = r->nranks;
+  const bool ok = h.nonce == r->ts->nonce && h.arg >= 0 && h.arg < n && h.arg != me &&
+                  gdakiHoldBuddyOf(h.arg, n) == me &&
+                  ((h.pad == GDAKI_CKPT_UPLOAD && h.from == h.arg) || (h.pad == GDAKI_CKPT_FETCH && h.from == h.arg));
+  if (!ok) {
+    GIN_TS_NOTE("GIN/RS: rank %d: a data connection refused (from rank %d about rank %d, purpose %u) mono_ms=%.3f", me,
+                h.from, h.arg, h.pad, gdakiQ4MonoMs());
+    gdakiTsAbortClose(fd);
+    return true;
+  }
+  {
+    std::lock_guard<std::mutex> lk(ck->mu);
+    ck->incoming.push_back(std::make_pair(fd, h));
+  }
+  ck->cv.notify_all();
+  return true;
+}
+
+// ---- the restore's part ----
+// The survivor's state transfer to the held peer's spare (impl/rs_ckpt_api.h STATE), once its REJOIN is accepted: on the
+// helper (the log export reads the put sources over the NIC copy path), inside gdakiTsBusy, every read and write bounded
+// by the hold's deadline.
+static bool gdakiCkptPutVec(void* arg, const void* p, size_t n) {  // the export into memory (its length goes first)
+  std::vector<uint8_t>* v = (std::vector<uint8_t>*)arg;
+  if (v->size() + n > (size_t)GDAKI_CKPT_STATE_MAX) return false;
+  v->insert(v->end(), (const uint8_t*)p, (const uint8_t*)p + n);
+  return true;
+}
+// One step: the first dials the spare and asks (STATE); the next ones read its answer without blocking (1: not yet; the
+// hold's deadline bounds the wait); once it is whole, the export and the rkey list (bounded by the deadline: the spare
+// reads and writes them at once). 0 done, -1 failed (why), 1 not yet.
+static int gdakiHoldTransferStep(struct gdakiRecHost* r, int p, char* why, size_t whyLen) {
+  struct gdakiHold* h = r->hold;
+  struct gdakiCkpt* ck = gdakiCkptOf(r);
+  struct gdakiHoldPeer& hp = h->peers[p];
+  const int left = gdakiHoldLeftMs(r, p);
+  if (ck == nullptr || left <= 0) {
+    gdakiHoldXferClose(hp);
+    snprintf(why, whyLen, "no time left for the state transfer");
+    return -1;
+  }
+  const uint32_t inc = gdakiRsPeerInc(r, p);
+  if (hp.xferFd < 0) {
+    gdakiTsBusy busy(r->ts);  // the dial and the first record are bounded by a handshake each
+    const int fd = gdakiCkptDial(r->ts->peers[p].addr, std::min(left, r->ts->handshakeMs));
+    if (fd < 0) {
+      snprintf(why, whyLen, "the spare's listen socket could not be reached for the state transfer");
+      return -1;
+    }
+    if (!gdakiCkptSendFirst(r, fd, GDAKI_CKPT_STATE, p, inc, std::min(left, r->ts->handshakeMs))) {
+      close(fd);
+      snprintf(why, whyLen, "the state transfer could not be asked of the spare");
+      return -1;
+    }
+    hp.xferFd = fd;
+    hp.xferHave = 0;
+    memset(&hp.xferAns, 0, sizeof(hp.xferAns));
+    return 1;
+  }
+  while (hp.xferHave < sizeof(hp.xferAns)) {
+    const ssize_t k = recv(hp.xferFd, (char*)&hp.xferAns + hp.xferHave, sizeof(hp.xferAns) - hp.xferHave, MSG_DONTWAIT);
+    if (k > 0) {
+      hp.xferHave += (size_t)k;
+      continue;
+    }
+    if (k < 0 && (errno == EAGAIN || errno == EWOULDBLOCK || errno == EINTR)) return 1;
+    gdakiHoldXferClose(hp);
+    snprintf(why, whyLen, "the spare closed the state transfer before it answered");
+    return -1;
+  }
+  const struct gdakiTsMsg a = hp.xferAns;
+  const int fd = hp.xferFd;
+  hp.xferFd = -1;
+  hp.xferHave = 0;
+  gdakiTsBusy busy(r->ts);
+  int rc = -1;
+  const struct gdakiCkptCut<struct gdakiCkptCutRec>* cut = nullptr;
+  if (a.magic != GDAKI_TS_MAGIC || a.type != GDAKI_TS_DATA || a.from != p || a.nonce != r->ts->nonce) {
+    snprintf(why, whyLen, "the spare's answer to the state transfer is not its own");
+  } else if (a.pad != 0) {
+    snprintf(why, whyLen, "the spare refused the state transfer (%u)", a.pad);
+  } else if ((cut = ck->peers[p].cuts.find(a.round)) == nullptr) {
+    snprintf(why, whyLen, "no confirmed cut toward the peer for checkpoint %lu here", (unsigned long)a.round);
+  } else {
+    std::vector<uint8_t> x;
+    char w[160] = {0};
+    const bool exported = gdakiRsLogExport(r, p, cut->rec.pause.head, hp.headAtHold, inc, hp.xAtHold, hp.mAtHold, hp.nqp,
+                                           gdakiCkptPutVec, &x, w, sizeof(w)) == ncclSuccess;
+    const uint64_t n = x.size();
+    if (!exported) {
+      snprintf(why, whyLen, "the log export failed: %.120s", w);
+    } else if (!gdakiCkptSendAll(fd, &n, sizeof(n), std::max(1, gdakiHoldLeftMs(r, p)), nullptr) ||
+               (n > 0 && !gdakiCkptSendAll(fd, x.data(), (size_t)n, std::max(1, gdakiHoldLeftMs(r, p)), nullptr))) {
+      snprintf(why, whyLen, "the log export (%lu bytes) could not be sent to the spare", (unsigned long)n);
+    } else {
+      struct gdakiRsRkeys* keys = new gdakiRsRkeys();
+      if (gdakiRsRkeysRecv(fd, std::max(1, gdakiHoldLeftMs(r, p)), keys, w, sizeof(w)) != ncclSuccess) {
+        delete keys;
+        snprintf(why, whyLen, "the spare's rkey list did not arrive: %.110s", w);
+      } else {
+        delete hp.rkeys;
+        hp.rkeys = keys;
+        rc = 0;
+        GIN_TS_NOTE("GIN/RS: rank %d: state of checkpoint %lu sent to rank %d's spare (%lu bytes of log, %zu rkeys back) "
+                    "mono_ms=%.3f", h->rank, (unsigned long)a.round, p, (unsigned long)n, keys->e.size(),
+                    gdakiQ4MonoMs());
+      }
+    }
+  }
+  close(fd);
+  return rc;
+}
+static bool gdakiCkptRegions(struct gdakiRecHost* r, std::vector<struct gdakiCkptRegionSrc>* out);
+// The spare's FETCH (impl/rs_ckpt_api.h): checkpoint *d->step of this rank from its buddy, written into this process's
+// regions (its windows, its ncclGinRestoreRegister buffers, its signal and counter tables), the header and the blob kept in
+// `d`. On the caller's thread (the spare's Resume: CUDA copies; the spare runs no kernel yet). Once, before the first
+// survivor's state transfer is taken (gdakiCkptSpareDataFd): no survivor has published toward this process yet, so no
+// device thread of a survivor writes into these windows before the image is in place. Nothing is written unless every
+// region of the image has its place here and the image's hash matches.
+static bool gdakiCkptSpareFetch(struct gdakiCkptSpareData* d) {
+  if (d->fetched) return d->fetchOk;
+  d->fetched = true;
+  struct gdakiRecHost* r = d->r;
+  struct gdakiTs* ts = r->ts;
+  const int me = r->ctx->rank, b = gdakiHoldBuddyOf(me, r->nranks);
+  const uint64_t step = d->step != nullptr ? *d->step : 0;
+  const int toMs = std::max(1, d->timeoutMs);
+  char* why = d->fetchWhy;
+  const size_t whyLen = sizeof(d->fetchWhy);
+  const double t0 = gdakiQ4MonoMs();
+  if (b < 0 || b >= (int)ts->peers.size()) {
+    snprintf(why, whyLen, "no buddy");
+    return false;
+  }
+  const int fd = gdakiCkptDial(ts->peers[b].addr, toMs);
+  if (fd < 0) {
+    snprintf(why, whyLen, "the buddy rank %d's helper socket could not be reached", b);
+    return false;
+  }
+  d->hdr.assign(1, gdakiCkptHdr());
+  struct gdakiCkptHdr& h = d->hdr[0];
+  uint32_t w2[2] = {0, 0};
+  bool ok = gdakiCkptSendFirst(r, fd, GDAKI_CKPT_FETCH, me, step, toMs) && gdakiCkptRecvAll(fd, w2, sizeof(w2), toMs, nullptr);
+  const int kind = ok ? gdakiCkptFetchAnswer(w2[0], w2[1]) : -1;
+  if (ok && kind == 0) {  // a refusal: the rest of the ack
+    struct gdakiCkptAck ack;
+    memset(&ack, 0, sizeof(ack));
+    if (gdakiCkptRecvAll(fd, (char*)&ack + sizeof(w2), sizeof(ack) - sizeof(w2), toMs, nullptr)) ack.why[sizeof(ack.why) - 1] = '\0';
+    snprintf(why, whyLen, "buddy rank %d refused checkpoint %lu: %.100s", b, (unsigned long)step, ack.why);
+    close(fd);
+    return false;
+  }
+  if (!ok || kind < 0) {
+    snprintf(why, whyLen, "buddy rank %d's answer to the fetch did not arrive or is damaged", b);
+    close(fd);
+    return false;
+  }
+  memcpy(&h, w2, sizeof(w2));
+  ok = gdakiCkptRecvAll(fd, (char*)&h + sizeof(w2), sizeof(h) - sizeof(w2), toMs, nullptr);
+  if (!ok || h.rank != me || h.nonce != ts->nonce || h.ckpt != step || h.blockBytes != GDAKI_CKPT_BLOCK ||
+      h.nRegions > GDAKI_CKPT_MAX_REGIONS || h.nPeers > GDAKI_CKPT_MAX_PEERS || h.blobBytes > GDAKI_CKPT_MAX_BLOB ||
+      h.imageBytes > (1ULL << 40) || h.nChanged != gdakiCkptNBlocks(h.imageBytes)) {
+    snprintf(why, whyLen, "buddy rank %d's image header does not match this rank's checkpoint %lu", b, (unsigned long)step);
+    close(fd);
+    return false;
+  }
+  std::vector<uint8_t> img;
+  try {
+    img.resize((size_t)h.imageBytes);
+  } catch (const std::bad_alloc&) {
+    snprintf(why, whyLen, "no host memory for the %lu-byte image", (unsigned long)h.imageBytes);
+    close(fd);
+    return false;
+  }
+  for (uint64_t k = 0; ok && k < h.nChanged; k++) {
+    uint64_t i = ~0ULL;
+    ok = gdakiCkptRecvAll(fd, &i, sizeof(i), toMs, nullptr) && i == k &&
+         gdakiCkptRecvAll(fd, img.data() + k * GDAKI_CKPT_BLOCK, (size_t)gdakiCkptBlockLen(k, h.imageBytes), toMs, nullptr);
+  }
+  d->blob.assign(h.blobBytes, 0);
+  struct gdakiCkptEnd end;
+  memset(&end, 0, sizeof(end));
+  ok = ok && (h.blobBytes == 0 || gdakiCkptRecvAll(fd, d->blob.data(), d->blob.size(), toMs, nullptr)) &&
+       gdakiCkptRecvAll(fd, &end, sizeof(end), toMs, nullptr);
+  close(fd);
+  if (!ok || end.magic != GDAKI_CKPT_MAGIC || end.ok != 1 ||
+      end.imageHash != gdakiCkptHash(img.data(), img.size(), GDAKI_CKPT_HASH_SEED)) {
+    snprintf(why, whyLen, "buddy rank %d's image did not arrive whole (or its hash does not match)", b);
+    return false;
+  }
+  // every region of the image has its place here, of the same size, inside the image
+  std::vector<struct gdakiCkptRegionSrc> regs;
+  if (!gdakiCkptRegions(r, &regs)) {
+    snprintf(why, whyLen, "more than %d regions here", GDAKI_CKPT_MAX_REGIONS);
+    return false;
+  }
+  uint32_t kind2[GDAKI_CKPT_MAX_REGIONS], id[GDAKI_CKPT_MAX_REGIONS];
+  uint64_t bytes[GDAKI_CKPT_MAX_REGIONS];
+  int map[GDAKI_CKPT_MAX_REGIONS];
+  for (size_t j = 0; j < regs.size(); j++) {
+    kind2[j] = regs[j].kind;
+    id[j] = regs[j].id;
+    bytes[j] = regs[j].bytes;
+  }
+  const char* mw = "";
+  if (!gdakiCkptRegionMatch(h.region, (int)h.nRegions, kind2, id, bytes, (int)regs.size(), map, &mw)) {
+    snprintf(why, whyLen, "%s", mw);
+    return false;
+  }
+  for (uint32_t i = 0; i < h.nRegions; i++)
+    if (h.region[i].offset > h.imageBytes || h.region[i].bytes > h.imageBytes - h.region[i].offset) {
+      snprintf(why, whyLen, "a region lies outside the image");
+      return false;
+    }
+  for (uint32_t i = 0; i < h.nRegions; i++)
+    if (cudaMemcpy((void*)regs[(size_t)map[i]].src, img.data() + h.region[i].offset, (size_t)h.region[i].bytes,
+                   cudaMemcpyHostToDevice) != cudaSuccess) {
+      snprintf(why, whyLen, "the copy of region %u into this process's memory failed", i);
+      return false;
+    }
+  d->fetchOk = true;
+  GIN_TS_NOTE("GIN/RS: spare rank %d: checkpoint %lu fetched from buddy rank %d and written (%lu bytes, %u regions, blob %u "
+              "bytes) in %.1f ms mono_ms=%.3f", me, (unsigned long)step, b, (unsigned long)h.imageBytes, h.nRegions,
+              h.blobBytes, gdakiQ4MonoMs() - t0, gdakiQ4MonoMs());
+  return true;
+}
+// The spare's side of STATE (impl/rs_spare_api.h gdakiRsSpareRun's dataFd, called once per survivor right after its
+// REJOIN_ACK; this process's helper does not run yet). The first call fetches the image first (gdakiCkptSpareFetch). Then
+// the survivor's data connection is taken on this process's listen socket (other connections are closed: nothing else may
+// reach a spare before its RESTORED), answered with the checkpoint this spare restores from, and its export kept for the
+// replay (exports[peer], the dev branch's import); the socket is returned for the spare's rkey list, kept, and closed by
+// gdakiCkptSpareDataDone. -1 (the restore fails): no fetch, or no transfer from that survivor within timeoutMs.
+static int gdakiCkptSpareDataFd(void* arg, int peer) {
+  struct gdakiCkptSpareData* d = (struct gdakiCkptSpareData*)arg;
+  struct gdakiRecHost* r = d != nullptr ? d->r : nullptr;
+  struct gdakiTs* ts = r != nullptr ? r->ts : nullptr;
+  if (ts == nullptr || ts->listenFd < 0 || peer < 0 || peer >= r->nranks) return -1;
+  if (!gdakiCkptSpareFetch(d)) {  // the image first (once): before any survivor can publish toward this process
+    WARN("GIN/RS: spare rank %d: the checkpoint fetch failed: %s", r->ctx->rank, d->fetchWhy);
+    return -1;
+  }
+  if (d->exports.size() != (size_t)r->nranks) d->exports.assign((size_t)r->nranks, std::vector<uint8_t>());
+  const uint32_t inc = gdakiRsPeerInc(r, r->ctx->rank);
+  const double deadline = gdakiQ4MonoMs() + d->timeoutMs;
+  while (gdakiQ4MonoMs() < deadline) {
+    struct pollfd pf = {ts->listenFd, POLLIN, 0};
+    if (poll(&pf, 1, 20) != 1) continue;
+    const int fd = accept(ts->listenFd, nullptr, nullptr);
+    if (fd < 0) continue;
+    gdakiTsSockOpts(fd);
+    const int left = std::max(1, (int)(deadline - gdakiQ4MonoMs()));
+    struct gdakiTsMsg m;
+    if (!gdakiCkptRecvAll(fd, &m, sizeof(m), std::min(left, 500), nullptr) || m.magic != GDAKI_TS_MAGIC ||
+        m.type != GDAKI_TS_DATA || m.pad != GDAKI_CKPT_STATE || m.from != peer || m.nonce != ts->nonce ||
+        m.arg != r->ctx->rank || (uint32_t)m.round != inc) {
+      close(fd);  // not this survivor's state transfer (it dials again or gives up by its own deadline)
+      continue;
+    }
+    struct gdakiTsMsg a;
+    memset(&a, 0, sizeof(a));
+    a.type = GDAKI_TS_DATA;
+    a.from = r->ctx->rank;
+    a.nonce = ts->nonce;
+    a.arg = r->ctx->rank;
+    a.round = d->step != nullptr ? *d->step : 0;
+    uint64_t n = 0;
+    std::vector<uint8_t>& x = d->exports[(size_t)peer];
+    const bool ok = gdakiTsSend(fd, &a, left) == 0 && gdakiCkptRecvAll(fd, &n, sizeof(n), left, nullptr) &&
+                    n <= GDAKI_CKPT_STATE_MAX && (x.resize((size_t)n), true) &&
+                    (n == 0 || gdakiCkptRecvAll(fd, x.data(), (size_t)n, std::max(1, (int)(deadline - gdakiQ4MonoMs())),
+                                                nullptr));
+    if (!ok) {
+      x.clear();
+      close(fd);
+      return -1;
+    }
+    d->fds.push_back(fd);
+    return fd;
+  }
+  return -1;
+}
+static void gdakiCkptSpareDataDone(struct gdakiCkptSpareData* d) {
+  for (int fd : d->fds) close(fd);
+  d->fds.clear();
+}
+// The buddy's registration of `peer`'s spare: its newest stable image's spare address, PID and start time.
+static bool gdakiHoldSpareOf(struct gdakiRecHost* r, int peer, struct gdakiRsActivate* a, void* addr, size_t addrLen) {
+  struct gdakiCkpt* ck = gdakiCkptOf(r);
+  if (ck == nullptr || peer < 0 || peer >= (int)ck->store.size()) return false;
+  std::lock_guard<std::mutex> lk(ck->storeMu);
+  const struct gdakiCkptStore& st = ck->store[(size_t)peer];
+  if (!st.haveStable) return false;
+  static const uint8_t zero[sizeof(st.stable.hdr.spareAddr)] = {0};
+  if (memcmp(st.stable.hdr.spareAddr, zero, sizeof(zero)) == 0) return false;
+  memcpy(addr, st.stable.hdr.spareAddr, std::min(addrLen, sizeof(st.stable.hdr.spareAddr)));
+  a->step = st.stable.ckpt;
+  a->pid = st.stable.hdr.pid;
+  a->pidStart = st.stable.hdr.pidStart;
+  return true;
+}
+static bool gdakiHoldRespareRegistered(struct gdakiRecHost*, int) {
+  // P5: a restored rank is armed again only at its own next stable checkpoint, whose image carries its new spare (simpler
+  // than re-using the old checkpoint; the post-restore DISARM already waits for the survivors' next ones)
+  return false;
+}
+
+// ---- the application's calls (ncclGinRestoreStep, ncclGinRestoreRegister; gin/gin_host.cc's entries) ----
+static struct gdakiRecHost* gdakiCkptFindComm(void* comm) {
+  std::lock_guard<std::mutex> lk(gdakiRecRegMu);
+  for (auto* r : gdakiRecReg)
+    if (r->commKey == comm && r->hold != nullptr && r->hold->ckpt != nullptr) return r;
+  return nullptr;
+}
+// The regions of this rank's image now (application thread): its windows on the context's collComm (in registration
+// order), its ncclGinRestoreRegister buffers, its signal and counter tables.
+static bool gdakiCkptRegions(struct gdakiRecHost* r, std::vector<struct gdakiCkptRegionSrc>* out) {
+  struct gdakiCkpt* ck = gdakiCkptOf(r);
+  out->clear();
+  {
+    std::lock_guard<std::mutex> lk(gdakiRsWinMu);
+    for (const auto& w : gdakiRsWins)
+      if (w.coll == (void*)r->ctx->collComm && !w.gone && w.hi > w.lo)
+        out->push_back({GDAKI_CKPT_REGION_WINDOW, w.id, (const void*)w.lo, (uint64_t)(w.hi - w.lo)});
+  }
+  if (ck != nullptr) {
+    std::lock_guard<std::mutex> lk(ck->mu);
+    for (size_t i = 0; i < ck->registered.size(); i++)
+      out->push_back({GDAKI_CKPT_REGION_REGISTERED, (uint32_t)i, ck->registered[i].first, ck->registered[i].second});
+  }
+  struct gdaki_context* g = r->ctx;
+  if (g->signals_table && g->signals_table->buffer_bytes())
+    out->push_back({GDAKI_CKPT_REGION_SIGNALS, 0, g->signals_table->gpu_ptr, g->signals_table->buffer_bytes()});
+  if (g->counters_table && g->counters_table->buffer_bytes())
+    out->push_back({GDAKI_CKPT_REGION_COUNTERS, 0, g->counters_table->gpu_ptr, g->counters_table->buffer_bytes()});
+  return out->size() <= GDAKI_CKPT_MAX_REGIONS;
+}
+// One checkpoint (application thread): the regions and the copy buffers, the ask to the helper, the copy once drained.
+static void gdakiCkptTake(struct gdakiRecHost* r, uint64_t step, const void* blob, size_t bytes) {
+  struct gdakiCkpt* ck = gdakiCkptOf(r);
+  {
+    std::lock_guard<std::mutex> lk(ck->mu);
+    // the previous one still runs (the helper not idle, its upload): no wait on the application thread, tried again later
+    if (ck->req != GDAKI_CKPT_REQ_NONE || ck->up.pending || ck->up.running || ck->phasePub != GDAKI_CKPT_I_IDLE) return;
+  }
+  auto backOff = [&]() {  // a checkpoint this rank cannot even ask for: tried again a quarter interval later
+    std::lock_guard<std::mutex> lk(ck->mu);
+    ck->haveRetry = true;
+    ck->retryAtStep = step + (uint64_t)std::max<int64_t>(1, ncclParamGinRestoreCkptSteps() / 4);
+  };
+  std::vector<struct gdakiCkptRegionSrc> regs;
