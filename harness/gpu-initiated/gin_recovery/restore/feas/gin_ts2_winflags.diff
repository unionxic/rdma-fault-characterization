@@ -108,6 +108,7 @@
 #include <string>
 #include <algorithm>
 #include <unistd.h>
+#include <dlfcn.h>  // gin-restore 9.15.6: the RO condition below
 #include <csignal>
 #include <arpa/inet.h>
 #include <netinet/in.h>
@@ -1002,8 +1003,24 @@
   ncclWindow_t sendWin, recvWin;
   NK(ncclMemAlloc(&dSend, winBytes));
   NK(ncclMemAlloc(&dRecv, winBytes));
-  NK(ncclCommWindowRegister(g_comm, dSend, winBytes, &sendWin, NCCL_WIN_COLL_SYMMETRIC));
-  NK(ncclCommWindowRegister(g_comm, dRecv, winBytes, &recvWin, NCCL_WIN_COLL_SYMMETRIC));
+  // gin-restore 9.15.6 (2026-10-11): GIN_TS_WIN_STRICT=1 registers both windows with NCCL_WIN_STRICT_ORDERING as well.
+  // ro_requested repeats NCCL's own condition for asking RO on a window MR (net_ib/init.cc 153-161 and the GDAKI copy
+  // gdakiRelaxedOrderingEnabled): NCCL_IB_PCI_RELAXED_ORDERING 1 or 2 (default 2) and ibv_reg_mr_iova2@IBVERBS_1.8 in the
+  // libibverbs NCCL loads (libibverbs.so, then libibverbs.so.1). Whether the NIC then sends relaxed writes is not seen here.
+  const int winFlags = NCCL_WIN_COLL_SYMMETRIC |
+                       ((getenv("GIN_TS_WIN_STRICT") && atoi(getenv("GIN_TS_WIN_STRICT")) != 0) ? NCCL_WIN_STRICT_ORDERING : 0);
+  {
+    const char* roEnv = getenv("NCCL_IB_PCI_RELAXED_ORDERING");
+    void* ibv = dlopen("libibverbs.so", RTLD_NOW);
+    if (ibv == nullptr) ibv = dlopen("libibverbs.so.1", RTLD_NOW);
+    const int roApi = (ibv != nullptr && dlvsym(ibv, "ibv_reg_mr_iova2", "IBVERBS_1.8") != nullptr) ? 1 : 0;
+    const long roMode = roEnv ? atol(roEnv) : 2;
+    kv("win_flags=%#x ro_env=%s ro_api=%d ro_requested=%d", winFlags, roEnv ? roEnv : "unset", roApi,
+       ((roMode == 1 || roMode == 2) && roApi) ? 1 : 0);
+    if (ibv != nullptr) dlclose(ibv);
+  }
+  NK(ncclCommWindowRegister(g_comm, dSend, winBytes, &sendWin, winFlags));
+  NK(ncclCommWindowRegister(g_comm, dRecv, winBytes, &recvWin, winFlags));
