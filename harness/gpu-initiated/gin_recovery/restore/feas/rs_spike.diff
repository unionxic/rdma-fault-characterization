+// gin-restore spike B1: the peer columns of an rkey table, read back from the GPU after its copy, as a keyed hash (the
+// own column is new in a replay and is left out)
+static void gdakiRsRkeyReport(const char* what, struct ncclGinIbCollComm* cComm, const __be32* gpuTable, unsigned info) {
+  if (!rsReportOn()) return;
+  std::vector<__be32> t(cComm->nranks, 0);
+  if (cudaMemcpy(t.data(), gpuTable, sizeof(__be32) * cComm->nranks, cudaMemcpyDeviceToHost) != cudaSuccess) {
+    WARN("GIN/RS: rkey report: cannot read the %s table back", what);
+    return;
+  }
+  t[cComm->rank] = 0;
+  char h[24];
+  rsHashStr(t.data(), sizeof(__be32) * t.size(), h, sizeof(h));
+  WARN("GIN/RS: rkeys %s info=%u peers=%s", what, info, h);
+}
