+static void rsWinReport(struct ncclComm* comm, ncclWindow_t win, size_t size) {
+  if (!rsReportOn()) return;
+  struct ncclWindow_vidmem* h = nullptr;
+  if (ncclShadowPoolToHost(&comm->devrState.shadows, win, &h) != ncclSuccess || h == nullptr) {
+    WARN("GIN/RS: window report: no host shadow");
+    return;
+  }
+  WARN("GIN/RS: window size=%zu lsaRank=%d worldRank=%d stride4G=%u mcOffset4K=%u ginOffset4K=%u winFlags=%#x "
+       "numSegments=%d",
+       size, h->lsaRank, h->worldRank, h->stride4G, h->mcOffset4K, h->ginOffset4K, h->winFlags, h->numSegments);
+}
+static void rsDevCommReport(struct ncclComm* comm, struct ncclDevComm* dc) {
+  if (!rsReportOn()) return;
+  WARN("GIN/RS: comm rank=%d nranks=%d runtimeConn=%d nvlsSupport=%d numRmaCtx=%d lsaSize=%d nLsaTeams=%d localRanks=%d "
+       "nNodes=%d symmetricSupport=%d globalGinSupport=%d",
+       comm->rank, comm->nRanks, comm->runtimeConn ? 1 : 0, comm->nvlsSupport ? 1 : 0, comm->config.numRmaCtx,
+       comm->devrState.lsaSize, comm->devrState.nLsaTeams, comm->localRanks, comm->nNodes,
+       comm->symmetricSupport ? 1 : 0, (int)comm->globalGinSupport);
+  WARN("GIN/RS: devcomm rank=%d nRanks=%d lsaRank=%d lsaSize=%d ginContextCount=%u ginSignalCount=%d ginCounterCount=%d "
+       "ginConnectionCount=%d",
+       dc->rank, dc->nRanks, dc->lsaRank, dc->lsaSize, dc->ginContextCount, dc->ginSignalCount, dc->ginCounterCount,
+       (int)dc->ginConnectionCount);
+  if (dc->resourceWindow != nullptr) rsWinReport(comm, dc->resourceWindow, 0);  // the devComm's internal window
+  ncclDevCommDump(dc);  // stdout; the compare script masks the pointer values
+  fflush(stdout);
+}
