+// gin-restore spike B1 (EXPERIMENT.md 9.15.4): the public bootstrap exchanges go through the record/replay hooks of the
+// bound communicator (rs_spike.h); only the outermost call is hooked (the sends and receives inside a barrier or a
+// broadcast are not), and calls with one participant have no network and are not hooked. Inert without the environment.
+ncclResult_t bootstrapSend(void* commState, int peer, int tag, void* data, int size) {
+  RsGuard g(commState);
+  if (!g.hooked) return bootstrapSendImpl(commState, peer, tag, data, size);
+  return rsSend(peer, tag, data, (size_t)size, [&]() { return bootstrapSendImpl(commState, peer, tag, data, size); });
+}
+ncclResult_t bootstrapRecv(void* commState, int peer, int tag, void* data, int size) {
+  RsGuard g(commState);
+  if (!g.hooked) return bootstrapRecvImpl(commState, peer, tag, data, size);
+  return rsRecv(peer, tag, data, (size_t)size, [&]() { return bootstrapRecvImpl(commState, peer, tag, data, size); });
+}
+ncclResult_t bootstrapAllGather(void* commState, void* allData, int size) {
+  RsGuard g(commState);
+  struct bootstrapState* state = (struct bootstrapState*)commState;
+  if (!g.hooked || state->nranks <= 1) return bootstrapAllGatherImpl(commState, allData, size);
+  return rsAllGather(RSK_AG, state->rank, state->nranks, allData, (size_t)size,
+                     [&]() { return bootstrapAllGatherImpl(commState, allData, size); });
+}
+ncclResult_t bootstrapIntraNodeBarrier(void* commState, int* ranks, int rank, int nranks, int tag) {
+  RsGuard g(commState);
+  if (!g.hooked || nranks <= 1) return bootstrapIntraNodeBarrierImpl(commState, ranks, rank, nranks, tag);
+  return rsNoData(RSK_INTRA_BARRIER, tag, nranks,
+                  [&]() { return bootstrapIntraNodeBarrierImpl(commState, ranks, rank, nranks, tag); });
+}
+ncclResult_t bootstrapBarrier(void* commState, int rank, int nranks, int tag) {
+  RsGuard g(commState);
+  if (!g.hooked || nranks <= 1) return bootstrapBarrierImpl(commState, rank, nranks, tag);
+  return rsNoData(RSK_BARRIER, tag, nranks, [&]() { return bootstrapBarrierImpl(commState, rank, nranks, tag); });
+}
+ncclResult_t bootstrapIntraNodeAllGather(void* commState, int* ranks, int rank, int nranks, void* allData, int size) {
+  RsGuard g(commState);
+  if (!g.hooked || nranks <= 1) return bootstrapIntraNodeAllGatherImpl(commState, ranks, rank, nranks, allData, size);
+  return rsAllGather(RSK_INTRA_AG, rank, nranks, allData, (size_t)size,
+                     [&]() { return bootstrapIntraNodeAllGatherImpl(commState, ranks, rank, nranks, allData, size); });
+}
+ncclResult_t bootstrapIntraNodeBroadcast(void* commState, int* ranks, int rank, int nranks, int root, void* bcastData,
+                                         int size) {
+  RsGuard g(commState);
+  if (!g.hooked || nranks <= 1)
+    return bootstrapIntraNodeBroadcastImpl(commState, ranks, rank, nranks, root, bcastData, size);
+  return rsBcast(RSK_INTRA_BCAST, root, rank, nranks, bcastData, (size_t)size, [&]() {
+    return bootstrapIntraNodeBroadcastImpl(commState, ranks, rank, nranks, root, bcastData, size);
+  });
+}
+ncclResult_t bootstrapBroadcast(void* commState, int rank, int nranks, int root, void* bcastData, int size) {
+  RsGuard g(commState);
+  if (!g.hooked || nranks <= 1) return bootstrapBroadcastImpl(commState, rank, nranks, root, bcastData, size);
+  return rsBcast(RSK_BCAST, root, rank, nranks, bcastData, (size_t)size,
+                 [&]() { return bootstrapBroadcastImpl(commState, rank, nranks, root, bcastData, size); });
+}
