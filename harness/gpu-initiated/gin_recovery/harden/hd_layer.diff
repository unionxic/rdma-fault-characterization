+// GIN transparent recovery (research build, gin-harden): a user devComm's abort word (its own, not the
+// communicator's) is written with this bit set (ncclCommAbort, an aborting shrink or a revoke, a recovery decline, a
+// peer judged dead). A wait released by such a word returns an error instead of ncclSuccess. NCCL's own abort words
+// only ever hold 0 or 1, so their waits keep the stock semantics.
+#define NCCL_DEVCOMM_ABORT_ERROR 0x80000000u
+#ifdef __CUDACC__
+static NCCL_DEVICE_INLINE bool abortIsError(uint32_t* abortFlag) {
+  return abortFlag != nullptr &&
+         (cuda::atomic_ref<uint32_t>{*abortFlag}.load(cuda::memory_order_relaxed) & NCCL_DEVCOMM_ABORT_ERROR) != 0;
+}
+#else
+static NCCL_DEVICE_INLINE bool abortIsError(uint32_t* abortFlag) {
+  volatile uint32_t* ptr = (volatile uint32_t*)abortFlag;
+  return ptr != nullptr && (*ptr & NCCL_DEVCOMM_ABORT_ERROR) != 0;
+}
+#endif
