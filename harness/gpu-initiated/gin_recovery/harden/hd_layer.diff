+/*
+ * GIN GDAKI transparent recovery counters (research build, gin-harden). EXPERIMENTAL: the struct and its meaning may
+ * change. Sums every transparent-recovery GDAKI context of `comm` that is still active (call it before
+ * ncclCommAbort/ncclCommDestroy). contexts == 0 means transparent recovery is off on this communicator. Counters are
+ * per rank; a round counts once on each rank that takes part in it.
+ */
+#define NCCL_GIN_RECOVERY_STATS_VERSION 1
+typedef struct {
+  int version;                        /* NCCL_GIN_RECOVERY_STATS_VERSION */
+  int contexts;                       /* GDAKI contexts with transparent recovery on this communicator */
+  unsigned long long roundsStarted;   /* recovery rounds started, as initiator or as responder */
+  unsigned long long recovered;       /* rounds that ended with the traffic resumed (either role) */
+  unsigned long long declined;        /* peers declined (the error surfaced) */
+  unsigned long long reconnects;      /* helper sockets re-established after a loss */
+  unsigned long long deathsJudged;    /* peers judged dead (FIN without BYE, or two refused connects >= 1 s apart) */
+  unsigned long long escalations;     /* times the round cap (NCCL_GIN_TS_ESCALATE_*) stopped the recovery */
+  unsigned long long cancelled;       /* rounds cancelled by a socket loss before the commit (then retried) */
+  unsigned long long fwOverruns;      /* firmware-command phases longer than NCCL_GIN_TS_FW_MS */
+  unsigned long long copyTimeouts;    /* device-state copies longer than NCCL_GIN_TS_COPY_MS */
+  int escalatedNow;                   /* 1 if recovery is stopped on this communicator */
+} ncclGinRecoveryStats_t;
+ncclResult_t  ncclGinGetRecoveryStats(ncclComm_t comm, ncclGinRecoveryStats_t* stats);
+ncclResult_t pncclGinGetRecoveryStats(ncclComm_t comm, ncclGinRecoveryStats_t* stats);
