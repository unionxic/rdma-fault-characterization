+// pilot2fix (PILOT.md pilot 2 문제 3, two deaths): the activation table's UD endpoints. A spare's transcript holds every
+// survivor's first incarnation's UD QP (the setup's all-gather); a survivor restored before has a new one that only the
+// ranks which took its REJOIN know (its nrp). The buddy appends to the activation blob, after gin-mirror's parts, one
+// entry per survivor of incarnation above 0 (gdakiCtrlActUdOf); the spare reads them (gdakiCtrlLaSpareBlobRecv) and its
+// REJOINs use them (gdakiCtrlRjSpareBegin). The launcher relays the blob's bytes as they are (GL_U_MAX_PAYLOAD).
+#define GDAKI_CTRL_ACT_UD_MAGIC 0x44554147u  // "GAUD"
+#define GDAKI_CTRL_ACT_UD_MAX (8u + 48u * 4096u)  // the table's bytes at most (4 096 ranks: the generations' bound)
+struct gdakiCtrlActUdHdr {
+  uint32_t magic, count;
+};
+struct gdakiCtrlActUd {
+  int32_t rank;
+  uint32_t incarnation;         // the table's incarnation of the rank (gdakiMiActAddr::incarnation)
+  struct gdakiCtrlEndpoint ud;  // its UD QP now (psn: its Q_Key)
+};
+static_assert(sizeof(struct gdakiCtrlActUdHdr) == 8 && sizeof(struct gdakiCtrlActUd) == 48, "the UD table's entries");
+static inline void gdakiCtrlActUdPut(const std::vector<struct gdakiCtrlActUd>& e, std::vector<uint8_t>* out) {
+  const struct gdakiCtrlActUdHdr h = {GDAKI_CTRL_ACT_UD_MAGIC, (uint32_t)e.size()};
+  const size_t at = out->size(), eb = e.size() * sizeof(struct gdakiCtrlActUd);
+  out->resize(at + sizeof(h) + eb);
+  memcpy(out->data() + at, &h, sizeof(h));
+  if (eb) memcpy(out->data() + at + sizeof(h), e.data(), eb);
+}
+// The bytes after gin-mirror's parts: none (a buddy without the table) is true with no entry; else the header and
+// exactly `count` entries (count <= nranks), each of a rank in range, at most once. False: damaged.
+static inline bool gdakiCtrlActUdGet(const uint8_t* p, size_t n, int nranks, std::vector<struct gdakiCtrlActUd>* out) {
+  out->clear();
+  if (n == 0) return true;
+  struct gdakiCtrlActUdHdr h;
+  if (n < sizeof(h) || nranks <= 0) return false;
+  memcpy(&h, p, sizeof(h));
+  if (h.magic != GDAKI_CTRL_ACT_UD_MAGIC || h.count > (uint32_t)nranks ||
+      n != sizeof(h) + (size_t)h.count * sizeof(struct gdakiCtrlActUd))
+    return false;
+  out->resize(h.count);
+  if (h.count) memcpy(out->data(), p + sizeof(h), (size_t)h.count * sizeof(struct gdakiCtrlActUd));
+  for (size_t i = 0; i < out->size(); i++) {
+    if ((*out)[i].rank < 0 || (*out)[i].rank >= nranks) return false;
+    for (size_t j = 0; j < i; j++)
+      if ((*out)[j].rank == (*out)[i].rank) return false;
+  }
+  return true;
+}
