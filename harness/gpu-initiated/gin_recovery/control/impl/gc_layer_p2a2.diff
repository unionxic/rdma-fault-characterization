+    struct gdakiTsPeer& pe = ts->peers[p];
+    if (p == r->ctx->rank || !pe.gated || pe.declined) continue;
+    while (gdakiCtrlPump(r, p, pe, &msg) == 1) {
+      gdakiCtrlIdleRecord(r, p, pe, msg);
+      if (!gdakiCtrlChanUp(r, p, pe) || pe.declined) break;
+    }
+  }
