+  const size_t wake = gdakiCtrlWakeFdAdd(r, pfds);
+  (void)poll(pfds.data(), pfds.size(), 1);
+  gdakiCtrlWakeTake(r, pfds, wake);
+  struct gdakiTsMsg msg;
+  for (size_t k = 0; k < who.size() && k < pfds.size(); k++) {
