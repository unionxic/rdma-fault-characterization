+        a->suspectMs != a0->suspectMs || a->stallMs != a0->stallMs) {
+      *who = p;
+      if (why != nullptr) snprintf(why, whyLen, "the liveness thresholds differ between ranks (rank %d)", p);
+      return GDAKI_CTRL_SA_THRESH;
+    }
+  }
+  return GDAKI_CTRL_SA_OK;
