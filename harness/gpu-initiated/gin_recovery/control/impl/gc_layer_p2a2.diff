+static void gdakiCtrlIdleRecord(struct gdakiRecHost* r, int p, struct gdakiTsPeer& pe, const struct gdakiTsMsg& msg) {
+  struct gdakiTsMsg m = msg;
+  if (m.type == GDAKI_TS_REQ && m.from == p) gdakiTsRespond(r, p, m);
+  else if (m.type == GDAKI_TS_FAIL) {
