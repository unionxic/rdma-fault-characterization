+// A record QP's cause (the ring pump's -1: "QP:NEWGEN", "QP:<the ring's cause>"): a lost connection of the record
+// channel, never evidence about the peer's process (design v3 2.4: not a liveness input).
+static bool gdakiCtrlCauseIsQp(const char* cause) { return cause != nullptr && strncmp(cause, "QP:", 3) == 0; }
+static void gdakiCtrlTcpCount(struct gdakiRecHost* r, int peer, uint32_t ch, bool rx, int rc) {
+  if (r == nullptr) return;
+  const int e = errno;  // the callers read errno after a failed send
+  const uint64_t n = (uint64_t)sizeof(struct gdakiTsMsg);
+  if (rx) {
+    if (rc == 1 && peer >= 0 && peer < GDAKI_CTRL_TCP_COUNT_PEERS)
+      r->ctrlTcp.rxPeer[peer].fetch_add(n, std::memory_order_relaxed);
+  } else if (rc == 0) {
+    (ch == GDAKI_CTRL_CH_DATA ? r->ctrlTcp.dataBytes : r->ctrlTcp.recordBytes).fetch_add(n, std::memory_order_relaxed);
+  }
+  errno = e;
+}
+// gdakiCtrlSend: a record to the pair's ring (gdakiTsSend's contract: the magic stamped, bounded by timeoutMs; queued
+// until CONNECTED and while the window is shut; -1: the queue stayed full to the bound, or the connection of this
+// generation is lost). REJOIN and DATA: not the ring's yet (2a-2-C).
+static bool gdakiCtrlRingSendOf(struct gdakiRecHost* r, int peer, uint32_t ch, struct gdakiTsMsg* m, int timeoutMs, int* rc) {
+  if (ch != GDAKI_CTRL_CH_RECORD || !gdakiCtrlRingLiveOn(r, peer)) return false;
+  struct gdakiCtrlRing* g = r->ctrl->ring;
+  struct gdakiCtrlRdmaPeer& pr = g->peers[(size_t)peer];
+  *rc = gdakiCtrlRdmaSend(g, peer, m, timeoutMs);
+  if (*rc == 0) {
+    pr.txRecords++;
+    if (!pr.ring.q.empty()) pr.deferred++;  // FIFO: anything still queued includes this record
+    if (pr.ring.q.size() > g->sendqMax) g->sendqMax = pr.ring.q.size();
+  }
+  return true;
+}
+// gdakiCtrlPump: the next record of the pair's inbox (1), none yet (0), or -1 exactly once per lost connection (a
+// generation change either side started, or this generation lost) with pe.closeCause "QP:NEWGEN" or "QP:<cause>"; the
+// witness's socket is not touched and gdakiTsSocketLost is not called (the caller's round is cancelled; REVIEW_P12 8).
+static bool gdakiCtrlRingPumpOf(struct gdakiRecHost* r, int peer, struct gdakiTsPeer& pe, struct gdakiTsMsg* out, int* rc) {
+  if (!gdakiCtrlRingLiveOn(r, peer)) return false;
+  struct gdakiCtrlRing* g = r->ctrl->ring;
+  struct gdakiCtrlRdmaPeer& pr = g->peers[(size_t)peer];
+  char cause[48] = {0};  // "QP:" and the ring's cause (24 B) fit; pe.closeCause keeps what it can
+  *rc = gdakiCtrlRdmaRecv(g, peer, out, cause, sizeof(cause));
+  if (*rc == 1) pr.rxRecords++;
+  if (*rc < 0) {
+    pr.lossEvents++;
+    const size_t n = std::min(strlen(cause), sizeof(pe.closeCause) - 1);
+    memcpy(pe.closeCause, cause, n);
+    pe.closeCause[n] = 0;
+  }
+  return true;
+}
+// gdakiCtrlRecv / gdakiCtrlRecvOn (_RECORD): gdakiTsRecv's contract on the pair's ring (1 a record, 0 timeout or stop, -1
+// the connection lost), waiting on the helper CQ's completion channel in slices of at most 5 ms as gdakiTsRecv does.
+static bool gdakiCtrlRingRecvOf(struct gdakiRecHost* r, int peer, uint32_t ch, struct gdakiTsPeer* pe,
+                                struct gdakiTsMsg* out, int timeoutMs, std::atomic<bool>* stop, int* rc) {
+  if (ch != GDAKI_CTRL_CH_RECORD || !gdakiCtrlRingLiveOn(r, peer)) return false;
+  struct gdakiCtrlRing* g = r->ctrl->ring;
+  struct gdakiTsPeer tmp;
+  struct gdakiTsPeer& p = pe != nullptr ? *pe : tmp;
+  const double deadline = gdakiQ4MonoMs() + timeoutMs;
+  while (true) {
+    (void)gdakiCtrlRingPumpOf(r, peer, p, out, rc);
+    if (*rc != 0) return true;
+    const int rem = (int)(deadline - gdakiQ4MonoMs());
+    if (rem <= 0 || (stop != nullptr && stop->load(std::memory_order_acquire))) return true;
+    struct pollfd pf = {gdakiCtrlRdmaChannelFd(g), POLLIN, 0};
+    if (pf.fd >= 0 && poll(&pf, 1, std::min(rem, 5)) > 0 && (pf.revents & POLLIN)) gdakiCtrlRdmaOnWake(g);
+    else if (pf.fd < 0) std::this_thread::sleep_for(std::chrono::milliseconds(std::min(rem, 5)));
+  }
+}
+// The helper's poll sets: the completion channel's fd beside the witness sockets (its index, or SIZE_MAX: none), and
+// its event taken after the poll (else the fd stays readable and every poll returns at once).
+static size_t gdakiCtrlWakeFdAdd(struct gdakiRecHost* r, std::vector<struct pollfd>& pf) {
+  const int fd = gdakiCtrlRdmaChannelFd(gdakiCtrlRingLive(r));
+  if (fd < 0) return SIZE_MAX;
+  pf.push_back({fd, POLLIN, 0});
+  return pf.size() - 1;
+}
+static void gdakiCtrlWakeTake(struct gdakiRecHost* r, const std::vector<struct pollfd>& pf, size_t k) {
+  if (k < pf.size() && (pf[k].revents & POLLIN)) gdakiCtrlRdmaOnWake(gdakiCtrlRingLive(r));
+}
+// The witness's socket while the ring carries the records (EXPERIMENT.md 9.1: the witness stays TCP): BYE marks the peer
+// left (one line) and the reading goes on; 1: a record that came on the socket (sent by a peer before its own ring was
+// live: the caller handles it as a record, counted as late); 0: nothing more; -1: FIN or an error (pe.closeCause), for
+// the caller's gdakiTsSocketLost (the witness judged as before).
+static int gdakiCtrlWitnessPump(struct gdakiRecHost* r, int peer, struct gdakiTsPeer& pe, struct gdakiTsMsg* out) {
+  while (true) {
+    if (pe.fd < 0 || pe.gone) return 0;
+    const int k = gdakiTsPump(pe, out);
+    if (k <= 0) return k;
+    if (peer >= 0 && peer < GDAKI_CTRL_TCP_COUNT_PEERS)
+      r->ctrlTcp.rxPeer[peer].fetch_add(sizeof(*out), std::memory_order_relaxed);
+    if (out->type == GDAKI_TS_BYE) {
+      if (!pe.left)
+        GIN_TS_NOTE("GIN/TS: rank %d: rank %d left the communicator (BYE) mono_ms=%.3f", r->ctx->rank, peer, gdakiQ4MonoMs());
+      pe.left = true;
+      continue;
+    }
+    r->ctrlTcp.lateRecords.fetch_add(1, std::memory_order_relaxed);
+    return 1;
+  }
