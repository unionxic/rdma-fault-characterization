+    if (gdakiCtrlPairOnAck(&p.pair, b.gen, k->inc, true) != GDAKI_CTRL_PA_CONNECT) return;
+    if (k->tx.rcConnect == nullptr || k->tx.rcConnect(k->tx.arg, li, &b.qp) != 0) {
+      p.qpErr = true;
+      return;
+    }
+    p.remote = b.qp;
+    p.page = b.page;
+    p.connected = true;  // this side started: its CONNECTED goes first
+    struct glMsg c;
+    gdakiCtrlLaMsgInit(k, &c, GL_K_CONNECTED, k->me, k->inc, p.node);
+    if (gdakiCtrlLaSendTo(k, li, &c) != 0) return;
+    p.beatMs = -1;
+    gdakiCtrlLaSay(k->log, "GIN/RC: rank %d: record QP to the launcher of node %u paired (gen %u)", k->me, p.node, b.gen);
+    return;
+  }
+  if (m.h.kind == GL_K_PAIR) {  // the launcher re-pairs (its record QP to this rank was lost)
+    struct glPairBody b;
+    memcpy(&b, m.body, sizeof(b));
+    struct gdakiCtrlEndpoint theirs;
+    memcpy(&theirs, &b.qp, sizeof(theirs));
+    const uint32_t a = gdakiCtrlPairOnPair(&p.pair, b.gen, k->inc, true, &theirs, now);
+    struct glMsg ack;
+    gdakiCtrlLaMsgInit(k, &ack, GL_K_PAIR_ACK, k->me, k->inc, p.node);
+    ack.h.sub = GL_PAIR_RECORD;
+    ack.h.reqSeq = m.h.seq;
+    struct glPairAckBody ab;
+    memset(&ab, 0, sizeof(ab));
+    ab.gen = b.gen;
+    ab.page = k->page;
+    ab.qkey = k->qkey;
+    ab.creditOff = k->creditOff0 + 8u * (uint32_t)li;
+    if (a == GDAKI_CTRL_PA_TAKE) {
+      p.connected = false;
+      memset(&p.local, 0, sizeof(p.local));
+      if (k->tx.rcCreate == nullptr || k->tx.rcCreate(k->tx.arg, li, b.gen, &p.local) != 0 || k->tx.rcConnect == nullptr ||
+          k->tx.rcConnect(k->tx.arg, li, &b.qp) != 0) {
+        ab.status = 1;
+      } else {
+        p.remote = b.qp;
+        p.page = b.page;
+      }
+      ab.qp = p.local;
+    } else if (a == GDAKI_CTRL_PA_RESEND_ACK) {
+      ab.qp = p.local;
+    } else {
+      return;
+    }
+    memcpy(ack.body, &ab, sizeof(ab));
+    ack.h.bodyBytes = (uint16_t)sizeof(ab);
+    if (k->tx.udSend != nullptr) (void)k->tx.udSend(k->tx.arg, li, &p.ud, p.qkey, &ack);
+  }
+}
+static void gdakiCtrlLaOnRc(struct gdakiCtrlLaLink* k, int li, const struct glMsg& m, double now) {
+  (void)now;
+  if (li < 0 || li >= (int)k->la.size() || gl_msg_check(&m) != GL_R_NONE) return;
+  struct gdakiCtrlLaPeer& p = k->la[(size_t)li];
+  p.rx++;
+  if (m.h.kind == GL_K_CONNECTED) {  // the launcher started (its re-pairing): this side is up now
+    if (gdakiCtrlPairOnDone(&p.pair, p.pair.cur, k->inc, true) == GDAKI_CTRL_PA_UP) {
+      p.connected = true;
+      p.beatMs = -1;
+      gdakiCtrlLaSay(k->log, "GIN/RC: rank %d: record QP to the launcher of node %u re-paired (gen %u)", k->me, p.node,
+                     p.pair.cur);
+    }
+    return;
+  }
+  if (m.h.nonce != k->nonce) return;
+  const int r = m.h.rank;
+  switch (m.h.kind) {
+    case GL_K_REG_NOTE:
+      if (r >= 0 && r < k->nranks) {
+        memcpy(&p.note[(size_t)r], m.body, sizeof(struct glRegNoteBody));
+        p.haveNote[(size_t)r] = 1;
+        if (k->laOf[(size_t)r] < 0 && p.note[(size_t)r].regState != GL_RS_NONE) k->laOf[(size_t)r] = li;
+      }
+      return;
+    case GL_K_EXITED:
+    case GL_K_LEFT:
+    case GL_K_FENCED:
+      if (r >= 0 && r < k->nranks && k->laOf[(size_t)r] < 0) k->laOf[(size_t)r] = li;
+      gdakiCtrlLaOnEnded(k, li, m);
+      return;
+    case GL_K_FENCE_NAK:
+      if (r >= 0 && r < k->nranks && k->fence[(size_t)r].sent && k->fence[(size_t)r].dead == m.h.incarnation)
+        k->fence[(size_t)r].nak = true;
+      return;
+    case GL_K_REFUSED:  // SPAWN's answer (or a refused kind): a line, never a fallback (REVIEW2 고칠 것 1)
+      if (m.h.sub == GL_K_SPAWN) p.spawnRefused++;
+      gdakiCtrlLaSay(k->log, "GIN/RC: rank %d: the launcher of node %u refused %s of rank %d (incarnation %u): %s; no "
+                     "fallback on it", k->me, p.node, m.h.sub == GL_K_SPAWN ? "SPAWN" : "a message", r, m.h.incarnation,
+                     gl_reason_text(m.h.reason));
+      return;
+    case GL_K_ACT_ANSWER:
+    case GL_K_FETCH_EP:
+    case GL_K_FETCH_DONE: {
+      if (r < 0 || r >= k->nranks) return;
+      struct gdakiCtrlLaAct& a = k->act[(size_t)r];
+      // not this activation: another launcher, incarnation or ACTIVATE (the launcher echoes its seq, REVIEW_P3 nit 3)
+      if (a.li != li || a.inc != m.h.incarnation || a.state == GDAKI_CTRL_LA_ACT_NONE || m.h.reqSeq != a.reqSeq) return;
+      if (m.h.kind == GL_K_FETCH_EP) {
+        memcpy(a.ep, m.body, sizeof(a.ep));
+        a.haveEp = true;
+        return;
+      }
+      if (m.h.kind == GL_K_FETCH_DONE) {
+        memcpy(a.done, m.body, sizeof(a.done));
+        a.haveDone = true;
+        return;
+      }
+      struct glActAnswerBody b;
+      memcpy(&b, m.body, sizeof(b));
+      a.spareState = b.spareState;
+      a.spareAgeMs = b.spareAgeMs;
+      a.reason = m.h.reason;
+      snprintf(a.why, sizeof(a.why), "%.63s", b.why);
+      if (a.state != GDAKI_CTRL_LA_ACT_SENT && a.state != GDAKI_CTRL_LA_ACT_LATER) return;  // a final answer is final
+      if (m.h.sub == GL_RS_ACT_LATER) {
+        if (a.nLater++ == 0) {
+          a.state = GDAKI_CTRL_LA_ACT_LATER;
+          a.laterMs = now;
+        } else {
+          gdakiCtrlLaSay(k->log, "GIN/RC: rank %d: a second LATER for rank %d (incarnation %u) from node %u: ignored", k->me,
+                         r, a.inc, p.node);
+        }
+      } else if (m.h.sub == GL_RS_ACT_ACCEPTED) {
+        a.ans = b.record;
+        a.state = GDAKI_CTRL_LA_ACT_ACCEPTED;
+        a.acceptedMs = now;
+      } else {
+        a.ans = b.record;
+        a.state = GDAKI_CTRL_LA_ACT_REFUSED;
+      }
+      return;
+    }
+    default:
+      return;
+  }
+}
+// The launcher page's beat (a READ of glPage line 0 by whoever reads it: TODO(2a-2), the watch thread's launcher slot).
+static void gdakiCtrlLaOnBeat(struct gdakiCtrlLaLink* k, int li, uint64_t beat, double now) {
+  struct gdakiCtrlLaPeer& p = k->la[(size_t)li];
+  if (p.beatMs < 0 || beat != p.beat) {
+    p.beat = beat;
+    p.beatMs = now;
+  }
+}
+// Launcher li is lost: its record QP is in error, or its page's beat stood stallMs (once read). *why: one word.
+static bool gdakiCtrlLaLost(const struct gdakiCtrlLaLink* k, int li, double now, const char** why) {
+  const struct gdakiCtrlLaPeer& p = k->la[(size_t)li];
+  if (p.qpErr || !p.connected) {
+    *why = p.qpErr ? "record_QP_error" : "not_paired";
+    return true;
+  }
+  if (p.beatMs >= 0 && now - p.beatMs >= k->stallMs) {
+    *why = "beat_stale";
+    return true;
+  }
+  return false;
+}
+
+// ---- the buddy: the fence (design v3 4.4 3) ----
+// The hold of (peer, dead) started here: the fence is armed (FENCED and the window line come once for it).
+static void gdakiCtrlLaFenceArm(struct gdakiCtrlLaLink* k, int peer, uint32_t dead) {
+  struct gdakiCtrlLaFence& f = k->fence[(size_t)peer];
+  if (f.armed && f.dead == dead) return;
+  f = gdakiCtrlLaFence();
+  f.armed = true;
+  f.dead = dead;
+}
+// Every HOLDING is in (the caller's decision): FENCE to the dead rank's launcher unless the word already says FENCED.
+// 1 fenced, 0 not yet, -1 fall back (FENCE_NAK, no launcher of the peer, the launcher lost, the send failed).
+static int gdakiCtrlLaFence(struct gdakiCtrlLaLink* k, int peer, uint32_t dead, double now, bool buddy) {
+  gdakiCtrlLaFenceArm(k, peer, dead);
+  struct gdakiCtrlLaFence& f = k->fence[(size_t)peer];
+  if (gdakiCtrlFencedIs(k->fencedPlus1[(size_t)peer], dead)) return 1;
+  if (f.nak) return -1;
+  const int li = k->laOf[(size_t)peer];
+  const char* lw = nullptr;
+  if (li < 0 || gdakiCtrlLaLost(k, li, now, &lw)) {
+    if (!f.sent || li < 0) {  // FENCE never went (REVIEW_P3 nit 7): a line of its own, once
+      if (buddy && !f.noPathSaid) {
+        f.noPathSaid = true;
+        char node[16];
+        if (li >= 0) snprintf(node, sizeof(node), "%u", k->la[(size_t)li].node);
+        else snprintf(node, sizeof(node), "unknown");
+        gdakiCtrlLaSay(k->log, "GIN/RC: rank %d: rank %d (incarnation %u) fence: no path to the launcher of node %s (%s): "
+                       "FENCE not sent", k->me, peer, dead, node, li < 0 ? "not_known" : lw);
+      }
+      return -1;
+    }
+    gdakiCtrlLaSay(k->log, "GIN/RC: rank %d: rank %d (incarnation %u) fence: the launcher of node %u is lost (%s) "
+                   "(STOP_launcher)", k->me, peer, dead, k->la[(size_t)li].node, lw);
+    return -1;
+  }
+  if (f.sent) return 0;
+  struct glMsg m;
+  gdakiCtrlLaMsgInit(k, &m, GL_K_FENCE, peer, dead, k->la[(size_t)li].node);
+  if (gdakiCtrlLaSendTo(k, li, &m) != 0) return -1;
+  f.sent = true;
+  f.sentMs = now;
+  if (buddy)
+    gdakiCtrlLaSay(k->log, "GIN/RC: rank %d: rank %d (incarnation %u) fence FENCING: FENCE sent to the launcher of node %u",
+                   k->me, peer, dead, k->la[(size_t)li].node);
+  return 0;
+}
+
+// The activation gate's launcher part (gdakiCtrlActFenceOk's body, the buddy, once every HOLDING is in): the fence step,
+// its FENCED report or its FENCE_NAK line. GO (the word says FENCED), WAIT, or FALLBACK with why (the caller falls back).
+enum : int { GDAKI_CTRL_LA_GATE_WAIT = 0, GDAKI_CTRL_LA_GATE_GO = 1, GDAKI_CTRL_LA_GATE_FALLBACK = -1 };
+static int gdakiCtrlLaGate(struct gdakiCtrlLaLink* k, int peer, uint32_t dead, double now, char* why, size_t whyLen) {
+  if (peer < 0 || peer >= k->nranks) {
+    snprintf(why, whyLen, "no such peer");
+    return GDAKI_CTRL_LA_GATE_FALLBACK;
+  }
+  const int f = gdakiCtrlLaFence(k, peer, dead, now, true);
+  if (f > 0) gdakiCtrlLaFenceReport(k, peer, true);
+  if (f < 0) {
+    if (k->fence[(size_t)peer].nak) {
+      const int li = k->laOf[(size_t)peer];
+      gdakiCtrlLaSay(k->log, "GIN/RC: rank %d: rank %d (incarnation %u) fence FENCE_NAK from node %u: nothing held, "
+                     "falling back", k->me, peer, dead, li >= 0 ? k->la[(size_t)li].node : 0u);
+    }
+    snprintf(why, whyLen, "the fence of the peer's dead incarnation cannot complete (FENCE_NAK, no launcher path, or the "
+                          "launcher is lost)");
+    return GDAKI_CTRL_LA_GATE_FALLBACK;
+  }
+  return gdakiCtrlFencedIs(k->fencedPlus1[(size_t)peer], dead) ? GDAKI_CTRL_LA_GATE_GO : GDAKI_CTRL_LA_GATE_WAIT;
+}
+
+// ---- the buddy: the activation through the launcher (design v3 5.4 4) ----
+enum : int { GDAKI_CTRL_LA_AS_WAIT = 0, GDAKI_CTRL_LA_AS_ACCEPTED = 1, GDAKI_CTRL_LA_AS_FALLBACK = -1 };
+// ACTIVATE (the 64 B record and the blob's region in this rank's outbox) to the launcher of the peer's node. False: not
+// sent (no launcher path).
+static bool gdakiCtrlLaActStart(struct gdakiCtrlLaLink* k, int peer, const struct glRsActivate& rec,
+                                const struct glRegion& blob, uint64_t xferId, double now) {
+  struct gdakiCtrlLaAct& a = k->act[(size_t)peer];
+  a = gdakiCtrlLaAct();
+  const int li = peer >= 0 && peer < k->nranks ? k->laOf[(size_t)peer] : -1;
+  const char* lw = nullptr;
+  if (li < 0 || gdakiCtrlLaLost(k, li, now, &lw)) return false;
+  struct glMsg m;
+  gdakiCtrlLaMsgInit(k, &m, GL_K_ACTIVATE, peer, rec.incarnation, k->la[(size_t)li].node);
+  struct glActivateBody b;
+  memset(&b, 0, sizeof(b));
+  b.record = rec;
+  b.blob = blob;
+  b.xferId = xferId;
+  memcpy(m.body, &b, sizeof(b));
+  m.h.bodyBytes = (uint16_t)sizeof(b);
+  if (gdakiCtrlLaSendTo(k, li, &m) != 0) return false;
+  a.state = GDAKI_CTRL_LA_ACT_SENT;
+  a.inc = rec.incarnation;
+  a.reqSeq = m.h.seq;
+  a.li = li;
+  a.sentMs = now;
+  return true;
+}
+static void gdakiCtrlLaAbort(struct gdakiCtrlLaLink* k, int peer) {
+  struct gdakiCtrlLaAct& a = k->act[(size_t)peer];
+  struct glMsg m;
+  gdakiCtrlLaMsgInit(k, &m, GL_K_ABORT, peer, a.inc, a.li >= 0 ? k->la[(size_t)a.li].node : 0u);
+  (void)gdakiCtrlLaSendTo(k, a.li, &m);
+  a.state = GDAKI_CTRL_LA_ACT_ABORTED;
+}
+// One step: ACCEPTED (the answer echoes the rank and the incarnation), WAIT, or FALLBACK with why (REFUSED; no first
+// answer within answerMs: ABORT; LATER and laterMs since it: ABORT; the launcher lost: its line with (STOP_launcher)).
+static int gdakiCtrlLaActStep(struct gdakiCtrlLaLink* k, int peer, double now, char* why, size_t whyLen) {
+  struct gdakiCtrlLaAct& a = k->act[(size_t)peer];
+  switch (a.state) {
+    case GDAKI_CTRL_LA_ACT_ACCEPTED:
+    case GDAKI_CTRL_LA_ACT_READY:
+      if (a.ans.rank != peer || a.ans.incarnation != a.inc) {
+        snprintf(why, whyLen, "the launcher's ACCEPTED names rank %d incarnation %u, not %u", (int)a.ans.rank,
+                 a.ans.incarnation, a.inc);
+        return GDAKI_CTRL_LA_AS_FALLBACK;
+      }
+      return GDAKI_CTRL_LA_AS_ACCEPTED;
+    case GDAKI_CTRL_LA_ACT_REFUSED:
+      snprintf(why, whyLen, "the peer's spare refused the activation (launcher: %s)", gl_reason_text(a.reason));
+      return GDAKI_CTRL_LA_AS_FALLBACK;
+    case GDAKI_CTRL_LA_ACT_SENT:
+    case GDAKI_CTRL_LA_ACT_LATER: {
+      const char* lw = nullptr;
+      if (gdakiCtrlLaLost(k, a.li, now, &lw)) {
+        gdakiCtrlLaSay(k->log, "GIN/RC: rank %d: the launcher of node %u is lost (%s) during rank %d's activation "
+                       "(incarnation %u): falling back (STOP_launcher)", k->me, k->la[(size_t)a.li].node, lw, peer, a.inc);
+        if (strcmp(lw, "beat_stale") == 0) gdakiCtrlLaAbort(k, peer);  // ABORTED (its QP may still take it)
+        else a.state = GDAKI_CTRL_LA_ACT_LOST;
+        snprintf(why, whyLen, "the launcher of the peer's node is lost (%s)", lw);
+        return GDAKI_CTRL_LA_AS_FALLBACK;
+      }
+      if (a.state == GDAKI_CTRL_LA_ACT_SENT && now - a.sentMs >= k->answerMs) {
+        gdakiCtrlLaAbort(k, peer);
+        snprintf(why, whyLen, "no answer of the launcher to the activation within %.0f ms", k->answerMs);
+        return GDAKI_CTRL_LA_AS_FALLBACK;
+      }
+      if (a.state == GDAKI_CTRL_LA_ACT_LATER && now - a.laterMs >= k->laterMs) {
+        gdakiCtrlLaAbort(k, peer);
+        snprintf(why, whyLen, "the peer's spare is not READY %.0f ms after LATER (ABORT sent)", k->laterMs);
+        return GDAKI_CTRL_LA_AS_FALLBACK;
+      }
+      return GDAKI_CTRL_LA_AS_WAIT;
+    }
+    default:
+      snprintf(why, whyLen, "no activation in progress");
+      return GDAKI_CTRL_LA_AS_FALLBACK;
+  }
+}
+// After ACCEPTED: READY (or FAIL) for the spare's FETCH (gdakiMiActReady's 72 B) through the launcher.
+static bool gdakiCtrlLaFetchReady(struct gdakiCtrlLaLink* k, int peer, const void* ready72) {
+  struct gdakiCtrlLaAct& a = k->act[(size_t)peer];
+  struct glMsg m;
+  gdakiCtrlLaMsgInit(k, &m, GL_K_FETCH_READY, peer, a.inc, k->la[(size_t)a.li].node);
+  memcpy(m.body, ready72, GL_FETCH_READY_BYTES);
+  m.h.bodyBytes = (uint16_t)GL_FETCH_READY_BYTES;
+  if (gdakiCtrlLaSendTo(k, a.li, &m) != 0) return false;
+  a.state = GDAKI_CTRL_LA_ACT_READY;
+  return true;
+}
+// SPAWN of (peer, inc) at the buddy's hold start (decision 12): one WR, its REFUSED a line only.
+static void gdakiCtrlLaSpawn(struct gdakiCtrlLaLink* k, int peer, uint32_t inc) {
+  const int li = peer >= 0 && peer < k->nranks ? k->laOf[(size_t)peer] : -1;
+  if (li < 0) return;
+  struct glMsg m;
+  gdakiCtrlLaMsgInit(k, &m, GL_K_SPAWN, peer, inc, k->la[(size_t)li].node);
+  (void)gdakiCtrlLaSendTo(k, li, &m);
+}
+
+// ---- the spare ----
+// The ACTIVATE bytes' record as this spare takes it: 0 usable, else what is wrong (the spare answers REFUSED).
+static int gdakiCtrlLaSpareCheck(const struct glRsActivate& rec, int me, uint64_t nonce, uint32_t helloInc) {
+  if (rec.magic != GL_RS_ACT_MAGIC || rec.kind != GL_RS_ACT_ACTIVATE) return 1;
+  if (rec.nonce != nonce || rec.rank != me) return 2;
+  if (rec.incarnation != helloInc) return 3;
+  if (!gdakiCtrlLaActFencedOk(rec.reserved, rec.incarnation)) return 4;  // the record does not carry FENCED
+  return 0;
+}
+static const char* gdakiCtrlLaSpareCheckText(int c) {
+  switch (c) {
+    case 1: return "not an ACTIVATE";
+    case 2: return "another communicator or rank";
+    case 3: return "another incarnation than this spare's HELLO";
+    case 4: return "the record does not carry FENCED";
+    default: return "ok";
+  }
+}
+// The FETCH talk's relay (the spare's side; the bytes of today's activation connection after ACCEPTED): the caller's end
+// of a socketpair takes them as before (gdakiMiSpareActivateFetch: out 112 B FETCH_EP, in 72 B READY, out 80 B DONE); the
+// relay thread moves them to and from the launcher's ACT_TALK. ABORT from the launcher, the launcher socket's loss, the
+// caller's close (EOF, in any phase) or stop end it (the caller's read then fails: its FETCH gives up). The bytes the
+// caller wrote are read before stop is looked at (REVIEW_P3 고칠 것 4: DONE is relayed even when the end follows it).
+struct gdakiCtrlLaRelay {
+  int fd = -1;                 // the relay's end
+  std::thread th;
+  std::atomic<bool> stop{false};
+  std::atomic<bool> done{false};  // the thread ended (its last piece relayed or given up)
+  bool aborted = false;
+  bool callerGone = false;     // the caller's end closed before the talk's end
+  int moved = 0;               // pieces moved (EP, READY, DONE)
+};
+// 1 read, 0 the caller closed, -1 stopped, aborted or the launcher socket lost.
+static int gdakiCtrlLaRelayRead(int fd, void* p, size_t n, std::atomic<bool>* stop, struct gdakiCtrlLaUnix* u,
+                                const struct gdakiCtrlLaLog& log, int me, bool* aborted) {
+  size_t have = 0;
+  while (have < n) {
+    const ssize_t k = recv(fd, (char*)p + have, n - have, MSG_DONTWAIT);
+    if (k > 0) {
+      have += (size_t)k;
+      continue;
+    }
+    if (k == 0) return 0;
+    if (errno != EAGAIN && errno != EWOULDBLOCK && errno != EINTR) return 0;
+    if (stop->load(std::memory_order_acquire)) return -1;
+    (void)gdakiCtrlLaUnixPoll(u, log, me);
+    for (const auto& t : u->talk)
+      if (t.h.sub == GL_UT_ABORT) *aborted = true;
+    if (*aborted || u->closed) return -1;
+    struct pollfd pf[2] = {{fd, POLLIN, 0}, {u->fd, POLLIN, 0}};
+    (void)poll(pf, 2, 5);
+  }
+  return 1;
+}
+static void gdakiCtrlLaRelayBody(struct gdakiCtrlLaRelay* x, struct gdakiCtrlLaUnix* u, const struct gdakiCtrlLaLog& log,
+                                 int me) {
+  uint8_t ep[GL_FETCH_EP_BYTES], done[GL_FETCH_DONE_BYTES];
+  int rd = gdakiCtrlLaRelayRead(x->fd, ep, sizeof(ep), &x->stop, u, log, me, &x->aborted);
+  if (rd == 0) x->callerGone = true;
+  if (rd != 1 || !gdakiCtrlLaUnixTalk(u, GL_UT_FETCH_EP, ep, sizeof(ep))) return;
+  x->moved++;
+  bool got = false;  // the buddy's READY (or FAIL), relayed by the launcher
+  while (!got && !x->stop.load(std::memory_order_acquire) && !x->aborted && !u->closed && !x->callerGone) {
+    (void)gdakiCtrlLaUnixPoll(u, log, me);
+    while (!u->talk.empty()) {
+      const struct glUnixMsg t = u->talk.front();
+      u->talk.pop_front();
+      if (t.h.sub == GL_UT_ABORT) x->aborted = true;
+      else if (t.h.sub == GL_UT_FETCH_READY && !got) {
+        size_t off = 0;
+        while (off < GL_FETCH_READY_BYTES) {
+          const ssize_t k = send(x->fd, t.body + off, GL_FETCH_READY_BYTES - off, MSG_NOSIGNAL);
+          if (k <= 0) break;
+          off += (size_t)k;
+        }
+        got = off == GL_FETCH_READY_BYTES;
+        if (!got) x->callerGone = true;
+      }
+    }
+    if (!got && !x->aborted) {  // the launcher's socket and the caller's end (REVIEW_P3 고칠 것 5 (가): its close)
+      struct pollfd pf[2] = {{u->fd, POLLIN, 0}, {x->fd, POLLIN, 0}};
+      if (poll(pf, 2, 5) > 0 && (pf[1].revents & (POLLIN | POLLHUP | POLLERR)) != 0) {
+        char c;
+        const ssize_t k = recv(x->fd, &c, 1, MSG_PEEK | MSG_DONTWAIT);
+        if (k == 0 || (k < 0 && errno != EAGAIN && errno != EWOULDBLOCK && errno != EINTR)) x->callerGone = true;
+      }
+    }
+  }
+  if (!got) return;
+  x->moved++;
+  rd = gdakiCtrlLaRelayRead(x->fd, done, sizeof(done), &x->stop, u, log, me, &x->aborted);
+  if (rd == 0) x->callerGone = true;
+  if (rd == 1 && gdakiCtrlLaUnixTalk(u, GL_UT_FETCH_DONE, done, sizeof(done))) x->moved++;
+}
+static void gdakiCtrlLaRelayMain(struct gdakiCtrlLaRelay* x, struct gdakiCtrlLaUnix* u, struct gdakiCtrlLaLog log, int me) {
+  gdakiCtrlLaRelayBody(x, u, log, me);
+  shutdown(x->fd, SHUT_RDWR);
+  x->done.store(true, std::memory_order_release);
+}
+// Start the relay: *callerFd is the caller's end. False: no socketpair.
+static bool gdakiCtrlLaRelayStart(struct gdakiCtrlLaRelay* x, struct gdakiCtrlLaUnix* u, const struct gdakiCtrlLaLog& log,
+                                  int me, int* callerFd) {
+  int sv[2];
+  if (socketpair(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0, sv) != 0) return false;
+  x->fd = sv[1];
+  x->stop.store(false, std::memory_order_release);
+  x->done.store(false, std::memory_order_release);
+  x->aborted = false;
+  x->callerGone = false;
+  x->moved = 0;
+  *callerFd = sv[0];
+  x->th = std::thread(gdakiCtrlLaRelayMain, x, u, log, me);
+  return true;
+}
+// End the relay: graceMs > 0 (after the FETCH): the thread ends by itself (DONE relayed, or the caller's EOF) within
+// graceMs before stop is set (REVIEW_P3 고칠 것 4); 0 (a failure): stop now.
+static void gdakiCtrlLaRelayEnd(struct gdakiCtrlLaRelay* x, int graceMs) {
+  if (x->th.joinable() && graceMs > 0) {
+    const double end = gdakiQ4MonoMs() + graceMs;
+    while (!x->done.load(std::memory_order_acquire) && gdakiQ4MonoMs() < end) usleep(500);
+  }
+  x->stop.store(true, std::memory_order_release);
+  if (x->th.joinable()) x->th.join();
+  if (x->fd >= 0) close(x->fd);
+  x->fd = -1;
+}
+// A spare's REPLAY_FAILED (REVIEW_P3 고칠 것 9): its replay or its Resume refused before an activation was accepted
+// (the launcher answers the buddy REFUSED, design v3 5.2), once.
+static bool gdakiCtrlLaSpareFail(struct gdakiCtrlLaUnix* u, const char* why) {
+  if (u->role != GDAKI_CTRL_LA_ROLE_SPARE || u->failedSent || u->fd < 0 || u->closed) return false;
+  u->failedSent = gdakiCtrlLaUnixStatus(u, false, why);
+  return u->failedSent;
+}
+// The blob of ACT_BYTES on a socketpair's read end, for the reader of today's activation connection (gdakiMiActRecv).
+// -1: none.
+static int gdakiCtrlLaBlobFd(const std::vector<uint8_t>& blob) {
+  int sv[2];
+  if (socketpair(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0, sv) != 0) return -1;
+  int sz = (int)std::max<size_t>(blob.size() + 4096, 1u << 16);
+  (void)setsockopt(sv[1], SOL_SOCKET, SO_SNDBUF, &sz, sizeof(sz));
+  (void)setsockopt(sv[0], SOL_SOCKET, SO_RCVBUF, &sz, sizeof(sz));
+  size_t off = 0;
+  while (off < blob.size()) {
+    const ssize_t k = send(sv[1], blob.data() + off, blob.size() - off, MSG_NOSIGNAL | MSG_DONTWAIT);
+    if (k <= 0) break;
+    off += (size_t)k;
+  }
+  close(sv[1]);
+  if (off != blob.size()) {
+    close(sv[0]);
+    return -1;
+  }
+  return sv[0];
+}
+// ---- the host's glue, here for the unit test (REVIEW_P3 고칠 것 6): the buddy's activation step, the FETCH_DONE hand-off,
+// the spare's wait and its revival; the host gives the mirror's and the hold's parts as tables ----
+// FETCH_DONE through the launcher to the FETCH waiter (its socketpair's other end), then that end closed.
+static void gdakiCtrlLaFetchFwdStep(struct gdakiCtrlLaLink* k) {
+  if (k->fwdSock < 0 || k->fwdPeer < 0 || k->fwdPeer >= k->nranks) return;
+  struct gdakiCtrlLaAct& a = k->act[(size_t)k->fwdPeer];
+  if (!a.haveDone) return;
+  (void)send(k->fwdSock, a.done, sizeof(a.done), MSG_NOSIGNAL | MSG_DONTWAIT);
+  a.haveDone = false;
+  close(k->fwdSock);
+  k->fwdSock = -1;
+  k->fwdPeer = -1;
+}
+struct gdakiCtrlLaBuddyOps {
+  void* arg = nullptr;
+  void (*unlock)(void* arg) = nullptr;  // around the drain and the blob (the helper's time; the link's mutex is free)
+  void (*lock)(void* arg) = nullptr;
+  // mirror or store on: the drain step: 0 drained, > 0 not yet (the next step), < 0 fall back with why
+  int (*drain)(void* arg, int peer, uint32_t dead, uint64_t step, char* why, size_t whyLen) = nullptr;
+  // the blob's bytes for the record; false with why
+  bool (*blob)(void* arg, int peer, uint32_t dead, const struct glRsActivate& rec, std::vector<uint8_t>* bytes, char* why,
+               size_t whyLen) = nullptr;
+  // the blob into this rank's outbox: its region and transfer id; false: no outbox (TODO(2a-2))
+  bool (*outboxPut)(void* arg, const std::vector<uint8_t>& bytes, struct glRegion* out, uint64_t* xferId) = nullptr;
+  // after ACCEPTED: this rank's FETCH QP to the spare's endpoint (gdakiMiActAnswer::fetch); false with why
+  bool (*fetchConnect)(void* arg, int peer, uint32_t dead, const struct gdakiMiActAnswer& an, char* why, size_t whyLen) =
+    nullptr;
+  // the FETCH waiter on fd (it reads the spare's DONE, 80 B, and owns fd); false: none (fd is closed here)
+  bool (*waiter)(void* arg, int peer, uint32_t dead, int fd) = nullptr;
+};
+struct gdakiCtrlLaBuddyOut {
+  bool started = false;     // ACTIVATE went out in this step
+  bool laterNew = false;    // the first LATER is new in this step (the host's LATER line)
+  bool fetchReady = false;  // READY went to the spare (its FETCH runs)
+  bool endAct = false;      // the caller ends the mirror's activation (gdakiMiActEnd) with the fallback
+  char why[256] = {0};      // the fallback's reason
+  char fetchWhy[160] = {0}; // the FETCH handshake's failure (the host's GIN/MI line)
+};
+enum : int { GDAKI_CTRL_LA_BS_WAIT = 0, GDAKI_CTRL_LA_BS_ACTIVATED = 1, GDAKI_CTRL_LA_BS_FALLBACK = -1 };
+// One step of the buddy's activation of (peer, dead + 1) (gdakiHoldActivateSend's rdma body). The first step decorates
+// the record (pid and pidStart 0, reserved = FENCED, version MI with the blob) and sends ACTIVATE; the next ones read the
+// answer (gdakiCtrlLaActStep) and, mirror or store on, after ACCEPTED: the spare's FETCH endpoint within 1000 ms, this
+// rank's FETCH QP, READY through the launcher, the waiter on a socketpair the FETCH_DONE hand-off fills.
+static int gdakiCtrlLaBuddyStep(struct gdakiCtrlLaLink* k, int peer, const struct glRsActivate& rec0, uint32_t dead, bool mi,
+                                double now, const struct gdakiCtrlLaBuddyOps& ops, struct gdakiCtrlLaBuddyOut* out) {
+  struct gdakiCtrlLaAct& st = k->act[(size_t)peer];
+  if (st.state == GDAKI_CTRL_LA_ACT_NONE || st.inc != dead + 1u) {  // this activation's first step: ACTIVATE
+    struct glRsActivate rec = rec0;
+    rec.pid = 0;  // the launcher holds the pidfd; the record carries FENCED instead
+    rec.pidStart = 0;
+    rec.reserved = gdakiCtrlLaActFencedMark(rec.incarnation);
+    std::vector<uint8_t> bytes;
+    if (mi) {
+      if (ops.unlock != nullptr) ops.unlock(ops.arg);
+      const int dr = ops.drain != nullptr ? ops.drain(ops.arg, peer, dead, rec.step, out->why, sizeof(out->why)) : 0;
+      bool ok = dr == 0;
+      if (ok && (ops.blob == nullptr || !ops.blob(ops.arg, peer, dead, rec, &bytes, out->why, sizeof(out->why)))) {
+        ok = false;
+        out->endAct = true;
+        if (out->why[0] == '\0') snprintf(out->why, sizeof(out->why), "the activation blob could not be encoded");
+      }
+      if (ops.lock != nullptr) ops.lock(ops.arg);
+      if (dr > 0) return GDAKI_CTRL_LA_BS_WAIT;  // not drained yet: the next helper step
+      if (!ok) return GDAKI_CTRL_LA_BS_FALLBACK;
+      rec.version = GDAKI_RS_ACT_VERSION_MI;
+    }
+    struct glRegion at;
+    memset(&at, 0, sizeof(at));
+    uint64_t xferId = 0;
+    if (ops.outboxPut == nullptr || !ops.outboxPut(ops.arg, bytes, &at, &xferId) ||
+        !gdakiCtrlLaActStart(k, peer, rec, at, xferId, now)) {
+      out->endAct = mi;
+      snprintf(out->why, sizeof(out->why), "no launcher path for the peer's activation (TODO(2a-2): the ring and its outbox)");
+      return GDAKI_CTRL_LA_BS_FALLBACK;
+    }
+    out->started = true;
+    return GDAKI_CTRL_LA_BS_WAIT;  // the answer comes in a later step (event based: no asking again, design v3 5.4 4)
+  }
+  const int s = gdakiCtrlLaActStep(k, peer, now, out->why, sizeof(out->why));
+  if (st.nLater > 0 && !st.laterSaid) {
+    st.laterSaid = true;
+    out->laterNew = true;
+  }
+  if (s == GDAKI_CTRL_LA_AS_WAIT) return GDAKI_CTRL_LA_BS_WAIT;
+  if (s == GDAKI_CTRL_LA_AS_FALLBACK) {
+    out->endAct = mi;
+    return GDAKI_CTRL_LA_BS_FALLBACK;
+  }
+  if (!mi || st.state != GDAKI_CTRL_LA_ACT_ACCEPTED) return GDAKI_CTRL_LA_BS_ACTIVATED;
+  // the FETCH handshake: the spare's endpoint, this rank's READY
+  char w[160] = {0};
+  if (!st.haveEp) {
+    if (now - st.acceptedMs < 1000.0) return GDAKI_CTRL_LA_BS_WAIT;  // within 1000 ms (as the TCP path)
+    snprintf(w, sizeof(w), "no FETCH endpoint from the spare");
+  }
+  struct gdakiMiActAnswer an;
+  memset(&an, 0, sizeof(an));
+  static_assert(sizeof(an) == GL_FETCH_EP_BYTES, "the spare's FETCH endpoint is the relayed 112 B");
+  if (st.haveEp) memcpy(&an, st.ep, sizeof(an));
+  struct gdakiMiActReady rd;
+  memset(&rd, 0, sizeof(rd));
+  static_assert(sizeof(rd) == GL_FETCH_READY_BYTES, "READY is the relayed 72 B");
+  rd.magic = GDAKI_MI_ACTB_MAGIC;
+  if (w[0] != '\0') {
+  } else if (an.magic != GDAKI_MI_ACTB_MAGIC || an.ok != 1) {
+    an.why[sizeof(an.why) - 1] = '\0';
+    snprintf(w, sizeof(w), "no FETCH endpoint from the spare%s%.100s", an.magic == GDAKI_MI_ACTB_MAGIC ? ": " : "",
+             an.magic == GDAKI_MI_ACTB_MAGIC ? an.why : "");
+  } else if (ops.fetchConnect != nullptr && ops.fetchConnect(ops.arg, peer, dead, an, w, sizeof(w))) {
+    rd.kind = GDAKI_MI_ACT_READY;
+  } else if (w[0] == '\0') {
+    snprintf(w, sizeof(w), "no FETCH QP of this rank for the peer");
+  }
+  out->endAct = true;
+  if (rd.kind != GDAKI_MI_ACT_READY) {
+    rd.kind = GDAKI_MI_ACT_FAIL;
+    snprintf(rd.why, sizeof(rd.why), "%.63s", w);
+    (void)gdakiCtrlLaFetchReady(k, peer, &rd);
+    snprintf(out->fetchWhy, sizeof(out->fetchWhy), "%s", w);
+    snprintf(out->why, sizeof(out->why), "the peer's spare accepted its activation but the FETCH handshake failed");
+    return GDAKI_CTRL_LA_BS_FALLBACK;
+  }
+  int sv[2];
+  if (socketpair(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0, sv) != 0) {
+    sv[0] = sv[1] = -1;
+  } else if (ops.waiter == nullptr || !ops.waiter(ops.arg, peer, dead, sv[0])) {  // REVIEW_P3 nit 8: no waiter, no activation
+    close(sv[0]);
+    close(sv[1]);
+    sv[0] = sv[1] = -1;
+  }
+  if (sv[1] < 0) {
+    rd.kind = GDAKI_MI_ACT_FAIL;
+    snprintf(rd.why, sizeof(rd.why), "the buddy's FETCH waiter could not start");
+    (void)gdakiCtrlLaFetchReady(k, peer, &rd);
+    gdakiCtrlLaAbort(k, peer);  // after ACCEPTED only ABORT ends the launcher's activation (EXPERIMENT.md 9.5 (8))
+    snprintf(out->fetchWhy, sizeof(out->fetchWhy), "the buddy's FETCH waiter could not start");
+    snprintf(out->why, sizeof(out->why), "the peer's spare accepted its activation but the FETCH handshake failed");
+    return GDAKI_CTRL_LA_BS_FALLBACK;
+  }
+  if (!gdakiCtrlLaFetchReady(k, peer, &rd)) {
+    close(sv[1]);  // the waiter sees EOF
+    snprintf(out->why, sizeof(out->why), "READY could not be sent to the peer's spare through its launcher");
+    return GDAKI_CTRL_LA_BS_FALLBACK;
+  }
+  if (k->fwdSock >= 0) close(k->fwdSock);
+  k->fwdSock = sv[1];
+  k->fwdPeer = peer;
+  out->endAct = false;
+  out->fetchReady = true;
+  return GDAKI_CTRL_LA_BS_ACTIVATED;
+}
+// The spare: READY to its launcher, then its ACTIVATE (the launcher hands it over only after READY) within waitMs,
+// checked: the record (this communicator, this rank, the HELLO's incarnation, FENCED carried) and, mirror or store on,
+// the blob as today's reader takes it (blobRecv on a socketpair holding it); the FETCH relay before ACCEPTED (one that
+// cannot start is REFUSED); the answer as ACT_TALK ANSWER. 0: ACCEPTED (*actFd the FETCH talk's end with mi, else -1);
+// else what failed (GDAKI_CTRL_LA_ST_*) with why.
+struct gdakiCtrlLaSpareOps {
+  void* arg = nullptr;
+  void (*unlock)(void* arg) = nullptr;  // around the wait for the bytes
+  void (*lock)(void* arg) = nullptr;
+  // mirror or store on: today's reader of the blob on fd (gdakiMiActRecv): 0 usable, else REFUSED with why
+  int (*blobRecv)(void* arg, int fd, const struct glRsActivate& rec, char* why, size_t whyLen) = nullptr;
+};
+enum : int {
+  GDAKI_CTRL_LA_ST_OK = 0, GDAKI_CTRL_LA_ST_NO_HELLO = 1, GDAKI_CTRL_LA_ST_NO_READY = 2, GDAKI_CTRL_LA_ST_NO_ACT = 3,
+  GDAKI_CTRL_LA_ST_REFUSED = 4
+};
+static int gdakiCtrlLaSpareTake(struct gdakiCtrlLaLink* k, struct gdakiCtrlLaRelay* relay, int waitMs, bool mi,
+                                const struct gdakiCtrlLaSpareOps& ops, struct glRsActivate* act, int* actFd, char* why,
+                                size_t whyLen) {
+  *actFd = -1;
+  why[0] = '\0';
+  struct gdakiCtrlLaUnix& u = k->unix;
+  if (u.role != GDAKI_CTRL_LA_ROLE_SPARE || !u.acked || u.ackStatus != GL_UA_OK) return GDAKI_CTRL_LA_ST_NO_HELLO;
+  if (!gdakiCtrlLaUnixStatus(&u, true, nullptr)) return GDAKI_CTRL_LA_ST_NO_READY;
+  gdakiCtrlLaSay(k->log, "GIN/RS: spare rank %d: READY (incarnation %u) to the launcher of node %u; waiting for the "
+                 "activation", k->me, u.inc, u.ack.node);
+  const double deadline = gdakiQ4MonoMs() + waitMs;
+  while (!u.haveAct && !u.closed && gdakiQ4MonoMs() < deadline) {
+    if (ops.unlock != nullptr) ops.unlock(ops.arg);
+    if (k->waitHook != nullptr) k->waitHook(k->waitArg, 100);
+    else gdakiCtrlLaUnixWait(&u, 100);
+    if (ops.lock != nullptr) ops.lock(ops.arg);
+    (void)gdakiCtrlLaUnixPoll(&u, k->log, k->me);
+  }
+  if (!u.haveAct) {
+    snprintf(why, whyLen, "%s", u.closed ? " (its socket closed)" : "");
+    return GDAKI_CTRL_LA_ST_NO_ACT;
+  }
+  u.haveAct = false;
+  *act = u.act;
+  int code = gdakiCtrlLaSpareCheck(u.act, k->me, k->nonce, u.inc);
+  if (code != 0) snprintf(why, whyLen, "%s", gdakiCtrlLaSpareCheckText(code));
+  if (code == 0 && (mi || act->version == GDAKI_RS_ACT_VERSION_MI)) {
+    const int bfd = gdakiCtrlLaBlobFd(u.blob);
+    if (bfd < 0 || ops.blobRecv == nullptr) {
+      code = 3;
+      snprintf(why, whyLen, "the activation blob could not be read");
+    } else {
+      code = ops.blobRecv(ops.arg, bfd, *act, why, whyLen);
+    }
+    if (bfd >= 0) close(bfd);
+  }
+  // the FETCH relay before ACCEPTED (REVIEW_P3 고칠 것 5 (다)): one that cannot start is REFUSED (a final answer)
+  if (code == 0 && mi && !gdakiCtrlLaRelayStart(relay, &u, k->log, k->me, actFd)) {
+    code = 5;
+    snprintf(why, whyLen, "the FETCH relay could not start");
+  }
+  struct glRsActivate ans = *act;
+  ans.kind = code == 0 ? (uint32_t)GL_RS_ACT_ACCEPTED : (uint32_t)GL_RS_ACT_REFUSED;
+  const bool sent = gdakiCtrlLaUnixTalk(&u, GL_UT_ANSWER, &ans, sizeof(ans));
+  if (code != 0 || !sent) {
+    if (code == 0) snprintf(why, whyLen, "the answer could not be sent");
+    if (*actFd >= 0) {
+      close(*actFd);  // the relay sees EOF and ends
+      *actFd = -1;
+    }
+    gdakiCtrlLaRelayEnd(relay, 0);
+    return GDAKI_CTRL_LA_ST_REFUSED;
+  }
+  return GDAKI_CTRL_LA_ST_OK;
+}
+// The spare after its FETCH, the relay ended: this process registers as the new incarnation (the launcher swaps the
+// rank's pidfd: design v3 5.4 7) and pairs again with every launcher (its re-arming waits for that). False with why.
+static bool gdakiCtrlLaSpareRevive(struct gdakiCtrlLaLink* k, char* why, size_t whyLen) {
+  const uint32_t inc = k->unix.act.incarnation;
+  k->inc = inc;
+  for (auto& p : k->la) {
+    gdakiCtrlPairInit(&p.pair, GDAKI_CTRL_PAIR_QP_RECORD, k->me, (int32_t)(GL_FROM_LAUNCHER | p.node));
+    p.connected = false;
+  }
+  k->latched = false;
+  k->pairOk = true;
+  return gdakiCtrlLaRegisterWait(k, GDAKI_CTRL_LA_ROLE_RANK, inc, 1000, why, whyLen);
+}
+// ---- gin-control (launcher): link (end) ----
+// ---- gin-control (launcher): host ----
+NCCL_PARAM(GinCtrlLaterMs, GDAKI_CTRL_P_LATER_MS, GDAKI_CTRL_LATER_MS_DEFAULT);                 // 1000 (결정 4)
+NCCL_PARAM(GinCtrlLauncherStallMs, GDAKI_CTRL_P_LAUNCHER_STALL_MS, GDAKI_CTRL_LAUNCHER_STALL_MS_DEFAULT);  // 1000
+// r->ctrl->launcher: the link (above) of this context, made at gdakiTsStart (the setup thread; a spare before its
+// activation), then the helper's (its step in gdakiTsMain, the hold machine's calls), freed by gdakiCtrlLauncherFree. Its
+// mutex covers every use but the spare's FETCH relay thread (which alone touches the Unix socket while the spare's FETCH
+// runs). The launchers' RNIC side has no transport here yet: TODO(2a-2) below.
+struct gdakiCtrlLauncher {
+  struct gdakiCtrlLaLink k;
+  struct gdakiCtrlLaRelay relay;
+  std::mutex mu;
+  struct gdakiRecHost* r = nullptr;
+  bool registered = false;          // HELLO_ACK OK for the current role and incarnation
+  bool spare = false;               // a spare process (NCCL_GIN_RESTORE_SPARE) before its activation
+  uint32_t resendSaidInc = 0;       // inc + 1 of the last "STORE_REQ goes again" line
+  // the judgement table's L inputs by rank (gdakiCtrlLaLInputs; the watch thread reads them without the mutex)
+  std::unique_ptr<std::atomic<uint64_t>[]> pubLeft, pubFenced, pubReg;
+};
+static struct gdakiCtrlLauncher* gdakiCtrlLaOf(struct gdakiRecHost* r) {
+  return (r != nullptr && r->ctrl != nullptr) ? r->ctrl->launcher : nullptr;
+}
+static void gdakiCtrlLaNote(void* arg, const char* line) {
+  (void)arg;
+  GIN_TS_NOTE("%s mono_ms=%.3f", line, gdakiQ4MonoMs());
+}
+// The lineage's verdict on an ended (rank, inc) (helper): CURRENT or HELD_OLD raise the fence word (design 4.4 4).
+static bool gdakiCtrlLaLnOk(void* arg, int rank, uint32_t inc) {
+  struct gdakiRecHost* r = (struct gdakiRecHost*)arg;
+  if (rank == r->ctx->rank) return false;
+  const uint32_t c = gdakiLnClassify(gdakiLnOf(r, rank), inc);
+  return c == GDAKI_LN_CURRENT || c == GDAKI_LN_HELD_OLD;
+}
