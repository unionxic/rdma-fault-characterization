+// ---- the registering connection is closed in a forked child (pthread_atfork; the helper's and witness's rule) ----
+#define GDAKI_CTRL_LA_FORK_SLOTS 16
+static std::atomic<int> gdakiCtrlLaForkFd[GDAKI_CTRL_LA_FORK_SLOTS];  // fd + 1; 0: free
+static void gdakiCtrlLaAtforkChild() {
+  for (int i = 0; i < GDAKI_CTRL_LA_FORK_SLOTS; i++) {
+    const int v = gdakiCtrlLaForkFd[i].exchange(0);
+    if (v > 0) (void)close(v - 1);
+  }
+}
+static void gdakiCtrlLaForkWatch(int fd) {
+  static std::once_flag once;
+  std::call_once(once, [] { (void)pthread_atfork(nullptr, nullptr, gdakiCtrlLaAtforkChild); });
+  for (int i = 0; i < GDAKI_CTRL_LA_FORK_SLOTS; i++) {
+    int z = 0;
+    if (gdakiCtrlLaForkFd[i].compare_exchange_strong(z, fd + 1)) return;
+  }
+}
+static void gdakiCtrlLaForkUnwatch(int fd) {
+  for (int i = 0; i < GDAKI_CTRL_LA_FORK_SLOTS; i++) {
+    int v = fd + 1;
+    if (gdakiCtrlLaForkFd[i].compare_exchange_strong(v, 0)) return;
+  }
+}
