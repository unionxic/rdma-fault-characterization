+// This rank's PAIR(record) to launcher li (setup; its record QP lost: gen + 1). The launcher answers PAIR_ACK on UD.
+static void gdakiCtrlLaPairBody(struct gdakiCtrlLaLink* k, int li, uint32_t gen, struct glPairBody* b) {
+  memset(b, 0, sizeof(*b));
+  b->gen = gen;
+  b->qkey = k->qkey;
+  b->qp = k->la[(size_t)li].local;
+  b->ud = k->ud;
+  b->page = k->page;
+  b->creditOff = k->creditOff0 + 8u * (uint32_t)li;
