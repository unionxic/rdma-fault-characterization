+GL_STATIC_ASSERT(sizeof(struct glActAnswerBody) == 144, "glActAnswerBody is 144 bytes");
+GL_STATIC_ASSERT(sizeof(struct glPairBody) <= GL_BODY_BYTES && sizeof(struct glPairAckBody) <= GL_BODY_BYTES &&
