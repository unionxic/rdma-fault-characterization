+// Every launcher not paired (or lost) starts a pairing; the clock resends and gives up (gdakiCtrlPairTick).
+static void gdakiCtrlLaPairTick(struct gdakiCtrlLaLink* k, double now) {
+  if (!k->pairOk) return;
+  for (size_t i = 0; i < k->la.size(); i++) {
+    struct gdakiCtrlLaPeer& p = k->la[i];
+    if (!p.known) continue;
+    if (p.pair.state == GDAKI_CTRL_PS_IDLE || (p.qpErr && p.pair.state == GDAKI_CTRL_PS_UP)) {
+      p.qpErr = false;
+      gdakiCtrlLaPairStart(k, (int)i, now);
+      continue;
+    }
+    if (gdakiCtrlPairTick(&p.pair, now) == GDAKI_CTRL_PA_RESEND_PAIR && p.pair.state == GDAKI_CTRL_PS_STARTED)
+      (void)gdakiCtrlLaPairSend(k, (int)i, p.pair.mine);
+  }
+}
+static bool gdakiCtrlLaAllPaired(const struct gdakiCtrlLaLink* k) {
+  if (k->la.empty() || k->nLaunchers <= 0 || (int)k->la.size() != k->nLaunchers) return false;
+  for (const auto& p : k->la)
