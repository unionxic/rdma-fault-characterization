+// [3] the judgement's hook (every survivor's hold start, before gdakiTsQuiesce and gdakiCtrlPeerToErr move any QP toward
+// the peer): the window line's snapshot (REVIEW_P3 막는 문제 1). Reads its cells over the copy path (16 cells of 64 B per
+// region; the helper, a few ms).
+static void gdakiCtrlOnJudgement(struct gdakiRecHost* r, int peer, uint32_t inc) {
+  struct gdakiCtrlLauncher* L = gdakiCtrlLaOf(r);
+  if (L == nullptr || peer < 0 || peer >= L->k.nranks) return;
+  std::lock_guard<std::mutex> lk(L->mu);
+  gdakiCtrlLaOnJudgement(&L->k, peer, inc);
+}
+// [3] the hold start's hook (every survivor, after gdakiCtrlPeerToErr): the fence of (peer, inc) armed and at the buddy
+// SPAWN (decision 12; its REFUSED is a line only). A word that already says FENCED (EXITED before the hold start) gives
+// the buddy's FENCED line and the window line now.
+static void gdakiCtrlOnHoldStart(struct gdakiRecHost* r, int peer, uint32_t inc) {
+  struct gdakiCtrlLauncher* L = gdakiCtrlLaOf(r);
+  if (L == nullptr || peer < 0 || peer >= L->k.nranks) return;
+  std::lock_guard<std::mutex> lk(L->mu);
+  gdakiCtrlLaFenceArm(&L->k, peer, inc);
+  const bool buddy = gdakiHoldBuddyOf(peer, L->k.nranks) == L->k.me;
+  if (buddy) gdakiCtrlLaSpawn(&L->k, peer, inc + 1u);
+  gdakiCtrlLaFenceReport(&L->k, peer, buddy);
+}
+static int gdakiCtrlLauncherSend(struct gdakiRecHost* r, int node, const void* msg, size_t bytes) {
+  struct gdakiCtrlLauncher* L = gdakiCtrlLaOf(r);
+  if (L == nullptr || msg == nullptr || bytes != sizeof(struct glMsg) || node < 0) return -1;
+  std::lock_guard<std::mutex> lk(L->mu);
+  struct glMsg m;
+  memcpy(&m, msg, sizeof(m));
+  return gdakiCtrlLaSendTo(&L->k, gdakiCtrlLaIndexOfNode(&L->k, (uint32_t)node), &m);
+}
+// The buddy's fence step (gdakiCtrlActFenceOk, once every HOLDING is in).
+static int gdakiCtrlLaFenceStep(struct gdakiRecHost* r, int peer, uint32_t dead, uint64_t* word, char* why, size_t whyLen) {
+  struct gdakiCtrlLauncher* L = gdakiCtrlLaOf(r);
+  *word = GDAKI_CTRL_FENCE_NONE;
+  if (L == nullptr || peer < 0 || peer >= L->k.nranks) {
+    snprintf(why, whyLen, "this rank has no launcher link");
+    return GDAKI_CTRL_LA_GATE_FALLBACK;
+  }
+  std::lock_guard<std::mutex> lk(L->mu);
+  const int g = gdakiCtrlLaGate(&L->k, peer, dead, gdakiQ4MonoMs(), why, whyLen);
+  *word = L->k.fencedPlus1[(size_t)peer];
+  struct gdakiCtrlPage* pg = gdakiPageOf(r);  // phase 1's report of the fence (gdakiLnFenceOf's fenceSent)
+  if (pg != nullptr && peer < (int)pg->peers.size()) pg->peers[(size_t)peer].fenceSent = L->k.fence[(size_t)peer].sent;
+  return g;
+}
+// r->ctrl->launcher (gdakiCtrlFree, after the helper and the watch thread stopped).
+static void gdakiCtrlLauncherFree(struct gdakiRecHost* r) {
+  struct gdakiCtrlLauncher* L = gdakiCtrlLaOf(r);
+  if (L == nullptr) return;
+  gdakiCtrlLaRelayEnd(&L->relay, 0);
+  gdakiCtrlLaUnixClose(&L->k.unix);
+  if (L->k.fwdSock >= 0) close(L->k.fwdSock);
+  delete L;
+  r->ctrl->launcher = nullptr;
+}
