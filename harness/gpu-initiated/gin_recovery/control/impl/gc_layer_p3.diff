+  v.regAcked = k->unix.acked && k->unix.ackStatus == GL_UA_OK && k->unix.role == GDAKI_CTRL_LA_ROLE_RANK ? 1u : 0u;
+  v.regAckInc = k->unix.ackInc;
+  v.leaving = k->leaving || k->unix.leavingSent ? 1u : 0u;
+  v.allPaired = gdakiCtrlLaAllPaired(k) ? 1u : 0u;
