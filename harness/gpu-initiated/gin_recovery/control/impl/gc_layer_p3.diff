+// The window line's regions (gdakiCtrlLaCellsIo): this rank's windows on the context's collComm (registration order),
+// its signal and counter tables: what a peer's RDMA WRITE or atomic can reach (gdakiCkptRegions without the
+// ncclGinRestoreRegister buffers, which no peer writes). The helper reads a cell over the copy path (gdakiRecD2H).
+static void gdakiCtrlLaCellRegions(void* arg, std::vector<struct gdakiCtrlLaRegion>* out) {
+  struct gdakiRecHost* r = (struct gdakiRecHost*)arg;
+  out->clear();
+  {
+    std::lock_guard<std::mutex> lk(gdakiRsWinMu);
+    for (const auto& w : gdakiRsWins)
+      if (w.coll == (void*)r->ctx->collComm && !w.gone && w.hi > w.lo) out->push_back({(const void*)w.lo, (uint64_t)(w.hi - w.lo)});
+  }
+  struct gdaki_context* g = r->ctx;
+  if (g->signals_table && g->signals_table->buffer_bytes())
+    out->push_back({g->signals_table->gpu_ptr, (uint64_t)g->signals_table->buffer_bytes()});
+  if (g->counters_table && g->counters_table->buffer_bytes())
+    out->push_back({g->counters_table->gpu_ptr, (uint64_t)g->counters_table->buffer_bytes()});
+}
+static bool gdakiCtrlLaCellRead(void* arg, const void* src, void* dst, size_t n) {
+  return gdakiRecD2H((struct gdakiRecHost*)arg, dst, src, n) == ncclSuccess;
+}
+// The latch (phase 1's gdakiCtrlLauncherPairedLatch): once the own launcher is paired and holds this incarnation.
+static void gdakiCtrlLaLatchStep(struct gdakiCtrlLauncher* L) {
+  if (L->k.latched || !gdakiCtrlLaPairedOwn(&L->k)) return;
+  L->k.latched = true;
+  gdakiCtrlLauncherPairedLatch(L->r);
+  gdakiCtrlLaSay(L->k.log, "GIN/RC: rank %d: paired with the launcher of node %u, which holds incarnation %u: the "
+                 "activation gate requires FENCED", L->k.me, L->k.la[(size_t)L->k.own].node, L->k.inc);
+}
+// REGISTER (a rank) or SPARE_HELLO (a spare) and its answer within 1000 ms (the setup thread, after the all-gather: the
+// nonce; the launcher is the node's, always up during a hold). The line or the WARN.
+static void gdakiCtrlLaRegister(struct gdakiCtrlLauncher* L, int role, uint32_t inc) {
+  struct gdakiCtrlLaLink& k = L->k;
+  char why[160] = {0};
+  L->registered = gdakiCtrlLaRegisterWait(&k, role, inc, 1000, why, sizeof(why));
+  if (!L->registered) {
+    WARN("GIN/RC: rank %d: %s of incarnation %u at the node's launcher failed (%s): no launcher path, this rank is not armed "
+         "mono_ms=%.3f", k.me, role == GDAKI_CTRL_LA_ROLE_SPARE ? "spare HELLO" : "REGISTER", inc, why, gdakiQ4MonoMs());
+    return;
+  }
+  if (k.unix.forkUnwatched)
+    GIN_TS_NOTE("GIN/RC: rank %d: the launcher connection has no fork-watch slot (%d in use): a forked child keeps it "
+                "open mono_ms=%.3f", k.me, GDAKI_CTRL_LA_FORK_SLOTS, gdakiQ4MonoMs());
+  gdakiCtrlLaSay(k.log, "GIN/RC: rank %d: %s incarnation %u at the launcher of node %u (page slot %u)", k.me,
+                 role == GDAKI_CTRL_LA_ROLE_SPARE ? "spare said HELLO as" : "registered", inc, k.unix.ack.node,
+                 k.unix.ack.pageSlot);
+}
+// The link of this context, made at the first of gdakiCtrlLauncherQuery and gdakiCtrlLauncherSetup (no nonce yet: set at
+// the setup). Only a process that asks for the restore. Null: none.
+static struct gdakiCtrlLauncher* gdakiCtrlLaMake(struct gdakiRecHost* r) {
+  if (r == nullptr || r->ctrl == nullptr || r->ctx == nullptr) return nullptr;
+  if (r->ctrl->launcher != nullptr) return r->ctrl->launcher;
+  const struct gdakiRsCfg& c = gdakiRsProc();
+  if (!c.requested) return nullptr;  // no restore asked: no launcher
+  struct gdakiCtrlLauncher* L = new gdakiCtrlLauncher();
+  L->r = r;
+  struct gdakiCtrlLaLink& k = L->k;
+  const bool spare = c.spare >= 0;
+  L->spare = spare;
+  const uint32_t inc = spare ? gdakiCtrlLaSpareIncEnv() : gdakiRsSelfInc(r);
+  // TODO(2a-2): this rank's UD endpoint, page and creditOff (k.ud, k.page, k.creditOff0) from the ring; the launcher
+  // count and the other launchers come from the all-gather's fields (gdakiCtrlLauncherAgTake: 2a-2 carries them)
+  gdakiCtrlLaInit(&k, r->ctx->rank, r->nranks, inc, 0, 0);
+  k.log.fn = gdakiCtrlLaNote;
+  k.lnOk = gdakiCtrlLaLnOk;
+  k.lnArg = r;
+  k.tx.arg = r;
+  k.tx.udSend = gdakiCtrlLaTxUd;
+  k.tx.rcCreate = gdakiCtrlLaTxCreate;
+  k.tx.rcConnect = gdakiCtrlLaTxConnect;
+  k.tx.rcSend = gdakiCtrlLaTxSend;
+  k.pairOk = !spare;  // a spare pairs as the new incarnation after its activation (gdakiCtrlLaSpareDone)
+  k.laterMs = (double)ncclParamGinCtrlLaterMs();
+  k.stallMs = (double)ncclParamGinCtrlLauncherStallMs();
+  L->pubLeft.reset(new std::atomic<uint64_t>[(size_t)r->nranks]());
+  L->pubFenced.reset(new std::atomic<uint64_t>[(size_t)r->nranks]());
+  L->pubReg.reset(new std::atomic<uint64_t>[(size_t)r->nranks]());
+  k.cells.arg = r;  // the window line's cells (REVIEW_P3 막는 문제 1)
+  k.cells.regions = gdakiCtrlLaCellRegions;
+  k.cells.read = gdakiCtrlLaCellRead;
+  r->ctrl->launcher = L;
+  return L;
+}
+static void gdakiCtrlLauncherQuery(struct gdakiRecHost* r) {
+  struct gdakiCtrlLauncher* L = gdakiCtrlLaMake(r);
+  if (L == nullptr) return;
+  std::lock_guard<std::mutex> lk(L->mu);
+  if (!gdakiCtrlLaInfoWait(&L->k, GDAKI_CTRL_LA_INFO_MS))
+    GIN_TS_NOTE("GIN/RC: rank %d: the node's launcher gave no INFO answer within %d ms (%s): this rank's all-gather field "
+                "says no launcher path mono_ms=%.3f", L->k.me, GDAKI_CTRL_LA_INFO_MS,
+                L->k.unix.fd < 0 ? "no socket" : L->k.unix.closed ? "its socket closed" : "TODO(launcher): INFO",
+                gdakiQ4MonoMs());
+}
+static void gdakiCtrlLauncherAgInfo(struct gdakiRecHost* r, struct gdakiCtrlLaAgInfo* out) {
+  memset(out, 0, sizeof(*out));
+  struct gdakiCtrlLauncher* L = gdakiCtrlLaOf(r);
+  if (L == nullptr) return;
+  std::lock_guard<std::mutex> lk(L->mu);
+  gdakiCtrlLaAgOf(L->k.unix, out);
+}
+static void gdakiCtrlLauncherAgTake(struct gdakiRecHost* r, const struct gdakiCtrlLaAgInfo* byRank, int nranks) {
+  struct gdakiCtrlLauncher* L = gdakiCtrlLaOf(r);
+  if (L == nullptr || byRank == nullptr) return;
+  std::lock_guard<std::mutex> lk(L->mu);
+  (void)gdakiCtrlLaAgTake(&L->k, byRank, nranks);
+}
+static void gdakiCtrlLauncherSetup(struct gdakiRecHost* r) {
+  if (r == nullptr || r->ts == nullptr) return;
+  struct gdakiCtrlLauncher* L = gdakiCtrlLaMake(r);
+  if (L == nullptr) return;
+  std::lock_guard<std::mutex> lk(L->mu);
+  struct gdakiCtrlLaLink& k = L->k;
+  gdakiCtrlLaSetNonce(&k, r->ts->nonce);
+  if (L->spare && k.inc == 0) {
+    WARN("GIN/RC: rank %d: %s is not an incarnation above 0: the spare says no HELLO mono_ms=%.3f", k.me,
+         GDAKI_CTRL_LA_SPARE_INC_ENV, gdakiQ4MonoMs());
+    return;
+  }
+  gdakiCtrlLaRegister(L, L->spare ? GDAKI_CTRL_LA_ROLE_SPARE : GDAKI_CTRL_LA_ROLE_RANK, k.inc);
+}
+// The helper's step (gdakiTsMain): the socket (its loss: the line), the pairings' clock, the latch, the buddy's FETCH QP.
+static void gdakiCtrlLauncherStep(struct gdakiRecHost* r) {
+  struct gdakiCtrlLauncher* L = gdakiCtrlLaOf(r);
+  if (L == nullptr) return;
+  std::lock_guard<std::mutex> lk(L->mu);
+  const double now = gdakiQ4MonoMs();
+  (void)gdakiCtrlLaUnixPoll(&L->k.unix, L->k.log, L->k.me);
+  gdakiCtrlLaPairTick(&L->k, now);
+  gdakiCtrlLaLatchStep(L);
+  for (int p = 0; p < L->k.nranks; p++) {  // a hold that fell back without the fence word: its window line (막는 문제 1)
+    struct gdakiCtrlLaFence& f = L->k.fence[(size_t)p];
+    if (!f.armed || f.windowSaid) continue;
+    const uint32_t st = gdakiHoldPeerState(r, p, nullptr);
+    if (st == GDAKI_HOLD_FALLBACK || st == GDAKI_HOLD_CANCELLED) gdakiCtrlLaOnHoldEnd(&L->k, p);
+    else if (!gdakiHoldIsHeldState(st)) f.windowSaid = true;  // restored without the word here: no point before the new
+                                                              // incarnation writes (no line)
+  }
+  gdakiCtrlLaFetchFwdStep(&L->k);  // FETCH_DONE through the launcher: to the FETCH waiter
+
+}
+// The L inputs' words after a launcher message (the helper, L->mu held).
+static void gdakiCtrlLaPublish(struct gdakiCtrlLauncher* L) {
+  for (int p = 0; p < L->k.nranks; p++) {
+    L->pubLeft[(size_t)p].store(L->k.leftPlus1[(size_t)p], std::memory_order_release);
+    L->pubFenced[(size_t)p].store(L->k.fencedPlus1[(size_t)p], std::memory_order_release);
+    L->pubReg[(size_t)p].store(gdakiCtrlLaRegWord(&L->k, p), std::memory_order_release);
+  }
+}
+static void gdakiCtrlLaLInputs(struct gdakiRecHost* r, int peer, uint32_t inc, bool* left, bool* ended, bool* regAlive,
+                               bool* regLeft) {
+  *left = *ended = *regAlive = *regLeft = false;
+  struct gdakiCtrlLauncher* L = gdakiCtrlLaOf(r);
+  if (L == nullptr || peer < 0 || peer >= L->k.nranks) return;
+  const struct gdakiCtrlLaLIn x = gdakiCtrlLaLInOf(L->pubLeft[(size_t)peer].load(std::memory_order_acquire),
+                                                   L->pubFenced[(size_t)peer].load(std::memory_order_acquire),
+                                                   L->pubReg[(size_t)peer].load(std::memory_order_acquire), inc);
+  *left = x.left;
+  *ended = x.ended;
+  *regAlive = x.regAlive;
+  *regLeft = x.regLeft;
+}
+// [2a-2 calls it] an envelope from a launcher.
+static void gdakiCtrlLauncherOnEnvelope(struct gdakiRecHost* r, const struct gdakiCtrlEnv* e, const void* body, bool ud) {
+  struct gdakiCtrlLauncher* L = gdakiCtrlLaOf(r);
+  if (L == nullptr || e == nullptr || body == nullptr || (e->from & GDAKI_CTRL_FROM_LAUNCHER) == 0) return;
+  std::lock_guard<std::mutex> lk(L->mu);
+  struct glMsg m;
+  memcpy(&m, body, sizeof(m));
+  const double now = gdakiQ4MonoMs();
+  if (ud) {
+    gdakiCtrlLaOnUd(&L->k, m, now);
+  } else {
+    const int li = gdakiCtrlLaIndexOfNode(&L->k, (uint32_t)e->from & ~(uint32_t)GDAKI_CTRL_FROM_LAUNCHER);
+    gdakiCtrlLaOnRc(&L->k, li, m, now);
+    if (li >= 0 && (m.h.kind == GL_K_EXITED || m.h.kind == GL_K_FENCED) && m.h.rank >= 0 && m.h.rank < L->k.nranks) {
+      const int p = m.h.rank;
+      gdakiLnFenced(r, p, m.h.incarnation);  // phase 1's page copy of the word (the report)
+      gdakiCtrlLaFenceReport(&L->k, p, gdakiHoldBuddyOf(p, L->k.nranks) == L->k.me);
+    }
+    gdakiCtrlLaPublish(L);
+  }
+  gdakiCtrlLaLatchStep(L);
+}
+static void gdakiCtrlLauncherLeaving(struct gdakiRecHost* r) {
+  struct gdakiCtrlLauncher* L = gdakiCtrlLaOf(r);
+  if (L == nullptr) return;
+  std::lock_guard<std::mutex> lk(L->mu);
+  L->k.leaving = true;
+  if (L->registered && gdakiCtrlLaUnixLeaving(&L->k.unix))
+    GIN_TS_NOTE("GIN/RC: rank %d: LEAVING (incarnation %u) to the launcher of node %u mono_ms=%.3f", L->k.me, L->k.inc,
+                L->k.own >= 0 ? L->k.la[(size_t)L->k.own].node : 0u, gdakiQ4MonoMs());
+}
+static bool gdakiCtrlLaWardArmOk(struct gdakiRecHost* r, int ward) {
+  struct gdakiCtrlLauncher* L = gdakiCtrlLaOf(r);
+  if (L == nullptr) return false;
+  if (gdakiHoldBuddyOf(ward, L->k.nranks) != L->k.me) return true;  // only the ward's buddy talks to its launcher
+  std::lock_guard<std::mutex> lk(L->mu);
+  return gdakiCtrlLaWardPathOk(&L->k, ward);
+}
+static void gdakiCtrlLaStoreReqTail(struct gdakiRecHost* r, struct gdakiStoreReqSpare* sp) {
+  sp->magic = GDAKI_CTRL_LA_STORE_SPARE_MAGIC;
+  sp->haveSpare = 0;
+  sp->pid = 0;
+  sp->pidStart = 0;
+  struct gdakiCtrlLaSpareReg g;
+  memset(&g, 0, sizeof(g));
+  struct gdakiCtrlLauncher* L = gdakiCtrlLaOf(r);
+  if (L != nullptr) {
+    std::lock_guard<std::mutex> lk(L->mu);
+    gdakiCtrlLaLatchStep(L);
+    sp->haveSpare = gdakiCtrlLaTailFill(&L->k, &g) ? 1u : 0u;
+  }
+  memcpy(sp->spareAddr, &g, sizeof(g));
