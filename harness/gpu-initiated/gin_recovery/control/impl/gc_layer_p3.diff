+// ---- the fence word and its lines ----
+// An ended (rank, inc) from launcher li (EXITED, FENCED): the word goes to max(word, inc + 1) when the lineage takes it.
+// The buddy's FENCED line and every survivor's window line come once per armed hold (gdakiCtrlLaFenceReport).
+static void gdakiCtrlLaFenceReport(struct gdakiCtrlLaLink* k, int peer, bool buddy, uint32_t (*cells)(void*, int, uint32_t*),
+                                   void* cellsArg) {
+  struct gdakiCtrlLaFence& f = k->fence[(size_t)peer];
+  if (!f.armed || !gdakiCtrlFencedIs(k->fencedPlus1[(size_t)peer], f.dead)) return;
+  if (buddy && !f.reported) {
+    f.reported = true;
+    gdakiCtrlLaSay(k->log, "GIN/RC: rank %d: rank %d (incarnation %u) fence FENCED (by %s from node %u)", k->me, peer, f.dead,
+                   k->endKind[(size_t)peer] == GL_K_EXITED ? "EXITED" : "FENCED", k->endNode[(size_t)peer]);
+  }
+  if (!f.windowSaid && cells != nullptr) {
+    f.windowSaid = true;
+    uint32_t unreadable = 0;
+    const uint32_t changed = cells(cellsArg, peer, &unreadable);
+    gdakiCtrlLaSay(k->log, "GIN/RC: rank %d: window check after the %s of rank %d: changed=%u cells "
+                   "against=snapshot_at_judgement unreadable=%u", k->me, k->endKind[(size_t)peer] == GL_K_EXITED ? "judgement" : "fence",
+                   peer,
+                   changed, unreadable);
+  }
