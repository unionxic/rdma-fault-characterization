+struct gdakiCtrlLaLog {
+  void (*fn)(void* arg, const char* line) = nullptr;
+  void* arg = nullptr;
+};
+__attribute__((format(printf, 2, 3))) static void gdakiCtrlLaSay(const struct gdakiCtrlLaLog& l, const char* fmt, ...) {
+  if (l.fn == nullptr) return;
+  char b[512];
+  va_list ap;
+  va_start(ap, fmt);
+  vsnprintf(b, sizeof(b), fmt, ap);
+  va_end(ap);
+  l.fn(l.arg, b);
+}
