+  uint64_t peer;         /* ((uint64_t)(rank & 0xffffff) << 32) | that rank's incarnation as paired */
+  uint64_t consumed;     /* ((uint64_t)gen << 32) | how many of that rank's record-QP messages the launcher consumed in
