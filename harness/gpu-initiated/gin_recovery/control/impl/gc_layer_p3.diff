+static bool gdakiCtrlLaPairedOwn(const struct gdakiCtrlLaLink* k) {
+  const struct glArmView v = gdakiCtrlLaArmViewOf(k);
+  return v.regAcked && v.regAckInc == v.inc && v.ownPaired && v.notedReg == GL_RS_ALIVE && v.notedInc == v.inc;
