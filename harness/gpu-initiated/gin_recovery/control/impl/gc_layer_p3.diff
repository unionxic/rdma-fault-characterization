+// One word for an errno (the lines' %s is a word without spaces).
+static const char* gdakiCtrlLaErrWord(int e) {
+  switch (e) {
+    case ECONNRESET: return "ECONNRESET";
+    case EPIPE: return "EPIPE";
+    case ENOTCONN: return "ENOTCONN";
+    case EBADF: return "EBADF";
+    case ENOBUFS: return "ENOBUFS";
+    default: return "error";
+  }
+}
+
+// ---- the Unix socket ----
+enum : int { GDAKI_CTRL_LA_ROLE_RANK = 1, GDAKI_CTRL_LA_ROLE_SPARE = 2 };
+struct gdakiCtrlLaUnix {
+  int fd = -1;
+  int role = 0;
+  int32_t rank = -1;
+  uint32_t inc = 0;            // the incarnation of the last REGISTER or SPARE_HELLO
+  uint64_t nonce = 0;
+  bool acked = false;          // a HELLO_ACK answered it
+  uint32_t ackStatus = GL_UA_REFUSED, ackReason = 0, ackInc = 0;
+  struct glUHelloAck ack;
+  bool leavingSent = false, readySent = false;
+  bool closed = false;         // EOF or an error (not this side's own close)
+  bool haveAct = false;        // GL_U_ACT_BYTES came
+  struct glRsActivate act;
+  std::vector<uint8_t> blob;
+  std::deque<struct glUnixMsg> talk;  // GL_U_ACT_TALK from the launcher (FETCH_READY, ABORT), oldest first
+  uint64_t sent = 0, received = 0;
+};
+// The socket path: NCCL_GIN_CTRL_LAUNCHER_SOCK, else the launcher's default ($XDG_RUNTIME_DIR/gin-launcher/launcher.sock,
+// else /tmp/gin-launcher-<uid>/launcher.sock; gl_default_sock_path). False: no room.
+static bool gdakiCtrlLaSockPath(char* out, size_t len) {
+  const char* e = getenv(GL_SOCK_ENV);
+  int n;
+  if (e != nullptr && *e) n = snprintf(out, len, "%s", e);
+  else {
+    const char* x = getenv("XDG_RUNTIME_DIR");
+    n = (x != nullptr && *x) ? snprintf(out, len, "%s/gin-launcher/launcher.sock", x)
+                             : snprintf(out, len, "/tmp/gin-launcher-%u/launcher.sock", (unsigned)getuid());
+  }
+  return n > 0 && (size_t)n < len && (size_t)n < sizeof(((struct sockaddr_un*)nullptr)->sun_path);
+}
+// The node number: NCCL_GIN_CTRL_LAUNCHER_NODE (the launcher's HELLO_ACK says its own; they must agree). -1: unset.
+static long gdakiCtrlLaNodeEnv() {
+  const char* e = getenv(GL_NODE_ENV);
+  if (e == nullptr || *e == '\0') return -1;
+  char* end = nullptr;
+  const long v = strtol(e, &end, 10);
+  return (end != nullptr && *end == '\0' && v >= 0 && v < (long)GL_FROM_LAUNCHER) ? v : -2;
+}
+// A spare's incarnation: NCCL_GIN_RESTORE_SPARE_INC (default 1). 0: not a valid value.
+static uint32_t gdakiCtrlLaSpareIncEnv() {
+  const char* e = getenv(GDAKI_CTRL_LA_SPARE_INC_ENV);
+  if (e == nullptr || *e == '\0') return 1u;
+  char* end = nullptr;
+  const unsigned long v = strtoul(e, &end, 10);
+  return (end != nullptr && *end == '\0' && v >= 1 && v < 0xffffffffUL) ? (uint32_t)v : 0u;
+}
+static void gdakiCtrlLaUnixMsgInit(struct glUnixMsg* m, uint16_t kind, int32_t rank, uint32_t inc, uint64_t nonce) {
+  memset(m, 0, sizeof(*m));
+  m->h.magic = GL_U_MAGIC;
+  m->h.version = (uint16_t)GL_WIRE_VERSION;
+  m->h.kind = kind;
+  m->h.rank = rank;
+  m->h.incarnation = inc;
+  m->h.nonce = nonce;
+  m->h.pid = (int64_t)getpid();
+  struct timespec ts;
+  clock_gettime(CLOCK_MONOTONIC, &ts);
+  m->h.monoNs = (uint64_t)ts.tv_sec * 1000000000ull + (uint64_t)ts.tv_nsec;
+}
+// Connect (SOCK_SEQPACKET, CLOEXEC; the connection then non-blocking) and watch it for fork. False with why.
+static bool gdakiCtrlLaUnixOpen(struct gdakiCtrlLaUnix* u, const char* path, char* why, size_t whyLen) {
+  const int fd = socket(AF_UNIX, SOCK_SEQPACKET | SOCK_CLOEXEC, 0);
+  if (fd < 0) {
+    snprintf(why, whyLen, "socket: %s", strerror(errno));
+    return false;
+  }
+  struct sockaddr_un a;
+  memset(&a, 0, sizeof(a));
+  a.sun_family = AF_UNIX;
+  snprintf(a.sun_path, sizeof(a.sun_path), "%s", path);
+  if (connect(fd, (struct sockaddr*)&a, sizeof(a)) != 0) {
+    snprintf(why, whyLen, "connect: %s", strerror(errno));
+    close(fd);
+    return false;
+  }
+  const int fl = fcntl(fd, F_GETFL, 0);
+  if (fl < 0 || fcntl(fd, F_SETFL, fl | O_NONBLOCK) != 0) {
+    snprintf(why, whyLen, "O_NONBLOCK: %s", strerror(errno));
+    close(fd);
+    return false;
+  }
+  u->fd = fd;
+  u->closed = false;
+  gdakiCtrlLaForkWatch(fd);
+  return true;
+}
+// One message (and an fd with SCM_RIGHTS, or -1). False: not sent (the connection is then closed).
+static bool gdakiCtrlLaUnixSend(struct gdakiCtrlLaUnix* u, const struct glUnixMsg* m, int passFd) {
+  if (u->fd < 0 || u->closed) return false;
+  struct iovec iov;
+  iov.iov_base = (void*)m;
+  iov.iov_len = sizeof(*m);
+  union {
+    char b[CMSG_SPACE(sizeof(int))];
+    struct cmsghdr align;
+  } cb;
+  struct msghdr mh;
+  memset(&mh, 0, sizeof(mh));
+  mh.msg_iov = &iov;
+  mh.msg_iovlen = 1;
+  if (passFd >= 0) {
+    memset(&cb, 0, sizeof(cb));
+    mh.msg_control = cb.b;
+    mh.msg_controllen = sizeof(cb.b);
+    struct cmsghdr* c = CMSG_FIRSTHDR(&mh);
+    c->cmsg_level = SOL_SOCKET;
+    c->cmsg_type = SCM_RIGHTS;
+    c->cmsg_len = CMSG_LEN(sizeof(int));
+    memcpy(CMSG_DATA(c), &passFd, sizeof(int));
+  }
+  for (int tries = 0; tries < 200; tries++) {  // a full socket: up to 200 ms
+    const ssize_t n = sendmsg(u->fd, &mh, MSG_NOSIGNAL);
+    if (n == (ssize_t)sizeof(*m)) {
+      u->sent++;
+      return true;
+    }
+    if (n < 0 && (errno == EAGAIN || errno == EWOULDBLOCK || errno == EINTR)) {
+      struct pollfd pf = {u->fd, POLLOUT, 0};
+      (void)poll(&pf, 1, 1);
+      continue;
+    }
+    break;
+  }
+  u->closed = true;
+  return false;
+}
+// REGISTER (a rank) or SPARE_HELLO (a spare, nonzero nonce) with this process's own pidfd. False with why.
+static bool gdakiCtrlLaUnixHello(struct gdakiCtrlLaUnix* u, int role, int32_t rank, uint32_t inc, uint64_t nonce, char* why,
+                                 size_t whyLen) {
+  if (rank < 0 || (role == GDAKI_CTRL_LA_ROLE_SPARE && (nonce == 0 || inc == 0))) {
+    snprintf(why, whyLen, "a %s needs a rank%s", role == GDAKI_CTRL_LA_ROLE_SPARE ? "spare HELLO" : "REGISTER",
+             role == GDAKI_CTRL_LA_ROLE_SPARE ? ", a nonzero nonce and an incarnation above 0" : "");
+    return false;
+  }
+  const int pidfd = (int)syscall(SYS_pidfd_open, getpid(), 0);
+  if (pidfd < 0) {
+    snprintf(why, whyLen, "pidfd_open: %s", strerror(errno));
+    return false;
+  }
+  struct glUnixMsg m;
+  gdakiCtrlLaUnixMsgInit(&m, role == GDAKI_CTRL_LA_ROLE_SPARE ? GL_U_SPARE_HELLO : GL_U_REGISTER, rank, inc, nonce);
+  const bool ok = gdakiCtrlLaUnixSend(u, &m, pidfd);
+  close(pidfd);  // the launcher holds its own copy
+  if (!ok) {
+    snprintf(why, whyLen, "the message could not be sent");
+    return false;
+  }
+  u->role = role;
+  u->rank = rank;
+  u->inc = inc;
+  u->nonce = nonce;
+  u->acked = false;
+  return true;
+}
+static bool gdakiCtrlLaUnixLeaving(struct gdakiCtrlLaUnix* u) {
+  if (u->leavingSent || u->role != GDAKI_CTRL_LA_ROLE_RANK) return u->leavingSent;
+  struct glUnixMsg m;
+  gdakiCtrlLaUnixMsgInit(&m, GL_U_LEAVING, u->rank, u->inc, u->nonce);
+  u->leavingSent = gdakiCtrlLaUnixSend(u, &m, -1);
+  return u->leavingSent;
+}
+// SPARE_STATUS: READY (replay, the FETCH buffer, the Resume entry done) or REPLAY_FAILED with why.
+static bool gdakiCtrlLaUnixStatus(struct gdakiCtrlLaUnix* u, bool ready, const char* why) {
+  struct glUnixMsg m;
+  gdakiCtrlLaUnixMsgInit(&m, GL_U_SPARE_STATUS, u->rank, u->inc, u->nonce);
+  m.h.sub = ready ? GL_US_READY : GL_US_REPLAY_FAILED;
+  if (why != nullptr) {
+    const int n = snprintf((char*)m.body, GL_U_BODY_BYTES, "%s", why);
+    m.h.bodyBytes = (uint16_t)std::min<int>(n + 1, (int)GL_U_BODY_BYTES);
+  }
+  const bool ok = gdakiCtrlLaUnixSend(u, &m, -1);
+  if (ok && ready) u->readySent = true;
+  return ok;
+}
+// ACT_TALK from the spare: ANSWER (64 B record), FETCH_EP (112 B), FETCH_DONE (80 B).
+static bool gdakiCtrlLaUnixTalk(struct gdakiCtrlLaUnix* u, uint32_t sub, const void* body, size_t len) {
+  if (len > GL_U_BODY_BYTES) return false;
+  struct glUnixMsg m;
+  gdakiCtrlLaUnixMsgInit(&m, GL_U_ACT_TALK, u->rank, u->inc, u->nonce);
+  m.h.sub = sub;
+  if (len) memcpy(m.body, body, len);
+  m.h.bodyBytes = (uint16_t)len;
+  return gdakiCtrlLaUnixSend(u, &m, -1);
+}
+// Read what is queued (non-blocking): HELLO_ACK, ACT_BYTES (record + blob), ACT_TALK. EOF or an error: closed, and the
+// line `launcher Unix socket closed (EOF|<errno name>)` once. Returns the messages taken.
+static int gdakiCtrlLaUnixPoll(struct gdakiCtrlLaUnix* u, const struct gdakiCtrlLaLog& log, int me) {
+  if (u->fd < 0 || u->closed) return 0;
+  int taken = 0;
+  std::vector<uint8_t> buf(sizeof(struct glUnixMsg) + GL_U_MAX_PAYLOAD);
+  for (;;) {
+    union {
+      char b[CMSG_SPACE(sizeof(int) * 4)];
+      struct cmsghdr align;
+    } cb;
+    struct iovec iov;
+    iov.iov_base = buf.data();
+    iov.iov_len = buf.size();
+    struct msghdr mh;
+    memset(&mh, 0, sizeof(mh));
+    mh.msg_iov = &iov;
+    mh.msg_iovlen = 1;
+    mh.msg_control = cb.b;
+    mh.msg_controllen = sizeof(cb.b);
+    const ssize_t n = recvmsg(u->fd, &mh, MSG_DONTWAIT | MSG_CMSG_CLOEXEC);
+    if (n < 0 && (errno == EAGAIN || errno == EWOULDBLOCK || errno == EINTR)) return taken;
+    for (struct cmsghdr* c = CMSG_FIRSTHDR(&mh); n > 0 && c != nullptr; c = CMSG_NXTHDR(&mh, c))  // no fd is expected
+      if (c->cmsg_level == SOL_SOCKET && c->cmsg_type == SCM_RIGHTS)
+        for (size_t j = 0; j < (c->cmsg_len - CMSG_LEN(0)) / sizeof(int); j++) {
+          int f;
+          memcpy(&f, CMSG_DATA(c) + j * sizeof(int), sizeof(int));
+          close(f);
+        }
+    if (n <= 0) {
+      u->closed = true;
+      gdakiCtrlLaSay(log, "GIN/RC: rank %d: launcher Unix socket closed (%s)", me, n == 0 ? "EOF" : gdakiCtrlLaErrWord(errno));
+      return taken;
+    }
+    const struct glUnixMsg* m = (const struct glUnixMsg*)buf.data();
+    if (gl_unix_check(m, (size_t)n) != GL_R_NONE) continue;
+    u->received++;
+    taken++;
+    switch (m->h.kind) {
+      case GL_U_HELLO_ACK:
+        memcpy(&u->ack, m->body, sizeof(u->ack));
+        u->ackStatus = u->ack.status;
+        u->ackReason = m->h.reason;
+        u->ackInc = m->h.incarnation;
+        u->acked = m->h.rank == u->rank && m->h.incarnation == u->inc && m->h.nonce == u->nonce;
+        break;
+      case GL_U_ACT_BYTES:
+        memcpy(&u->act, m->body, sizeof(u->act));
+        u->blob.assign(buf.data() + sizeof(struct glUnixMsg), buf.data() + sizeof(struct glUnixMsg) + m->h.payloadBytes);
+        u->haveAct = true;
+        break;
+      case GL_U_ACT_TALK:
+        u->talk.push_back(*m);
+        break;
+      default:
+        break;
+    }
+  }
+}
+// Wait up to ms for the socket to have something (the caller polls it then).
+static void gdakiCtrlLaUnixWait(const struct gdakiCtrlLaUnix* u, int ms) {
+  if (u->fd < 0 || u->closed) return;
+  struct pollfd pf = {u->fd, POLLIN, 0};
+  (void)poll(&pf, 1, ms);
+}
+static void gdakiCtrlLaUnixClose(struct gdakiCtrlLaUnix* u) {
+  if (u->fd >= 0) {
+    gdakiCtrlLaForkUnwatch(u->fd);
+    close(u->fd);
+  }
+  u->fd = -1;
+}
+
+// ---- the launchers' RNIC side: a transport table and one record QP pairing per launcher ----
+// li: the launcher's index (the communicator's launchers in node order). The host's table is the ring's (TODO(2a-2)); the
+// unit test's bridges to the launcher core's in-process transport. Every call returns 0 on success.
+struct gdakiCtrlLaTx {
+  void* arg = nullptr;
+  int (*udSend)(void* arg, int li, const struct glEp* to, uint32_t qkey, const struct glMsg* m) = nullptr;
+  int (*rcCreate)(void* arg, int li, uint32_t gen, struct glEp* local) = nullptr;  // INIT, RECVs posted, a fresh PSN
+  int (*rcConnect)(void* arg, int li, const struct glEp* remote) = nullptr;         // RTR, RTS
+  int (*rcSend)(void* arg, int li, const struct glMsg* m) = nullptr;
+};
+struct gdakiCtrlLaPeer {
+  uint32_t node = 0;
+  bool known = false;               // its UD endpoint and Q_Key are known (the own one's HELLO_ACK, or the all-gather)
+  struct glEp ud;
+  uint32_t qkey = 0;
+  struct glRegion page;
+  struct gdakiCtrlPairSt pair;      // the record QP's pairing (gin-control (ring)'s model; the launcher's `from`)
+  struct glEp local, remote;
+  bool connected = false, qpErr = false;
+  std::vector<struct glRegNoteBody> note;  // by rank: the launcher's latest REG_NOTE
