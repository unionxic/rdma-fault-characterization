+// The blob's place in this rank's outbox (the launcher READs it from there). TODO(2a-2): the ring's outbox half
+// (gdakiCtrlRdmaOutboxRegion, REMOTE_READ; the half is this activation's until its answer); without the ring there is no
+// outbox and the activation through the launcher cannot go.
+static bool gdakiCtrlLaOutboxPut(struct gdakiRecHost* r, const std::vector<uint8_t>& bytes, struct glRegion* out,
+                                 uint64_t* xferId) {
+  (void)r;
+  memset(out, 0, sizeof(*out));
+  *xferId = 0;
