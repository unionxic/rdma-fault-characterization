+// The responder counts of the QPs toward `peer` (one QUERY per QP: the hold start's firmware phase), the window line's
+// cells. *ok: per QP, readable.
+static void gdakiCtrlLaCells(struct gdakiRecHost* r, int peer, std::vector<uint32_t>* v, std::vector<uint8_t>* ok) {
+  v->clear();
+  ok->clear();
+  gdakiRecForPeer(r, peer, [&](gdakiRecQp&, struct doca_gpu_verbs_qp_hl* q) {
+    uint32_t s = 0;
+    const bool good = doca_verbs_qp_query_seq(q->qp, &s, nullptr, nullptr, nullptr) == DOCA_SUCCESS;
+    v->push_back(s);
+    ok->push_back(good ? 1 : 0);
+  });
+}
+// The window line's count (gdakiCtrlLaFenceReport): the QPs toward `peer` whose responder count moved since this rank's
+// hold start (the snapshot at the judgement), and the ones that could not be read either time.
+static uint32_t gdakiCtrlLaCellsChanged(void* arg, int peer, uint32_t* unreadable) {
+  struct gdakiCtrlLauncher* L = (struct gdakiCtrlLauncher*)arg;
+  std::vector<uint32_t> now;
+  std::vector<uint8_t> ok;
+  gdakiCtrlLaCells(L->r, peer, &now, &ok);
+  uint32_t changed = 0, bad = 0;
+  const std::vector<uint32_t>& s = L->snap[(size_t)peer];
+  const std::vector<uint8_t>& sOk = L->snapOk[(size_t)peer];
+  for (size_t i = 0; i < now.size(); i++) {
+    if (i >= s.size() || !sOk[i] || !ok[i]) bad++;
+    else if (now[i] != s[i]) changed++;
+  }
+  *unreadable = bad;
+  return changed;
+}
+// The latch (phase 1's gdakiCtrlLauncherPairedLatch): once the own launcher is paired and holds this incarnation.
+static void gdakiCtrlLaLatchStep(struct gdakiCtrlLauncher* L) {
+  if (L->k.latched || !gdakiCtrlLaPairedOwn(&L->k)) return;
+  L->k.latched = true;
+  gdakiCtrlLauncherPairedLatch(L->r);
+  gdakiCtrlLaSay(L->k.log, "GIN/RC: rank %d: paired with the launcher of node %u, which holds incarnation %u: the "
+                 "activation gate requires FENCED", L->k.me, L->k.la[(size_t)L->k.own].node, L->k.inc);
+}
+// REGISTER (a rank) or SPARE_HELLO (a spare) and its answer within 1000 ms (the setup thread; the launcher is the
+// node's, always up during a hold). The own launcher becomes launcher 0.
+static void gdakiCtrlLaRegister(struct gdakiCtrlLauncher* L, int role, uint32_t inc) {
+  struct gdakiCtrlLaLink& k = L->k;
+  char why[160] = {0};
+  if (k.unix.fd < 0) {
+    char path[sizeof(((struct sockaddr_un*)nullptr)->sun_path)];
+    if (!gdakiCtrlLaSockPath(path, sizeof(path))) snprintf(why, sizeof(why), "the socket path is too long");
+    else (void)gdakiCtrlLaUnixOpen(&k.unix, path, why, sizeof(why));
+  }
+  if (k.unix.fd >= 0 && gdakiCtrlLaUnixHello(&k.unix, role, k.me, inc, k.nonce, why, sizeof(why))) {
+    const double end = gdakiQ4MonoMs() + 1000.0;
+    while (!k.unix.acked && !k.unix.closed && gdakiQ4MonoMs() < end) {
+      gdakiCtrlLaUnixWait(&k.unix, 10);
+      (void)gdakiCtrlLaUnixPoll(&k.unix, k.log, k.me);
+    }
+    if (!k.unix.acked) snprintf(why, sizeof(why), "no answer from the launcher in 1000 ms");
+    else if (k.unix.ackStatus != GL_UA_OK) snprintf(why, sizeof(why), "refused: %s", gl_reason_text(k.unix.ackReason));
+  }
+  const long envNode = gdakiCtrlLaNodeEnv();
+  if (why[0] == '\0' && envNode >= 0 && (uint32_t)envNode != k.unix.ack.node)
+    snprintf(why, sizeof(why), "%s=%ld but the launcher on the socket is node %u", GL_NODE_ENV, envNode, k.unix.ack.node);
+  if (why[0] != '\0') {
+    L->registered = false;
+    WARN("GIN/RC: rank %d: %s of incarnation %u at the node's launcher failed (%s): no launcher path, this rank is not armed "
+         "mono_ms=%.3f", k.me, role == GDAKI_CTRL_LA_ROLE_SPARE ? "spare HELLO" : "REGISTER", inc, why, gdakiQ4MonoMs());
+    return;
+  }
+  L->registered = true;
+  k.own = gdakiCtrlLaAddLauncher(&k, k.unix.ack.node, k.unix.ack.ud, k.unix.ack.qkey, k.unix.ack.page);
+  gdakiCtrlLaSetRankNode(&k, k.me, k.unix.ack.node);
+  gdakiCtrlLaSay(k.log, "GIN/RC: rank %d: %s incarnation %u at the launcher of node %u (page slot %u)", k.me,
+                 role == GDAKI_CTRL_LA_ROLE_SPARE ? "spare said HELLO as" : "registered", inc, k.unix.ack.node,
+                 k.unix.ack.pageSlot);
+}
+static void gdakiCtrlLauncherSetup(struct gdakiRecHost* r) {
+  if (r == nullptr || r->ctrl == nullptr || r->ts == nullptr || r->ctx == nullptr || r->ctrl->launcher != nullptr) return;
+  const struct gdakiRsCfg& c = gdakiRsProc();
+  if (!c.requested) return;  // no restore asked: no launcher
+  struct gdakiCtrlLauncher* L = new gdakiCtrlLauncher();
+  L->r = r;
+  struct gdakiCtrlLaLink& k = L->k;
+  const bool spare = c.spare >= 0;
+  const uint32_t inc = spare ? gdakiCtrlLaSpareIncEnv() : gdakiRsSelfInc(r);
+  // TODO(2a-2): the all-gather's launcher count and every rank's launcher node (gdakiCtrlLaSetRankNode), the other
+  // launchers' UD endpoints (gdakiCtrlLaAddLauncher); this rank's UD endpoint, page and creditOff (k.ud, k.page,
+  // k.creditOff0) from the ring. Until then only the own launcher is known and nLaunchers stays 0 (never all paired).
+  gdakiCtrlLaInit(&k, r->ctx->rank, r->nranks, inc, r->ts->nonce, 0);
+  k.log.fn = gdakiCtrlLaNote;
+  k.lnOk = gdakiCtrlLaLnOk;
+  k.lnArg = r;
+  k.tx.arg = r;
+  k.tx.udSend = gdakiCtrlLaTxUd;
+  k.tx.rcCreate = gdakiCtrlLaTxCreate;
+  k.tx.rcConnect = gdakiCtrlLaTxConnect;
+  k.tx.rcSend = gdakiCtrlLaTxSend;
+  k.pairOk = !spare;  // a spare pairs as the new incarnation after its activation (gdakiCtrlLaSpareDone)
+  k.laterMs = (double)ncclParamGinCtrlLaterMs();
+  k.stallMs = (double)ncclParamGinCtrlLauncherStallMs();
+  L->snap.assign((size_t)r->nranks, std::vector<uint32_t>());
+  L->snapOk.assign((size_t)r->nranks, std::vector<uint8_t>());
+  if (spare && inc == 0) {
+    WARN("GIN/RC: rank %d: %s is not an incarnation above 0: the spare says no HELLO mono_ms=%.3f", k.me,
+         GDAKI_CTRL_LA_SPARE_INC_ENV, gdakiQ4MonoMs());
+  } else {
+    gdakiCtrlLaRegister(L, spare ? GDAKI_CTRL_LA_ROLE_SPARE : GDAKI_CTRL_LA_ROLE_RANK, inc);
+  }
+  r->ctrl->launcher = L;
+}
+// The helper's step (gdakiTsMain): the socket (its loss: the line), the pairings' clock, the latch, the buddy's FETCH QP.
+static void gdakiCtrlLauncherStep(struct gdakiRecHost* r) {
+  struct gdakiCtrlLauncher* L = gdakiCtrlLaOf(r);
+  if (L == nullptr) return;
+  std::lock_guard<std::mutex> lk(L->mu);
+  const double now = gdakiQ4MonoMs();
+  (void)gdakiCtrlLaUnixPoll(&L->k.unix, L->k.log, L->k.me);
+  gdakiCtrlLaPairTick(&L->k, now);
+  gdakiCtrlLaLatchStep(L);
+  if (L->fetchDoneSock >= 0 && L->fetchDonePeer >= 0) {  // FETCH_DONE through the launcher: to the FETCH waiter
+    struct gdakiCtrlLaAct& a = L->k.act[(size_t)L->fetchDonePeer];
+    if (a.haveDone) {
+      (void)send(L->fetchDoneSock, a.done, sizeof(a.done), MSG_NOSIGNAL | MSG_DONTWAIT);
+      a.haveDone = false;
+      close(L->fetchDoneSock);
+      L->fetchDoneSock = -1;
+      L->fetchDonePeer = -1;
+    }
+  }
+}
+// [2a-2 calls it] an envelope from a launcher.
+static void gdakiCtrlLauncherOnEnvelope(struct gdakiRecHost* r, const struct gdakiCtrlEnv* e, const void* body, bool ud) {
+  struct gdakiCtrlLauncher* L = gdakiCtrlLaOf(r);
+  if (L == nullptr || e == nullptr || body == nullptr || (e->from & GDAKI_CTRL_FROM_LAUNCHER) == 0) return;
+  std::lock_guard<std::mutex> lk(L->mu);
+  struct glMsg m;
+  memcpy(&m, body, sizeof(m));
+  const double now = gdakiQ4MonoMs();
+  if (ud) {
+    gdakiCtrlLaOnUd(&L->k, m, now);
+  } else {
+    const int li = gdakiCtrlLaIndexOfNode(&L->k, (uint32_t)e->from & ~(uint32_t)GDAKI_CTRL_FROM_LAUNCHER);
+    gdakiCtrlLaOnRc(&L->k, li, m, now);
+    if (li >= 0 && (m.h.kind == GL_K_EXITED || m.h.kind == GL_K_FENCED) && m.h.rank >= 0 && m.h.rank < L->k.nranks) {
+      const int p = m.h.rank;
+      gdakiLnFenced(r, p, m.h.incarnation);  // phase 1's page copy of the word (the report)
+      gdakiCtrlLaFenceReport(&L->k, p, gdakiHoldBuddyOf(p, L->k.nranks) == L->k.me, gdakiCtrlLaCellsChanged, L);
+    }
+  }
+  gdakiCtrlLaLatchStep(L);
+}
+static void gdakiCtrlLauncherLeaving(struct gdakiRecHost* r) {
+  struct gdakiCtrlLauncher* L = gdakiCtrlLaOf(r);
+  if (L == nullptr) return;
+  std::lock_guard<std::mutex> lk(L->mu);
+  L->k.leaving = true;
+  if (L->registered && gdakiCtrlLaUnixLeaving(&L->k.unix))
+    GIN_TS_NOTE("GIN/RC: rank %d: LEAVING (incarnation %u) to the launcher of node %u mono_ms=%.3f", L->k.me, L->k.inc,
+                L->k.own >= 0 ? L->k.la[(size_t)L->k.own].node : 0u, gdakiQ4MonoMs());
+}
+static bool gdakiCtrlLaHaveSpare(struct gdakiRecHost* r) {
+  struct gdakiCtrlLauncher* L = gdakiCtrlLaOf(r);
+  if (L == nullptr) return false;
+  std::lock_guard<std::mutex> lk(L->mu);
+  gdakiCtrlLaLatchStep(L);
+  return gdakiCtrlLaPathExists(&L->k);
+}
+static void gdakiCtrlLaSpareRegFill(struct gdakiRecHost* r, void* out32) {
+  struct gdakiCtrlLaSpareReg g;
+  memset(&g, 0, sizeof(g));
+  struct gdakiCtrlLauncher* L = gdakiCtrlLaOf(r);
+  if (L != nullptr) {
+    std::lock_guard<std::mutex> lk(L->mu);
+    g.magic = GDAKI_CTRL_LA_SPAREREG_MAGIC;
+    g.version = GDAKI_CTRL_LA_SPAREREG_VERSION;
+    g.path = GDAKI_CTRL_LA_PATH_LAUNCHER;
+    g.node = L->k.own >= 0 ? L->k.la[(size_t)L->k.own].node : 0u;
+    g.rank = L->k.me;
+    g.inc = L->k.inc;
+    g.flags = gdakiCtrlLaPathExists(&L->k) ? GDAKI_CTRL_LA_REG_F_PATH : 0u;
+  }
+  memcpy(out32, &g, sizeof(g));
+}
+static bool gdakiCtrlLaSpareRegCheck(struct gdakiRecHost* r, const void* reg32, int peer, uint32_t dead, char* why,
+                                     size_t whyLen) {
+  struct gdakiCtrlLaSpareReg g;
+  memcpy(&g, reg32, sizeof(g));
+  if (!gdakiCtrlLaSpareRegOk(g, peer, dead)) {
+    snprintf(why, whyLen, "the peer's registration is not a launcher path of incarnation %u (magic %08x, flags %u)", dead,
+             g.magic, g.flags);
+    return false;
+  }
+  struct gdakiCtrlLauncher* L = gdakiCtrlLaOf(r);
+  if (L == nullptr) {
+    snprintf(why, whyLen, "this rank has no launcher link");
+    return false;
+  }
+  std::lock_guard<std::mutex> lk(L->mu);
+  if (gdakiCtrlLaIndexOfNode(&L->k, g.node) < 0) {
+    snprintf(why, whyLen, "this rank is not paired with the launcher of node %u", g.node);
+    return false;
+  }
+  gdakiCtrlLaSetRankNode(&L->k, peer, g.node);
+  return true;
+}
+// [3] the hold start's hook (every survivor, after gdakiCtrlPeerToErr): the fence of (peer, inc) armed, the snapshot of
+// the window line's cells, and at the buddy SPAWN (decision 12; its REFUSED is a line only). A word that already says
+// FENCED (EXITED before the hold start) gives the buddy's FENCED line now.
+static void gdakiCtrlOnHoldStart(struct gdakiRecHost* r, int peer, uint32_t inc) {
+  struct gdakiCtrlLauncher* L = gdakiCtrlLaOf(r);
+  if (L == nullptr || peer < 0 || peer >= L->k.nranks) return;
+  std::lock_guard<std::mutex> lk(L->mu);
+  gdakiCtrlLaCells(r, peer, &L->snap[(size_t)peer], &L->snapOk[(size_t)peer]);
+  gdakiCtrlLaFenceArm(&L->k, peer, inc);
+  const bool buddy = gdakiHoldBuddyOf(peer, L->k.nranks) == L->k.me;
+  if (buddy) gdakiCtrlLaSpawn(&L->k, peer, inc + 1u);
+  gdakiCtrlLaFenceReport(&L->k, peer, buddy, gdakiCtrlLaCellsChanged, L);
+}
+static int gdakiCtrlLauncherSend(struct gdakiRecHost* r, int node, const void* msg, size_t bytes) {
+  struct gdakiCtrlLauncher* L = gdakiCtrlLaOf(r);
+  if (L == nullptr || msg == nullptr || bytes != sizeof(struct glMsg) || node < 0) return -1;
+  std::lock_guard<std::mutex> lk(L->mu);
+  struct glMsg m;
+  memcpy(&m, msg, sizeof(m));
+  return gdakiCtrlLaSendTo(&L->k, gdakiCtrlLaIndexOfNode(&L->k, (uint32_t)node), &m);
+}
+// The buddy's fence step (gdakiCtrlActFenceOk, once every HOLDING is in).
+static int gdakiCtrlLaFenceStep(struct gdakiRecHost* r, int peer, uint32_t dead, uint64_t* word) {
+  struct gdakiCtrlLauncher* L = gdakiCtrlLaOf(r);
+  *word = GDAKI_CTRL_FENCE_NONE;
+  if (L == nullptr || peer < 0 || peer >= L->k.nranks) return -1;
+  std::lock_guard<std::mutex> lk(L->mu);
+  const int f = gdakiCtrlLaFence(&L->k, peer, dead, gdakiQ4MonoMs(), true);
+  *word = L->k.fencedPlus1[(size_t)peer];
+  struct gdakiCtrlPage* pg = gdakiPageOf(r);  // phase 1's report of the fence (gdakiLnFenceOf's fenceSent)
+  if (pg != nullptr && peer < (int)pg->peers.size()) pg->peers[(size_t)peer].fenceSent = L->k.fence[(size_t)peer].sent;
+  if (f > 0) gdakiCtrlLaFenceReport(&L->k, peer, true, gdakiCtrlLaCellsChanged, L);
+  if (f < 0 && L->k.fence[(size_t)peer].nak)
+    gdakiCtrlLaSay(L->k.log, "GIN/RC: rank %d: rank %d (incarnation %u) fence FENCE_NAK from node %u: nothing held, "
+                   "falling back", L->k.me, peer, dead,
+                   L->k.laOf[(size_t)peer] >= 0 ? L->k.la[(size_t)L->k.laOf[(size_t)peer]].node : 0u);
+  return f;
+}
+// r->ctrl->launcher (gdakiCtrlFree, after the helper and the watch thread stopped).
+static void gdakiCtrlLauncherFree(struct gdakiRecHost* r) {
+  struct gdakiCtrlLauncher* L = gdakiCtrlLaOf(r);
+  if (L == nullptr) return;
+  gdakiCtrlLaRelayEnd(&L->relay);
+  gdakiCtrlLaUnixClose(&L->k.unix);
+  if (L->fetchDoneSock >= 0) close(L->fetchDoneSock);
+  delete L;
+  r->ctrl->launcher = nullptr;
+}
