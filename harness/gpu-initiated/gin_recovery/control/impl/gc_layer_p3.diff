+static bool gdakiCtrlLaPairSend(struct gdakiCtrlLaLink* k, int li, uint32_t gen) {
+  struct gdakiCtrlLaPeer& p = k->la[(size_t)li];
+  struct glMsg m;
+  gdakiCtrlLaMsgInit(k, &m, GL_K_PAIR, k->me, k->inc, p.node);
+  m.h.sub = GL_PAIR_RECORD;
+  struct glPairBody b;
+  gdakiCtrlLaPairBody(k, li, gen, &b);
+  memcpy(m.body, &b, sizeof(b));
+  m.h.bodyBytes = (uint16_t)sizeof(b);
+  return k->tx.udSend != nullptr && k->tx.udSend(k->tx.arg, li, &p.ud, p.qkey, &m) == 0;
