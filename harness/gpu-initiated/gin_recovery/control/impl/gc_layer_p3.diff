+static void gdakiCtrlLaActivateSend(struct gdakiRecHost* r, int peer, const struct gdakiRsActivate& a0, uint32_t dead,
+                                    double now) {
+  struct gdakiHold* h = gdakiHoldOf(r);
+  struct gdakiHoldPeer& hp = h->peers[peer];
+  struct gdakiCtrlLauncher* L = gdakiCtrlLaOf(r);
+  if (L == nullptr) return gdakiHoldFallback(r, peer, "this rank has no launcher link");
+  const bool mi = gdakiStoreActV2(r);  // gin-control (store) [2], decision 7: activation v2 (store blob, FETCH)
+  std::unique_lock<std::mutex> lk(L->mu);
+  struct gdakiCtrlLaAct& st = L->k.act[(size_t)peer];
+  char w[256] = {0};
+  if (st.state == GDAKI_CTRL_LA_ACT_NONE || st.inc != dead + 1u) {  // this activation's first step: ACTIVATE
+    struct gdakiRsActivate a = a0;
+    a.pid = 0;  // the launcher holds the pidfd; the record carries FENCED instead
+    a.pidStart = 0;
+    a.reserved = gdakiCtrlLaActFencedMark(a.incarnation);
+    std::vector<uint8_t> bytes;
+    if (mi) {
+      lk.unlock();
+      gdakiTsBusy busy(r->ts);
+      const int dr = gdakiMiDrainStep(r, peer, dead, a.step, w, sizeof(w));
+      if (dr < 0) return gdakiHoldFallback(r, peer, w);
+      if (dr > 0) return;  // not drained yet: the next helper step
+      const struct gdakiMiActBlob* blob = gdakiMiActBlobFor(r, peer, dead, a, w, sizeof(w));
+      if (blob == nullptr || !gdakiMiActBlobEncode(blob->hdr, blob->addr, blob->ext, &bytes)) {
+        gdakiMiActEnd(r, peer);
+        return gdakiHoldFallback(r, peer, blob == nullptr ? w : "the activation blob could not be encoded");
+      }
+      a.version = GDAKI_RS_ACT_VERSION_MI;
+      lk.lock();
+    }
+    struct glRegion blobAt;
+    uint64_t xferId = 0;
+    struct glRsActivate rec;
+    static_assert(sizeof(rec) == sizeof(a), "the activation record is launcher_msg.h's");
+    memcpy(&rec, &a, sizeof(rec));
+    if (!gdakiCtrlLaOutboxPut(r, bytes, &blobAt, &xferId) || !gdakiCtrlLaActStart(&L->k, peer, rec, blobAt, xferId, now)) {
+      lk.unlock();
+      if (mi) gdakiMiActEnd(r, peer);
+      return gdakiHoldFallback(r, peer, "no launcher path for the peer's activation (TODO(2a-2): the ring and its outbox)");
+    }
+    hp.activateLater = 0;
+    hp.firstLaterMs = 0;
+    return;  // the answer comes in a later step (event based: no asking again, design v3 5.4 4)
+  }
+  const int nLaterBefore = hp.activateLater;
+  const int s = gdakiCtrlLaActStep(&L->k, peer, now, w, sizeof(w));
+  hp.activateLater = st.nLater > 0 ? 1 : 0;
+  if (st.nLater > 0) hp.firstLaterMs = st.laterMs;
+  if (s == GDAKI_CTRL_LA_AS_WAIT) {
+    if (hp.activateLater > nLaterBefore)
+      WARN("GIN/RS: rank %d: rank %d's spare answered 'later' through the launcher of node %u (replaying for %u ms); "
+           "waiting at most %.0f ms for its READY mono_ms=%.3f", h->rank, peer, L->k.la[(size_t)st.li].node, st.spareAgeMs,
+           L->k.laterMs, now);
+    return;
+  }
+  if (s == GDAKI_CTRL_LA_AS_FALLBACK) {
+    lk.unlock();
+    if (mi) gdakiMiActEnd(r, peer);
+    return gdakiHoldFallback(r, peer, w);
+  }
+  if (mi && st.state == GDAKI_CTRL_LA_ACT_ACCEPTED) {  // the FETCH handshake: the spare's endpoint, this rank's READY
+    if (!st.haveEp) {
+      if (now - st.acceptedMs < 1000.0) return;  // the spare's FETCH endpoint within 1000 ms (as the TCP path)
+      snprintf(w, sizeof(w), "no FETCH endpoint from the spare");
+    }
+    struct gdakiMiSparePeer* sp = gdakiMiActSeq(r, peer, dead);
+    struct gdakiMiActAnswer an;
+    memset(&an, 0, sizeof(an));
+    if (st.haveEp) memcpy(&an, st.ep, sizeof(an));
+    struct gdakiMiActReady rd;
+    memset(&rd, 0, sizeof(rd));
+    rd.magic = GDAKI_MI_ACTB_MAGIC;
+    if (w[0] != '\0') {
+    } else if (an.magic != GDAKI_MI_ACTB_MAGIC || an.ok != 1) {
+      an.why[sizeof(an.why) - 1] = '\0';
+      snprintf(w, sizeof(w), "no FETCH endpoint from the spare%s%.100s", an.magic == GDAKI_MI_ACTB_MAGIC ? ": " : "",
+               an.magic == GDAKI_MI_ACTB_MAGIC ? an.why : "");
+    } else if (sp == nullptr || sp->fetchQp == nullptr) {
+      snprintf(w, sizeof(w), "no FETCH QP of this rank for the peer");
+    } else if (gdakiMiHostQpConnect(sp->fetchQp, an.fetch, w, sizeof(w)) == ncclSuccess) {
+      rd.kind = GDAKI_MI_ACT_READY;
+    }
+    if (rd.kind != GDAKI_MI_ACT_READY) {
+      rd.kind = GDAKI_MI_ACT_FAIL;
+      snprintf(rd.why, sizeof(rd.why), "%.63s", w);
+      (void)gdakiCtrlLaFetchReady(&L->k, peer, &rd);
+      lk.unlock();
+      WARN("GIN/MI: rank %d: rank %d's spare accepted its activation but the FETCH handshake failed (%s) mono_ms=%.3f",
+           h->rank, peer, w, gdakiQ4MonoMs());
+      gdakiMiActEnd(r, peer);
+      return gdakiHoldFallback(r, peer, "the peer's spare accepted its activation but the FETCH handshake failed");
+    }
+    if (!gdakiCtrlLaFetchReady(&L->k, peer, &rd)) {
+      lk.unlock();
+      gdakiMiActEnd(r, peer);
+      return gdakiHoldFallback(r, peer, "READY could not be sent to the peer's spare through its launcher");
+    }
+    // the FETCH QP to the waiter (gin-mirror's, unchanged): it reads the spare's DONE on a socketpair whose other end
+    // this rank's launcher step fills from FETCH_DONE
+    struct gdakiMiSpareState* ms = gdakiMiSpareOf(r);
+    int sv[2];
+    if (ms != nullptr && socketpair(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0, sv) == 0) {
+      if (ms->waiter.joinable()) {
+        ms->waiterStop.store(true, std::memory_order_release);
+        ms->waiter.join();
+      }
+      ms->waiterStop.store(false, std::memory_order_release);
+      struct gdakiMiHostQp* qp = sp->fetchQp;
+      sp->fetchQp = nullptr;
+      if (L->fetchDoneSock >= 0) close(L->fetchDoneSock);
+      L->fetchDoneSock = sv[1];
+      L->fetchDonePeer = peer;
+      const double wDeadline = gdakiQ4MonoMs() + (double)std::max(1000, gdakiHoldLeftMs(r, peer));
+      ms->waiter = std::thread(gdakiMiFetchWait, ms, h->rank, peer, sv[0], qp, wDeadline);
+    }
+    GIN_TS_NOTE("GIN/MI: rank %d: rank %d's spare is READY to FETCH checkpoint %lu through the launcher of node %u "
+                "mono_ms=%.3f", h->rank, peer, (unsigned long)a0.step, L->k.la[(size_t)st.li].node, gdakiQ4MonoMs());
+  }
+  hp.holders.activated = true;
+  WARN("GIN/RS: rank %d: every survivor holds rank %d: its spare activated (incarnation %u, %.1f ms after this rank's "
+       "hold start), %d 'later' answers over %.1f ms mono_ms=%.3f", h->rank, peer, a0.incarnation, now - hp.holdStartMs,
+       hp.activateLater, hp.activateLater > 0 ? now - hp.firstLaterMs : 0.0, gdakiQ4MonoMs());
+}
