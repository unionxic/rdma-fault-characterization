+static void gdakiCtrlLaOnEnded(struct gdakiCtrlLaLink* k, int li, const struct glMsg& m) {
+  const int p = m.h.rank;
+  if (p < 0 || p >= k->nranks || m.h.kind == GL_K_LEFT) return;  // LEFT is a leave, never a fence
+  const uint32_t inc = m.h.incarnation;
+  if (k->lnOk != nullptr && !k->lnOk(k->lnArg, p, inc)) {
+    gdakiCtrlLaSay(k->log, "GIN/LN: rank %d: %s of rank %d incarnation %u from node %u is not this lineage's (FUTURE or "
+                   "STALE): the fence word stays", k->me, m.h.kind == GL_K_EXITED ? "EXITED" : "FENCED", p, inc,
+                   k->la[(size_t)li].node);
+    return;
+  }
+  const uint64_t w = gdakiCtrlFenceWord(inc);
+  if (w <= k->fencedPlus1[(size_t)p]) return;
+  k->fencedPlus1[(size_t)p] = w;
+  k->endKind[(size_t)p] = m.h.kind;
+  k->endNode[(size_t)p] = k->la[(size_t)li].node;
+}
