+static_assert(sizeof(struct glCtrlEnv) == sizeof(struct gdakiCtrlEnv) && GL_ENV_MAGIC == GDAKI_CTRL_ENV_MAGIC &&
+                  GL_FROM_LAUNCHER == GDAKI_CTRL_FROM_LAUNCHER && (int)GL_ENV_KIND_LAUNCHER == (int)GDAKI_CTRL_K_LAUNCHER,
+              "the launcher's envelope is the ctrl API's");
+static_assert(sizeof(struct glEp) == sizeof(struct gdakiCtrlEndpoint) && sizeof(struct glRsActivate) == 64 &&
+                  sizeof(struct glMsg) == GDAKI_CTRL_LAUNCHER_BYTES,
