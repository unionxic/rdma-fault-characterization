+// ---- the spare ----
+// READY to its launcher, then its ACTIVATE (the launcher hands it over only after READY), checked: the record (this
+// communicator, this rank, the HELLO's incarnation, FENCED carried) and, mirror or store on, the blob as today's reader
+// takes it (gdakiMiActRecv on a socketpair holding the blob). ACCEPTED or REFUSED back as ACT_TALK ANSWER; after ACCEPTED
+// *actFd is the FETCH talk's end (the relay moves it through the launcher). activated: 0; else the spare gives up.
+static ncclResult_t gdakiCtrlLaSpareWait(struct gdakiRecHost* r, int waitMs, bool mi, struct gdakiRsActivate* act,
+                                         int* actFd, struct gdakiMiActBlob* blob) {
+  *actFd = -1;
+  struct gdakiCtrlLauncher* L = gdakiCtrlLaOf(r);
+  const int rank = r->ctx->rank;
+  if (L == nullptr || !L->registered || L->k.unix.role != GDAKI_CTRL_LA_ROLE_SPARE) {
+    WARN("GIN/RS: spare rank %d: no HELLO at the node's launcher: no activation can come mono_ms=%.3f", rank, gdakiQ4MonoMs());
+    return ncclSystemError;
+  }
+  std::unique_lock<std::mutex> lk(L->mu);
+  struct gdakiCtrlLaUnix& u = L->k.unix;
+  if (!gdakiCtrlLaUnixStatus(&u, true, nullptr)) {
+    WARN("GIN/RS: spare rank %d: READY could not be sent to the launcher mono_ms=%.3f", rank, gdakiQ4MonoMs());
+    return ncclSystemError;
+  }
+  GIN_TS_NOTE("GIN/RS: spare rank %d: READY (incarnation %u) to the launcher of node %u; waiting for the activation "
+              "mono_ms=%.3f", rank, u.inc, u.ack.node, gdakiQ4MonoMs());
+  const double deadline = gdakiQ4MonoMs() + waitMs;
+  while (!u.haveAct && !u.closed && gdakiQ4MonoMs() < deadline) {
+    lk.unlock();
+    gdakiCtrlLaUnixWait(&u, 100);
+    lk.lock();
+    (void)gdakiCtrlLaUnixPoll(&u, L->k.log, rank);
+  }
+  if (!u.haveAct) {
+    WARN("GIN/RS: spare rank %d: no ACTIVATE from the launcher within %d ms%s mono_ms=%.3f", rank, waitMs,
+         u.closed ? " (its socket closed)" : "", gdakiQ4MonoMs());
+    return ncclSystemError;
+  }
+  u.haveAct = false;
+  memcpy(act, &u.act, sizeof(*act));
+  char why[192] = {0};
+  int code = gdakiCtrlLaSpareCheck(u.act, rank, r->ts->nonce, u.inc);
+  if (code != 0) snprintf(why, sizeof(why), "%s", gdakiCtrlLaSpareCheckText(code));
+  if (code == 0 && (mi || act->version == GDAKI_RS_ACT_VERSION_MI)) {
+    const int bfd = gdakiCtrlLaBlobFd(u.blob);
+    code = bfd < 0 ? 3 : gdakiMiActRecv(r, bfd, *act, gdakiQ4MonoMs() + 500.0, blob, why, sizeof(why));
+    if (bfd < 0) snprintf(why, sizeof(why), "the activation blob could not be read");
+    else close(bfd);
+  }
+  struct gdakiRsActivate ans = *act;
+  ans.kind = code == 0 ? (uint32_t)GDAKI_RS_ACT_ACCEPTED : (uint32_t)GDAKI_RS_ACT_REFUSED;
+  const bool sent = gdakiCtrlLaUnixTalk(&u, GL_UT_ANSWER, &ans, sizeof(ans));
+  if (code != 0 || !sent) {
+    WARN("GIN/RS: spare rank %d: activation refused (%s) mono_ms=%.3f", rank, code != 0 ? why : "the answer could not be sent",
+         gdakiQ4MonoMs());
+    return ncclSystemError;
+  }
+  WARN("GIN/RS: spare rank %d: activating incarnation %u from step %llu (through the launcher of node %u: FENCED carried) "
+       "mono_ms=%.3f", rank, act->incarnation, (unsigned long long)act->step, u.ack.node, gdakiQ4MonoMs());
+  if (mi && !gdakiCtrlLaRelayStart(&L->relay, &u, L->k.log, rank, actFd)) {
+    WARN("GIN/RS: spare rank %d: the FETCH relay could not start mono_ms=%.3f", rank, gdakiQ4MonoMs());
+    return ncclSystemError;
+  }
+  return ncclSuccess;
+}
+// After the FETCH (or its failure): the relay ends; on success this process registers as the new incarnation (the
+// launcher swaps the rank's pidfd: design v3 5.4 7) and its re-arming waits for that and for both launchers' pairings.
+static void gdakiCtrlLaSpareDone(struct gdakiRecHost* r, bool ok) {
+  struct gdakiCtrlLauncher* L = gdakiCtrlLaOf(r);
+  if (L == nullptr) return;
+  gdakiCtrlLaRelayEnd(&L->relay);
+  if (!ok) return;
+  std::lock_guard<std::mutex> lk(L->mu);
+  const uint32_t inc = L->k.unix.act.incarnation;
+  L->k.inc = inc;
+  for (auto& p : L->k.la) {  // this process pairs again as the new incarnation (TODO(2a-2): the transport)
+    gdakiCtrlPairInit(&p.pair, GDAKI_CTRL_PAIR_QP_RECORD, L->k.me, (int32_t)(GL_FROM_LAUNCHER | p.node));
+    p.connected = false;
+  }
+  L->k.latched = false;
+  L->k.pairOk = true;
+  gdakiCtrlLaRegister(L, GDAKI_CTRL_LA_ROLE_RANK, inc);
+}
