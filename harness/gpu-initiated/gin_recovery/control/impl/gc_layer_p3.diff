+static bool gdakiCtrlLaStableArmable(struct gdakiRecHost* r, bool allArmable) {
+  struct gdakiCtrlLauncher* L = gdakiCtrlLaOf(r);
+  if (L == nullptr) return false;
+  bool resend = false, say = false, arm;
+  uint32_t inc;
+  {
+    std::lock_guard<std::mutex> lk(L->mu);
+    gdakiCtrlLaLatchStep(L);
+    arm = gdakiCtrlLaStableArm(&L->k, allArmable, &resend);
+    inc = L->k.inc;
+    say = resend && L->resendSaidInc != inc + 1u;
+    if (say) L->resendSaidInc = inc + 1u;
+  }
+  if (resend) {  // the buddy's registration lacks the path: the store's next request carries it (the helper's next step)
+    struct gdakiStoreState* st = gdakiStoreOf(r);
+    if (st != nullptr) {
+      std::lock_guard<std::mutex> lk(st->mu);
+      if (st->up.need == GDAKI_STORE_N_NONE) st->up.need = GDAKI_STORE_N_RETRY;
+    }
+    if (say)
+      GIN_TS_NOTE("GIN/RC: rank %d: a spare path of incarnation %u exists but the buddy's registration says none: this "
+                  "checkpoint is not armed, STORE_REQ goes again mono_ms=%.3f", L->k.me, inc, gdakiQ4MonoMs());
+  }
+  return arm;
+}
+static bool gdakiCtrlLaSpareRegCheck(struct gdakiRecHost* r, const void* reg32, int peer, uint32_t dead, char* why,
+                                     size_t whyLen) {
+  struct gdakiCtrlLaSpareReg g;
+  memcpy(&g, reg32, sizeof(g));
+  if (!gdakiCtrlLaSpareRegOk(g, peer, dead)) {
+    snprintf(why, whyLen, "the peer's registration is not a launcher path of incarnation %u (magic %08x, flags %u)", dead,
+             g.magic, g.flags);
+    return false;
+  }
+  struct gdakiCtrlLauncher* L = gdakiCtrlLaOf(r);
+  if (L == nullptr) {
+    snprintf(why, whyLen, "this rank has no launcher link");
+    return false;
+  }
+  std::lock_guard<std::mutex> lk(L->mu);
+  if (gdakiCtrlLaIndexOfNode(&L->k, g.node) < 0) {
+    snprintf(why, whyLen, "this rank does not know the launcher of node %u", g.node);  // REVIEW_P3 nit 4
+    return false;
+  }
+  gdakiCtrlLaSetRankNode(&L->k, peer, g.node);
+  return true;
