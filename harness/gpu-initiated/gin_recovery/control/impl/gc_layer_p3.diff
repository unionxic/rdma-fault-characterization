+static void gdakiCtrlLaCtxLock(void* arg) { ((struct gdakiCtrlLaBuddyCtx*)arg)->lk->lock(); }
+static int gdakiCtrlLaHostDrain(void* arg, int peer, uint32_t dead, uint64_t step, char* why, size_t whyLen) {
+  struct gdakiRecHost* r = ((struct gdakiCtrlLaBuddyCtx*)arg)->r;
+  gdakiTsBusy busy(r->ts);
+  return gdakiMiDrainStep(r, peer, dead, step, why, whyLen);
+}
+static bool gdakiCtrlLaHostBlob(void* arg, int peer, uint32_t dead, const struct glRsActivate& rec, std::vector<uint8_t>* bytes,
+                                char* why, size_t whyLen) {
+  struct gdakiRecHost* r = ((struct gdakiCtrlLaBuddyCtx*)arg)->r;
+  struct gdakiRsActivate a;
+  static_assert(sizeof(a) == sizeof(rec), "the activation record is launcher_msg.h's");
+  memcpy(&a, &rec, sizeof(a));
+  const struct gdakiMiActBlob* blob = gdakiMiActBlobFor(r, peer, dead, a, why, whyLen);
+  if (blob == nullptr) return false;
+  if (!gdakiMiActBlobEncode(blob->hdr, blob->addr, blob->ext, bytes)) {
+    snprintf(why, whyLen, "the activation blob could not be encoded");
+    return false;
+  }
+  return true;
+}
+static bool gdakiCtrlLaHostFetchConnect(void* arg, int peer, uint32_t dead, const struct gdakiMiActAnswer& an, char* why,
+                                        size_t whyLen) {
+  struct gdakiRecHost* r = ((struct gdakiCtrlLaBuddyCtx*)arg)->r;
+  struct gdakiMiSparePeer* sp = gdakiMiActSeq(r, peer, dead);
+  if (sp == nullptr || sp->fetchQp == nullptr) {
+    snprintf(why, whyLen, "no FETCH QP of this rank for the peer");
+    return false;
+  }
+  return gdakiMiHostQpConnect(sp->fetchQp, an.fetch, why, whyLen) == ncclSuccess;
+}
+// gin-mirror's FETCH waiter (unchanged) with this rank's FETCH QP: it reads the spare's DONE on fd.
+static bool gdakiCtrlLaHostWaiter(void* arg, int peer, uint32_t dead, int fd) {
+  struct gdakiRecHost* r = ((struct gdakiCtrlLaBuddyCtx*)arg)->r;
+  struct gdakiMiSpareState* ms = gdakiMiSpareOf(r);
+  struct gdakiMiSparePeer* sp = gdakiMiActSeq(r, peer, dead);
+  if (ms == nullptr || sp == nullptr || sp->fetchQp == nullptr) return false;
+  if (ms->waiter.joinable()) {
+    ms->waiterStop.store(true, std::memory_order_release);
+    ms->waiter.join();
+  }
+  ms->waiterStop.store(false, std::memory_order_release);
+  struct gdakiMiHostQp* qp = sp->fetchQp;
+  sp->fetchQp = nullptr;
+  const double wDeadline = gdakiQ4MonoMs() + (double)std::max(1000, gdakiHoldLeftMs(r, peer));
+  ms->waiter = std::thread(gdakiMiFetchWait, ms, r->ctx->rank, peer, fd, qp, wDeadline);
+  return true;
+}
+static void gdakiCtrlLaActivateSend(struct gdakiRecHost* r, int peer, const struct gdakiRsActivate& a0, uint32_t dead,
+                                    double now) {
+  struct gdakiHold* h = gdakiHoldOf(r);
+  struct gdakiHoldPeer& hp = h->peers[peer];
+  struct gdakiCtrlLauncher* L = gdakiCtrlLaOf(r);
+  if (L == nullptr) return gdakiHoldFallback(r, peer, "this rank has no launcher link");
+  const bool mi = gdakiStoreActV2(r);  // gin-control (store) [2], decision 7: activation v2 (store blob, FETCH)
+  std::unique_lock<std::mutex> lk(L->mu);
+  struct gdakiCtrlLaBuddyCtx ctx = {r, &lk};
+  struct gdakiCtrlLaBuddyOps ops;
+  ops.arg = &ctx;
+  ops.unlock = gdakiCtrlLaCtxUnlock;
+  ops.lock = gdakiCtrlLaCtxLock;
+  ops.drain = gdakiCtrlLaHostDrain;
+  ops.blob = gdakiCtrlLaHostBlob;
+  ops.outboxPut = gdakiCtrlLaOutboxPut;
+  ops.fetchConnect = gdakiCtrlLaHostFetchConnect;
+  ops.waiter = gdakiCtrlLaHostWaiter;
+  struct glRsActivate rec;
+  static_assert(sizeof(rec) == sizeof(a0), "the activation record is launcher_msg.h's");
+  memcpy(&rec, &a0, sizeof(rec));
+  struct gdakiCtrlLaBuddyOut out;
+  const int s = gdakiCtrlLaBuddyStep(&L->k, peer, rec, dead, mi, now, ops, &out);
+  const struct gdakiCtrlLaAct& st = L->k.act[(size_t)peer];
+  if (out.started) {
+    hp.activateLater = 0;
+    hp.firstLaterMs = 0;
+  } else {
+    hp.activateLater = st.nLater > 0 ? 1 : 0;
+    if (st.nLater > 0) hp.firstLaterMs = st.laterMs;
+  }
+  if (out.laterNew)
+    WARN("GIN/RS: rank %d: rank %d's spare answered 'later' through the launcher of node %u (replaying for %u ms); "
+         "waiting at most %.0f ms for its READY mono_ms=%.3f", h->rank, peer, L->k.la[(size_t)st.li].node, st.spareAgeMs,
+         L->k.laterMs, now);
+  if (out.fetchReady)
+    GIN_TS_NOTE("GIN/MI: rank %d: rank %d's spare is READY to FETCH checkpoint %lu through the launcher of node %u "
+                "mono_ms=%.3f", h->rank, peer, (unsigned long)a0.step, L->k.la[(size_t)st.li].node, gdakiQ4MonoMs());
+  if (s == GDAKI_CTRL_LA_BS_WAIT) return;
+  lk.unlock();
+  if (s == GDAKI_CTRL_LA_BS_FALLBACK) {
+    if (out.fetchWhy[0] != '\0')
+      WARN("GIN/MI: rank %d: rank %d's spare accepted its activation but the FETCH handshake failed (%s) mono_ms=%.3f",
+           h->rank, peer, out.fetchWhy, gdakiQ4MonoMs());
+    if (mi && out.endAct) gdakiMiActEnd(r, peer);
+    return gdakiHoldFallback(r, peer, out.why);
+  }
+  hp.holders.activated = true;
+  WARN("GIN/RS: rank %d: every survivor holds rank %d: its spare activated (incarnation %u, %.1f ms after this rank's "
+       "hold start), %d 'later' answers over %.1f ms mono_ms=%.3f", h->rank, peer, a0.incarnation, now - hp.holdStartMs,
+       hp.activateLater, hp.activateLater > 0 ? now - hp.firstLaterMs : 0.0, gdakiQ4MonoMs());
+}
+
+// ---- the spare ----
+static_assert((int)GL_RS_ACT_ACCEPTED == (int)GDAKI_RS_ACT_ACCEPTED && (int)GL_RS_ACT_REFUSED == (int)GDAKI_RS_ACT_REFUSED &&
+                  (int)GL_RS_ACT_ACTIVATE == (int)GDAKI_RS_ACT_ACTIVATE,
+              "the launcher's record kinds are gin-restore's");
+struct gdakiCtrlLaSpareCtx {
+  struct gdakiRecHost* r;
+  std::unique_lock<std::mutex>* lk;
+  struct gdakiMiActBlob* blob;
+};
+static void gdakiCtrlLaSpareUnlock(void* arg) { ((struct gdakiCtrlLaSpareCtx*)arg)->lk->unlock(); }
+static void gdakiCtrlLaSpareLock(void* arg) { ((struct gdakiCtrlLaSpareCtx*)arg)->lk->lock(); }
+static int gdakiCtrlLaSpareBlobRecv(void* arg, int fd, const struct glRsActivate& rec, char* why, size_t whyLen) {
+  struct gdakiCtrlLaSpareCtx* c = (struct gdakiCtrlLaSpareCtx*)arg;
+  struct gdakiRsActivate a;
+  memcpy(&a, &rec, sizeof(a));
+  return gdakiMiActRecv(c->r, fd, a, gdakiQ4MonoMs() + 500.0, c->blob, why, whyLen);
+}
+// gdakiRsSpareActivateWait's rdma body: gdakiCtrlLaSpareTake (the link's glue) with gin-mirror's blob reader; the lines.
+static ncclResult_t gdakiCtrlLaSpareWait(struct gdakiRecHost* r, int waitMs, bool mi, struct gdakiRsActivate* act,
+                                         int* actFd, struct gdakiMiActBlob* blob) {
+  *actFd = -1;
+  struct gdakiCtrlLauncher* L = gdakiCtrlLaOf(r);
+  const int rank = r->ctx->rank;
+  if (L == nullptr || !L->registered || L->k.unix.role != GDAKI_CTRL_LA_ROLE_SPARE) {
+    WARN("GIN/RS: spare rank %d: no HELLO at the node's launcher: no activation can come mono_ms=%.3f", rank, gdakiQ4MonoMs());
+    return ncclSystemError;
+  }
+  std::unique_lock<std::mutex> lk(L->mu);
+  struct gdakiCtrlLaSpareCtx ctx = {r, &lk, blob};
+  struct gdakiCtrlLaSpareOps ops;
+  ops.arg = &ctx;
+  ops.unlock = gdakiCtrlLaSpareUnlock;
+  ops.lock = gdakiCtrlLaSpareLock;
+  ops.blobRecv = gdakiCtrlLaSpareBlobRecv;
+  struct glRsActivate rec;
+  memset(&rec, 0, sizeof(rec));
+  char why[192] = {0};
+  const int st = gdakiCtrlLaSpareTake(&L->k, &L->relay, waitMs, mi, ops, &rec, actFd, why, sizeof(why));
+  memcpy(act, &rec, sizeof(*act));
+  switch (st) {
+    case GDAKI_CTRL_LA_ST_OK:
+      WARN("GIN/RS: spare rank %d: activating incarnation %u from step %llu (through the launcher of node %u: FENCED "
+           "carried) mono_ms=%.3f", rank, act->incarnation, (unsigned long long)act->step, L->k.unix.ack.node,
+           gdakiQ4MonoMs());
+      return ncclSuccess;
+    case GDAKI_CTRL_LA_ST_NO_READY:
+      WARN("GIN/RS: spare rank %d: READY could not be sent to the launcher mono_ms=%.3f", rank, gdakiQ4MonoMs());
+      break;
+    case GDAKI_CTRL_LA_ST_NO_ACT:
+      WARN("GIN/RS: spare rank %d: no ACTIVATE from the launcher within %d ms%s mono_ms=%.3f", rank, waitMs, why,
+           gdakiQ4MonoMs());
+      break;
+    case GDAKI_CTRL_LA_ST_REFUSED:
+      WARN("GIN/RS: spare rank %d: activation refused (%s) mono_ms=%.3f", rank, why, gdakiQ4MonoMs());
+      break;
+    default:
+      WARN("GIN/RS: spare rank %d: no HELLO at the node's launcher: no activation can come mono_ms=%.3f", rank,
+           gdakiQ4MonoMs());
+      break;
+  }
+  return ncclSystemError;
+}
+// A spare's replay or Resume failed before READY or an activation (REVIEW_P3 고칠 것 9): REPLAY_FAILED with why, once.
+static void gdakiCtrlLaSpareFailed(struct gdakiRecHost* r, const char* why) {
+  struct gdakiCtrlLauncher* L = gdakiCtrlLaOf(r);
+  if (L == nullptr || !L->registered) return;
+  std::lock_guard<std::mutex> lk(L->mu);
+  if (gdakiCtrlLaSpareFail(&L->k.unix, why))
+    GIN_TS_NOTE("GIN/RS: spare rank %d: REPLAY_FAILED (%s) to the launcher of node %u mono_ms=%.3f", L->k.me, why,
+                L->k.unix.ack.node, gdakiQ4MonoMs());
+}
+// After the FETCH (or its failure): the relay ends; on success this process registers as the new incarnation (the
+// launcher swaps the rank's pidfd: design v3 5.4 7) and its re-arming waits for that and for both launchers' pairings.
+static void gdakiCtrlLaSpareDone(struct gdakiRecHost* r, bool ok) {
+  struct gdakiCtrlLauncher* L = gdakiCtrlLaOf(r);
+  if (L == nullptr) return;
+  gdakiCtrlLaRelayEnd(&L->relay, ok ? 1000 : 0);  // REVIEW_P3 고칠 것 4: DONE relayed before the end (its grace)
+  if (!ok) return;
+  std::lock_guard<std::mutex> lk(L->mu);
+  char why[160] = {0};
+  L->spare = false;
+  L->registered = gdakiCtrlLaSpareRevive(&L->k, why, sizeof(why));  // TODO(2a-2): the pairings' transport
+  if (!L->registered)
+    WARN("GIN/RC: rank %d: REGISTER of incarnation %u at the node's launcher failed (%s): no launcher path, this rank is not "
+         "armed mono_ms=%.3f", L->k.me, L->k.inc, why, gdakiQ4MonoMs());
+  else
+    gdakiCtrlLaSay(L->k.log, "GIN/RC: rank %d: registered incarnation %u at the launcher of node %u (page slot %u)", L->k.me,
+                   L->k.inc, L->k.unix.ack.node, L->k.unix.ack.pageSlot);
+}
