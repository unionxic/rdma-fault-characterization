+// After every QP on it is destroyed. False: kept (a CQ that cannot be destroyed keeps its stats alive, as the template).
+[[maybe_unused]] static bool gdakiCtrlCqDestroy(struct gdakiCtrlCq* c) {
+  if (c == nullptr) return true;
+  if (c->cq != nullptr && wrap_ibv_destroy_cq(c->cq) != ncclSuccess) {
+    WARN("GIN/RC: a control CQ could not be destroyed; its state is kept mono_ms=%.3f", gdakiQ4MonoMs());
+    return false;
+  }
+  c->cq = nullptr;
+  if (c->channel != nullptr) (void)wrap_ibv_destroy_comp_channel(c->channel);
+  delete c;
+  return true;
+}
