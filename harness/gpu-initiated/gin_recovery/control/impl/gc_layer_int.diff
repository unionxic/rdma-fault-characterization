+  struct gdakiCtrlRejoinNrp nrp;   // the endpoints its first REJOIN carried (every resend carries the same)
+  double sentMs = -1e18;           // the last one
+  uint32_t lastAnswer = 0;         // the last answer that did not take it (GDAKI_CTRL_RJA_WAIT, _REFUSE; 0 none)
+  uint64_t waits = 0, refusals = 0, timeouts = 0;
