+// ---- the fence word's step (design v3 4.4 4): FENCED or EXITED of (peer, inc) ----
+// CURRENT and HELD_OLD raise the word to max(word, inc + 1); FUTURE and STALE leave it; it never goes down.
+static inline uint64_t gdakiLnFencedStep(uint64_t word, uint32_t cls, uint32_t inc) {
+  if (cls != GDAKI_LN_CURRENT && cls != GDAKI_LN_HELD_OLD) return word;
+  const uint64_t w = gdakiCtrlFenceWord(inc);
+  return w > word ? w : word;
+}
+
+// ---- the verdict mailbox (watch -> helper; REVIEW_P12 막는 문제 6) ----
+// One 64-bit word per (peer, kind): the watch thread stores a verdict once (its latch), the helper takes it with an
+// exchange to 0 and acts once. 0: empty.
+static inline uint64_t gdakiCtrlMailPack(uint32_t row, uint32_t verdict, uint32_t cause, uint32_t inc) {
+  return (1ull << 63) | ((uint64_t)(row & 0x1fu) << 48) | ((uint64_t)(verdict & 0xffu) << 40) |
+         ((uint64_t)(cause & 0xffu) << 32) | inc;
+}
+static inline uint32_t gdakiCtrlMailRow(uint64_t m) { return (uint32_t)(m >> 48) & 0x1fu; }
+static inline uint32_t gdakiCtrlMailVerdict(uint64_t m) { return (uint32_t)(m >> 40) & 0xffu; }
+static inline uint32_t gdakiCtrlMailCause(uint64_t m) { return (uint32_t)(m >> 32) & 0xffu; }
+static inline uint32_t gdakiCtrlMailInc(uint64_t m) { return (uint32_t)m; }
+
+// ---- the judgement's effect on the record path (phase 2a-2-C step 4; EXPERIMENT.md 9.3, impl/notes_fix12.md "2a-2가
+// 다음에 묶을 것" 3) ----
+// An effective pair (its records go on the ring, the status page and its liveness READ QP are up): a witness FIN or RST
+// without BYE only opens the confirm window; the hold (the decline when not armed) starts on the table's verdict at
+// t_F + W (rows 3-6: EXITED, FIN+STALE, FIN+NORESP, REMACC+FIN) or at once on the launcher's EXITED or FENCED of the
+// pair's incarnation (row 3, "ended"; EXITED wins over a rising beat), never on the FIN by itself. Row 8 re-dials the
+// witness (alive); row 9, or no verdict within W + PROBE_TIMEOUT_MS, makes the witness unknown (re-dialled; the launcher's
+// report decides, ln4's refusal rule stays the last word). Any other pair (the tcp build, no ring, the ring not live yet,
+// no page) keeps ln4's witness rule: FIN = death at once. The helper's, one per peer.
+enum : uint32_t {
+  GDAKI_CTRL_EA_NONE = 0,    // nothing (no window of this incarnation pending, or its end was acted on)
+  GDAKI_CTRL_EA_OLD = 1,     // ln4's socket rule (FIN: death now; RST: unknown)
+  GDAKI_CTRL_EA_WINDOW = 2,  // the FIN or RST opened the window: no death until its verdict
+  GDAKI_CTRL_EA_END = 3,     // ended: the hold (armed) or the decline, now
+  GDAKI_CTRL_EA_REDIAL = 4,  // row 8: alive, the witness lost: re-dial it
+  GDAKI_CTRL_EA_WAIT = 5,    // row 9, or the verdict overdue: the witness unknown, the launcher's report decides
+};
+struct gdakiCtrlEff {
+  uint32_t pendInc1 = 0;  // the incarnation + 1 whose FIN or RST opened the window (0: none pending)
+  uint32_t doneInc1 = 0;  // the incarnation + 1 whose end was acted on (once per incarnation)
+  uint32_t src = 0;       // GDAKI_CTRL_WSRC_FIN or _RST of the pending one
+  double tF = 0;          // its t_F (the helper's clock)
+};
+// The rows that end a peer here (the floor rule: each carries the launcher's end or a FIN with a confirmed window).
+static inline bool gdakiCtrlEffEndRow(uint32_t row) { return row >= 3 && row <= 6; }
+static inline bool gdakiCtrlEffective(bool ringLive, bool pageUp, bool hasQp) { return ringLive && pageUp && hasQp; }
+// A FIN or RST (src) of incarnation inc at now. A second one of the same incarnation keeps the first t_F.
+static inline uint32_t gdakiCtrlEffOnFin(struct gdakiCtrlEff* e, bool effective, uint32_t src, uint32_t inc, double now) {
+  if (!effective) return GDAKI_CTRL_EA_OLD;
+  if (e->doneInc1 == inc + 1u) return GDAKI_CTRL_EA_NONE;  // ended already: the FIN is spent
+  if (e->pendInc1 != inc + 1u) {
+    e->pendInc1 = inc + 1u;
+    e->src = src;
+    e->tF = now;
+  }
+  return GDAKI_CTRL_EA_WINDOW;
+}
+// The window's verdict (its mailbox: the table's row) of incarnation inc.
+static inline uint32_t gdakiCtrlEffOnVerdict(struct gdakiCtrlEff* e, uint32_t row, uint32_t inc) {
+  if (e->pendInc1 != inc + 1u || e->doneInc1 == inc + 1u) return GDAKI_CTRL_EA_NONE;
+  e->pendInc1 = 0;
+  if (gdakiCtrlEffEndRow(row)) {
+    e->doneInc1 = inc + 1u;
+    return GDAKI_CTRL_EA_END;
+  }
+  return row == 8 ? GDAKI_CTRL_EA_REDIAL : GDAKI_CTRL_EA_WAIT;
+}
+// The launcher's EXITED or FENCED of incarnation inc (the fence word stands): the end at once, window or not.
+static inline uint32_t gdakiCtrlEffOnEnded(struct gdakiCtrlEff* e, bool effective, uint32_t inc) {
+  if (!effective || e->doneInc1 == inc + 1u) return GDAKI_CTRL_EA_NONE;
+  e->doneInc1 = inc + 1u;
+  e->pendInc1 = 0;
+  return GDAKI_CTRL_EA_END;
+}
+// A pending window without its verdict boundMs after t_F (the watch thread gone or late): WAIT once.
+static inline uint32_t gdakiCtrlEffOverdue(struct gdakiCtrlEff* e, double now, double boundMs) {
+  if (e->pendInc1 == 0 || now - e->tF <= boundMs) return GDAKI_CTRL_EA_NONE;
+  e->pendInc1 = 0;
+  return GDAKI_CTRL_EA_WAIT;
+}
+// smoke3 (NCCL_GIN_CTRL_WITNESS=0): on an effective pair the witness socket stays for the bootstrap and BYE only; its end
+// (FIN, RST, any error, a refused re-dial) opens no window and feeds no judgement (W is "off" in the table): the
+// launcher's report (row 3) or the READ failure path (rows 10, 11) judges. A pair without a live ring keeps ln4's rule
+// (its socket carries the records); an end after the peer's BYE is "left" as before.
+static inline bool gdakiCtrlWitnessMuted(bool effective, bool witnessOn, bool left) {
+  return effective && !witnessOn && !left;
+}
+// The READ failure path's end of incarnation inc (the periodic judgement's rows 10, 11: the hardware's retry exceeded,
+// the launcher unresponsive or its word not ALIVE with the witness off): once per incarnation, window or not. Row 10 is
+// LINKDOWN (a decline, no restore), row 11 NORESP (the hold when armed; the fence confirms).
+static inline bool gdakiCtrlEffReadRow(uint32_t row) { return row == 10 || row == 11; }
+static inline uint32_t gdakiCtrlEffOnReadRow(struct gdakiCtrlEff* e, bool effective, uint32_t row, uint32_t inc) {
+  if (!effective || !gdakiCtrlEffReadRow(row) || e->doneInc1 == inc + 1u) return GDAKI_CTRL_EA_NONE;
+  e->doneInc1 = inc + 1u;
+  e->pendInc1 = 0;
+  return GDAKI_CTRL_EA_END;
+}
+
+// ---- the launcher page pull (design v3 4.2 L: pullOk and the registration word; EXPERIMENT.md 9.2, 9.3) ----
+// launcher_msg.h's glPage: a 64 B head (magicVer first, beat second), then GDAKI_CTRL_LAP_REGS slots of 32 B {nonce, reg,
+// spare, spareSinceMs}, reg = (state << 56) | (rank << 32) | incarnation; a slot is bound to (nonce, rank) once and never
+// rebound. The pull is one READ of the head and the slots (the launcher host region static_asserts these numbers).
+#define GDAKI_CTRL_LAP_MAGIC 0x504c5247u  // GL_PAGE_MAGIC
+#define GDAKI_CTRL_LAP_HEAD 64u
+#define GDAKI_CTRL_LAP_SLOT 32u
+#define GDAKI_CTRL_LAP_REGS 62u
+#define GDAKI_CTRL_LAP_PULL_BYTES (GDAKI_CTRL_LAP_HEAD + GDAKI_CTRL_LAP_SLOT * GDAKI_CTRL_LAP_REGS)  // 2048
+#define GDAKI_CTRL_LAP_RS_ALIVE 1u        // GL_RS_ALIVE
+#define GDAKI_CTRL_LAP_RS_LEFT 3u         // GL_RS_LEFT
+// The registration word of (nonce, rank) in one pull (n bytes): 1 and *word when a slot is bound to them, 0 when none is
+// (the page answered), -1 when the bytes are not a whole pull of a launcher page.
+static inline int gdakiCtrlLaPageRegOf(const uint8_t* page, size_t n, uint64_t nonce, int rank, uint64_t* word) {
+  *word = 0;
+  if (page == nullptr || n < GDAKI_CTRL_LAP_PULL_BYTES) return -1;
+  uint64_t mv = 0;
+  memcpy(&mv, page, 8);
+  if ((uint32_t)(mv >> 32) != GDAKI_CTRL_LAP_MAGIC) return -1;
+  if (nonce == 0 || rank < 0) return 0;
+  for (uint32_t i = 0; i < GDAKI_CTRL_LAP_REGS; i++) {
+    uint64_t sn = 0, reg = 0;
+    memcpy(&sn, page + GDAKI_CTRL_LAP_HEAD + GDAKI_CTRL_LAP_SLOT * i, 8);
+    memcpy(&reg, page + GDAKI_CTRL_LAP_HEAD + GDAKI_CTRL_LAP_SLOT * i + 8, 8);
+    if (sn == nonce && (uint32_t)((reg >> 32) & 0xffffffu) == ((uint32_t)rank & 0xffffffu)) {
+      *word = reg;
+      return 1;
+    }
+  }
+  return 0;
+}
+// The pull's L inputs for incarnation inc: (ALIVE, rank, inc) is regAlive, (LEFT, rank, inc) regLeft; any other word or
+// no slot is "no information" (the word's EXITED and FENCED are not an end: the messages are).
+static inline void gdakiCtrlLaPageRegL(int found, uint64_t word, uint32_t inc, bool* regAlive, bool* regLeft) {
+  const uint32_t st = (uint32_t)(word >> 56), wi = (uint32_t)word;
+  *regAlive = found == 1 && st == GDAKI_CTRL_LAP_RS_ALIVE && wi == inc;
+  *regLeft = found == 1 && st == GDAKI_CTRL_LAP_RS_LEFT && wi == inc;
+}
+// pullOk: the launcher's record QP connected and not in error, its beat not stale (gdakiCtrlLaLost), and a pull succeeded
+// within the launcher stall bound (a READ that never completes leaves its last success behind: then 무응답).
+static inline bool gdakiCtrlLaPullOk(bool connected, bool qpErr, bool lost, double lastOkMs, double nowMs, double stallMs) {
+  return connected && !qpErr && !lost && lastOkMs >= 0 && nowMs - lastOkMs < stallMs;
+}
+// The published pull of one rank (helper -> watch, one word): (state << 56) | (pullOk << 33) | (found << 32) | inc.
+static inline uint64_t gdakiCtrlLaPullPack(bool pullOk, int found, uint64_t word) {
+  return (word & 0xff000000ffffffffull) | ((uint64_t)(pullOk ? 1u : 0u) << 33) | ((uint64_t)(found == 1 ? 1u : 0u) << 32);
+}
+static inline bool gdakiCtrlLaPullOkOf(uint64_t w) { return ((w >> 33) & 1u) != 0; }
+static inline void gdakiCtrlLaPullL(uint64_t w, uint32_t inc, bool* pullOk, bool* regAlive, bool* regLeft) {
+  *pullOk = gdakiCtrlLaPullOkOf(w);
+  gdakiCtrlLaPageRegL(((w >> 32) & 1u) != 0 ? 1 : 0, w & 0xff000000ffffffffull, inc, regAlive, regLeft);
+}
+
+// ---- the test switch FREEZE_PAGE (EXPERIMENT.md 9.9 "박동 쓰기만 멈춤") ----
+// "<ms>": the watch thread writes neither beat for <ms>; "<ms>:helper": helperBeat only (watchBeat still rises). The
+// freeze starts when the communicator is first armed (ncclGinRestoreResume) plus an optional "@<after ms>". False: not a
+// valid value (the switch stays off).
+struct gdakiCtrlFreezeSpec {
+  bool on = false, helperOnly = false;
+  double lenMs = 0, afterMs = 0;
+};
+static inline bool gdakiCtrlFreezeParse(const char* s, struct gdakiCtrlFreezeSpec* out) {
+  struct gdakiCtrlFreezeSpec f;
+  if (s == nullptr || *s == 0) return false;
+  char* e = nullptr;
+  const double len = strtod(s, &e);
+  if (e == s || len <= 0) return false;
+  f.lenMs = len;
+  if (strncmp(e, ":helper", 7) == 0) {
+    f.helperOnly = true;
+    e += 7;
+  }
+  if (*e == '@') {
+    const char* a = e + 1;
+    f.afterMs = strtod(a, &e);
+    if (e == a || f.afterMs < 0) return false;
+  }
+  if (*e != 0) return false;
+  f.on = true;
+  *out = f;
+  return true;
+}
