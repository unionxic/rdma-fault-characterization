+  if (pg == nullptr) return;
+  for (auto& pp : pg->peers) gdakiProbeQpDestroy(&pp.qp);
+  if (pg->pageMr != nullptr) (void)wrap_ibv_dereg_mr(pg->pageMr);
+  if (pg->rdMr != nullptr) (void)wrap_ibv_dereg_mr(pg->rdMr);
+  free(pg->page);
+  free(pg->rd);
+  delete pg;
+}
+// ---- live: this rank's device progress line (user decision 2026-10-22) ----
+// The GIN context 0's device QP array (DOCA's doca_gpu_verbs_export_multi_qps_dev: one GPU allocation of nranks x
+// struct doca_gpu_dev_verbs_qp, GPU-page aligned; element k is this rank's QP to rank k, gdqp of the context's staging
+// copy). The GPU writes sq_rsvd_index at every post and cq_sq.cqe_ci at every poll; no device code changes. Registered
+// in the GIN PD for REMOTE_READ only, as the GIN windows are (gdakiRegMr: DMA-BUF, else peer memory; iova 0, strict
+// ordering), before the setup all-gather so that the region goes out in gdakiCtrlSetupAddr::dev; the status page names
+// it too (devLine), for an incarnation the all-gather does not reach. BAR1: the allocation's GPU page (64 KiB for up to
+// 221 ranks), the NIC copy path registered it in its own PD already. Made and freed on the setup and teardown threads.
+struct gdakiCtrlDev {
+  struct ibv_mr* mr = nullptr;
+  uint32_t bytes = 0;                       // nranks x sizeof(struct doca_gpu_dev_verbs_qp)
+  std::vector<struct gdakiCtrlRegion> ag;   // every rank's all-gather region (rkey 0: none), by rank
+};
+static void gdakiCtrlDevSetup(struct gdakiRecHost* r, bool on, struct gdakiCtrlSetupAddr* mine) {
+  if (!on || r == nullptr || r->ctrl == nullptr || r->ctrl->dev != nullptr || ncclParamGinCtrlPage() == 0) return;
+  struct gdaki_context* g = r->ctx;
+  if (g == nullptr || g->collComm == nullptr || g->collComm->ib.pd == nullptr || g->gin_gdaki_gpu_ctx_host_staging == nullptr)
+    return;
+  struct gdakiCtrlDev* d = new gdakiCtrlDev();
+  r->ctrl->dev = d;
+  d->ag.assign((size_t)std::max(0, r->nranks), gdakiCtrlRegion());
+  void* base = (void*)g->gin_gdaki_gpu_ctx_host_staging[0].gdqp;
+  const uint32_t bytes = (uint32_t)((size_t)std::max(0, r->nranks) * sizeof(struct doca_gpu_dev_verbs_qp));
+  ncclResult_t res = ncclInvalidUsage;
+  if (base != nullptr && bytes != 0) res = gdakiRegMr(&d->mr, g->collComm->ib.pd, base, bytes, IBV_ACCESS_REMOTE_READ, true);
+  if (res != ncclSuccess || d->mr == nullptr) {
+    d->mr = nullptr;
+    WARN("GIN/RC: rank %d: the device progress line (%u B) could not be registered: liveness falls back to the host beats "
+         "for this rank mono_ms=%.3f", g->rank, bytes, gdakiQ4MonoMs());
+    return;
+  }
+  d->bytes = bytes;
+  mine->dev.addr = 0;  // the MR's iova
+  mine->dev.rkey = d->mr->rkey;
+  mine->dev.len = bytes;
+  GIN_TS_NOTE("GIN/RC: rank %d: device progress line registered (%u B, %d QPs of context 0, rkey=0x%x) mono_ms=%.3f",
+              g->rank, bytes, r->nranks, d->mr->rkey, gdakiQ4MonoMs());
+}
+// After the all-gather: every rank's region (all[p] null: a rank without transparent recovery).
+static void gdakiCtrlDevAgTake(struct gdakiRecHost* r, int nranks, const struct gdakiCtrlSetupAddr* const* all) {
+  struct gdakiCtrlDev* d = (r != nullptr && r->ctrl != nullptr) ? r->ctrl->dev : nullptr;
+  if (d == nullptr) return;
+  for (int p = 0; p < nranks && p < (int)d->ag.size(); p++)
+    if (all[p] != nullptr) d->ag[(size_t)p] = all[p]->dev;
+}
+static void gdakiCtrlDevFree(struct gdakiCtrlState* st) {  // after the page (its READ QPs) is gone, before the unexport
+  if (st == nullptr || st->dev == nullptr) return;
+  if (st->dev->mr != nullptr) (void)wrap_ibv_dereg_mr(st->dev->mr);
+  delete st->dev;
+  st->dev = nullptr;
+}
+
+// Bring the page up once (NCCL_GIN_CTRL_PAGE=1), on the setup thread (gdakiTsStart): the thresholds' range check
+// (gdakiCtrlThresholdsOk: out of range, the page stays off with a WARN, the scaffold's fail-fast), the 4 KiB status page
+// (REMOTE_READ), one READ slot per peer and per launcher (LOCAL_WRITE, one MR), one liveness-READ QP per gated peer. The
+// page is published only when it is complete (a release store; the watch thread loads it with acquire).
+static int gdakiCtrlRingLaunchersOf(const struct gdakiRecHost* r);  // int2: the ring's launcher count (ring back end)
+static void gdakiPageSetup(struct gdakiRecHost* r) {
+  struct gdakiCtrlState* st = r != nullptr ? r->ctrl : nullptr;  // made by gdakiTsSetup before its all-gather (prep)
+  if (st == nullptr || gdakiPageOf(r) != nullptr || r->ts == nullptr) return;
+  if (ncclParamGinCtrlPage() == 0) return;  // NCCL_GIN_CTRL_PAGE=0: no page (the rdma build's default is 1)
+  struct gdaki_context* g = r->ctx;
+  if (g == nullptr || g->q4 == nullptr) {  // no watch thread to write and read it (REVIEW_FIX12_P2B 고칠 것 6)
+    WARN("GIN/RC: rank %d: NCCL_GIN_CTRL_PAGE=1 needs NCCL_GIN_FAULT_CLASSIFY=1 (the watch thread): the status page stays "
+         "off mono_ms=%.3f", g != nullptr ? g->rank : -1, gdakiQ4MonoMs());
+    return;
+  }
+  struct gdakiCtrlThresholds t;
+  t.probeMs = ncclParamGinTsProbeMs();
+  t.probeTimeoutMs = ncclParamGinCtrlProbeTimeoutMs();
+  t.confirmMs = ncclParamGinCtrlConfirmMs();
+  t.suspectMs = ncclParamGinTsSuspectMs();
+  t.stallMs = ncclParamGinTsStallMs();
+  t.restoreMs = ncclParamGinRestoreMs();
+  char why[160];
+  if (!gdakiCtrlThresholdsOk(t, why, sizeof(why))) {
+    WARN("GIN/RC: rank %d: the liveness thresholds are out of range (%s): the status page stays off mono_ms=%.3f",
+         g->rank, why, gdakiQ4MonoMs());
+    return;
+  }
+  struct ibv_pd* pd = (g != nullptr && g->collComm != nullptr) ? g->collComm->ib.pd : nullptr;
+  if (pd == nullptr) return;
+  struct gdakiCtrlPage* pg = new gdakiCtrlPage();
+  pg->me = g->rank;
+  pg->probeMs = (int)t.probeMs;
+  pg->suspectMs = (int)t.suspectMs;
+  pg->stallMs = (int)t.stallMs;
+  pg->probeTimeoutMs = (int)t.probeTimeoutMs;
+  pg->wMs = (int)t.confirmMs;  // no silent clamp: the range check refused a W below 20
+  pg->probeFailN = (int)std::max<int64_t>(1, ncclParamGinTsProbeFailN());
+  pg->vetoMs = (int)std::max<int64_t>(0, ncclParamGinTsStallRmsnMs());
+  pg->witnessOn = ncclParamGinCtrlWitness() != 0;
+  const int nranks = r->nranks;
+  pg->peers = std::vector<struct gdakiCtrlPeerProbe>((size_t)std::max(0, nranks));
+  pg->fencedPlus1.assign((size_t)std::max(0, nranks), GDAKI_CTRL_FENCE_NONE);
+#ifndef NCCL_GIN_TS_PRODUCTION
+  const char* fz = getenv("NCCL_GIN_TS_TEST_FREEZE_PAGE");
+  if (fz != nullptr && *fz && !gdakiCtrlFreezeParse(fz, &pg->freeze))
+    WARN("GIN/RC: rank %d: test switch FREEZE_PAGE=%s is not <ms>[:helper][@<after ms>]: off", g->rank, fz);
+#endif
+  pg->nLaunchers = (uint32_t)gdakiCtrlRingLaunchersOf(r);  // int2: the all-gather's count, the ring's layout's
+  if (!gdakiCtrlPageLayoutOf((uint32_t)nranks, pg->nLaunchers, &pg->layout)) {
+    WARN("GIN/RC: rank %d: the status page does not fit %d ranks; the page stays off mono_ms=%.3f", g->rank, nranks,
+         gdakiQ4MonoMs());
+    gdakiCtrlPageDelete(pg);
+    return;
+  }
+  pg->rdSlot = (((size_t)pg->layout.bytes + 63u) & ~(size_t)63u) + 2 * sizeof(struct gdakiCtrlPageHead);
+  // live: the device line areas after the slots (a peer's line has this library's layout: nranks QPs)
+  pg->devStride = (uint32_t)sizeof(struct doca_gpu_dev_verbs_qp);
+  pg->devOffPosted = (uint32_t)offsetof(struct doca_gpu_dev_verbs_qp, sq_rsvd_index);
+  pg->devOffPolled = (uint32_t)(offsetof(struct doca_gpu_dev_verbs_qp, cq_sq) + offsetof(struct doca_gpu_dev_verbs_cq, cqe_ci));
+  pg->devBytes = (uint32_t)nranks * pg->devStride;
+  pg->devOff = pg->rdSlot * ((size_t)nranks + GDAKI_CTRL_PAGE_MAX_LAUNCHERS);
+  pg->devSlot = (((size_t)pg->devBytes) + 63u) & ~(size_t)63u;
+  pg->rdBytes = ((pg->devOff + pg->devSlot * (size_t)nranks) + 4095u) & ~(size_t)4095u;
+  void* rd = nullptr;
+  if (posix_memalign(&pg->page, 4096, GDAKI_CTRL_PAGE_BYTES) != 0 || pg->page == nullptr ||
+      posix_memalign(&rd, 4096, pg->rdBytes) != 0 || rd == nullptr) {
+    WARN("GIN/RC: rank %d: the status page could not be allocated mono_ms=%.3f", g->rank, gdakiQ4MonoMs());
+    free(rd);
+    gdakiCtrlPageDelete(pg);
+    return;
+  }
+  pg->rd = (uint8_t*)rd;
+  memset(pg->page, 0, GDAKI_CTRL_PAGE_BYTES);
+  memset(pg->rd, 0, pg->rdBytes);
+  pg->head = (struct gdakiCtrlPageHead*)pg->page;
+  // live: the page names this rank's device progress line (constant from here; 0 when it is not registered)
+  if (st->dev != nullptr && st->dev->mr != nullptr)
+    gdakiCtrlWordStore(&pg->head->devLine, gdakiCtrlDevLineWord(st->dev->mr->rkey, st->dev->bytes));
+  // the page MR before any liveness READ QP (design 3.5's registration order)
+  if (wrap_ibv_reg_mr(&pg->pageMr, pd, pg->page, GDAKI_CTRL_PAGE_BYTES, IBV_ACCESS_LOCAL_WRITE | IBV_ACCESS_REMOTE_READ) !=
+          ncclSuccess ||
+      wrap_ibv_reg_mr(&pg->rdMr, pd, pg->rd, pg->rdBytes, IBV_ACCESS_LOCAL_WRITE) != ncclSuccess) {
+    WARN("GIN/RC: rank %d: the status page MR could not be registered mono_ms=%.3f", g->rank, gdakiQ4MonoMs());
+    gdakiCtrlPageDelete(pg);
+    return;
+  }
+  for (int p = 0; p < nranks; p++) {
+    struct gdakiCtrlPeerProbe& pp = pg->peers[(size_t)p];
+    pp.theirStale.assign((size_t)nranks, -1.0);  // unseen until a READ of the peer's page
+    if (p == g->rank || !r->ts->peers[p].gated) continue;
+    if (gdakiProbeQpCreate(r, p, &pp.qp, why, sizeof(why)) != ncclSuccess)
+      WARN("GIN/RC: rank %d: the liveness READ QP to rank %d could not be created (%s) mono_ms=%.3f", g->rank, p, why,
+           gdakiQ4MonoMs());
+    else
+      pp.hasQp = true;
+  }
+  pg->lastBeatMs = gdakiQ4MonoMs();
+  pg->up.store(true, std::memory_order_release);
+  __atomic_store_n(&st->page, pg, __ATOMIC_RELEASE);  // published complete
+  GIN_TS_NOTE("GIN/RC: rank %d: status page up (%u B in use, probe_ms=%d stall_ms=%d W=%d, device line %s %u B) "
+              "mono_ms=%.3f", g->rank, pg->layout.bytes, pg->probeMs, pg->stallMs, pg->wMs,
+              pg->head->devLine != 0 ? "named" : "none", pg->devBytes, gdakiQ4MonoMs());
+}
+
+// The probe summary (rows_gc.py PROBESUM), one line per peer, at the teardown.
+static void gdakiCtrlProbeSummary(struct gdakiRecHost* r, struct gdakiCtrlPage* pg) {
+  if (pg == nullptr || pg->summarized) return;  // smoke fix 2: once, at the communicator's teardown or at the free
+  pg->summarized = true;
+  for (int p = 0; p < (int)pg->peers.size(); p++) {
+    struct gdakiCtrlPeerProbe& pp = pg->peers[(size_t)p];
+    if (p == pg->me || pp.qp.q == nullptr) continue;
+    std::vector<float> l = pp.latUs;
+    float med = 0, mx = 0;
+    if (!l.empty()) {
+      std::nth_element(l.begin(), l.begin() + (long)(l.size() / 2), l.end());
+      med = l[l.size() / 2];
+      mx = *std::max_element(l.begin(), l.end());
+    }
+    GIN_TS_NOTE("GIN/RC: rank %d: probe summary peer=%d reads=%lu ok=%lu remacc=%lu noresp=%lu timeout=%lu gen=%u "
+                "lat_med_us=%.1f lat_max_us=%.1f beat_gap_max_ms=%.3f torn=%lu after_end_reads=0 after_end_ok=0 "
+                "broken=%lu other_page=%lu sq_max=%u W=%d W_rule=%d helper_fw=%lu watch_fw=0 drain_giveup=%lu "
+                "refused_hold=%lu refused_lineage=%lu dev_line=%d dev_reads=%lu dev_ok=%lu dev_quiet=%lu dev_ag_diff=%lu "
+                "dev_bad=%lu pair_max=%u mono_ms=%.3f", pg->me, p, (unsigned long)pp.reads,
+                (unsigned long)pp.ok, (unsigned long)pp.remacc, (unsigned long)pp.noresp, (unsigned long)pp.timeouts,
+                pp.qp.gen, (double)med, (double)mx, pg->gapMaxMs, (unsigned long)pp.torn, (unsigned long)pp.broken,
+                (unsigned long)pp.otherInc, pp.io.maxOutstanding, pg->wMs,
+                gdakiCtrlConfirmW(GDAKI_CTRL_CONFIRM_FACTOR, pg->gapMaxMs), (unsigned long)pp.helperFw,
+                (unsigned long)pp.hand.drainGiveUps, (unsigned long)pp.hand.refusedHold,
+                (unsigned long)pp.hand.refusedLineage, pp.devRkey != 0 ? 1 : 0, (unsigned long)pp.devReads,
+                (unsigned long)pp.devOkN, (unsigned long)pp.devQuietN, (unsigned long)pp.devAgDiff,
+                (unsigned long)pp.devBad, pp.io.maxPeriodicLeft, gdakiQ4MonoMs());
+  }
+  (void)r;
+}
+// Smoke fix 2: the communicator's teardown asks the watch thread for the summary (it owns the counters and the latency
+// vector) and waits up to 500 ms; a watch thread that does not step by then is not running, and the teardown writes it.
+static void gdakiCtrlProbeSummaryAtTeardown(struct gdakiRecHost* r) {
+  struct gdakiCtrlPage* pg = gdakiPageOf(r);
+  if (pg == nullptr || !gdakiPageUp(pg)) return;
+  int want = 0;
+  if (!pg->sumReq.compare_exchange_strong(want, 1, std::memory_order_acq_rel)) return;
+  const double t0 = gdakiQ4MonoMs();
+  while (pg->sumReq.load(std::memory_order_acquire) == 1 && gdakiQ4MonoMs() - t0 < 500.0)
+    std::this_thread::sleep_for(std::chrono::milliseconds(1));
+  want = 1;
+  if (pg->sumReq.compare_exchange_strong(want, 4, std::memory_order_acq_rel)) {
+    gdakiCtrlProbeSummary(r, pg);
+    pg->sumReq.store(2, std::memory_order_release);
+    return;
+  }
+  while (pg->sumReq.load(std::memory_order_acquire) == 4 && gdakiQ4MonoMs() - t0 < 1000.0)
+    std::this_thread::sleep_for(std::chrono::milliseconds(1));
+}
+static void gdakiCtrlPageFree(struct gdakiRecHost* r) {  // [1] the free hook gdakiCtrlFree calls (threads stopped)
+  struct gdakiCtrlState* st = (r != nullptr) ? r->ctrl : nullptr;
+  struct gdakiCtrlPage* pg = gdakiPageOf(r);
+  if (pg != nullptr) {
+    gdakiCtrlProbeSummary(r, pg);
+    gdakiCtrlPageDelete(pg);
+    __atomic_store_n(&st->page, (struct gdakiCtrlPage*)nullptr, __ATOMIC_RELEASE);
+  }
+  gdakiCtrlDevFree(st);  // live: the device line's MR, after the READ QPs
+}
+
+// Write this rank's judgement words into the status page, once per ms (design 3.1, 3.3; REVIEW_P12 nit 1), and measure
+// the beat's largest gap (W's basis, 결정 5). The watch thread is the only writer. FREEZE_PAGE holds the beats.
+static void gdakiPageBeatStep(struct gdakiRecHost* r, struct gdakiCtrlPage* pg, double nowMs) {
+  if (pg->head == nullptr || nowMs - pg->lastBeatMs < 1.0) return;
+  struct gdaki_context* g = r->ctx;
+  bool freezeAll = false, freezeHelper = false;
+  if (pg->freeze.on) {
+    if (pg->freezeFromMs < 0 && r->hold != nullptr && r->hold->commArmed.load(std::memory_order_acquire) != 0) {
+      pg->freezeFromMs = nowMs + pg->freeze.afterMs;
+      pg->freezeToMs = pg->freezeFromMs + pg->freeze.lenMs;
+    }
+    if (pg->freezeFromMs >= 0 && nowMs >= pg->freezeFromMs && nowMs < pg->freezeToMs) {
+      if (!pg->freezeLogged) {
+        pg->freezeLogged = true;
+        GIN_TS_NOTE("GIN/RC: rank %d: test switch FREEZE_PAGE=%.0f%s: %s frozen mono_ms=%.3f", g->rank, pg->freeze.lenMs,
+                    pg->freeze.helperOnly ? ":helper" : "", pg->freeze.helperOnly ? "helperBeat" : "watchBeat and helperBeat",
+                    nowMs);
+      }
+      freezeAll = !pg->freeze.helperOnly;
+      freezeHelper = true;
+    }
+  }
+  const double gap = nowMs - pg->lastBeatMs;
+  pg->lastBeatMs = nowMs;
+  if (freezeAll) return;
+  if (pg->beat > 0 && gap > pg->gapMaxMs) pg->gapMaxMs = gap;  // a frozen stretch moves lastBeatMs: not a gap
+  gdakiCtrlWordStore(&pg->head->watchBeat, ++pg->beat);
+  if (!freezeHelper) {
+    const int64_t hb = r->ts->heartbeatUs.load(std::memory_order_acquire);
+    gdakiCtrlWordStore(&pg->head->helperBeat, (uint64_t)hb);
+  }
+  const int64_t bz = r->ts->busySinceUs.load(std::memory_order_acquire);
+  const int64_t fw = r->fwSinceUs.load(std::memory_order_acquire);
+  gdakiCtrlWordStore(&pg->head->helperBusy, gdakiCtrlBusyOf(&pg->busy, bz, r->ts->roundMs, fw, r->ts->fwMs));
+  if (pg->selfIncAtMs < 0 || nowMs - pg->selfIncAtMs >= 10.0) {  // the global lineage mutex at most every 10 ms (nit 1)
+    pg->selfInc = gdakiRsSelfInc(r);
+    pg->selfIncAtMs = nowMs;
+  }
+  gdakiCtrlWordStore(&pg->head->incNonce, gdakiCtrlIncNonce(pg->selfInc, r->ts->nonce));
+  gdakiCtrlWordStore(&pg->head->flags, gdakiCtrlPageFlags(false, true, gdakiMiOn(r)));
+  // staleMs[q]: this rank's view of q (the larger of its two beats' stalls), for the other ranks' partition guard (one
+  // writer: this thread; design 3.4, REVIEW_P12 막는 문제 3)
+  uint64_t* sw = (uint64_t*)((uint8_t*)pg->page + pg->layout.staleMsOff);
+  for (int q = 0; q < (int)pg->peers.size(); q++) {
+    const struct gdakiCtrlPeerProbe& pp = pg->peers[(size_t)q];
+    const bool seen = q != pg->me && pp.watchStale.have;  // "never seen" is its own value (REVIEW_FIX12_P2B 고칠 것 2)
+    double s = seen ? std::max(nowMs - pp.watchStale.firstMs, pp.helperStale.have ? nowMs - pp.helperStale.firstMs : 0.0) : 0;
+    if (seen && pp.devRkey != 0 && pp.devStale.have) s = std::max(s, nowMs - pp.devStale.firstMs);  // live: the GPU's
+    gdakiCtrlWordStore(&sw[q], gdakiCtrlStaleWord(seen, s));
+  }
+}
+
+// One signaled READ of `bytes` of the peer's page into `local` (this peer's slot of the READ buffer). 0 posted. Live:
+// `dev` reads the peer's device progress line instead (remote address 0 of its MR, the rkey its page named).
+static int gdakiProbePost(struct gdakiCtrlPage* pg, struct gdakiCtrlPeerProbe& pp, uint8_t* local, uint32_t bytes,
+                          uint64_t wrId, bool dev = false) {
+  if (pp.qp.q == nullptr || pp.qp.q->qp == nullptr || !pp.haveRemote || !gdakiCtrlProbeCanPost(&pp.io, 1)) return -1;
+  if (dev && (pp.devRkey == 0 || bytes > pp.devLen)) return -1;
+  struct ibv_sge sg;
+  memset(&sg, 0, sizeof(sg));
+  sg.addr = (uint64_t)(uintptr_t)local;
+  sg.length = bytes;
+  sg.lkey = pg->rdMr->lkey;
+  struct ibv_send_wr wr, *bad = nullptr;
+  memset(&wr, 0, sizeof(wr));
+  wr.wr_id = wrId;
+  wr.sg_list = &sg;
+  wr.num_sge = 1;
+  wr.opcode = IBV_WR_RDMA_READ;
+  wr.send_flags = IBV_SEND_SIGNALED;
+  wr.wr.rdma.remote_addr = dev ? 0 : pp.remotePage.addr;
+  wr.wr.rdma.rkey = dev ? pp.devRkey : pp.remotePage.rkey;
+  if (wrap_ibv_post_send(pp.qp.q->qp, &wr, &bad) != ncclSuccess) return -1;
+  pp.qp.q->outstanding++;
+  return 0;
+}
+// The QP broke (an error completion of this generation, or a failed post): its software state, and the helper's word
+// (the pairing re-pairs it).
+static void gdakiProbeBroke(struct gdakiCtrlPeerProbe& pp) {
+  if (!pp.qp.connected) return;  // already: the first error of the generation counts
+  const uint32_t gen = pp.qp.gen;
+  gdakiProbeQpOnError(&pp.qp);
+  pp.errGenPlus1.store(gen + 1u, std::memory_order_release);
+}
+// The handoff, the watch thread's part (struct gdakiCtrlProbeHand; REVIEW_FIX12_P2B 막는 문제 2, 고칠 것 1, 4, 9), under the
+// page mutex, with no firmware command: apply a result, take the hold start's ERR, plan a new request.
+static void gdakiProbeHandWatch(struct gdakiCtrlPeerProbe& pp) {
+  struct gdakiCtrlProbeHand& h = pp.hand;
+  if (h.phase == GDAKI_CTRL_PH_BACK) {  // the helper's firmware is done: the software state follows it
+    const struct gdakiCtrlProbeReq& q = pp.req;
+    if (h.plan != GDAKI_CTRL_PP_REUSE) gdakiCtrlProbeIoReset(&pp.io);  // drained, or a new QP: nothing old completes
+    if (pp.res.ok && q.op == GDAKI_CTRL_PO_PREPARE) pp.preparedGen = q.gen;
+    if (pp.res.ok && q.op == GDAKI_CTRL_PO_CONNECT) {
+      pp.remotePage = q.page;
+      pp.haveRemote = q.page.addr != 0 && q.page.rkey != 0 && q.page.len >= sizeof(struct gdakiCtrlPageHead);
+      pp.incExp = q.incNonce;
+      pp.watchStale = gdakiCtrlStale();
+      pp.helperStale = gdakiCtrlStale();
+      pp.busy = gdakiCtrlBusySeen();
+      pp.lastCls = GDAKI_CTRL_CQ_OK;
+      pp.pageOk = true;
+      pp.witnessUnknown = false;
+      pp.devRkey = pp.devLen = 0;  // live: the device line again from this pairing's page (another process may answer)
+      pp.devSeen = pp.devRose = pp.devQuiet = false;
+      pp.devStale = gdakiCtrlStale();
+      pp.pairCls = GDAKI_CTRL_CQ_OK;
+      pp.nextReadMs = gdakiQ4MonoMs();
+      pp.holdErr.store(false, std::memory_order_release);  // a new connection of a current incarnation
+    }
+    gdakiCtrlHandBack(&h);
+  }
+  if (pp.toErrReq) {  // the hold start's ERR (the helper moved the QP): no re-pairing word, the window cannot confirm
+    pp.toErrReq = false;
+    pp.haveRemote = false;
+    pp.preparedGen = 0;  // a later CONNECT resets with a fresh PSN anyway (REVIEW_FIX12_P2B nit 9)
+    gdakiCtrlWindowQpLost(&pp.win);
+    if (gdakiCtrlHandWatchOwns(&h)) gdakiProbeQpOnError(&pp.qp);
+  }
+  if (h.phase == GDAKI_CTRL_PH_NEW) {
+    const bool haveQp = pp.qp.q != nullptr && pp.qp.q->qp != nullptr;
+    if (gdakiCtrlHandTake(&h, haveQp, pp.qp.connected, haveQp && pp.qp.q->err, pp.preparedGen, pp.io.outstanding)) {
+      gdakiCtrlWindowQpLost(&pp.win);  // this rank's own re-pairing: the window cannot confirm (never NORESP)
+      gdakiProbeQpOnError(&pp.qp);     // no post from now; not a break (no re-pairing word)
+    }
+    pp.preparedGen = 0;
+  }
+  pp.watchOwns = gdakiCtrlHandWatchOwns(&h);
+}
+// The handoff, the helper's part: the ERR of a DRAIN plan, and the firmware of a request in FW (the page mutex is not
+// held while a command runs). Called from the helper's step and while it waits for an answer.
+static void gdakiProbeHandHelper(struct gdakiRecHost* r, struct gdakiCtrlPage* pg, int p) {
+  struct gdakiCtrlPeerProbe& pp = pg->peers[(size_t)p];
+  struct gdakiCtrlProbeHand h;
+  struct gdakiCtrlProbeReq q;
+  uint32_t rjAccInc = 0;
+  {
+    std::lock_guard<std::mutex> lk(pg->mu);
+    if (pp.hand.phase != GDAKI_CTRL_PH_ERR && pp.hand.phase != GDAKI_CTRL_PH_FW) return;
+    h = pp.hand;
+    q = pp.req;
+    rjAccInc = pp.rjAccInc;
+  }
+  struct ibv_qp_attr a;
+  memset(&a, 0, sizeof(a));
+  a.qp_state = IBV_QPS_ERR;
+  if (h.phase == GDAKI_CTRL_PH_ERR) {  // the watch thread collects the flushes next (the QP stays its own meanwhile)
+    if (pp.qp.q != nullptr && pp.qp.q->qp != nullptr) (void)wrap_ibv_modify_qp(pp.qp.q->qp, &a, IBV_QP_STATE);
+    pp.helperFw++;
+    std::lock_guard<std::mutex> lk(pg->mu);
+    gdakiCtrlHandErrDone(&pp.hand, gdakiQ4MonoMs());
+    return;
+  }
+  // FW: the QP is the helper's until BACK
+  struct gdakiCtrlProbeRes res;
+  res.seq = q.seq;
+  res.gen = q.gen;
+  const uint32_t inc = gdakiCtrlIncOf(q.incNonce);
+  // smoke2 fix: the UD REJOIN's CONNECT (gdakiCtrlRjAcceptStep) comes while the hold still knows the dead incarnation
+  // (HOLD_WAIT; ln4 raises the known one after the REJOIN_ACK): its successor dead + 1 under acceptance is taken as current
+  const struct gdakiLnView lv = gdakiLnOf(r, p);
+  const uint32_t lcls = gdakiLnClassify(lv, inc);
+  const bool lnCur = q.op != GDAKI_CTRL_PO_CONNECT || lcls == GDAKI_LN_CURRENT ||
+                     (lcls == GDAKI_LN_FUTURE && lv.phase == GDAKI_LN_HOLD_WAIT && inc == lv.dead + 1u && inc == rjAccInc);
+  const bool haveQp = pp.qp.q != nullptr && pp.qp.q->qp != nullptr;
+  const uint32_t fw = gdakiCtrlProbeFwPlan(&h, haveQp, lnCur);
+  char why[128] = {0};
+  if (fw & (GDAKI_CTRL_FW_REFUSE_HOLD | GDAKI_CTRL_FW_REFUSE_LINEAGE)) {
+    // never RTS toward an old incarnation (design 4.4's invariant; REVIEW_FIX12_P2B 고칠 것 1): the QP stays in ERR, or a
+    // new one (not RTS) replaces one whose drain gave up
+    if (fw & GDAKI_CTRL_FW_NEWQP) {
+      gdakiProbeQpDestroy(&pp.qp);
+      if (gdakiProbeQpCreate(r, p, &pp.qp, why, sizeof(why)) != ncclSuccess)
+        WARN("GIN/RC: rank %d: a new liveness READ QP to rank %d could not be created (%s) mono_ms=%.3f", pg->me, p, why,
+             gdakiQ4MonoMs());
+      pp.helperFw += 2;
+    } else if (haveQp) {
+      (void)wrap_ibv_modify_qp(pp.qp.q->qp, &a, IBV_QP_STATE);
+      pp.helperFw++;
+    }
+    gdakiProbeQpOnError(&pp.qp);
+    if (fw & GDAKI_CTRL_FW_REFUSE_HOLD) snprintf(res.why, sizeof(res.why), "the hold started: the request is dropped");
+    else snprintf(res.why, sizeof(res.why), "incarnation %u is not the lineage's current one: no CONNECT", inc);
+  } else {
+    bool ok = true;
+    if (fw & GDAKI_CTRL_FW_NEWQP) {  // its flushes did not come (or no QP): a new QP, nothing of the old one completes
+      gdakiProbeQpDestroy(&pp.qp);
+      pp.helperFw += 2;
+      if (gdakiProbeQpCreate(r, p, &pp.qp, why, sizeof(why)) != ncclSuccess) {
+        snprintf(res.why, sizeof(res.why), "a new liveness READ QP could not be created (%s)", why);
+        ok = false;
+      }
+    }
+    if (ok && (fw & GDAKI_CTRL_FW_RESET)) {
+      pp.helperFw += 2;
+      if (gdakiProbeQpReconnect(&pp.qp, nullptr, q.gen, why, sizeof(why)) != ncclSuccess) {
+        snprintf(res.why, sizeof(res.why), "%s", why);
+        ok = false;
+      }
+      while (ok && q.haveAvoid && pp.qp.local.psn == (q.avoidPsn & 0xffffffu)) {  // a fresh PSN (REVIEW_P12 nit 9)
+        pp.qp.q->psn = gdakiMiHostQpPsn();
+        pp.qp.local.psn = pp.qp.q->psn;
+      }
+    }
+    if (ok) pp.qp.gen = q.gen;
+    if (ok && (fw & GDAKI_CTRL_FW_CONNECT)) {
+      pp.helperFw += 2;
+      if (gdakiProbeQpConnect(&pp.qp, &q.remote, q.gen, why, sizeof(why)) != ncclSuccess) {
+        snprintf(res.why, sizeof(res.why), "%s", why);
+        ok = false;
+      }
+    }
+    if (ok) {
+      res.local = pp.qp.local;
+      res.ok = true;
+    }
+  }
+  std::lock_guard<std::mutex> lk(pg->mu);
+  if (fw & GDAKI_CTRL_FW_REFUSE_HOLD) pp.hand.refusedHold++;
+  if (fw & GDAKI_CTRL_FW_REFUSE_LINEAGE) pp.hand.refusedLineage++;
+  pp.res = res;
+  gdakiCtrlHandFwDone(&pp.hand);
+}
+
+// One judgement of peer p from what this reader knows now (the watch thread); `wEnds` with the window verdict `cw` at
+// t_F + W. A stall verdict goes into the helper's mailbox once per incarnation (the latch).
+static void gdakiProbeJudge(struct gdakiRecHost* r, struct gdakiCtrlPage* pg, int p, double nowMs, bool wEnds, uint32_t cw) {
+  struct gdakiCtrlPeerProbe& pp = pg->peers[(size_t)p];
+  struct gdakiCtrlRFacts f;
+  f.probeOff = pg->probeMs == 0;
+  f.lastCls = pp.lastCls;
+  f.timedOut = pp.io.periodicOut && pp.io.timeoutSeen;
+  f.okInGen = pp.watchOwns && gdakiProbeQpOkInGen(&pp.qp);
+  f.pageOk = pp.pageOk;
+  f.watchRose = pp.watchRose;
+  f.watchStaleMs = pp.watchStale.have ? pp.watchStale.lastMs - pp.watchStale.firstMs : 0;
+  f.helperStaleMs = pp.helperStale.have ? pp.helperStale.lastMs - pp.helperStale.firstMs : 0;
+  f.busy = gdakiCtrlBusySeenAt(&pp.busy, nowMs, &f.busyOverMs);
+  f.suspectMs = (double)pg->suspectMs;
+  f.stallMs = (double)pg->stallMs;
+  f.devMode = pp.devRkey != 0;  // live: the GPU's progress (R (2)-(5)) from the device line; the beats are R (6)-(9)
+  f.devOk = pp.devSeen;
+  f.devStaleMs = pp.devStale.have ? pp.devStale.lastMs - pp.devStale.firstMs : 0;
+  // the partition guard: the other survivors' view of p (their page word staleMs[p], from this rank's last READ of them)
+  double others[GDAKI_CTRL_PAGE_MAX_RANKS];
+  bool valid[GDAKI_CTRL_PAGE_MAX_RANKS];
+  int no = 0;
+  for (int k = 0; k < (int)pg->peers.size() && no < (int)GDAKI_CTRL_PAGE_MAX_RANKS; k++) {
+    if (k == pg->me || k == p || !pg->peers[(size_t)k].hasQp) continue;  // hasQp: k's QP may be the helper's now
+    const struct gdakiCtrlPeerProbe& pk = pg->peers[(size_t)k];
+    others[no] = pk.theirStale.size() > (size_t)p ? pk.theirStale[(size_t)p] : -1.0;
+    const double kStale = pk.watchStale.have ? pk.watchStale.lastMs - pk.watchStale.firstMs : 1e18;
+    valid[no] = nowMs - pk.lastOkMs <= 3.0 * pg->probeMs && kStale < (double)pg->suspectMs && pk.pageOk;
+    no++;
+  }
+  const uint32_t guard = gdakiCtrlPartitionGuard(others, valid, no, (double)pg->stallMs, (double)pg->probeMs);
+  f.guardOk = guard == GDAKI_CTRL_PG_PASS;
+  const int64_t mv = pp.rmsnMoveUs.load(std::memory_order_acquire);
+  f.vetoClear = mv == 0 || nowMs - (double)mv / 1000.0 > (double)pg->vetoMs;
+  const uint32_t R = gdakiCtrlRDerive(f);
+  const uint32_t inc = gdakiCtrlIncOf(pp.incExp);
+  // gin-control (launcher) [3] (REVIEW_P3 고칠 것 1): LEFT, the end (EXITED or FENCED) and the registration word of p's
+  // incarnation, as the launcher link took them (CURRENT or HELD_OLD); 2a-2-C step 4: pullOk and the registration word
+  // from the pull of p's node launcher's page (gdakiCtrlLaPullInputs: the page's word, not the REG_NOTE's, says "that
+  // process is there"), so rows 10-12 part on L
+  bool lLeft, lEnded, lPullOk, lRegAlive, lRegLeft;
+  gdakiCtrlLaLInputs(r, p, inc, &lLeft, &lEnded, &lRegAlive, &lRegLeft);
+  gdakiCtrlLaPullInputs(r, p, inc, &lPullOk, &lRegAlive, &lRegLeft);
+  const uint32_t L = gdakiCtrlLOf(pg->launcherPaired.load(std::memory_order_acquire), lLeft, lEnded, lPullOk, lRegAlive,
+                                  lRegLeft);
+  const uint32_t B = pp.byeSeen ? GDAKI_CTRL_B_SEEN : GDAKI_CTRL_B_NONE;
+  const uint32_t W = gdakiCtrlWOf(pg->witnessOn, pp.win.state == GDAKI_CTRL_WS_OPEN, wEnds, cw, pp.witnessUnknown);
+  pp.last = gdakiCtrlJudge(L, B, W, R);
+  if (pp.last.row == 18 && !pp.suspectLogged) {
+    pp.suspectLogged = true;
+    const bool helper = R == GDAKI_CTRL_R_HELPER_SUSPECT || R == GDAKI_CTRL_R_HELPER_GUARDED;
+    const bool hostWatch = f.devMode && helper && f.watchStaleMs >= f.suspectMs;
+    GIN_TS_NOTE("GIN/RC: rank %d: rank %d suspected (kind=%s stale_ms=%.1f)%s mono_ms=%.3f", pg->me, p,
+                helper ? (hostWatch ? "watch" : "helper") : f.devMode ? "gpu" : "watch",
+                helper ? (hostWatch ? f.watchStaleMs : f.helperStaleMs) : f.devMode ? f.devStaleMs : f.watchStaleMs,
+                guard == GDAKI_CTRL_PG_FRESH  ? " (partition guard: another survivor sees it fresh)"
+                : guard == GDAKI_CTRL_PG_SELF ? " (partition guard: no other survivor readable; this rank suspects itself)"
+                : !f.vetoClear && !helper     ? " (the data path's veto: its responder count moved)"
+                                              : "",
+                nowMs);
+  } else if (pp.last.row == 20) {
+    pp.suspectLogged = false;
+  }
+  if ((pp.last.verdict == GDAKI_CTRL_V_STALL || pp.last.verdict == GDAKI_CTRL_V_STALL_HELPER) && pp.latchedInc != inc + 1u) {
+    pp.latchedInc = inc + 1u;  // the latch: once per incarnation
+    pp.stallMail.store(gdakiCtrlMailPack(pp.last.row, pp.last.verdict, pp.last.cause, inc), std::memory_order_release);
+  }
+  if (gdakiCtrlEffReadRow(pp.last.row) && pp.readLatchedInc != inc + 1u) {  // smoke3: the READ failure path, once
+    pp.readLatchedInc = inc + 1u;
+    pp.readMail.store(gdakiCtrlMailPack(pp.last.row, pp.last.verdict, pp.last.cause, inc), std::memory_order_release);
+  }
+}
+// A window's verdict at t_F + W (or at once when it cannot confirm): the judgement with W = the window's end, a line,
+// the helper's mailbox; the witness is unknown from now (rows 8, 9).
+static void gdakiProbeWindowEnd(struct gdakiRecHost* r, struct gdakiCtrlPage* pg, int p, double nowMs) {
+  struct gdakiCtrlPeerProbe& pp = pg->peers[(size_t)p];
+  const uint32_t cw = gdakiCtrlWindowJudge(&pp.win, pp.incExp, nowMs);
+  static const char* kName[] = {"alive", "STALE", "NORESP", "REMACC", "unconfirmed"};
+  GIN_TS_NOTE("GIN/RC: rank %d: confirm window for rank %d closed: %s (opened by %s at %.3f, READ1 %s%.3f, READ2 %s%.3f, "
+              "W=%d, step_gap_max_ms=%.3f%s) mono_ms=%.3f", pg->me, p, kName[cw <= 4 ? cw : 4],
+              gdakiCtrlWsrcName(pp.win.src), pp.win.tF, pp.win.r1Done ? "+" : "not done ",
+              pp.win.r1Done ? pp.win.r1Ms - pp.win.tF : 0.0, pp.win.r2Done ? "+" : "not done ",
+              pp.win.r2Done ? pp.win.r2Ms - pp.win.tF : 0.0, pg->wMs, pp.win.stepGapMaxMs,
+              pp.win.lateReader ? ", late reader" : "", nowMs);
+  gdakiProbeJudge(r, pg, p, nowMs, true, cw);
+  if (pp.win.src != GDAKI_CTRL_WSRC_ENDED)
+    pp.winMail.store(gdakiCtrlMailPack(pp.last.row, pp.last.verdict, pp.last.cause, gdakiCtrlIncOf(pp.incExp)),
+                     std::memory_order_release);
+  pp.witnessUnknown = true;  // the FIN or RST is spent (design 4.2 W: 모름)
+}
+
+// One peer's probe, run by the watch thread every step: the handoff, the completions by wr_id, the periodic READ (one at
+// a time), its timeout, the window, the judgement.
+static void gdakiProbePeerStep(struct gdakiRecHost* r, struct gdakiCtrlPage* pg, int p, double nowMs) {
+  struct gdakiCtrlPeerProbe& pp = pg->peers[(size_t)p];
+  uint32_t wsrc = 0;
+  double wtf = 0;
+  {
+    std::lock_guard<std::mutex> lk(pg->mu);
+    gdakiProbeHandWatch(pp);  // the handoff: no firmware command here (REVIEW_FIX12_P2B 고칠 것 4)
+    if (pp.winReqSeq != pp.winSeen) {
+      pp.winSeen = pp.winReqSeq;
+      wsrc = pp.winReqSrc;
+      wtf = pp.winReqMs;
+    }
+  }
+  // the completions, each matched by its wr_id (REVIEW_P12 막는 문제 4, 5); a QP in the helper's hands is not touched
+  struct ibv_wc wc[8];
+  int n = 0;
+  if (pp.watchOwns && pp.qp.q != nullptr && pp.qp.q->cq != nullptr && pp.io.outstanding > 0 &&
+      wrap_ibv_poll_cq(pp.qp.q->cq, 8, wc, &n) == ncclSuccess) {
+    for (int k = 0; k < n; k++) {
+      const uint64_t id = wc[k].wr_id;
+      const uint32_t kind = gdakiCtrlProbeWrKind(id), seq = gdakiCtrlProbeWrSeq(id);
+      const uint32_t cls = gdakiCtrlProbeCqeClass((int)wc[k].status);
+      if (pp.qp.q->outstanding > 0) pp.qp.q->outstanding--;
+      const bool ofPair = gdakiCtrlProbeIsPeriodic(&pp.io, kind, seq);  // live: the page READ or the device line's
+      const bool pairDone = gdakiCtrlProbeOnCqe(&pp.io, kind, seq);
+      const bool thisGen = gdakiCtrlProbeWrGenIs(id, pp.qp.gen) && pp.qp.connected;
+      // the first error of this generation is a break (the pairing re-pairs), not the hold start's own ERR
+      if (cls != GDAKI_CTRL_CQ_OK && thisGen && !pp.holdErr.load(std::memory_order_acquire)) gdakiProbeBroke(pp);
+      if (!gdakiCtrlProbeWrGenIs(id, pp.qp.gen)) continue;           // an older generation's: its slot only
+      if (ofPair) {
+        const bool devRead = kind == GDAKI_CTRL_PW_DEV;
+        if (devRead) pp.devReads++;
+        else pp.reads++;
+        if (cls == GDAKI_CTRL_CQ_OK) {
+          gdakiProbeQpOnSuccess(&pp.qp, pp.qp.gen);
+          pp.okGen.store(pp.qp.gen, std::memory_order_release);
+        }
+        if (cls == GDAKI_CTRL_CQ_OK && devRead) {
+          if (pp.pageOk && pp.devRkey != 0) {  // live: the GPU's stall clock, from the line the same pair's page named
+            const struct gdakiCtrlDevSum d = gdakiCtrlDevSumOf(gdakiPageDevRd(pg, p), pp.devLen, pg->devStride,
+                                                                 pg->devOffPosted, pg->devOffPolled);
+            (void)gdakiCtrlDevOnRead(&pp.devStale, d, nowMs, (double)pg->probeMs, &pp.devRose, &pp.devQuiet);
+            pp.devSeen = true;
+            pp.devOkN++;
+            if (pp.devQuiet) pp.devQuietN++;
+          }
+        } else if (cls == GDAKI_CTRL_CQ_OK) {
+          const uint8_t* b = gdakiPageRd(pg, p);
+          struct gdakiCtrlPageHead h;
+          memcpy(&h, b, sizeof(h));  // REVIEW_P12 nit 6: a copy, not a cast
+          pp.ok++;
+          if (pp.latUs.size() < 65536) pp.latUs.push_back((float)((nowMs - pp.postMs) * 1000.0));
+          pp.lastOkMs = nowMs;
+          pp.pageOk = h.incNonce == pp.incExp;  // design 3.2: another process's page is never the stall clock's
+          if (!pp.pageOk) {
+            pp.otherInc++;
+          } else {
+            (void)gdakiCtrlStaleOnRead(&pp.watchStale, h.watchBeat, nowMs, (double)pg->probeMs, &pp.watchRose);
+            (void)gdakiCtrlStaleOnRead(&pp.helperStale, h.helperBeat, nowMs, (double)pg->probeMs);
+            double over = 0;
+            (void)gdakiCtrlBusySeenStep(&pp.busy, h.helperBusy, nowMs, &over);
+            pp.byeSeen = pp.byeSeen || (h.flags & GDAKI_CTRL_PF_LEAVING) != 0;
+            uint64_t w[GDAKI_CTRL_PAGE_MAX_RANKS];
+            const size_t nw = std::min(pp.theirStale.size(), (size_t)GDAKI_CTRL_PAGE_MAX_RANKS);
+            if (pg->layout.staleMsOff + 8u * nw <= pg->layout.bytes) {
+              memcpy(w, b + pg->layout.staleMsOff, 8u * nw);
+              for (size_t i = 0; i < nw; i++) pp.theirStale[i] = gdakiCtrlStaleOfWord(w[i]);
+            }
+            // live: the device line this process's page names (a line of another layout is not read: devBad)
+            const uint64_t dl = h.devLine;
+            const bool fits = dl != 0 && gdakiCtrlDevLineBytes(dl) == pg->devBytes;
+            if (dl != 0 && !fits) pp.devBad++;
+            const uint32_t rk = fits ? gdakiCtrlDevLineRkey(dl) : 0u;
+            if (rk != pp.devRkey) {
+              pp.devRkey = rk;
+              pp.devLen = rk != 0 ? gdakiCtrlDevLineBytes(dl) : 0u;
+              pp.devSeen = pp.devRose = pp.devQuiet = false;
+              pp.devStale = gdakiCtrlStale();
+              const struct gdakiCtrlDev* dv = r->ctrl != nullptr ? r->ctrl->dev : nullptr;
+              const uint32_t agRk = dv != nullptr && (size_t)p < dv->ag.size() ? dv->ag[(size_t)p].rkey : 0u;
+              if (rk != 0 && agRk != rk) pp.devAgDiff++;  // another incarnation than the setup's, or none at the setup
+              GIN_TS_NOTE("GIN/RC: rank %d: rank %d's device progress line %s (rkey=0x%x %u B; setup all-gather rkey=0x%x) "
+                          "mono_ms=%.3f", pg->me, p, rk != 0 ? "named" : "none", rk, pp.devLen, agRk, nowMs);
+            }
+          }
+        } else {
+          if (pp.pairCls == GDAKI_CTRL_CQ_OK) pp.pairCls = cls;  // the pair's first error decides (the next is a flush)
+          if (cls == GDAKI_CTRL_CQ_REMACC) pp.remacc++;
+          else if (cls == GDAKI_CTRL_CQ_NORESP) pp.noresp++;
+          else pp.broken++;
+          WARN("GIN/RC: rank %d: liveness READ of rank %d%s: %s (status %d) mono_ms=%.3f", pg->me, p,
+               devRead ? " (device line)" : "", gdakiCtrlCqClassName(cls), (int)wc[k].status, nowMs);
+        }
+        if (pairDone) {  // live: the pair complete (one READ without a device line): R's facts, then the judgement
+          pp.lastCls = pp.pairCls;
+          pp.pairCls = GDAKI_CTRL_CQ_OK;
+          gdakiProbeJudge(r, pg, p, nowMs, false, 0);
+        }
+      } else if (kind == GDAKI_CTRL_PW_WIN1 || kind == GDAKI_CTRL_PW_WIN2) {
+        const uint32_t which = kind == GDAKI_CTRL_PW_WIN1 ? 1u : 2u;
+        struct gdakiCtrlPageHead h;
+        memset(&h, 0, sizeof(h));
+        if (cls == GDAKI_CTRL_CQ_OK) {  // smoke3: line 0's watchBeat (the host's), never the device line
+          memcpy(&h, gdakiPageRd(pg, p) + gdakiPageWinOff(pg, which), sizeof(h));
+          gdakiProbeQpOnSuccess(&pp.qp, pp.qp.gen);
+          pp.okGen.store(pp.qp.gen, std::memory_order_release);  // a success of this generation (REVIEW_FIX12_P2B nit 8)
+        }
+        (void)gdakiCtrlWindowOnCqe(&pp.win, seq, which, cls, h.watchBeat, h.incNonce, nowMs);
+      }
+    }
+  }
+  {  // a drain: one poll per step, bounded (REVIEW_FIX12_P2B 고칠 것 4); then the QP is the helper's
+    std::lock_guard<std::mutex> lk(pg->mu);
+    if (gdakiCtrlHandDrain(&pp.hand, pp.io.outstanding, nowMs) == 1 && !pp.hand.drainOk) gdakiCtrlProbeIoReset(&pp.io);
+    pp.watchOwns = gdakiCtrlHandWatchOwns(&pp.hand);
+  }
+  // the periodic READ's timeout: a report (R (12)), the READ stays in flight
+  if (gdakiCtrlProbeTimedOut(&pp.io, nowMs, (double)pg->probeTimeoutMs)) {
+    pp.timeouts++;
+    GIN_TS_NOTE("GIN/RC: rank %d: probe of rank %d timed out (no CQE in %d ms) mono_ms=%.3f", pg->me, p,
+                pg->probeTimeoutMs, nowMs);
+    gdakiProbeJudge(r, pg, p, nowMs, false, 0);
+  }
+  // the window
+  if (wsrc != 0) {
+    // smoke3: the window confirms over the host's watch beat (line 0), whether or not the peer names a device line
+    const bool countable = pp.watchOwns && gdakiProbeQpOkInGen(&pp.qp) && pp.haveRemote && gdakiCtrlProbeCanPost(&pp.io, 2);
+    if (gdakiCtrlWindowOpen(&pp.win, wsrc, wtf, countable))
+      GIN_TS_NOTE("GIN/RC: rank %d: confirm window for rank %d opened by %s W=%d over the watch beat%s mono_ms=%.3f", pg->me,
+                  p, gdakiCtrlWsrcName(wsrc), pg->wMs, countable ? "" : " (cannot confirm: no READ of this generation)",
+                  nowMs);
+  }
+  // one window action per pass (REVIEW_FIX12_P2B 막는 문제 2: POST1, POST2 and the verdict never in one step)
+  const uint32_t wa = gdakiCtrlWindowStep(&pp.win, nowMs, (double)pg->wMs);
+  if (wa == GDAKI_CTRL_WA_JUDGE) {
+    gdakiProbeWindowEnd(r, pg, p, nowMs);
+  } else if (wa == GDAKI_CTRL_WA_POST1 || wa == GDAKI_CTRL_WA_POST2) {
+    const uint32_t which = wa == GDAKI_CTRL_WA_POST1 ? 1u : 2u;
+    bool ok = false;
+    if (pp.watchOwns && gdakiProbeQpIsRts(&pp.qp)) {  // pp.qp is read only while the watch thread owns it
+      const uint64_t id = gdakiCtrlProbeWrId(which == 1 ? GDAKI_CTRL_PW_WIN1 : GDAKI_CTRL_PW_WIN2, (uint32_t)p, pp.qp.gen,
+                                             pp.win.no);
+      ok = gdakiProbePost(pg, pp, gdakiPageRd(pg, p) + gdakiPageWinOff(pg, which),
+                          (uint32_t)sizeof(struct gdakiCtrlPageHead), id) == 0;
+    }
+    if (ok) gdakiCtrlProbeOnPosted(&pp.io, which == 1 ? GDAKI_CTRL_PW_WIN1 : GDAKI_CTRL_PW_WIN2, pp.win.no, nowMs);
+    gdakiCtrlWindowPosted(&pp.win, which, ok, nowMs);
+  }
+  // the periodic READ: one at a time (REVIEW_P12 막는 문제 4), never into the open window's reserved slots
+  if (pg->probeMs == 0 || !pp.haveRemote || !pp.watchOwns || !gdakiProbeQpIsRts(&pp.qp)) return;
+  const uint32_t reserve =
+      pp.win.state == GDAKI_CTRL_WS_OPEN ? (uint32_t)!pp.win.r1Posted + (uint32_t)!pp.win.r2Posted : 0u;
+  const bool devP = pp.devRkey != 0;  // live: the pair (the page, then the device line its last READ named)
+  const uint32_t seq = gdakiCtrlProbePeriodicDue(&pp.io, nowMs, pp.nextReadMs, reserve, devP ? 2u : 1u);
+  if (seq == 0) return;
+  pp.nextReadMs = nowMs + (double)pg->probeMs;
+  const uint32_t bytes = std::min<uint32_t>(pg->layout.bytes, pp.remotePage.len);
+  if (gdakiProbePost(pg, pp, gdakiPageRd(pg, p), bytes, gdakiCtrlProbeWrId(GDAKI_CTRL_PW_PERIODIC, (uint32_t)p, pp.qp.gen,
+                                                                           seq)) == 0) {
+    gdakiCtrlProbeOnPosted(&pp.io, GDAKI_CTRL_PW_PERIODIC, seq, nowMs);
+    pp.postMs = nowMs;
+    if (devP) {
+      if (gdakiProbePost(pg, pp, gdakiPageDevRd(pg, p), pp.devLen,
+                         gdakiCtrlProbeWrId(GDAKI_CTRL_PW_DEV, (uint32_t)p, pp.qp.gen, seq), true) == 0)
+        gdakiCtrlProbeOnPosted(&pp.io, GDAKI_CTRL_PW_DEV, seq, nowMs);
+      else
+        gdakiProbeBroke(pp);  // the page READ completes the period alone (its pair has one READ)
+    }
+  } else {
+    gdakiProbeBroke(pp);  // a failed post: the QP is not usable (the pairing re-pairs it)
+  }
+}
+
+// The watch-thread hook (one call from gdakiQ4Watch): the beat and each peer's probe. A no-op until the page is up.
+static void gdakiCtrlPageStep(struct gdakiRecHost* r) {
+  if (r == nullptr || r->ts == nullptr) return;  // only a context that asked for transparent recovery has a page
+  struct gdakiCtrlPage* pg = gdakiPageOf(r);
+  if (!gdakiPageUp(pg)) return;  // published complete on the setup thread (gdakiPageSetup)
+  const double nowMs = gdakiQ4MonoMs();
+  gdakiPageBeatStep(r, pg, nowMs);
+  if (pg->sumReq.load(std::memory_order_acquire) != 0) {  // smoke fix 2: the teardown asked for the summary
+    int want = 1;
+    if (pg->sumReq.compare_exchange_strong(want, 4, std::memory_order_acq_rel)) {
+      gdakiCtrlProbeSummary(r, pg);
+      pg->sumReq.store(2, std::memory_order_release);
+    }
+    return;  // the communicator is gone: the beat goes on (peers still read it), no more READs
+  }
+  for (int p = 0; p < (int)pg->peers.size(); p++)
+    if (p != pg->me && pg->peers[(size_t)p].hasQp) gdakiProbePeerStep(r, pg, p, nowMs);  // a lost QP still answers requests
+}
+
+// ---- the helper's side (helper thread only) ----
+// The window request: a witness FIN or RST with no BYE (gdakiTsSocketLost), or an end report for timing only; t_F is the
+// helper's clock now. The watch thread opens the window at its next step.
+static void gdakiCtrlWindowRequest(struct gdakiRecHost* r, int peer, uint32_t src) {
+  struct gdakiCtrlPage* pg = gdakiPageOf(r);
+  if (!gdakiPageUp(pg) || peer < 0 || peer >= (int)pg->peers.size() || peer == pg->me) return;
+  struct gdakiCtrlPeerProbe& pp = pg->peers[(size_t)peer];
+  std::lock_guard<std::mutex> lk(pg->mu);
+  pp.winReqMs = gdakiQ4MonoMs();
+  pp.winReqSrc = src;
+  pp.winReqSeq++;
+}
+// ---- the judgement's effect (phase 2a-2-C step 4; struct gdakiCtrlEff, helper only) ----
+static bool gdakiCtrlRingLiveOn(struct gdakiRecHost* r, int peer);  // the ring's (below): the pair's records go on it
+// The pair judges an exit by the table (its records go on the ring, the page and its liveness READ QP are up), not by
+// ln4's witness FIN.
+static bool gdakiCtrlEffOn(struct gdakiRecHost* r, int peer) {
+  struct gdakiCtrlPage* pg = gdakiPageOf(r);
+  if (pg == nullptr || peer < 0 || peer >= (int)pg->peers.size() || peer == pg->me) return false;
+  return gdakiCtrlEffective(gdakiCtrlRingLiveOn(r, peer), gdakiPageUp(pg), pg->peers[(size_t)peer].hasQp);
+}
+// The witness socket's end without ln4's verdict (the socket closes as ln4 closes an unknown peer's, with a reset; the
+// lineage's next step re-dials only after `redial`): pe's re-dial state as gdakiTsMakeUnknown leaves it.
+static void gdakiCtrlEffWitnessOff(struct gdakiTsPeer& pe, bool redial) {
+  gdakiTsMakeUnknown(pe);
+  pe.unknown = redial;
+}
+// The end of `peer`'s incarnation inc by the table (row 3-6's cause): ln4's death of a FIN (gone, judged dead; the
+// decline, which starts the hold when armed, now or by the caller: the helper loop, a round's liveness check), with the
+// table's cause as the hold's strong evidence (gdakiHoldStrongCause's rdma names).
+static void gdakiCtrlEffEnd(struct gdakiRecHost* r, int peer, uint32_t inc, const char* cause, const char* by,
+                            bool decline) {
+  struct gdakiTs* ts = r->ts;
+  if (ts == nullptr || peer < 0 || peer >= (int)ts->peers.size()) return;
+  struct gdakiTsPeer& pe = ts->peers[(size_t)peer];
+  if (pe.declined || pe.left || pe.deadJudged || gdakiHoldIsHeldState(gdakiHoldPeerState(r, peer, nullptr))) return;
+  snprintf(pe.lostCause, sizeof(pe.lostCause), "%s", cause);
+  gdakiCtrlEffWitnessOff(pe, false);
+  pe.gone = true;
+  pe.deadJudged = true;
+  ts->cDeaths.fetch_add(1, std::memory_order_relaxed);
+  WARN("GIN/TS: rank %d: rank %d judged dead (cause=%s) mono_ms=%.3f", r->ctx->rank, peer, cause, gdakiQ4MonoMs());
+  GIN_TS_NOTE("GIN/RC: rank %d: rank %d (incarnation %u) ended by the judgement table (%s): the hold or the decline now "
+              "mono_ms=%.3f", r->ctx->rank, peer, inc, by, gdakiQ4MonoMs());
+  if (!decline) return;
+  char why[96];
+  snprintf(why, sizeof(why), "peer judged dead: the judgement table shows %s", cause);
+  gdakiTsDecline(r, peer, why, false, 0, gdakiCause::PeerDead, GDAKI_UA_PEER_DEAD);
+}
+// gdakiTsSocketLost's first step (rdma build): a FIN without BYE of an effective pair only opens the confirm window (no
+// death; the socket closes, no re-dial until the verdict). False: ln4's rule (the caller goes on).
+static bool gdakiCtrlFinOpensWindow(struct gdakiRecHost* r, int peer, struct gdakiTsPeer& pe, const char* cause) {
+  struct gdakiCtrlPage* pg = gdakiPageOf(r);
+  if (pe.left || cause == nullptr || strcmp(cause, "FIN") != 0 || !gdakiCtrlEffOn(r, peer)) return false;
+  const uint32_t inc = gdakiLnOf(r, peer).cur;
+  const double now = gdakiQ4MonoMs();
+  const uint32_t a = gdakiCtrlEffOnFin(&pg->peers[(size_t)peer].eff, true, GDAKI_CTRL_WSRC_FIN, inc, now);
+  snprintf(pe.lostCause, sizeof(pe.lostCause), "FIN");
+  gdakiCtrlEffWitnessOff(pe, false);
+  GIN_TS_NOTE("GIN/TS: rank %d: socket to rank %d closed cause=FIN mono_ms=%.3f liveness=pending (the confirm window "
+              "judges: W=%d ms%s)", r->ctx->rank, peer, now, pg->wMs,
+              a == GDAKI_CTRL_EA_NONE ? ", the incarnation ended already" : "");
+  if (a == GDAKI_CTRL_EA_WINDOW) gdakiCtrlWindowRequest(r, peer, GDAKI_CTRL_WSRC_FIN);
+  return true;
+}
+// gdakiTsSocketLost's first step after the record QP's causes (smoke3): the witness off on an effective pair. The socket
+// closes with a reset and is not re-dialled; no window, no death, no unknown (true: the caller returns "no evidence").
+static bool gdakiCtrlWitnessMutedOf(struct gdakiRecHost* r, int peer) {
+  const struct gdakiCtrlPage* pg = gdakiPageOf(r);
+  return gdakiPageUp(pg) && gdakiCtrlWitnessMuted(gdakiCtrlEffOn(r, peer), pg->witnessOn, false);
+}
+static bool gdakiCtrlWitnessOffLost(struct gdakiRecHost* r, int peer, struct gdakiTsPeer& pe, const char* cause) {
+  if (cause == nullptr || pe.left || !gdakiCtrlWitnessMutedOf(r, peer)) return false;
+  snprintf(pe.lostCause, sizeof(pe.lostCause), "%s", cause);
+  gdakiCtrlEffWitnessOff(pe, false);
+  GIN_TS_NOTE("GIN/TS: rank %d: socket to rank %d closed cause=%s mono_ms=%.3f liveness=ignored (the witness is off: no "
+              "window, no judgement; the launcher's report or the READ failure path judges)", r->ctx->rank, peer, cause,
+              gdakiQ4MonoMs());
+  return true;
+}
+// gdakiTsSocketLost's hook (rdma build): the cause names of ln4's pump ("FIN"; ECONNRESET is the RST). An RST of an
+// effective pair is ln4's unknown (re-dialled) and its window's verdict reacts as a FIN's.
+static void gdakiCtrlOnSocketLost(struct gdakiRecHost* r, int peer, const char* cause, bool left) {
+  if (left || cause == nullptr) return;  // a BYE came first: the FIN is "left", no window (design 4.2 B)
+  if (strcmp(cause, "FIN") == 0) {
+    gdakiCtrlWindowRequest(r, peer, GDAKI_CTRL_WSRC_FIN);
+  } else if (strcmp(cause, "ECONNRESET") == 0) {
+    struct gdakiCtrlPage* pg = gdakiPageOf(r);
+    if (gdakiCtrlEffOn(r, peer) &&
+        gdakiCtrlEffOnFin(&pg->peers[(size_t)peer].eff, true, GDAKI_CTRL_WSRC_RST, gdakiLnOf(r, peer).cur,
+                          gdakiQ4MonoMs()) == GDAKI_CTRL_EA_NONE)
+      return;  // ended already
+    gdakiCtrlWindowRequest(r, peer, GDAKI_CTRL_WSRC_RST);
+  }
+}
+// The reaction to the window's verdict a (gdakiCtrlEffOnVerdict or gdakiCtrlEffOverdue) of an effective pair.
+static void gdakiCtrlEffReact(struct gdakiRecHost* r, int peer, uint32_t a, uint32_t row, uint32_t cause, uint32_t inc,
+                              uint32_t src, double tF, bool decline) {
+  struct gdakiCtrlPage* pg = gdakiPageOf(r);
+  const double now = gdakiQ4MonoMs();
+  if (a == GDAKI_CTRL_EA_END) {
+    char by[64];
+    snprintf(by, sizeof(by), "table row %u, %.3f ms after the %s", row, now - tF, gdakiCtrlWsrcName(src));
+    gdakiCtrlEffEnd(r, peer, inc, gdakiCtrlCauseName(cause), by, decline);
+    return;
+  }
+  if (a != GDAKI_CTRL_EA_REDIAL && a != GDAKI_CTRL_EA_WAIT) return;
+  struct gdakiTsPeer& pe = r->ts->peers[(size_t)peer];
+  const bool redial = !pe.unknown && !pe.gone && !pe.declined;
+  if (redial) gdakiCtrlEffWitnessOff(pe, true);
+  if (a == GDAKI_CTRL_EA_REDIAL)
+    GIN_TS_NOTE("GIN/RC: rank %d: witness of rank %d lost; liveness alive mono_ms=%.3f (table row 8%s)", pg->me, peer, now,
+                redial ? "; the witness is re-dialled" : "");
+  else if (row != 0)
+    GIN_TS_NOTE("GIN/RC: rank %d: confirm window of rank %d: table row %u, no verdict (%.3f ms after the %s); the witness "
+                "is unknown%s, the launcher's report decides mono_ms=%.3f", pg->me, peer, row, now - tF,
+                gdakiCtrlWsrcName(src), redial ? " and re-dialled" : "", now);
+  else
+    GIN_TS_NOTE("GIN/RC: rank %d: confirm window of rank %d: no verdict %.3f ms after the %s (bound %d ms); the witness is "
+                "unknown%s, the launcher's report decides mono_ms=%.3f", pg->me, peer, now - tF, gdakiCtrlWsrcName(src),
+                pg->wMs + pg->probeTimeoutMs, redial ? " and re-dialled" : "", now);
+}
+// One peer's effect step (helper): the window's mailbox (an effective pair's verdict reacts; any other is reported), the
+// overdue bound of a pending window, and the launcher's end (the link's fence word of the lineage's incarnation: an
+// effective pair ends at once, row 3, window or not). decline: the hold or the decline now (the helper's step), else the
+// caller's (gdakiTsPeerLiveness: a round's liveness check sees the peer dead).
+static void gdakiCtrlEffPoll(struct gdakiRecHost* r, int p, bool decline) {
+  struct gdakiCtrlPage* pg = gdakiPageOf(r);
+  if (!gdakiPageUp(pg) || r->ts == nullptr || p < 0 || p >= (int)pg->peers.size() || p >= (int)r->ts->peers.size() ||
+      p == pg->me)
+    return;
+  struct gdakiCtrlPeerProbe& pp = pg->peers[(size_t)p];
+  struct gdakiCtrlEff& e = pp.eff;
+  const uint32_t cur = gdakiLnOf(r, p).cur;
+  const uint64_t wm = pp.winMail.exchange(0, std::memory_order_acq_rel);
+  if (wm != 0) {
+    const uint32_t row = gdakiCtrlMailRow(wm), inc = gdakiCtrlMailInc(wm), src = e.src;
+    const double tF = e.tF;
+    const bool done = e.doneInc1 == inc + 1u;
+    const uint32_t a = inc == cur ? gdakiCtrlEffOnVerdict(&e, row, inc) : GDAKI_CTRL_EA_NONE;
+    if (a != GDAKI_CTRL_EA_NONE)
+      gdakiCtrlEffReact(r, p, a, row, gdakiCtrlMailCause(wm), inc, src, tF, decline);
+    else if (row == 8 && !done)
+      GIN_TS_NOTE("GIN/RC: rank %d: witness of rank %d lost; liveness alive mono_ms=%.3f (table row 8)", pg->me, p,
+                  gdakiQ4MonoMs());
+    else
+      GIN_TS_NOTE("GIN/RC: rank %d: confirm window of rank %d: table row %u%s%s; %s mono_ms=%.3f", pg->me, p, row,
+                  gdakiCtrlMailCause(wm) != GDAKI_CTRL_C_NONE ? ", cause " : "", gdakiCtrlCauseName(gdakiCtrlMailCause(wm)),
+                  done ? "the incarnation ended already (no reaction)"
+                  : inc != cur ? "another incarnation's window (no reaction)"
+                               : "reported only (the pair keeps ln4's witness rule: its records are not on a live ring)",
+                  gdakiQ4MonoMs());
+  }
+  {
+    const uint32_t src = e.src;
+    const double tF = e.tF;
+    const uint32_t a = gdakiCtrlEffOverdue(&e, gdakiQ4MonoMs(), (double)(pg->wMs + pg->probeTimeoutMs));
+    if (a != GDAKI_CTRL_EA_NONE) gdakiCtrlEffReact(r, p, a, 0, GDAKI_CTRL_C_NONE, cur, src, tF, decline);
+  }
+  bool left, ended, alive, lft;
+  gdakiCtrlLaLInputs(r, p, cur, &left, &ended, &alive, &lft);
+  if (!ended || left || e.doneInc1 == cur + 1u) return;
+  const bool pend = e.pendInc1 == cur + 1u;
+  const double tF = e.tF;
+  if (gdakiCtrlEffOnEnded(&e, gdakiCtrlEffOn(r, p), cur) != GDAKI_CTRL_EA_END) return;
+  char by[96];
+  if (pend)
+    snprintf(by, sizeof(by), "row 3: the launcher's end %.3f ms after the %s, before the window's verdict",
+             gdakiQ4MonoMs() - tF, gdakiCtrlWsrcName(e.src));
+  else
+    snprintf(by, sizeof(by), "row 3: the launcher's end");
+  gdakiCtrlEffEnd(r, p, cur, gdakiCtrlCauseName(GDAKI_CTRL_C_EXITED), by, decline);
+}
+// Every peer's effect step after the launcher's envelopes (gdakiCtrlLauncherStep; no lock held).
+static void gdakiCtrlEffEndedStep(struct gdakiRecHost* r) {
+  struct gdakiCtrlPage* pg = gdakiPageOf(r);
+  if (!gdakiPageUp(pg)) return;
+  for (int p = 0; p < (int)pg->peers.size(); p++) gdakiCtrlEffPoll(r, p, true);
+}
+// The data path's veto input (the helper's QP watch, gdakiDetWatchStep): the peer's responder count on this rank's QP
+// moved since the last sample, i.e. the peer's GPU still sends (EXPERIMENT.md 9.3: NCCL_GIN_TS_STALL_RMSN_MS). Without
+// the QP watch (NCCL_GIN_TS_QPWATCH_MS = 0) no sample comes and the veto stays clear.
+static void gdakiCtrlVetoObserve(struct gdakiRecHost* r, int peer, int qpIdx, uint32_t rmsn) {
+  struct gdakiCtrlPage* pg = gdakiPageOf(r);
+  if (!gdakiPageUp(pg) || peer < 0 || peer >= (int)pg->peers.size() || qpIdx < 0) return;
+  static thread_local std::vector<uint32_t> lastRmsn;  // the helper's own (one helper per context; indexes by QP)
+  static thread_local std::vector<uint8_t> have;
+  if ((size_t)qpIdx >= lastRmsn.size()) {
+    lastRmsn.resize((size_t)qpIdx + 1, 0);
+    have.resize((size_t)qpIdx + 1, 0);
+  }
+  if (have[(size_t)qpIdx] && lastRmsn[(size_t)qpIdx] != (rmsn & 0xffffffu))
+    pg->peers[(size_t)peer].rmsnMoveUs.store((int64_t)(gdakiQ4MonoMs() * 1000.0), std::memory_order_release);
+  lastRmsn[(size_t)qpIdx] = rmsn & 0xffffffu;
+  have[(size_t)qpIdx] = 1;
+}
+// The helper's request of a QP operation; 0 when one is pending already (the caller waits for its result).
+static uint32_t gdakiCtrlProbeAsk(struct gdakiRecHost* r, int peer, const struct gdakiCtrlProbeReq& q) {
+  struct gdakiCtrlPage* pg = gdakiPageOf(r);
+  if (!gdakiPageUp(pg) || peer < 0 || peer >= (int)pg->peers.size()) return 0;
+  struct gdakiCtrlPeerProbe& pp = pg->peers[(size_t)peer];
+  std::lock_guard<std::mutex> lk(pg->mu);
+  const uint32_t seq = gdakiCtrlHandAsk(&pp.hand, q.op, q.gen);  // 0: one in progress
+  if (seq == 0) return 0;
+  pp.req = q;
+  pp.req.seq = seq;
+  return seq;
+}
+// The result of request `seq`: true once it is there (*out a copy).
+static bool gdakiCtrlProbeAnswer(struct gdakiRecHost* r, int peer, uint32_t seq, struct gdakiCtrlProbeRes* out) {
+  struct gdakiCtrlPage* pg = gdakiPageOf(r);
+  if (!gdakiPageUp(pg) || peer < 0 || peer >= (int)pg->peers.size() || seq == 0) return false;
+  if (pg->peers[(size_t)peer].hasQp) gdakiProbeHandHelper(r, pg, peer);  // the firmware it waits for
+  struct gdakiCtrlPeerProbe& pp = pg->peers[(size_t)peer];
+  std::lock_guard<std::mutex> lk(pg->mu);
+  if (pp.hand.done != seq || pp.res.seq != seq) return false;
+  *out = pp.res;
+  return true;
+}
+// The watch thread's "this QP broke in generation g" (taken once): g + 1, 0 none.
+static uint32_t gdakiCtrlProbeErrTake(struct gdakiRecHost* r, int peer) {
+  struct gdakiCtrlPage* pg = gdakiPageOf(r);
+  if (!gdakiPageUp(pg) || peer < 0 || peer >= (int)pg->peers.size()) return 0;
+  return pg->peers[(size_t)peer].errGenPlus1.exchange(0, std::memory_order_acq_rel);
+}
+
+// Phase 1's reaction to a software stall verdict (rows 14, 15), on the helper (REVIEW_P12 막는 문제 6): STALLED(52) to
+// every rank, then decline the peer (no launcher and no FENCED in phase 1: the fence and the restore are phase 3's; this
+// is the NCCL_GIN_RESTORE_FENCE=none shape). 결정 1: a helper-only stall (row 15) takes the same path as row 14.
+// smoke3: with NCCL_GIN_RESTORE_FENCE=lineage (the default) and the launcher paired, the stall is the hold's strong
+// evidence (9.3 rows 14, 15: STALL, STALL_HELPER): the decline starts the hold when armed, the activation gate then
+// sends FENCE and waits for FENCED (9.4); otherwise (none, no launcher, not armed) the decline as before.
+static bool gdakiCtrlStallFenceOn(struct gdakiRecHost* r) {
+  const char* v = getenv("NCCL_" GDAKI_CTRL_P_RESTORE_FENCE);
+  struct gdakiCtrlPage* pg = gdakiPageOf(r);
+  return (v == nullptr || v[0] == '\0' || strcmp(v, GDAKI_CTRL_RESTORE_FENCE_DEFAULT) == 0) && pg != nullptr &&
+         pg->launcherPaired.load(std::memory_order_acquire);
+}
+static void gdakiCtrlStallDecline(struct gdakiRecHost* r, int peer, uint32_t inc, const char* cause) {
+  struct gdakiHold* h = gdakiHoldOf(r);
+  const int told = h != nullptr ? gdakiHoldBroadcast(r, GDAKI_TS_CTRL_STALLED, peer, inc, -1) : 0;
+  const char* c = (cause != nullptr && cause[0]) ? cause : "STALL";
+  char why[96];
+  snprintf(why, sizeof(why), "liveness stall judged (%s)", c);
+  const bool fence = gdakiCtrlStallFenceOn(r);
+  if (fence && r->ts != nullptr && peer >= 0 && peer < (int)r->ts->peers.size())
+    snprintf(r->ts->peers[(size_t)peer].lostCause, sizeof(r->ts->peers[(size_t)peer].lostCause), "%s", c);
+  WARN("GIN/RC: rank %d: rank %d (incarnation %u) judged stalled (%s); STALLED to %d rank(s); %s mono_ms=%.3f",
+       r->ctx->rank, peer, inc, why, told,
+       fence ? "the hold when armed, then FENCE and the restore (fence=lineage, launcher paired)"
+             : "declined (fence=none or no launcher)",
+       gdakiQ4MonoMs());
+  gdakiTsDecline(r, peer, why, false, 0, gdakiCause::PeerDead, GDAKI_UA_PEER_DEAD);
+}
+// The helper's step (gdakiTsMain, every loop): the mailboxes, taken once each, and the scaffold's pairing.
+static void gdakiCtrlPageHelperStep(struct gdakiRecHost* r) {
+  struct gdakiCtrlPage* pg = gdakiPageOf(r);
+  if (!gdakiPageUp(pg) || r->ts == nullptr) return;
+  for (int p = 0; p < (int)pg->peers.size(); p++) {
+    if (p == pg->me) continue;
+    struct gdakiCtrlPeerProbe& pp = pg->peers[(size_t)p];
+    const uint64_t sm = pp.stallMail.exchange(0, std::memory_order_acq_rel);
+    if (sm != 0) {
+      const uint32_t inc = gdakiCtrlMailInc(sm);
+      const struct gdakiTsPeer& pe = r->ts->peers[(size_t)p];
+      if (inc != gdakiLnOf(r, p).cur)  // judged on another incarnation's page than the lineage's current one: dropped
+        GIN_TS_NOTE("GIN/LN: rank %d: stall verdict of rank %d for incarnation %u dropped (current %u) mono_ms=%.3f",
+                    pg->me, p, inc, gdakiLnOf(r, p).cur, gdakiQ4MonoMs());
+      else if (!pe.declined)
+        gdakiCtrlStallDecline(r, p, inc, gdakiCtrlCauseName(gdakiCtrlMailCause(sm)));
+    }
+    const uint64_t rm = pp.readMail.exchange(0, std::memory_order_acq_rel);
+    if (rm != 0) {  // smoke3: rows 10, 11 end an effective pair (the witness off has no window: this or row 3 judges)
+      const uint32_t inc = gdakiCtrlMailInc(rm), row = gdakiCtrlMailRow(rm), cur = gdakiLnOf(r, p).cur;
+      const bool eff = gdakiCtrlEffOn(r, p);
+      if (inc == cur && gdakiCtrlEffOnReadRow(&pp.eff, eff, row, inc) == GDAKI_CTRL_EA_END) {
+        char by[96];
+        snprintf(by, sizeof(by), "row %u: the liveness READ's retry exceeded, %s", row,
+                 row == 10 ? "the launcher unresponsive (node or line)" : "the launcher's word not ALIVE, the witness off");
+        gdakiCtrlEffEnd(r, p, inc, gdakiCtrlCauseName(gdakiCtrlMailCause(rm)), by, true);
+      } else {
+        GIN_TS_NOTE("GIN/RC: rank %d: rank %d (incarnation %u): table row %u reported only (%s) mono_ms=%.3f", pg->me, p, inc,
+                    row, inc != cur ? "another incarnation" : !eff ? "the pair keeps ln4's witness rule" : "ended already",
+                    gdakiQ4MonoMs());
+      }
+    }
+    if (pp.hasQp) gdakiProbeHandHelper(r, pg, p);  // the handoff's firmware (every loop: no request waits on the link)
+    gdakiCtrlEffPoll(r, p, true);  // 2a-2-C step 4: the window's verdict reacts on an effective pair, the launcher's end
+  }
+  gdakiCtrlRingHelperStep(r);  // phase 2a-2-A: the ring's first pairing over UD (record 55's scaffold is gone)
+}
+
+// ---- the hooks (phase 1's real bodies; they replace the preparation stage's placeholders) ----
+// The launcher-paired latch (phase 3 calls it once the context's launcher pairing stands; never cleared: REVIEW_P12 고칠
+// 것 5, the gate does not move between FENCED and /proc inside one hold).
+[[maybe_unused]] static void gdakiCtrlLauncherPairedLatch(struct gdakiRecHost* r) {
+  struct gdakiCtrlPage* pg = gdakiPageOf(r);
+  if (pg != nullptr) pg->launcherPaired.store(true, std::memory_order_release);
+}
+// The buddy's activation fence gate (design 4.4; REVIEW_PREP main-list fix 9), the last condition of
+// gdakiHoldActivateDecide's rdma branch (helper): gdakiCtrlActGate over the latch and the fence word (the /proc verdict is
+// the decision's own check before it: GO here). Waiting, the fence's report name once per (peer, dead) (gdakiLnFenceOf).
+static bool gdakiCtrlActFenceOk(struct gdakiRecHost* r, int peer, uint32_t dead) {
+  struct gdakiCtrlPage* pg = gdakiPageOf(r);
+  // gin-control (launcher) [3] (REVIEW_P12 고칠 것 5): every HOLDING is in when this is asked, so FENCE goes now (unless
+  // the word says FENCED); the word is the launcher link's (EXITED, FENCED), the page keeps a copy for the report. The
+  // /proc branch is gone in this build: the gate is FENCED alone (gdakiCtrlActGate with the launcher-paired mode).
+  // This predicate falls back itself when the fence cannot complete (REVIEW_P3 nit 2): its one caller,
+  // gdakiHoldActivateDecide, returns on false and the hold has ended then.
+  uint64_t word = GDAKI_CTRL_FENCE_NONE;
+  char fw[192] = {0};
+  if (gdakiCtrlLaFenceStep(r, peer, dead, &word, fw, sizeof(fw)) < 0) {
+    gdakiHoldFallback(r, peer, fw);
+    return false;
+  }
+  const int v = gdakiCtrlActGate(true, gdakiCtrlFencedIs(word, dead), GDAKI_RS_ACT_WAIT);
+  if (v != GDAKI_RS_ACT_GO && pg != nullptr) {
+    static thread_local uint64_t lastSaid = ~0ull;
+    const uint64_t key = ((uint64_t)(uint32_t)peer << 32) | dead;
+    if (key != lastSaid) {
+      lastSaid = key;
+      const struct gdakiLnView lv = gdakiLnOf(r, peer);
+      const bool sent = peer >= 0 && peer < (int)pg->peers.size() && pg->peers[(size_t)peer].fenceSent;
+      GIN_TS_NOTE("GIN/RC: rank %d: rank %d (incarnation %u) fence %s: the activation waits for FENCED mono_ms=%.3f",
+                  r->ctx->rank, peer, dead, gdakiLnFenceName(gdakiLnFenceOf(lv.phase, lv.dead, word, sent)),
+                  gdakiQ4MonoMs());
+    }
+  }
+  return v == GDAKI_RS_ACT_GO;
+}
+// FENCED(peer, inc) into the fence word (design 4.4; gdakiLnFencedStep: CURRENT or HELD_OLD only, never down). In
+// phase 1 (no launcher) this is reached only by a relayed FENCED record (record 54), which this experiment does not
+// produce; it is here for phase 3 (gdakiCtrlOnRecord also opens a timing window on it).
+static void gdakiLnFenced(struct gdakiRecHost* r, int peer, uint32_t inc) {
+  struct gdakiCtrlPage* pg = gdakiPageOf(r);
+  if (pg == nullptr || peer < 0 || peer >= (int)pg->fencedPlus1.size()) return;
+  pg->fencedPlus1[(size_t)peer] = gdakiLnFencedStep(pg->fencedPlus1[(size_t)peer], gdakiLnClassify(gdakiLnOf(r, peer), inc), inc);
+}
+// The liveness READ QP toward `peer` into ERR at the hold start (gdakiCtrlPeerToErr, helper): the helper runs the command
+// and tells the watch thread (which owns the QP's software state) through the request word; a pairing request in
+// progress is cancelled (struct gdakiCtrlProbeHand).
+static void gdakiProbeToErr(struct gdakiRecHost* r, int peer) {
+  struct gdakiCtrlPage* pg = gdakiPageOf(r);
+  if (pg == nullptr || peer < 0 || peer >= (int)pg->peers.size()) return;
+  struct gdakiCtrlPeerProbe& pp = pg->peers[(size_t)peer];
+  pp.holdErr.store(true, std::memory_order_release);  // before the ERR: its flushes are not a break
+  {
+    std::lock_guard<std::mutex> lk(pg->mu);
+    pp.toErrReq = true;
+    gdakiCtrlHandCancel(&pp.hand);  // a request in progress is answered "hold started" (REVIEW_FIX12_P2B 고칠 것 1)
+  }
+  // the ERR itself on the helper (a firmware command; REVIEW_FIX12_P2B 고칠 것 4). pp.qp.q changes only on the helper.
+  if (pp.hasQp && pp.qp.q != nullptr && pp.qp.q->qp != nullptr) {
+    struct ibv_qp_attr a;
+    memset(&a, 0, sizeof(a));
+    a.qp_state = IBV_QPS_ERR;
+    (void)wrap_ibv_modify_qp(pp.qp.q->qp, &a, IBV_QP_STATE);
+    pp.helperFw++;
+  }
+}
+
+// Records 52-55 handled in the hold drain (a survivor and a held peer's buddy take them in arrival order). 53 DISPUTE is
+// received only: the detection design's stall disagreement sends it (REVIEW_P12 nit 15). 55 is the scaffold's pairing.
+static void gdakiCtrlOnRecord(struct gdakiRecHost* r, int from, const struct gdakiTsMsg& m) {
+  switch (m.type) {
+    case GDAKI_TS_CTRL_STALLED:
+      GIN_TS_NOTE("GIN/RC: rank %d: STALLED(rank %d, incarnation %u) from rank %d mono_ms=%.3f", r->ctx->rank, m.arg,
+                  (uint32_t)m.round, from, gdakiQ4MonoMs());
+      break;
+    case GDAKI_TS_CTRL_DISPUTE:
+      GIN_TS_NOTE("GIN/RC: rank %d: DISPUTE(rank %d, incarnation %u) from rank %d mono_ms=%.3f", r->ctx->rank, m.arg,
+                  (uint32_t)m.round, from, gdakiQ4MonoMs());
+      break;
+    case GDAKI_TS_CTRL_FENCED:  // from the launcher's relay (phase 3): the fence word, and a timing window
+      gdakiLnFenced(r, m.arg, (uint32_t)m.round);
+      gdakiCtrlWindowRequest(r, m.arg, GDAKI_CTRL_WSRC_ENDED);
+      break;
+    case GDAKI_TS_CTRL_PROBE_SETUP:
+      gdakiCtrlProbeSetupRecv(r, from, m);
+      break;
+    default:
+      break;
+  }
+}
+#endif  // !NCCL_GIN_CTRL_TCP
+// ==== gin-control (page): the status page, READ detection, the judgement table, the fence (end) ====
+// ---- [1] page (end) ----
+
+// ---- [2] ring: placeholders phase 2 replaces (begin) ----
+// the swap points (phase 2a-2-B; 2a-2-C: per pair): the pair's path once the context has a ring (the region
+// "gin-control (ring): live seams" below answers through the four hooks: the records go where the pair's path says, the
+// peer's are taken by the path marker's order rule), else the TCP back end (gdakiTsSend, gdakiTsPump, gdakiTsRecv,
+// gdakiRsRecvOn, gdakiTsAnswerFail, pe.fd) as before, its bytes counted. REJOIN: over UD when there is no socket (fd -1,
+// 2a-2-C: the REJOIN, its answers, the install from its REJOIN_ACK), else TCP; DATA stays on TCP until the outbox step.
+// A hook's false: not the path's (no ring, another channel, no such pair); *rc the answer else.
+static bool gdakiCtrlRingSendOf(struct gdakiRecHost* r, int peer, uint32_t ch, int fd, struct gdakiTsMsg* m, int timeoutMs,
+                                int* rc);
+static bool gdakiCtrlRingPumpOf(struct gdakiRecHost* r, int peer, struct gdakiTsPeer& pe, struct gdakiTsMsg* out, int* rc);
+static bool gdakiCtrlRingRecvOf(struct gdakiRecHost* r, int peer, uint32_t ch, struct gdakiTsPeer* pe,
+                                struct gdakiTsMsg* out, int timeoutMs, std::atomic<bool>* stop, int* rc);
+static void gdakiCtrlTcpCount(struct gdakiRecHost* r, int peer, uint32_t ch, bool rx, int rc);  // errno kept
+static int gdakiCtrlSend(struct gdakiRecHost* r, int peer, uint32_t ch, int fd, struct gdakiTsMsg* m, int timeoutMs) {
+  int rc = -1;
+  if (gdakiCtrlRingSendOf(r, peer, ch, fd, m, timeoutMs, &rc)) return rc;
+  rc = gdakiTsSend(fd, m, timeoutMs);
+  gdakiCtrlTcpCount(r, peer, ch, false, rc);
+  return rc;
+}
+static int gdakiCtrlPump(struct gdakiRecHost* r, int peer, struct gdakiTsPeer& pe, struct gdakiTsMsg* out) {
+  int rc = 0;
+  if (gdakiCtrlRingPumpOf(r, peer, pe, out, &rc)) return rc;
+  rc = gdakiTsPump(pe, out);
+  gdakiCtrlTcpCount(r, peer, GDAKI_CTRL_CH_RECORD, true, rc);
+  return rc;
+}
+static int gdakiCtrlRecv(struct gdakiRecHost* r, int peer, struct gdakiTsPeer& pe, struct gdakiTsMsg* out, int timeoutMs,
+                         std::atomic<bool>* stop) {
+  int rc = 0;
+  if (gdakiCtrlRingRecvOf(r, peer, GDAKI_CTRL_CH_RECORD, &pe, out, timeoutMs, stop, &rc)) return rc;
+  rc = gdakiTsRecv(pe, out, timeoutMs, stop);
+  gdakiCtrlTcpCount(r, peer, GDAKI_CTRL_CH_RECORD, true, rc);
+  return rc;
+}
+static int gdakiCtrlRecvOn(struct gdakiRecHost* r, int peer, uint32_t ch, int fd, struct gdakiTsMsg* out, int timeoutMs,
+                           std::atomic<bool>* stop) {
+  int rc = 0;  // _RECORD: the pair's ring once the peer's records come on it; _REJOIN: TCP until the UD answer
+  if (gdakiCtrlRingRecvOf(r, peer, ch, nullptr, out, timeoutMs, stop, &rc)) return rc;
+  rc = gdakiRsRecvOn(fd, out, timeoutMs, stop);
+  gdakiCtrlTcpCount(r, peer, ch, true, rc);
+  return rc;
+}
+static bool gdakiCtrlRjAnswer(struct gdakiRecHost* r, int peer, uint64_t round, uint32_t code, uint32_t pad);  // below
+static void gdakiCtrlRejoinFail(struct gdakiRecHost* r, int fd, int peer, uint64_t round, const char* what) {
+  // no socket (fd -1): a REJOIN that came over UD (2a-2-C): the FAIL record goes back to its sender over UD
+  if (fd < 0 && r != nullptr && r->ts != nullptr && peer >= 0 && peer < (int)r->ts->peers.size() &&
+      gdakiCtrlRjAnswer(r, peer, round, GDAKI_CTRL_RJA_FAIL, gdakiTsCausePad(r->ts->peers[(size_t)peer].declCause))) {
+    GIN_TS_NOTE("GIN/TS: rank %d: answered a %s of declined rank %d with FAIL (over UD) mono_ms=%.3f", r->ctx->rank, what,
+                peer, gdakiQ4MonoMs());
+    return;
+  }
+  gdakiTsAnswerFail(r, fd, peer, round, what);
+}
+static bool gdakiCtrlRdmaLiveUp(struct gdakiRecHost* r, int peer, bool* up);  // the ring's (below)
+static bool gdakiCtrlChanUp(struct gdakiRecHost* r, int peer, const struct gdakiTsPeer& pe) {
+  bool up = false;  // the ring answers once the pair's records go on it (its path): the record QP CONNECTED, not lost;
+                    // the witness's socket state aside
+  if (gdakiCtrlRdmaLiveUp(r, peer, &up)) return up;
+  return pe.fd >= 0 && !pe.gone;
+}
+[[maybe_unused]] static bool gdakiCtrlChanUp(struct gdakiRecHost* r, int peer) {
+  if (r == nullptr || r->ts == nullptr || peer < 0 || peer >= (int)r->ts->peers.size()) return false;
+  return gdakiCtrlChanUp(r, peer, r->ts->peers[(size_t)peer]);
+}
+static bool gdakiCtrlRdmaGenOf(struct gdakiRecHost* r, int peer, uint32_t* gen);  // the ring's (below)
+static uint32_t gdakiCtrlChanGen(struct gdakiRecHost* r, int peer, const struct gdakiTsPeer& pe) {
+  uint32_t g = 0;  // the record QP pairing's generation while the pair's records go on the ring (REVIEW_P12 막는 문제 8;
+                   // 2a-2-C: its path): a kept REQ of an older generation is dropped as one of an older socket
+  return gdakiCtrlRdmaGenOf(r, peer, &g) ? g : pe.gen;
+}
+static bool gdakiCtrlRingLiveOn(struct gdakiRecHost* r, int peer);  // the ring's (below): the pair's records go on it
+static int gdakiCtrlPollFd(struct gdakiRecHost* r, int peer, const struct gdakiTsPeer& pe) {
+  // the pair's records on the ring: -1 (poll ignores it, the peek fails, so the pump reads the inbox); the helper CQ's
+  // completion channel fd joins the poll sets beside the witness sockets (gdakiCtrlWakeFdAdd)
+  if (gdakiCtrlRingLiveOn(r, peer)) return -1;
+  return pe.fd;
+}
+static bool gdakiCtrlRjSpareInstall(struct gdakiRecHost* r, int peer);  // the ring's (below)
+static void gdakiCtrlChanInstall(struct gdakiRecHost* r, int peer, struct gdakiTsPeer& pe, int fd) {
+  // no socket (fd -1): the REJOIN went over UD (2a-2-C): the ring installs the pair from its REJOIN_ACK (both pairings,
+  // the records on the ring); a socket is the witness's, and the record channel until the ring is live (REVIEW_PREP nit 14)
+  if (fd < 0) (void)gdakiCtrlRjSpareInstall(r, peer);
+  pe.fd = fd;
+}
+// the record QP toward `peer` into ERR, and its re-pairing asked of the helper's step (never the witness's socket)
+static void gdakiCtrlRdmaRecordToErrAsk(struct gdakiRecHost* r, int peer);  // the ring's (below)
+static void gdakiCtrlRecordToErr(struct gdakiRecHost* r, int peer) { gdakiCtrlRdmaRecordToErrAsk(r, peer); }
+// the store's responder QP of ward `peer` into ERR (ln4's hold start does not: its quiesce moves the user and mirror QPs
+// only; EXPERIMENT.md 9.4 step 1). Phase 2b: a job for the store thread (region "gin-control (store)")
+static void gdakiStoreWardToErr(struct gdakiRecHost* r, int peer) { gdakiCtrlStoreWardToErrAsk(r, peer); }
+// r->ctrl->ring (phase 2a-2-A: made at the setup; the QPs, then the CQ with its channel, then the memory)
+static void gdakiCtrlRdmaDestroy(struct gdakiCtrlRing* g);  // the ring's (below)
+static void gdakiCtrlRingFree(struct gdakiRecHost* r) {
+  if (r == nullptr || r->ctrl == nullptr || r->ctrl->ring == nullptr) return;
+  gdakiCtrlRdmaDestroy(r->ctrl->ring);
+  r->ctrl->ring = nullptr;
+}
+// Phase 2a-1 (integration): the ring model and the verbs back end below are built but not wired; the bodies above
+// stay the preparation stage's until phase 2a-2 binds them.
+// ==== gin-control (ring): model (begin; phase 2a-1, impl/gc_unit_p2.cc compiles this region on the CPU) ====
+// The record ring of one pair, its credit and generations, the sender's queue and the receiver's inbox (EXPERIMENT.md
+// 9.1 "링과 흐름 제어"; design v3 2.2-2.4), and the UD pairing (9.1 "짝 맺기"; design v3 2.5), as plain structs and
+// functions: no verbs, no socket, no clock (the caller passes nowMs). What the NIC does is the caller's: the region
+// "gin-control (ring): verbs back end" posts what these ask through a struct gdakiCtrlRingOps and feeds the completions
+// back. Needs the block "gin-control: ctrl API" and <deque>, <vector>, <cstring>.
+#if !NCCL_GIN_CTRL_TCP
+// ---- wr_id: (what, peer, generation, slot) ----
+// The completion of an older generation is recognized by its wr_id alone (design v3 2.2 "세대와 자리").
+enum : uint32_t {
+  GDAKI_CTRL_WR_RECV = 1,         // a ring slot's RECV on a record QP
+  GDAKI_CTRL_WR_SEND = 2,         // a SEND from a send slot
+  GDAKI_CTRL_WR_READ_CREDIT = 3,  // the window is shut: the READ of the peer's consumed word
+  GDAKI_CTRL_WR_READ_XFER = 4,    // the READ of a half of the peer's outbox
+  GDAKI_CTRL_WR_UD_RECV = 5,      // the UD QP's RECV (slot = its buffer)
+  GDAKI_CTRL_WR_UD_SEND = 6,      // a datagram (slot = its buffer)
+};
+#define GDAKI_CTRL_WR_MAX_PEERS 4096u  // peer indexes: ranks, then the launchers (nranks + i)
+static inline uint64_t gdakiCtrlWrId(uint32_t what, uint32_t peer, uint32_t gen, uint32_t slot) {
+  return ((uint64_t)(what & 0xfu) << 60) | ((uint64_t)(peer & 0xfffu) << 48) | ((uint64_t)gen << 16) | (slot & 0xffffu);
+}
+static inline uint32_t gdakiCtrlWrWhat(uint64_t id) { return (uint32_t)(id >> 60); }
+static inline uint32_t gdakiCtrlWrPeer(uint64_t id) { return (uint32_t)(id >> 48) & 0xfffu; }
+static inline uint32_t gdakiCtrlWrGen(uint64_t id) { return (uint32_t)(id >> 16); }
+static inline uint32_t gdakiCtrlWrSlot(uint64_t id) { return (uint32_t)id & 0xffffu; }
+
+// ---- the ring of one pair: constants ----
+// PAIR_DONE (the liveness READ QP's last datagram) is a PAIR body with step GDAKI_CTRL_PAIR_STEP_DONE (3), and the record
+// QP's CONNECTED (its first RC SEND of a generation, seq 1) the bodiless envelope kind GDAKI_CTRL_K_CONNECTED (6): both
+// the header's (integration: phase 2a-1's own #define of the step and its CONNECTED as a PAIR body are replaced).
+#define GDAKI_CTRL_QUEUE_MAX 4096u      // the sender's queue per pair, in messages (about 7.6 MiB at most; grows as needed)
+#define GDAKI_CTRL_INBOX_MAX 4096u      // the receiver's inbox per pair: at it, no RECV is posted again (no credit back)
+#define GDAKI_CTRL_CREDIT_READ_MS 1.0   // the window is shut: the consumed word's READ at most this often
+#define GDAKI_CTRL_SEND_SLOTS 64u       // send buffers per pair (a SEND's buffer is free at its completion, not its credit)
+#define GDAKI_CTRL_FRAME_MAX (64u + GDAKI_CTRL_RECORD_BYTES)
+static_assert(GDAKI_CTRL_RING_SLOTS == 64u && GDAKI_CTRL_SEND_SLOTS == 64u, "one 64-bit mask per slot set");
+static_assert(GDAKI_CTRL_SEND_SLOTS + 16u + 16u == GDAKI_CTRL_RECORD_SQ, "SQ 96 = SENDs 64 + READs 16 + 16 (9.1)");
+// ---- the pair's path marker (phase 2a-2-C, impl/notes_p2a2.md "2a-2-C"; EXPERIMENT.md 9.1 "차례와 잃음의 뜻") ----
+// A pair's records go on one path at a time, this side's choice: the helper socket (the TCP back end) or the ring. A
+// switch starts a new path generation and tells the peer how many records went on the old path: the marker (path, gen,
+// recordsSentBeforeSwitch). On the ring it is every RECORD envelope's reserved 16 bytes (gdakiCtrlEnvCheck does not read
+// them; impl/rs_ctrl_api_p2a2c.diff names the field); a socket record has no envelope, so a socket generation after a
+// switch starts with one marker record (GDAKI_TS_CTRL_PATH, the marker in executed[0..3]; never handed to a caller).
+// The receiver takes the new path's records only after it took the old path's counted ones, or the old path closed, or
+// 1 000 ms passed; the old path's later records are dropped (one line per switch). Generation 0: the setup's socket.
+// The record type GDAKI_TS_CTRL_PATH, GDAKI_CTRL_PM_* and struct gdakiCtrlPathMark (the envelope's pathMark) are the
+// ctrl API block's (rs_ctrl_api_p2a2c.diff, merged in int3).
+// A message waiting in the sender's queue (its envelope is made at the post: seq and ackSeq are the post's; a RECORD's
+// path marker is the one of its enqueue).
+struct gdakiCtrlQEnt {
+  uint16_t kind = 0;
+  uint16_t rsv = 0;
+  uint32_t bytes = 0;
+  struct gdakiCtrlPathMark mark = {};
+  uint8_t body[GDAKI_CTRL_RECORD_BYTES];
+};
+// A message taken from the ring, in arrival order (the inbox).
+struct gdakiCtrlInEnt {
+  struct gdakiCtrlEnv env;
+  uint8_t body[GDAKI_CTRL_RECORD_BYTES];
+};
+// What the model asks of the NIC (the verbs back end, or a test's model of it). Each returns 0 when posted.
+struct gdakiCtrlRingOps {
+  void* ctx = nullptr;
+  // one SEND of `bytes` of `frame` (envelope and body) from send slot `sslot`, signaled, wr_id (SEND, peer, gen, sslot)
+  int (*postSend)(void* ctx, int peer, uint32_t gen, uint32_t sslot, const uint8_t* frame, uint32_t bytes) = nullptr;
+  // ring slot `slot`'s RECV, wr_id (RECV, peer, gen, slot)
+  int (*postRecv)(void* ctx, int peer, uint32_t gen, uint32_t slot) = nullptr;
+  // the window is shut: one READ of the peer's consumed word for this rank, wr_id (READ_CREDIT, peer, gen, 0); its value
+  // comes back through gdakiCtrlRingOnCreditWord
+  int (*readCredit)(void* ctx, int peer, uint32_t gen) = nullptr;
+};
+// One pair's ring, both directions (the record QP's SQ and RQ). gen 0: never paired.
+struct gdakiCtrlRingPair {
+  int peer = -1;
+  int32_t me = -1;
+  uint64_t nonce = 0;
+  uint32_t inc = 0;
+  uint32_t recMagic = 0;      // the record's magic, stamped at the post (GDAKI_TS_MAGIC: gdakiTsSend's contract)
+  uint32_t gen = 0;           // the record QP pairing's generation
+  bool initiator = false;     // this side started gen's pairing: it sends CONNECTED first
+  bool rts = false;           // the record QP is RTS in gen (the back end says so)
+  bool connected = false;     // CONNECTED sent (initiator) or taken (the other side): from then on SENDs go
+  bool lost = false;          // gen's connection is lost (a bad completion, a gap, a bad envelope): until a new gen
+  char lostCause[24] = {0};
+  // the send direction
+  uint64_t sent = 0;          // S: SENDs posted in gen (= the seq of the last one)
+  uint64_t peerConsumed = 0;  // C: what this side knows the peer consumed of them in gen (S - C < K before a post)
+  uint64_t sendBusy = 0;      // a bit per send slot: posted, its completion not seen
+  uint32_t sendGen[GDAKI_CTRL_SEND_SLOTS] = {0};  // the generation each busy send slot was posted in (REVIEW_P12 고칠 것 9:
+                              // only that generation's completion frees it)
+  bool creditReadOut = false;
+  double creditReadMs = -1e18;
+  uint64_t creditReads = 0;   // READs of the consumed word (the window was shut)
+  std::deque<struct gdakiCtrlQEnt> q;
+  uint64_t queuedDropped = 0; // messages dropped from the queue by a generation change (all generations)
+  uint64_t oldSendCqes = 0;   // send completions of an older generation (collected, nothing else)
+  // the receive direction
+  uint32_t slotGen[GDAKI_CTRL_RING_SLOTS] = {0};  // the generation of the RECV posted in the slot; 0: none (collected)
+  uint64_t lastSeq = 0;       // the seq last taken in gen
+  uint64_t consumed = 0;      // RECVs posted again in gen after a message was taken (the credit given back)
+  std::deque<uint32_t> deferred;  // slots whose RECV waits for the inbox to drop below its bound (arrival order)
+  std::deque<struct gdakiCtrlInEnt> inbox;
+  uint64_t oldRecvCqes = 0;   // receive completions of an older generation dropped
+  uint64_t oldEnvelopes = 0;  // envelopes of an older generation in a current RECV (dropped, not counted as consumed)
+  uint64_t oldTaken = 0;      // an older generation's messages RC delivered (its RECV succeeded) after the change: taken
+                              // before that generation's end (REVIEW_P12 막는 문제 8)
+  uint64_t oldDropped = 0;    // an older generation's successful RECVs that could not be taken (a gap, a bad envelope)
+  uint32_t lossToldGen = 0;   // the generation whose loss the pump told (-1 once per connection)
+  uint64_t rnrErrors = 0;     // IBV_WC_RNR_RETRY_EXC_ERR in gen (the back end counts it; 0 when the credit is right)
+};
+static inline void gdakiCtrlRingInit(struct gdakiCtrlRingPair* p, int peer, int32_t me, uint64_t nonce, uint32_t inc,
+                                     uint32_t recMagic) {
+  *p = gdakiCtrlRingPair();
+  p->peer = peer;
+  p->me = me;
+  p->nonce = nonce;
+  p->inc = inc;
+  p->recMagic = recMagic;
+}
+static inline void gdakiCtrlRingLose(struct gdakiCtrlRingPair* p, const char* cause) {
+  if (p->lost) return;
+  p->lost = true;
+  snprintf(p->lostCause, sizeof(p->lostCause), "%s", cause);
+}
+// The pair's record channel is up (the seam gdakiCtrlChanUp of phase 2a-2): paired in gen, RTS, CONNECTED, not lost. A
+// channel not up still takes messages into its queue (held until CONNECTED); the pump reads what the inbox has.
+static inline bool gdakiCtrlRingUp(const struct gdakiCtrlRingPair* p) {
+  return p->gen != 0 && p->rts && p->connected && !p->lost;
+}
+// The consumed word this side publishes for the peer (its status page's rxConsumed[peer]; the peer READs it when shut).
+static inline uint64_t gdakiCtrlRingConsumedWord(const struct gdakiCtrlRingPair* p) {
+  return gdakiCtrlGenCount(p->gen, (uint32_t)p->consumed);
+}
+static inline uint32_t gdakiCtrlRingFreeSendSlot(const struct gdakiCtrlRingPair* p) {
+  for (uint32_t s = 0; s < GDAKI_CTRL_SEND_SLOTS; s++)
+    if ((p->sendBusy & (1ull << s)) == 0) return s;
+  return GDAKI_CTRL_SEND_SLOTS;
+}
+// Envelope and body into one frame; the record's magic stamped as gdakiTsSend stamps it (in the frame and, through
+// stampInto, in the caller's record). Returns the frame's bytes.
+static inline uint32_t gdakiCtrlFrame(uint8_t* frame, uint16_t kind, int32_t from, uint32_t gen, uint64_t seq,
+                                      uint64_t ackSeq, uint64_t nonce, uint32_t inc, const void* body, uint32_t bytes,
+                                      uint32_t recMagic) {
+  struct gdakiCtrlEnv e;
+  gdakiCtrlEnvPack(&e, kind, from, gen, seq, ackSeq, nonce, inc, bytes);
+  memcpy(frame, &e, sizeof(e));
+  if (bytes > 0) memcpy(frame + sizeof(e), body, bytes);
+  if (kind == GDAKI_CTRL_K_RECORD && bytes >= 4) memcpy(frame + sizeof(e), &recMagic, 4);
+  return (uint32_t)sizeof(e) + bytes;
+}
+// One post of `kind`/`body` now (credit, a send slot and a connection checked by the caller): seq = ++sent. A path
+// marker (`mark`, path not 0) goes into the envelope's reserved bytes.
+static inline int gdakiCtrlRingPostOne(struct gdakiCtrlRingPair* p, const struct gdakiCtrlRingOps& ops, uint16_t kind,
+                                       const void* body, uint32_t bytes, const struct gdakiCtrlPathMark* mark = nullptr) {
+  const uint32_t s = gdakiCtrlRingFreeSendSlot(p);
+  if (s >= GDAKI_CTRL_SEND_SLOTS) return 1;
+  uint8_t frame[GDAKI_CTRL_FRAME_MAX];
+  const uint32_t n =
+      gdakiCtrlFrame(frame, kind, p->me, p->gen, p->sent + 1, p->consumed, p->nonce, p->inc, body, bytes, p->recMagic);
+  if (mark != nullptr && mark->path != 0) memcpy(frame + offsetof(struct gdakiCtrlEnv, pathMark), mark, sizeof(*mark));
+  if (ops.postSend(ops.ctx, p->peer, p->gen, s, frame, n) != 0) {
+    gdakiCtrlRingLose(p, "POSTSEND");
+    return -1;
+  }
+  p->sent++;
+  p->sendBusy |= 1ull << s;
+  p->sendGen[s] = p->gen;
+  return 0;
+}
+// Queue one message (held until CONNECTED, sent when the credit allows): 0 queued, 1 the queue is full (the caller drives
+// the ring and tries again until its bound: then gdakiTsSend's "send failed"), -1 the connection of gen is lost.
+static inline int gdakiCtrlRingEnqueue(struct gdakiCtrlRingPair* p, uint16_t kind, const void* body, uint32_t bytes,
+                                       const struct gdakiCtrlPathMark* mark = nullptr) {
+  if (p->lost) return -1;
+  if (bytes > GDAKI_CTRL_RECORD_BYTES) return -1;
+  if (p->q.size() >= GDAKI_CTRL_QUEUE_MAX) return 1;
+  p->q.emplace_back();
+  struct gdakiCtrlQEnt& e = p->q.back();
+  e.kind = kind;
+  e.bytes = bytes;
+  if (mark != nullptr) e.mark = *mark;
+  if (bytes > 0) memcpy(e.body, body, bytes);
+  return 0;
+}
+// Post what the window and the send slots allow (CONNECTED first, from the side that started the pairing); with the
+// window shut and something queued, READ the peer's consumed word (one at a time, at most every 1 ms). Returns the posts.
+static inline int gdakiCtrlRingKick(struct gdakiCtrlRingPair* p, const struct gdakiCtrlRingOps& ops, double nowMs) {
+  if (p->lost || p->gen == 0 || !p->rts) return 0;
+  int n = 0;
+  if (!p->connected) {
+    if (!p->initiator) return 0;  // the other side: nothing goes before its CONNECTED came
+    // CONNECTED: the envelope alone (GDAKI_CTRL_K_CONNECTED, 0 B; it takes a RECV slot and seq 1 like a record)
+    if (gdakiCtrlRingPostOne(p, ops, GDAKI_CTRL_K_CONNECTED, &p->gen, 0) != 0) return 0;
+    p->connected = true;
+    n++;
+  }
+  while (!p->q.empty() && gdakiCtrlCanSend(p->gen, p->sent, gdakiCtrlGenCount(p->gen, (uint32_t)p->peerConsumed))) {
+    const struct gdakiCtrlQEnt& e = p->q.front();
+    const int r = gdakiCtrlRingPostOne(p, ops, e.kind, e.body, e.bytes, &e.mark);
+    if (r != 0) break;
+    p->q.pop_front();
+    n++;
+  }
+  if (!p->q.empty() && !p->lost && !p->creditReadOut && nowMs - p->creditReadMs >= GDAKI_CTRL_CREDIT_READ_MS &&
+      !gdakiCtrlCanSend(p->gen, p->sent, gdakiCtrlGenCount(p->gen, (uint32_t)p->peerConsumed))) {
+    p->creditReadMs = nowMs;
+    if (ops.readCredit(ops.ctx, p->peer, p->gen) == 0) {
+      p->creditReadOut = true;
+      p->creditReads++;
+    }
+  }
+  return n;
+}
+// The consumed count c32 (32 bits) as a count of gen's SENDs: the peer consumed no more than was sent.
+static inline void gdakiCtrlRingLearnConsumed(struct gdakiCtrlRingPair* p, uint32_t c32) {
+  const uint32_t behind = (uint32_t)p->sent - c32;
+  if ((uint64_t)behind > p->sent) return;  // not a count of this generation's SENDs
+  const uint64_t c = p->sent - behind;
+  if (c > p->peerConsumed) p->peerConsumed = c;
+}
+// The READ of the peer's consumed word completed (ok false: it failed; the record QP's completion says the rest).
+static inline void gdakiCtrlRingOnCreditWord(struct gdakiCtrlRingPair* p, uint32_t readGen, bool ok, uint64_t word) {
+  if (readGen != p->gen) return;  // an older generation's READ
+  p->creditReadOut = false;
+  if (ok && gdakiCtrlGenOf(word) == p->gen) gdakiCtrlRingLearnConsumed(p, gdakiCtrlCountOf(word));
+}
+// A SEND's completion: its slot is free when it was posted in the completion's generation (a late completion of a
+// destroyed QP's SEND never frees the slot a newer generation posted in; REVIEW_P12 고칠 것 9); a bad one of gen loses
+// the connection.
+static inline void gdakiCtrlRingOnSendCqe(struct gdakiCtrlRingPair* p, uint64_t wrId, bool ok, bool rnr) {
+  const uint32_t s = gdakiCtrlWrSlot(wrId);
+  if (s < GDAKI_CTRL_SEND_SLOTS && p->sendGen[s] == gdakiCtrlWrGen(wrId)) p->sendBusy &= ~(1ull << s);
+  if (gdakiCtrlWrGen(wrId) != p->gen) {
+    p->oldSendCqes++;
+    return;
+  }
+  if (rnr) p->rnrErrors++;
+  if (!ok) gdakiCtrlRingLose(p, rnr ? "RNR" : "SENDERR");
+}
+
+// ---- the receive direction ----
+// Post slot `s`'s RECV in gen; a RECV given back after a take is the credit (consumed + 1), the first K are not.
+static inline int gdakiCtrlRingRepost(struct gdakiCtrlRingPair* p, const struct gdakiCtrlRingOps& ops, uint32_t s,
+                                      bool credit) {
+  if (ops.postRecv(ops.ctx, p->peer, p->gen, s) != 0) {
+    gdakiCtrlRingLose(p, "POSTRECV");
+    return -1;
+  }
+  p->slotGen[s] = p->gen;
+  if (credit) p->consumed++;
+  return 0;
+}
+// The slots still holding an older generation's RECV (their completion, a flush or a success, not collected yet).
+static inline uint32_t gdakiCtrlRingOldRecvs(const struct gdakiCtrlRingPair* p) {
+  uint32_t n = 0;
+  for (uint32_t s = 0; s < GDAKI_CTRL_RING_SLOTS; s++) n += p->slotGen[s] != 0 && p->slotGen[s] != p->gen;
+  return n;
+}
+// The RECVs still posted in generation `g` (their completion not collected).
+static inline uint32_t gdakiCtrlRingRecvsOf(const struct gdakiCtrlRingPair* p, uint32_t g) {
+  uint32_t n = 0;
+  for (uint32_t s = 0; s < GDAKI_CTRL_RING_SLOTS; s++) n += g != 0 && p->slotGen[s] == g;
+  return n;
+}
+// Everything of the QP not collected yet (RECVs, SENDs and the credit READ of any generation): 0 before a RESET.
+static inline uint32_t gdakiCtrlRingOutstanding(const struct gdakiCtrlRingPair* p) {
+  uint32_t n = (uint32_t)__builtin_popcountll(p->sendBusy) + (p->creditReadOut ? 1u : 0u);
+  for (uint32_t s = 0; s < GDAKI_CTRL_RING_SLOTS; s++) n += p->slotGen[s] != 0;
+  return n;
+}
+// The inbox holds the records of every generation in arrival order and, where a generation ended, its end (an internal
+// entry: envelope kind 0, which no wire envelope has; env.gen the ended generation, env.seq its last seq taken). The pump
+// hands the end out as -1 once (the loss event, TCP's FIN; REVIEW_P12 막는 문제 8).
+static inline bool gdakiCtrlInIsEnd(const struct gdakiCtrlInEnt& e) { return e.env.kind == 0; }
+// A new generation of the pair (a pairing taken or started, by either side): the queue's messages are dropped (not
+// ACKed by RC: TCP's lost send buffer; the record layer hears the loss once through the pump's -1), the inbox's
+// records stay (RC ACKed them: they are read before the old generation's end, as TCP's reader reads the bytes before
+// the FIN; REVIEW_P12 막는 문제 8), and the old generation's end goes behind them unless the pump told its loss already.
+// The counts start from 0. The RECVs and SENDs of the old generation stay outstanding until their completions are
+// collected (an old generation's success is still taken, gdakiCtrlRingOnRecvCqe) or the QP is destroyed
+// (gdakiCtrlRingForgetOld). Returns the queued messages dropped.
+static inline uint64_t gdakiCtrlRingNewGen(struct gdakiCtrlRingPair* p, uint32_t gen, bool initiator) {
+  const uint64_t dropped = p->q.size();
+  p->queuedDropped += dropped;
+  p->q.clear();
+  if (p->gen != 0 && p->lossToldGen != p->gen) {
+    p->inbox.emplace_back();
+    struct gdakiCtrlInEnt& end = p->inbox.back();
+    memset(&end.env, 0, sizeof(end.env));
+    end.env.gen = p->gen;
+    end.env.seq = p->lastSeq;
+    // -1 once per connection (REVIEW_FIX12_P2B 고칠 것 3): a generation never connected that dropped nothing ends silently
+    end.env.ackSeq = p->connected || dropped > 0 ? 1u : 0u;
+  }
+  p->deferred.clear();  // their RECVs were taken: the slots are free (slotGen 0)
+  p->gen = gen;
+  p->initiator = initiator;
+  p->rts = false;
+  p->connected = false;
+  p->lost = false;
+  p->lostCause[0] = 0;
+  p->sent = p->peerConsumed = 0;
+  p->creditReadOut = false;
+  p->creditReadMs = -1e18;
+  p->lastSeq = p->consumed = 0;
+  p->rnrErrors = 0;
+  return dropped;
+}
+// The QP was destroyed (not reset): nothing of the old generation can complete any more.
+static inline void gdakiCtrlRingForgetOld(struct gdakiCtrlRingPair* p) {
+  for (uint32_t s = 0; s < GDAKI_CTRL_RING_SLOTS; s++)
+    if (p->slotGen[s] != p->gen) p->slotGen[s] = 0;
+  p->sendBusy = 0;
+  for (uint32_t s = 0; s < GDAKI_CTRL_SEND_SLOTS; s++) p->sendGen[s] = 0;
+}
+// Before RTR (design v3 2.2): all K RECVs of gen. -1 when an older generation's RECV is still outstanding (collect its
+// completion first) or a post failed; else the RECVs posted.
+static inline int gdakiCtrlRingPostInitial(struct gdakiCtrlRingPair* p, const struct gdakiCtrlRingOps& ops) {
+  if (p->gen == 0 || gdakiCtrlRingOldRecvs(p) != 0) return -1;
+  int n = 0;
+  for (uint32_t s = 0; s < GDAKI_CTRL_RING_SLOTS; s++) {
+    if (p->slotGen[s] == p->gen) continue;
+    if (gdakiCtrlRingRepost(p, ops, s, false) != 0) return -1;
+    n++;
+  }
+  return n;
+}
+// After the pop of one inbox message: the deferred RECVs go again while the inbox is below its bound.
+static inline void gdakiCtrlRingUndefer(struct gdakiCtrlRingPair* p, const struct gdakiCtrlRingOps& ops) {
+  while (!p->deferred.empty() && p->inbox.size() < GDAKI_CTRL_INBOX_MAX && !p->lost) {
+    const uint32_t s = p->deferred.front();
+    p->deferred.pop_front();
+    if (gdakiCtrlRingRepost(p, ops, s, true) != 0) return;
+  }
+}
+enum : int {
+  GDAKI_CTRL_RX_TAKEN = 0,      // a message of gen in the inbox (or CONNECTED taken)
+  GDAKI_CTRL_RX_OLD = 1,        // an older generation's completion or envelope: dropped
+  GDAKI_CTRL_RX_LOST = 2,       // gen's connection is lost (lostCause)
+  GDAKI_CTRL_RX_IGNORED = 3,    // nothing for the ring (a completion of a slot it does not know)
+  GDAKI_CTRL_RX_TAKEN_OLD = 4,  // an older generation's message RC delivered: taken before that generation's end
+};
+// An older generation's successful RECV (`g` < gen; its slot collected already): RC ACKed it, so it is taken, in that
+// generation's order, in front of that generation's end in the inbox. False: no such end any more (the pump told the
+// loss), or not the next message of that generation (a gap, a bad envelope): dropped and counted.
+static inline bool gdakiCtrlRingTakeOld(struct gdakiCtrlRingPair* p, uint32_t g, const uint8_t* frame, uint32_t len) {
+  struct gdakiCtrlEnv e;
+  if (frame == nullptr || len < sizeof(e)) return false;
+  memcpy(&e, frame, sizeof(e));
+  if (gdakiCtrlEnvCheck(&e, p->nonce, len) != GDAKI_CTRL_ENV_OK || e.from != p->peer || e.gen != g) return false;
+  const bool conn = e.kind == GDAKI_CTRL_K_CONNECTED;  // that generation's first message: its seq, nothing to read
+  if (!conn && e.kind != GDAKI_CTRL_K_RECORD && e.kind != GDAKI_CTRL_K_XFER && e.kind != GDAKI_CTRL_K_XFER_DONE) return false;
+  for (auto it = p->inbox.begin(); it != p->inbox.end(); ++it) {
+    if (!gdakiCtrlInIsEnd(*it) || it->env.gen != g) continue;
+    if (e.seq != it->env.seq + 1u || conn != (e.seq == 1u)) return false;
+    it->env.seq++;
+    if (conn) return true;
+    struct gdakiCtrlInEnt in;
+    in.env = e;
+    memcpy(in.body, frame + sizeof(e), e.bodyBytes);
+    p->inbox.insert(it, in);
+    return true;
+  }
+  return false;
+}
+// A RECV's completion with the slot's bytes (`frame`, `len` bytes landed; ok false: an error or a flush).
+static inline int gdakiCtrlRingOnRecvCqe(struct gdakiCtrlRingPair* p, const struct gdakiCtrlRingOps& ops, uint64_t wrId,
+                                         bool ok, const uint8_t* frame, uint32_t len) {
+  const uint32_t s = gdakiCtrlWrSlot(wrId), g = gdakiCtrlWrGen(wrId);
+  if (s >= GDAKI_CTRL_RING_SLOTS) return GDAKI_CTRL_RX_IGNORED;
+  if (g != p->gen) {
+    const bool mine = p->slotGen[s] == g;
+    if (mine) p->slotGen[s] = 0;  // collected: the slot may take gen's RECV
+    p->oldRecvCqes++;
+    if (mine && ok) {  // RC delivered it before the change: taken (REVIEW_P12 막는 문제 8)
+      if (gdakiCtrlRingTakeOld(p, g, frame, len)) {
+        p->oldTaken++;
+        return GDAKI_CTRL_RX_TAKEN_OLD;
+      }
+      p->oldDropped++;
+    }
+    return GDAKI_CTRL_RX_OLD;
+  }
+  if (p->slotGen[s] != g) return GDAKI_CTRL_RX_IGNORED;
+  p->slotGen[s] = 0;
+  if (!ok) {
+    gdakiCtrlRingLose(p, "RECVERR");
+    return GDAKI_CTRL_RX_LOST;
+  }
+  // a success after the loss (an SQ error came first in the CQ): RC delivered it, so it is taken; its RECV is not given
+  // again (the QP is in ERR; REVIEW_P12 막는 문제 8)
+  struct gdakiCtrlEnv e;
+  if (len < sizeof(e)) {
+    gdakiCtrlRingLose(p, "SHORT");
+    return GDAKI_CTRL_RX_LOST;
+  }
+  memcpy(&e, frame, sizeof(e));
+  if (gdakiCtrlEnvCheck(&e, p->nonce, len) != GDAKI_CTRL_ENV_OK || e.from != p->peer) {
+    gdakiCtrlRingLose(p, "BADENV");
+    return GDAKI_CTRL_RX_LOST;
+  }
+  const uint32_t ord = gdakiCtrlOrder(p->gen, p->lastSeq, &e);
+  if (ord == GDAKI_CTRL_ORDER_DROP_OLD) {  // an older generation's packet in a RECV of gen: given back, not counted
+    p->oldEnvelopes++;
+    if (!p->lost) gdakiCtrlRingRepost(p, ops, s, false);
+    return GDAKI_CTRL_RX_OLD;
+  }
+  if (ord != GDAKI_CTRL_ORDER_TAKE) {
+    gdakiCtrlRingLose(p, "SEQ");
+    return GDAKI_CTRL_RX_LOST;
+  }
+  p->lastSeq++;
+  gdakiCtrlRingLearnConsumed(p, (uint32_t)e.ackSeq);
+  const uint8_t* body = frame + sizeof(e);
+  if (e.kind == GDAKI_CTRL_K_PAIR) {  // a PAIR is UD only (the header's CONNECTED is its own kind)
+    gdakiCtrlRingLose(p, "BADPAIR");
+    return GDAKI_CTRL_RX_LOST;
+  }
+  if (e.kind == GDAKI_CTRL_K_CONNECTED) {  // the first message of gen, from the side that started the pairing
+    if (p->initiator || p->connected || e.seq != 1) {
+      gdakiCtrlRingLose(p, "BADCONN");
+      return GDAKI_CTRL_RX_LOST;
+    }
+    p->connected = true;
+    if (!p->lost) gdakiCtrlRingRepost(p, ops, s, true);  // the inbox is empty at a generation's first message
+    return GDAKI_CTRL_RX_TAKEN;
+  }
+  if (e.kind == GDAKI_CTRL_K_RECORD) {
+    uint32_t m;
+    memcpy(&m, body, 4);
+    if (m != p->recMagic) {
+      gdakiCtrlRingLose(p, "BADMAGIC");
+      return GDAKI_CTRL_RX_LOST;
+    }
+  }
+  if (!p->connected) {  // a message before CONNECTED (the other side's rule broken)
+    gdakiCtrlRingLose(p, "EARLY");
+    return GDAKI_CTRL_RX_LOST;
+  }
+  p->inbox.emplace_back();
+  struct gdakiCtrlInEnt& in = p->inbox.back();
+  in.env = e;
+  memcpy(in.body, body, e.bodyBytes);
+  if (p->lost) {
+  } else if (p->deferred.empty() && p->inbox.size() <= GDAKI_CTRL_INBOX_MAX) {
+    gdakiCtrlRingRepost(p, ops, s, true);
+  } else {
+    p->deferred.push_back(s);
+  }
+  return GDAKI_CTRL_RX_TAKEN;
+}
+// The oldest inbox message: 1 taken (and the deferred RECVs given back while below the bound), 0 none yet, -1 once
+// per lost connection: at an older generation's end once its RECVs are all collected (a re-pairing either side
+// started), or with nothing left when gen's connection is lost (lostCause). That -1 is TCP's FIN (decision 6: the round
+// is cancelled; REVIEW_P12 막는 문제 8).
+static inline int gdakiCtrlRingPop(struct gdakiCtrlRingPair* p, const struct gdakiCtrlRingOps& ops,
+                                   struct gdakiCtrlInEnt* out) {
+  if (p->inbox.empty()) {
+    if (!p->lost || p->lossToldGen == p->gen) return 0;
+    if (!p->connected && p->q.empty()) return 0;  // never connected, nothing queued: no -1 (REVIEW_FIX12_P2B 고칠 것 3)
+    p->lossToldGen = p->gen;
+    return -1;
+  }
+  if (gdakiCtrlInIsEnd(p->inbox.front())) {
+    const uint32_t g = p->inbox.front().env.gen;
+    if (gdakiCtrlRingRecvsOf(p, g) != 0) return 0;  // that generation's RECVs may still bring ACKed records
+    // connected, dropped queued messages, or a record of it came after the change (seq 1 is CONNECTED)
+    const bool told = p->inbox.front().env.ackSeq != 0 || p->inbox.front().env.seq >= 2;
+    p->inbox.pop_front();
+    p->lossToldGen = g;
+    if (!told) return gdakiCtrlRingPop(p, ops, out);  // never connected: no -1 (one per connection)
+    return -1;
+  }
+  *out = p->inbox.front();
+  p->inbox.pop_front();
+  gdakiCtrlRingUndefer(p, ops);
+  return 1;
+}
+
+// ---- the UD pairing of one (pair, QP kind) (design v3 2.5; EXPERIMENT.md 9.1 "짝 맺기") ----
+// The record QP (GDAKI_CTRL_PAIR_QP_RECORD) and the liveness READ QP (_PROBE) of a pair pair separately, each with its
+// generation. Either side starts (the setup: the lower rank; after an ERR: the side that saw it) with PAIR(kind, cur + 1);
+// crossing PAIRs of one generation: the lower `from` wins (a rank against a launcher, 0x40000000 | node, always), the
+// other answers it. Every pairing draws a fresh PSN. Every step takes the lineage's verdict on the sender's incarnation
+// (`lnOk`: gdakiLnClassify says CURRENT; HELD_OLD, STALE and FUTURE are dropped with one GIN/LN line, REVIEW_P12 막는
+// 문제 7: a held rank's old incarnation never brings a QP back to RTS), and PAIRs of another incarnation than the peer's
+// known one are dropped too (a new incarnation comes in through the REJOIN, which sets it: gdakiCtrlPairSetPeerInc for
+// both kinds). What each step asks of the caller is an action.
+#define GDAKI_CTRL_PAIR_RESEND_MS 500.0       // a PAIR without an answer is sent again (as HELLO)
+#define GDAKI_CTRL_PAIR_DONE_WAIT_MS 500.0    // the answering side of a liveness READ QP starts its READs at the latest
+enum : uint32_t {
+  GDAKI_CTRL_PS_IDLE = 0,      // nothing in progress (cur 0: never paired)
+  GDAKI_CTRL_PS_STARTED = 1,   // this side's PAIR(mine) is out: its QP is INIT (record: K RECVs posted), fresh PSN
+  GDAKI_CTRL_PS_ANSWERED = 2,  // this side took the peer's PAIR(cur): RTS, PAIR_ACK sent; waiting for CONNECTED (record)
+                               // or PAIR_DONE (probe; at the latest after 500 ms the READs start)
+  GDAKI_CTRL_PS_UP = 3,        // cur is connected
+  GDAKI_CTRL_PS_GAVE_UP = 4,   // the bound passed: the pair's channel of this kind is "unknown" (the judgement decides)
+};
+enum : uint32_t {
+  GDAKI_CTRL_PA_NONE = 0,
+  GDAKI_CTRL_PA_DROP = 1,         // the datagram is dropped (stale, a crossing this side wins, another incarnation)
+  GDAKI_CTRL_PA_SEND_PAIR = 2,    // prepare the QP for gen `mine` (ERR -> collect -> RESET -> INIT, or a new QP; a fresh
+                                  // PSN; record: the ring's new generation as initiator and its K RECVs) and send PAIR
+  GDAKI_CTRL_PA_RESEND_PAIR = 3,  // the same PAIR again (no answer for 500 ms)
+  GDAKI_CTRL_PA_TAKE = 4,         // answer: the QP for gen `cur` toward the PAIR's endpoint (reuse: this side's own QP
+                                  // prepared for that gen; else ERR -> collect -> RESET, a fresh PSN; record: the ring's
+                                  // new generation as the other side and its K RECVs, before RTR), RTR, RTS, PAIR_ACK
+  GDAKI_CTRL_PA_RESEND_ACK = 5,   // the stored PAIR_ACK again (the same PAIR came again), the QP untouched
+  GDAKI_CTRL_PA_CONNECT = 6,      // the answer came: RTR, RTS toward its endpoint; record: CONNECTED goes first on the
+                                  // ring (gdakiCtrlRingKick), probe: PAIR_DONE over UD and the READs start
+  GDAKI_CTRL_PA_RESEND_DONE = 7,  // probe: the PAIR_ACK came again (the PAIR_DONE was lost): PAIR_DONE again
+  GDAKI_CTRL_PA_UP = 8,           // the answering side: CONNECTED or PAIR_DONE came, or 500 ms passed (probe)
+  GDAKI_CTRL_PA_GIVE_UP = 9,      // the bound passed (setup NCCL_GIN_TS_CONNECT_MS, re-pairing _RECONNECT_MS)
+};
+struct gdakiCtrlPairSt {
+  uint32_t qpKind = GDAKI_CTRL_PAIR_QP_RECORD;
+  int32_t me = -1, peer = -1;
+  uint32_t state = GDAKI_CTRL_PS_IDLE;
+  uint32_t cur = 0;            // the generation in use (taken or connected); 0: never paired
+  uint32_t mine = 0;           // this side's PAIR outstanding (0: none)
+  uint32_t lastMine = 0;       // the generation of this side's last attempt (a new attempt goes above it, given up or not)
+  bool answeredCur = false;    // cur came from the peer's PAIR (this side answered: its repeat gets the stored answer)
+  uint32_t answeredQpn = 0, answeredPsn = 0;  // the endpoint of the PAIR this side answered (REVIEW_P12 고칠 것 10)
+  bool lnLogged = false, lnLog = false;  // a lineage drop: lnLog says the caller writes its one GIN/LN line now
+  uint32_t lnLoggedInc = 0;
+  bool reusedMine = false;     // the last TAKE used this side's own QP prepared for the same generation
+  bool peerIncKnown = false;
+  uint32_t peerInc = 0;
+  bool havePsn = false;
+  uint32_t lastPsn = 0;        // the PSN of the last pairing (gdakiCtrlPairPsnFresh)
+  double startMs = 0, nextMs = 0, boundMs = 0, answeredMs = 0;
+  uint64_t pairsSent = 0, acksSent = 0, dropped = 0, droppedInc = 0, droppedLn = 0, gaveUp = 0, retaken = 0;
+  struct gdakiCtrlPairBody ack;  // the stored PAIR_ACK of cur (answeredCur)
+};
+static inline void gdakiCtrlPairInit(struct gdakiCtrlPairSt* s, uint32_t qpKind, int32_t me, int32_t peer) {
+  *s = gdakiCtrlPairSt();
+  s->qpKind = qpKind;
+  s->me = me;
+  s->peer = peer;
+  memset(&s->ack, 0, sizeof(s->ack));
+}
+// The peer's incarnation, from the setup's all-gather or an accepted REJOIN.
+static inline void gdakiCtrlPairSetPeerInc(struct gdakiCtrlPairSt* s, uint32_t inc) {
+  s->peerIncKnown = true;
+  s->peerInc = inc;
+}
+// A PSN for a new pairing must differ from the last one's (a fresh draw, design v3 2.5): true takes it.
+static inline bool gdakiCtrlPairPsnFresh(struct gdakiCtrlPairSt* s, uint32_t psn) {
+  psn &= 0xffffffu;
+  if (s->havePsn && psn == s->lastPsn) return false;
+  s->havePsn = true;
+  s->lastPsn = psn;
+  return true;
+}
+// This side starts (the setup's lower rank, or it saw its QP of this kind in ERR): PAIR(cur + 1), resent every 500 ms
+// until boundMs. Starting again while started is nothing (the same attempt).
+static inline uint32_t gdakiCtrlPairStart(struct gdakiCtrlPairSt* s, double nowMs, double boundMs) {
+  if (s->state == GDAKI_CTRL_PS_STARTED) return GDAKI_CTRL_PA_NONE;
+  // above the last attempt too: after a give-up the peer may have taken that generation (REVIEW_P12 고칠 것 10)
+  s->mine = (s->cur > s->lastMine ? s->cur : s->lastMine) + 1u;
+  s->lastMine = s->mine;
+  s->state = GDAKI_CTRL_PS_STARTED;
+  s->startMs = nowMs;
+  s->nextMs = nowMs + GDAKI_CTRL_PAIR_RESEND_MS;
+  s->boundMs = boundMs;
+  s->pairsSent++;
+  return GDAKI_CTRL_PA_SEND_PAIR;
+}
+// This side's QP of this kind went to ERR in generation `gen` (a bad completion of gen, an async event, the test switch):
+// a re-pairing starts unless it is an older generation's (its flushes after a re-pairing) or one is in progress.
+static inline uint32_t gdakiCtrlPairOnQpErr(struct gdakiCtrlPairSt* s, uint32_t gen, double nowMs, double boundMs) {
+  if (gen != s->cur || s->cur == 0) return GDAKI_CTRL_PA_NONE;
+  return gdakiCtrlPairStart(s, nowMs, boundMs);
+}
+// The lineage's verdict and the known incarnation (every step first). False: dropped (lnLog: the one GIN/LN line).
+static inline bool gdakiCtrlPairIncOk(struct gdakiCtrlPairSt* s, uint32_t inc, bool lnOk) {
+  s->lnLog = false;
+  if (!lnOk) {
+    s->droppedLn++;
+    s->dropped++;
+    if (!s->lnLogged || s->lnLoggedInc != inc) {
+      s->lnLogged = true;
+      s->lnLoggedInc = inc;
+      s->lnLog = true;
+    }
+    return false;
+  }
+  if (!s->peerIncKnown || inc == s->peerInc) return true;
+  s->droppedInc++;
+  s->dropped++;
+  return false;
+}
+// A PAIR(kind, theirGen) from the peer with its QP endpoint (theirQp; null: not known). TAKE: the caller answers (and
+// stores the answer with gdakiCtrlPairStoreAck). The same generation again from another endpoint (the peer gave up and
+// started again with a new QP or PSN) is taken again, never answered from the stored answer (REVIEW_P12 고칠 것 10).
+static inline uint32_t gdakiCtrlPairOnPair(struct gdakiCtrlPairSt* s, uint32_t theirGen, uint32_t theirInc, bool lnOk,
+                                           const struct gdakiCtrlEndpoint* theirQp, double nowMs) {
+  if (!gdakiCtrlPairIncOk(s, theirInc, lnOk)) return GDAKI_CTRL_PA_DROP;
+  const uint32_t mineGen = s->state == GDAKI_CTRL_PS_STARTED ? s->mine : 0u;
+  uint32_t res = gdakiCtrlPairResolve(s->me, s->peer, s->cur, mineGen, theirGen, s->answeredCur);
+  if (res == GDAKI_CTRL_PAIR_REPEAT && theirQp != nullptr &&
+      (theirQp->qpn != s->answeredQpn || (theirQp->psn & 0xffffffu) != s->answeredPsn)) {
+    res = GDAKI_CTRL_PAIR_TAKE;
+    s->retaken++;
+  }
+  switch (res) {
+    case GDAKI_CTRL_PAIR_REPEAT:
+      s->acksSent++;
+      return GDAKI_CTRL_PA_RESEND_ACK;
+    case GDAKI_CTRL_PAIR_TAKE:
+      s->reusedMine = mineGen == theirGen;
+      s->cur = theirGen;
+      if (theirGen > s->lastMine) s->lastMine = theirGen;
+      s->mine = 0;
+      s->answeredCur = true;
+      s->answeredQpn = theirQp != nullptr ? theirQp->qpn : 0u;
+      s->answeredPsn = theirQp != nullptr ? (theirQp->psn & 0xffffffu) : 0u;
+      s->state = GDAKI_CTRL_PS_ANSWERED;
+      s->answeredMs = nowMs;
+      s->acksSent++;
+      return GDAKI_CTRL_PA_TAKE;
+    default:  // STALE, KEEP_MINE
+      s->dropped++;
+      return GDAKI_CTRL_PA_DROP;
+  }
+}
+static inline void gdakiCtrlPairStoreAck(struct gdakiCtrlPairSt* s, const struct gdakiCtrlPairBody& ack) { s->ack = ack; }
+// A PAIR_ACK(kind, gen) from the peer.
+static inline uint32_t gdakiCtrlPairOnAck(struct gdakiCtrlPairSt* s, uint32_t gen, uint32_t theirInc, bool lnOk) {
+  if (!gdakiCtrlPairIncOk(s, theirInc, lnOk)) return GDAKI_CTRL_PA_DROP;
+  if (s->state == GDAKI_CTRL_PS_STARTED && gen == s->mine) {
+    s->cur = s->mine;
+    s->mine = 0;
+    s->answeredCur = false;
+    s->state = GDAKI_CTRL_PS_UP;
+    return GDAKI_CTRL_PA_CONNECT;
+  }
+  if (gen == s->cur && !s->answeredCur && s->state == GDAKI_CTRL_PS_UP)
+    return s->qpKind == GDAKI_CTRL_PAIR_QP_PROBE ? GDAKI_CTRL_PA_RESEND_DONE : GDAKI_CTRL_PA_NONE;
+  s->dropped++;
+  return GDAKI_CTRL_PA_DROP;
+}
+// CONNECTED (record: the ring took it, gdakiCtrlRingOnRecvCqe; lnOk true: the RC QP's peer is the paired one) or
+// PAIR_DONE (probe, a datagram) of gen.
+static inline uint32_t gdakiCtrlPairOnDone(struct gdakiCtrlPairSt* s, uint32_t gen, uint32_t theirInc, bool lnOk) {
+  if (!gdakiCtrlPairIncOk(s, theirInc, lnOk)) return GDAKI_CTRL_PA_DROP;
+  if (s->state == GDAKI_CTRL_PS_ANSWERED && gen == s->cur) {
+    s->state = GDAKI_CTRL_PS_UP;
+    return GDAKI_CTRL_PA_UP;
+  }
+  if (gen != s->cur) s->dropped++;
+  return gen == s->cur ? GDAKI_CTRL_PA_NONE : GDAKI_CTRL_PA_DROP;
+}
+// The clock: resend, the probe's 500 ms start, the bound.
+static inline uint32_t gdakiCtrlPairTick(struct gdakiCtrlPairSt* s, double nowMs) {
+  if (s->state == GDAKI_CTRL_PS_STARTED) {
+    if (nowMs - s->startMs >= s->boundMs) {
+      s->state = GDAKI_CTRL_PS_GAVE_UP;
+      s->mine = 0;
+      s->gaveUp++;
+      return GDAKI_CTRL_PA_GIVE_UP;
+    }
+    if (nowMs >= s->nextMs) {
+      s->nextMs = nowMs + GDAKI_CTRL_PAIR_RESEND_MS;
+      s->pairsSent++;
+      return GDAKI_CTRL_PA_RESEND_PAIR;
+    }
+    return GDAKI_CTRL_PA_NONE;
+  }
+  if (s->state == GDAKI_CTRL_PS_ANSWERED && s->qpKind == GDAKI_CTRL_PAIR_QP_PROBE &&
+      nowMs - s->answeredMs >= GDAKI_CTRL_PAIR_DONE_WAIT_MS) {
+    s->state = GDAKI_CTRL_PS_UP;
+    return GDAKI_CTRL_PA_UP;
+  }
+  return GDAKI_CTRL_PA_NONE;
+}
+// The pairing body of this side (PAIR or PAIR_ACK) for (kind, gen) with its QP's and UD QP's endpoints and regions.
+static inline struct gdakiCtrlPairBody gdakiCtrlPairBodyOf(const struct gdakiCtrlPairSt* s, uint32_t step, uint32_t gen,
+                                                           uint32_t inc, uint64_t nonce, const struct gdakiCtrlEndpoint& qp,
+                                                           const struct gdakiCtrlEndpoint& ud,
+                                                           const struct gdakiCtrlRegion& page,
+                                                           const struct gdakiCtrlRegion& outbox) {
+  struct gdakiCtrlPairBody b;
+  memset(&b, 0, sizeof(b));
+  b.qpKind = s->qpKind;
+  b.step = step;
+  b.gen = gen;
+  b.incarnation = inc;
+  b.from = s->me;
+  b.to = s->peer;
+  b.nonce = nonce;
+  b.qp = qp;
+  b.ud = ud;
+  b.page = page;
+  b.outbox = outbox;
+  return b;
+}
+// A received pairing datagram's body is well formed for (me, nonce): its kind and step, addressed to me, its endpoints
+// (needUd false: a transport without UD, the scaffold's record 55, carries no UD endpoint).
+static inline bool gdakiCtrlPairBodyOk(const struct gdakiCtrlPairBody& b, int32_t me, uint64_t nonce, bool needUd = true) {
+  if (b.qpKind != GDAKI_CTRL_PAIR_QP_RECORD && b.qpKind != GDAKI_CTRL_PAIR_QP_PROBE) return false;
+  if (b.step != GDAKI_CTRL_PAIR_STEP_PAIR && b.step != GDAKI_CTRL_PAIR_STEP_ACK && b.step != GDAKI_CTRL_PAIR_STEP_DONE)
+    return false;
+  if (b.to != me || b.nonce != nonce || b.gen == 0) return false;
+  if (b.step == GDAKI_CTRL_PAIR_STEP_DONE) return true;  // PAIR_DONE carries no endpoint
+  return gdakiCtrlEndpointOk(b.qp) && b.qp.qpType == GDAKI_CTRL_QPT_RC &&
+         (!needUd || (gdakiCtrlEndpointOk(b.ud) && b.ud.qpType == GDAKI_CTRL_QPT_UD));
+}
+
+// ---- the REJOIN over UD: the nrp block and the survivor's idempotency table (EXPERIMENT.md 9.5 (5); design v3 5.4) ----
+// The REJOIN and REJOIN_ACK carry struct gdakiCtrlRejoinNrp in the record's unused nrp[] (256 B), put and got with the
+// header's gdakiCtrlNrpPut and gdakiCtrlNrpGet (memcpy; integration: phase 2a-1's own put/get are deleted). gen and
+// probeGen: the generations the record QP and the liveness READ QP pairings start with, each kind its own counter (the
+// header's two; integration: notes_p2.md 결정 10's "max(record, probe) + 1 for both" is dropped).
+// What the model asks of a block that gdakiCtrlNrpGet took (version 1): false when it is malformed.
+static inline bool gdakiCtrlRejoinNrpOk(const struct gdakiCtrlRejoinNrp& n, bool isAck) {
+  const struct gdakiCtrlRejoinNrp* out = &n;
+  if (out->version != GDAKI_CTRL_NRP_VERSION || out->gen == 0 || out->probeGen == 0) return false;
+  if (!gdakiCtrlEndpointOk(out->rec) || out->rec.qpType != GDAKI_CTRL_QPT_RC) return false;
+  if (!gdakiCtrlEndpointOk(out->probe) || out->probe.qpType != GDAKI_CTRL_QPT_RC) return false;
+  if (!isAck && (!gdakiCtrlEndpointOk(out->ud) || out->ud.qpType != GDAKI_CTRL_QPT_UD)) return false;
+  return out->rec.qpn != out->probe.qpn;
+}
+// The survivor's table for one held rank (only while that rank is HELD: gdakiCtrlRejoinHold at the hold start,
+// gdakiCtrlRejoinEnd at its end). The acceptance itself is the existing rule's (HELD, known + 1, nonce, the park check,
+// FAIL to a refused rank; the buddy's fence word): the table only answers what comes after an acceptance.
+enum : uint32_t {
+  GDAKI_CTRL_RJ_RULES = 0,     // no acceptance in the table for this (from, incarnation): the existing rule decides
+  GDAKI_CTRL_RJ_REPEAT = 1,    // accepted already with this QPN: send the stored REJOIN_ACK again, the QPs untouched
+  GDAKI_CTRL_RJ_DROP_QPN = 2,  // accepted already with another QPN: dropped (never FAIL: a stray datagram must not end
+                               // the spare); `log` says whether this is the first such drop for that QPN (one GIN/LN line)
+  GDAKI_CTRL_RJ_DROP_OLD = 3,  // an older incarnation than the accepted one: dropped
+  GDAKI_CTRL_RJ_NOT_HELD = 4,  // the rank is not HELD: no table (the existing rule refuses, as today)
+};
+struct gdakiCtrlRejoinSt {
+  bool held = false;
+  bool accepted = false;
+  int32_t from = -1;
+  uint32_t inc = 0, qpn = 0;   // the accepted REJOIN's incarnation and the spare's record QPN
+  uint32_t probeQpn = 0;       // and its liveness READ QPN (REVIEW_P12 고칠 것 11: a REPEAT answers the same two only)
+  uint64_t logged[8] = {0};    // the other (record, probe) QPN pairs a GIN/LN line was written for (REVIEW_P12 nit 7)
+  uint32_t nLogged = 0;
+  uint64_t repeats = 0, droppedQpn = 0, droppedOld = 0;
+  uint8_t ack[GDAKI_CTRL_RECORD_BYTES];  // the stored REJOIN_ACK record, byte for byte
+};
+static inline void gdakiCtrlRejoinHold(struct gdakiCtrlRejoinSt* t, int32_t from) {
+  t->held = true;
+  t->accepted = false;
+  t->from = from;
+  t->inc = t->qpn = t->probeQpn = t->nLogged = 0;
+}
+static inline void gdakiCtrlRejoinEnd(struct gdakiCtrlRejoinSt* t) {
+  t->held = false;
+  t->accepted = false;
+}
+// The spare never makes its QPs again within one restore (design v3 5.4, D:944, over the whole restore): every REJOIN
+// of incarnation i + 1 then carries the same two QPNs, and the first that reaches the rule is the only one there is.
+static inline uint32_t gdakiCtrlRejoinOn(struct gdakiCtrlRejoinSt* t, int32_t from, uint32_t inc, uint32_t qpn,
+                                         uint32_t probeQpn, bool* log) {
+  *log = false;
+  if (!t->held || from != t->from) return GDAKI_CTRL_RJ_NOT_HELD;
+  if (!t->accepted || inc > t->inc) return GDAKI_CTRL_RJ_RULES;
+  if (inc < t->inc) {
+    t->droppedOld++;
+    return GDAKI_CTRL_RJ_DROP_OLD;
+  }
+  if (qpn == t->qpn && probeQpn == t->probeQpn) {
+    t->repeats++;
+    return GDAKI_CTRL_RJ_REPEAT;
+  }
+  t->droppedQpn++;
+  const uint64_t key = ((uint64_t)qpn << 32) | probeQpn;
+  bool seen = false;
+  for (uint32_t i = 0; i < t->nLogged && !seen; i++) seen = t->logged[i] == key;
+  if (!seen) {
+    if (t->nLogged < 8) t->logged[t->nLogged++] = key;
+    *log = true;
+  }
+  return GDAKI_CTRL_RJ_DROP_QPN;
+}
+// The existing rule accepted (from, inc) with the spare's record and liveness READ QPNs; the answer is stored for a repeat.
+static inline void gdakiCtrlRejoinAccepted(struct gdakiCtrlRejoinSt* t, uint32_t inc, uint32_t qpn, uint32_t probeQpn,
+                                           const void* ack, size_t ackBytes) {
+  t->accepted = true;
+  t->inc = inc;
+  t->qpn = qpn;
+  t->probeQpn = probeQpn;
+  memset(t->ack, 0, sizeof(t->ack));
+  memcpy(t->ack, ack, ackBytes <= sizeof(t->ack) ? ackBytes : sizeof(t->ack));
+}
+
+// ---- the outbox (EXPERIMENT.md 9.1 "큰 자료"): two halves, XFER and XFER_DONE ----
+// The giver fills a free half and sends XFER(id, bytes, half, rkey, END on the last piece); the half is free again at
+// its XFER_DONE. The receiver takes an XFER of the next id only, READs it, answers XFER_DONE with the same body.
+struct gdakiCtrlOutboxSt {
+  bool busy[2] = {false, false};
+  uint64_t busyId[2] = {0, 0};
+  uint64_t nextId = 1;        // the giver's next piece
+  uint64_t expectId = 1;      // the receiver's next piece
+};
+// The giver: a free half for the next piece (-1: both wait for their XFER_DONE).
+static inline int gdakiCtrlOutboxTake(struct gdakiCtrlOutboxSt* o, uint64_t bytes, uint32_t rkey, bool end,
+                                      struct gdakiCtrlXfer* x) {
+  if (bytes > GDAKI_CTRL_OUTBOX_HALF_BYTES) return -1;
+  for (int h = 0; h < 2; h++) {
+    if (o->busy[h]) continue;
+    o->busy[h] = true;
+    o->busyId[h] = o->nextId;
+    memset(x, 0, sizeof(*x));
+    x->xferId = o->nextId++;
+    x->bytes = bytes;
+    x->half = (uint32_t)h;
+    x->rkey = rkey;
+    x->flags = end ? GDAKI_CTRL_XFER_F_END : 0u;
+    return h;
+  }
+  return -1;
+}
+// The giver: an XFER_DONE; false: not one of its pieces in flight (dropped)
+static inline bool gdakiCtrlOutboxDone(struct gdakiCtrlOutboxSt* o, const struct gdakiCtrlXfer& x) {
+  if (x.half > 1 || !o->busy[x.half] || o->busyId[x.half] != x.xferId) return false;
+  o->busy[x.half] = false;
+  return true;
+}
+// A new generation of the pair (REVIEW_P12 고칠 것 15): an XFER_DONE of the old one never comes, so both halves are free
+// and the ids start again (the transfer in flight fails: its sender sees the lost connection).
+static inline void gdakiCtrlOutboxNewGen(struct gdakiCtrlOutboxSt* o) { *o = gdakiCtrlOutboxSt(); }
+// The receiver: an XFER it may READ (the next id, a half, its size, the rkey of the giver's outbox from the pairing)
+static inline bool gdakiCtrlOutboxAccept(struct gdakiCtrlOutboxSt* o, const struct gdakiCtrlXfer& x, uint32_t rkey) {
+  if (x.xferId != o->expectId || x.half > 1 || x.bytes > GDAKI_CTRL_OUTBOX_HALF_BYTES || x.rkey != rkey) return false;
+  o->expectId++;
+  return true;
+}
+
+// ---- the pair's path: this side's choice and the receiver's order rule (phase 2a-2-C; the marker above) ----
+// The verdict on one record that came on a path, and why a pending path generation was taken. Path generations are
+// consecutive on the sender; the receiver may see a later one first (another path is faster), so the announced ones wait
+// in generation order and only the next one (rxGen + 1) is taken by the count or the closed old path; any waits at most
+// GDAKI_CTRL_PM_WAIT_MS from its announcement (a generation that never showed is skipped then).
+enum : uint32_t { GDAKI_CTRL_PM_TAKE = 0, GDAKI_CTRL_PM_HOLD = 1, GDAKI_CTRL_PM_DROP = 2 };
+enum : uint32_t {
+  GDAKI_CTRL_PM_W_NONE = 0,
+  GDAKI_CTRL_PM_W_ALL = 1,     // the old path's counted records were all taken
+  GDAKI_CTRL_PM_W_CLOSED = 2,  // the old path closed
+  GDAKI_CTRL_PM_W_WAITED = 3,  // GDAKI_CTRL_PM_WAIT_MS passed
+  GDAKI_CTRL_PM_W_NEWER = 4,   // more than GDAKI_CTRL_PM_PEND_MAX generations wait: the oldest is taken at once
+};
+#define GDAKI_CTRL_PM_PEND_MAX 4u
+struct gdakiCtrlPathRec {      // one record's bytes (struct gdakiTsMsg; the model does not need its fields)
+  uint8_t b[GDAKI_CTRL_RECORD_BYTES];
+};
+struct gdakiCtrlPathPend {     // an announced generation the receiver has not taken yet
+  uint32_t path = 0, gen = 0;
+  uint64_t before = 0;         // its marker's count of the generation before it
+  double sinceMs = 0;          // its announcement
+  std::deque<struct gdakiCtrlPathRec> held;  // its records, in arrival order
+};
+struct gdakiCtrlPathSt {
+  // the send side: where this side's records to the peer go (the seams consult it)
+  uint32_t txPath = GDAKI_CTRL_PM_SOCKET, txGen = 0;
+  uint64_t txSent = 0;     // records handed to txPath in txGen
+  uint64_t txBefore = 0;   // the marker's count: records handed to the path before txGen's
+  bool txMarkDue = false;  // a socket generation's marker record has not gone out yet (generation 0 has none)
+  // the receive side: where the peer's records are taken from
+  uint32_t rxPath = GDAKI_CTRL_PM_SOCKET, rxGen = 0;
+  uint64_t rxTaken = 0;    // records taken in rxGen
+  uint32_t sockGen = 0;    // the socket stream's generation (its last marker record's)
+  std::deque<struct gdakiCtrlPathPend> pend;  // announced generations above rxGen, in generation order
+  std::deque<struct gdakiCtrlPathRec> ready;  // taken records not handed out yet (the held ones after a switch first)
+  // the last switch (its line) and the counters
+  uint32_t lastWhy = GDAKI_CTRL_PM_W_NONE, lastFromPath = 0;
+  uint64_t lastTaken = 0, lastBefore = 0;
+  uint32_t lineGen = 0;    // the receive generation whose line is written (one per switch)
+  uint64_t switches = 0, dropped = 0, heldMax = 0;
+};
+static inline const char* gdakiCtrlPathName(uint32_t path) { return path == GDAKI_CTRL_PM_RING ? "ring" : "socket"; }
+static inline const char* gdakiCtrlPathWhyName(uint32_t why) {
+  switch (why) {
+    case GDAKI_CTRL_PM_W_ALL: return "all counted";
+    case GDAKI_CTRL_PM_W_CLOSED: return "old path closed";
+    case GDAKI_CTRL_PM_W_WAITED: return "1000 ms passed";
+    case GDAKI_CTRL_PM_W_NEWER: return "too many generations waiting";
+    default: return "none";
+  }
+}
+// This side's records to the peer go on `path` from now: a new generation whose marker carries the old path's count.
+// False: they already go there.
+static inline bool gdakiCtrlPathSwitch(struct gdakiCtrlPathSt* s, uint32_t path) {
+  if (s->txPath == path) return false;
+  s->txBefore = s->txSent;
+  s->txGen++;
+  s->txPath = path;
+  s->txSent = 0;
+  s->txMarkDue = path == GDAKI_CTRL_PM_SOCKET;  // the ring's envelopes carry it on every record
+  return true;
+}
+static inline struct gdakiCtrlPathMark gdakiCtrlPathMarkOf(const struct gdakiCtrlPathSt* s) {
+  struct gdakiCtrlPathMark m = {};
+  m.path = (uint8_t)s->txPath;
+  m.gen = s->txGen;
+  m.before = s->txBefore;
+  return m;
+}
+// The oldest waiting generation becomes the receive side's (its held records ready, counted in it).
+static inline uint32_t gdakiCtrlPathTake(struct gdakiCtrlPathSt* s, uint32_t why) {
+  struct gdakiCtrlPathPend& n = s->pend.front();
+  s->lastWhy = why;
+  s->lastFromPath = s->rxPath;
+  s->lastTaken = s->rxTaken;
+  s->lastBefore = n.gen == s->rxGen + 1u ? n.before : 0;
+  s->rxPath = n.path;
+  s->rxGen = n.gen;
+  s->rxTaken = n.held.size();
+  for (const struct gdakiCtrlPathRec& m : n.held) s->ready.push_back(m);
+  s->pend.pop_front();
+  s->switches++;
+  return why;
+}
+// The rule's step, one switch at most (the caller repeats it until NONE): the next generation is taken once the old
+// path's counted records are in or the old path closed; any waiting one once GDAKI_CTRL_PM_WAIT_MS passed since its
+// announcement. Returns why (NONE: still waiting, or nothing waits).
+static inline uint32_t gdakiCtrlPathStep(struct gdakiCtrlPathSt* s, bool oldClosed, double nowMs) {
+  if (s->pend.empty()) return GDAKI_CTRL_PM_W_NONE;
+  const struct gdakiCtrlPathPend& n = s->pend.front();
+  if (n.gen == s->rxGen + 1u && s->rxTaken >= n.before) return gdakiCtrlPathTake(s, GDAKI_CTRL_PM_W_ALL);
+  if (n.gen == s->rxGen + 1u && oldClosed) return gdakiCtrlPathTake(s, GDAKI_CTRL_PM_W_CLOSED);
+  if (nowMs - n.sinceMs >= GDAKI_CTRL_PM_WAIT_MS) return gdakiCtrlPathTake(s, GDAKI_CTRL_PM_W_WAITED);
+  return GDAKI_CTRL_PM_W_NONE;
+}
+// The waiting generation `gen` (announced now if it is new and above rxGen); null: not above rxGen (stale). *why: the
+// oldest taken at once (NEWER) to keep GDAKI_CTRL_PM_PEND_MAX.
+static inline struct gdakiCtrlPathPend* gdakiCtrlPathAnnounce(struct gdakiCtrlPathSt* s, uint32_t path, uint32_t gen,
+                                                              uint64_t before, double nowMs, uint32_t* why) {
+  *why = GDAKI_CTRL_PM_W_NONE;
+  if (gen <= s->rxGen) return nullptr;
+  auto it = s->pend.begin();
+  while (it != s->pend.end() && it->gen < gen) ++it;
+  if (it != s->pend.end() && it->gen == gen) return &*it;
+  struct gdakiCtrlPathPend n;
+  n.path = path;
+  n.gen = gen;
+  n.before = before;
+  n.sinceMs = nowMs;
+  it = s->pend.insert(it, n);
+  if (s->pend.size() <= GDAKI_CTRL_PM_PEND_MAX) return &*it;
+  *why = gdakiCtrlPathTake(s, GDAKI_CTRL_PM_W_NEWER);  // `gen` is not the oldest here (the bound is above 1)
+  for (struct gdakiCtrlPathPend& p : s->pend)
+    if (p.gen == gen) return &p;
+  return nullptr;
+}
+// The socket's marker record: the socket stream's generation from here on (and its announcement).
+static inline uint32_t gdakiCtrlPathSockMark(struct gdakiCtrlPathSt* s, const struct gdakiCtrlPathMark& m, double nowMs) {
+  uint32_t why = GDAKI_CTRL_PM_W_NONE;
+  if (m.gen > s->sockGen) s->sockGen = m.gen;
+  (void)gdakiCtrlPathAnnounce(s, GDAKI_CTRL_PM_SOCKET, m.gen, m.before, nowMs, &why);
+  return why;
+}
+// The verdict on record `m` (GDAKI_CTRL_RECORD_BYTES) that came on `path` in path generation `gen` (the ring's: its envelope's marker, with its
+// count `before`; the socket's: sockGen): TAKE (the receive generation's, counted), HOLD (a waiting generation's, kept in
+// its held records; a new one is announced by it), DROP (an older generation's: after the switch). *why: a waiting
+// generation taken on the way (NEWER).
+static inline uint32_t gdakiCtrlPathIn(struct gdakiCtrlPathSt* s, uint32_t path, uint32_t gen, uint64_t before,
+                                       const void* m, double nowMs, uint32_t* why) {
+  *why = GDAKI_CTRL_PM_W_NONE;
+  if (path == s->rxPath && gen == s->rxGen) {
+    s->rxTaken++;
+    return GDAKI_CTRL_PM_TAKE;
+  }
+  struct gdakiCtrlPathPend* n = gdakiCtrlPathAnnounce(s, path, gen, before, nowMs, why);
+  if (n == nullptr) {
+    s->dropped++;
+    return GDAKI_CTRL_PM_DROP;
+  }
+  n->held.emplace_back();
+  memcpy(n->held.back().b, m, GDAKI_CTRL_RECORD_BYTES);
+  if (n->held.size() > s->heldMax) s->heldMax = n->held.size();
+  return GDAKI_CTRL_PM_HOLD;
+}
+#endif  // !NCCL_GIN_CTRL_TCP
+// ==== gin-control (ring): model (end) ====
+
+// ==== gin-control (ring): setup, pure (begin; phase 2a-2-A, impl/gc_unit_p2a2.cc compiles this region on the CPU) ====
+// The setup all-gather's control fields (EXPERIMENT.md 9.6, design v3 5.1; impl/rs_ctrl_api.h [2] gdakiCtrlSetupAddr and
+// gdakiCtrlSetupAgree): what this rank puts into `mine`, the verdict every rank reaches from the same records, the
+// spare's strict fields against its transcript, and Resume's conditions 41-44 (gdakiRsLocalCheck, after 40).
+#if !NCCL_GIN_CTRL_TCP
+struct gdakiCtrlSetupOut {
+  bool agreed = false;          // the agreement ran
+  uint32_t verdict = 0;         // 0, 42 (an MTU below 2048) or 44 (the path differs; a threshold drift is told as 44)
+  uint32_t sa = 0;              // gdakiCtrlSetupAgree's own answer (GDAKI_CTRL_SA_*)
+  int who = -1;                 // the first rank that differs (-1: none)
+  uint32_t minMtu = 0xffu;      // the lowest active MTU over the ranks (enum ibv_mtu)
+  uint32_t activeMtu = 0;       // this rank's (the GIN port's active_mtu)
+  uint32_t fork = 0xffu;        // this rank's ibv_is_fork_initialized() (0xff: the symbol is missing)
+  bool spareDiffers = false;    // a spare's path or launcher node is not its transcript's (44)
+  bool spare = false;           // a spare's setup (replayed): its pairings are its REJOIN's (phase 2a-2-C)
+  char why[192] = {0};          // the detail of a verdict other than 0
+};
+// This rank's fields: with the ring (path RDMA) its UD endpoint and outbox; without it (RDMA_OFF: the page parameter is 0
+// or the ring could not be made) none. The page region stays 0 (the PAIR carries it once the page is up).
+static inline void gdakiCtrlSetupMine(struct gdakiCtrlSetupAddr* a, bool ring, const struct gdakiCtrlEndpoint& ud,
+                                      const struct gdakiCtrlRegion& outbox, uint32_t activeMtu, uint32_t fork,
+                                      const struct gdakiCtrlThresholds& t) {
+  memset(a, 0, sizeof(*a));
+  a->path = ring ? GDAKI_CTRL_PATH_RDMA : GDAKI_CTRL_PATH_RDMA_OFF;
+  a->launcherNode = GDAKI_CTRL_LAUNCHER_NODE_NONE;
+  if (ring) {
+    a->ud = ud;
+    a->outbox = outbox;
+  }
+  a->activeMtu = activeMtu;
+  a->fork = fork;
+  a->probeMs = (int32_t)t.probeMs;
+  a->probeTimeoutMs = (int32_t)t.probeTimeoutMs;
+  a->confirmMs = (int32_t)t.confirmMs;
+  a->suspectMs = (int32_t)t.suspectMs;
+  a->stallMs = (int32_t)t.stallMs;
+}
+// The verdict over every rank's fields (all[p] null: a rank without transparent recovery, not counted): 0, or the Resume
+// condition that turns transparent recovery off at the setup (42, 44) with its text in *offWhy (a literal: the setup's
+// `why`) and the detail in o->why.
+static inline uint32_t gdakiCtrlSetupVerdict(const struct gdakiCtrlSetupAddr* const* all, int n, struct gdakiCtrlSetupOut* o,
+                                             const char** offWhy) {
+  *offWhy = nullptr;
+  o->agreed = true;
+  o->sa = gdakiCtrlSetupAgree(all, n, &o->minMtu, &o->who, o->why, sizeof(o->why));
+  switch (o->sa) {
+    case GDAKI_CTRL_SA_OK: o->verdict = 0; o->why[0] = 0; break;
+    case GDAKI_CTRL_SA_MTU: o->verdict = 42; *offWhy = GDAKI_CTRL_R42; break;
+    case GDAKI_CTRL_SA_PATH: o->verdict = 44; *offWhy = GDAKI_CTRL_R44; break;
+    default: o->verdict = 44; *offWhy = GDAKI_CTRL_R44T; break;  // GDAKI_CTRL_SA_THRESH
+  }
+  return o->verdict;
+}
+// The spare's strict fields against its transcript's own slot (design v3 5.1: the path and the launcher node; the rest may
+// differ). False: they differ (44), `why` says which.
+static inline bool gdakiCtrlSpareCtlMatch(const struct gdakiCtrlSetupAddr& rec, const struct gdakiCtrlSetupAddr& now,
+                                          char* why, size_t whyLen) {
+  if (rec.path != now.path) {
+    snprintf(why, whyLen, "the control path %u is not the transcript's %u", now.path, rec.path);
+    return false;
+  }
+  if (rec.launcherNode != now.launcherNode) {
+    snprintf(why, whyLen, "the launcher node %u is not the transcript's %u", now.launcherNode, rec.launcherNode);
+    return false;
+  }
+  return true;
+}
+#define GDAKI_CTRL_RESUME_WHY 320  // a condition's text: GDAKI_CTRL_R4x and its detail
+// Resume's conditions 41-44 of this rank (gdakiRsLocalIn's gc41-gc44: null, or the text): `o` null when the context has
+// no ring (no condition then: the records stay on the TCP path). launcherNamed: phase 3 named the node's launcher (41 is
+// asked only then); launcherPaired: the latch.
+static inline void gdakiCtrlResumeConds(const struct gdakiCtrlSetupOut* o, bool launcherNamed, bool launcherPaired,
+                                        char (*buf)[GDAKI_CTRL_RESUME_WHY], const char** c41, const char** c42, const char** c43,
+                                        const char** c44) {
+  *c41 = *c42 = *c43 = *c44 = nullptr;
+  if (o == nullptr) return;
+  if (launcherNamed && !launcherPaired) {
+    snprintf(buf[0], sizeof(buf[0]), "%s", GDAKI_CTRL_R41);
+    *c41 = buf[0];
+  }
+  if (o->agreed && o->verdict == 42) {
+    snprintf(buf[1], sizeof(buf[1]), "%s (%s)", GDAKI_CTRL_R42, o->why);
+    *c42 = buf[1];
+  }
+  if (o->fork != GDAKI_CTRL_FORK_UNNEEDED) {
+    snprintf(buf[2], sizeof(buf[2]), "%s (%s)", GDAKI_CTRL_R43,
+             o->fork == 0xffu ? "the symbol is missing" : o->fork == 0 ? "IBV_FORK_DISABLED" : "IBV_FORK_ENABLED");
+    *c43 = buf[2];
+  }
+  if ((o->agreed && o->verdict == 44) || o->spareDiffers) {
+    snprintf(buf[3], sizeof(buf[3]), "%s (%s)", o->sa == GDAKI_CTRL_SA_THRESH ? GDAKI_CTRL_R44T : GDAKI_CTRL_R44, o->why);
+    *c44 = buf[3];
+  }
+}
+// The page's rxConsumed[N] (`pageWords`, the page's words at layout.rxConsumedOff) takes over from the ring's own words:
+// every peer's word is copied first, then the ring publishes there (before any record goes on the ring: notes_fix12 6).
+static inline uint64_t* gdakiCtrlBindWords(uint64_t* own, uint64_t* pageWords, int nranks) {
+  for (int p = 0; p < nranks; p++) __atomic_store_n(&pageWords[p], __atomic_load_n(&own[p], __ATOMIC_ACQUIRE), __ATOMIC_RELEASE);
+  return pageWords;
+}
+#endif  // !NCCL_GIN_CTRL_TCP
+// ==== gin-control (ring): setup, pure (end) ====
+
+// ==== gin-control (ring): the liveness READ QP's pairing link (begin; REVIEW_P12 막는 문제 1, 4, 7, 고칠 것 12) ====
+// One pair's liveness READ QP pairing (the model's struct gdakiCtrlPairSt of kind PROBE) on the helper thread, over a
+// transport that carries struct gdakiCtrlPairBody: the verbs back end's UD datagram (gdakiCtrlRdma*; phase 2a-2-A: phase
+// 1's scaffold over record 55 PROBE_SETUP is gone, an incoming 55 is dropped with one line). The QP itself is the watch thread's: each model action that moves it is a request
+// (gdakiCtrlProbeAsk: PREPARE or CONNECT), and the datagram it needs goes when the watch thread's answer is there
+// (gdakiCtrlProbeLinkPoll), with the endpoint (and fresh PSN) the answer carries.
+#if !NCCL_GIN_CTRL_TCP
+typedef int (*gdakiCtrlProbeSendFn)(void* ctx, int peer, const struct gdakiCtrlPairBody& b);
+struct gdakiCtrlProbeLink {
+  struct gdakiCtrlPairSt st;
+  uint32_t pendAct = GDAKI_CTRL_PA_NONE;  // the action waiting for the watch thread's answer
+  uint32_t pendSeq = 0;
+  uint32_t pendGen = 0;
+  struct gdakiCtrlEndpoint local;         // the QP's endpoint of the last answer
+  bool haveLocal = false;
+  bool started = false;
+  uint32_t peerInc = 0;                   // the lineage's current incarnation the link was set up for
+  uint32_t fails = 0, failsGen = 0;       // breaks in a row without a success in between (PROBE_FAIL_N)
+  bool stopped = false;                   // PROBE_FAIL_N reached: no more re-pairing (row 12 or 16: report only)
+  uint64_t asked = 0, answered = 0, refused = 0;
+};
+struct gdakiCtrlProbeLinkCtx {  // the transport and this side's regions
+  void* ctx = nullptr;
+  gdakiCtrlProbeSendFn send = nullptr;
+  struct gdakiCtrlEndpoint ud;            // this side's UD QP (zero for the scaffold)
+  struct gdakiCtrlRegion page, outbox;
+  uint64_t nonce = 0;
+  uint32_t inc = 0;
+  const char* via = "";
+};
+static void gdakiCtrlProbeLinkSend(struct gdakiRecHost* r, int peer, struct gdakiCtrlProbeLink& k,
+                                   const struct gdakiCtrlProbeLinkCtx& c, uint32_t step, uint32_t gen) {
+  (void)r;
+  if (!k.haveLocal) return;
+  const struct gdakiCtrlPairBody b = gdakiCtrlPairBodyOf(&k.st, step, gen, c.inc, c.nonce, k.local, c.ud, c.page, c.outbox);
+  if (step == GDAKI_CTRL_PAIR_STEP_ACK) gdakiCtrlPairStoreAck(&k.st, b);
+  if (c.send(c.ctx, peer, b) != 0) k.refused++;
+}
+// The result of the pending request: its datagram goes now (true: none pending any more).
+static bool gdakiCtrlProbeLinkPoll(struct gdakiRecHost* r, int peer, struct gdakiCtrlProbeLink& k,
+                                   const struct gdakiCtrlProbeLinkCtx& c) {
+  if (k.pendSeq == 0) return true;
+  struct gdakiCtrlProbeRes res;
+  if (!gdakiCtrlProbeAnswer(r, peer, k.pendSeq, &res)) return false;
+  const uint32_t act = k.pendAct;
+  k.pendSeq = 0;
+  k.pendAct = GDAKI_CTRL_PA_NONE;
+  k.answered++;
+  if (!res.ok) {
+    k.haveLocal = false;
+    WARN("GIN/RC: rank %d: the liveness READ QP to rank %d (gen %u): %s mono_ms=%.3f", r->ctx->rank, peer, res.gen,
+         res.why, gdakiQ4MonoMs());
+    return true;
+  }
+  k.local = res.local;
+  k.haveLocal = true;
+  (void)gdakiCtrlPairPsnFresh(&k.st, res.local.psn);  // the pairing's last PSN (the next draw differs from it)
+  if (act == GDAKI_CTRL_PA_SEND_PAIR) gdakiCtrlProbeLinkSend(r, peer, k, c, GDAKI_CTRL_PAIR_STEP_PAIR, k.st.mine);
+  else if (act == GDAKI_CTRL_PA_TAKE) gdakiCtrlProbeLinkSend(r, peer, k, c, GDAKI_CTRL_PAIR_STEP_ACK, k.st.cur);
+  else if (act == GDAKI_CTRL_PA_CONNECT) {
+    gdakiCtrlProbeLinkSend(r, peer, k, c, GDAKI_CTRL_PAIR_STEP_DONE, k.st.cur);
+    GIN_TS_NOTE("GIN/RC: rank %d: liveness READ QP to rank %d %s (gen %u) via %s mono_ms=%.3f", r->ctx->rank, peer,
+                k.st.cur > 1 ? "re-paired" : "paired", k.st.cur, c.via, gdakiQ4MonoMs());
+  }
+  return true;
+}
+// Ask the watch thread for the action's QP operation (a pending one is finished first, bounded 50 ms).
+static void gdakiCtrlProbeLinkAsk(struct gdakiRecHost* r, int peer, struct gdakiCtrlProbeLink& k,
+                                  const struct gdakiCtrlProbeLinkCtx& c, uint32_t act, uint32_t op, uint32_t gen,
+                                  const struct gdakiCtrlPairBody* in) {
+  const double t0 = gdakiQ4MonoMs();
+  while (!gdakiCtrlProbeLinkPoll(r, peer, k, c) && gdakiQ4MonoMs() - t0 < 50.0)
+    std::this_thread::sleep_for(std::chrono::microseconds(20));
+  struct gdakiCtrlProbeReq q;
+  q.op = op;
+  q.gen = gen;
+  q.haveAvoid = k.st.havePsn;
+  q.avoidPsn = k.st.lastPsn;
+  if (in != nullptr) {
+    q.remote = in->qp;
+    q.page = in->page;
+    q.incNonce = gdakiCtrlIncNonce(in->incarnation, c.nonce);
+  }
+  const uint32_t seq = gdakiCtrlProbeAsk(r, peer, q);
+  if (seq == 0) {
+    WARN("GIN/RC: rank %d: the liveness READ QP to rank %d: the watch thread did not take the request (gen %u) "
+         "mono_ms=%.3f", r->ctx->rank, peer, gen, gdakiQ4MonoMs());
+    return;
+  }
+  k.asked++;
+  k.pendSeq = seq;
+  k.pendAct = act;
+  k.pendGen = gen;
+}
+// One model action (GDAKI_CTRL_PA_*) of the link; `in` the datagram it answers.
+static void gdakiCtrlProbeLinkAct(struct gdakiRecHost* r, int peer, struct gdakiCtrlProbeLink& k,
+                                  const struct gdakiCtrlProbeLinkCtx& c, uint32_t act, const struct gdakiCtrlPairBody* in) {
+  switch (act) {
+    case GDAKI_CTRL_PA_SEND_PAIR:
+      gdakiCtrlProbeLinkAsk(r, peer, k, c, act, GDAKI_CTRL_PO_PREPARE, k.st.mine, nullptr);
+      break;
+    case GDAKI_CTRL_PA_RESEND_PAIR:
+      if (k.pendSeq == 0) gdakiCtrlProbeLinkSend(r, peer, k, c, GDAKI_CTRL_PAIR_STEP_PAIR, k.st.mine);
+      break;
+    case GDAKI_CTRL_PA_TAKE:
+    case GDAKI_CTRL_PA_CONNECT:
+      if (in != nullptr) gdakiCtrlProbeLinkAsk(r, peer, k, c, act, GDAKI_CTRL_PO_CONNECT, k.st.cur, in);
+      break;
+    case GDAKI_CTRL_PA_RESEND_ACK:
+      if (k.pendSeq == 0 && c.send(c.ctx, peer, k.st.ack) != 0) k.refused++;
+      break;
+    case GDAKI_CTRL_PA_RESEND_DONE:
+      if (k.pendSeq == 0) gdakiCtrlProbeLinkSend(r, peer, k, c, GDAKI_CTRL_PAIR_STEP_DONE, k.st.cur);
+      break;
+    case GDAKI_CTRL_PA_UP:
+      GIN_TS_NOTE("GIN/RC: rank %d: liveness READ QP to rank %d %s (gen %u) via %s (the answering side) mono_ms=%.3f",
+                  r->ctx->rank, peer, k.st.cur > 1 ? "re-paired" : "paired", k.st.cur, c.via, gdakiQ4MonoMs());
+      break;
+    case GDAKI_CTRL_PA_GIVE_UP:
+      INFO(NCCL_NET, "GIN/RC: the liveness READ QP pairing with rank %d gave up at its bound (gen %u) mono_ms=%.3f", peer,
+           k.st.lastMine, gdakiQ4MonoMs());
+      break;
+    default: break;
+  }
+}
+// A pairing body of the peer (either transport): the lineage's verdict on its sender first (REVIEW_P12 막는 문제 7).
+static void gdakiCtrlProbeLinkOnBody(struct gdakiRecHost* r, int from, struct gdakiCtrlProbeLink& k,
+                                     const struct gdakiCtrlProbeLinkCtx& c, const struct gdakiCtrlPairBody& b) {
+  const uint32_t cls = gdakiLnClassify(gdakiLnOf(r, from), b.incarnation);
+  const bool lnOk = cls == GDAKI_LN_CURRENT;
+  uint32_t a = GDAKI_CTRL_PA_NONE;
+  if (b.step == GDAKI_CTRL_PAIR_STEP_PAIR) a = gdakiCtrlPairOnPair(&k.st, b.gen, b.incarnation, lnOk, &b.qp, gdakiQ4MonoMs());
+  else if (b.step == GDAKI_CTRL_PAIR_STEP_ACK) a = gdakiCtrlPairOnAck(&k.st, b.gen, b.incarnation, lnOk);
+  else a = gdakiCtrlPairOnDone(&k.st, b.gen, b.incarnation, lnOk);
+  if (k.st.lnLog)
+    WARN(GDAKI_LN_HEAD "rank %d: a liveness READ QP pairing (step %u, gen %u) of rank %d's incarnation %u is dropped: "
+         "the lineage classifies it %s (%s) mono_ms=%.3f", r->ctx->rank, b.step, b.gen, from, b.incarnation,
+         gdakiLnClassName(cls), c.via, gdakiQ4MonoMs());
+  gdakiCtrlProbeLinkAct(r, from, k, c, a, &b);
+}
+// The clock: the model's resends and bounds, the watch thread's answers, its "this QP broke" words (a re-pairing per
+// 2a-1's model: the side that saw the ERR starts PAIR(gen + 1)), PROBE_FAIL_N.
+static void gdakiCtrlProbeLinkTick(struct gdakiRecHost* r, int peer, struct gdakiCtrlProbeLink& k,
+                                   const struct gdakiCtrlProbeLinkCtx& c, int failN) {
+  (void)gdakiCtrlProbeLinkPoll(r, peer, k, c);
+  const uint32_t g1 = gdakiCtrlProbeErrTake(r, peer);
+  if (g1 != 0 && !k.stopped) {
+    const uint32_t gen = g1 - 1u;
+    struct gdakiCtrlPage* pg = gdakiPageOf(r);
+    const uint32_t okGen = pg != nullptr ? pg->peers[(size_t)peer].okGen.load(std::memory_order_acquire) : 0u;
+    if (okGen == gen && k.failsGen != gen) k.fails = 0;  // that generation had a success: not a break in a row
+    k.failsGen = gen;
+    if (++k.fails > (uint32_t)failN) {
+      k.stopped = true;
+      WARN("GIN/RC: rank %d: the liveness READ QP to rank %d broke %u times in a row: no more re-pairing (table row 12 "
+           "or 16; phase 1 reports it) mono_ms=%.3f", r->ctx->rank, peer, k.fails, gdakiQ4MonoMs());
+    } else {
+      GIN_TS_NOTE("GIN/RC: rank %d: PAIR(liveness READ, gen %u) to rank %d (local ERR) mono_ms=%.3f", r->ctx->rank,
+                  gen + 1u, peer, gdakiQ4MonoMs());
+      gdakiCtrlProbeLinkAct(r, peer, k, c,
+                            gdakiCtrlPairOnQpErr(&k.st, gen, gdakiQ4MonoMs(), (double)ncclParamGinTsReconnectMs()), nullptr);
+    }
+  }
+  gdakiCtrlProbeLinkAct(r, peer, k, c, gdakiCtrlPairTick(&k.st, gdakiQ4MonoMs()), nullptr);
+}
+
+// ---- record 55 PROBE_SETUP (phase 1's scaffold; phase 2a-2-A: the UD pairing carries the endpoint) ----
+// An incoming 55 (a peer of an older build, or a stale one in flight): taken and dropped, one line per sender.
+static void gdakiCtrlProbeSetupRecv(struct gdakiRecHost* r, int from, const struct gdakiTsMsg& m) {
+  (void)m;
+  static std::mutex mu;
+  static std::vector<std::pair<const void*, int>> said;
+  std::lock_guard<std::mutex> lk(mu);
+  for (const auto& e : said)
+    if (e.first == (const void*)r && e.second == from) return;
+  said.emplace_back((const void*)r, from);
+  INFO(NCCL_NET, "GIN/RC: rank %d: record 55 PROBE_SETUP from rank %d dropped (the liveness READ QP pairs over UD)",
+       (r != nullptr && r->ctx != nullptr) ? r->ctx->rank : -1, from);
+}
