+// (max_rd_atomic GDAKI_CTRL_LA_RD_ATOMIC; the template's max_dest_rd_atomic is the same 1, which the launcher's one READ
+// at a time of the blob slot and the outbox needs).
+#define GDAKI_CTRL_LA_RD_ATOMIC 1
+static inline bool gdakiCtrlLaReadFree(bool beatOut, bool creditOut) { return !beatOut && !creditOut; }
+struct gdakiCtrlLaIn {
+  int li = -1;
+  bool ud = false;
+  struct gdakiCtrlEnv env;
+  uint8_t body[GDAKI_CTRL_LAUNCHER_BYTES];
+};
+struct gdakiCtrlRing {
