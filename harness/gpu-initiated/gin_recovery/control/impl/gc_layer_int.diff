+  struct gdakiCtrlCq* cq = nullptr;           // the helper's CQ and completion channel
+  struct gdakiMiHostQp* ud = nullptr;         // the context's UD QP (the helper's CQ)
+  struct gdakiCtrlEndpoint udLocal;
+  uint8_t *rxMem = nullptr, *txMem = nullptr, *udRx = nullptr, *udTx = nullptr, *outbox = nullptr, *inStage = nullptr;
+  uint64_t* creditRd = nullptr;               // per peer: the READ target of its consumed word
+  uint64_t* rxConsumedOwn = nullptr;          // per peer: this side's consumed words until phase 1's page is bound
+  uint64_t* rxConsumed = nullptr;             // where they are published (the page's rxConsumed[N], or rxConsumedOwn)
+  struct ibv_mr *rxMr = nullptr, *txMr = nullptr, *udRxMr = nullptr, *udTxMr = nullptr, *outboxMr = nullptr,
+                *inStageMr = nullptr, *creditRdMr = nullptr;
+  uint64_t udTxBusy = 0;                      // a bit per UD send buffer (64)
+  int inStageBy = -1;                         // the peer whose outbox READ uses inStage (one at a time)
+  std::vector<struct gdakiCtrlRdmaPeer> peers;  // by rank (peers[me] unused)
+  std::deque<struct gdakiCtrlUdIn> udIn;        // at most GDAKI_CTRL_UDIN_PER_PEER per rank (REVIEW_P12 고칠 것 13)
+  std::deque<struct gdakiCtrlRdmaAct> acts;     // the pairing actions of the last CQ batch
+  struct gdakiCtrlRingOps ops;
+  uint64_t cqEvents = 0, cqEventsUnacked = 0, badDgrams = 0, udRecvErrs = 0, udRemade = 0, udInDropped = 0;
+  bool udBroken = false;                        // a UD RECV ended in error: the UD QP is made again after the batch
+  bool inPoll = false;                          // the full poll runs (a nested call only collects)
+  // phase 2a-2 (the setup and the first pairing; impl/notes_p2a2.md)
+  uint32_t qkey = 0;                            // this side's UD Q_Key: its own, chosen before the exchange (the
+                                                // context's nonce comes after it); a remade UD QP keeps it
+  struct gdakiCtrlSetupOut setup;               // the setup agreement's outcome (Resume's 42-44)
+  bool bound = false;                           // rxConsumed[] is the status page's rxConsumed[N] (before any post)
+  bool pairingStarted = false;                  // the setup's first pairings were started (the helper's step)
+  bool live = false;                            // the swap points use the ring (phase 2a-2-B sets it; until then the
+                                                // records stay on the helper socket and the ring only pairs)
+  bool spareRejoined = false;                   // phase 2a-2-C: a spare's REJOINs over UD were all taken (its ring may
+                                                // go live: gdakiCtrlRingLiveStep)
+  // phase 2a-2-B
+  struct gdakiCtrlRingSw sw;                    // the test switches
+  std::deque<struct gdakiCtrlHeldWc> held;      // RECV completions held by CREDIT_STALL (fed in order after it)
+  double originMs = -1;                         // the switches' origin
+  size_t sendqMax = 0;                          // the longest send queue seen (any pair)
+  // the integration int2: the launchers' record QPs (gdakiCtrlRingLaunchers sets them after the all-gather)
+  std::vector<struct gdakiCtrlRdmaLa> la;
+  std::deque<struct gdakiCtrlLaIn> laIn;
+  uint8_t *laRx = nullptr, *laTx = nullptr, *laBlob = nullptr;
+  uint64_t* laBeat = nullptr;                   // per launcher (GDAKI_CTRL_LAP_PULL_BYTES apart): the READ target of its
+                                                // page's head and registration slots (2a-2-C step 4: the pull; 16 B
+                                                // magicVer, beat when the page is shorter)
+  struct ibv_mr *laRxMr = nullptr, *laTxMr = nullptr, *laBlobMr = nullptr, *laBeatMr = nullptr;
+  uint64_t laInDropped = 0;
+  // One writer per word (REVIEW_P12 nit 12): the helper writes rxConsumed[] here, the watch thread every other word of
+  // the status page.
+};
+#define GDAKI_CTRL_UDIN_PER_PEER 64u
+// The test switches QP_ERR=<ms>:<peer>, CREDIT_STALL=<start ms>:<length ms>, DROP_UD=rejoin:<n> (rs_ctrl_api.h [2]),
+// 2a-2-C: DIE_RST=<ms>, RST_GAP=<start ms>:<length ms>, FD_HOLDER=sock|uverbs (the witness socket's); research builds
+// only: the production build parses nothing and every switch stays off. A malformed value: one WARN, off.
+static struct gdakiCtrlRingSw* gdakiCtrlRingSwOf(struct gdakiCtrlRing* g) {
+  struct gdakiCtrlRingSw* s = &g->sw;
+  if (s->parsed) return s;
+  s->parsed = true;
+#ifndef NCCL_GIN_TS_PRODUCTION
+  const char* v = getenv(GDAKI_CTRL_T_QP_ERR);
+  if (v != nullptr && *v) {
+    double ms = 0;
+    int peer = -1, n = 0;
+    if (sscanf(v, "%lf:%d%n", &ms, &peer, &n) == 2 && v[n] == 0 && ms >= 0 && peer >= 0 && peer < g->nranks && peer != g->me) {
+      s->qpErrAfterMs = ms;
+      s->qpErrPeer = peer;
+    } else {
+      WARN("GIN/RC: rank %d: test switch QP_ERR=%s is not <ms>:<peer> (another rank): off", g->me, v);
+    }
+  }
+  v = getenv(GDAKI_CTRL_T_CREDIT_STALL);
+  if (v != nullptr && *v) {
+    double a = 0, l = 0;
+    int n = 0;
+    if (sscanf(v, "%lf:%lf%n", &a, &l, &n) == 2 && v[n] == 0 && a >= 0 && l > 0) {
+      s->stallAfterMs = a;
+      s->stallLenMs = l;
+    } else {
+      WARN("GIN/RC: rank %d: test switch CREDIT_STALL=%s is not <start ms>:<length ms>: off", g->me, v);
+    }
+  }
+  v = getenv(GDAKI_CTRL_T_DROP_UD);
+  if (v != nullptr && *v) {
+    unsigned k = 0;
+    int n = 0;
+    if (sscanf(v, "rejoin:%u%n", &k, &n) == 1 && v[n] == 0) s->dropUdLeft = k;
+    else WARN("GIN/RC: rank %d: test switch DROP_UD=%s is not rejoin:<n>: off", g->me, v);
+  }
+  v = getenv(GDAKI_CTRL_T_DIE_RST);
+  if (v != nullptr && *v) {
+    double ms = 0;
+    int n = 0;
+    if (sscanf(v, "%lf%n", &ms, &n) == 1 && v[n] == 0 && ms >= 0) s->dieRstAfterMs = ms;
+    else WARN("GIN/TS: rank %d: test switch DIE_RST=%s is not <ms>: off", g->me, v);
+  }
+  v = getenv(GDAKI_CTRL_T_RST_GAP);
+  if (v != nullptr && *v) {
+    double a = 0, l = 0;
+    int n = 0;
+    if (sscanf(v, "%lf:%lf%n", &a, &l, &n) == 2 && v[n] == 0 && a >= 0 && l > 0) {
+      s->rstGapAfterMs = a;
+      s->rstGapLenMs = l;
+    } else {
+      WARN("GIN/TS: rank %d: test switch RST_GAP=%s is not <start ms>:<length ms>: off", g->me, v);
+    }
+  }
+  v = getenv(GDAKI_CTRL_T_FD_HOLDER);
+  if (v != nullptr && *v) {
+    if (strcmp(v, "sock") == 0) s->fdHold = 1;
+    else if (strcmp(v, "uverbs") == 0) s->fdHold = 2;
+    else WARN("GIN/TS: rank %d: test switch FD_HOLDER=%s is not sock|uverbs: off", g->me, v);
+  }
+#endif
+  return s;
+}
+// CREDIT_STALL lasts now: the RECV completions wait (no RECV is posted again, so no credit goes back).
+static bool gdakiCtrlStallNow(const struct gdakiCtrlRing* g) {
+  if (g->sw.stallFromMs < 0) return false;
+  const double now = gdakiQ4MonoMs();
+  return now >= g->sw.stallFromMs && now < g->sw.stallToMs;
+}
+static size_t gdakiCtrlRingSlotOff(int peer, uint32_t slot) {
+  return ((size_t)peer * GDAKI_CTRL_RING_SLOTS + slot) * GDAKI_CTRL_SLOT_BYTES;
+}
+// ---- the model's posts ----
+static int gdakiCtrlRdmaPostSend(void* ctx, int peer, uint32_t gen, uint32_t sslot, const uint8_t* frame, uint32_t bytes) {
+  struct gdakiCtrlRing* g = (struct gdakiCtrlRing*)ctx;
+  struct gdakiCtrlRdmaPeer& pr = g->peers[(size_t)peer];
+  if (pr.q == nullptr || pr.q->qp == nullptr || bytes > GDAKI_CTRL_SLOT_BYTES) return -1;
+  uint8_t* buf = g->txMem + gdakiCtrlRingSlotOff(peer, sslot);
+  memcpy(buf, frame, bytes);
+  struct ibv_sge sg;
+  sg.addr = (uint64_t)(uintptr_t)buf;
+  sg.length = bytes;
+  sg.lkey = g->txMr->lkey;
+  struct ibv_send_wr wr, *bad = nullptr;
+  memset(&wr, 0, sizeof(wr));
+  wr.wr_id = gdakiCtrlWrId(GDAKI_CTRL_WR_SEND, (uint32_t)peer, gen, sslot);
+  wr.sg_list = &sg;
+  wr.num_sge = 1;
+  wr.opcode = IBV_WR_SEND;
+  wr.send_flags = IBV_SEND_SIGNALED;
+  return wrap_ibv_post_send(pr.q->qp, &wr, &bad) == ncclSuccess ? 0 : -1;
+}
+static int gdakiCtrlRdmaPostRecv(void* ctx, int peer, uint32_t gen, uint32_t slot) {
+  struct gdakiCtrlRing* g = (struct gdakiCtrlRing*)ctx;
+  struct gdakiCtrlRdmaPeer& pr = g->peers[(size_t)peer];
+  if (pr.q == nullptr || pr.q->qp == nullptr) return -1;
+  struct ibv_sge sg;
+  sg.addr = (uint64_t)(uintptr_t)(g->rxMem + gdakiCtrlRingSlotOff(peer, slot));
+  sg.length = GDAKI_CTRL_SLOT_BYTES;
+  sg.lkey = g->rxMr->lkey;
+  struct ibv_recv_wr wr, *bad = nullptr;
+  memset(&wr, 0, sizeof(wr));
+  wr.wr_id = gdakiCtrlWrId(GDAKI_CTRL_WR_RECV, (uint32_t)peer, gen, slot);
+  wr.sg_list = &sg;
+  wr.num_sge = 1;
+  return wrap_ibv_post_recv(pr.q->qp, &wr, &bad) == ncclSuccess ? 0 : -1;
+}
+// The window is shut: READ the peer's consumed word for this rank (its page's rxConsumed[me], 8 B) over the record QP.
+static int gdakiCtrlRdmaReadCredit(void* ctx, int peer, uint32_t gen) {
+  struct gdakiCtrlRing* g = (struct gdakiCtrlRing*)ctx;
+  struct gdakiCtrlRdmaPeer& pr = g->peers[(size_t)peer];
+  if (pr.q == nullptr || pr.q->qp == nullptr || pr.remotePage.rkey == 0 || pr.remotePage.addr == 0 || pr.creditOff)
+    return -1;
+  const uint32_t off = g->layout.rxConsumedOff + 8u * (uint32_t)g->me;
+  if (off + 8u > pr.remotePage.len) return -1;
+  struct ibv_sge sg;
+  sg.addr = (uint64_t)(uintptr_t)&g->creditRd[peer];
+  sg.length = 8;
+  sg.lkey = g->creditRdMr->lkey;
+  struct ibv_send_wr wr, *bad = nullptr;
+  memset(&wr, 0, sizeof(wr));
+  wr.wr_id = gdakiCtrlWrId(GDAKI_CTRL_WR_READ_CREDIT, (uint32_t)peer, gen, 0);
+  wr.sg_list = &sg;
+  wr.num_sge = 1;
+  wr.opcode = IBV_WR_RDMA_READ;
+  wr.send_flags = IBV_SEND_SIGNALED;
+  wr.wr.rdma.remote_addr = pr.remotePage.addr + off;
+  wr.wr.rdma.rkey = pr.remotePage.rkey;
+  return wrap_ibv_post_send(pr.q->qp, &wr, &bad) == ncclSuccess ? 0 : -1;
+}
+static int gdakiCtrlRdmaPostUdRecv(struct gdakiCtrlRing* g, uint32_t slot) {
+  struct ibv_sge sg;
+  sg.addr = (uint64_t)(uintptr_t)(g->udRx + (size_t)slot * GDAKI_CTRL_UD_SLOT_BYTES);
+  sg.length = GDAKI_CTRL_UD_SLOT_BYTES;
+  sg.lkey = g->udRxMr->lkey;
+  struct ibv_recv_wr wr, *bad = nullptr;
+  memset(&wr, 0, sizeof(wr));
+  wr.wr_id = gdakiCtrlWrId(GDAKI_CTRL_WR_UD_RECV, 0, 0, slot);
+  wr.sg_list = &sg;
+  wr.num_sge = 1;
+  return wrap_ibv_post_recv(g->ud->qp, &wr, &bad) == ncclSuccess ? 0 : -1;
+}
+
+// ---- create and destroy (the lifetime rule of impl/rs_ctrl_api.h: QPs, then the CQ with its channel, then stats) ----
+static void* gdakiCtrlRdmaAlloc(size_t bytes) {
+  void* p = nullptr;
+  if (posix_memalign(&p, 4096, bytes) != 0) return nullptr;
+  memset(p, 0, bytes);
+  return p;
+}
+static void gdakiCtrlRdmaDestroy(struct gdakiCtrlRing* g) {
+  if (g == nullptr) return;
+  const struct gdakiCtrlVerbs* v = gdakiCtrlVerbsOf();
+  bool kept = false;  // the CQ could not be destroyed: the memory stays registered and allocated (a leak with a WARN)
+  for (struct gdakiCtrlRdmaPeer& pr : g->peers) {
+    if (pr.ah != nullptr && v->ok) (void)v->destroyAh(pr.ah);  // the address handles before the UD QP
+    pr.ah = nullptr;
+    gdakiMiHostQpDestroy(pr.q);  // a QP kept by it (a WARN) keeps the CQ busy: its destroy below fails, all is kept
+    pr.q = nullptr;
+  }
+  for (struct gdakiCtrlRdmaLa& la : g->la) {  // int2: the launchers' handles and record QPs, before the UD QP and the CQ
+    if (la.ah != nullptr && v->ok) (void)v->destroyAh(la.ah);
+    la.ah = nullptr;
+    gdakiMiHostQpDestroy(la.q);
+    la.q = nullptr;
+  }
+  gdakiMiHostQpDestroy(g->ud);
+  g->ud = nullptr;
+  if (g->cq != nullptr && g->cqEventsUnacked > 0 && v->ok) v->ackCqEvents(g->cq->cq, (unsigned)g->cqEventsUnacked);
+  if (gdakiCtrlCqDestroy(g->cq)) g->cq = nullptr;
+  else kept = true;
+  if (!kept) {
+    struct ibv_mr* mrs[] = {g->rxMr,  g->txMr,  g->udRxMr,   g->udTxMr,  g->outboxMr, g->inStageMr,
+                            g->creditRdMr, g->laRxMr, g->laTxMr, g->laBlobMr, g->laBeatMr};
+    for (struct ibv_mr* m : mrs)
+      if (m != nullptr) (void)wrap_ibv_dereg_mr(m);
+    free(g->laRx);
+    free(g->laTx);
+    free(g->laBlob);
+    free(g->laBeat);
+    free(g->rxMem);
+    free(g->txMem);
+    free(g->udRx);
+    free(g->udTx);
+    free(g->outbox);
+    free(g->inStage);
+    free(g->creditRd);
+    free(g->rxConsumedOwn);
+    delete g;
+  } else {
+    WARN("GIN/RC: the control ring's CQ could not be destroyed; its memory is kept mono_ms=%.3f", gdakiQ4MonoMs());
+  }
+}
+// The context's ring: the helper's CQ (fits: gdakiCtrlCqFits), the regions and their MRs, the UD QP (RTS, its 64 RECVs
+// posted), a ring model and two pairing models per peer rank. No record QP yet (gdakiCtrlRdmaPrepare makes them).
+static ncclResult_t gdakiCtrlRdmaCreate(struct gdakiRecHost* r, int me, int nranks, int nLaunchers, uint64_t nonce,
+                                        uint32_t inc, struct gdakiCtrlRing** out, char* why, size_t whyLen) {
+  *out = nullptr;
+  struct gdaki_context* gc = r != nullptr ? r->ctx : nullptr;
+  struct ibv_pd* pd = (gc != nullptr && gc->collComm != nullptr) ? gc->collComm->ib.pd : nullptr;
+  if (pd == nullptr || me < 0 || me >= nranks || nranks > (int)GDAKI_CTRL_PAGE_MAX_RANKS) {
+    snprintf(why, whyLen, "no GIN protection domain or ranks out of range (%d of %d)", me, nranks);
+    return ncclInvalidUsage;
+  }
+  if (!gdakiCtrlCqFits((uint32_t)(nranks - 1), (uint32_t)nLaunchers)) {
+    snprintf(why, whyLen, "%d peers and %d launchers overrun the helper's CQ of %u", nranks - 1, nLaunchers,
+             GDAKI_CTRL_HELPER_CQ);
+    return ncclInvalidUsage;
+  }
+  if (!gdakiCtrlVerbsOf()->ok) {
+    snprintf(why, whyLen, "libibverbs' ibv_create_ah, ibv_get_cq_event or ibv_ack_cq_events not found");
+    return ncclSystemError;
+  }
+  struct gdakiCtrlRing* g = new gdakiCtrlRing();
+  g->r = r;
+  g->me = me;
+  g->nranks = nranks;
+  g->nLaunchers = nLaunchers;
+  g->nonce = nonce;
+  g->inc = inc;
+  g->qkey = gdakiCtrlQkeyOf(nonce);
+  auto fail = [&](const char* what, ncclResult_t res) -> ncclResult_t {
+    if (why[0] == 0 || what != nullptr) snprintf(why, whyLen, "%s", what != nullptr ? what : "control ring");
+    gdakiCtrlRdmaDestroy(g);
+    return res;
+  };
+  why[0] = 0;
+  if (!gdakiCtrlPageLayoutOf((uint32_t)nranks, (uint32_t)nLaunchers, &g->layout)) return fail("no page layout", ncclInvalidUsage);
+  if (gdakiCtrlCqCreate(r, (int)GDAKI_CTRL_HELPER_CQ, true, &g->cq, why, whyLen) != ncclSuccess) return fail(nullptr, ncclSystemError);
+  {  // the completion channel's fd never blocks the helper (REVIEW_P12 고칠 것 13): an empty read is EAGAIN
+    const int fd = g->cq->channel->fd;
+    const int fl = fcntl(fd, F_GETFL);
+    if (fl < 0 || fcntl(fd, F_SETFL, fl | O_NONBLOCK) != 0) return fail("cannot make the completion channel non-blocking", ncclSystemError);
+  }
+  const size_t ringBytes = (size_t)nranks * GDAKI_CTRL_RING_SLOTS * GDAKI_CTRL_SLOT_BYTES;
+  g->rxMem = (uint8_t*)gdakiCtrlRdmaAlloc(ringBytes);
+  g->txMem = (uint8_t*)gdakiCtrlRdmaAlloc(ringBytes);
+  g->udRx = (uint8_t*)gdakiCtrlRdmaAlloc((size_t)GDAKI_CTRL_UD_RQ * GDAKI_CTRL_UD_SLOT_BYTES);
+  g->udTx = (uint8_t*)gdakiCtrlRdmaAlloc((size_t)GDAKI_CTRL_UD_SQ * GDAKI_CTRL_SLOT_BYTES);
+  g->outbox = (uint8_t*)gdakiCtrlRdmaAlloc(GDAKI_CTRL_OUTBOX_BYTES);
+  g->inStage = (uint8_t*)gdakiCtrlRdmaAlloc(GDAKI_CTRL_OUTBOX_HALF_BYTES);
+  g->creditRd = (uint64_t*)gdakiCtrlRdmaAlloc(4096);
+  g->rxConsumedOwn = (uint64_t*)gdakiCtrlRdmaAlloc(4096);
+  if (!g->rxMem || !g->txMem || !g->udRx || !g->udTx || !g->outbox || !g->inStage || !g->creditRd || !g->rxConsumedOwn)
+    return fail("cannot allocate the control ring's memory", ncclSystemError);
+  g->rxConsumed = g->rxConsumedOwn;
+  // receive slots, send slots, UD buffers and READ targets: LOCAL_WRITE only (no peer writes this memory); the outbox:
+  // REMOTE_READ (the peer, or the launcher, READs a half)
+  g->rxMr = wrap_direct_ibv_reg_mr(pd, g->rxMem, ringBytes, IBV_ACCESS_LOCAL_WRITE);
+  g->txMr = wrap_direct_ibv_reg_mr(pd, g->txMem, ringBytes, IBV_ACCESS_LOCAL_WRITE);
+  g->udRxMr = wrap_direct_ibv_reg_mr(pd, g->udRx, (size_t)GDAKI_CTRL_UD_RQ * GDAKI_CTRL_UD_SLOT_BYTES, IBV_ACCESS_LOCAL_WRITE);
+  g->udTxMr = wrap_direct_ibv_reg_mr(pd, g->udTx, (size_t)GDAKI_CTRL_UD_SQ * GDAKI_CTRL_SLOT_BYTES, IBV_ACCESS_LOCAL_WRITE);
+  g->outboxMr = wrap_direct_ibv_reg_mr(pd, g->outbox, GDAKI_CTRL_OUTBOX_BYTES, IBV_ACCESS_LOCAL_WRITE | IBV_ACCESS_REMOTE_READ);
+  g->inStageMr = wrap_direct_ibv_reg_mr(pd, g->inStage, GDAKI_CTRL_OUTBOX_HALF_BYTES, IBV_ACCESS_LOCAL_WRITE);
+  g->creditRdMr = wrap_direct_ibv_reg_mr(pd, g->creditRd, 4096, IBV_ACCESS_LOCAL_WRITE);
+  if (!g->rxMr || !g->txMr || !g->udRxMr || !g->udTxMr || !g->outboxMr || !g->inStageMr || !g->creditRdMr)
+    return fail("cannot register the control ring's memory", ncclSystemError);
+  struct gdakiMiQpEndpoint v1;
+  const struct gdakiCtrlQpAttr ua = gdakiCtrlQpAttrUd(g->qkey, g->cq->cq);
+  if (gdakiMiHostQpCreate(r, 1, &g->ud, &v1, why, whyLen, ua) != ncclSuccess) return fail(nullptr, ncclSystemError);
+  g->udLocal = gdakiCtrlEndpointOf(v1, GDAKI_CTRL_QPT_UD);
+  g->udLocal.psn = ua.qkey;  // a UD endpoint's psn holds its Q_Key
+  if (gdakiMiHostQpConnect(g->ud, v1, why, whyLen) != ncclSuccess) return fail(nullptr, ncclSystemError);
+  for (uint32_t s = 0; s < GDAKI_CTRL_UD_RQ; s++)
+    if (gdakiCtrlRdmaPostUdRecv(g, s) != 0) return fail("cannot post the UD QP's RECVs", ncclSystemError);
+  g->ops.ctx = g;
+  g->ops.postSend = gdakiCtrlRdmaPostSend;
+  g->ops.postRecv = gdakiCtrlRdmaPostRecv;
+  g->ops.readCredit = gdakiCtrlRdmaReadCredit;
+  g->peers.resize((size_t)nranks);
+  for (int p = 0; p < nranks; p++) {
+    struct gdakiCtrlRdmaPeer& pr = g->peers[(size_t)p];
+    gdakiCtrlRingInit(&pr.ring, p, me, nonce, inc, GDAKI_TS_MAGIC);
+    gdakiCtrlPairInit(&pr.pairRec, GDAKI_CTRL_PAIR_QP_RECORD, me, p);
+    gdakiCtrlPairInit(&pr.prb.st, GDAKI_CTRL_PAIR_QP_PROBE, me, p);
+  }
+  if (g->cq->cq->context->ops.req_notify_cq(g->cq->cq, 0) != 0) return fail("cannot arm the helper's CQ", ncclSystemError);
+  *out = g;
+  return ncclSuccess;
+}
+// The fd the helper's poll() waits on with its witness sockets (the seam gdakiCtrlPollFd of phase 2a-2); -1: none.
+static int gdakiCtrlRdmaChannelFd(const struct gdakiCtrlRing* g) {
+  return (g != nullptr && g->cq != nullptr && g->cq->channel != nullptr) ? g->cq->channel->fd : -1;
+}
+// The seam gdakiCtrlChanGen's generation: the pair's ring generation while the pair's records go on the ring (phase
+// 2a-2-C: its path; false: no ring, or the socket path, the socket's generation stands).
+static bool gdakiCtrlRdmaGenOf(struct gdakiRecHost* r, int peer, uint32_t* gen) {
+  const struct gdakiCtrlRing* g = (r != nullptr && r->ctrl != nullptr) ? r->ctrl->ring : nullptr;
+  if (g == nullptr || peer < 0 || peer >= g->nranks || peer == g->me) return false;
+  if (g->peers[(size_t)peer].path.txPath != GDAKI_CTRL_PM_RING) return false;
+  *gen = g->peers[(size_t)peer].ring.gen;
+  return true;
+}
+// The seam gdakiCtrlChanUp of phase 2a-2: the pair's record channel is up.
+static bool gdakiCtrlRdmaUp(const struct gdakiCtrlRing* g, int peer) {
+  return g != nullptr && peer >= 0 && peer < g->nranks && peer != g->me && gdakiCtrlRingUp(&g->peers[(size_t)peer].ring);
+}
+
+// ---- the record QP of one pair: prepare (INIT, a fresh PSN, the ring's generation, its K RECVs), connect, to ERR ----
+static void gdakiCtrlRdmaPoll(struct gdakiCtrlRing* g, double nowMs);
+static void gdakiCtrlRdmaCollect(struct gdakiCtrlRing* g);
+// A new generation of the pair's record path: the ring's (its inbox kept, its end behind it), the outbox's (an XFER_DONE
+// of the old one never comes; REVIEW_P12 고칠 것 15).
+static void gdakiCtrlRdmaNewGen(struct gdakiCtrlRdmaPeer& pr, uint32_t gen, bool initiator) {
+  gdakiCtrlRingNewGen(&pr.ring, gen, initiator);
+  gdakiCtrlOutboxNewGen(&pr.outbox);
+  pr.xferIn.clear();
+  pr.xferReadOut = pr.xferReadOk = false;
+  pr.xo.on = pr.xi.on = pr.xi.reading = pr.xi.donePend = false;  // their steps fail on the generation (2a-2-C step 3)
+}
+// ERR, then the QP's completions collected while they are still the current generation's (its successful RECVs are RC
+// ACKed records: they reach the inbox in order before the generation's end; REVIEW_P12 막는 문제 8), bounded 200 ms
+// (else the QP is destroyed and a new one made: nothing of the old generation completes then); the new generation;
+// RESET -> INIT; or a new QP. A PSN unlike the last pairing's. Only the CQ is collected inside (no pairing action, no
+// tick: REVIEW_P12 고칠 것 9).
+static ncclResult_t gdakiCtrlRdmaPrepare(struct gdakiCtrlRing* g, int peer, uint32_t gen, bool initiator, char* why,
+                                         size_t whyLen) {
+  struct gdakiCtrlRdmaPeer& pr = g->peers[(size_t)peer];
+  struct ibv_qp_attr a;
+  if (pr.q != nullptr && pr.q->qp != nullptr) {
+    memset(&a, 0, sizeof(a));
+    a.qp_state = IBV_QPS_ERR;
+    (void)wrap_ibv_modify_qp(pr.q->qp, &a, IBV_QP_STATE);
+    const double t0 = gdakiQ4MonoMs();
+    while (gdakiCtrlRingOutstanding(&pr.ring) != 0 && gdakiQ4MonoMs() - t0 < 200.0) {
+      gdakiCtrlRdmaCollect(g);
+      std::this_thread::sleep_for(std::chrono::microseconds(50));
+    }
+    bool reuse = gdakiCtrlRingOutstanding(&pr.ring) == 0;
+    gdakiCtrlRdmaNewGen(pr, gen, initiator);
+    if (reuse) {
+      memset(&a, 0, sizeof(a));
+      a.qp_state = IBV_QPS_RESET;
+      reuse = wrap_ibv_modify_qp(pr.q->qp, &a, IBV_QP_STATE) == ncclSuccess;
+    }
+    if (reuse) {
+      memset(&a, 0, sizeof(a));
+      a.qp_state = IBV_QPS_INIT;
+      a.pkey_index = pr.q->pkeyIndex;
+      a.port_num = pr.q->port;
+      a.qp_access_flags = (int)pr.q->attr.access;
+      reuse = wrap_ibv_modify_qp(pr.q->qp, &a, IBV_QP_STATE | IBV_QP_PKEY_INDEX | IBV_QP_PORT | IBV_QP_ACCESS_FLAGS) ==
+              ncclSuccess;
+    }
+    if (reuse) {
+      do pr.q->psn = gdakiMiHostQpPsn(); while (!gdakiCtrlPairPsnFresh(&pr.pairRec, pr.q->psn));
+      pr.q->err = false;
+      pr.q->outstanding = 0;
+      pr.local.psn = pr.q->psn;
+    } else {
+      gdakiMiHostQpDestroy(pr.q);
+      pr.q = nullptr;
+      gdakiCtrlRingForgetOld(&pr.ring);
+      pr.ring.creditReadOut = false;
+    }
+  } else {
+    gdakiCtrlRdmaNewGen(pr, gen, initiator);
+    gdakiCtrlRingForgetOld(&pr.ring);
+  }
+  if (pr.q == nullptr) {
+    struct gdakiMiQpEndpoint v1;
+    const struct gdakiCtrlQpAttr attr = gdakiCtrlQpAttrRecord((uint8_t)ncclParamIbTimeout(), g->cq->cq);
+    if (gdakiMiHostQpCreate(g->r, 16, &pr.q, &v1, why, whyLen, attr) != ncclSuccess) return ncclSystemError;
+    while (!gdakiCtrlPairPsnFresh(&pr.pairRec, pr.q->psn)) pr.q->psn = gdakiMiHostQpPsn();
+    v1.psn = pr.q->psn;
+    pr.local = gdakiCtrlEndpointOf(v1, GDAKI_CTRL_QPT_RC);
+  }
+  // before RTR, at both ends: the K RECVs of gen (design v3 2.2)
+  if (gdakiCtrlRingPostInitial(&pr.ring, g->ops) != (int)GDAKI_CTRL_RING_SLOTS) {
+    snprintf(why, whyLen, "cannot post the record QP's %u RECVs to rank %d", GDAKI_CTRL_RING_SLOTS, peer);
+    return ncclSystemError;
+  }
+  gdakiCtrlWordStore(&g->rxConsumed[peer], gdakiCtrlRingConsumedWord(&pr.ring));
+  return ncclSuccess;
+}
+// RTR, RTS toward the peer's record QP of gen; the initiator's CONNECTED goes first (gdakiCtrlRingKick).
+static ncclResult_t gdakiCtrlRdmaConnect(struct gdakiCtrlRing* g, int peer, const struct gdakiCtrlEndpoint& remote,
+                                         char* why, size_t whyLen) {
+  struct gdakiCtrlRdmaPeer& pr = g->peers[(size_t)peer];
+  if (pr.q == nullptr || !gdakiCtrlEndpointOk(remote) || remote.qpType != GDAKI_CTRL_QPT_RC) {
+    snprintf(why, whyLen, "no record QP to rank %d or not a well-formed RC endpoint", peer);
+    return ncclInvalidUsage;
+  }
+  if (gdakiMiHostQpConnect(pr.q, gdakiCtrlEndpointV1(remote), why, whyLen) != ncclSuccess) return ncclSystemError;
+  pr.remote = remote;
+  pr.ring.rts = true;
+  (void)gdakiCtrlRingKick(&pr.ring, g->ops, gdakiQ4MonoMs());
+  return ncclSuccess;
+}
+// The record QP toward `peer` into ERR (the hold start's step 1, the test switch QP_ERR): the ring's connection of this
+// generation is lost; the flushes come back as gen's errors (the pairing's re-pairing is the caller's: gdakiCtrlPairOnQpErr).
+static void gdakiCtrlRdmaRecordToErr(struct gdakiCtrlRing* g, int peer) {
+  if (g == nullptr || peer < 0 || peer >= g->nranks) return;
+  struct gdakiCtrlRdmaPeer& pr = g->peers[(size_t)peer];
+  if (pr.q == nullptr || pr.q->qp == nullptr) return;
+  struct ibv_qp_attr a;
+  memset(&a, 0, sizeof(a));
+  a.qp_state = IBV_QPS_ERR;
+  if (wrap_ibv_modify_qp(pr.q->qp, &a, IBV_QP_STATE) != ncclSuccess)
+    WARN("GIN/RC: the record QP to rank %d could not be moved to ERR mono_ms=%.3f", peer, gdakiQ4MonoMs());
+  gdakiCtrlRingLose(&pr.ring, "TOERR");
+}
+
+// ---- UD: the address handle and the datagrams ----
+static ncclResult_t gdakiCtrlRdmaUdAh(struct gdakiCtrlRing* g, struct gdakiCtrlRdmaPeer& pr, char* why, size_t whyLen) {
+  if (pr.ah != nullptr) return ncclSuccess;
+  if (!pr.haveUd) {
+    snprintf(why, whyLen, "no UD endpoint of the peer");
+    return ncclInvalidUsage;
+  }
+  struct ibv_ah_attr aa;
+  memset(&aa, 0, sizeof(aa));
+  aa.port_num = g->ud->port;
+  if (g->ud->roce) {
+    aa.is_global = 1;
+    memcpy(aa.grh.dgid.raw, pr.remoteUd.gid, sizeof(pr.remoteUd.gid));
+    aa.grh.sgid_index = (uint8_t)g->ud->gidIndex;  // the GIN QPs' GID index and traffic class (design v3 2.5)
+    aa.grh.hop_limit = DEFAULT_HOP_LIMIT;
+    aa.grh.traffic_class = (uint8_t)g->ud->tc;
+  } else {
+    aa.dlid = (uint16_t)pr.remoteUd.lid;
+    aa.sl = (uint8_t)g->ud->sl;
+  }
+  struct gdaki_context* gc = g->r->ctx;
+  pr.ah = gdakiCtrlVerbsOf()->createAh(gc->collComm->ib.pd, &aa);
+  if (pr.ah == nullptr) {
+    snprintf(why, whyLen, "cannot create the address handle of the peer's UD QP");
+    return ncclSystemError;
+  }
+  return ncclSuccess;
+}
+// The peer's UD endpoint (the setup's all-gather, its PAIR, or the REJOIN's nrp): a changed one gets a new handle.
+static void gdakiCtrlRdmaSetUd(struct gdakiCtrlRing* g, int peer, const struct gdakiCtrlEndpoint& ud) {
+  struct gdakiCtrlRdmaPeer& pr = g->peers[(size_t)peer];
+  if (pr.haveUd && memcmp(&pr.remoteUd, &ud, sizeof(ud)) == 0) return;
+  if (pr.ah != nullptr) (void)gdakiCtrlVerbsOf()->destroyAh(pr.ah);
+  pr.ah = nullptr;
+  pr.remoteUd = ud;
+  pr.haveUd = true;
+}
+// One datagram: the envelope (kind, gen, no seq) and a body to `peer`'s UD QP; 0 posted.
+static int gdakiCtrlRdmaUdSend(struct gdakiCtrlRing* g, int peer, uint16_t kind, uint32_t gen, const void* body,
+                               uint32_t bytes) {
+  char why[128] = {0};
+  struct gdakiCtrlRdmaPeer& pr = g->peers[(size_t)peer];
+  uint32_t type = 0;  // DROP_UD (phase 2a-2-B): the first <n> REJOIN datagrams are dropped here, as if the network lost them
+  if (kind == GDAKI_CTRL_K_RECORD && bytes >= 8) memcpy(&type, (const uint8_t*)body + 4, 4);
+  if (type == GDAKI_TS_RS_REJOIN && gdakiCtrlRingSwOf(g)->dropUdLeft > 0) {
+    g->sw.dropUdLeft--;
+    GIN_TS_NOTE("GIN/RC: rank %d: test switch DROP_UD: the REJOIN datagram to rank %d dropped mono_ms=%.3f", g->me, peer,
+                gdakiQ4MonoMs());
+    return 0;
+  }
+  if (bytes > GDAKI_CTRL_RECORD_BYTES || gdakiCtrlRdmaUdAh(g, pr, why, sizeof(why)) != ncclSuccess) return -1;
+  uint32_t s = 0;
+  while (s < GDAKI_CTRL_UD_SQ && (g->udTxBusy & (1ull << s)) != 0) s++;
+  if (s >= GDAKI_CTRL_UD_SQ) return -1;  // 64 datagrams in flight: the caller's resend covers it
+  uint8_t* buf = g->udTx + (size_t)s * GDAKI_CTRL_SLOT_BYTES;
+  const uint32_t n = gdakiCtrlFrame(buf, kind, g->me, gen, 0, 0, g->nonce, g->inc, body, bytes, GDAKI_TS_MAGIC);
+  struct ibv_sge sg;
+  sg.addr = (uint64_t)(uintptr_t)buf;
+  sg.length = n;
+  sg.lkey = g->udTxMr->lkey;
+  struct ibv_send_wr wr, *bad = nullptr;
+  memset(&wr, 0, sizeof(wr));
+  wr.wr_id = gdakiCtrlWrId(GDAKI_CTRL_WR_UD_SEND, (uint32_t)peer, gen, s);
+  wr.sg_list = &sg;
+  wr.num_sge = 1;
+  wr.opcode = IBV_WR_SEND;
+  wr.send_flags = IBV_SEND_SIGNALED;
+  wr.wr.ud.ah = pr.ah;
+  wr.wr.ud.remote_qpn = pr.remoteUd.qpn;
+  wr.wr.ud.remote_qkey = pr.remoteUd.psn;
+  if (wrap_ibv_post_send(g->ud->qp, &wr, &bad) != ncclSuccess) return -1;
+  g->udTxBusy |= 1ull << s;
+  return 0;
+}
+
+// ---- the pairing's actions (the model's GDAKI_CTRL_PA_*) ----
+// This side's page (phase 1's status page, once it is up: its address, rkey and used bytes) and outbox.
+static struct gdakiCtrlRegion gdakiCtrlRdmaOutboxRegion(const struct gdakiCtrlRing* g) {
+  struct gdakiCtrlRegion o;
+  o.addr = (uint64_t)(uintptr_t)g->outbox;
+  o.rkey = g->outboxMr->rkey;
+  o.len = GDAKI_CTRL_OUTBOX_BYTES;
+  return o;
+}
+static struct gdakiCtrlRegion gdakiCtrlRdmaPageRegion(const struct gdakiCtrlRing* g) {
+  struct gdakiCtrlRegion p;
+  memset(&p, 0, sizeof(p));
+  const struct gdakiCtrlPage* pg = gdakiPageOf(g->r);
+  if (gdakiPageUp(pg)) {  // phase 2a-2 also binds the ring's rxConsumed[] to the page before the record path goes
+    p.addr = (uint64_t)(uintptr_t)pg->page;
+    p.rkey = pg->pageMr->rkey;
+    p.len = pg->layout.bytes;
+  }
+  return p;
+}
+// The liveness READ QP's link over UD (the link's transport; the QP moves through the watch thread only).
+static int gdakiCtrlRdmaProbeSend(void* ctx, int peer, const struct gdakiCtrlPairBody& b) {
+  return gdakiCtrlRdmaUdSend((struct gdakiCtrlRing*)ctx, peer, GDAKI_CTRL_K_PAIR, b.gen, &b, (uint32_t)sizeof(b));
+}
+static struct gdakiCtrlProbeLinkCtx gdakiCtrlRdmaProbeCtx(struct gdakiCtrlRing* g) {
+  struct gdakiCtrlProbeLinkCtx c;
+  c.ctx = g;
+  c.send = gdakiCtrlRdmaProbeSend;
+  c.ud = g->udLocal;
+  c.page = gdakiCtrlRdmaPageRegion(g);
+  c.outbox = gdakiCtrlRdmaOutboxRegion(g);
+  c.nonce = g->nonce;
+  c.inc = g->inc;
+  c.via = "UD";
+  return c;
+}
+// One action of the record QP's pairing (`in`: the datagram it answers).
+static void gdakiCtrlRdmaPairAct(struct gdakiCtrlRing* g, int peer, uint32_t act, const struct gdakiCtrlPairBody* in) {
+  struct gdakiCtrlRdmaPeer& pr = g->peers[(size_t)peer];
+  struct gdakiCtrlPairSt& st = pr.pairRec;
+  char why[160] = {0};
+  auto body = [&](uint32_t step, uint32_t gen) {
+    return gdakiCtrlPairBodyOf(&st, step, gen, g->inc, g->nonce, pr.local, g->udLocal, gdakiCtrlRdmaPageRegion(g),
+                               gdakiCtrlRdmaOutboxRegion(g));
+  };
+  auto learn = [&](const struct gdakiCtrlPairBody& b) {  // the peer's UD endpoint and regions (a stale rkey mended)
+    gdakiCtrlRdmaSetUd(g, peer, b.ud);
+    pr.remotePage = b.page;
+    pr.remoteOutbox = b.outbox;
+    pr.creditOff = false;  // a fresh page region: the consumed word's READ may go again
+  };
+  ncclResult_t res = ncclSuccess;
+  switch (act) {
+    case GDAKI_CTRL_PA_SEND_PAIR:
+      res = gdakiCtrlRdmaPrepare(g, peer, st.mine, true, why, sizeof(why));
+      if (res == ncclSuccess) {
+        const struct gdakiCtrlPairBody b = body(GDAKI_CTRL_PAIR_STEP_PAIR, st.mine);
+        (void)gdakiCtrlRdmaUdSend(g, peer, GDAKI_CTRL_K_PAIR, st.mine, &b, (uint32_t)sizeof(b));
+      }
+      break;
+    case GDAKI_CTRL_PA_RESEND_PAIR: {
+      const struct gdakiCtrlPairBody b = body(GDAKI_CTRL_PAIR_STEP_PAIR, st.mine);
+      (void)gdakiCtrlRdmaUdSend(g, peer, GDAKI_CTRL_K_PAIR, st.mine, &b, (uint32_t)sizeof(b));
+      break;
+    }
+    case GDAKI_CTRL_PA_TAKE:
+      if (in == nullptr) break;
+      learn(*in);
+      if (st.reusedMine) pr.ring.initiator = false;  // this side's QP of that generation, its RECVs posted: it answers
+      else res = gdakiCtrlRdmaPrepare(g, peer, st.cur, false, why, sizeof(why));
+      if (res == ncclSuccess) res = gdakiCtrlRdmaConnect(g, peer, in->qp, why, sizeof(why));
+      if (res == ncclSuccess) {
+        gdakiCtrlPairStoreAck(&st, body(GDAKI_CTRL_PAIR_STEP_ACK, st.cur));
+        (void)gdakiCtrlRdmaUdSend(g, peer, GDAKI_CTRL_K_PAIR, st.cur, &st.ack, (uint32_t)sizeof(st.ack));
+      }
+      break;
+    case GDAKI_CTRL_PA_RESEND_ACK:
+      (void)gdakiCtrlRdmaUdSend(g, peer, GDAKI_CTRL_K_PAIR, st.cur, &st.ack, (uint32_t)sizeof(st.ack));
+      break;
+    case GDAKI_CTRL_PA_CONNECT:
+      if (in == nullptr) break;
+      learn(*in);
+      res = gdakiCtrlRdmaConnect(g, peer, in->qp, why, sizeof(why));  // CONNECTED goes first
+      break;
+    case GDAKI_CTRL_PA_GIVE_UP:
+      INFO(NCCL_NET, "GIN/RC: the record QP pairing with rank %d gave up at its bound (gen %u) mono_ms=%.3f", peer,
+           st.lastMine, gdakiQ4MonoMs());
+      break;
+    default: break;
+  }
+  if (res != ncclSuccess)
+    WARN("GIN/RC: the record QP pairing with rank %d: %s mono_ms=%.3f", peer, why, gdakiQ4MonoMs());
+}
+// The pairing entry points (phase 2a-2 and phase 3 call these): start (the setup's lower rank; an ERR of gen seen).
+// Phase 2a-2 calls them outside the CQ loop (from the helper's step), never inside it.
+static void gdakiCtrlRdmaPairStart(struct gdakiCtrlRing* g, int peer, uint32_t qpKind, double boundMs) {
+  struct gdakiCtrlRdmaPeer& pr = g->peers[(size_t)peer];
+  if (qpKind == GDAKI_CTRL_PAIR_QP_PROBE)
+    gdakiCtrlProbeLinkAct(g->r, peer, pr.prb, gdakiCtrlRdmaProbeCtx(g), gdakiCtrlPairStart(&pr.prb.st, gdakiQ4MonoMs(), boundMs),
+                          nullptr);
+  else
+    gdakiCtrlRdmaPairAct(g, peer, gdakiCtrlPairStart(&pr.pairRec, gdakiQ4MonoMs(), boundMs), nullptr);
+}
+static void gdakiCtrlRdmaPairOnErr(struct gdakiCtrlRing* g, int peer, uint32_t qpKind, uint32_t gen, double boundMs) {
+  struct gdakiCtrlRdmaPeer& pr = g->peers[(size_t)peer];
+  if (qpKind == GDAKI_CTRL_PAIR_QP_PROBE)
+    gdakiCtrlProbeLinkAct(g->r, peer, pr.prb, gdakiCtrlRdmaProbeCtx(g),
+                          gdakiCtrlPairOnQpErr(&pr.prb.st, gen, gdakiQ4MonoMs(), boundMs), nullptr);
+  else
+    gdakiCtrlRdmaPairAct(g, peer, gdakiCtrlPairOnQpErr(&pr.pairRec, gen, gdakiQ4MonoMs(), boundMs), nullptr);
+}
+// An accepted REJOIN of `peer` as incarnation `inc` (phase 2a-2's acceptance calls it): both kinds know the new
+// incarnation, so its PAIRs are taken (REVIEW_P12 막는 문제 7).
+[[maybe_unused]] static void gdakiCtrlRdmaOnRejoinAccepted(struct gdakiCtrlRing* g, int peer, uint32_t inc) {
+  if (g == nullptr || peer < 0 || peer >= g->nranks || peer == g->me) return;
+  gdakiCtrlPairSetPeerInc(&g->peers[(size_t)peer].pairRec, inc);
+  gdakiCtrlPairSetPeerInc(&g->peers[(size_t)peer].prb.st, inc);
+}
+
+// ---- the launchers' record QPs (int2; struct gdakiCtrlRdmaLa above). Helper only, outside the CQ loop's callers' locks:
+// none of these polls the CQ, so the launcher link may call them under its mutex. ----
+// After the all-gather (the setup thread, before the helper): the communicator's launcher count. The ring's page layout
+// takes it (the status page's, gdakiPageSetup: every rank the same count from the same fields, so every page has the
+// same layout and a launcher's creditOff = rxConsumedL[li] never points into staleMs); the launchers' QPs come with it
+// when the helper's CQ fits them (else none: a WARN, the page layout stays). False: no ring.
+static bool gdakiCtrlRingLaunchers(struct gdakiCtrlRing* g, int nLaunchers) {
+  if (g == nullptr || nLaunchers < 0) return false;
+  const uint32_t nL = std::min<uint32_t>((uint32_t)nLaunchers, GDAKI_CTRL_PAGE_MAX_LAUNCHERS);
+  struct gdakiCtrlPageLayout l;
+  if (!gdakiCtrlPageLayoutOf((uint32_t)g->nranks, nL, &l)) return false;
+  g->layout = l;
+  g->nLaunchers = (int)nL;
+  if (nL == 0 || !g->la.empty()) return true;
+  if (!gdakiCtrlCqFits((uint32_t)(g->nranks - 1), nL)) {
+    WARN("GIN/RC: rank %d: %d peers and %u launchers overrun the helper's CQ of %u: no launcher QP (the page keeps their "
+         "words) mono_ms=%.3f", g->me, g->nranks - 1, nL, GDAKI_CTRL_HELPER_CQ, gdakiQ4MonoMs());
+    return true;
+  }
+  struct gdaki_context* gc = g->r != nullptr ? g->r->ctx : nullptr;
+  struct ibv_pd* pd = (gc != nullptr && gc->collComm != nullptr) ? gc->collComm->ib.pd : nullptr;
+  if (pd == nullptr) return true;
+  const size_t rxB = (size_t)nL * GDAKI_CTRL_LA_RQ * GDAKI_CTRL_LA_FRAME_BYTES;
+  const size_t txB = (size_t)nL * GDAKI_CTRL_LA_SQ * GDAKI_CTRL_LA_FRAME_BYTES;
+  g->laRx = (uint8_t*)gdakiCtrlRdmaAlloc(rxB);
+  g->laTx = (uint8_t*)gdakiCtrlRdmaAlloc(txB);
+  g->laBlob = (uint8_t*)gdakiCtrlRdmaAlloc(GDAKI_CTRL_LA_BLOB_BYTES);
+  // 2a-2-C step 4: the pulls; step 5: then one 8 B consumed word per launcher (the credit READ's target)
+  const size_t beatB = std::max<size_t>(4096, (size_t)nL * (GDAKI_CTRL_LAP_PULL_BYTES + 8u));
+  g->laBeat = (uint64_t*)gdakiCtrlRdmaAlloc(beatB);
+  if (g->laRx != nullptr) g->laRxMr = wrap_direct_ibv_reg_mr(pd, g->laRx, rxB, IBV_ACCESS_LOCAL_WRITE);
+  if (g->laTx != nullptr) g->laTxMr = wrap_direct_ibv_reg_mr(pd, g->laTx, txB, IBV_ACCESS_LOCAL_WRITE);
+  if (g->laBlob != nullptr)
+    g->laBlobMr = wrap_direct_ibv_reg_mr(pd, g->laBlob, GDAKI_CTRL_LA_BLOB_BYTES, IBV_ACCESS_LOCAL_WRITE | IBV_ACCESS_REMOTE_READ);
+  if (g->laBeat != nullptr) g->laBeatMr = wrap_direct_ibv_reg_mr(pd, g->laBeat, beatB, IBV_ACCESS_LOCAL_WRITE);
+  if (!g->laRxMr || !g->laTxMr || !g->laBlobMr || !g->laBeatMr) {
+    WARN("GIN/RC: rank %d: the launchers' buffers could not be made: no launcher QP mono_ms=%.3f", g->me, gdakiQ4MonoMs());
+    return true;  // the destroy frees what was made
+  }
+  g->la.resize(nL);
+  return true;
+}
+static int gdakiCtrlRingLaunchersOf(const struct gdakiRecHost* r) {
+  const struct gdakiCtrlRing* g = (r != nullptr && r->ctrl != nullptr) ? r->ctrl->ring : nullptr;
+  return g != nullptr ? g->nLaunchers : 0;
+}
+// The consumed word of launcher li's messages: the page's rxConsumedL[li] once the ring is bound (before it: none is
+// taken; the launcher QPs are made only then).
+static uint64_t* gdakiCtrlRdmaLaWord(struct gdakiCtrlRing* g, int li) {
+  return (g->bound ? g->rxConsumed : g->rxConsumedOwn) + g->nranks + li;
+}
+static uint8_t* gdakiCtrlRdmaLaRxSlot(struct gdakiCtrlRing* g, int li, uint32_t s) {
+  return g->laRx + ((size_t)li * GDAKI_CTRL_LA_RQ + s) * GDAKI_CTRL_LA_FRAME_BYTES;
+}
+static uint8_t* gdakiCtrlRdmaLaTxSlot(struct gdakiCtrlRing* g, int li, uint32_t s) {
+  return g->laTx + ((size_t)li * GDAKI_CTRL_LA_SQ + s) * GDAKI_CTRL_LA_FRAME_BYTES;
+}
+static int gdakiCtrlRdmaLaPostRecv(struct gdakiCtrlRing* g, int li, uint32_t s) {
+  struct gdakiCtrlRdmaLa& la = g->la[(size_t)li];
+  struct ibv_sge sg;
+  sg.addr = (uint64_t)(uintptr_t)gdakiCtrlRdmaLaRxSlot(g, li, s);
+  sg.length = GDAKI_CTRL_LA_FRAME_BYTES;
+  sg.lkey = g->laRxMr->lkey;
+  struct ibv_recv_wr wr, *bad = nullptr;
+  memset(&wr, 0, sizeof(wr));
+  wr.wr_id = gdakiCtrlWrId(GDAKI_CTRL_WR_RECV, GDAKI_CTRL_WR_LA_PEER + (uint32_t)li, la.gen, s);
+  wr.sg_list = &sg;
+  wr.num_sge = 1;
+  return wrap_ibv_post_recv(la.q->qp, &wr, &bad) == ncclSuccess ? 0 : -1;
+}
+static bool gdakiCtrlRdmaLaOk(const struct gdakiCtrlRing* g, int li) {
+  return g != nullptr && li >= 0 && li < (int)g->la.size();
+}
+// The transport table's udSend: one datagram (envelope kind PAIR, `from` this rank, gen and seq 0, the 256 B launcher
+// message) to the launcher's UD QP with its own Q_Key. 0 posted.
+static int gdakiCtrlRdmaLaUd(struct gdakiCtrlRing* g, int li, const struct gdakiCtrlEndpoint& to, uint32_t qkey,
+                             const void* msg) {
+  if (!gdakiCtrlRdmaLaOk(g, li) || g->ud == nullptr) return -1;
+  struct gdakiCtrlRdmaLa& la = g->la[(size_t)li];
+  const struct gdakiCtrlVerbs* v = gdakiCtrlVerbsOf();
+  if (!la.haveUd || memcmp(&la.ud, &to, sizeof(to)) != 0 || la.qkey != qkey) {
+    if (la.ah != nullptr && v->ok) (void)v->destroyAh(la.ah);
+    la.ah = nullptr;
+    la.ud = to;
+    la.qkey = qkey;
+    la.haveUd = true;
+  }
+  if (la.ah == nullptr) {
+    struct ibv_ah_attr aa;
+    memset(&aa, 0, sizeof(aa));
+    aa.port_num = g->ud->port;
+    if (g->ud->roce) {
+      aa.is_global = 1;
+      memcpy(aa.grh.dgid.raw, la.ud.gid, sizeof(la.ud.gid));
+      aa.grh.sgid_index = (uint8_t)g->ud->gidIndex;
+      aa.grh.hop_limit = DEFAULT_HOP_LIMIT;
+      aa.grh.traffic_class = (uint8_t)g->ud->tc;
+    } else {
+      aa.dlid = (uint16_t)la.ud.lid;
+      aa.sl = (uint8_t)g->ud->sl;
+    }
+    la.ah = v->createAh(g->r->ctx->collComm->ib.pd, &aa);
+    if (la.ah == nullptr) return -1;
+  }
+  uint32_t s = 0;
+  while (s < GDAKI_CTRL_UD_SQ && (g->udTxBusy & (1ull << s)) != 0) s++;
+  if (s >= GDAKI_CTRL_UD_SQ) return -1;  // the link's clock resends
+  uint8_t* buf = g->udTx + (size_t)s * GDAKI_CTRL_SLOT_BYTES;
+  const uint32_t n = gdakiCtrlFrame(buf, GDAKI_CTRL_K_PAIR, g->me, 0, 0, 0, g->nonce, g->inc, msg,
+                                    GDAKI_CTRL_LAUNCHER_BYTES, GDAKI_TS_MAGIC);
+  struct ibv_sge sg;
+  sg.addr = (uint64_t)(uintptr_t)buf;
+  sg.length = n;
+  sg.lkey = g->udTxMr->lkey;
+  struct ibv_send_wr wr, *bad = nullptr;
+  memset(&wr, 0, sizeof(wr));
+  wr.wr_id = gdakiCtrlWrId(GDAKI_CTRL_WR_UD_SEND, GDAKI_CTRL_WR_LA_PEER + (uint32_t)li, 0, s);
+  wr.sg_list = &sg;
+  wr.num_sge = 1;
+  wr.opcode = IBV_WR_SEND;
+  wr.send_flags = IBV_SEND_SIGNALED;
+  wr.wr.ud.ah = la.ah;
+  wr.wr.ud.remote_qpn = la.ud.qpn;
+  wr.wr.ud.remote_qkey = qkey;
+  if (wrap_ibv_post_send(g->ud->qp, &wr, &bad) != ncclSuccess) return -1;
+  g->udTxBusy |= 1ull << s;
+  return 0;
+}
+// rcCreate: a new record QP for generation gen (never a reset one: a fresh PSN), its 64 RECVs posted (INIT), the
+// counters of gen at 0, its consumed word (gen << 32). 0 made (*local its endpoint).
+static int gdakiCtrlRdmaLaCreate(struct gdakiCtrlRing* g, int li, uint32_t gen, struct gdakiCtrlEndpoint* local) {
+  if (!gdakiCtrlRdmaLaOk(g, li) || !g->bound) return -1;
+  struct gdakiCtrlRdmaLa& la = g->la[(size_t)li];
+  gdakiMiHostQpDestroy(la.q);  // the old one's completions are not this generation's (their gen differs)
+  la.q = nullptr;
+  la.connected = false;
+  la.err = false;
+  la.errTaken = true;
+  la.gen = gen;
+  la.seqOut = la.ackIn = la.seqIn = 0;
+  la.sBusy = 0;
+  la.pend.clear();
+  la.beatOut = false;
+  la.creditOut = false;  // 2a-2-C step 5: the old QP's credit READ is gone with it
+  la.creditMs = -1e18;
+  char why[160] = {0};
+  struct gdakiMiQpEndpoint v1;
+  const struct gdakiCtrlQpAttr attr = gdakiCtrlQpAttrLauncher((uint8_t)ncclParamIbTimeout(), g->cq->cq);
+  if (gdakiMiHostQpCreate(g->r, GDAKI_CTRL_LA_RD_ATOMIC, &la.q, &v1, why, sizeof(why), attr) != ncclSuccess) {
+    WARN("GIN/RC: rank %d: the record QP to launcher %d could not be made (%s) mono_ms=%.3f", g->me, li, why, gdakiQ4MonoMs());
+    return -1;
+  }
+  for (uint32_t s = 0; s < GDAKI_CTRL_LA_RQ; s++)
+    if (gdakiCtrlRdmaLaPostRecv(g, li, s) != 0) {
+      gdakiMiHostQpDestroy(la.q);
+      la.q = nullptr;
+      return -1;
+    }
+  gdakiCtrlWordStore(gdakiCtrlRdmaLaWord(g, li), (uint64_t)gen << 32);
+  *local = gdakiCtrlEndpointOf(v1, GDAKI_CTRL_QPT_RC);
+  return 0;
+}
+// rcConnect: RTR, RTS toward the launcher's QP (the template's max_dest_rd_atomic lets it READ the blob slot).
+static int gdakiCtrlRdmaLaConnect(struct gdakiCtrlRing* g, int li, const struct gdakiCtrlEndpoint& remote) {
+  if (!gdakiCtrlRdmaLaOk(g, li)) return -1;
+  struct gdakiCtrlRdmaLa& la = g->la[(size_t)li];
+  char why[160] = {0};
+  if (la.q == nullptr || !gdakiCtrlEndpointOk(remote) || remote.qpType != GDAKI_CTRL_QPT_RC ||
+      gdakiMiHostQpConnect(la.q, gdakiCtrlEndpointV1(remote), why, sizeof(why)) != ncclSuccess) {
+    if (why[0]) WARN("GIN/RC: rank %d: the record QP to launcher %d: %s mono_ms=%.3f", g->me, li, why, gdakiQ4MonoMs());
+    return -1;
+  }
+  la.connected = true;
+  return 0;
+}
+// One message now (window, slot and connection checked here): seq = ++seqOut, ackSeq = this side's consumed count.
+static int gdakiCtrlRdmaLaPost(struct gdakiCtrlRing* g, int li, const void* msg) {
+  struct gdakiCtrlRdmaLa& la = g->la[(size_t)li];
+  uint32_t s = 0;
+  while (s < GDAKI_CTRL_LA_SQ && (la.sBusy & (1u << s)) != 0) s++;
+  if (s >= GDAKI_CTRL_LA_SQ) return 1;
+  uint8_t* buf = gdakiCtrlRdmaLaTxSlot(g, li, s);
+  const uint32_t n = gdakiCtrlFrame(buf, GDAKI_CTRL_K_LAUNCHER, g->me, la.gen, la.seqOut + 1, la.seqIn, g->nonce, g->inc, msg,
+                                    GDAKI_CTRL_LAUNCHER_BYTES, GDAKI_TS_MAGIC);
+  struct ibv_sge sg;
+  sg.addr = (uint64_t)(uintptr_t)buf;
+  sg.length = n;
+  sg.lkey = g->laTxMr->lkey;
+  struct ibv_send_wr wr, *bad = nullptr;
+  memset(&wr, 0, sizeof(wr));
+  wr.wr_id = gdakiCtrlWrId(GDAKI_CTRL_WR_SEND, GDAKI_CTRL_WR_LA_PEER + (uint32_t)li, la.gen, s);
+  wr.sg_list = &sg;
+  wr.num_sge = 1;
+  wr.opcode = IBV_WR_SEND;
+  wr.send_flags = IBV_SEND_SIGNALED;
+  if (wrap_ibv_post_send(la.q->qp, &wr, &bad) != ncclSuccess) return -1;
+  la.sBusy |= 1u << s;
+  la.seqOut++;
+  la.tx++;
+  return 0;
+}
+// The queue past the window, in order, while the launcher's window and a send slot allow.
+static void gdakiCtrlRdmaLaFlush(struct gdakiCtrlRing* g, int li) {
+  struct gdakiCtrlRdmaLa& la = g->la[(size_t)li];
+  while (!la.pend.empty() && la.connected && !la.err && la.seqOut - la.ackIn < GDAKI_CTRL_LA_RQ) {
+    const int r = gdakiCtrlRdmaLaPost(g, li, la.pend.front().data());
+    if (r == 1) return;  // no send slot: the next completion flushes
+    if (r < 0) {
+      la.err = true;
+      la.errTaken = false;
+      return;
+    }
+    la.pend.pop_front();
+  }
+}
+// rcSend: 0 sent or queued (past the launcher's window), -1 the QP is gone or in error, or the queue is full.
+static int gdakiCtrlRdmaLaSend(struct gdakiCtrlRing* g, int li, const void* msg) {
+  if (!gdakiCtrlRdmaLaOk(g, li)) return -1;
+  struct gdakiCtrlRdmaLa& la = g->la[(size_t)li];
+  if (la.q == nullptr || !la.connected || la.err) return -1;
+  if (la.pend.empty() && la.seqOut - la.ackIn < GDAKI_CTRL_LA_RQ) {
+    const int r = gdakiCtrlRdmaLaPost(g, li, msg);
+    if (r == 0) return 0;
+    if (r < 0) return -1;
+  }
+  if (la.pend.size() >= GDAKI_CTRL_LA_PEND_MAX) return -1;
+  la.pend.emplace_back((const uint8_t*)msg, (const uint8_t*)msg + GDAKI_CTRL_LAUNCHER_BYTES);
+  la.queued++;
+  return 0;
+}
+// A launcher's datagram or message for the link's step (bounded: the oldest goes).
+static void gdakiCtrlRdmaLaQueue(struct gdakiCtrlRing* g, int li, bool ud, const struct gdakiCtrlEnv& e, const uint8_t* body) {
+  if (g->laIn.size() >= GDAKI_CTRL_LA_IN_MAX) {
+    g->laIn.pop_front();
+    g->laInDropped++;
+  }
+  g->laIn.emplace_back();
+  struct gdakiCtrlLaIn& x = g->laIn.back();
+  x.li = li;
+  x.ud = ud;
+  x.env = e;
+  memcpy(x.body, body, GDAKI_CTRL_LAUNCHER_BYTES);
+}
+// The launcher page's beat: a READ of its first 16 B (magicVer, beat) over the record QP (the launcher's QP takes READs:
+// REMOTE_READ, max_dest_rd_atomic 1), at most every GDAKI_CTRL_LA_BEAT_MS, one in flight, never beside the credit READ
+// (gdakiCtrlLaReadFree; a beat it delays goes at the next step). The helper's, so a stalled
+// helper reads nothing (the link's beat rule counts the stall only across this side's own reads). 2a-2-C step 4: a page
+// of len >= GDAKI_CTRL_LAP_PULL_BYTES is read with its registration slots (the pull: pullOk and the L input's word).
+static uint8_t* gdakiCtrlRdmaLaBeatBuf(struct gdakiCtrlRing* g, int li) {
+  return (uint8_t*)g->laBeat + (size_t)li * GDAKI_CTRL_LAP_PULL_BYTES;
+}
+static void gdakiCtrlRdmaLaBeatAsk(struct gdakiCtrlRing* g, int li, uint64_t addr, uint32_t rkey, double nowMs,
+                                   uint32_t len = 16) {
+  if (!gdakiCtrlRdmaLaOk(g, li)) return;
+  struct gdakiCtrlRdmaLa& la = g->la[(size_t)li];
+  if (la.q == nullptr || !la.connected || la.err || !gdakiCtrlLaReadFree(la.beatOut, la.creditOut) || addr == 0 ||
+      rkey == 0 || nowMs - la.beatPostMs < GDAKI_CTRL_LA_BEAT_MS)
+    return;
+  struct ibv_sge sg;
+  const uint32_t n = len >= GDAKI_CTRL_LAP_PULL_BYTES ? GDAKI_CTRL_LAP_PULL_BYTES : 16u;
+  sg.addr = (uint64_t)(uintptr_t)gdakiCtrlRdmaLaBeatBuf(g, li);
+  sg.length = n;
+  sg.lkey = g->laBeatMr->lkey;
+  struct ibv_send_wr wr, *bad = nullptr;
+  memset(&wr, 0, sizeof(wr));
+  wr.wr_id = gdakiCtrlWrId(GDAKI_CTRL_WR_READ_CREDIT, GDAKI_CTRL_WR_LA_PEER + (uint32_t)li, la.gen, 0);
+  wr.sg_list = &sg;
+  wr.num_sge = 1;
+  wr.opcode = IBV_WR_RDMA_READ;
+  wr.send_flags = IBV_SEND_SIGNALED;
+  wr.wr.rdma.remote_addr = addr;
+  wr.wr.rdma.rkey = rkey;
+  if (wrap_ibv_post_send(la.q->qp, &wr, &bad) != ncclSuccess) return;
+  la.beatOut = true;
+  la.beatPostMs = nowMs;
+  la.beatLen = n;
+}
+// 2a-2-C step 5: the launcher page's consumed word for this rank, READ when the window toward the launcher is shut
+// (gdakiCtrlLaCreditDue; `addr` = the page + the creditOff of its PAIR or PAIR_ACK) on the record QP, wr_id slot 1 (the
+// beat's is 0), never beside the beat READ (F1: gdakiCtrlLaReadFree; it waits for the beat's completion); its value comes
+// back in gdakiCtrlRdmaLaWc, which opens the window and flushes the queue.
+static uint64_t* gdakiCtrlRdmaLaCreditBuf(struct gdakiCtrlRing* g, int li) {
+  return (uint64_t*)((uint8_t*)g->laBeat + g->la.size() * GDAKI_CTRL_LAP_PULL_BYTES + 8u * (size_t)li);
+}
+static void gdakiCtrlRdmaLaCreditAsk(struct gdakiCtrlRing* g, int li, uint64_t addr, uint32_t rkey, double nowMs) {
+  if (!gdakiCtrlRdmaLaOk(g, li)) return;
+  struct gdakiCtrlRdmaLa& la = g->la[(size_t)li];
+  if (la.q == nullptr || !la.connected || la.err || addr == 0 || rkey == 0 ||
+      !gdakiCtrlLaCreditDue(!la.pend.empty(), la.seqOut - la.ackIn >= GDAKI_CTRL_LA_RQ,
+                            !gdakiCtrlLaReadFree(la.beatOut, la.creditOut), la.creditMs, nowMs))
+    return;
+  struct ibv_sge sg;
+  sg.addr = (uint64_t)(uintptr_t)gdakiCtrlRdmaLaCreditBuf(g, li);
+  sg.length = 8;
+  sg.lkey = g->laBeatMr->lkey;
+  struct ibv_send_wr wr, *bad = nullptr;
+  memset(&wr, 0, sizeof(wr));
+  wr.wr_id = gdakiCtrlWrId(GDAKI_CTRL_WR_READ_CREDIT, GDAKI_CTRL_WR_LA_PEER + (uint32_t)li, la.gen, 1);
+  wr.sg_list = &sg;
+  wr.num_sge = 1;
+  wr.opcode = IBV_WR_RDMA_READ;
+  wr.send_flags = IBV_SEND_SIGNALED;
+  wr.wr.rdma.remote_addr = addr;
+  wr.wr.rdma.rkey = rkey;
+  la.creditMs = nowMs;
+  if (wrap_ibv_post_send(la.q->qp, &wr, &bad) != ncclSuccess) return;
+  la.creditOut = true;
+  la.creditReads++;
+}
+// The beat READ's completions since the last call: true with the page's two words when one succeeded (*n: how many
+// completed, any status).
+static bool gdakiCtrlRdmaLaBeatTake(struct gdakiCtrlRing* g, int li, uint64_t* magicVer, uint64_t* beat, uint64_t* n) {
+  if (!gdakiCtrlRdmaLaOk(g, li)) return false;
+  struct gdakiCtrlRdmaLa& la = g->la[(size_t)li];
+  *n = la.beatDone;
+  la.beatDone = 0;
+  if (*n == 0 || !la.beatOk) return false;
+  const uint64_t* w = (const uint64_t*)gdakiCtrlRdmaLaBeatBuf(g, li);
+  *magicVer = __atomic_load_n(&w[0], __ATOMIC_ACQUIRE);
+  *beat = __atomic_load_n(&w[1], __ATOMIC_ACQUIRE);
+  return true;
+}
+// The last successful beat READ's bytes (after gdakiCtrlRdmaLaBeatTake said true, before the next ask): the pull when it
+// read the slots (GDAKI_CTRL_LAP_PULL_BYTES), else 16 (no slots). 0: none.
+static size_t gdakiCtrlRdmaLaPullCopy(struct gdakiCtrlRing* g, int li, uint8_t* out, size_t cap) {
+  if (!gdakiCtrlRdmaLaOk(g, li)) return 0;
+  const struct gdakiCtrlRdmaLa& la = g->la[(size_t)li];
+  if (!la.beatOk || la.beatOut || la.beatLen == 0 || la.beatLen > cap) return 0;
+  memcpy(out, gdakiCtrlRdmaLaBeatBuf(g, li), la.beatLen);
+  return la.beatLen;
+}
+// The QP of launcher li failed since the last call (an error completion, a gap in its sequence, a failed post).
+static bool gdakiCtrlRdmaLaErrTake(struct gdakiCtrlRing* g, int li) {
+  if (!gdakiCtrlRdmaLaOk(g, li)) return false;
+  struct gdakiCtrlRdmaLa& la = g->la[(size_t)li];
+  if (la.errTaken) return false;
+  la.errTaken = true;
+  return true;
+}
+// The activation blob into its slot: (addr, rkey, bytes); false when it does not fit or there is no slot.
+static bool gdakiCtrlRdmaLaBlobPut(struct gdakiCtrlRing* g, const uint8_t* bytes, size_t n, struct gdakiCtrlRegion* out) {
+  if (g == nullptr || g->laBlob == nullptr || g->laBlobMr == nullptr || n > GDAKI_CTRL_LA_BLOB_BYTES) return false;
+  if (n > 0) memcpy(g->laBlob, bytes, n);
+  out->addr = (uint64_t)(uintptr_t)g->laBlob;
+  out->rkey = g->laBlobMr->rkey;
+  out->len = (uint32_t)n;
+  return true;
+}
+// A completion of launcher li's record QP (the CQ loop): a message in order into laIn (its consumed word published, the
+// RECV posted again), the window's ackSeq, a send slot back, the beat READ; an error or a gap: the QP failed.
+static void gdakiCtrlRdmaLaWc(struct gdakiCtrlRing* g, int li, uint32_t what, uint64_t id, bool ok, bool flush,
+                              uint32_t len) {
+  if (!gdakiCtrlRdmaLaOk(g, li)) return;
+  struct gdakiCtrlRdmaLa& la = g->la[(size_t)li];
+  if (gdakiCtrlWrGen(id) != la.gen || la.q == nullptr) return;  // an older QP's (destroyed with its generation)
+  auto fail = [&]() {
+    if (!la.err) {
+      la.err = true;
+      la.errTaken = false;
+    }
+    la.connected = false;
+  };
+  switch (what) {
+    case GDAKI_CTRL_WR_RECV: {
+      if (!ok) {
+        if (!flush) fail();
+        return;
+      }
+      const uint8_t* b = gdakiCtrlRdmaLaRxSlot(g, li, gdakiCtrlWrSlot(id) % GDAKI_CTRL_LA_RQ);
+      struct gdakiCtrlEnv e;
+      memcpy(&e, b, sizeof(e));
+      if (gdakiCtrlEnvCheck(&e, g->nonce, len) != GDAKI_CTRL_ENV_OK || e.kind != GDAKI_CTRL_K_LAUNCHER ||
+          (e.from & GDAKI_CTRL_FROM_LAUNCHER) == 0 || e.gen != la.gen || e.seq != la.seqIn + 1) {
+        la.bad++;
+        fail();  // a gap or another generation's message on this QP: its connection is lost (design v2 2.4)
+        return;
+      }
+      la.seqIn = e.seq;
+      la.rx++;
+      if (e.ackSeq > la.ackIn && e.ackSeq <= la.seqOut) la.ackIn = e.ackSeq;
+      gdakiCtrlWordStore(gdakiCtrlRdmaLaWord(g, li), ((uint64_t)la.gen << 32) | (la.seqIn & 0xffffffffu));
+      gdakiCtrlRdmaLaQueue(g, li, false, e, b + sizeof(e));
+      if (gdakiCtrlRdmaLaPostRecv(g, li, gdakiCtrlWrSlot(id) % GDAKI_CTRL_LA_RQ) != 0) fail();
+      gdakiCtrlRdmaLaFlush(g, li);
+      return;
+    }
+    case GDAKI_CTRL_WR_SEND:
+      if (gdakiCtrlWrSlot(id) < GDAKI_CTRL_LA_SQ) la.sBusy &= ~(1u << gdakiCtrlWrSlot(id));
+      if (!ok && !flush) fail();
+      else gdakiCtrlRdmaLaFlush(g, li);
+      return;
+    case GDAKI_CTRL_WR_READ_CREDIT:  // the beat READ (slot 0), the consumed word's (slot 1; 2a-2-C step 5)
+      if (gdakiCtrlWrSlot(id) == 1) {
+        la.creditOut = false;
+        if (!ok) {
+          if (!flush) fail();
+          return;
+        }
+        const uint64_t a0 = la.ackIn;
+        la.ackIn = gdakiCtrlLaLearnAck(la.gen, la.seqOut, la.ackIn,
+                                       __atomic_load_n(gdakiCtrlRdmaLaCreditBuf(g, li), __ATOMIC_ACQUIRE));
+        if (la.ackIn > a0) la.creditLearned++;
+        gdakiCtrlRdmaLaFlush(g, li);
+        return;
+      }
+      la.beatOut = false;
+      la.beatOk = ok;
+      la.beatDone++;
+      if (!ok && !flush) fail();
+      return;
+    default:
+      return;
+  }
+}
+// The launchers' datagrams and messages, oldest first, for the link (gdakiCtrlLauncherStep): false when none is left.
+static bool gdakiCtrlRdmaLaTake(struct gdakiCtrlRing* g, struct gdakiCtrlLaIn* out) {
+  if (g == nullptr || g->laIn.empty()) return false;
+  *out = g->laIn.front();
+  g->laIn.pop_front();
+  return true;
+}
+
+// ---- the helper's CQ ----
+// A datagram (the CQ loop): a pairing body becomes an action for after the loop (the model decides now, its QP moves
+// later: gdakiCtrlRdmaRunActs); a REJOIN record waits in udIn (bounded per rank).
+static void gdakiCtrlRdmaUdIn(struct gdakiCtrlRing* g, uint32_t slot, uint32_t len) {
+  const uint8_t* d = g->udRx + (size_t)slot * GDAKI_CTRL_UD_SLOT_BYTES + GDAKI_CTRL_UD_GRH_BYTES;
+  struct gdakiCtrlEnv e;
+  if (len < GDAKI_CTRL_UD_GRH_BYTES + sizeof(e)) {
+    g->badDgrams++;
+    return;
+  }
+  len -= GDAKI_CTRL_UD_GRH_BYTES;
+  memcpy(&e, d, sizeof(e));
+  if (e.from >= 0 && (e.from & GDAKI_CTRL_FROM_LAUNCHER) != 0) {
+    // int2 (REVIEW_P3 2a-2와 합칠 때 6): a launcher's PAIR or PAIR_ACK (its envelope's gen, seq and incarnation are 0):
+    // for the launcher link's step, whichever launcher it names (the link matches its node)
+    if (gdakiCtrlEnvCheck(&e, g->nonce, len) == GDAKI_CTRL_ENV_OK && e.kind == GDAKI_CTRL_K_PAIR &&
+        e.bodyBytes == GDAKI_CTRL_LAUNCHER_BYTES)
+      gdakiCtrlRdmaLaQueue(g, -1, true, e, d + sizeof(e));
+    else
+      g->badDgrams++;
+    return;
+  }
+  if (gdakiCtrlEnvCheck(&e, g->nonce, len) != GDAKI_CTRL_ENV_OK || e.from < 0 || e.from >= g->nranks || e.from == g->me) {
+    g->badDgrams++;  // another communicator's nonce, or malformed
+    return;
+  }
+  if (e.kind == GDAKI_CTRL_K_PAIR) {
+    struct gdakiCtrlPairBody b;
+    if (e.bodyBytes != sizeof(b)) {
+      g->badDgrams++;
+      return;
+    }
+    memcpy(&b, d + sizeof(e), sizeof(b));
+    // the body's sender, generation and incarnation are the envelope's (REVIEW_P12 nit 8)
+    if (!gdakiCtrlPairBodyOk(b, g->me, g->nonce) || b.from != e.from || b.gen != e.gen || b.incarnation != e.incarnation) {
+      g->badDgrams++;
+      return;
+    }
+    struct gdakiCtrlRdmaAct a;
+    a.peer = e.from;
+    a.qpKind = b.qpKind;
+    a.haveIn = true;
+    a.in = b;
+    g->acts.push_back(a);
+    return;
+  }
+  if (e.kind == GDAKI_CTRL_K_RECORD) {  // REJOIN, REJOIN_ACK: their reader (phase 2a-2) takes them
+    struct gdakiCtrlRdmaPeer& pr = g->peers[(size_t)e.from];
+    if (pr.udInN >= GDAKI_CTRL_UDIN_PER_PEER) {  // nobody reads them (a REJOIN every 200 ms): the oldest goes
+      for (auto it = g->udIn.begin(); it != g->udIn.end(); ++it)
+        if (it->from == e.from) {
+          g->udIn.erase(it);
+          pr.udInN--;
+          g->udInDropped++;
+          break;
+        }
+    }
+    g->udIn.emplace_back();
+    struct gdakiCtrlUdIn& u = g->udIn.back();
+    u.from = e.from;
+    u.env = e;
+    memcpy(u.body, d + sizeof(e), e.bodyBytes);
+    pr.udInN++;
+    return;
+  }
+  g->badDgrams++;
+}
+// The UD QP made again after a RECV of it ended in error (its RQ is empty then; REVIEW_P12 고칠 것 13): a line, a new
+// QP with its RECVs. Its endpoint changes: the peers learn it from this side's next PAIR.
+static void gdakiCtrlRdmaUdRemake(struct gdakiCtrlRing* g) {
+  g->udBroken = false;
+  char why[160] = {0};
+  gdakiMiHostQpDestroy(g->ud);
+  g->ud = nullptr;
+  g->udTxBusy = 0;  // the old QP's sends are gone with it
+  struct gdakiMiQpEndpoint v1;
+  const struct gdakiCtrlQpAttr ua = gdakiCtrlQpAttrUd(g->qkey, g->cq->cq);
+  bool ok = gdakiMiHostQpCreate(g->r, 1, &g->ud, &v1, why, sizeof(why), ua) == ncclSuccess &&
+            gdakiMiHostQpConnect(g->ud, v1, why, sizeof(why)) == ncclSuccess;
+  for (uint32_t s = 0; ok && s < GDAKI_CTRL_UD_RQ; s++) ok = gdakiCtrlRdmaPostUdRecv(g, s) == 0;
+  if (ok) {
+    g->udLocal = gdakiCtrlEndpointOf(v1, GDAKI_CTRL_QPT_UD);
+    g->udLocal.psn = ua.qkey;
+    g->udRemade++;
+  }
+  WARN("GIN/RC: rank %d: the UD QP's RECV ended in error: the UD QP %s (%s) mono_ms=%.3f", g->me,
+       ok ? "was made again" : "could not be made again", ok ? "the peers learn it from the next PAIR" : why,
+       gdakiQ4MonoMs());
+}
+// The CQ only (Prepare's inner loop; REVIEW_P12 고칠 것 9): completions into the models; the pairing actions they raise
+// wait in g->acts for the full poll.
+// A RECV completion into the pair's ring (the slot's bytes; its consumed word published).
+static void gdakiCtrlRdmaOnRecvWc(struct gdakiCtrlRing* g, uint32_t peer, uint64_t id, bool ok, uint32_t len) {
+  struct gdakiCtrlRdmaPeer& pr = g->peers[peer];
+  const uint8_t* slot = g->rxMem + gdakiCtrlRingSlotOff((int)peer, gdakiCtrlWrSlot(id) % GDAKI_CTRL_RING_SLOTS);
+  const bool wasConnected = pr.ring.connected;
+  (void)gdakiCtrlRingOnRecvCqe(&pr.ring, g->ops, id, ok, slot, ok ? len : 0);
+  gdakiCtrlWordStore(&g->rxConsumed[peer], gdakiCtrlRingConsumedWord(&pr.ring));
+  if (!wasConnected && pr.ring.connected)  // CONNECTED on the RC QP: its peer is the paired process
+    (void)gdakiCtrlPairOnDone(&pr.pairRec, pr.ring.gen, pr.pairRec.peerInc, true);
+}
+static void gdakiCtrlRdmaCollect(struct gdakiCtrlRing* g) {
+  if (g == nullptr || g->cq == nullptr) return;
+  while (!g->held.empty() && !gdakiCtrlStallNow(g)) {  // CREDIT_STALL ended: the held completions first, in order
+    const struct gdakiCtrlHeldWc h = g->held.front();
+    g->held.pop_front();
+    if (gdakiCtrlWrPeer(h.id) < (uint32_t)g->nranks) gdakiCtrlRdmaOnRecvWc(g, gdakiCtrlWrPeer(h.id), h.id, h.ok, h.len);
+  }
+  for (int round = 0; round < 64; round++) {
+    struct ibv_wc wc[32];
+    int n = 0;
+    if (wrap_ibv_poll_cq(g->cq->cq, 32, wc, &n) != ncclSuccess || n <= 0) break;
+    for (int k = 0; k < n; k++) {
+      const uint64_t id = wc[k].wr_id;
+      const bool ok = wc[k].status == IBV_WC_SUCCESS;
+      const uint32_t peer = gdakiCtrlWrPeer(id);
+      const uint32_t what = gdakiCtrlWrWhat(id);
+      if (what == GDAKI_CTRL_WR_UD_RECV) {
+        if (ok) {
+          gdakiCtrlRdmaUdIn(g, gdakiCtrlWrSlot(id), wc[k].byte_len);
+          if (gdakiCtrlRdmaPostUdRecv(g, gdakiCtrlWrSlot(id)) != 0) g->udBroken = true;
+        } else {
+          g->udRecvErrs++;
+          g->udBroken = true;  // never posted again on a QP in error: made again after the batch
+        }
+        continue;
+      }
+      if (what == GDAKI_CTRL_WR_UD_SEND) {
+        if (gdakiCtrlWrSlot(id) < 64u) g->udTxBusy &= ~(1ull << gdakiCtrlWrSlot(id));
+        continue;
+      }
+      if (peer >= GDAKI_CTRL_WR_LA_PEER) {  // int2: a launcher's record QP
+        gdakiCtrlRdmaLaWc(g, (int)(peer - GDAKI_CTRL_WR_LA_PEER), what, id, ok, wc[k].status == IBV_WC_WR_FLUSH_ERR,
+                          wc[k].byte_len);
+        continue;
+      }
+      if (peer >= (uint32_t)g->nranks) continue;
+      struct gdakiCtrlRdmaPeer& pr = g->peers[peer];
+      switch (what) {
+        case GDAKI_CTRL_WR_RECV:
+          if (gdakiCtrlStallNow(g) || !g->held.empty()) {  // CREDIT_STALL (phase 2a-2-B): held, in arrival order
+            struct gdakiCtrlHeldWc h;
+            h.id = id;
+            h.ok = ok;
+            h.len = wc[k].byte_len;
+            g->held.push_back(h);
+            break;
+          }
+          gdakiCtrlRdmaOnRecvWc(g, peer, id, ok, wc[k].byte_len);
+          break;
+        case GDAKI_CTRL_WR_SEND: {
+          const bool rnr = wc[k].status == IBV_WC_RNR_RETRY_EXC_ERR;
+          pr.rnr += rnr;
+          gdakiCtrlRingOnSendCqe(&pr.ring, id, ok, rnr);
+          break;
+        }
+        case GDAKI_CTRL_WR_READ_CREDIT:
+          gdakiCtrlRingOnCreditWord(&pr.ring, gdakiCtrlWrGen(id), ok, __atomic_load_n(&g->creditRd[peer], __ATOMIC_ACQUIRE));
+          if (!ok && gdakiCtrlWrGen(id) == pr.ring.gen) {
+            gdakiCtrlRingLose(&pr.ring, "READERR");
+            if (wc[k].status == IBV_WC_REM_ACCESS_ERR && !pr.creditOff) {  // a stale page rkey (REVIEW_P12 고칠 것 14)
+              pr.creditOff = true;
+              WARN("GIN/RC: rank %d: the consumed word's READ of rank %d hit a remote access error: that path is off "
+                   "until the next pairing (the envelopes' ackSeq carries the credit) mono_ms=%.3f", g->me, peer,
+                   gdakiQ4MonoMs());
+            }
+          }
+          break;
+        case GDAKI_CTRL_WR_READ_XFER:
+          if (gdakiCtrlWrGen(id) == pr.ring.gen) {
+            pr.xferReadOut = false;
+            pr.xferReadOk = ok;
+          }
+          if (!ok && gdakiCtrlWrGen(id) == pr.ring.gen) gdakiCtrlRingLose(&pr.ring, "READERR");
+          break;
+        default: break;
+      }
+    }
+  }
+}
+// The actions of the last batch, outside the CQ loop (each may Prepare a QP, which collects the CQ again).
+static void gdakiCtrlRdmaRunActs(struct gdakiCtrlRing* g) {
+  while (!g->acts.empty()) {
+    const struct gdakiCtrlRdmaAct a = g->acts.front();
+    g->acts.pop_front();
+    struct gdakiCtrlRdmaPeer& pr = g->peers[(size_t)a.peer];
+    if (a.qpKind == GDAKI_CTRL_PAIR_QP_PROBE) {
+      gdakiCtrlProbeLinkOnBody(g->r, a.peer, pr.prb, gdakiCtrlRdmaProbeCtx(g), a.in);
+      continue;
+    }
+    const struct gdakiCtrlPairBody& b = a.in;
+    const uint32_t cls = gdakiLnClassify(gdakiLnOf(g->r, a.peer), b.incarnation);  // REVIEW_P12 막는 문제 7
+    const bool lnOk = cls == GDAKI_LN_CURRENT;
+    uint32_t act = GDAKI_CTRL_PA_NONE;
+    if (b.step == GDAKI_CTRL_PAIR_STEP_PAIR) act = gdakiCtrlPairOnPair(&pr.pairRec, b.gen, b.incarnation, lnOk, &b.qp, gdakiQ4MonoMs());
+    else if (b.step == GDAKI_CTRL_PAIR_STEP_ACK) act = gdakiCtrlPairOnAck(&pr.pairRec, b.gen, b.incarnation, lnOk);
+    else continue;  // a record QP has no PAIR_DONE (its CONNECTED is an RC SEND)
+    if (pr.pairRec.lnLog)
+      WARN(GDAKI_LN_HEAD "rank %d: a record QP pairing (step %u, gen %u) of rank %d's incarnation %u is dropped: the "
+           "lineage classifies it %s mono_ms=%.3f", g->me, b.step, b.gen, a.peer, b.incarnation, gdakiLnClassName(cls),
+           gdakiQ4MonoMs());
+    gdakiCtrlRdmaPairAct(g, a.peer, act, &b);
+  }
+}
+// The full poll (the helper's): collect, the UD QP made again if it broke, the pairing actions, the clocks, the kicks.
+// A nested call (a sender's or Prepare's wait inside an action) only collects.
+static void gdakiCtrlRdmaPoll(struct gdakiCtrlRing* g, double nowMs) {
+  if (g == nullptr || g->cq == nullptr) return;
+  gdakiCtrlRdmaCollect(g);
+  if (g->inPoll) return;
+  g->inPoll = true;
+  if (g->udBroken) gdakiCtrlRdmaUdRemake(g);
+  gdakiCtrlRdmaRunActs(g);
+  const struct gdakiCtrlProbeLinkCtx pc = gdakiCtrlRdmaProbeCtx(g);
+  const struct gdakiCtrlPage* pg = gdakiPageOf(g->r);
+  for (int p = 0; p < g->nranks; p++) {
+    if (p == g->me) continue;
+    struct gdakiCtrlRdmaPeer& pr = g->peers[(size_t)p];
+    gdakiCtrlRdmaPairAct(g, p, gdakiCtrlPairTick(&pr.pairRec, nowMs), nullptr);
+    if (gdakiPageUp(pg)) gdakiCtrlProbeLinkTick(g->r, p, pr.prb, pc, pg->probeFailN);
+    (void)gdakiCtrlRingKick(&pr.ring, g->ops, nowMs);
+  }
+  gdakiCtrlRdmaRunActs(g);
+  g->inPoll = false;
+}
+// The completion channel's fd was readable (the helper's poll): take the event (EAGAIN: none; the fd is non-blocking),
+// collect, re-arm, collect once more.
+static void gdakiCtrlRdmaOnWake(struct gdakiCtrlRing* g) {
+  if (g == nullptr || g->cq == nullptr || g->cq->channel == nullptr) return;
+  const struct gdakiCtrlVerbs* v = gdakiCtrlVerbsOf();
+  struct ibv_cq* cq = nullptr;
+  void* ctx = nullptr;
+  if (v->getCqEvent(g->cq->channel, &cq, &ctx) == 0) {
+    g->cqEvents++;
+    if (++g->cqEventsUnacked >= 64) {
+      v->ackCqEvents(g->cq->cq, (unsigned)g->cqEventsUnacked);
+      g->cqEventsUnacked = 0;
+    }
+  }
+  gdakiCtrlRdmaPoll(g, gdakiQ4MonoMs());
+  (void)g->cq->cq->context->ops.req_notify_cq(g->cq->cq, 0);
+  gdakiCtrlRdmaPoll(g, gdakiQ4MonoMs());
+}
+
+// ---- the swap points' rdma bodies (phase 2a-2 binds gdakiCtrlSend, gdakiCtrlRecv and gdakiCtrlPump to them) ----
+// One record to `peer` (gdakiTsSend's contract: the magic stamped, bounded by timeoutMs): 0 queued or sent, -1 not (the
+// queue stayed full until the bound, or the pair's connection of this generation is lost). `mark`: the pair's path
+// marker for the envelope (phase 2a-2-C).
+static int gdakiCtrlRdmaSend(struct gdakiCtrlRing* g, int peer, struct gdakiTsMsg* m, int timeoutMs,
+                             const struct gdakiCtrlPathMark* mark = nullptr) {
+  if (g == nullptr || peer < 0 || peer >= g->nranks || peer == g->me) return -1;
+  m->magic = GDAKI_TS_MAGIC;
+  struct gdakiCtrlRdmaPeer& pr = g->peers[(size_t)peer];
+  const double deadline = gdakiQ4MonoMs() + timeoutMs;
+  while (true) {
+    const int r = gdakiCtrlRingEnqueue(&pr.ring, GDAKI_CTRL_K_RECORD, m, (uint32_t)sizeof(*m), mark);
+    if (r == 0) {
+      (void)gdakiCtrlRingKick(&pr.ring, g->ops, gdakiQ4MonoMs());
+      return 0;
+    }
+    if (r < 0 || gdakiQ4MonoMs() >= deadline) return -1;
+    gdakiCtrlRdmaPoll(g, gdakiQ4MonoMs());
+    std::this_thread::sleep_for(std::chrono::microseconds(50));
+  }
+}
+// XFER and XFER_DONE out of the inbox (records and generation ends stay, in order): at most two of each are in flight
+// per pair. An older generation's are dropped (its transfer failed with it: gdakiCtrlRdmaNewGen).
+static void gdakiCtrlRdmaTakeXfers(struct gdakiCtrlRing* g, int peer) {
+  struct gdakiCtrlRdmaPeer& pr = g->peers[(size_t)peer];
+  bool took = false;
+  for (auto it = pr.ring.inbox.begin(); it != pr.ring.inbox.end();) {
+    if ((it->env.kind == GDAKI_CTRL_K_XFER || it->env.kind == GDAKI_CTRL_K_XFER_DONE) && it->env.gen != pr.ring.gen) {
+      it = pr.ring.inbox.erase(it);
+      took = true;
+    } else if (it->env.kind == GDAKI_CTRL_K_XFER || it->env.kind == GDAKI_CTRL_K_XFER_DONE) {
+      struct gdakiCtrlXfer x;
+      memcpy(&x, it->body, sizeof(x));
+      if (it->env.kind == GDAKI_CTRL_K_XFER) pr.xferIn.push_back(x);
+      else if (!gdakiCtrlOutboxDone(&pr.outbox, x)) gdakiCtrlRingLose(&pr.ring, "BADXFER");
+      it = pr.ring.inbox.erase(it);
+      took = true;
+    } else {
+      ++it;
+    }
+  }
+  if (took) gdakiCtrlRingUndefer(&pr.ring, g->ops);
+}
+// The next record of `peer` (gdakiTsPump's contract): 1 a record in *out, 0 none yet, -1 the connection of this
+// generation is lost and nothing is left (cause: "QP:<the ring's cause>"). `mark`: the record's path marker (its
+// envelope's reserved bytes; phase 2a-2-C).
+static int gdakiCtrlRdmaRecv(struct gdakiCtrlRing* g, int peer, struct gdakiTsMsg* out, char* cause, size_t clen,
+                             struct gdakiCtrlPathMark* mark = nullptr) {
+  if (g == nullptr || peer < 0 || peer >= g->nranks || peer == g->me) return -1;
+  struct gdakiCtrlRdmaPeer& pr = g->peers[(size_t)peer];
+  gdakiCtrlRdmaPoll(g, gdakiQ4MonoMs());
+  gdakiCtrlRdmaTakeXfers(g, peer);
+  struct gdakiCtrlInEnt e;
+  const int r = gdakiCtrlRingPop(&pr.ring, g->ops, &e);
+  if (r == 1) {
+    gdakiCtrlWordStore(&g->rxConsumed[peer], gdakiCtrlRingConsumedWord(&pr.ring));
+    if (e.env.kind != GDAKI_CTRL_K_RECORD) return 0;  // nothing else is a record's (TakeXfers took the XFERs)
+    memcpy(out, e.body, sizeof(*out));
+    if (mark != nullptr) memcpy(mark, e.env.pathMark, sizeof(*mark));
+    return 1;
+  }
+  if (r < 0) snprintf(cause, clen, "QP:%s", pr.ring.lost ? pr.ring.lostCause : "NEWGEN");  // NEWGEN: the peer re-paired
+  return r;
+}
+
+// ---- the outbox (STATE, the rkey list, the activation blob): XFER, the receiver's READ, XFER_DONE ----
+// In steps (phase 2a-2-C step 3; 2a-1's gdakiCtrlRdmaXferSend/Recv waited inside): each call polls the ring once and moves
+// the transfer as far as the halves, the queue and the READ allow. 1 not yet, 0 done, -1 failed (why); the caller bounds
+// the time. A transfer lives in one generation of the pair's record QP (a new one fails it: gdakiCtrlRdmaNewGen).
+static void gdakiCtrlRdmaXOutStart(struct gdakiCtrlRing* g, int peer, std::vector<uint8_t>&& data) {
+  struct gdakiCtrlRdmaPeer& pr = g->peers[(size_t)peer];
+  pr.xo = gdakiCtrlXOut();
+  pr.xo.on = true;
+  pr.xo.gen = pr.ring.gen;
+  pr.xo.b = std::move(data);
+}
+static int gdakiCtrlRdmaXOutStep(struct gdakiCtrlRing* g, int peer, char* why, size_t whyLen) {
+  struct gdakiCtrlRdmaPeer& pr = g->peers[(size_t)peer];
+  struct gdakiCtrlXOut& o = pr.xo;
+  gdakiCtrlRdmaPoll(g, gdakiQ4MonoMs());
+  gdakiCtrlRdmaTakeXfers(g, peer);
+  if (!o.on || o.gen != pr.ring.gen || pr.ring.lost) {
+    snprintf(why, whyLen, "the transfer to rank %d ended with its connection (%s)", peer,
+             pr.ring.lost ? pr.ring.lostCause : "a new generation");
+    o.on = false;
+    return -1;
+  }
+  const uint64_t bytes = o.b.size();
+  while (o.pend || !o.started || o.off < bytes) {
+    if (!o.pend) {
+      const uint64_t piece = std::min<uint64_t>(GDAKI_CTRL_OUTBOX_HALF_BYTES, bytes - o.off);
+      const int h = gdakiCtrlOutboxTake(&pr.outbox, piece, g->outboxMr->rkey, o.off + piece >= bytes, &o.x);
+      if (h < 0) return 1;  // both halves wait for their XFER_DONE
+      if (piece > 0) memcpy(g->outbox + (size_t)h * GDAKI_CTRL_OUTBOX_HALF_BYTES, o.b.data() + o.off, piece);
+      o.off += piece;
+      o.started = o.pend = true;
+    }
+    const int q = gdakiCtrlRingEnqueue(&pr.ring, GDAKI_CTRL_K_XFER, &o.x, (uint32_t)sizeof(o.x));
+    if (q < 0) {
+      snprintf(why, whyLen, "the XFER to rank %d could not be queued", peer);
+      o.on = false;
+      return -1;
+    }
+    if (q != 0) return 1;  // the queue is full
+    o.pend = false;
+    (void)gdakiCtrlRingKick(&pr.ring, g->ops, gdakiQ4MonoMs());
+  }
+  if (pr.outbox.busy[0] || pr.outbox.busy[1]) return 1;  // the last pieces' XFER_DONE
+  o.on = false;
+  return 0;
+}
+// The next transfer of `peer` into pr.xi.b (at most maxBytes). Nothing pending is "not yet" (1) and moves nothing.
+static int gdakiCtrlRdmaXInStep(struct gdakiCtrlRing* g, int peer, uint64_t maxBytes, char* why, size_t whyLen) {
+  struct gdakiCtrlRdmaPeer& pr = g->peers[(size_t)peer];
+  struct gdakiCtrlXIn& in = pr.xi;
+  gdakiCtrlRdmaPoll(g, gdakiQ4MonoMs());
+  gdakiCtrlRdmaTakeXfers(g, peer);
+  auto fail = [&]() {
+    in.on = in.reading = in.donePend = false;
+    if (g->inStageBy == peer) g->inStageBy = -1;
+    return -1;
+  };
+  if (pr.ring.lost || (in.on && in.gen != pr.ring.gen)) {
+    snprintf(why, whyLen, "the transfer from rank %d stopped (%s)", peer, pr.ring.lost ? pr.ring.lostCause : "a new generation");
+    return fail();
+  }
+  while (true) {
+    if (in.donePend) {
+      const int q = gdakiCtrlRingEnqueue(&pr.ring, GDAKI_CTRL_K_XFER_DONE, &in.x, (uint32_t)sizeof(in.x));
+      if (q < 0) {  // the giver never hears it: a failure, not a success (REVIEW_P12 고칠 것 15)
+        snprintf(why, whyLen, "the XFER_DONE to rank %d could not be queued (%s)", peer,
+                 pr.ring.lost ? pr.ring.lostCause : "lost");
+        return fail();
+      }
+      if (q != 0) return 1;
+      in.donePend = false;
+      (void)gdakiCtrlRingKick(&pr.ring, g->ops, gdakiQ4MonoMs());
+      if (in.x.flags & GDAKI_CTRL_XFER_F_END) {
+        in.on = false;
+        return 0;
+      }
+      continue;
+    }
+    if (in.reading) {
+      if (pr.xferReadOut) return 1;
+      in.reading = false;
+      if (g->inStageBy == peer) g->inStageBy = -1;
+      if (!pr.xferReadOk) {
+        snprintf(why, whyLen, "the outbox READ from rank %d did not complete", peer);
+        return fail();
+      }
+      in.b.insert(in.b.end(), g->inStage, g->inStage + in.x.bytes);
+      in.donePend = true;
+      continue;
+    }
+    if (pr.xferIn.empty()) return 1;
+    const struct gdakiCtrlXfer& x = pr.xferIn.front();
+    if (x.bytes > 0 && g->inStageBy >= 0 && g->inStageBy != peer && g->peers[(size_t)g->inStageBy].xi.reading)
+      return 1;  // another pair's READ uses the stage
+    if (!in.on) {
+      in = gdakiCtrlXIn();
+      in.on = true;
+      in.gen = pr.ring.gen;
+    }
+    in.x = x;
+    pr.xferIn.pop_front();
+    if (!gdakiCtrlOutboxAccept(&pr.outbox, in.x, pr.remoteOutbox.rkey) || in.b.size() + in.x.bytes > maxBytes ||
+        (uint64_t)(in.x.half + 1u) * GDAKI_CTRL_OUTBOX_HALF_BYTES > pr.remoteOutbox.len) {
+      snprintf(why, whyLen, "a malformed XFER from rank %d (id %llu, %llu bytes)", peer, (unsigned long long)in.x.xferId,
+               (unsigned long long)in.x.bytes);
+      return fail();
+    }
+    if (in.x.bytes == 0) {
+      in.donePend = true;
+      continue;
+    }
+    struct ibv_sge sg;
+    sg.addr = (uint64_t)(uintptr_t)g->inStage;
+    sg.length = (uint32_t)in.x.bytes;
+    sg.lkey = g->inStageMr->lkey;
+    struct ibv_send_wr wr, *bad = nullptr;
+    memset(&wr, 0, sizeof(wr));
+    wr.wr_id = gdakiCtrlWrId(GDAKI_CTRL_WR_READ_XFER, (uint32_t)peer, pr.ring.gen, in.x.half);
+    wr.sg_list = &sg;
+    wr.num_sge = 1;
+    wr.opcode = IBV_WR_RDMA_READ;
+    wr.send_flags = IBV_SEND_SIGNALED;
+    wr.wr.rdma.remote_addr = pr.remoteOutbox.addr + (uint64_t)in.x.half * GDAKI_CTRL_OUTBOX_HALF_BYTES;
+    wr.wr.rdma.rkey = in.x.rkey;
+    pr.xferReadOut = true;
+    pr.xferReadOk = false;
+    if (pr.q == nullptr || wrap_ibv_post_send(pr.q->qp, &wr, &bad) != ncclSuccess) {
+      pr.xferReadOut = false;
+      snprintf(why, whyLen, "cannot post the outbox READ from rank %d", peer);
+      return fail();
+    }
+    in.reading = true;
+    g->inStageBy = peer;
+    gdakiCtrlRdmaPoll(g, gdakiQ4MonoMs());
+  }
+}
+// The RNR count of every pair (9.1: 0 when the credit is right; the port counter rnr_nak_retry_err is the runner's).
+static uint64_t gdakiCtrlRdmaRnr(const struct gdakiCtrlRing* g) {
+  uint64_t n = 0;
+  if (g != nullptr)
+    for (const struct gdakiCtrlRdmaPeer& pr : g->peers) n += pr.rnr;
+  return n;
+}
+
+// ---- phase 2a-2-A: the setup (gdakiTsSetup) and the first pairing (the helper's step; impl/notes_p2a2.md) ----
+// The liveness thresholds as the page reads them (gdakiPageSetup): every rank the same (the setup agreement).
+static struct gdakiCtrlThresholds gdakiCtrlThresholdsNow() {
+  struct gdakiCtrlThresholds t;
+  t.probeMs = ncclParamGinTsProbeMs();
+  t.probeTimeoutMs = ncclParamGinCtrlProbeTimeoutMs();
+  t.confirmMs = ncclParamGinCtrlConfirmMs();
+  t.suspectMs = ncclParamGinTsSuspectMs();
+  t.stallMs = ncclParamGinTsStallMs();
+  t.restoreMs = ncclParamGinRestoreMs();
+  return t;
+}
+static uint32_t gdakiCtrlForkStatus() {
+  const struct gdakiCtrlVerbs* v = gdakiCtrlVerbsOf();
+  return v->isForkInit != nullptr ? (uint32_t)v->isForkInit() : 0xffu;
+}
+// Before the all-gather (the setup thread): the ring (helper CQ with its channel, the regions, the UD QP) unless the page
+// parameter is 0 or this rank's transparent recovery is off already, and this rank's control fields in *mine. `seed`:
+// this rank's salt (the recorded one for a spare): its UD Q_Key, since the context's nonce comes after the exchange.
+static void gdakiCtrlRingSetup(struct gdakiRecHost* r, bool on, int me, int nranks, uint64_t seed,
+                               struct gdakiCtrlSetupAddr* mine) {
+  struct gdakiCtrlRing* g = nullptr;
+  char why[192] = {0};
+  if (on && r != nullptr && r->ctrl != nullptr && r->ctrl->ring == nullptr && ncclParamGinCtrlPage() != 0) {
+    if (gdakiCtrlRdmaCreate(r, me, nranks, 0, seed, gdakiRsSelfInc(r), &g, why, sizeof(why)) != ncclSuccess) {
+      WARN("GIN/RC: rank %d: the control ring could not be made (%s): control path rdma-off mono_ms=%.3f", me, why,
+           gdakiQ4MonoMs());
+      g = nullptr;
+    } else {
+      r->ctrl->ring = g;
+    }
+  }
+  const uint32_t fork = gdakiCtrlForkStatus();
+  uint32_t mtu = 0;
+  if (g != nullptr) mtu = (uint32_t)g->udLocal.mtu;  // the GIN port's active_mtu (the host QP template's)
+  else if (r != nullptr && r->ctx != nullptr) mtu = (uint32_t)r->ctx->port_attr.active_mtu;
+  struct gdakiCtrlEndpoint ud;
+  struct gdakiCtrlRegion ob;
+  memset(&ud, 0, sizeof(ud));
+  memset(&ob, 0, sizeof(ob));
+  if (g != nullptr) {
+    ud = g->udLocal;
+    ob = gdakiCtrlRdmaOutboxRegion(g);
+    g->setup.activeMtu = mtu;
+    g->setup.fork = fork;
+  }
+  gdakiCtrlSetupMine(mine, g != nullptr, ud, ob, mtu, fork, gdakiCtrlThresholdsNow());
+  GIN_TS_NOTE("GIN/RC: rank %d: control setup path=%s active_mtu=%u (%d B) fork=%u ud_qpn=%u qkey=0x%x mono_ms=%.3f", me,
+              g != nullptr ? "rdma" : "rdma-off", mtu, mtu >= 1 && mtu <= 5 ? 128 << mtu : 0, fork, ud.qpn, ud.psn,
+              gdakiQ4MonoMs());
+}
+// The ring's models take the context's nonce and this process's incarnation (the setup thread, after the exchange,
+// before anything posts or pairs).
+static void gdakiCtrlRdmaSetNonce(struct gdakiCtrlRing* g, uint64_t nonce, uint32_t inc) {
+  g->nonce = nonce;
+  g->inc = inc;
+  for (int p = 0; p < g->nranks; p++) {
+    struct gdakiCtrlRdmaPeer& pr = g->peers[(size_t)p];
+    gdakiCtrlRingInit(&pr.ring, p, g->me, nonce, inc, GDAKI_TS_MAGIC);
+    gdakiCtrlPairInit(&pr.pairRec, GDAKI_CTRL_PAIR_QP_RECORD, g->me, p);
+    pr.prb = gdakiCtrlProbeLink();
+    gdakiCtrlPairInit(&pr.prb.st, GDAKI_CTRL_PAIR_QP_PROBE, g->me, p);
+  }
+}
+// After the all-gather (the setup thread): the agreement over the ranks' control fields (all[p] null: a rank without
+// transparent recovery; the same verdict on every rank: the same records), a spare's strict fields against its
+// transcript slot (`rec`, null: not a spare), the context's nonce into the ring and every peer's UD endpoint. One line;
+// a WARN when the verdict turns transparent recovery off. Returns that verdict's literal (the setup's `why`), or null.
+static const char* gdakiCtrlRingAgree(struct gdakiRecHost* r, int me, int nranks, uint64_t nonce,
+                                      const struct gdakiCtrlSetupAddr* const* all, const struct gdakiCtrlSetupAddr* rec) {
+  struct gdakiCtrlRing* g = (r != nullptr && r->ctrl != nullptr) ? r->ctrl->ring : nullptr;
+  struct gdakiCtrlSetupOut o;
+  if (g != nullptr) o = g->setup;  // this rank's active_mtu and fork
+  const char* off = nullptr;
+  (void)gdakiCtrlSetupVerdict(all, nranks, &o, &off);
+  o.spare = rec != nullptr;
+  if (rec != nullptr && all[me] != nullptr) {
+    char w[128] = {0};
+    if (!gdakiCtrlSpareCtlMatch(*rec, *all[me], w, sizeof(w))) {
+      o.spareDiffers = true;
+      if (off == nullptr) {
+        snprintf(o.why, sizeof(o.why), "spare: %s", w);
+        off = GDAKI_CTRL_R44;
+      }
+    }
+  }
+  if (g != nullptr) {
+    g->setup = o;
+    gdakiCtrlRdmaSetNonce(g, nonce, gdakiRsSelfInc(r));
+    for (int p = 0; p < nranks; p++)
+      if (p != me && all[p] != nullptr && all[p]->path == GDAKI_CTRL_PATH_RDMA) gdakiCtrlRdmaSetUd(g, p, all[p]->ud);
+  }
+  if (off != nullptr)
+    WARN("GIN/RC: rank %d: setup agreement: %s (%s): transparent recovery off at the setup (Resume condition %u) "
+         "min_active_mtu=%u mono_ms=%.3f", me, off, o.why, o.spareDiffers && o.verdict == 0 ? 44u : o.verdict, o.minMtu,
+         gdakiQ4MonoMs());
+  else
+    GIN_TS_NOTE("GIN/RC: rank %d: setup agreement: control path %s on every rank, min_active_mtu=%u, thresholds equal "
+                "mono_ms=%.3f", me, g != nullptr ? "rdma" : "rdma-off", o.minMtu, gdakiQ4MonoMs());
+  return off;
+}
+// Resume's facts 41-44 (ncclGinRestoreResume, under gdakiRecRegMu; the ring's setup outcome is fixed before the helper
+// started): `buf` holds the texts. No ring: none (the records stay on the TCP path). 41 (int2, TODO(2a-2) 6): this
+// process asked for the restore (its launcher link exists: gdakiCtrlLaMake) but the latch says the own launcher is not
+// paired holding this incarnation (no INFO or REGISTER answer, no pairing yet, or no transport): fail-fast. Asked at the
+// call: a Resume before the helper's first pairing finished also gets 41 (impl/notes_int2.md, open).
+static void gdakiCtrlResumeFacts(struct gdakiRecHost* r, struct gdakiRsLocalIn* in, char (*buf)[GDAKI_CTRL_RESUME_WHY]) {
+  const struct gdakiCtrlRing* g = (r != nullptr && r->ctrl != nullptr) ? r->ctrl->ring : nullptr;
+  const struct gdakiCtrlPage* pg = r != nullptr ? gdakiPageOf(r) : nullptr;
+  const bool paired = pg != nullptr && pg->launcherPaired.load(std::memory_order_acquire);
+  const bool named = r != nullptr && r->ctrl != nullptr && r->ctrl->launcher != nullptr;
+  gdakiCtrlResumeConds(g != nullptr ? &g->setup : nullptr, named, paired, buf, &in->gc41, &in->gc42, &in->gc43, &in->gc44);
+}
+// The helper's step (gdakiCtrlPageHelperStep, every loop of gdakiTsMain), after the setup agreed: once the status page
+// is up its rxConsumed[N] takes the ring's consumed words (before anything posts: notes_fix12 6), then the lower rank of
+// every gated pair starts both pairings over UD (the record QP and the liveness READ QP, NCCL_GIN_TS_CONNECT_MS; the
+// model's PAIR with a fresh PSN; the record QP's CONNECTED, kind 6, goes first on it), and the ring's poll runs (the
+// datagrams, the resends, the kicks). The higher rank answers from its poll. The records stay on the helper socket until
+// phase 2a-2-B sets `live`. A spare pairs through its REJOIN (phase 2a-2-C).
+static void gdakiCtrlRingLiveStep(struct gdakiRecHost* r);  // the live seams' (below)
+static void gdakiCtrlRjIntake(struct gdakiRecHost* r);      // the live seams' (below): the REJOINs over UD (2a-2-C)
+static void gdakiCtrlRingHelperStep(struct gdakiRecHost* r) {
+  struct gdakiCtrlRing* g = (r != nullptr && r->ctrl != nullptr) ? r->ctrl->ring : nullptr;
+  if (g == nullptr || r->ts == nullptr || !g->setup.agreed || g->setup.verdict != 0 || g->setup.spareDiffers) return;
+  struct gdakiCtrlPage* pg = gdakiPageOf(r);
+  if (!g->bound) {
+    if (!gdakiPageUp(pg)) return;  // nothing polls before the binding: a peer's PAIR waits in the UD RQ (it resends)
+    if (pg->layout.rxConsumedOff != g->layout.rxConsumedOff || pg->layout.bytes != g->layout.bytes) {
+      WARN("GIN/RC: rank %d: the status page's layout is not the ring's (rxConsumed at %u, %u B; the ring's %u, %u B): "
+           "no pairing mono_ms=%.3f", g->me, pg->layout.rxConsumedOff, pg->layout.bytes, g->layout.rxConsumedOff,
+           g->layout.bytes, gdakiQ4MonoMs());
+      g->setup.verdict = 44;  // never again this context (Resume's 44 names it)
+      snprintf(g->setup.why, sizeof(g->setup.why), "the status page's layout is not the ring's");
+      return;
+    }
+    g->rxConsumed = gdakiCtrlBindWords(g->rxConsumedOwn, (uint64_t*)((uint8_t*)pg->page + pg->layout.rxConsumedOff),
+                                       g->nranks);
+    g->bound = true;
+  }
+  if (!g->pairingStarted) {
+    g->pairingStarted = true;
+    int started = 0, gated = 0;
+    const double bound = (double)ncclParamGinTsConnectMs();
+    for (int p = 0; !g->setup.spare && p < g->nranks && p < (int)r->ts->peers.size(); p++) {
+      if (p == g->me || !r->ts->peers[(size_t)p].gated) continue;
+      struct gdakiCtrlRdmaPeer& pr = g->peers[(size_t)p];
+      const uint32_t inc = gdakiLnOf(r, p).cur;
+      gdakiCtrlPairSetPeerInc(&pr.pairRec, inc);
+      gdakiCtrlPairSetPeerInc(&pr.prb.st, inc);
+      pr.prb.started = true;
+      pr.prb.peerInc = inc;
+      gated++;
+      if (g->me > p) continue;  // the lower rank starts (17946-18158's order)
+      gdakiCtrlRdmaPairStart(g, p, GDAKI_CTRL_PAIR_QP_RECORD, bound);
+      if ((size_t)p < pg->peers.size() && pg->peers[(size_t)p].hasQp) gdakiCtrlRdmaPairStart(g, p, GDAKI_CTRL_PAIR_QP_PROBE, bound);
+      started++;
+    }
+    GIN_TS_NOTE("GIN/RC: rank %d: the ring's consumed words are the status page's rxConsumed[%d]; first pairing over UD "
+                "started with %d of %d gated rank(s) (record and liveness READ QPs; the records stay on the helper socket "
+                "until phase 2a-2-B) mono_ms=%.3f", g->me, g->nranks, started, gated, gdakiQ4MonoMs());
+  }
+  gdakiCtrlRdmaPoll(g, gdakiQ4MonoMs());
+  gdakiCtrlRjIntake(r);      // phase 2a-2-C: the REJOINs that came over UD (parked, answered, or repeated)
+  gdakiCtrlRingLiveStep(r);  // phase 2a-2-B: live once every pair is up, the re-pairing, the switches
+}
+// The seam gdakiCtrlChanUp's ring answer: true when the pair's records go on the ring (its path, phase 2a-2-C; the
+// switch to live sets it for every gated pair) and *up is the pair's; false: the socket's answer stands.
+static bool gdakiCtrlRdmaLiveUp(struct gdakiRecHost* r, int peer, bool* up) {
+  const struct gdakiCtrlRing* g = (r != nullptr && r->ctrl != nullptr) ? r->ctrl->ring : nullptr;
+  if (g == nullptr || peer < 0 || peer >= g->nranks || peer == g->me) return false;
+  if (g->peers[(size_t)peer].path.txPath != GDAKI_CTRL_PM_RING) return false;
+  *up = gdakiCtrlRdmaUp(g, peer);
+  return true;
+}
+#endif  // !NCCL_GIN_CTRL_TCP
+// ==== gin-control (ring): verbs back end (end) ====
+// ==== gin-control (store): decision 7 and the outbox transfers (begin; phase 2b, impl/notes_p2b.md) ====
+// Phase 2b (EXPERIMENT.md 9.1 "큰 자료", 9.7 decision 7, 9.8 phase 2; design v3 2.3, 2.8, 3.5). In the rdma build:
+//   - the checkpoint store is every restoring process's (gdakiStoreOn without gdakiMiOn): the mirror-off checkpoint goes
+//     as the whole image over the upload QP into the buddy's store (gin-mirror's store path, unchanged), the spare FETCHes
+//     it over a FETCH QP after its activation v2, whose blob has the store part only (GDAKI_MI_ACTB_F_STORE, no pool);
+//   - gdakiStoreWardToErr: at the hold start of a ward (the dead rank was the ward's owner) the buddy's side of that
+//     ward's upload QP goes to ERR through the store thread (the QP's owner); the stable slot stays for the FETCH;
+//   - STATE and the rkey list: through the pair's outbox (three transfers below) when the spare's REJOIN went over UD
+//     (phase 2a-2-C step 3: both sides take that way, waiting until the pair is up in the REJOIN's generation); the data
+//     socket carries them as in ln4 only when the pair has no ring (none in the context, or the REJOIN went over TCP);
+//   - the host memory this adds per rank is reported in one line at the store's request (no bound: decision 2026-10-17).
+// The tcp build has none of this (its preprocessed host file stays ln4's).
+#if !NCCL_GIN_CTRL_TCP
+// ---- gin-control (store): pure (begin; impl/gc_unit_p2b.cc compiles this region on the CPU) ----
+// Needs the blocks "gin-control: ctrl API", "gin-mirror: store API", gin-restore's checkpoint text (gdakiCkptHash),
+// struct gdakiTsMsg, the rkey list (struct gdakiRsRkeys), gin-mirror's spare pure region (the activation blob) and
+// <vector>. No verbs, no socket, no clock.
+//
+// One outbox transfer (gdakiCtrlRdmaXOutStep/XInStep, in steps since 2a-2-C: one or more halves, END on the last)
+// carries a 64 B head and its payload. The STATE sequence of one survivor s and the restored rank d's spare, on the pair's ring after the
+// REJOIN (decision of this phase: the spare starts each turn, since it takes the survivors one at a time; nothing of it
+// is a record, so the record layer and the hold machine never see it):
+//   1. d -> s  STATE_REQ  payload: the DATA record of ln4's answer (type DATA, from d, arg d, round K, pad 0), head inc =
+//                         d's incarnation, ckpt K
+//   2. s -> d  STATE      payload: ln4's data-socket bytes (uint64 n, then the n bytes of the export: v1 or, with the
+//                         mirror, v2), head inc = d's incarnation as s knows it (the lineage's current), ckpt K
+//   3. d -> s  RKEYS      payload: ln4's rkey list bytes (struct gdakiRsRkeysHdr, count x struct gdakiRsRkeyEntry),
+//                         head inc = d's incarnation
+// Each side checks the head (kind, from, to, nonce, incarnation, size, hash) and the payload as ln4's data socket did.
+// Kind 4 (ACTB, the activation blob through a launcher) is reserved for phase 3.
+// The head (GDAKI_CTRL_XFERH_*, GDAKI_CTRL_XK_*, struct gdakiCtrlXferHdr) is the ctrl API block's "[2] ring" part since
+// phase 2a-2 merged impl/rs_ctrl_api_p2b.diff (the same text, moved).
+#define GDAKI_CTRL_RKEYS_HDR_BYTES 32u
+#define GDAKI_CTRL_RKEYS_ENTRY_BYTES 16u
+static_assert(sizeof(struct gdakiRsRkeysHdr) == GDAKI_CTRL_RKEYS_HDR_BYTES &&
+                  sizeof(struct gdakiRsRkeyEntry) == GDAKI_CTRL_RKEYS_ENTRY_BYTES,
+              "the rkey list's bytes as ln4's data socket carries them");
+// A kind's largest payload (0: not a kind).
+static inline uint64_t gdakiCtrlXferMax(uint16_t kind) {
+  switch (kind) {
+    case GDAKI_CTRL_XK_STATE_REQ: return sizeof(struct gdakiTsMsg);
+    case GDAKI_CTRL_XK_STATE: return sizeof(uint64_t) + GDAKI_CKPT_STATE_MAX;
+    case GDAKI_CTRL_XK_RKEYS: return GDAKI_CTRL_RKEYS_HDR_BYTES + (uint64_t)GDAKI_RS_RKEYS_MAX * GDAKI_CTRL_RKEYS_ENTRY_BYTES;
+    case GDAKI_CTRL_XK_ACTB:
+      return sizeof(struct gdakiMiActHdr) + (uint64_t)GDAKI_MI_ACT_MAX_ADDR * sizeof(struct gdakiMiActAddr) +
+             (uint64_t)GDAKI_MI_ACT_MAX_EXT * sizeof(struct gdakiMiActExt);
+    default: return 0;
+  }
+}
+static inline void gdakiCtrlXferPack(std::vector<uint8_t>* out, uint16_t kind, int from, int to, uint32_t inc,
+                                     uint64_t nonce, uint64_t ckpt, const void* p, uint64_t n) {
+  struct gdakiCtrlXferHdr h;
+  memset(&h, 0, sizeof(h));
+  h.magic = GDAKI_CTRL_XFERH_MAGIC;
+  h.version = (uint16_t)GDAKI_CTRL_XFERH_VERSION;
+  h.kind = kind;
+  h.from = from;
+  h.to = to;
+  h.incarnation = inc;
+  h.nonce = nonce;
+  h.ckpt = ckpt;
+  h.bytes = n;
+  h.hash = gdakiCkptHash(p, (size_t)n, GDAKI_CKPT_HASH_SEED);
+  out->resize(sizeof(h) + (size_t)n);
+  memcpy(out->data(), &h, sizeof(h));
+  if (n) memcpy(out->data() + sizeof(h), p, (size_t)n);
+}
+enum : uint32_t {
+  GDAKI_CTRL_XC_OK = 0, GDAKI_CTRL_XC_SHORT = 1, GDAKI_CTRL_XC_MAGIC = 2, GDAKI_CTRL_XC_KIND = 3, GDAKI_CTRL_XC_PEER = 4,
+  GDAKI_CTRL_XC_NONCE = 5, GDAKI_CTRL_XC_INC = 6, GDAKI_CTRL_XC_BYTES = 7, GDAKI_CTRL_XC_HASH = 8, GDAKI_CTRL_XC_CKPT = 9,
+  GDAKI_CTRL_XC_RECORD = 10, GDAKI_CTRL_XC_REFUSED = 11, GDAKI_CTRL_XC_PAYLOAD = 12
+};
+static inline const char* gdakiCtrlXferWhy(uint32_t c) {
+  switch (c) {
+    case GDAKI_CTRL_XC_OK: return "ok";
+    case GDAKI_CTRL_XC_SHORT: return "shorter than its head";
+    case GDAKI_CTRL_XC_MAGIC: return "not a transfer head (magic or version)";
+    case GDAKI_CTRL_XC_KIND: return "another kind than the turn's";
+    case GDAKI_CTRL_XC_PEER: return "another pair's";
+    case GDAKI_CTRL_XC_NONCE: return "another context's (nonce)";
+    case GDAKI_CTRL_XC_INC: return "another incarnation's";
+    case GDAKI_CTRL_XC_BYTES: return "its size is not its head's or above the kind's bound";
+    case GDAKI_CTRL_XC_HASH: return "its payload's hash does not match";
+    case GDAKI_CTRL_XC_CKPT: return "another checkpoint's";
+    case GDAKI_CTRL_XC_RECORD: return "its record is not the spare's own";
+    case GDAKI_CTRL_XC_REFUSED: return "the spare refused the state transfer";
+    case GDAKI_CTRL_XC_PAYLOAD: return "its payload is malformed";
+    default: return "?";
+  }
+}
+// The head of a transfer that arrived whole (b, n): GDAKI_CTRL_XC_OK and *h, *payload; else what is wrong.
+static inline uint32_t gdakiCtrlXferCheck(const uint8_t* b, size_t n, uint16_t kind, int from, int to, uint64_t nonce,
+                                          uint32_t inc, struct gdakiCtrlXferHdr* h, const uint8_t** payload) {
+  if (n < sizeof(*h)) return GDAKI_CTRL_XC_SHORT;
+  memcpy(h, b, sizeof(*h));
+  if (h->magic != GDAKI_CTRL_XFERH_MAGIC || h->version != GDAKI_CTRL_XFERH_VERSION) return GDAKI_CTRL_XC_MAGIC;
+  if (h->kind != kind) return GDAKI_CTRL_XC_KIND;
+  if (h->from != from || h->to != to) return GDAKI_CTRL_XC_PEER;
+  if (h->nonce != nonce) return GDAKI_CTRL_XC_NONCE;
+  if (h->incarnation != inc) return GDAKI_CTRL_XC_INC;
+  if (h->bytes != (uint64_t)(n - sizeof(*h)) || h->bytes > gdakiCtrlXferMax(kind)) return GDAKI_CTRL_XC_BYTES;
+  if (h->hash != gdakiCkptHash(b + sizeof(*h), (size_t)h->bytes, GDAKI_CKPT_HASH_SEED)) return GDAKI_CTRL_XC_HASH;
+  *payload = b + sizeof(*h);
+  return GDAKI_CTRL_XC_OK;
+}
+// 1. the spare's STATE_REQ: ln4's answer record (gdakiCkptSpareDataFd), the magic stamped as gdakiTsSend does
+static inline void gdakiCtrlStateReqFill(struct gdakiTsMsg* a, int me, uint64_t nonce, uint64_t step) {
+  memset(a, 0, sizeof(*a));
+  a->magic = GDAKI_TS_MAGIC;
+  a->type = GDAKI_TS_DATA;
+  a->from = me;
+  a->nonce = nonce;
+  a->arg = me;
+  a->round = step;
+}
+// The survivor's take of a STATE_REQ from spare p (incKnown: p's incarnation as the lineage knows it): ln4's checks of
+// the answer (gdakiHoldTransferStep) on the record, the head's on the rest. *a: the record (its round is K).
+static inline uint32_t gdakiCtrlStateReqTake(const uint8_t* b, size_t n, int p, int me, uint64_t nonce, uint32_t incKnown,
+                                             struct gdakiTsMsg* a) {
+  struct gdakiCtrlXferHdr h;
+  const uint8_t* pl = nullptr;
+  const uint32_t c = gdakiCtrlXferCheck(b, n, GDAKI_CTRL_XK_STATE_REQ, p, me, nonce, incKnown, &h, &pl);
+  if (c != GDAKI_CTRL_XC_OK) return c;
+  if (h.bytes != sizeof(*a)) return GDAKI_CTRL_XC_BYTES;
+  memcpy(a, pl, sizeof(*a));
+  if (a->magic != GDAKI_TS_MAGIC || a->type != GDAKI_TS_DATA || a->from != p || a->nonce != nonce)
+    return GDAKI_CTRL_XC_RECORD;
+  if (a->round != h.ckpt) return GDAKI_CTRL_XC_CKPT;
+  if (a->pad != 0) return GDAKI_CTRL_XC_REFUSED;
+  return GDAKI_CTRL_XC_OK;
+}
+// 2. the survivor's STATE: ln4's bytes (n, then the export)
+static inline void gdakiCtrlStatePack(std::vector<uint8_t>* out, int me, int p, uint32_t inc, uint64_t nonce, uint64_t ckpt,
+                                      const std::vector<uint8_t>& x) {
+  std::vector<uint8_t> pl(sizeof(uint64_t) + x.size());
+  const uint64_t n = x.size();
+  memcpy(pl.data(), &n, sizeof(n));
+  if (n) memcpy(pl.data() + sizeof(n), x.data(), x.size());
+  gdakiCtrlXferPack(out, GDAKI_CTRL_XK_STATE, me, p, inc, nonce, ckpt, pl.data(), pl.size());
+}
+// The spare's take of survivor s's STATE for its checkpoint `step`: *x the export (ln4's n bytes).
+static inline uint32_t gdakiCtrlStateTake(const uint8_t* b, size_t n, int s, int me, uint64_t nonce, uint32_t inc,
+                                          uint64_t step, std::vector<uint8_t>* x) {
+  struct gdakiCtrlXferHdr h;
+  const uint8_t* pl = nullptr;
+  const uint32_t c = gdakiCtrlXferCheck(b, n, GDAKI_CTRL_XK_STATE, s, me, nonce, inc, &h, &pl);
+  if (c != GDAKI_CTRL_XC_OK) return c;
+  if (h.ckpt != step) return GDAKI_CTRL_XC_CKPT;
+  uint64_t k = 0;
+  if (h.bytes < sizeof(k)) return GDAKI_CTRL_XC_PAYLOAD;
+  memcpy(&k, pl, sizeof(k));
+  if (k > GDAKI_CKPT_STATE_MAX || k != h.bytes - sizeof(k)) return GDAKI_CTRL_XC_PAYLOAD;
+  x->assign(pl + sizeof(k), pl + sizeof(k) + k);
+  return GDAKI_CTRL_XC_OK;
+}
+// 3. the spare's rkey list: ln4's bytes (gdakiRsRkeysSend's header and entries)
+static inline void gdakiCtrlRkeysBytes(const struct gdakiRsRkeys& list, std::vector<uint8_t>* out) {
+  struct gdakiRsRkeysHdr h;
+  memset(&h, 0, sizeof(h));
+  h.magic = GDAKI_RS_RKEYS_MAGIC;
+  h.version = 1u;
+  h.rank = list.rank;
+  h.incarnation = list.incarnation;
+  h.nonce = list.nonce;
+  h.count = (uint32_t)list.e.size();
+  out->resize(sizeof(h) + list.e.size() * sizeof(struct gdakiRsRkeyEntry));
+  memcpy(out->data(), &h, sizeof(h));
+  if (!list.e.empty()) memcpy(out->data() + sizeof(h), list.e.data(), list.e.size() * sizeof(struct gdakiRsRkeyEntry));
+}
+// The survivor's take of spare p's RKEYS: ln4's checks (gdakiRsRkeysRecv) and the whole length.
+static inline uint32_t gdakiCtrlRkeysTake(const uint8_t* b, size_t n, int p, int me, uint64_t nonce, uint32_t inc,
+                                          struct gdakiRsRkeys* out) {
+  struct gdakiCtrlXferHdr h;
+  const uint8_t* pl = nullptr;
+  const uint32_t c = gdakiCtrlXferCheck(b, n, GDAKI_CTRL_XK_RKEYS, p, me, nonce, inc, &h, &pl);
+  if (c != GDAKI_CTRL_XC_OK) return c;
+  struct gdakiRsRkeysHdr k;
+  if (h.bytes < sizeof(k)) return GDAKI_CTRL_XC_PAYLOAD;
+  memcpy(&k, pl, sizeof(k));
+  if (k.magic != GDAKI_RS_RKEYS_MAGIC || k.version != 1u || k.count > GDAKI_RS_RKEYS_MAX ||
+      h.bytes != sizeof(k) + (uint64_t)k.count * sizeof(struct gdakiRsRkeyEntry))
+    return GDAKI_CTRL_XC_PAYLOAD;
+  out->rank = k.rank;
+  out->incarnation = k.incarnation;
+  out->nonce = k.nonce;
+  out->e.resize(k.count);
+  if (k.count) memcpy(out->e.data(), pl + sizeof(k), (size_t)k.count * sizeof(struct gdakiRsRkeyEntry));
+  return GDAKI_CTRL_XC_OK;
+}
+
+// ---- decision 7: who takes the store path, the store-only blob, the ward's QP at its owner's hold start ----
+// The activation v2 (the blob, the FETCH over the store) with the mirror on (gin-mirror) and, in the rdma build, with the
+// store on (every restoring process): mirrorOn || storeOn.
+static inline bool gdakiCtrlStoreActV2Of(bool mirrorOn, bool storeOn) { return mirrorOn || storeOn; }
+// A spare without the mirror takes a blob of the store part only (design v3 2.8: "저장소 칸만 유효, pool 표시 없음").
+static inline bool gdakiCtrlStoreBlobModeOk(const struct gdakiMiActHdr& h, bool mirrorOn) {
+  if (mirrorOn) return true;  // gin-mirror's own checks (gdakiMiActCheck)
+  return (h.flags & GDAKI_MI_ACTB_F_STORE) != 0 && (h.flags & GDAKI_MI_ACTB_F_POOL) == 0 && h.nExt == 0 && h.poolRkey == 0;
+}
+// The hold start of `dead` (gdakiCtrlPeerToErr): this rank's side of the store's upload QP of ward `dead` goes to ERR when
+// this rank is dead's buddy (the dead rank owned that ward: a late WRITE of the dead process lands nowhere from then on;
+// its stable slot stays for the FETCH QP). buddyOfDead: gdakiHoldBuddyOf(dead, n).
+static inline bool gdakiCtrlStoreWardErrDue(int me, int n, int dead, int buddyOfDead) {
+  return n >= 2 && dead >= 0 && dead < n && dead != me && buddyOfDead == me;
+}
+// ---- the host memory this path adds per rank (design v3 3.5; reported, not bounded: the 2026-10-17 decision) ----
+// staging: the upload's pinned buffer (one slot of this rank's image); wards: per ward, the store MR's two slots (this
+// rank's image size when the ward's is not known: the test cells' p xor 1 pairs are alike); control: phase 2a-1's ring
+// (receive and send slots per rank, UD buffers, the outbox, its READ stage, two words' pages) and phase 1's page.
+struct gdakiCtrlStoreMem {
+  uint64_t staging = 0, wards = 0, control = 0, total = 0;
+};
+static inline struct gdakiCtrlStoreMem gdakiCtrlStoreMemOf(int nranks, uint64_t ownImage, uint64_t wardImage, int nWards,
+                                                           bool ring) {
+  struct gdakiCtrlStoreMem m;
+  m.staging = ownImage ? gdakiStoreSlotBytes(ownImage) : 0;
+  m.wards = wardImage ? (uint64_t)std::max(0, nWards) * 2u * gdakiStoreSlotBytes(wardImage) : 0;
+  if (ring)
+    m.control = 2u * (uint64_t)std::max(0, nranks) * GDAKI_CTRL_RING_SLOTS * GDAKI_CTRL_SLOT_BYTES +
+                (uint64_t)GDAKI_CTRL_UD_RQ * (GDAKI_CTRL_UD_GRH_BYTES + GDAKI_CTRL_SLOT_BYTES) +
+                (uint64_t)GDAKI_CTRL_UD_SQ * GDAKI_CTRL_SLOT_BYTES + GDAKI_CTRL_OUTBOX_BYTES + GDAKI_CTRL_OUTBOX_HALF_BYTES +
+                2u * 4096u + GDAKI_CTRL_PAGE_BYTES;
+  m.total = m.staging + m.wards + m.control;
+  return m;
+}
+// ---- gin-control (store): pure (end) ----
+
+// ---- gin-control (store): host ----
+static bool gdakiStoreActV2(struct gdakiRecHost* r) { return gdakiCtrlStoreActV2Of(gdakiMiOn(r), gdakiStoreOn(r)); }
+// STATE and the rkey list through the pair's outbox (phase 2a-2-C step 3): the way, the steps and the transfers are the
+// live seams' (gdakiCtrlStateWayOf, gdakiCtrlStateSurvivorTurn, gdakiCtrlStateSpareTurn, gdakiCtrlRkeysSpareTurn; the
+// region "gin-control (ring): live seams" below); here the host's parts: the survivor's log export and the rkeys into
+// the hold, the spare's bounds.
+static struct gdakiCtrlRing* gdakiCtrlStateRingOf(struct gdakiRecHost* r, int peer, bool spare, uint32_t inc);
+static int gdakiCtrlStateSurvivorTurn(struct gdakiRecHost* r, int p, uint32_t inc,
+                                      bool (*ex)(void* arg, uint64_t ckpt, std::vector<uint8_t>* x, char* why, size_t whyLen),
+                                      void* exArg, struct gdakiRsRkeys* keys, char* why, size_t whyLen);
+static int gdakiCtrlStateSpareTurn(struct gdakiRecHost* r, int peer, uint32_t inc, uint64_t step, std::vector<uint8_t>* x,
+                                   char* why, size_t whyLen);
+static int gdakiCtrlRkeysSpareTurn(struct gdakiRecHost* r, int peer, const struct gdakiRsRkeys& keys, char* why,
+                                   size_t whyLen);
+static void gdakiCtrlRingNap(struct gdakiCtrlRing* g, int ms);
+struct gdakiCtrlStateExportArg {
+  struct gdakiRecHost* r;
+  int p;
+  uint32_t inc;
+};
+// The survivor's log export of checkpoint K toward spare p (2b's text: the confirmed cut, the export of the mirror's or
+// gin-restore's log, inside gdakiTsBusy).
+static bool gdakiCtrlStateExport(void* arg, uint64_t ckpt, std::vector<uint8_t>* x, char* why, size_t whyLen) {
+  const struct gdakiCtrlStateExportArg* e = (const struct gdakiCtrlStateExportArg*)arg;
+  struct gdakiRecHost* r = e->r;
+  struct gdakiCkpt* ck = gdakiCkptOf(r);
+  struct gdakiHoldPeer& hp = r->hold->peers[e->p];
+  const struct gdakiCkptCut<struct gdakiCkptCutRec>* cut = ck != nullptr ? ck->peers[e->p].cuts.find(ckpt) : nullptr;
+  if (cut == nullptr) {
+    snprintf(why, whyLen, "no confirmed cut toward the peer for checkpoint %lu here", (unsigned long)ckpt);
+    return false;
+  }
+  gdakiTsBusy busy(r->ts);
+  char w[256] = {0};
+  if ((gdakiMiOn(r) ? gdakiMiLogExport : gdakiRsLogExport)(r, e->p, ckpt, cut->rec.pause.head, hp.headAtHold, e->inc,
+                                                         hp.xAtHold, hp.mAtHold, hp.nqp, gdakiCkptPutVec, x, w,
+                                                         sizeof(w)) != ncclSuccess) {
+    snprintf(why, whyLen, "the log export failed: %.120s", w);
+    return false;
+  }
+  return true;
+}
+// The survivor's turn (gdakiHoldTransferStep): 2 the data socket (the caller's), 1 not yet (the hold's deadline bounds
+// the wait, as ln4's), 0 done (hp.rkeys set), -1 failed (why). Never blocks.
+static int gdakiCtrlStateSurvivorStep(struct gdakiRecHost* r, int p, char* why, size_t whyLen) {
+  struct gdakiCtrlStateExportArg e;
+  e.r = r;
+  e.p = p;
+  e.inc = gdakiLnOf(r, p).cur;  // the successor's (HOLD_SUCC), as ln4's ask names it
+  struct gdakiRsRkeys keys;
+  const int k = gdakiCtrlStateSurvivorTurn(r, p, e.inc, gdakiCtrlStateExport, &e, &keys, why, whyLen);
+  if (k == 0) {
+    struct gdakiHoldPeer& hp = r->hold->peers[p];
+    delete hp.rkeys;
+    hp.rkeys = new gdakiRsRkeys(std::move(keys));
+  }
+  return k;
+}
+// The spare's turn with survivor `peer` (gdakiCkptSpareDataFd, after the FETCH): -2 the data socket, else as ln4's:
+// GDAKI_CTRL_XFER_NOFD (the export kept in d->exports[peer]; the rkey list goes back through the outbox,
+// gdakiCtrlRkeysHandOver) or -1. The step answers "not yet" until the ring is up in the REJOIN's generation and the
+// STATE is whole; this loop bounds it by the spare's timeout (no helper runs yet in this process).
+static int gdakiCtrlStateSpareTake(struct gdakiCkptSpareData* d, int peer) {
+  struct gdakiRecHost* r = d->r;
+  const int me = r->ctx->rank;
+  const uint64_t step = d->step != nullptr ? *d->step : 0;
+  const uint32_t inc = gdakiRsPeerInc(r, me);
+  const double deadline = gdakiQ4MonoMs() + std::max(1, d->timeoutMs);
+  std::vector<uint8_t>& x = d->exports[(size_t)peer];
+  char w[256] = {0};
+  while (true) {
+    const int k = gdakiCtrlStateSpareTurn(r, peer, inc, step, &x, w, sizeof(w));
+    if (k == 2) return -2;
+    if (k == 0) return GDAKI_CTRL_XFER_NOFD;
+    if (k < 0 || gdakiQ4MonoMs() >= deadline) {
+      x.clear();
+      WARN("GIN/CTRL: spare rank %d: the state transfer with rank %d over the outbox failed: %s", me, peer,
+           k < 0 ? w : "not done within the spare's bound (the ring not up in the REJOIN's generation, or no STATE)");
+      return -1;
+    }
+    gdakiCtrlRingNap(r->ctrl->ring, 1);
+  }
+}
+// The spare's rkey list to survivor `peer`: the outbox when its STATE came that way (dfd GDAKI_CTRL_XFER_NOFD), else
+// ln4's data socket.
+static ncclResult_t gdakiCtrlRkeysHandOver(struct gdakiRecHost* r, int peer, int dfd, const struct gdakiRsRkeys& keys,
+                                           int timeoutMs) {
+  if (dfd != GDAKI_CTRL_XFER_NOFD) return gdakiRsRkeysSend(dfd, keys, timeoutMs);
+  struct gdakiCtrlRing* g = gdakiCtrlStateRingOf(r, peer, true, gdakiRsPeerInc(r, r->ctx->rank));
+  if (g == nullptr) return ncclSystemError;  // the pair's ring went away after STATE
+  const double deadline = gdakiQ4MonoMs() + std::max(1, timeoutMs);
+  char w[200] = {0};
+  while (true) {
+    const int k = gdakiCtrlRkeysSpareTurn(r, peer, keys, w, sizeof(w));
+    if (k == 0) return ncclSuccess;
+    if (k < 0 || gdakiQ4MonoMs() >= deadline) {
+      WARN("GIN/CTRL: spare rank %d: its rkey list to rank %d over the outbox failed: %s", r->ctx->rank, peer,
+           k < 0 ? w : "not READ within the bound");
+      return ncclSystemError;
+    }
+    gdakiCtrlRingNap(g, 1);
+  }
+}
+// gdakiStoreWardToErr's work (the hold start's hook, the helper): a job for the store thread, which owns the ward's QP.
+// Never creates the store state (a process that has none has no ward QP); idempotent (the thread skips a QP in ERR).
+static void gdakiCtrlStoreWardToErrAsk(struct gdakiRecHost* r, int peer) {
+  if (r == nullptr || r->ctx == nullptr || !gdakiStoreOn(r)) return;
+  struct gdakiStoreState* st;
+  {
+    std::lock_guard<std::mutex> lk(gdakiStoreLifeMu);
+    st = r->mi.store;
+  }
+  if (st == nullptr || !gdakiCtrlStoreWardErrDue(st->me, st->n, peer, gdakiHoldBuddyOf(peer, st->n))) return;
+  {
+    std::lock_guard<std::mutex> lk(st->mu);
+    if (st->stop) return;
+    struct gdakiStoreJob j;
+    j.kind = GDAKI_CTRL_STORE_JOB_WARD_ERR;
+    j.d = peer;
+    st->jobs.push_back(j);
+  }
+  st->cv.notify_all();
+}
+// The store thread: ward d's upload QP (this rank's side) to ERR. The record, the MRs and the stable slot stay; the next
+// STORE_REQ of d's successor replaces the QP (gdakiStoreServe destroys the old one first).
+static void gdakiCtrlStoreWardErrRun(struct gdakiRecHost* r, struct gdakiStoreState* st, int d) {
+  if (d < 0 || d >= st->n) return;
+  struct gdakiMiHostQp* q = st->wards[(size_t)d].qp;
+  if (q == nullptr || q->qp == nullptr || q->err) return;
+  struct ibv_qp_attr a;
+  memset(&a, 0, sizeof(a));
+  a.qp_state = IBV_QPS_ERR;
+  const bool moved = wrap_ibv_modify_qp(q->qp, &a, IBV_QP_STATE) == ncclSuccess;
+  q->err = true;  // either way never used again: the next request of the ward destroys it
+  GIN_TS_NOTE("GIN/CTRL: rank %d: the store's upload QP of ward rank %d (qpn %#x) %s at its hold start mono_ms=%.3f", st->me,
+              d, q->qp->qp_num, moved ? "moved to ERR" : "could not be moved to ERR (it is not used again)",
+              gdakiQ4MonoMs());
+  (void)r;
+}
+// The host memory line (gdakiStoreUpStep, after a request with a new image size went out; once per size).
+static void gdakiCtrlStoreMemLine(struct gdakiRecHost* r, struct gdakiStoreState* st, uint64_t image, uint64_t slotBytes) {
+  if (st == nullptr || image == 0 || st->ctrlMemImage == image) return;
+  st->ctrlMemImage = image;
+  int nWards = 0;
+  for (int p = 0; p < st->n; p++)
+    if (p != st->me && gdakiHoldBuddyOf(p, st->n) == st->me) nWards++;
+  const bool ring = r->ctrl != nullptr && r->ctrl->ring != nullptr;  // null: no ring in this context
+  const struct gdakiCtrlStoreMem m = gdakiCtrlStoreMemOf(st->n, image, image, nWards, true);
+  const double MiB = 1048576.0;
+  GIN_TS_NOTE("GIN/CTRL: rank %d: host memory added (decision 7, mirror %s): staging %.1f MiB (pinned, slot %lu bytes), "
+              "ward stores %d x 2 slots %.1f MiB, control %.1f MiB (%s), total %.1f MiB = 3 x image + %.1f MiB, image %.1f MiB "
+              "(reported, no bound); device staging %.1f MiB (GPU memory, the pause's snapshot; 0 with the mirror on) "
+              "mono_ms=%.3f", st->me, gdakiMiOn(r) ? "on" : "off", m.staging / MiB,
+              (unsigned long)slotBytes, nWards, m.wards / MiB, m.control / MiB, ring ? "ring up" : "ring not made yet",
+              m.total / MiB, (m.total - 3.0 * (double)image) / MiB, image / MiB,
+              gdakiSnapDevBytes(gdakiMiOn(r), image) / MiB, gdakiQ4MonoMs());
+}
+#endif  // !NCCL_GIN_CTRL_TCP
+// ==== gin-control (store): decision 7 and the outbox transfers (end) ====
+// ==== gin-control (ring): live seams (begin; phase 2a-2-B, impl/gc_unit_p2a2.cc compiles this region on the CPU) ====
+// The swap points' answers by the pair's path (EXPERIMENT.md 9.1 "링과 흐름 제어", "차례와 잃음의 뜻"; design v3 2.2-2.4;
+// phase 2a-2-C: the path marker's order rule, the model's "the pair's path"), the witness's socket while the ring carries
+// the records, the switch to live (every gated pair's path to the ring), the re-pairing after a local ERR, the test
+// switches QP_ERR and CREDIT_STALL (DROP_UD is the UD send's) and the witness socket's DIE_RST, RST_GAP, FD_HOLDER
+// (2a-2-C), and the teardown's summary lines.
+// The helper's thread (the setup thread before it starts; the ring is never live there).
+#if !NCCL_GIN_CTRL_TCP
+static_assert(GDAKI_CTRL_PAGE_MAX_RANKS <= GDAKI_CTRL_TCP_COUNT_PEERS, "the TCP counters cover every rank of a page");
+static_assert(sizeof(struct gdakiCtrlPathRec) == sizeof(struct gdakiTsMsg) &&
+                  sizeof(struct gdakiCtrlPathMark) <= sizeof(((struct gdakiTsMsg*)nullptr)->executed),
+              "a held record is a record; the marker fits a record's executed[]");
+static struct gdakiCtrlRing* gdakiCtrlRingLive(struct gdakiRecHost* r) {
+  struct gdakiCtrlRing* g = (r != nullptr && r->ctrl != nullptr) ? r->ctrl->ring : nullptr;
+  return (g != nullptr && g->live) ? g : nullptr;
+}
+// The pair's path state (phase 2a-2-C): every pair of a context with a ring; null: no ring (the TCP back end alone).
+static struct gdakiCtrlPathSt* gdakiCtrlPathOf(struct gdakiRecHost* r, int peer) {
+  struct gdakiCtrlRing* g = (r != nullptr && r->ctrl != nullptr) ? r->ctrl->ring : nullptr;
+  if (g == nullptr || peer < 0 || peer >= g->nranks || peer == g->me) return nullptr;
+  return &g->peers[(size_t)peer].path;
+}
+static bool gdakiCtrlRingLiveOn(struct gdakiRecHost* r, int peer) {
+  const struct gdakiCtrlPathSt* s = gdakiCtrlPathOf(r, peer);
+  return s != nullptr && s->txPath == GDAKI_CTRL_PM_RING;
+}
+// This side's records to `peer` go on `path` from now: a new path generation whose marker carries the old path's count.
+// The switch to live does it for every gated pair; a run-time switch to the socket is a follow-up (the per-pair choice,
+// the marker and the order rule are here). False: no ring, or the records already go there.
+static bool gdakiCtrlPathSet(struct gdakiRecHost* r, int peer, uint32_t path) {
+  struct gdakiCtrlPathSt* s = gdakiCtrlPathOf(r, peer);
+  return s != nullptr && gdakiCtrlPathSwitch(s, path);
+}
+// A record QP's cause (the ring pump's -1: "QP:NEWGEN", "QP:<the ring's cause>"): a lost connection of the record
+// channel, never evidence about the peer's process (design v3 2.4: not a liveness input).
+static bool gdakiCtrlCauseIsQp(const char* cause) { return cause != nullptr && strncmp(cause, "QP:", 3) == 0; }
+static void gdakiCtrlTcpCount(struct gdakiRecHost* r, int peer, uint32_t ch, bool rx, int rc) {
+  if (r == nullptr) return;
+  const int e = errno;  // the callers read errno after a failed send
+  const uint64_t n = (uint64_t)sizeof(struct gdakiTsMsg);
+  if (rx) {
+    if (rc == 1 && peer >= 0 && peer < GDAKI_CTRL_TCP_COUNT_PEERS)
+      r->ctrlTcp.rxPeer[peer].fetch_add(n, std::memory_order_relaxed);
+  } else if (rc == 0) {
+    (ch == GDAKI_CTRL_CH_DATA ? r->ctrlTcp.dataBytes : r->ctrlTcp.recordBytes).fetch_add(n, std::memory_order_relaxed);
+    if (r->ctrlTcp.live.load(std::memory_order_acquire))
+      (ch == GDAKI_CTRL_CH_DATA ? r->ctrlTcp.dataBytesLive : r->ctrlTcp.recordBytesLive).fetch_add(n, std::memory_order_relaxed);
+  }
+  errno = e;
+}
+// The receive side's one line per switch: the pending generation taken without all of the old path's counted records
+// (closed, waited, newer), or the first old-path record dropped after a switch (any why).
+static void gdakiCtrlPathLine(struct gdakiRecHost* r, int peer, struct gdakiCtrlPathSt* s, uint32_t why, bool drop,
+                              uint32_t dropPath, uint32_t dropGen) {
+  if (s->lineGen == s->rxGen || (!drop && (why == GDAKI_CTRL_PM_W_NONE || why == GDAKI_CTRL_PM_W_ALL))) return;
+  s->lineGen = s->rxGen;
+  const int me = r->ctrl->ring->me;
+  if (drop)
+    GIN_TS_NOTE("GIN/RC: rank %d: rank %d's records: a %s record of path gen %u dropped after the switch to the %s path "
+                "(gen %u; %s: %llu of %llu %s record(s) taken); the old paths' later records are dropped too mono_ms=%.3f",
+                me, peer, gdakiCtrlPathName(dropPath), dropGen, gdakiCtrlPathName(s->rxPath), s->rxGen,
+                gdakiCtrlPathWhyName(s->lastWhy), (unsigned long long)s->lastTaken, (unsigned long long)s->lastBefore,
+                gdakiCtrlPathName(s->lastFromPath), gdakiQ4MonoMs());
+  else
+    GIN_TS_NOTE("GIN/RC: rank %d: rank %d's records: the %s path (gen %u) taken with %llu of %llu %s record(s) (%s); the "
+                "old path's later records are dropped mono_ms=%.3f", me, peer, gdakiCtrlPathName(s->rxPath), s->rxGen,
+                (unsigned long long)s->lastTaken, (unsigned long long)s->lastBefore, gdakiCtrlPathName(s->lastFromPath),
+                gdakiCtrlPathWhyName(why), gdakiQ4MonoMs());
+}
+// One record that came on `path` (gen, before: its marker's) through the order rule: 1 handed out in *io (a ready one
+// first: then *io is the oldest ready record and this one waits behind it), 0 held or dropped. A ring record without a
+// marker is outside the rule (handed out).
+static int gdakiCtrlPathInRec(struct gdakiRecHost* r, int peer, struct gdakiCtrlPathSt* s, uint32_t path, uint32_t gen,
+                              uint64_t before, struct gdakiTsMsg* io) {
+  uint32_t why = GDAKI_CTRL_PM_W_NONE;
+  const uint32_t v = gdakiCtrlPathIn(s, path, gen, before, io, gdakiQ4MonoMs(), &why);
+  gdakiCtrlPathLine(r, peer, s, why, false, 0, 0);
+  if (v == GDAKI_CTRL_PM_HOLD) return 0;
+  if (v == GDAKI_CTRL_PM_DROP) {
+    gdakiCtrlPathLine(r, peer, s, GDAKI_CTRL_PM_W_NONE, true, path, gen);
+    return 0;
+  }
+  if (!s->ready.empty()) {
+    s->ready.emplace_back();
+    memcpy(s->ready.back().b, io, sizeof(*io));
+    memcpy(io, s->ready.front().b, sizeof(*io));
+    s->ready.pop_front();
+  }
+  return 1;
+}
+// The receive path is closed (the rule's second way out): the ring's connection not up, or no socket.
+static bool gdakiCtrlPathRxClosed(const struct gdakiCtrlRing* g, int peer, const struct gdakiTsPeer& pe,
+                                  const struct gdakiCtrlPathSt* s) {
+  if (s->rxPath == GDAKI_CTRL_PM_RING) return !gdakiCtrlRingUp(&g->peers[(size_t)peer].ring);
+  return pe.fd < 0 || pe.gone;
+}
+// The rule's steps (and their lines), then the oldest ready record (1), if any. rxClosed is the receive path's before the
+// first switch (a later one's old path is the one switched to: the ring's state, or no socket).
+static int gdakiCtrlPathReadyOut(struct gdakiRecHost* r, int peer, struct gdakiCtrlPathSt* s, bool rxClosed,
+                                 struct gdakiTsMsg* out) {
+  for (uint32_t why; (why = gdakiCtrlPathStep(s, rxClosed, gdakiQ4MonoMs())) != GDAKI_CTRL_PM_W_NONE; rxClosed = false)
+    gdakiCtrlPathLine(r, peer, s, why, false, 0, 0);
+  if (s->ready.empty()) return 0;
+  memcpy(out, s->ready.front().b, sizeof(*out));
+  s->ready.pop_front();
+  return 1;
+}
+// The peer's socket for the rule: 1 a record in *out (its bytes counted), 0 nothing (or no socket), -1 FIN or an error
+// (pe.closeCause, ln4's). A marker record is taken here (the socket stream's generation, its announcement) and never
+// handed out.
+static int gdakiCtrlPathSockRead(struct gdakiRecHost* r, int peer, struct gdakiCtrlPathSt* s, struct gdakiTsPeer& pe,
+                                 struct gdakiTsMsg* out) {
+  while (true) {
+    if (pe.fd < 0) return 0;
+    const int k = gdakiTsPump(pe, out);
+    if (k <= 0) return k;
+    gdakiCtrlTcpCount(r, peer, GDAKI_CTRL_CH_RECORD, true, 1);
+    if (out->type != GDAKI_TS_CTRL_PATH) return 1;
+    struct gdakiCtrlPathMark m;
+    memcpy(&m, out->executed, sizeof(m));
+    gdakiCtrlPathLine(r, peer, s, gdakiCtrlPathSockMark(s, m, gdakiQ4MonoMs()), false, 0, 0);
+  }
+}
+// The ring's next record of the pair with its marker (gdakiCtrlRdmaRecv; counted), its -1's cause in `cause`.
+static int gdakiCtrlRingPumpMark(struct gdakiCtrlRing* g, int peer, struct gdakiTsMsg* out, struct gdakiCtrlPathMark* mk,
+                                 char* cause, size_t clen) {
+  struct gdakiCtrlRdmaPeer& pr = g->peers[(size_t)peer];
+  memset(mk, 0, sizeof(*mk));
+  const int k = gdakiCtrlRdmaRecv(g, peer, out, cause, clen, mk);
+  if (k == 1) pr.rxRecords++;
+  if (k < 0) pr.lossEvents++;
+  return k;
+}
+// ---- the REJOIN over UD (phase 2a-2-C; design v3 5.4 5, EXPERIMENT.md 9.5 (5)) ----
+// The spare's REJOIN (record 32) and the survivor's REJOIN_ACK (33) go over the UD context QP, the new endpoints in nrp
+// (gdakiCtrlNrpPut/Get): the REJOIN carries the spare's record QP (INIT, its RECVs posted, a fresh PSN), its liveness
+// READ QP (its watch thread's PREPARE), its UD QP, page and outbox and the two generations it starts; the REJOIN_ACK the
+// survivor's two QPs (RTS toward those), its UD QP, page and outbox. Both pairings are the model's with the REJOIN as
+// their PAIR: the survivor TAKEs both (its record QP RTS at once, its PAIR_ACKs over UD as in any pairing), the spare's
+// are STARTED by its REJOIN (no PAIR or resend of their own: the REJOIN's resend covers them) and CONNECT on the
+// REJOIN_ACK (or on a PAIR_ACK that came first); the record QP's CONNECTED goes first and the survivor sends nothing on it
+// before (its records wait in the queue). An answer that does not take the REJOIN is a FAIL record over UD with arg
+// GDAKI_CTRL_RJA_FAIL (the spare stops), _WAIT or _REFUSE (told as TCP told them with a FIN: the spare sends the REJOIN
+// again). The REJOIN's generations are (incarnation << 20) + 1, above every generation of the pair's older incarnations
+// (fewer than 2^20 re-pairings each). After it the pair's path starts afresh on both sides with the records on the ring.
+#define GDAKI_CTRL_RJ_RESEND_MS 200.0  // the spare's REJOIN again when nothing took it (ln4's 200 ms re-dial)
+#define GDAKI_CTRL_RJ_PARK_MS 1000.0   // a parked REJOIN nobody took (ln4's park limit)
+#define GDAKI_CTRL_RJ_ACC_TRIES 3u     // REVIEW_INT3 F3: the acceptance's liveness READ QP CONNECT, tries in a resend interval
+// REVIEW_INT3 nit 4: 32 bits hold incarnations below 4 096 (inc << 20); this study's restores stay far below.
+static inline uint32_t gdakiCtrlRjGenOf(uint32_t inc) { return (inc << 20) + 1u; }
+static inline const char* gdakiCtrlRjaName(uint32_t a) {
+  return a == GDAKI_CTRL_RJA_WAIT ? "WAIT" : a == GDAKI_CTRL_RJA_REFUSE ? "REFUSE" : "FAIL";
+}
+static struct gdakiCtrlRing* gdakiCtrlRjRing(struct gdakiRecHost* r, int peer) {
+  struct gdakiCtrlRing* g = (r != nullptr && r->ctrl != nullptr) ? r->ctrl->ring : nullptr;
+  if (g == nullptr || r->ts == nullptr || peer < 0 || peer >= g->nranks || peer == g->me ||
+      peer >= (int)r->ts->peers.size())
+    return nullptr;
+  return g;
+}
+// The REJOIN toward `peer` goes over UD: a ring that agreed and is bound to the status page, the peer's UD endpoint, its
+// liveness READ QP (the REJOIN carries it).
+static bool gdakiCtrlRjUd(struct gdakiRecHost* r, int peer) {
+  const struct gdakiCtrlRing* g = gdakiCtrlRjRing(r, peer);
+  if (g == nullptr || !g->setup.agreed || g->setup.verdict != 0 || g->setup.spareDiffers || !g->bound ||
+      !g->pairingStarted)
+    return false;
+  const struct gdakiCtrlPage* pg = gdakiPageOf(r);
+  return g->peers[(size_t)peer].haveUd && gdakiPageUp(pg) && (size_t)peer < pg->peers.size() &&
+         pg->peers[(size_t)peer].hasQp;
+}
+// The spare's REJOIN to `peer` takes UD: its QPs were prepared for it (gdakiCtrlRjSpareBegin).
+static bool gdakiCtrlRjSpareUd(struct gdakiRecHost* r, int peer) {
+  const struct gdakiCtrlRing* g = gdakiCtrlRjRing(r, peer);
+  return g != nullptr && g->peers[(size_t)peer].rj.state != GDAKI_CTRL_RJS_IDLE && gdakiCtrlRjUd(r, peer);
+}
+// One record to `peer`'s UD QP (envelope kind RECORD, gen 0): 0 posted (or dropped by DROP_UD, as if lost).
+static int gdakiCtrlRjUdRec(struct gdakiCtrlRing* g, int peer, struct gdakiTsMsg* m) {
+  m->magic = GDAKI_TS_MAGIC;
+  return gdakiCtrlRdmaUdSend(g, peer, GDAKI_CTRL_K_RECORD, 0, m, (uint32_t)sizeof(*m));
+}
+// This side's endpoints for a REJOIN or REJOIN_ACK's nrp (its record QP and liveness READ QP of the pair, UD, regions).
+static struct gdakiCtrlRejoinNrp gdakiCtrlRjNrpOf(struct gdakiCtrlRing* g, int peer, uint32_t gen, uint32_t probeGen) {
+  const struct gdakiCtrlRdmaPeer& pr = g->peers[(size_t)peer];
+  struct gdakiCtrlRejoinNrp n;
+  memset(&n, 0, sizeof(n));
+  n.version = GDAKI_CTRL_NRP_VERSION;
+  n.gen = gen;
+  n.probeGen = probeGen;
+  n.rec = pr.local;
+  n.probe = pr.prb.local;
+  n.ud = g->udLocal;
+  n.page = gdakiCtrlRdmaPageRegion(g);
+  n.outbox = gdakiCtrlRdmaOutboxRegion(g);
+  return n;
+}
+// A pairing body of `peer` from a REJOIN's or REJOIN_ACK's nrp (the model's datagram for the REJOIN's pairings).
+static struct gdakiCtrlPairBody gdakiCtrlRjBodyOf(const struct gdakiCtrlRing* g, int peer, uint32_t kind, uint32_t step,
+                                                  uint32_t inc, const struct gdakiCtrlRejoinNrp& n) {
+  struct gdakiCtrlPairBody b;
+  memset(&b, 0, sizeof(b));
+  b.qpKind = kind;
+  b.step = step;
+  b.gen = kind == GDAKI_CTRL_PAIR_QP_PROBE ? n.probeGen : n.gen;
+  b.incarnation = inc;
+  b.from = peer;
+  b.to = g->me;
+  b.nonce = g->nonce;
+  b.qp = kind == GDAKI_CTRL_PAIR_QP_PROBE ? n.probe : n.rec;
+  b.ud = gdakiCtrlEndpointOk(n.ud) ? n.ud : g->peers[(size_t)peer].remoteUd;
+  b.page = n.page;
+  b.outbox = n.outbox;
+  return b;
+}
+// The spare's REJOIN pairing of one kind: STARTED in `gen` with no resend and no bound of its own.
+static void gdakiCtrlRjPairStarted(struct gdakiCtrlPairSt* s, uint32_t gen, double nowMs) {
+  s->state = GDAKI_CTRL_PS_STARTED;
+  s->mine = gen;
+  if (gen > s->lastMine) s->lastMine = gen;
+  s->startMs = nowMs;
+  s->nextMs = s->boundMs = 1e300;
+  s->pairsSent++;
+}
+// The survivor's answer to a REJOIN it does not take (FAIL, WAIT, REFUSE): a FAIL record with that arg to the REJOIN's
+// sender over UD (WAIT and REFUSE with one line). False: no UD way to it (the caller's TCP answer stands).
+static bool gdakiCtrlRjAnswer(struct gdakiRecHost* r, int peer, uint64_t round, uint32_t code, uint32_t pad) {
+  struct gdakiCtrlRing* g = gdakiCtrlRjRing(r, peer);
+  if (g == nullptr || !g->peers[(size_t)peer].haveUd) return false;
+  struct gdakiTsMsg a;
+  memset(&a, 0, sizeof(a));
+  a.type = GDAKI_TS_FAIL;
+  a.from = g->me;
+  a.arg = (int32_t)code;
+  a.round = round;
+  a.nonce = r->ts->nonce;
+  a.pad = pad;
+  g->peers[(size_t)peer].rj.answers++;
+  const int k = gdakiCtrlRjUdRec(g, peer, &a);
+  if (code != GDAKI_CTRL_RJA_FAIL)
+    GIN_TS_NOTE("GIN/RC: rank %d: answered a REJOIN of rank %d with %s over UD%s mono_ms=%.3f", g->me, peer,
+                gdakiCtrlRjaName(code), k == 0 ? "" : " (the post failed)", gdakiQ4MonoMs());
+  return true;
+}
+// The REJOIN table at the hold start of `peer` (gdakiCtrlPeerToErr): its REJOINs are the existing rule's from now; a
+// parked one and an acceptance in progress are an older hold's.
+static void gdakiCtrlRjOnHoldStart(struct gdakiRecHost* r, int peer) {
+  struct gdakiCtrlRing* g = gdakiCtrlRjRing(r, peer);
+  if (g == nullptr) return;
+  struct gdakiCtrlRdmaPeer& pr = g->peers[(size_t)peer];
+  gdakiCtrlRejoinHold(&pr.rejoin, peer);
+  pr.rj.parked = pr.rj.accStarted = pr.rj.accProbeAsked = pr.rj.accRecOn = false;
+}
+// The survivor's UD intake (the helper's step after the ring's poll; a process that asks for the restore): every REJOIN
+// in udIn, by ln4's listen-socket rules and the REJOIN table: another context's, an ungated rank's or one without its
+// endpoints is dropped; a repeat of the accepted one gets the stored REJOIN_ACK again (the QPs untouched), another QPN
+// pair of it is dropped (one GIN/LN line per pair), an older incarnation too; a declined rank gets FAIL; a rank that is not
+// HELD gets WAIT; the rest is parked for the hold's acceptance (a newer one replaces it).
+static void gdakiCtrlRjIntake(struct gdakiRecHost* r) {
+  struct gdakiCtrlRing* g = (r != nullptr && r->ctrl != nullptr) ? r->ctrl->ring : nullptr;
+  if (g == nullptr || r->ts == nullptr || g->udIn.empty() || !gdakiRsRequested()) return;
+  for (auto it = g->udIn.begin(); it != g->udIn.end();) {
+    uint32_t type = 0;
+    memcpy(&type, it->body + 4, 4);
+    const int from = it->from;
+    if (it->env.kind != GDAKI_CTRL_K_RECORD || type != GDAKI_TS_RS_REJOIN || from < 0 || from >= g->nranks) {
+      ++it;
+      continue;
+    }
+    struct gdakiTsMsg m;
+    memcpy(&m, it->body, sizeof(m));
+    struct gdakiCtrlRdmaPeer& pr = g->peers[(size_t)from];
+    if (pr.udInN > 0) pr.udInN--;
+    it = g->udIn.erase(it);
+    pr.rj.intake++;
+    struct gdakiCtrlRejoinNrp n;
+    if (m.from != from || m.nonce != r->ts->nonce || from >= (int)r->ts->peers.size() || !r->ts->peers[(size_t)from].gated ||
+        !gdakiCtrlNrpGet(m.nrp, sizeof(m.nrp), &n) || !gdakiCtrlRejoinNrpOk(n, false)) {
+      pr.rj.bad++;
+      continue;
+    }
+    bool log = false;
+    const uint32_t v = gdakiCtrlRejoinOn(&pr.rejoin, from, m.pad, n.rec.qpn, n.probe.qpn, &log);
+    if (v == GDAKI_CTRL_RJ_REPEAT) {  // its REJOIN_ACK was lost: the stored one again
+      struct gdakiTsMsg a;
+      memcpy(&a, pr.rejoin.ack, sizeof(a));
+      pr.rj.repeats++;
+      (void)gdakiCtrlRjUdRec(g, from, &a);
+      continue;
+    }
+    if (v == GDAKI_CTRL_RJ_DROP_QPN || v == GDAKI_CTRL_RJ_DROP_OLD) {
+      pr.rj.dropped++;
+      if (log)
+        WARN(GDAKI_LN_HEAD "rank %d: a REJOIN of rank %d's incarnation %u with record QPN %u and liveness READ QPN %u is "
+             "dropped: that incarnation was taken with QPNs %u and %u (never FAIL for a stray datagram) mono_ms=%.3f",
+             g->me, from, m.pad, n.rec.qpn, n.probe.qpn, pr.rejoin.qpn, pr.rejoin.probeQpn, gdakiQ4MonoMs());
+      continue;
+    }
+    gdakiCtrlRdmaSetUd(g, from, n.ud);  // the answer's way: the spare's UD QP
+    if (r->ts->peers[(size_t)from].declined) {
+      gdakiCtrlRejoinFail(r, -1, from, m.round, "REJOIN");  // the FAIL-on-reconnect rule, over UD
+      continue;
+    }
+    if (v == GDAKI_CTRL_RJ_NOT_HELD) {
+      (void)gdakiCtrlRjAnswer(r, from, m.round, GDAKI_CTRL_RJA_WAIT, m.pad);
+      continue;
+    }
+    pr.rj.parked = true;
+    pr.rj.parkedMs = gdakiQ4MonoMs();
+    pr.rj.park = m;
+  }
+}
+// The REJOIN the intake parked for `peer` (gdakiRsRejoinAccept, the hold's acceptance): taken once; one older than the
+// park limit is dropped (the spare sends it again).
+static bool gdakiCtrlRjParkedTake(struct gdakiRecHost* r, int peer, struct gdakiTsMsg* m) {
+  struct gdakiCtrlRing* g = gdakiCtrlRjRing(r, peer);
+  if (g == nullptr || !g->peers[(size_t)peer].rj.parked) return false;
+  struct gdakiCtrlRjSt& j = g->peers[(size_t)peer].rj;
+  j.parked = false;
+  if (gdakiQ4MonoMs() - j.parkedMs > GDAKI_CTRL_RJ_PARK_MS) return false;
+  *m = j.park;
+  return true;
+}
+// The survivor's acceptance of REJOIN `m` once ln4's rules took it (gdakiRsRejoinAccept): the first call TAKEs both
+// pairings (gdakiCtrlRdmaOnRejoinAccepted first: the new incarnation's), drops what the dead incarnation left in the ring
+// (invariant 4) and starts the pair's path afresh: the record QP RTS toward the spare's at once, the liveness READ QP's
+// CONNECT asked of the watch thread; the REJOIN_ACK's nrp goes into *ack once that answer is there. 1 ready, 0 not yet
+// (call again: the same acceptance), -1 not taken (why: the caller answers REFUSE).
+// REVIEW_INT3 F3: a transient failure of the liveness READ QP's step (the watch thread did not take the CONNECT, or the
+// CONNECT failed) is tried again (GDAKI_CTRL_RJ_ACC_TRIES in all, 0 meanwhile); after the last, that pairing goes back
+// to where it was and -1. The record QP stays TAKEn for this REJOIN (the same spare's QP): the spare's next REJOIN goes on
+// from the liveness READ QP's step instead of meeting its own generation as "not above the pair's".
+static int gdakiCtrlRjAcceptStep(struct gdakiRecHost* r, int peer, const struct gdakiTsMsg& m, struct gdakiTsMsg* ack,
+                                 char* why, size_t whyLen) {
+  struct gdakiCtrlRing* g = gdakiCtrlRjRing(r, peer);
+  struct gdakiCtrlRejoinNrp n;
+  if (g == nullptr || !gdakiCtrlNrpGet(m.nrp, sizeof(m.nrp), &n) || !gdakiCtrlRejoinNrpOk(n, false)) {
+    snprintf(why, whyLen, "the REJOIN carries no endpoints of the spare (nrp)");
+    return -1;
+  }
+  struct gdakiCtrlRdmaPeer& pr = g->peers[(size_t)peer];
+  struct gdakiCtrlRjSt& j = pr.rj;
+  const struct gdakiCtrlProbeLinkCtx pc = gdakiCtrlRdmaProbeCtx(g);
+  const bool recKept = j.accRecOn && j.accInc == m.pad && j.accGen == n.gen && j.accRecQpn == n.rec.qpn &&
+                       j.accRecPsn == (n.rec.psn & 0xffffffu) && pr.pairRec.cur == n.gen;
+  if (!j.accStarted || j.accInc != m.pad || j.accGen != n.gen) {
+    const uint32_t recTop = std::max(pr.pairRec.cur, pr.pairRec.lastMine), prbTop = std::max(pr.prb.st.cur, pr.prb.st.lastMine);
+    if ((!recKept && n.gen <= recTop) || n.probeGen <= prbTop) {
+      snprintf(why, whyLen, "the REJOIN's generations (%u, %u) are not above the pair's (%u, %u)", n.gen, n.probeGen, recTop,
+               prbTop);
+      return -1;
+    }
+    j.accPrbWas = pr.prb.st;  // F3: where a final failure puts the liveness READ QP's pairing back
+    j.accPrbWasStarted = pr.prb.started;
+    j.accPrbWasInc = pr.prb.peerInc;
+    gdakiCtrlRdmaOnRejoinAccepted(g, peer, m.pad);
+    const double now = gdakiQ4MonoMs();
+    if (!recKept) {
+      const struct gdakiCtrlPairBody br = gdakiCtrlRjBodyOf(g, peer, GDAKI_CTRL_PAIR_QP_RECORD, GDAKI_CTRL_PAIR_STEP_PAIR, m.pad, n);
+      const uint32_t a = gdakiCtrlPairOnPair(&pr.pairRec, n.gen, m.pad, true, &n.rec, now);
+      gdakiCtrlRdmaPairAct(g, peer, a, &br);  // TAKE: the peer's UD and regions, a new generation, RTS, PAIR_ACK
+      if (a != GDAKI_CTRL_PA_TAKE || pr.ring.gen != n.gen || !pr.ring.rts) {
+        snprintf(why, whyLen, "the record QP could not be paired toward the spare's (gen %u)", n.gen);
+        return -1;
+      }
+      j.accRecOn = true;
+      j.accRecQpn = n.rec.qpn;
+      j.accRecPsn = n.rec.psn & 0xffffffu;
+      size_t left = 0;  // the dead incarnation's records and generation ends in the ring: dropped (invariant 4)
+      for (auto it = pr.ring.inbox.begin(); it != pr.ring.inbox.end();) {
+        if (it->env.gen == pr.ring.gen) {
+          ++it;
+          continue;
+        }
+        left += gdakiCtrlInIsEnd(*it) ? 0u : 1u;
+        it = pr.ring.inbox.erase(it);
+      }
+      if (left > 0)
+        WARN(GDAKI_LN_HEAD "rank %d: %zu record(s) of rank %d's dead incarnation still in the ring at the acceptance of its "
+             "incarnation %u: dropped mono_ms=%.3f", g->me, left, peer, m.pad, gdakiQ4MonoMs());
+      pr.path = gdakiCtrlPathSt();  // the new process's records: the pair's path starts afresh
+    }
+    const uint32_t ap = gdakiCtrlPairOnPair(&pr.prb.st, n.probeGen, m.pad, true, &n.probe, now);
+    if (ap != GDAKI_CTRL_PA_TAKE) {
+      const bool psn = pr.prb.st.havePsn;
+      const uint32_t lastPsn = pr.prb.st.lastPsn;
+      pr.prb.st = j.accPrbWas;
+      pr.prb.st.havePsn = psn;
+      pr.prb.st.lastPsn = lastPsn;
+      snprintf(why, whyLen, "the liveness READ QP's pairing did not take the REJOIN's (gen %u)", n.probeGen);
+      return -1;
+    }
+    if (struct gdakiCtrlPage* pgA = gdakiPageOf(r)) {  // smoke2 fix: the helper's firmware takes this incarnation's CONNECT
+      std::lock_guard<std::mutex> lk(pgA->mu);
+      if (peer < (int)pgA->peers.size()) pgA->peers[(size_t)peer].rjAccInc = m.pad;
+    }
+    j.accStarted = true;
+    j.accProbeAsked = false;
+    j.accInc = m.pad;
+    j.accGen = n.gen;
+    j.accTries = 0;
+    j.accNextMs = now;
+  }
+  // F3: the transient part, tried again while tries are left; the last failure puts the liveness READ QP's pairing back
+  auto again = [&](const char* what) -> int {
+    j.accProbeAsked = false;
+    if (j.accTries < GDAKI_CTRL_RJ_ACC_TRIES) {
+      j.accNextMs = gdakiQ4MonoMs() + GDAKI_CTRL_RJ_RESEND_MS / GDAKI_CTRL_RJ_ACC_TRIES;
+      j.accRetries++;
+      WARN("GIN/RC: rank %d: the REJOIN of rank %d (incarnation %u): %s (gen %u, try %u of %u): asked again in %.0f ms "
+           "mono_ms=%.3f", g->me, peer, m.pad, what, n.probeGen, j.accTries, GDAKI_CTRL_RJ_ACC_TRIES,
+           GDAKI_CTRL_RJ_RESEND_MS / GDAKI_CTRL_RJ_ACC_TRIES, gdakiQ4MonoMs());
+      return 0;
+    }
+    const bool psn = pr.prb.st.havePsn;  // the PSN rule never goes back
+    const uint32_t lastPsn = pr.prb.st.lastPsn;
+    pr.prb.st = j.accPrbWas;
+    pr.prb.st.havePsn = psn;
+    pr.prb.st.lastPsn = lastPsn;
+    pr.prb.started = j.accPrbWasStarted;
+    pr.prb.peerInc = j.accPrbWasInc;
+    if (struct gdakiCtrlPage* pgA = gdakiPageOf(r)) {
+      std::lock_guard<std::mutex> lk(pgA->mu);
+      if (peer < (int)pgA->peers.size() && pgA->peers[(size_t)peer].rjAccInc == m.pad) pgA->peers[(size_t)peer].rjAccInc = 0;
+    }
+    j.accStarted = false;
+    j.accGaveUp++;
+    snprintf(why, whyLen, "%s (gen %u) after %u tries: its pairing is back, the record QP kept for this REJOIN", what,
+             n.probeGen, j.accTries);
+    return -1;
+  };
+  if (!j.accProbeAsked) {
+    if (gdakiQ4MonoMs() < j.accNextMs) return 0;
+    j.accTries++;
+    j.accAnswered = pr.prb.answered;
+    const uint64_t asked0 = pr.prb.asked;
+    const struct gdakiCtrlPairBody bp = gdakiCtrlRjBodyOf(g, peer, GDAKI_CTRL_PAIR_QP_PROBE, GDAKI_CTRL_PAIR_STEP_PAIR, m.pad, n);
+    gdakiCtrlProbeLinkAct(r, peer, pr.prb, pc, GDAKI_CTRL_PA_TAKE, &bp);  // CONNECT asked of the watch thread; PAIR_ACK after
+    if (pr.prb.asked == asked0 || pr.prb.pendSeq == 0)
+      return again("the watch thread did not take the liveness READ QP's CONNECT");
+    pr.prb.started = true;
+    pr.prb.peerInc = m.pad;
+    j.accProbeAsked = true;
+  }
+  (void)gdakiCtrlProbeLinkPoll(r, peer, pr.prb, pc);
+  if (pr.prb.pendSeq != 0 || pr.prb.answered == j.accAnswered) return 0;
+  if (!pr.prb.haveLocal) return again("the liveness READ QP's CONNECT toward the spare's failed");
+  const struct gdakiCtrlRejoinNrp mine = gdakiCtrlRjNrpOf(g, peer, n.gen, n.probeGen);
+  (void)gdakiCtrlNrpPut(ack->nrp, sizeof(ack->nrp), mine);
+  return 1;
+}
+// The REJOIN_ACK went out (gdakiRsRejoinAccept, after its send): the table keeps it (a repeat gets it again, another QPN
+// pair is dropped), this side's records go on the ring from now (they wait in the queue for the spare's CONNECTED).
+static void gdakiCtrlRjAccepted(struct gdakiRecHost* r, int peer, const struct gdakiTsMsg& m, const struct gdakiTsMsg& ack) {
+  struct gdakiCtrlRing* g = gdakiCtrlRjRing(r, peer);
+  struct gdakiCtrlRejoinNrp n;
+  if (g == nullptr || !gdakiCtrlNrpGet(m.nrp, sizeof(m.nrp), &n)) return;
+  struct gdakiCtrlRdmaPeer& pr = g->peers[(size_t)peer];
+  gdakiCtrlRejoinAccepted(&pr.rejoin, m.pad, n.rec.qpn, n.probe.qpn, &ack, sizeof(ack));
+  (void)gdakiCtrlPathSwitch(&pr.path, GDAKI_CTRL_PM_RING);
+  pr.shownRec = n.gen;  // the REJOIN's pairings have this line, not the re-paired ones
+  pr.shownPrb = n.probeGen;
+  pr.rj.accStarted = pr.rj.accProbeAsked = pr.rj.accRecOn = false;
+  GIN_TS_NOTE("GIN/RC: rank %d: the REJOIN of rank %d (incarnation %u) taken over UD: record QP gen %u, liveness READ QP "
+              "gen %u, REJOIN_ACK sent; the records go on the ring after its CONNECTED mono_ms=%.3f", g->me, peer, m.pad,
+              n.gen, n.probeGen, gdakiQ4MonoMs());
+}
+// The spare's REJOINs start (gdakiRsSpareRejoinAll, before the first; the setup thread, the helper not started): this
+// process's incarnation into the ring, the ring bound to the status page by the helper's step once (a spare starts no
+// pairing of its own), and per gated peer with a UD way its record QP prepared for the REJOIN's generation (INIT, its
+// RECVs posted, a fresh PSN; the model STARTED) and its liveness READ QP's PREPARE asked of the watch thread.
+static void gdakiCtrlRjSpareBegin(struct gdakiRecHost* r, uint32_t inc) {
+  struct gdakiCtrlRing* g = (r != nullptr && r->ctrl != nullptr) ? r->ctrl->ring : nullptr;
+  if (g == nullptr || r->ts == nullptr) return;
+  g->inc = inc;
+  for (struct gdakiCtrlRdmaPeer& pr : g->peers) pr.ring.inc = inc;
+  gdakiCtrlRingHelperStep(r);
+  const uint32_t gen = gdakiCtrlRjGenOf(inc);
+  const struct gdakiCtrlProbeLinkCtx pc = gdakiCtrlRdmaProbeCtx(g);
+  int ready = 0, gated = 0;
+  for (int p = 0; p < g->nranks && p < (int)r->ts->peers.size(); p++) {
+    if (p == g->me || !r->ts->peers[(size_t)p].gated) continue;
+    gated++;
+    if (!gdakiCtrlRjUd(r, p)) continue;
+    struct gdakiCtrlRdmaPeer& pr = g->peers[(size_t)p];
+    pr.rj = gdakiCtrlRjSt();
+    char why[160] = {0};
+    if (gdakiCtrlRdmaPrepare(g, p, gen, true, why, sizeof(why)) != ncclSuccess) {
+      WARN("GIN/RC: rank %d: the record QP for the REJOIN to rank %d: %s (the REJOIN takes TCP) mono_ms=%.3f", g->me, p, why,
+           gdakiQ4MonoMs());
+      continue;
+    }
+    const double now = gdakiQ4MonoMs();
+    gdakiCtrlRjPairStarted(&pr.pairRec, gen, now);
+    gdakiCtrlRjPairStarted(&pr.prb.st, gen, now);
+    gdakiCtrlProbeLinkAsk(r, p, pr.prb, pc, GDAKI_CTRL_PA_NONE, GDAKI_CTRL_PO_PREPARE, gen, nullptr);
+    pr.prb.started = true;
+    pr.rj.gen = pr.rj.probeGen = gen;
+    pr.rj.state = GDAKI_CTRL_RJS_READY;
+    ready++;
+  }
+  GIN_TS_NOTE("GIN/RC: rank %d: REJOIN over UD to %d of %d gated rank(s) as incarnation %u (record and liveness READ QPs "
+              "gen %u) mono_ms=%.3f", g->me, ready, gated, inc, gen, gdakiQ4MonoMs());
+}
+// The spare's REJOIN to `peer` over UD (gdakiCtrlSend _REJOIN, fd -1): its endpoints into the record's nrp (the first
+// time its liveness READ QP's once the watch thread answered the PREPARE, waited for at most timeoutMs; every resend the
+// same endpoints), then the datagram; a send after the first is a resend (one line each). 0 sent, -1 not.
+static int gdakiCtrlRjSpareSend(struct gdakiRecHost* r, int peer, struct gdakiTsMsg* m, int timeoutMs) {
+  struct gdakiCtrlRing* g = gdakiCtrlRjRing(r, peer);
+  struct gdakiCtrlRdmaPeer& pr = g->peers[(size_t)peer];
+  if (pr.rj.tries == 0) {
+    const struct gdakiCtrlProbeLinkCtx pc = gdakiCtrlRdmaProbeCtx(g);
+    const double deadline = gdakiQ4MonoMs() + timeoutMs;
+    while (true) {
+      (void)gdakiCtrlProbeLinkPoll(r, peer, pr.prb, pc);
+      if (pr.prb.pendSeq == 0) break;
+      if (gdakiQ4MonoMs() >= deadline) return -1;
+      std::this_thread::sleep_for(std::chrono::microseconds(20));
+    }
+    if (!pr.prb.haveLocal) return -1;  // the PREPARE failed (its WARN)
+    pr.rj.nrp = gdakiCtrlRjNrpOf(g, peer, pr.rj.gen, pr.rj.probeGen);
+  }
+  (void)gdakiCtrlNrpPut(m->nrp, sizeof(m->nrp), pr.rj.nrp);
+  pr.rj.tries++;
+  if (pr.rj.tries > 1)
+    GIN_TS_NOTE("GIN/RC: rank %d: REJOIN to rank %d resent (try %u) mono_ms=%.3f", g->me, peer, pr.rj.tries, gdakiQ4MonoMs());
+  pr.rj.sentMs = gdakiQ4MonoMs();
+  if (pr.rj.state == GDAKI_CTRL_RJS_READY) pr.rj.state = GDAKI_CTRL_RJS_SENT;
+  return gdakiCtrlRjUdRec(g, peer, m);
+}
+// gdakiCtrlSend _REJOIN with no socket (fd -1): the spare's REJOIN or the survivor's REJOIN_ACK over UD. False: not UD.
+static bool gdakiCtrlRjSendOf(struct gdakiRecHost* r, int peer, struct gdakiTsMsg* m, int timeoutMs, int* rc) {
+  struct gdakiCtrlRing* g = gdakiCtrlRjRing(r, peer);
+  if (g == nullptr) return false;
+  if (m->type == GDAKI_TS_RS_REJOIN) {
+    if (!gdakiCtrlRjSpareUd(r, peer)) return false;
+    *rc = gdakiCtrlRjSpareSend(r, peer, m, timeoutMs);
+    return true;
+  }
+  if (m->type != GDAKI_TS_RS_REJOIN_ACK || !g->peers[(size_t)peer].haveUd) return false;
+  *rc = gdakiCtrlRjUdRec(g, peer, m);
+  return true;
+}
+// The spare's wait for the answer to its REJOIN over UD (gdakiCtrlRecvOn _REJOIN once its REJOIN went over UD): 1 a
+// REJOIN_ACK with the survivor's endpoints (kept for gdakiCtrlChanInstall) or FAIL (the spare stops), in *out; 0 nothing
+// took it by the resend interval from the last REJOIN (or timeoutMs, or stop): WAIT and REFUSE are told so (one line
+// when the answer changes), as TCP's FIN told them. False: the REJOIN did not go over UD.
+static bool gdakiCtrlRjSpareWait(struct gdakiRecHost* r, int peer, struct gdakiTsMsg* out, int timeoutMs,
+                                 std::atomic<bool>* stop, int* rc) {
+  struct gdakiCtrlRing* g = gdakiCtrlRjRing(r, peer);
+  if (g == nullptr || g->peers[(size_t)peer].rj.tries == 0) return false;
+  struct gdakiCtrlRdmaPeer& pr = g->peers[(size_t)peer];
+  const double until = std::min(gdakiQ4MonoMs() + std::max(0, timeoutMs), pr.rj.sentMs + GDAKI_CTRL_RJ_RESEND_MS);
+  *rc = 0;
+  while (true) {
+    gdakiCtrlRdmaPoll(g, gdakiQ4MonoMs());
+    for (auto it = g->udIn.begin(); it != g->udIn.end();) {
+      uint32_t type = 0;
+      memcpy(&type, it->body + 4, 4);
+      if (it->from != peer || it->env.kind != GDAKI_CTRL_K_RECORD ||
+          (type != GDAKI_TS_RS_REJOIN_ACK && type != GDAKI_TS_FAIL)) {
+        ++it;
+        continue;
+      }
+      struct gdakiTsMsg a;
+      memcpy(&a, it->body, sizeof(a));
+      if (pr.udInN > 0) pr.udInN--;
+      it = g->udIn.erase(it);
+      if (a.from != peer || a.nonce != r->ts->nonce) continue;
+      if (type == GDAKI_TS_RS_REJOIN_ACK) {
+        struct gdakiCtrlRejoinNrp n;
+        if (!gdakiCtrlNrpGet(a.nrp, sizeof(a.nrp), &n) || !gdakiCtrlRejoinNrpOk(n, true) || n.gen != pr.rj.gen ||
+            n.probeGen != pr.rj.probeGen)
+          continue;
+        pr.rj.ack = a;
+        pr.rj.haveAck = true;
+        pr.rj.state = GDAKI_CTRL_RJS_ACKED;
+        *out = a;
+        *rc = 1;
+        return true;
+      }
+      if (a.arg == GDAKI_CTRL_RJA_WAIT || a.arg == GDAKI_CTRL_RJA_REFUSE) {
+        (a.arg == GDAKI_CTRL_RJA_WAIT ? pr.rj.waits : pr.rj.refusals)++;
+        if (pr.rj.lastAnswer != (uint32_t)a.arg)
+          GIN_TS_NOTE("GIN/RC: rank %d: rank %d answered the REJOIN with %s over UD (try %u): sent again mono_ms=%.3f",
+                      g->me, peer, gdakiCtrlRjaName((uint32_t)a.arg), pr.rj.tries, gdakiQ4MonoMs());
+        pr.rj.lastAnswer = (uint32_t)a.arg;
+        continue;
+      }
+      pr.rj.state = GDAKI_CTRL_RJS_FAILED;  // FAIL (declined): the caller's rule ends the restore
+      *out = a;
+      *rc = 1;
+      return true;
+    }
+    const double now = gdakiQ4MonoMs();
+    if (now >= until || (stop != nullptr && stop->load(std::memory_order_acquire))) {
+      if (pr.rj.lastAnswer == 0) pr.rj.timeouts++;
+      return true;
+    }
+    const int cfd = gdakiCtrlRdmaChannelFd(g);
+    struct pollfd pf = {cfd, POLLIN, 0};
+    const int ms = std::max(1, std::min(5, (int)(until - now)));
+    if (cfd < 0) std::this_thread::sleep_for(std::chrono::milliseconds(ms));
+    else if (poll(&pf, 1, ms) > 0 && (pf.revents & POLLIN)) gdakiCtrlRdmaOnWake(g);
+  }
+}
+// The spare installs the pair from the REJOIN_ACK it took (gdakiCtrlChanInstall, fd -1): both pairings CONNECT toward
+// its endpoints (the record QP RTR, RTS with its CONNECTED first; the liveness READ QP's CONNECT asked of the watch
+// thread, its PAIR_DONE after; a PAIR_ACK that came first did it already), both know the survivor's incarnation, the
+// pair's path starts afresh with this side's records on the ring. False: no REJOIN_ACK over UD.
+static bool gdakiCtrlRjSpareInstall(struct gdakiRecHost* r, int peer) {
+  struct gdakiCtrlRing* g = gdakiCtrlRjRing(r, peer);
+  if (g == nullptr || !g->peers[(size_t)peer].rj.haveAck) return false;
+  struct gdakiCtrlRdmaPeer& pr = g->peers[(size_t)peer];
+  struct gdakiCtrlRejoinNrp n;
+  if (!gdakiCtrlNrpGet(pr.rj.ack.nrp, sizeof(pr.rj.ack.nrp), &n)) return false;
+  const uint32_t inc = pr.rj.ack.executed[1];  // the survivor's own incarnation
+  pr.rj.haveAck = false;
+  const struct gdakiCtrlPairBody br = gdakiCtrlRjBodyOf(g, peer, GDAKI_CTRL_PAIR_QP_RECORD, GDAKI_CTRL_PAIR_STEP_ACK, inc, n);
+  gdakiCtrlRdmaPairAct(g, peer, gdakiCtrlPairOnAck(&pr.pairRec, n.gen, inc, true), &br);
+  const struct gdakiCtrlPairBody bp = gdakiCtrlRjBodyOf(g, peer, GDAKI_CTRL_PAIR_QP_PROBE, GDAKI_CTRL_PAIR_STEP_ACK, inc, n);
+  gdakiCtrlProbeLinkAct(r, peer, pr.prb, gdakiCtrlRdmaProbeCtx(g), gdakiCtrlPairOnAck(&pr.prb.st, n.probeGen, inc, true), &bp);
+  gdakiCtrlPairSetPeerInc(&pr.pairRec, inc);
+  gdakiCtrlPairSetPeerInc(&pr.prb.st, inc);
+  pr.prb.peerInc = inc;
+  pr.path = gdakiCtrlPathSt();
+  (void)gdakiCtrlPathSwitch(&pr.path, GDAKI_CTRL_PM_RING);
+  pr.shownRec = n.gen;
+  pr.shownPrb = n.probeGen;
+  pr.rj.state = GDAKI_CTRL_RJS_INSTALLED;
+  GIN_TS_NOTE("GIN/RC: rank %d: REJOIN_ACK of rank %d taken over UD (try %u): record QP gen %u %s, liveness READ QP gen %u; "
+              "the records go on the ring mono_ms=%.3f", g->me, peer, pr.rj.tries, n.gen,
+              pr.ring.connected ? "CONNECTED sent" : "not connected", n.probeGen, gdakiQ4MonoMs());
+  return true;
+}
+// The spare's REJOINs ended (gdakiRsSpareRejoinAll): its ring goes live once every pair is up (gdakiCtrlRingLiveStep).
+static void gdakiCtrlRjSpareDone(struct gdakiRecHost* r) {
+  struct gdakiCtrlRing* g = (r != nullptr && r->ctrl != nullptr) ? r->ctrl->ring : nullptr;
+  if (g != nullptr && g->setup.spare) g->spareRejoined = true;
+}
+// The restored pair's witness (EXPERIMENT.md 9.1: the witness stays TCP): after a REJOIN over UD there is no socket; the
+// peer is unknown and re-dialled at once by the layer's reconnect step (the lower rank dials, the higher accepts), and
+// never judged ended for lacking it (gdakiCtrlNoWitnessLv).
+static void gdakiCtrlRjWitnessRedial(struct gdakiRecHost* r, int peer) {
+  if (r == nullptr || r->ts == nullptr || peer < 0 || peer >= (int)r->ts->peers.size()) return;
+  struct gdakiTsPeer& pe = r->ts->peers[(size_t)peer];
+  if (pe.fd >= 0) return;
+  const double now = gdakiQ4MonoMs();
+  pe.have = 0;
+  pe.unknown = true;
+  pe.gone = false;
+  pe.lostMs = now;
+  pe.nextDialMs = now;
+  pe.attempts = 0;
+  pe.nextProbeMs = now;
+  pe.probeAnswered = false;
+  snprintf(pe.lostCause, sizeof(pe.lostCause), "REJOIN");
+  GIN_TS_NOTE("GIN/RC: rank %d: rank %d's witness socket after its REJOIN over UD: unknown, re-dialled (the records go on "
+              "the ring) mono_ms=%.3f", r->ctx->rank, peer, now);
+}
+// gdakiTsPeerLiveness's answer for a peer without a witness socket: unknown while the pair's records go on the ring (no
+// socket is no evidence), else ln4's DEAD.
+static int gdakiCtrlNoWitnessLv(struct gdakiRecHost* r, int peer) {
+  if (gdakiCtrlWitnessMutedOf(r, peer)) return GDAKI_TS_LV_NOEVIDENCE;  // smoke3: the witness off: no socket is no evidence
+  return gdakiCtrlRingLiveOn(r, peer) ? GDAKI_TS_LV_UNKNOWN : GDAKI_TS_LV_DEAD;
+}
+// ---- STATE and the rkey list over the outbox (phase 2a-2-C step 3; impl/notes_p2b.md "기록과 XFER 차례", design v3 2.3,
+// 5.4 5) ----
+// The way of a pair's STATE turn is the REJOIN's: both sides know how the spare's REJOIN went (over UD, its generations
+// (inc << 20) + 1 agreed in its nrp, or over TCP), so they never wait on different paths. Over UD the turn takes the
+// ring and waits ("not yet") until the pair's record QP is up in that generation or a later one (a re-pairing of the same
+// incarnation); a side whose generation lags (the survivor before the spare's CONNECTED, the spare before its install)
+// waits, never takes the socket. The data socket (ln4's way) only when the pair has no ring: none in this context, or the
+// REJOIN went over TCP (then neither side has a generation of the new incarnation); the tcp build has no ring at all.
+// The three transfers (STATE_REQ, STATE, RKEYS with the 64 B head) go in steps that never block (the survivor's helper,
+// the spare's REJOIN loop: 1 "not yet").
+enum : int { GDAKI_CTRL_SW_UP = 0, GDAKI_CTRL_SW_WAIT = 1, GDAKI_CTRL_SW_SOCKET = 2 };
+enum : uint32_t { GDAKI_CTRL_SWR_TCP = 0, GDAKI_CTRL_SWR_UD = 1, GDAKI_CTRL_SWR_TAKEN = 2 };
+// ring: the context has one; rejoin: the REJOIN of this incarnation went over TCP, over UD (not taken or installed yet), or
+// was taken (the survivor) / installed (the spare); agreedGen: the REJOIN's record QP generation; pairGen, pairUp: the
+// pair's record QP now.
+static inline int gdakiCtrlStateWayRule(bool ring, uint32_t rejoin, uint32_t agreedGen, uint32_t pairGen, bool pairUp) {
+  if (!ring || rejoin == GDAKI_CTRL_SWR_TCP) return GDAKI_CTRL_SW_SOCKET;
+  if (rejoin != GDAKI_CTRL_SWR_TAKEN || agreedGen == 0 || pairGen < agreedGen || !pairUp) return GDAKI_CTRL_SW_WAIT;
+  return GDAKI_CTRL_SW_UP;
+}
+// This side's way with `peer` (spare: this process is the spare and peer a survivor; inc: the spare's incarnation).
+static int gdakiCtrlStateWayOf(struct gdakiRecHost* r, int peer, bool spare, uint32_t inc) {
+  struct gdakiCtrlRing* g = gdakiCtrlRjRing(r, peer);
+  if (g == nullptr) return gdakiCtrlStateWayRule(false, GDAKI_CTRL_SWR_TCP, 0, 0, false);
+  const struct gdakiCtrlRdmaPeer& pr = g->peers[(size_t)peer];
+  uint32_t rj = GDAKI_CTRL_SWR_TCP, agreed = 0;
+  if (spare) {
+    if (pr.rj.state == GDAKI_CTRL_RJS_INSTALLED) rj = GDAKI_CTRL_SWR_TAKEN;
+    else if (pr.rj.state != GDAKI_CTRL_RJS_IDLE) rj = GDAKI_CTRL_SWR_UD;
+    agreed = pr.rj.gen == gdakiCtrlRjGenOf(inc) ? pr.rj.gen : 0u;
+  } else {
+    if (pr.rejoin.accepted && pr.rejoin.inc == inc) rj = GDAKI_CTRL_SWR_TAKEN;
+    else if ((pr.rj.parked && pr.rj.park.pad == inc) || (pr.rj.accStarted && pr.rj.accInc == inc)) rj = GDAKI_CTRL_SWR_UD;
+    agreed = gdakiCtrlRjGenOf(inc);
+  }
+  return gdakiCtrlStateWayRule(true, rj, agreed, pr.ring.gen, gdakiCtrlRingUp(&pr.ring));
+}
+// The pair's ring when its STATE turn takes the outbox (up or not yet), null: the data socket.
+static struct gdakiCtrlRing* gdakiCtrlStateRingOf(struct gdakiRecHost* r, int peer, bool spare, uint32_t inc) {
+  return gdakiCtrlStateWayOf(r, peer, spare, inc) == GDAKI_CTRL_SW_SOCKET ? nullptr : r->ctrl->ring;
+}
+// The turn of `peer` for incarnation inc (a new incarnation's starts afresh).
+static struct gdakiCtrlStateTurn& gdakiCtrlStateTurnOf(struct gdakiCtrlRing* g, int peer, uint32_t inc) {
+  struct gdakiCtrlStateTurn& t = g->peers[(size_t)peer].st;
+  if (t.inc != inc) {
+    t = gdakiCtrlStateTurn();
+    t.inc = inc;
+  }
+  return t;
+}
+static void gdakiCtrlStateTurnFail(struct gdakiCtrlRing* g, int peer) {
+  struct gdakiCtrlRdmaPeer& pr = g->peers[(size_t)peer];
+  const uint32_t inc = pr.st.inc;
+  pr.st = gdakiCtrlStateTurn();
+  pr.st.inc = inc;
+  pr.xo.on = pr.xi.on = false;
+}
+// A short wait of the spare's loops for the ring (its channel fd, or a sleep): at most ms.
+static void gdakiCtrlRingNap(struct gdakiCtrlRing* g, int ms) {
+  const int cfd = gdakiCtrlRdmaChannelFd(g);
+  struct pollfd pf = {cfd, POLLIN, 0};
+  if (cfd < 0) std::this_thread::sleep_for(std::chrono::microseconds(50));
+  else if (poll(&pf, 1, std::max(0, ms)) > 0 && (pf.revents & POLLIN)) gdakiCtrlRdmaOnWake(g);
+}
+// The survivor's turn with spare p of incarnation inc (gdakiHoldTransferStep, the helper): 2 the data socket, 1 not yet
+// (the ring not up in the REJOIN's generation, or a transfer under way), 0 done (*keys: the spare's rkey list), -1
+// failed (why). ex: the log export of checkpoint K (ln4's bytes; false: why written).
+static int gdakiCtrlStateSurvivorTurn(struct gdakiRecHost* r, int p, uint32_t inc,
+                                      bool (*ex)(void* arg, uint64_t ckpt, std::vector<uint8_t>* x, char* why, size_t whyLen),
+                                      void* exArg, struct gdakiRsRkeys* keys, char* why, size_t whyLen) {
+  const int way = gdakiCtrlStateWayOf(r, p, false, inc);
+  if (way == GDAKI_CTRL_SW_SOCKET) return 2;
+  struct gdakiCtrlRing* g = r->ctrl->ring;
+  struct gdakiCtrlRdmaPeer& pr = g->peers[(size_t)p];
+  struct gdakiCtrlStateTurn& t = gdakiCtrlStateTurnOf(g, p, inc);
+  if (t.phase == GDAKI_CTRL_ST_DONE) t = gdakiCtrlStateTurn(), t.inc = inc;  // another turn of the same incarnation
+  if (way == GDAKI_CTRL_SW_WAIT && t.phase == GDAKI_CTRL_ST_IDLE) {
+    gdakiCtrlRdmaPoll(g, gdakiQ4MonoMs());
+    t.waits++;
+    return 1;
+  }
+  const int me = g->me;
+  const uint64_t nonce = r->ts->nonce;
+  char w[200] = {0};
+  if (t.phase == GDAKI_CTRL_ST_IDLE) {
+    const int k = gdakiCtrlRdmaXInStep(g, p, sizeof(struct gdakiCtrlXferHdr) + gdakiCtrlXferMax(GDAKI_CTRL_XK_STATE_REQ), w,
+                                       sizeof(w));
+    if (k == 1) return 1;
+    if (k < 0) {
+      snprintf(why, whyLen, "the spare's state request did not arrive over the outbox: %.150s", w);
+      gdakiCtrlStateTurnFail(g, p);
+      return -1;
+    }
+    struct gdakiTsMsg a;
+    const uint32_t c = gdakiCtrlStateReqTake(pr.xi.b.data(), pr.xi.b.size(), p, me, nonce, inc, &a);
+    if (c != GDAKI_CTRL_XC_OK) {
+      if (c == GDAKI_CTRL_XC_REFUSED) snprintf(why, whyLen, "the spare refused the state transfer (%u)", a.pad);
+      else snprintf(why, whyLen, "the spare's state request over the outbox is %s", gdakiCtrlXferWhy(c));
+      gdakiCtrlStateTurnFail(g, p);
+      return -1;
+    }
+    std::vector<uint8_t> x;
+    if (!ex(exArg, a.round, &x, why, whyLen)) {
+      gdakiCtrlStateTurnFail(g, p);
+      return -1;
+    }
+    std::vector<uint8_t> out;
+    gdakiCtrlStatePack(&out, me, p, inc, nonce, a.round, x);
+    t.ckpt = a.round;
+    t.exportBytes = x.size();
+    t.startMs = gdakiQ4MonoMs();
+    gdakiCtrlRdmaXOutStart(g, p, std::move(out));
+    t.phase = GDAKI_CTRL_ST_STATE_OUT;
+  }
+  if (t.phase == GDAKI_CTRL_ST_STATE_OUT) {
+    const int k = gdakiCtrlRdmaXOutStep(g, p, w, sizeof(w));
+    if (k == 1) return 1;
+    if (k < 0) {
+      snprintf(why, whyLen, "the log export (%lu bytes) could not be sent over the outbox: %.100s",
+               (unsigned long)t.exportBytes, w);
+      gdakiCtrlStateTurnFail(g, p);
+      return -1;
+    }
+    t.phase = GDAKI_CTRL_ST_RKEYS_IN;
+  }
+  const int k = gdakiCtrlRdmaXInStep(g, p, sizeof(struct gdakiCtrlXferHdr) + gdakiCtrlXferMax(GDAKI_CTRL_XK_RKEYS), w,
+                                     sizeof(w));
+  if (k == 1) return 1;
+  if (k < 0) {
+    snprintf(why, whyLen, "the spare's rkey list did not arrive over the outbox: %.110s", w);
+    gdakiCtrlStateTurnFail(g, p);
+    return -1;
+  }
+  const uint32_t c = gdakiCtrlRkeysTake(pr.xi.b.data(), pr.xi.b.size(), p, me, nonce, inc, keys);
+  if (c != GDAKI_CTRL_XC_OK) {
+    snprintf(why, whyLen, "the spare's rkey list over the outbox is %s", gdakiCtrlXferWhy(c));
+    gdakiCtrlStateTurnFail(g, p);
+    return -1;
+  }
+  t.phase = GDAKI_CTRL_ST_DONE;
+  GIN_TS_NOTE("GIN/CTRL: rank %d: state of checkpoint %lu sent to rank %d's spare over the outbox (%lu bytes of log, %zu "
+              "rkeys back, %.1f ms, %lu step(s) waited for the ring) mono_ms=%.3f", me, (unsigned long)t.ckpt, p,
+              (unsigned long)t.exportBytes, keys->e.size(), gdakiQ4MonoMs() - t.startMs, (unsigned long)t.waits,
+              gdakiQ4MonoMs());
+  return 0;
+}
+// The spare's STATE step with survivor `peer` (gdakiCkptSpareDataFd; inc: this process's incarnation, step: K): 2 the
+// data socket, 1 not yet, 0 the export in *x (ln4's n bytes), -1 failed (why).
+static int gdakiCtrlStateSpareTurn(struct gdakiRecHost* r, int peer, uint32_t inc, uint64_t step, std::vector<uint8_t>* x,
+                                   char* why, size_t whyLen) {
+  const int way = gdakiCtrlStateWayOf(r, peer, true, inc);
+  if (way == GDAKI_CTRL_SW_SOCKET) return 2;
+  struct gdakiCtrlRing* g = r->ctrl->ring;
+  struct gdakiCtrlRdmaPeer& pr = g->peers[(size_t)peer];
+  struct gdakiCtrlStateTurn& t = gdakiCtrlStateTurnOf(g, peer, inc);
+  if (t.phase > GDAKI_CTRL_ST_STATE_IN) t = gdakiCtrlStateTurn(), t.inc = inc;  // another turn
+  if (way == GDAKI_CTRL_SW_WAIT && t.phase == GDAKI_CTRL_ST_IDLE) {
+    gdakiCtrlRdmaPoll(g, gdakiQ4MonoMs());
+    t.waits++;
+    return 1;
+  }
+  const int me = g->me;
+  const uint64_t nonce = r->ts->nonce;
+  char w[200] = {0};
+  if (t.phase == GDAKI_CTRL_ST_IDLE) {
+    struct gdakiTsMsg a;
+    gdakiCtrlStateReqFill(&a, me, nonce, step);
+    std::vector<uint8_t> out;
+    gdakiCtrlXferPack(&out, GDAKI_CTRL_XK_STATE_REQ, me, peer, inc, nonce, step, &a, sizeof(a));
+    t.ckpt = step;
+    t.startMs = gdakiQ4MonoMs();
+    gdakiCtrlRdmaXOutStart(g, peer, std::move(out));
+    t.phase = GDAKI_CTRL_ST_REQ_OUT;
+  }
+  if (t.phase == GDAKI_CTRL_ST_REQ_OUT) {
+    const int k = gdakiCtrlRdmaXOutStep(g, peer, w, sizeof(w));
+    if (k == 1) return 1;
+    if (k < 0) {
+      snprintf(why, whyLen, "the state request to rank %d over the outbox failed: %.150s", peer, w);
+      gdakiCtrlStateTurnFail(g, peer);
+      return -1;
+    }
+    t.phase = GDAKI_CTRL_ST_STATE_IN;
+  }
+  const int k = gdakiCtrlRdmaXInStep(g, peer, sizeof(struct gdakiCtrlXferHdr) + gdakiCtrlXferMax(GDAKI_CTRL_XK_STATE), w,
+                                     sizeof(w));
+  if (k == 1) return 1;
+  if (k < 0) {
+    snprintf(why, whyLen, "rank %d's state over the outbox did not arrive: %.150s", peer, w);
+    gdakiCtrlStateTurnFail(g, peer);
+    return -1;
+  }
+  const uint32_t c = gdakiCtrlStateTake(pr.xi.b.data(), pr.xi.b.size(), peer, me, nonce, inc, t.ckpt, x);
+  if (c != GDAKI_CTRL_XC_OK) {
+    x->clear();
+    snprintf(why, whyLen, "rank %d's state over the outbox is %s", peer, gdakiCtrlXferWhy(c));
+    gdakiCtrlStateTurnFail(g, peer);
+    return -1;
+  }
+  t.exportBytes = x->size();
+  t.phase = GDAKI_CTRL_ST_HAVE_STATE;
+  GIN_TS_NOTE("GIN/CTRL: spare rank %d: state of checkpoint %lu from rank %d over the outbox (%zu bytes of log, %.1f ms, "
+              "%lu step(s) waited for the ring) mono_ms=%.3f", me, (unsigned long)t.ckpt, peer, x->size(),
+              gdakiQ4MonoMs() - t.startMs, (unsigned long)t.waits, gdakiQ4MonoMs());
+  return 0;
+}
+// The spare's rkey list to survivor `peer` after its STATE came over the outbox (gdakiCtrlRkeysHandOver): 1 not yet, 0
+// done (the survivor READ it), -1 failed (why: no such STATE, or the transfer failed).
+static int gdakiCtrlRkeysSpareTurn(struct gdakiRecHost* r, int peer, const struct gdakiRsRkeys& keys, char* why,
+                                   size_t whyLen) {
+  struct gdakiCtrlRing* g = gdakiCtrlRjRing(r, peer);
+  if (g == nullptr) {
+    snprintf(why, whyLen, "no ring toward rank %d", peer);
+    return -1;
+  }
+  struct gdakiCtrlStateTurn& t = g->peers[(size_t)peer].st;
+  if (t.phase == GDAKI_CTRL_ST_HAVE_STATE) {
+    std::vector<uint8_t> pl, out;
+    gdakiCtrlRkeysBytes(keys, &pl);
+    gdakiCtrlXferPack(&out, GDAKI_CTRL_XK_RKEYS, g->me, peer, keys.incarnation, r->ts->nonce, 0, pl.data(), pl.size());
+    gdakiCtrlRdmaXOutStart(g, peer, std::move(out));
+    t.phase = GDAKI_CTRL_ST_RKEYS_OUT;
+  }
+  if (t.phase != GDAKI_CTRL_ST_RKEYS_OUT) {
+    snprintf(why, whyLen, "no state of rank %d came over the outbox before the rkey list", peer);
+    return -1;
+  }
+  char w[200] = {0};
+  const int k = gdakiCtrlRdmaXOutStep(g, peer, w, sizeof(w));
+  if (k == 1) return 1;
+  if (k < 0) {
+    snprintf(why, whyLen, "%.190s", w);
+    gdakiCtrlStateTurnFail(g, peer);
+    return -1;
+  }
+  t.phase = GDAKI_CTRL_ST_DONE;
+  return 0;
+}
+// gdakiCtrlSend (_RECORD) by the pair's path (phase 2a-2-C): the ring, the marker in every envelope (gdakiTsSend's
+// contract: the magic stamped, bounded by timeoutMs; queued until CONNECTED and while the window is shut; -1: the queue
+// stayed full to the bound, or the connection of this generation is lost), or the socket `fd` (a socket generation after
+// a switch: its marker record first), the bytes counted. REJOIN: UD when there is no socket (fd -1: the REJOIN and its
+// REJOIN_ACK over UD, 2a-2-C), else TCP; DATA: TCP until the outbox step.
+static bool gdakiCtrlRingSendOf(struct gdakiRecHost* r, int peer, uint32_t ch, int fd, struct gdakiTsMsg* m, int timeoutMs,
+                                int* rc) {
+  if (ch == GDAKI_CTRL_CH_REJOIN) return fd < 0 && gdakiCtrlRjSendOf(r, peer, m, timeoutMs, rc);
+  struct gdakiCtrlPathSt* s = ch == GDAKI_CTRL_CH_RECORD ? gdakiCtrlPathOf(r, peer) : nullptr;
+  if (s == nullptr) return false;
+  struct gdakiCtrlRing* g = r->ctrl->ring;
+  if (s->txPath == GDAKI_CTRL_PM_RING) {
+    struct gdakiCtrlRdmaPeer& pr = g->peers[(size_t)peer];
+    const struct gdakiCtrlPathMark mk = gdakiCtrlPathMarkOf(s);
+    *rc = gdakiCtrlRdmaSend(g, peer, m, timeoutMs, &mk);
+    if (*rc == 0) {
+      pr.txRecords++;
+      s->txSent++;
+      if (!pr.ring.q.empty()) pr.deferred++;  // FIFO: anything still queued includes this record
+      if (pr.ring.q.size() > g->sendqMax) g->sendqMax = pr.ring.q.size();
+    }
+    return true;
+  }
+  if (s->txMarkDue) {
+    struct gdakiTsMsg mm;
+    memset(&mm, 0, sizeof(mm));
+    mm.type = GDAKI_TS_CTRL_PATH;
+    mm.from = g->me;
+    mm.round = s->txGen;
+    mm.arg = (int32_t)s->txPath;
+    mm.nonce = r->ts != nullptr ? r->ts->nonce : 0;
+    const struct gdakiCtrlPathMark mk = gdakiCtrlPathMarkOf(s);
+    memcpy(mm.executed, &mk, sizeof(mk));
+    const int k = gdakiTsSend(fd, &mm, timeoutMs);
+    gdakiCtrlTcpCount(r, peer, ch, false, k);
+    if (k != 0) {
+      *rc = -1;
+      return true;
+    }
+    s->txMarkDue = false;
+  }
+  *rc = gdakiTsSend(fd, m, timeoutMs);
+  gdakiCtrlTcpCount(r, peer, ch, false, *rc);
+  if (*rc == 0) s->txSent++;
+  return true;
+}
+// gdakiCtrlPump by the pair's path (phase 2a-2-C): the ready records first, then the receive path (the ring; or the
+// socket with ln4's contract: a BYE is a record, FIN or an error -1, no socket -1 while this side's records go on the
+// socket), then, while the socket is the receive path, the
+// ring for a newer generation (while the ring is, the socket's marker and records come through the witness pump); every
+// record through the order rule. The ring's -1 while it is the receive path or this side's records go on it: exactly
+// once per lost connection (a
+// generation change either side started, or this generation lost) with pe.closeCause "QP:NEWGEN" or "QP:<cause>", the
+// witness's socket untouched and gdakiTsSocketLost not called (the caller's round is cancelled; REVIEW_P12 8). The
+// socket's -1 while a newer generation waits closes the old path instead (the witness reads the FIN again).
+static bool gdakiCtrlRingPumpOf(struct gdakiRecHost* r, int peer, struct gdakiTsPeer& pe, struct gdakiTsMsg* out, int* rc) {
+  struct gdakiCtrlPathSt* s = gdakiCtrlPathOf(r, peer);
+  if (s == nullptr) return false;
+  struct gdakiCtrlRing* g = r->ctrl->ring;
+  const bool ringRead = g->pairingStarted;  // the helper's step paired it (never on the setup thread)
+  while (true) {
+    if (gdakiCtrlPathReadyOut(r, peer, s, gdakiCtrlPathRxClosed(g, peer, pe, s), out) == 1) {
+      *rc = 1;
+      return true;
+    }
+    struct gdakiCtrlPathMark mk;
+    char cause[48] = {0};  // "QP:" and the ring's cause (24 B) fit; pe.closeCause keeps what it can
+    int k;
+    if (s->rxPath == GDAKI_CTRL_PM_RING) {
+      k = ringRead ? gdakiCtrlRingPumpMark(g, peer, out, &mk, cause, sizeof(cause)) : 0;
+      if (k < 0) {
+        const size_t n = std::min(strlen(cause), sizeof(pe.closeCause) - 1);
+        memcpy(pe.closeCause, cause, n);
+        pe.closeCause[n] = 0;
+      }
+      if (k <= 0) {
+        *rc = k;
+        return true;
+      }
+      if (mk.path == 0 || gdakiCtrlPathInRec(r, peer, s, mk.path, mk.gen, mk.before, out) == 1) {
+        *rc = 1;
+        return true;
+      }
+      continue;
+    }
+    k = gdakiCtrlPathSockRead(r, peer, s, pe, out);
+    if (k == 1) {
+      if (gdakiCtrlPathInRec(r, peer, s, GDAKI_CTRL_PM_SOCKET, s->sockGen, 0, out) == 1) {
+        *rc = 1;
+        return true;
+      }
+      continue;
+    }
+    if (k < 0) {
+      if (s->pend.empty() || s->pend.front().gen != s->rxGen + 1u) {
+        *rc = -1;
+        return true;
+      }
+      gdakiCtrlPathLine(r, peer, s, gdakiCtrlPathStep(s, true, gdakiQ4MonoMs()), false, 0, 0);  // the old path closed
+      continue;
+    }
+    k = ringRead ? gdakiCtrlRingPumpMark(g, peer, out, &mk, cause, sizeof(cause)) : 0;
+    if (k < 0 && s->txPath == GDAKI_CTRL_PM_RING) {  // the pair's ring lost while this side's records go on it (the
+      const size_t n = std::min(strlen(cause), sizeof(pe.closeCause) - 1);  // peer's first ones may not have come yet)
+      memcpy(pe.closeCause, cause, n);
+      pe.closeCause[n] = 0;
+      *rc = -1;
+      return true;
+    }
+    if (k <= 0) {  // nothing (a ring that carries nothing of the pair: its -1 counted only)
+      // no socket while this side's records still go on it: ln4's answer (-1, the socket's cause); else nothing yet
+      *rc = (pe.fd < 0 && s->pend.empty() && s->txPath == GDAKI_CTRL_PM_SOCKET) ? gdakiTsPump(pe, out) : 0;
+      return true;
+    }
+    if (mk.path == 0 || gdakiCtrlPathInRec(r, peer, s, mk.path, mk.gen, mk.before, out) == 1) {
+      *rc = 1;
+      return true;
+    }
+  }
+}
+// gdakiCtrlRecv / gdakiCtrlRecvOn (_RECORD) by the pair's path: gdakiTsRecv's contract (1 a record, 0 timeout or stop, -1
+// FIN, an error or the ring's lost connection) over the pump above, waiting on the socket (while it is the receive path)
+// and on the helper CQ's completion channel in slices of at most 5 ms as gdakiTsRecv does. RecvOn (pe null: the spare's
+// dial is not the pair's socket) takes this only while the ring is the receive path or this side's records go on it
+// (2a-2-C: after a REJOIN over UD there is no dial); RecvOn _REJOIN: the UD answer once the REJOIN went over UD.
+static bool gdakiCtrlRingRecvOf(struct gdakiRecHost* r, int peer, uint32_t ch, struct gdakiTsPeer* pe,
+                                struct gdakiTsMsg* out, int timeoutMs, std::atomic<bool>* stop, int* rc) {
+  if (ch == GDAKI_CTRL_CH_REJOIN) return pe == nullptr && gdakiCtrlRjSpareWait(r, peer, out, timeoutMs, stop, rc);
+  struct gdakiCtrlPathSt* s = ch == GDAKI_CTRL_CH_RECORD ? gdakiCtrlPathOf(r, peer) : nullptr;
+  if (s == nullptr || (pe == nullptr && s->rxPath != GDAKI_CTRL_PM_RING && s->txPath != GDAKI_CTRL_PM_RING)) return false;
+  struct gdakiCtrlRing* g = r->ctrl->ring;
+  struct gdakiTsPeer tmp;
+  struct gdakiTsPeer& p = pe != nullptr ? *pe : tmp;
+  const double deadline = gdakiQ4MonoMs() + timeoutMs;
+  while (true) {
+    (void)gdakiCtrlRingPumpOf(r, peer, p, out, rc);
+    if (*rc != 0) return true;
+    const int rem = (int)(deadline - gdakiQ4MonoMs());
+    if (rem <= 0 || (stop != nullptr && stop->load(std::memory_order_acquire))) return true;
+    struct pollfd pf[2];
+    int n = 0, wake = -1;
+    if (s->rxPath == GDAKI_CTRL_PM_SOCKET && p.fd >= 0 && !p.gone) pf[n++] = {p.fd, POLLIN, 0};
+    const int cfd = g->pairingStarted ? gdakiCtrlRdmaChannelFd(g) : -1;
+    if (cfd >= 0) {
+      wake = n;
+      pf[n++] = {cfd, POLLIN, 0};
+    }
+    if (n == 0) std::this_thread::sleep_for(std::chrono::milliseconds(std::min(rem, 5)));
+    else if (poll(pf, (nfds_t)n, std::min(rem, 5)) > 0 && wake >= 0 && (pf[wake].revents & POLLIN)) gdakiCtrlRdmaOnWake(g);
+  }
+}
+// The helper's poll sets: the completion channel's fd beside the witness sockets (its index, or SIZE_MAX: none), and
+// its event taken after the poll (else the fd stays readable and every poll returns at once).
+static size_t gdakiCtrlWakeFdAdd(struct gdakiRecHost* r, std::vector<struct pollfd>& pf) {
+  const int fd = gdakiCtrlRdmaChannelFd(gdakiCtrlRingLive(r));
+  if (fd < 0) return SIZE_MAX;
+  pf.push_back({fd, POLLIN, 0});
+  return pf.size() - 1;
+}
+static void gdakiCtrlWakeTake(struct gdakiRecHost* r, const std::vector<struct pollfd>& pf, size_t k) {
+  if (k < pf.size() && (pf[k].revents & POLLIN)) gdakiCtrlRdmaOnWake(gdakiCtrlRingLive(r));
+}
+// The witness's socket while the ring carries the records (EXPERIMENT.md 9.1: the witness stays TCP): BYE marks the peer
+// left (one line) and the reading goes on; the pair's path marker records and its socket records go through the order
+// rule (phase 2a-2-C): 1 a record the caller handles as a record (the socket generation's own while it is the receive
+// generation: a peer not switched yet, counted as late), held ones wait for the switch, an old generation's are dropped
+// (one line per switch); 0: nothing more; -1: FIN or an error (pe.closeCause), for the caller's gdakiTsSocketLost (the
+// witness judged as before).
+static int gdakiCtrlWitnessPump(struct gdakiRecHost* r, int peer, struct gdakiTsPeer& pe, struct gdakiTsMsg* out) {
+  struct gdakiCtrlPathSt* s = gdakiCtrlPathOf(r, peer);
+  if (s == nullptr) return 0;  // no ring: never live
+  while (true) {
+    if (pe.fd < 0 || pe.gone) return 0;
+    const int k = gdakiCtrlPathSockRead(r, peer, s, pe, out);
+    if (k <= 0) return k;
+    if (out->type == GDAKI_TS_BYE) {
+      if (!pe.left)
+        GIN_TS_NOTE("GIN/TS: rank %d: rank %d left the communicator (BYE) mono_ms=%.3f", r->ctx->rank, peer, gdakiQ4MonoMs());
+      pe.left = true;
+      continue;
+    }
+    if (gdakiCtrlPathInRec(r, peer, s, GDAKI_CTRL_PM_SOCKET, s->sockGen, 0, out) == 0) continue;  // held or dropped
+    r->ctrlTcp.lateRecords.fetch_add(1, std::memory_order_relaxed);
+    return 1;
+  }
+}
+// gdakiCtrlRecordToErr: the record QP into ERR (the ring's connection of this generation lost); the helper's step starts
+// the re-pairing when the peer's lineage is live (a held peer is paired again through its spare's REJOIN, 2a-2-C).
+static void gdakiCtrlRdmaRecordToErrAsk(struct gdakiRecHost* r, int peer) {
+  struct gdakiCtrlRing* g = (r != nullptr && r->ctrl != nullptr) ? r->ctrl->ring : nullptr;
+  if (g == nullptr || peer < 0 || peer >= g->nranks || peer == g->me) return;
+  gdakiCtrlRdmaRecordToErr(g, peer);
+}
+static bool gdakiCtrlArmedNow(struct gdakiRecHost* r);  // the communicator is armed, or has no restore (the host's)
+#ifndef NCCL_GIN_TS_PRODUCTION
+// ---- 2a-2-C: the witness socket's test switches (EXPERIMENT.md 9.9; notes_test.md's lines; rdma research build) ----
+#include <sys/prctl.h>
+#include <sys/resource.h>
+#include <sys/syscall.h>
+static void gdakiCtrlTestDieNow(struct gdakiRecHost* r);  // DIE_RST's end: SIGKILL of this process (the host's)
+// This rank's open witness sockets (the helper sockets toward every other rank): their fds into fds[], at most max.
+static int gdakiCtrlWitnessFds(struct gdakiRecHost* r, int* fds, int max) {
+  int n = 0;
+  for (int p = 0; r->ts != nullptr && p < (int)r->ts->peers.size() && n < max; p++)
+    if (p != r->ctx->rank && r->ts->peers[(size_t)p].fd >= 0) fds[n++] = r->ts->peers[(size_t)p].fd;
+  return n;
+}
+// FD_HOLDER's child (after fork: async-signal-safe calls only, no CUDA, no verbs, no allocation): its name gin_fdhold,
+// 0-2 on /dev/null, every other fd closed but its end of the socketpair, the fds taken over SCM_RIGHTS, then 60 s and
+// _exit. The kernel's close_range (5.9) or, without it, close up to the fd limit.
+#define GDAKI_CTRL_FDHOLD_MAX 64
+#define GDAKI_CTRL_FDHOLD_S 60
+static void gdakiCtrlFdHoldCloseFrom(int lo, int hi) {  // [lo, hi]
+  if (lo > hi) return;
+#ifndef SYS_close_range
+#define GDAKI_CTRL_SYS_CLOSE_RANGE 436  // the generic syscall number (x86_64, aarch64)
+#else
+#define GDAKI_CTRL_SYS_CLOSE_RANGE SYS_close_range
+#endif
+  if (syscall(GDAKI_CTRL_SYS_CLOSE_RANGE, (unsigned)lo, (unsigned)hi, 0u) == 0) return;
+  for (int fd = lo; fd <= hi; fd++) (void)close(fd);
+}
+[[noreturn]] static void gdakiCtrlFdHoldChild(int sock) {
+  (void)prctl(PR_SET_NAME, "gin_fdhold", 0, 0, 0);
+  const int nul = open("/dev/null", O_RDWR);
+  if (nul >= 0)
+    for (int k = 0; k < 3; k++) (void)dup2(nul, k);
+  struct rlimit rl;
+  int top = 65535;
+  if (getrlimit(RLIMIT_NOFILE, &rl) == 0 && rl.rlim_cur != RLIM_INFINITY && rl.rlim_cur < (rlim_t)(1u << 20))
+    top = (int)rl.rlim_cur - 1;
+  gdakiCtrlFdHoldCloseFrom(3, sock - 1);
+  gdakiCtrlFdHoldCloseFrom(sock + 1, sock + 1 > top ? sock + 1 : top);
+  char byte = 0;
+  struct iovec io = {&byte, 1};
+  union {
+    char buf[CMSG_SPACE(sizeof(int) * GDAKI_CTRL_FDHOLD_MAX)];
+    struct cmsghdr align;
+  } u;
+  struct msghdr mh;
+  memset(&mh, 0, sizeof(mh));
+  mh.msg_iov = &io;
+  mh.msg_iovlen = 1;
+  mh.msg_control = u.buf;
+  mh.msg_controllen = sizeof(u.buf);
+  (void)recvmsg(sock, &mh, 0);  // the fds stay open in this process (nothing reads or closes them)
+  (void)close(sock);
+  struct timespec t0, t;
+  clock_gettime(CLOCK_MONOTONIC, &t0);
+  do {
+    struct timespec d = {1, 0};
+    (void)nanosleep(&d, nullptr);
+    clock_gettime(CLOCK_MONOTONIC, &t);
+  } while (t.tv_sec - t0.tv_sec < GDAKI_CTRL_FDHOLD_S);
+  _exit(0);
+}
+// FD_HOLDER=sock|uverbs: fork gin_fdhold and pass it this rank's witness sockets (none with the witness off) and, for
+// uverbs, the verbs context's command and async fds (net_ib's context, the ring's QPs'); no PDEATHSIG (the runner ends
+// it by the PID of the line). The line: notes_test.md's, the fd count the child was sent.
+static void gdakiCtrlFdHoldStart(struct gdakiRecHost* r, struct gdakiCtrlRing* g, struct gdakiCtrlRingSw* s, double now) {
+  const struct gdakiCtrlPage* pg = gdakiPageOf(r);
+  const bool witnessOn = pg == nullptr || pg->witnessOn;
+  int fds[GDAKI_CTRL_FDHOLD_MAX];
+  int n = witnessOn ? gdakiCtrlWitnessFds(r, fds, GDAKI_CTRL_FDHOLD_MAX - 2) : 0;
+  const struct ibv_context* ic =
+      (s->fdHold == 2 && r->ctx->collComm != nullptr) ? r->ctx->collComm->ib.context : nullptr;
+  if (ic != nullptr) {
+    if (ic->cmd_fd >= 0) fds[n++] = ic->cmd_fd;
+    if (ic->async_fd >= 0 && ic->async_fd != ic->cmd_fd) fds[n++] = ic->async_fd;
+  }
+  const char* kind = s->fdHold == 2 ? "uverbs" : "sock";
+  int sv[2];
+  if (socketpair(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0, sv) != 0) {
+    WARN("GIN/TS: rank %d: test switch FD_HOLDER=%s: socketpair failed (%s): off", g->me, kind, strerror(errno));
+    return;
+  }
+  fflush(stdout);
+  fflush(stderr);
+  const pid_t pid = fork();
+  if (pid == 0) gdakiCtrlFdHoldChild(sv[1]);
+  (void)close(sv[1]);
+  if (pid < 0) {
+    WARN("GIN/TS: rank %d: test switch FD_HOLDER=%s: fork failed (%s): off", g->me, kind, strerror(errno));
+    (void)close(sv[0]);
+    return;
+  }
+  s->fdHoldPid = (int)pid;
+  char byte = 0;
+  struct iovec io = {&byte, 1};
+  union {
+    char buf[CMSG_SPACE(sizeof(int) * GDAKI_CTRL_FDHOLD_MAX)];
+    struct cmsghdr align;
+  } u;
+  struct msghdr mh;
+  memset(&mh, 0, sizeof(mh));
+  mh.msg_iov = &io;
+  mh.msg_iovlen = 1;
+  if (n > 0) {
+    memset(u.buf, 0, sizeof(u.buf));
+    mh.msg_control = u.buf;
+    mh.msg_controllen = CMSG_SPACE(sizeof(int) * (size_t)n);
+    struct cmsghdr* c = CMSG_FIRSTHDR(&mh);
+    c->cmsg_level = SOL_SOCKET;
+    c->cmsg_type = SCM_RIGHTS;
+    c->cmsg_len = CMSG_LEN(sizeof(int) * (size_t)n);
+    memcpy(CMSG_DATA(c), fds, sizeof(int) * (size_t)n);
+  }
+  if (sendmsg(sv[0], &mh, MSG_NOSIGNAL) != 1) {
+    WARN("GIN/TS: rank %d: test switch FD_HOLDER=%s: the fds were not passed (%s)", g->me, kind, strerror(errno));
+    n = 0;
+  }
+  (void)close(sv[0]);
+  GIN_TS_NOTE("GIN/TS: rank %d: test switch FD_HOLDER=%s: child gin_fdhold pid=%d holds %d fd(s) after_ckpt_ms=%d "
+              "mono_ms=%.3f", g->me, kind, (int)pid, n, (int)(now - g->originMs), gdakiQ4MonoMs());
+}
+// The witness switches at the helper's step after the origin. DIE_RST: linger 0 on every open witness socket, the line,
+// then each closed (a reset to the peer) and this process's SIGKILL. RST_GAP: the switch line only (this build resets no
+// socket and closes no listener: notes_p2a2.md). FD_HOLDER: the fork at the origin.
+static void gdakiCtrlWitnessSwitches(struct gdakiRecHost* r, struct gdakiCtrlRing* g, struct gdakiCtrlRingSw* s,
+                                     double now) {
+  if (s->fdHold != 0 && !s->fdHoldDone) {
+    s->fdHoldDone = true;
+    gdakiCtrlFdHoldStart(r, g, s, now);
+  }
+  if (s->rstGapAtMs >= 0 && !s->rstGapDone && now >= s->rstGapAtMs) {
+    s->rstGapDone = true;
+    GIN_TS_NOTE("GIN/TS: rank %d: test switch RST_GAP: 0 socket(s) reset, listener closed for 0 ms (the line only in "
+                "this build; asked %.0f:%.0f) after_ckpt_ms=%d mono_ms=%.3f", g->me, s->rstGapAfterMs, s->rstGapLenMs,
+                (int)(now - g->originMs), gdakiQ4MonoMs());
+  }
+  if (s->dieRstAtMs >= 0 && !s->dieRstDone && now >= s->dieRstAtMs) {
+    s->dieRstDone = true;
+    int fds[GDAKI_CTRL_FDHOLD_MAX];
+    const int n = gdakiCtrlWitnessFds(r, fds, GDAKI_CTRL_FDHOLD_MAX);
+    const struct linger lg = {1, 0};
+    int lingered = 0;
+    for (int k = 0; k < n; k++) lingered += setsockopt(fds[k], SOL_SOCKET, SO_LINGER, &lg, sizeof(lg)) == 0;
+    GIN_TS_NOTE("GIN/TS: rank %d: test switch DIE_RST: linger 0 on %d socket(s); SIGKILL now after_ckpt_ms=%d "
+                "mono_ms=%.3f", g->me, lingered, (int)(now - g->originMs), gdakiQ4MonoMs());
+    for (int p = 0; r->ts != nullptr && p < (int)r->ts->peers.size(); p++) {
+      struct gdakiTsPeer& pe = r->ts->peers[(size_t)p];
+      if (p == r->ctx->rank || pe.fd < 0) continue;
+      (void)close(pe.fd);
+      pe.fd = -1;
+    }
+    gdakiCtrlTestDieNow(r);
+  }
+}
+#endif  // !NCCL_GIN_TS_PRODUCTION
+// The helper's step once the setup's first pairings started (gdakiCtrlRingHelperStep's last call): the switch to live,
+// the re-pairing of a pair whose record QP this side saw lost (PAIR(record, gen + 1), NCCL_GIN_TS_RECONNECT_MS), the
+// re-paired lines, the test switches.
+static void gdakiCtrlRingLiveStep(struct gdakiRecHost* r) {
+  struct gdakiCtrlRing* g = (r != nullptr && r->ctrl != nullptr) ? r->ctrl->ring : nullptr;
+  if (g == nullptr || r->ts == nullptr || !g->bound || !g->pairingStarted) return;
+  const struct gdakiCtrlPage* pg = gdakiPageOf(r);
+  const double now = gdakiQ4MonoMs();
+  int gated = 0, up = 0;
+  for (int p = 0; p < g->nranks && p < (int)r->ts->peers.size(); p++) {
+    if (p == g->me || !r->ts->peers[(size_t)p].gated) continue;
+    struct gdakiCtrlRdmaPeer& pr = g->peers[(size_t)p];
+    const struct gdakiTsPeer& pe = r->ts->peers[(size_t)p];
+    const bool hasPrb = pg != nullptr && (size_t)p < pg->peers.size() && pg->peers[(size_t)p].hasQp;
+    gated++;
+    if (gdakiCtrlRingUp(&pr.ring) && pr.pairRec.state == GDAKI_CTRL_PS_UP &&
+        (!hasPrb || pr.prb.st.state == GDAKI_CTRL_PS_UP))
+      up++;
+    // a local loss of this generation: this side starts the re-pairing (design v3 2.5: the side that saw the ERR)
+    if (pr.ring.lost && pr.ring.gen != 0 && pr.askedGen != pr.ring.gen && !pe.declined && !pe.left && !pe.gone &&
+        gdakiLnOf(r, p).phase == GDAKI_LN_LIVE) {
+      pr.askedGen = pr.ring.gen;
+      const uint32_t was = pr.pairRec.lastMine;
+      gdakiCtrlRdmaPairOnErr(g, p, GDAKI_CTRL_PAIR_QP_RECORD, pr.ring.gen, (double)ncclParamGinTsReconnectMs());
+      if (pr.pairRec.lastMine != was)
+        GIN_TS_NOTE("GIN/RC: rank %d: PAIR(record, gen %u) to rank %d (local ERR) mono_ms=%.3f", g->me,
+                    pr.pairRec.lastMine, p, gdakiQ4MonoMs());
+    }
+    if (gdakiCtrlRingUp(&pr.ring) && pr.ring.gen > pr.shownRec) {
+      pr.shownRec = pr.ring.gen;
+      pr.repairs++;
+      GIN_TS_NOTE("GIN/RC: rank %d: record QP to rank %d re-paired (gen %u) mono_ms=%.3f", g->me, p, pr.ring.gen,
+                  gdakiQ4MonoMs());
+    }
+    if (pr.prb.st.state == GDAKI_CTRL_PS_UP && pr.prb.st.cur > pr.shownPrb) {
+      pr.shownPrb = pr.prb.st.cur;
+      GIN_TS_NOTE("GIN/RC: rank %d: liveness READ QP to rank %d re-paired (gen %u) mono_ms=%.3f", g->me, p,
+                  pr.prb.st.cur, gdakiQ4MonoMs());
+    }
+  }
+  if (!g->live && gated > 0 && up == gated && (!g->setup.spare || g->spareRejoined)) {  // 2a-2-C: the accepted spare
+    g->live = true;  // from now the records go on the ring (both pairings of every gated peer CONNECTED)
+    r->ctrlTcp.live.store(true, std::memory_order_release);  // the summary's TCP bytes after live count from here
+    for (int p = 0; p < g->nranks && p < (int)r->ts->peers.size(); p++)  // phase 2a-2-C: each pair's path, its marker
+      if (p != g->me && r->ts->peers[(size_t)p].gated) (void)gdakiCtrlPathSet(r, p, GDAKI_CTRL_PM_RING);
+    GIN_TS_NOTE("GIN/RC: rank %d: the records go on the ring from now (live): %d peer(s), record and liveness READ QPs "
+                "paired; the helper sockets are the witness's mono_ms=%.3f", g->me, gated, gdakiQ4MonoMs());
+    if (gdakiPageUp(pg))  // 2a-2-C step 4: the judgement is the reaction from now (gdakiCtrlEffOn, gdakiCtrlEffPoll)
+      GIN_TS_NOTE("GIN/RC: rank %d: the judgement table decides an exit from now: a witness FIN or RST opens the confirm "
+                  "window (W=%d ms) and the hold starts on its verdict (rows 3-6) or on the launcher's EXITED or FENCED, "
+                  "never on the FIN alone; L reads the launcher pages (pullOk); a pair without a live ring keeps ln4's "
+                  "witness rule mono_ms=%.3f", g->me, pg->wMs, gdakiQ4MonoMs());
+  }
+  if (!g->live) return;
+  struct gdakiCtrlRingSw* s = gdakiCtrlRingSwOf(g);
+  if (g->originMs < 0 && gdakiCtrlArmedNow(r)) {
+    g->originMs = now;
+    if (s->qpErrAfterMs >= 0) s->qpErrAtMs = now + s->qpErrAfterMs;
+    if (s->stallAfterMs >= 0) {
+      s->stallFromMs = now + s->stallAfterMs;
+      s->stallToMs = s->stallFromMs + s->stallLenMs;
+    }
+    if (s->dieRstAfterMs >= 0) s->dieRstAtMs = now + s->dieRstAfterMs;
+    if (s->rstGapAfterMs >= 0) s->rstGapAtMs = now + s->rstGapAfterMs;
+  }
+  if (s->qpErrAtMs >= 0 && !s->qpErrDone && now >= s->qpErrAtMs) {
+    s->qpErrDone = true;
+    gdakiCtrlRdmaRecordToErr(g, s->qpErrPeer);
+    GIN_TS_NOTE("GIN/RC: rank %d: test switch QP_ERR: record QP to rank %d moved to ERR mono_ms=%.3f", g->me,
+                s->qpErrPeer, gdakiQ4MonoMs());
+  }
+  if (s->stallFromMs >= 0 && !s->stallLogged && now >= s->stallFromMs) {
+    s->stallLogged = true;
+    GIN_TS_NOTE("GIN/RC: rank %d: test switch CREDIT_STALL: no RECV re-posted for %d ms mono_ms=%.3f", g->me,
+                (int)s->stallLenMs, gdakiQ4MonoMs());
+  }
+#ifndef NCCL_GIN_TS_PRODUCTION
+  if (g->originMs >= 0) gdakiCtrlWitnessSwitches(r, g, s, now);
+#endif
+}
+// The teardown's lines (the helper's end; rows_gc.py CTRLSUM, RINGSUM): the control summary (every process of the rdma
+// build, with or without a ring) and one ring summary per paired peer.
+static void gdakiCtrlRingSummary(struct gdakiRecHost* r) {
+  if (r == nullptr || r->ctx == nullptr) return;
+  struct gdakiCtrlRing* g = (r->ctrl != nullptr) ? r->ctrl->ring : nullptr;
+  const struct gdakiCtrlPage* pg = gdakiPageOf(r);
+  const int me = r->ctx->rank;
+  uint32_t open = 0;
+  if (r->ts != nullptr)
+    for (size_t p = 0; p < r->ts->peers.size(); p++) open += (int)p != me && r->ts->peers[p].fd >= 0;
+  const bool live = g != nullptr && g->live;
+  uint64_t lost = 0, dup = 0, deferred = 0, asyncRec = 0, asyncRead = 0;
+  uint32_t repairs = 0;
+  if (g != nullptr) {
+    if (g->cq != nullptr) asyncRec += (uint64_t)__atomic_load_n(&g->cq->stats.fatalErrorCount, __ATOMIC_RELAXED);
+    for (int p = 0; p < g->nranks; p++) {
+      if (p == g->me) continue;
+      const struct gdakiCtrlRdmaPeer& pr = g->peers[(size_t)p];
+      lost += pr.ring.queuedDropped + pr.ring.oldDropped;
+      dup += pr.ring.oldEnvelopes;
+      deferred += pr.deferred;
+      repairs += pr.repairs;
+      if (pr.q != nullptr) asyncRec += (uint64_t)__atomic_load_n(&pr.q->stats.fatalErrorCount, __ATOMIC_RELAXED);
+    }
+  }
+  if (pg != nullptr)
+    for (const struct gdakiCtrlPeerProbe& pp : pg->peers)
+      if (pp.qp.q != nullptr) asyncRead += (uint64_t)__atomic_load_n(&pp.qp.q->stats.fatalErrorCount, __ATOMIC_RELAXED);
+  const uint32_t mtu = g != nullptr ? g->setup.activeMtu : (uint32_t)r->ctx->port_attr.active_mtu;
+  char rx[1024] = {0};
+  size_t o = 0;
+  for (int p = 0; p < r->nranks && p < GDAKI_CTRL_TCP_COUNT_PEERS && o + 48 < sizeof(rx); p++)
+    if (p != me)
+      o += (size_t)snprintf(rx + o, sizeof(rx) - o, " tcp_rx_bytes_peer%d=%llu", p,
+                            (unsigned long long)r->ctrlTcp.rxPeer[p].load(std::memory_order_relaxed));
+  // the split by the moment the ring went live (the live part first: a total read after it is never below it)
+  const uint64_t recLive = r->ctrlTcp.recordBytesLive.load(std::memory_order_relaxed),
+                 datLive = r->ctrlTcp.dataBytesLive.load(std::memory_order_relaxed),
+                 recAll = r->ctrlTcp.recordBytes.load(std::memory_order_relaxed),
+                 datAll = r->ctrlTcp.dataBytes.load(std::memory_order_relaxed);
+  GIN_TS_NOTE("GIN/RC: rank %d: control summary tcp_record_bytes=%llu tcp_data_bytes=%llu tcp_conns=%u witness_conns=%u "
+              "records_lost=%u records_dup=%u repairs=%u sendq_deferred=%u sendq_max=%u rnr=%u async=%u active_mtu=%u"
+              "%s async_rec=%llu async_read=%llu async_la=0 tcp_late_records=%llu tcp_record_bytes_prelive=%llu "
+              "tcp_record_bytes_live=%llu tcp_data_bytes_prelive=%llu tcp_data_bytes_live=%llu live=%d mono_ms=%.3f",
+              me, (unsigned long long)recAll, (unsigned long long)datAll, live ? 0u : open, open,
+              (unsigned)lost, (unsigned)dup, repairs, (unsigned)deferred, (unsigned)(g != nullptr ? g->sendqMax : 0),
+              (unsigned)gdakiCtrlRdmaRnr(g), (unsigned)(asyncRec + asyncRead), mtu, rx, (unsigned long long)asyncRec,
+              (unsigned long long)asyncRead, (unsigned long long)r->ctrlTcp.lateRecords.load(std::memory_order_relaxed),
+              (unsigned long long)(recAll >= recLive ? recAll - recLive : 0), (unsigned long long)recLive,
+              (unsigned long long)(datAll >= datLive ? datAll - datLive : 0), (unsigned long long)datLive, live ? 1 : 0,
+              gdakiQ4MonoMs());
+  if (g == nullptr) return;
+  for (int p = 0; p < g->nranks; p++) {
+    const struct gdakiCtrlRdmaPeer& pr = g->peers[(size_t)p];
+    if (p == g->me || pr.ring.gen == 0) continue;
+    GIN_TS_NOTE("GIN/RC: rank %d: ring summary peer=%d gen=%u sent=%llu received=%llu lost=%u dup=%u mono_ms=%.3f", me, p,
+                pr.ring.gen, (unsigned long long)pr.txRecords, (unsigned long long)pr.rxRecords,
+                (unsigned)(pr.ring.queuedDropped + pr.ring.oldDropped), (unsigned)pr.ring.oldEnvelopes, gdakiQ4MonoMs());
+  }
+}
+#endif  // !NCCL_GIN_CTRL_TCP
+// ==== gin-control (ring): live seams (end) ====
+// ==== gin-control (ring): the helper's live loop (begin; phase 2a-2-B) ====
+// The idle loop's poll block while the ring is live (gdakiTsMain): the witness sockets and the completion channel's fd in
+// one poll (1 ms), the witness's socket read for the witness alone (gdakiCtrlWitnessPump: BYE, FIN, a late record), then
+// every gated peer's inbox through gdakiCtrlPump, each record handled as the idle loop handles it. A -1 of the pump is a
+// lost record connection: nothing more here (no round runs; the re-pairing is the helper's step's, the witness stays).
+#if !NCCL_GIN_CTRL_TCP
+static bool gdakiCtrlArmedNow(struct gdakiRecHost* r) {
+  return r->hold == nullptr || r->hold->commArmed.load(std::memory_order_acquire) != 0;
+}
+#ifndef NCCL_GIN_TS_PRODUCTION
+static void gdakiCtrlTestDieNow(struct gdakiRecHost*) {  // DIE_RST (the live seams' gdakiCtrlWitnessSwitches)
+  fflush(stdout);
+  fflush(stderr);
+  kill(getpid(), SIGKILL);
+}
+#endif
+static void gdakiCtrlIdleRecord(struct gdakiRecHost* r, int p, struct gdakiTsPeer& pe, const struct gdakiTsMsg& msg) {
+  struct gdakiTsMsg m = msg;
+  if (m.type == GDAKI_TS_REQ && m.from == p) gdakiTsRespond(r, p, m);
+  else if (m.type == GDAKI_TS_FAIL) {
+    if (!pe.declined) gdakiTsDecline(r, p, "the peer declined", false, m.arg, gdakiTsRemoteCause(m));
+  } else if (m.type == GDAKI_TS_BYE) {  // the ring's BYE (design v3 2.4: leaving is told by the ring's BYE)
+    pe.left = true;
+    GIN_TS_NOTE("GIN/TS: rank %d: rank %d left the communicator (BYE) mono_ms=%.3f", r->ctx->rank, p, gdakiQ4MonoMs());
+  } else if (gdakiHoldDefer(r, p, &m)) {  // parked; gdakiHoldStep takes it
+  } else
+    INFO(NCCL_NET, "GIN/TS: ignoring %s from rank %d while idle", gdakiTsMsgName(m.type), p);
+}
+static bool gdakiCtrlHelperLiveStep(struct gdakiRecHost* r, std::vector<struct pollfd>& pfds, std::vector<int>& who) {
+  if (gdakiCtrlRingLive(r) == nullptr) return false;
+  struct gdakiTs* ts = r->ts;
+  const size_t wake = gdakiCtrlWakeFdAdd(r, pfds);
+  (void)poll(pfds.data(), pfds.size(), 1);
+  gdakiCtrlWakeTake(r, pfds, wake);
+  struct gdakiTsMsg msg;
+  for (size_t k = 0; k < who.size() && k < pfds.size(); k++) {
+    if (!(pfds[k].revents & (POLLIN | POLLERR | POLLHUP))) continue;
+    const int p = who[k];
+    struct gdakiTsPeer& pe = ts->peers[p];
+    int got;
+    while ((got = gdakiCtrlWitnessPump(r, p, pe, &msg)) == 1) gdakiCtrlIdleRecord(r, p, pe, msg);
+    if (got < 0 && !pe.gone && pe.fd >= 0) (void)gdakiTsSocketLost(r, p);  // the witness, judged as before
+  }
+  for (int p = 0; p < (int)ts->peers.size(); p++) {
+    struct gdakiTsPeer& pe = ts->peers[p];
+    if (p == r->ctx->rank || !pe.gated || pe.declined) continue;
+    while (gdakiCtrlPump(r, p, pe, &msg) == 1) {
+      gdakiCtrlIdleRecord(r, p, pe, msg);
+      if (!gdakiCtrlChanUp(r, p, pe) || pe.declined) break;
+    }
+  }
+  return true;
+}
+#endif  // !NCCL_GIN_CTRL_TCP
+// ==== gin-control (ring): the helper's live loop (end) ====
+// ---- [2] ring (end) ----
+
+// ---- [3] launcher: placeholders phase 3 replaces (begin) ----
+// Phase 3 replaced them in place: gdakiCtrlOnHoldStart, gdakiCtrlLauncherSend and gdakiCtrlLauncherFree are in the region
+// below, with the rest of the rank side of the launcher (impl/notes_p3.md).
+// ==== gin-control (launcher): the rank side of the launcher (begin; impl/notes_p3.md) ====
+// ---- gin-control: launcher wire (begin; impl/launcher/launcher_msg.h, byte for byte) ----
+/* launcher_msg.h - the wire of the per-node launcher (gin-control, EXPERIMENT.md 9.5; design v2 2.3, 2.5, 5.2, 5.4).
+ *
+ * Self-contained C/C++ header: plain structs, fixed-width types, no NCCL, no verbs. Included by
+ * control/impl/rs_ctrl_api.h as "launcher/launcher_msg.h" (the rank side) and by gin_launcher.c (the launcher).
+ *
+ * Two wires:
+ *   1. the node-local Unix socket (SOCK_SEQPACKET, one message per datagram, SCM_RIGHTS for the pidfd): struct
+ *      glUnixMsg, 256 B, kinds GL_U_* (the seven rows of EXPERIMENT.md 9.5's table and the nonce-free INFO and its
+ *      answer, impl/notes_p3.md "고침"); only GL_U_ACT_BYTES carries
+ *      a payload after its 256 B (the activation blob, at most GL_U_MAX_PAYLOAD bytes);
+ *   2. the RNIC side (the launcher's UD QP for pairing, one RC QP per rank for everything else): struct glMsg, 256 B
+ *      (design v2 2.3: "the launcher's message is a fixed 256 B structure"), kinds GL_K_*. On the wire every UD
+ *      datagram and every RC SEND starts with the 64 B control envelope (struct glCtrlEnv, the same bytes as design
+ *      v2 2.3's gdakiCtrlEnv), then the 256 B glMsg: 320 B, far under the UD limit of path MTU >= 2048.
+ *
+ * Choices this header makes where the design leaves a size or value open (the rank side must match them):
+ *   - glMsg = 64 B head + 192 B body; glUnixMsg = 64 B head + 192 B body.
+ *   - envelope kinds: GL_ENV_KIND_LAUNCHER 4 (RC), GL_ENV_KIND_PAIR 5 (UD); RECORD 1, XFER 2, XFER_DONE 3 and the
+ *     rank-rank CONNECTED 6 are the record path's (owned by rs_ctrl_api.h; this header follows its numbers).
+ *   - envelope `from` of a launcher: GL_FROM_LAUNCHER | node (design v2 2.3).
+ *   - the launcher's Q_Key: its own 31-bit value (design v2 2.5 last line), handed out in GL_U_HELLO_ACK.
+ *   - GL_U_MAX_PAYLOAD 65536: the activation blob (gdakiMiActHdr + 40 B x nranks + 40 B x nExt <= 256) fits up to
+ *     about 1 370 ranks.
+ *   - the relayed activation-talk payloads are opaque here; their sizes are fixed below (GL_ACT_RECORD_BYTES etc.) so
+ *     rs_ctrl_api.h can static_assert them against gdakiRsActivate, gdakiMiActAnswer, gdakiMiActReady, gdakiMiActDone.
+ */
+#ifndef GIN_LAUNCHER_MSG_H
+#define GIN_LAUNCHER_MSG_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+#define GL_STATIC_ASSERT(c, m) static_assert(c, m)
+#else
+#define GL_STATIC_ASSERT(c, m) _Static_assert(c, m)
+#endif
+
+#define GL_WIRE_VERSION 1u
+
+/* ---------------------------------------------------------------------------------------------------------------
+ * Shared pieces
+ * ------------------------------------------------------------------------------------------------------------- */
+
+/* A QP endpoint: the same 40 bytes as rs_ctrl_api.h's gdakiCtrlEndpoint (version 2 of gin-mirror's gdakiMiQpEndpoint,
+ * whose last 4 B were pad 0). RC: psn = the initial send PSN (fresh for every QP); UD: psn = the Q_Key. */
+#define GL_EP_VERSION 2u
+#define GL_QPT_RC 2u /* IBV_QPT_RC */
+#define GL_QPT_UD 4u /* IBV_QPT_UD */
+struct glEp {
+  uint32_t qpn, psn;
+  uint32_t lid;
+  int32_t mtu;       /* enum ibv_mtu */
+  uint8_t gid[16];   /* RoCE/IB GID */
+  int32_t gidIndex;
+  uint8_t version;   /* GL_EP_VERSION */
+  uint8_t qpType;    /* GL_QPT_RC or GL_QPT_UD */
+  uint16_t rsv;
+};
+GL_STATIC_ASSERT(sizeof(struct glEp) == 40, "a QP endpoint is 40 bytes (gdakiMiQpEndpoint)");
+
+/* A remote-readable region (the launcher's state page, a rank's outbox half). */
+struct glRegion {
+  uint64_t addr;
+  uint32_t rkey; /* host order */
+  uint32_t len;
+};
+GL_STATIC_ASSERT(sizeof(struct glRegion) == 16, "a region is 16 bytes");
+
+/* The activation record: the same 64 bytes as struct gdakiRsActivate (gin_host_gdaki.cc ln4 8889), kinds as its enum
+ * (4583). The launcher reads and writes only magic, version, kind, rank, incarnation, nonce, step; it answers with the
+ * buddy's record echoed (rank, incarnation, nonce, step) and kind LATER or REFUSED when it answers itself. */
+#define GL_RS_ACT_MAGIC 0x41535247u /* "GRSA" */
+enum { GL_RS_ACT_ACTIVATE = 1, GL_RS_ACT_ABANDON = 2, GL_RS_ACT_ACCEPTED = 3, GL_RS_ACT_REFUSED = 4, GL_RS_ACT_LATER = 5 };
+struct glRsActivate {
+  uint32_t magic, version;
+  uint32_t kind, pad;
+  int32_t rank;
+  uint32_t incarnation; /* the new incarnation (dead + 1) */
+  uint64_t nonce;
+  uint64_t step;
+  int64_t pid;          /* unused on the launcher path (the launcher holds the pidfd); 0 */
+  uint64_t pidStart;    /* unused on the launcher path; 0 */
+  uint64_t reserved;
+};
+GL_STATIC_ASSERT(sizeof(struct glRsActivate) == 64, "the activation record is 64 bytes (gdakiRsActivate)");
+
+/* Opaque relayed payloads of the activation talk (the bytes of today's TCP activation connection). */
+#define GL_ACT_RECORD_BYTES 64u   /* gdakiRsActivate */
+#define GL_FETCH_EP_BYTES 112u    /* gdakiMiActAnswer: magic, ok, gdakiMiQpEndpoint, why[64] */
+#define GL_FETCH_READY_BYTES 72u  /* gdakiMiActReady: magic, kind, why[64] */
+#define GL_FETCH_DONE_BYTES 80u   /* gdakiMiActDone: magic, ok, bytes, why[64] */
+
+/* Reason codes (glMsg.reason, glUnixMsg.h.reason). The text of each is gl_reason_text below. */
+enum glReason {
+  GL_R_NONE = 0,
+  GL_R_SPAWN_NOT_BUILT = 1,     /* SPAWN: this experiment's launcher does not spawn ("spawn not built") */
+  GL_R_NO_SPARE = 2,            /* ACTIVATE: no pre-launched spare said HELLO for (rank, incarnation) */
+  GL_R_SPARE_REPLAYING = 3,     /* LATER: the spare said HELLO, not READY yet */
+  GL_R_SPARE_EXITED = 4,        /* the spare's pidfd became readable */
+  GL_R_REPLAY_FAILED = 5,       /* the spare reported a replay failure */
+  GL_R_SPARE_REFUSED = 6,       /* the spare answered REFUSED (its record is relayed) */
+  GL_R_NOT_REGISTERED = 7,      /* no registration of (nonce, rank) here */
+  GL_R_NONCE = 8,               /* nonce differs from the registration or the asker's pairing */
+  GL_R_INCARNATION = 9,         /* incarnation is not the registered one (+1 for an activation) */
+  GL_R_ALREADY_OFFERED = 10,    /* a second ACTIVATE for the same (rank, incarnation) */
+  GL_R_ORIGINAL_ALIVE = 11,     /* ACTIVATE while the registered original's pidfd is not readable (guard) */
+  GL_R_DUPLICATE = 12,          /* a second connection with the same (rank, incarnation) */
+  GL_R_STALE = 13,              /* an incarnation older than (or equal to) one already seen */
+  GL_R_UID = 14,                /* SO_PEERCRED uid differs from the launcher's */
+  GL_R_BAD_FD = 15,             /* no fd, not a pidfd, or more than one fd */
+  GL_R_BAD_MSG = 16,            /* magic, version, kind or size wrong */
+  GL_R_OLDER_ALIVE = 17,        /* re-registration while the older incarnation's process is alive */
+  GL_R_NOT_HELD = 18,           /* FENCE: no pidfd of (rank, incarnation) held, nothing signalled */
+  GL_R_ALREADY_EXITED = 19,     /* FENCED: the process had exited before the FENCE */
+  GL_R_FENCE_KILLED = 20,       /* FENCED: the launcher sent SIGKILL through the pidfd and saw the group end */
+  GL_R_ALREADY_LEFT = 21,       /* FENCED: the process had left (LEAVING then exit) */
+  GL_R_SPARE_NOT_ACTIVATED = 22,/* re-registration of a spare's incarnation before its activation was accepted */
+  GL_R_PID_MISMATCH = 23,       /* the pidfd's process is not the connection's peer */
+  GL_R_ABORTED = 24,            /* the buddy aborted the activation (hold deadline) or its launcher QP failed */
+  GL_R_SEND_FAILED = 25,        /* the launcher could not hand the bytes to the spare */
+  GL_R_BLOB_READ_FAILED = 26,   /* the RDMA READ of the buddy's outbox failed */
+  GL_R_BLOB_TOO_BIG = 27,       /* the blob exceeds GL_U_MAX_PAYLOAD */
+  GL_R_TABLE_FULL = 28,         /* no free slot */
+  GL_R_SELF_EXIT = 29,          /* EXITED: the group ended without a FENCE or LEAVING */
+  GL_R_PAIR_STALE = 30,         /* PAIR of an older generation or incarnation than the paired one */
+  GL_R_UNKNOWN_KIND = 31,
+  GL_R_COUNT
+};
+
+static inline const char* gl_reason_text(uint32_t r) {
+  switch (r) {
+    case GL_R_NONE: return "none";
+    case GL_R_SPAWN_NOT_BUILT: return "spawn not built";
+    case GL_R_NO_SPARE: return "no pre-launched spare for this rank and incarnation";
+    case GL_R_SPARE_REPLAYING: return "the spare is replaying";
+    case GL_R_SPARE_EXITED: return "the spare exited";
+    case GL_R_REPLAY_FAILED: return "the spare's replay failed";
+    case GL_R_SPARE_REFUSED: return "the spare refused";
+    case GL_R_NOT_REGISTERED: return "not registered here";
+    case GL_R_NONCE: return "nonce mismatch";
+    case GL_R_INCARNATION: return "incarnation mismatch";
+    case GL_R_ALREADY_OFFERED: return "already offered";
+    case GL_R_ORIGINAL_ALIVE: return "the original process is still alive";
+    case GL_R_DUPLICATE: return "second connection with the same rank and incarnation";
+    case GL_R_STALE: return "stale incarnation";
+    case GL_R_UID: return "peer uid differs";
+    case GL_R_BAD_FD: return "no pidfd";
+    case GL_R_BAD_MSG: return "malformed message";
+    case GL_R_OLDER_ALIVE: return "the older incarnation is still alive";
+    case GL_R_NOT_HELD: return "no pidfd held for this rank and incarnation";
+    case GL_R_ALREADY_EXITED: return "already exited";
+    case GL_R_FENCE_KILLED: return "killed through the pidfd";
+    case GL_R_ALREADY_LEFT: return "already left";
+    case GL_R_SPARE_NOT_ACTIVATED: return "the spare's activation was not accepted";
+    case GL_R_PID_MISMATCH: return "the pidfd is not the peer's process";
+    case GL_R_ABORTED: return "aborted";
+    case GL_R_SEND_FAILED: return "could not hand over to the spare";
+    case GL_R_BLOB_READ_FAILED: return "reading the activation blob failed";
+    case GL_R_BLOB_TOO_BIG: return "activation blob too large";
+    case GL_R_TABLE_FULL: return "table full";
+    case GL_R_SELF_EXIT: return "exited";
+    case GL_R_PAIR_STALE: return "stale pairing";
+    case GL_R_UNKNOWN_KIND: return "unknown kind";
+    default: return "?";
+  }
+}
+
+/* ---------------------------------------------------------------------------------------------------------------
+ * 1. The node-local Unix socket (EXPERIMENT.md 9.5's table: seven rows, plus INFO and INFO_ACK = nine kinds)
+ * ------------------------------------------------------------------------------------------------------------- */
+
+#define GL_U_MAGIC 0x554c5247u /* "GRLU" */
+#define GL_U_MAX_PAYLOAD 65536u
+/* Socket path: the launcher's --sock argument, else this variable; the rank side reads the same variable. The path's
+ * directory must be the user's own with mode 0700 (the launcher creates it so and refuses anything else). */
+#define GL_SOCK_ENV "NCCL_GIN_CTRL_LAUNCHER_SOCK"
+#define GL_NODE_ENV "NCCL_GIN_CTRL_LAUNCHER_NODE"
+
+enum glUnixKind {
+  GL_U_REGISTER = 1,     /* rank -> launcher: (rank, incarnation, nonce) + its own pidfd (SCM_RIGHTS); uid by SO_PEERCRED */
+  GL_U_HELLO_ACK = 2,    /* launcher -> rank or spare: the answer to REGISTER and SPARE_HELLO (body glUHelloAck) */
+  GL_U_LEAVING = 3,      /* rank -> launcher: (rank, incarnation), before BYE, when the communicator is destroyed */
+  GL_U_SPARE_HELLO = 4,  /* spare -> launcher: (rank, new incarnation, nonce) + its own pidfd; second (rank, inc) refused */
+  GL_U_SPARE_STATUS = 5, /* spare -> launcher: sub GL_US_READY (replay, FETCH buffer join, Resume entry done) or
+                            GL_US_REPLAY_FAILED (body: why) */
+  GL_U_ACT_BYTES = 6,    /* launcher -> spare: body = the 64 B activation record, payload = the activation blob */
+  GL_U_ACT_TALK = 7,     /* spare <-> launcher: sub GL_UT_* (answer, FETCH QP endpoint, READY, DONE, ABORT) */
+  GL_U_INFO = 8,         /* rank -> launcher, before the all-gather (impl/notes_p3.md "고침"): head only (bodyBytes 0, no
+                            payload, no fd), nonce 0, incarnation 0, rank = the sender. Nonce-free: no registration entry,
+                            no page slot, no count of REGISTER's; any connection, before, without or after a REGISTER */
+  GL_U_INFO_ACK = 9      /* launcher -> rank, the same connection: head echoes INFO's rank, incarnation and nonce, sub =
+                            GL_U_INFO, reason; body glUHelloAck (GL_UA_OK: node, qkey, pageSlot 0xffffffff, ud, page,
+                            why "ok"; GL_UA_REFUSED: reason GL_R_UID, GL_R_BAD_FD (an fd came with it) or GL_R_BAD_MSG) */
+};
+/* Layout note: kinds 8 and 9 were added after 897641f3 (GL_U_KIND_MAX 7 -> 9). No size, field or GL_WIRE_VERSION
+ * change: every Unix message stays 256 B and glUHelloAck 136 B; a launcher of 897641f3 drops INFO as an unknown kind. */
+#define GL_U_KIND_MAX 9
+GL_STATIC_ASSERT(GL_U_KIND_MAX == GL_U_INFO_ACK, "GL_U_KIND_MAX is the last Unix kind");
+
+enum { GL_US_READY = 1, GL_US_REPLAY_FAILED = 2 };
+enum {
+  GL_UT_ANSWER = 1,      /* spare -> launcher: 64 B gdakiRsActivate (ACCEPTED, LATER or REFUSED) */
+  GL_UT_FETCH_EP = 2,    /* spare -> launcher: 112 B gdakiMiActAnswer (its FETCH QP endpoint) */
+  GL_UT_FETCH_READY = 3, /* launcher -> spare: 72 B gdakiMiActReady (from the buddy) */
+  GL_UT_FETCH_DONE = 4,  /* spare -> launcher: 80 B gdakiMiActDone */
+  GL_UT_ABORT = 5        /* launcher -> spare: the buddy gave up (hold deadline, its launcher QP failed); no body */
+};
+enum { GL_UA_OK = 0, GL_UA_REFUSED = 1 }; /* glUHelloAck.status */
+
+struct glUnixHdr {
+  uint32_t magic;        /* GL_U_MAGIC */
+  uint16_t version;      /* GL_WIRE_VERSION */
+  uint16_t kind;         /* GL_U_* */
+  int32_t rank;
+  uint32_t incarnation;
+  uint64_t nonce;
+  uint32_t sub;          /* GL_US_*, GL_UT_*, or 0 */
+  uint32_t reason;       /* GL_R_* */
+  uint32_t payloadBytes; /* bytes after the 256 B message (GL_U_ACT_BYTES only) */
+  uint16_t bodyBytes;    /* used bytes of body[] */
+  uint16_t flags;
+  int64_t pid;           /* the sender's getpid(), for the log only (identity is SO_PEERCRED and the pidfd) */
+  uint64_t monoNs;       /* the sender's CLOCK_MONOTONIC */
+  uint64_t rsv;
+};
+GL_STATIC_ASSERT(sizeof(struct glUnixHdr) == 64, "the Unix message head is 64 bytes");
+
+#define GL_U_BODY_BYTES 192u
+struct glUnixMsg {
+  struct glUnixHdr h;
+  uint8_t body[GL_U_BODY_BYTES];
+};
+GL_STATIC_ASSERT(sizeof(struct glUnixMsg) == 256, "a Unix-socket message is 256 bytes");
+
+/* GL_U_HELLO_ACK's and GL_U_INFO_ACK's body: the launcher's node number, UD endpoint and Q_Key (EXPERIMENT.md 9.5 row
+ * 2), its state page, and which page registration slot is (rank)'s (INFO_ACK: always 0xffffffff, no slot is bound). */
+struct glUHelloAck {
+  uint32_t status;       /* GL_UA_* (reason in the head) */
+  uint32_t node;
+  uint32_t qkey;         /* the launcher UD QP's own Q_Key */
+  uint32_t pageSlot;     /* the index of (rank)'s glPageReg on the launcher page (0xffffffff: none) */
+  struct glEp ud;        /* the launcher's UD QP (qpn; psn unused) */
+  struct glRegion page;  /* the launcher's state page (REMOTE_READ) */
+  char why[64];
+};
+GL_STATIC_ASSERT(sizeof(struct glUHelloAck) == 136, "glUHelloAck is 136 bytes");
+GL_STATIC_ASSERT(sizeof(struct glUHelloAck) <= GL_U_BODY_BYTES, "glUHelloAck fits a Unix body");
+GL_STATIC_ASSERT(GL_ACT_RECORD_BYTES <= GL_U_BODY_BYTES && GL_FETCH_EP_BYTES <= GL_U_BODY_BYTES &&
+                     GL_FETCH_READY_BYTES <= GL_U_BODY_BYTES && GL_FETCH_DONE_BYTES <= GL_U_BODY_BYTES,
+                 "every relayed activation-talk payload fits a Unix body");
+
+/* ---------------------------------------------------------------------------------------------------------------
+ * 2. The RNIC side: control envelope + 256 B launcher message
+ * ------------------------------------------------------------------------------------------------------------- */
+
+#define GL_ENV_MAGIC 0x45435247u /* "GRCE" (design v2 2.3) */
+/* GL_ENV_KIND_CONNECTED 6: rs_ctrl_api.h's bodiless first RC SEND of a rank-rank record QP (design v3 2.5 step 3); never
+ * to or from a launcher (gl_env_check refuses it: a launcher's CONNECTED is GL_K_CONNECTED inside a LAUNCHER message). */
+enum { GL_ENV_KIND_RECORD = 1, GL_ENV_KIND_XFER = 2, GL_ENV_KIND_XFER_DONE = 3, GL_ENV_KIND_LAUNCHER = 4,
+       GL_ENV_KIND_PAIR = 5, GL_ENV_KIND_CONNECTED = 6 };
+#define GL_FROM_LAUNCHER 0x40000000 /* envelope `from` of a launcher: GL_FROM_LAUNCHER | node */
+
+/* The 64 B control envelope, the same field order as design v2 2.3's gdakiCtrlEnv (rs_ctrl_api.h should static_assert
+ * the offsets equal). Design v2 lists magic .. bodyBytes plus rsv[8], which sums to 56 B against its stated 64 B; this
+ * header keeps the stated 64 B by rsv[16] (offsets of every named field unchanged). For the launcher's own traffic:
+ * gen = the pairing's generation, seq from 1 per (QP, direction, gen), ackSeq = how many of the other side's messages
+ * this side consumed (credit), bodyBytes = 256. */
+struct glCtrlEnv {
+  uint32_t magic;
+  uint16_t version, kind;
+  int32_t from;
+  uint32_t gen;
+  uint64_t seq;
+  uint64_t ackSeq;
+  uint64_t nonce;
+  uint32_t incarnation;
+  uint32_t bodyBytes;
+  uint8_t rsv[16];
+};
+GL_STATIC_ASSERT(sizeof(struct glCtrlEnv) == 64, "the control envelope is 64 bytes");
+GL_STATIC_ASSERT(offsetof(struct glCtrlEnv, from) == 8 && offsetof(struct glCtrlEnv, gen) == 12 &&
+                     offsetof(struct glCtrlEnv, seq) == 16 && offsetof(struct glCtrlEnv, ackSeq) == 24 &&
+                     offsetof(struct glCtrlEnv, nonce) == 32 && offsetof(struct glCtrlEnv, incarnation) == 40 &&
+                     offsetof(struct glCtrlEnv, bodyBytes) == 44,
+                 "envelope offsets as design v2 2.3");
+
+#define GL_MAGIC 0x414c5247u /* "GRLA" */
+enum glKind {
+  GL_K_PAIR = 1,        /* UD, either side may start (REVIEW2 block 4): sub = GL_PAIR_RECORD or GL_PAIR_PROBE, body
+                           glPairBody (subject rank, its incarnation, nonce in the head; the QP carries a fresh PSN) */
+  GL_K_PAIR_ACK = 2,    /* UD answer: same sub, body glPairAckBody; the same PAIR again gets the same answer */
+  GL_K_CONNECTED = 3,   /* RC, the record QP's first message, from the side that started the pairing; the other side
+                           sends nothing on that QP before it (design v2 2.5 step 3) */
+  GL_K_REG_NOTE = 4,    /* launcher -> ranks: the registration word and the spare word of (rank) (glRegNoteBody); on
+                           every change and to a newly connected rank (the same words are on the launcher page) */
+  GL_K_EXITED = 5,      /* launcher -> every rank of that nonce: (rank, incarnation, nonce) of the head ended, no FENCE
+                           and no LEAVING before; never for a spare that was not accepted as the rank */
+  GL_K_LEFT = 6,        /* the same after a LEAVING notice */
+  GL_K_FENCED = 8,      /* the same when a FENCE had come (one event, one message: it replaces EXITED and LEFT), and the
+                           answer to a FENCE of something already ended; never switched off (NO_EXIT_REPORT stops EXITED
+                           only) */
+  GL_K_FENCE = 7,       /* buddy -> launcher: end (rank, inc) and confirm */
+  GL_K_FENCE_NAK = 9,   /* launcher -> the asker: nothing held for (rank, inc); nothing was signalled */
+  GL_K_ACTIVATE = 10,   /* buddy -> launcher: body glActivateBody (the 64 B record + where the blob is) */
+  GL_K_ACT_ANSWER = 11, /* launcher -> buddy: body glActAnswerBody; sub = GL_RS_ACT_LATER (at most once per activation),
+                           GL_RS_ACT_ACCEPTED or GL_RS_ACT_REFUSED (final) */
+  GL_K_FETCH_EP = 12,   /* launcher -> buddy: the spare's gdakiMiActAnswer (GL_FETCH_EP_BYTES) */
+  GL_K_FETCH_READY = 13,/* buddy -> launcher: gdakiMiActReady for the spare (GL_FETCH_READY_BYTES) */
+  GL_K_FETCH_DONE = 14, /* launcher -> buddy: the spare's gdakiMiActDone (GL_FETCH_DONE_BYTES) */
+  GL_K_ABORT = 15,      /* buddy -> launcher: the activation of (rank, inc) is given up (hold deadline, its own bound) */
+  GL_K_SPAWN = 16,      /* buddy -> launcher: spawn a spare for (rank, inc) (decision 12; kind only in gin-control) */
+  GL_K_REFUSED = 17     /* launcher -> the asker: sub = the refused kind (GL_K_SPAWN: reason GL_R_SPAWN_NOT_BUILT). Not an
+                           activation answer: the buddy never falls back on it (REVIEW2 fix 1) */
+};
+#define GL_K_KIND_MAX 17
+enum { GL_PAIR_RECORD = 1, GL_PAIR_PROBE = 2 }; /* glMsgHdr.sub of PAIR and PAIR_ACK */
+
+struct glMsgHdr {
+  uint32_t magic;       /* GL_MAGIC */
+  uint16_t version;     /* GL_WIRE_VERSION */
+  uint16_t kind;        /* GL_K_* */
+  int32_t rank;         /* the subject rank (the process the message is about) */
+  uint32_t incarnation; /* the subject incarnation */
+  uint64_t nonce;       /* the communicator nonce */
+  int32_t from;         /* sender: a rank, or GL_FROM_LAUNCHER | node */
+  uint32_t node;        /* the launcher's node number (sender or addressee) */
+  uint32_t seq;         /* the sender's message number (from 1; per sender, for matching answers) */
+  uint32_t reqSeq;      /* the request this answers (its seq), else 0 */
+  uint32_t sub;         /* kind-specific (answer kind, refused kind, pairing kind) */
+  uint32_t reason;      /* GL_R_* */
+  uint16_t bodyBytes;   /* used bytes of body[] */
+  uint16_t flags;
+  uint32_t rsv;
+  uint64_t monoNs;      /* the sender's CLOCK_MONOTONIC */
+};
+GL_STATIC_ASSERT(sizeof(struct glMsgHdr) == 64, "the launcher message head is 64 bytes");
+
+#define GL_BODY_BYTES 192u
+struct glMsg {
+  struct glMsgHdr h;
+  uint8_t body[GL_BODY_BYTES];
+};
+GL_STATIC_ASSERT(sizeof(struct glMsg) == 256, "the launcher message is 256 bytes (EXPERIMENT.md 9.1, 9.8)");
+#define GL_WIRE_BYTES (sizeof(struct glCtrlEnv) + sizeof(struct glMsg)) /* 320 B per SEND or datagram */
+GL_STATIC_ASSERT(sizeof(struct glCtrlEnv) + sizeof(struct glMsg) == 320, "envelope + message = 320 bytes");
+
+/* GL_K_PAIR. The record QP (sub GL_PAIR_RECORD) carries the launcher messages; the liveness-READ QP (sub GL_PAIR_PROBE)
+ * only lets the rank READ the launcher page (the launcher never posts on it). The two pair and re-pair apart: an error of
+ * one does not touch the other. Every PAIR carries a QP created for it (never a RESET one): a fresh random PSN. The rank
+ * may start (setup, its QP in error), and so may the launcher (its record QP in error: gen + 1 to the rank's last UD
+ * endpoint and Q_Key, every 500 ms within GL_REPAIR_MS). When both start the same generation, the rank's PAIR wins
+ * (the lower `from`). */
+struct glPairBody {
+  uint32_t gen;          /* the pairing's generation (per kind; + 1 per re-pairing) */
+  uint32_t qkey;         /* the sender's UD Q_Key (a rank: its nonce's low 31 bits), where the answer goes */
+  struct glEp qp;        /* the sender's QP of this kind (INIT, RECVs posted for a record QP; fresh PSN) */
+  struct glEp ud;        /* the sender's UD QP */
+  struct glRegion page;  /* the sender's state page (a rank's: its page; the launcher's: its page) */
+  uint32_t creditOff;    /* the byte offset in that page of the sender's consumed-count word for the receiver's
+                            messages ((gen << 32) | count, design v2 2.2); for a rank: its rxConsumed slot of this
+                            launcher; for the launcher: glPageCredit.consumed of that rank */
+  uint32_t pad;
+};
+GL_STATIC_ASSERT(sizeof(struct glPairBody) == 112, "glPairBody is 112 bytes");
+
+struct glPairAckBody {   /* GL_K_PAIR_ACK */
+  uint32_t gen;          /* echo */
+  uint32_t status;       /* 0 ok; else refused (reason in the head) */
+  struct glEp qp;        /* the answering side's QP of this kind (already RTR/RTS; fresh PSN) */
+  struct glRegion page;  /* the answering side's state page */
+  uint32_t qkey;         /* the answering side's UD Q_Key */
+  uint32_t creditOff;    /* as glPairBody.creditOff, for the answering side */
+};
+GL_STATIC_ASSERT(sizeof(struct glPairAckBody) == 72, "glPairAckBody is 72 bytes");
+#define GL_REPAIR_MS 10000 /* NCCL_GIN_TS_RECONNECT_MS's default: the launcher's re-pairing bound */
+#define GL_REPAIR_EVERY_MS 500
+
+/* Spare states (glRegNoteBody.spareState, the page's spare word). */
+enum { GL_SP_NONE = 0, GL_SP_REPLAYING = 1, GL_SP_READY = 2, GL_SP_OFFERED = 3, GL_SP_ACCEPTED = 4, GL_SP_FAILED = 5,
+       GL_SP_ABORTED = 6 };
+/* Registration states (the page's registration word). */
+enum { GL_RS_NONE = 0, GL_RS_ALIVE = 1, GL_RS_EXITED = 2, GL_RS_LEFT = 3, GL_RS_FENCED = 4 };
+
+struct glRegNoteBody {   /* GL_K_REG_NOTE (subject rank and nonce in the head; incarnation = regInc) */
+  uint32_t regState;     /* GL_RS_*: ALIVE = the launcher holds the pidfd of (rank, regInc) */
+  uint32_t regInc;
+  uint32_t spareState;   /* GL_SP_* of the pre-launched spare of (rank, spareInc) */
+  uint32_t spareInc;
+  uint32_t spareAgeMs;   /* how long the spare has been in spareState (the launcher's clock) */
+  uint32_t pad;
+};
+GL_STATIC_ASSERT(sizeof(struct glRegNoteBody) == 24, "glRegNoteBody is 24 bytes");
+
+struct glExitBody {      /* GL_K_EXITED, GL_K_LEFT, GL_K_FENCED: the subject is the head's (rank, incarnation, nonce) */
+  uint64_t observedMonoNs; /* when the launcher saw the pidfd readable */
+  uint64_t fenceMonoNs;  /* FENCED after a signal: when it sent SIGKILL; else 0 */
+};
+GL_STATIC_ASSERT(sizeof(struct glExitBody) == 16, "glExitBody is 16 bytes");
+
+struct glActivateBody {  /* GL_K_ACTIVATE */
+  struct glRsActivate record;  /* the 64 B record, bytes as today's */
+  struct glRegion blob;  /* the activation blob in the buddy's outbox (len 0: none) */
+  uint64_t xferId;       /* the buddy's transfer number (echoed nowhere; for its log) */
+};
+GL_STATIC_ASSERT(sizeof(struct glActivateBody) == 88, "glActivateBody is 88 bytes");
+
+/* GL_K_ACT_ANSWER. After a LATER the launcher sets no time limit of its own in gin-control (the HELLO 2 000 ms and
+ * READY 5 000 ms limits are gin-dynamic's): it ends the wait at READY (hand-over), a replay failure, the spare's exit,
+ * or the buddy's ABORT. So the rank side bounds it: the LATER says how long the spare has been replaying, the page's
+ * spare word and its age move on, and the page beat shows the launcher alive (glPage). Which bound gin-control
+ * pre-registers is an open question (README_launcher.md). */
+struct glActAnswerBody {
+  struct glRsActivate record;  /* the spare's answer record, or the buddy's echoed with kind LATER or REFUSED */
+  uint32_t spareState;   /* GL_SP_* when the answer was sent */
+  uint32_t spareAgeMs;   /* ms since the spare entered that state (LATER: since its HELLO) */
+  uint32_t pageSlot;     /* the index of (rank)'s glPageReg on the launcher page */
+  uint32_t pad;
+  char why[64];
+};
+GL_STATIC_ASSERT(sizeof(struct glActAnswerBody) == 144, "glActAnswerBody is 144 bytes");
+GL_STATIC_ASSERT(sizeof(struct glPairBody) <= GL_BODY_BYTES && sizeof(struct glPairAckBody) <= GL_BODY_BYTES &&
+                     sizeof(struct glActivateBody) <= GL_BODY_BYTES && sizeof(struct glActAnswerBody) <= GL_BODY_BYTES &&
+                     GL_FETCH_EP_BYTES <= GL_BODY_BYTES,
+                 "every launcher body fits 192 bytes");
+
+/* ---------------------------------------------------------------------------------------------------------------
+ * 3. The launcher's state page (REMOTE_READ, 4 KiB, single writer: the launcher's thread; only aligned 8 B words, each
+ *    meaningful alone, written with one 8 B store). Ranks READ it over their liveness-READ QP to this launcher.
+ *    line 0: head; then GL_PAGE_REGS registration slots of 32 B; then GL_PAGE_CREDITS credit slots of 32 B.
+ *    A slot is bound to its (nonce, rank) at first use and never rebound while the launcher lives, so a reader that
+ *    matched the nonce and key words can read the state words of the same READ.
+ * ------------------------------------------------------------------------------------------------------------- */
+#define GL_PAGE_MAGIC 0x504c5247u /* "GRLP" */
+#define GL_PAGE_LAYOUT 2u         /* (magicVer & 0xffff): this layout */
+#define GL_PAGE_REGS 62
+#define GL_PAGE_CREDITS 64
+#define GL_BEAT_MS 10
+
+/* registration word: ((uint64_t)GL_RS_* << 56) | ((uint64_t)(rank & 0xffffff) << 32) | incarnation */
+/* spare word:        ((uint64_t)GL_SP_* << 56) | ((uint64_t)(rank & 0xffffff) << 32) | spare incarnation */
+static inline uint64_t gl_page_word(uint32_t state, int32_t rank, uint32_t inc) {
+  return ((uint64_t)(state & 0xffu) << 56) | ((uint64_t)((uint32_t)rank & 0xffffffu) << 32) | inc;
+}
+static inline uint32_t gl_page_word_state(uint64_t w) { return (uint32_t)(w >> 56); }
+static inline int32_t gl_page_word_rank(uint64_t w) { return (int32_t)((w >> 32) & 0xffffffu); }
+static inline uint32_t gl_page_word_inc(uint64_t w) { return (uint32_t)w; }
+
+struct glPageReg {
+  uint64_t nonce;        /* 0: free */
+  uint64_t reg;          /* registration word (the original or the re-registered rank) */
+  uint64_t spare;        /* spare word (the pre-launched spare of the next incarnation) */
+  uint64_t spareSinceMs; /* the launcher's monoMs when the spare entered its state (compare with glPage.monoMs) */
+};
+struct glPageCredit {
+  uint64_t nonce;        /* 0: free */
+  uint64_t peer;         /* ((uint64_t)(rank & 0xffffff) << 32) | that rank's incarnation as paired */
+  uint64_t consumed;     /* ((uint64_t)gen << 32) | how many of that rank's record-QP messages the launcher consumed in
+                            that generation (design v2 2.2: the rank's credit toward the launcher) */
+  uint64_t rsv;
+};
+struct glPage {
+  uint64_t magicVer;     /* (GL_PAGE_MAGIC << 32) | (GL_WIRE_VERSION << 16) | GL_PAGE_LAYOUT */
+  uint64_t beat;         /* +1 every loop pass (at least every GL_BEAT_MS) */
+  uint64_t monoMs;       /* the launcher's CLOCK_MONOTONIC in ms at the last pass */
+  uint64_t node;
+  uint64_t qkey;
+  uint64_t nRegs;        /* slots in use (bound) */
+  uint64_t nCredits;
+  uint64_t rsv;
+  struct glPageReg reg[GL_PAGE_REGS];
+  struct glPageCredit credit[GL_PAGE_CREDITS];
+};
+GL_STATIC_ASSERT(sizeof(struct glPageReg) == 32 && sizeof(struct glPageCredit) == 32, "page slots are 32 bytes");
+GL_STATIC_ASSERT(sizeof(struct glPage) == 4096, "the launcher page is 4 KiB");
+GL_STATIC_ASSERT(offsetof(struct glPage, reg) == 64 && offsetof(struct glPage, credit) == 64 + 32 * GL_PAGE_REGS,
+                 "page layout");
+#define GL_PAGE_CREDIT_OFF(i) ((uint32_t)(offsetof(struct glPage, credit) + 32u * (uint32_t)(i) + 16u))
+
+/* ---------------------------------------------------------------------------------------------------------------
+ * 4. Pure helpers (both sides)
+ * ------------------------------------------------------------------------------------------------------------- */
+
+static inline void gl_env_pack(struct glCtrlEnv* e, uint16_t kind, int32_t from, uint32_t gen, uint64_t seq,
+                               uint64_t ackSeq, uint64_t nonce, uint32_t inc) {
+  uint8_t* p = (uint8_t*)e;
+  for (size_t i = 0; i < sizeof(*e); i++) p[i] = 0;
+  e->magic = GL_ENV_MAGIC;
+  e->version = (uint16_t)GL_WIRE_VERSION;
+  e->kind = kind;
+  e->from = from;
+  e->gen = gen;
+  e->seq = seq;
+  e->ackSeq = ackSeq;
+  e->nonce = nonce;
+  e->incarnation = inc;
+  e->bodyBytes = (uint32_t)sizeof(struct glMsg);
+}
+/* 0 when the envelope heads a launcher message of `kind` (LAUNCHER or PAIR); else a GL_R_* code. */
+static inline uint32_t gl_env_check(const struct glCtrlEnv* e, uint16_t kind) {
+  if (e->magic != GL_ENV_MAGIC || e->version != GL_WIRE_VERSION) return GL_R_BAD_MSG;
+  if (e->kind != kind || e->bodyBytes != sizeof(struct glMsg)) return GL_R_BAD_MSG;
+  return GL_R_NONE;
+}
+/* 0 when m is a well-formed launcher message; else a GL_R_* code. */
+static inline uint32_t gl_msg_check(const struct glMsg* m) {
+  if (m->h.magic != GL_MAGIC || m->h.version != GL_WIRE_VERSION) return GL_R_BAD_MSG;
+  if (m->h.kind < 1 || m->h.kind > GL_K_KIND_MAX) return GL_R_UNKNOWN_KIND;
+  if (m->h.bodyBytes > GL_BODY_BYTES) return GL_R_BAD_MSG;
+  return GL_R_NONE;
+}
+/* 0 when u is a well-formed Unix message of n received bytes; else a GL_R_* code. */
+static inline uint32_t gl_unix_check(const struct glUnixMsg* u, size_t n) {
+  if (n < sizeof(struct glUnixMsg)) return GL_R_BAD_MSG;
+  if (u->h.magic != GL_U_MAGIC || u->h.version != GL_WIRE_VERSION) return GL_R_BAD_MSG;
+  if (u->h.kind < 1 || u->h.kind > GL_U_KIND_MAX) return GL_R_UNKNOWN_KIND;
+  if (u->h.bodyBytes > GL_U_BODY_BYTES) return GL_R_BAD_MSG;
+  if (u->h.payloadBytes > GL_U_MAX_PAYLOAD) return GL_R_BAD_MSG;
+  if (n != sizeof(struct glUnixMsg) + u->h.payloadBytes) return GL_R_BAD_MSG;
+  if (u->h.payloadBytes != 0 && u->h.kind != GL_U_ACT_BYTES) return GL_R_BAD_MSG;
+  return GL_R_NONE;
+}
+
+/* The arming condition on the rdma path (EXPERIMENT.md 9.5 "등록", design v2 5.4 1 and 7, REVIEW2 fix 8): "a spare is
+ * registered" becomes "paired with that node's launcher, the launcher holds this incarnation's pidfd, and it noted a
+ * pre-launched spare of the next incarnation that said HELLO". The rank side fills glArmView from what its launcher(s)
+ * answered; today's decision is `allArmable && haveSpare` (gdakiCkptOnStable, ln4 14981).
+ *   regAcked / regAckInc: the own launcher's GL_U_HELLO_ACK answered GL_UA_OK to REGISTER(rank, inc) for this inc;
+ *   ownPaired: the record QP to the own launcher is CONNECTED;
+ *   notedReg / notedInc: its latest REG_NOTE (or page) registration word is ALIVE for this inc;
+ *   notedSpare / notedSpareInc: its spare word is REPLAYING, READY or OFFERED for inc + 1;
+ *   allPaired: every launcher of the communicator is paired (a revived rank re-arms only after both, design v2 5.4 7);
+ *   leaving: this rank sent LEAVING. */
+struct glArmView {
+  uint32_t inc;
+  uint32_t regAcked, regAckInc;
+  uint32_t ownPaired;
+  uint32_t notedReg, notedInc;
+  uint32_t notedSpare, notedSpareInc;
+  uint32_t allPaired;
+  uint32_t leaving;
+};
+static inline int gl_spare_usable(uint32_t sp) {
+  return sp == GL_SP_REPLAYING || sp == GL_SP_READY || sp == GL_SP_OFFERED;
+}
+static inline int gl_path_exists(const struct glArmView* v) {
+  return v->regAcked && v->regAckInc == v->inc && v->ownPaired && v->notedReg == GL_RS_ALIVE && v->notedInc == v->inc &&
+         gl_spare_usable(v->notedSpare) && (uint64_t)v->notedSpareInc == (uint64_t)v->inc + 1u && v->allPaired &&
+         !v->leaving;
+}
+/* The rdma build's CKPT_STABLE armable bit: when the path exists it is today's decision with a spare registered. */
+static inline int gl_armable(int allArmable, const struct glArmView* v) { return allArmable && gl_path_exists(v); }
+
+#endif /* GIN_LAUNCHER_MSG_H */
+// ---- gin-control: launcher wire (end) ----
+static_assert(sizeof(struct glCtrlEnv) == sizeof(struct gdakiCtrlEnv) && GL_ENV_MAGIC == GDAKI_CTRL_ENV_MAGIC &&
+                  GL_FROM_LAUNCHER == GDAKI_CTRL_FROM_LAUNCHER && (int)GL_ENV_KIND_LAUNCHER == (int)GDAKI_CTRL_K_LAUNCHER,
+              "the launcher's envelope is the ctrl API's");
+static_assert(sizeof(struct glEp) == sizeof(struct gdakiCtrlEndpoint) && sizeof(struct glRsActivate) == 64 &&
+                  sizeof(struct glMsg) == GDAKI_CTRL_LAUNCHER_BYTES,
+              "the launcher's endpoint, activation record and message");
+// ---- gin-control (launcher): link (begin; impl/gc_unit_p3.cc compiles this region on the CPU) ----
+// The rank side of the launcher (EXPERIMENT.md 9.4, 9.5; design v3 4.4, 5.1-5.4) without NCCL, verbs or CUDA: the
+// node-local Unix socket (REGISTER, SPARE_HELLO, LEAVING, SPARE_STATUS, the activation bytes and talk; the pidfd of this
+// process over SCM_RIGHTS; the registering connection CLOEXEC and closed in a forked child), the launchers' RNIC
+// messages through a transport table (the host's is the ring's, int2; the unit test's is the launcher core's
+// in-process transport), the record QP's pairing with each launcher on gin-control (ring)'s pairing model, the arming
+// view (launcher_msg.h's gl_path_exists), the fence word and its report lines, the buddy's activation (one LATER at
+// most, the LATER bound, the first-answer bound, the launcher's beat), the spare's check of the ACTIVATE and its FETCH
+// relay. Lines go through a log function (the host appends " mono_ms=%.3f"). Needs launcher/launcher_msg.h (pasted above
+// in the host file), the ctrl API block and gin-control (ring)'s pairing model (struct gdakiCtrlPairSt).
+#include <stdarg.h>
+#include <pthread.h>
+#include <sys/syscall.h>
+#include <sys/un.h>
+#ifndef SYS_pidfd_open
+#define SYS_pidfd_open 434
+#endif
+
+struct gdakiCtrlLaLog {
+  void (*fn)(void* arg, const char* line) = nullptr;
+  void* arg = nullptr;
+};
+__attribute__((format(printf, 2, 3))) static void gdakiCtrlLaSay(const struct gdakiCtrlLaLog& l, const char* fmt, ...) {
+  if (l.fn == nullptr) return;
+  char b[512];
+  va_list ap;
+  va_start(ap, fmt);
+  vsnprintf(b, sizeof(b), fmt, ap);
+  va_end(ap);
+  l.fn(l.arg, b);
+}
+
+// ---- the registering connection is closed in a forked child (pthread_atfork; the helper's and witness's rule) ----
+#define GDAKI_CTRL_LA_FORK_SLOTS 16
+static std::atomic<int> gdakiCtrlLaForkFd[GDAKI_CTRL_LA_FORK_SLOTS];  // fd + 1; 0: free
+static void gdakiCtrlLaAtforkChild() {
+  for (int i = 0; i < GDAKI_CTRL_LA_FORK_SLOTS; i++) {
+    const int v = gdakiCtrlLaForkFd[i].exchange(0);
+    if (v > 0) (void)close(v - 1);
+  }
+}
+// False: no free slot (REVIEW_P3 nit 9: the caller says so in a line).
+static bool gdakiCtrlLaForkWatch(int fd) {
+  static std::once_flag once;
+  std::call_once(once, [] { (void)pthread_atfork(nullptr, nullptr, gdakiCtrlLaAtforkChild); });
+  for (int i = 0; i < GDAKI_CTRL_LA_FORK_SLOTS; i++) {
+    int z = 0;
+    if (gdakiCtrlLaForkFd[i].compare_exchange_strong(z, fd + 1)) return true;
+  }
+  return false;
+}
+static void gdakiCtrlLaForkUnwatch(int fd) {
+  for (int i = 0; i < GDAKI_CTRL_LA_FORK_SLOTS; i++) {
+    int v = fd + 1;
+    if (gdakiCtrlLaForkFd[i].compare_exchange_strong(v, 0)) return;
+  }
+}
+
+// One word for an errno (the lines' %s is a word without spaces).
+static const char* gdakiCtrlLaErrWord(int e) {
+  switch (e) {
+    case ECONNRESET: return "ECONNRESET";
+    case EPIPE: return "EPIPE";
+    case ENOTCONN: return "ENOTCONN";
+    case EBADF: return "EBADF";
+    case ENOBUFS: return "ENOBUFS";
+    default: return "error";
+  }
+}
+
+// ---- the Unix socket ----
+enum : int { GDAKI_CTRL_LA_ROLE_RANK = 1, GDAKI_CTRL_LA_ROLE_SPARE = 2 };
+struct gdakiCtrlLaUnix {
+  int fd = -1;
+  int role = 0;
+  int32_t rank = -1;
+  uint32_t inc = 0;            // the incarnation of the last REGISTER or SPARE_HELLO
+  uint64_t nonce = 0;
+  bool acked = false;          // a HELLO_ACK answered it
+  uint32_t ackStatus = GL_UA_REFUSED, ackReason = 0, ackInc = 0;
+  struct glUHelloAck ack;
+  bool leavingSent = false, readySent = false;
+  bool closed = false;         // EOF or an error (not this side's own close)
+  bool haveAct = false;        // GL_U_ACT_BYTES came
+  struct glRsActivate act;
+  std::vector<uint8_t> blob;
+  std::deque<struct glUnixMsg> talk;  // GL_U_ACT_TALK from the launcher (FETCH_READY, ABORT), oldest first
+  uint64_t sent = 0, received = 0;
+  bool infoSent = false, infoAcked = false;  // the nonce-free INFO (before the all-gather) and its answer
+  struct glUHelloAck info;
+  bool failedSent = false;     // a spare's REPLAY_FAILED went out
+  bool forkUnwatched = false;  // the fork watch had no free slot: the connection stays open in a forked child
+  std::vector<uint8_t> rbuf;   // the receive buffer (one message and the largest payload), made once
+};
+// The nonce-free INFO (impl/notes_p3.md "고침"; launcher_msg.h GL_U_INFO 8 and GL_U_INFO_ACK 9 since the launcher's
+// f8e3216e, GL_U_KIND_MAX 9): INFO rank -> launcher (no fd, no nonce, body empty), INFO_ACK the answer (body glUHelloAck:
+// status, node, qkey, pageSlot 0xffffffff, ud, page; the head echoes the INFO's rank, incarnation and nonce, sub = INFO).
+// A launcher of 897641f3 drops INFO (an unknown kind): no answer within the bound, the all-gather field says no path.
+#define GDAKI_CTRL_LA_U_INFO ((uint32_t)GL_U_INFO)
+#define GDAKI_CTRL_LA_U_INFO_ACK ((uint32_t)GL_U_INFO_ACK)
+static_assert(GDAKI_CTRL_LA_U_INFO == 8u && GDAKI_CTRL_LA_U_INFO_ACK == 9u && GL_U_KIND_MAX == 9,
+              "the Unix kinds of launcher_msg.h f8e3216e");
+#define GDAKI_CTRL_LA_INFO_MS 200  // the answer's bound (the node's own launcher; a REGISTER's is 1 000 ms)
+// The socket path: NCCL_GIN_CTRL_LAUNCHER_SOCK, else the launcher's default ($XDG_RUNTIME_DIR/gin-launcher/launcher.sock,
+// else /tmp/gin-launcher-<uid>/launcher.sock; gl_default_sock_path). False: no room.
+static bool gdakiCtrlLaSockPath(char* out, size_t len) {
+  const char* e = getenv(GL_SOCK_ENV);
+  int n;
+  if (e != nullptr && *e) n = snprintf(out, len, "%s", e);
+  else {
+    const char* x = getenv("XDG_RUNTIME_DIR");
+    n = (x != nullptr && *x) ? snprintf(out, len, "%s/gin-launcher/launcher.sock", x)
+                             : snprintf(out, len, "/tmp/gin-launcher-%u/launcher.sock", (unsigned)getuid());
+  }
+  return n > 0 && (size_t)n < len && (size_t)n < sizeof(((struct sockaddr_un*)nullptr)->sun_path);
+}
+// The node number: NCCL_GIN_CTRL_LAUNCHER_NODE (the launcher's HELLO_ACK says its own; they must agree). -1: unset.
+static long gdakiCtrlLaNodeEnv() {
+  const char* e = getenv(GL_NODE_ENV);
+  if (e == nullptr || *e == '\0') return -1;
+  char* end = nullptr;
+  const long v = strtol(e, &end, 10);
+  return (end != nullptr && *end == '\0' && v >= 0 && v < (long)GL_FROM_LAUNCHER) ? v : -2;
+}
+// A spare's incarnation: NCCL_GIN_RESTORE_SPARE_INC (default 1). 0: not a valid value.
+static uint32_t gdakiCtrlLaSpareIncEnv() {
+  const char* e = getenv(GDAKI_CTRL_LA_SPARE_INC_ENV);
+  if (e == nullptr || *e == '\0') return 1u;
+  char* end = nullptr;
+  const unsigned long v = strtoul(e, &end, 10);
+  return (end != nullptr && *end == '\0' && v >= 1 && v < 0xffffffffUL) ? (uint32_t)v : 0u;
+}
+static void gdakiCtrlLaUnixMsgInit(struct glUnixMsg* m, uint16_t kind, int32_t rank, uint32_t inc, uint64_t nonce) {
+  memset(m, 0, sizeof(*m));
+  m->h.magic = GL_U_MAGIC;
+  m->h.version = (uint16_t)GL_WIRE_VERSION;
+  m->h.kind = kind;
+  m->h.rank = rank;
+  m->h.incarnation = inc;
+  m->h.nonce = nonce;
+  m->h.pid = (int64_t)getpid();
+  struct timespec ts;
+  clock_gettime(CLOCK_MONOTONIC, &ts);
+  m->h.monoNs = (uint64_t)ts.tv_sec * 1000000000ull + (uint64_t)ts.tv_nsec;
+}
+// Connect (SOCK_SEQPACKET, CLOEXEC; the connection then non-blocking) and watch it for fork. False with why.
+static bool gdakiCtrlLaUnixOpen(struct gdakiCtrlLaUnix* u, const char* path, char* why, size_t whyLen) {
+  const int fd = socket(AF_UNIX, SOCK_SEQPACKET | SOCK_CLOEXEC, 0);
+  if (fd < 0) {
+    snprintf(why, whyLen, "socket: %s", strerror(errno));
+    return false;
+  }
+  struct sockaddr_un a;
+  memset(&a, 0, sizeof(a));
+  a.sun_family = AF_UNIX;
+  snprintf(a.sun_path, sizeof(a.sun_path), "%s", path);
+  if (connect(fd, (struct sockaddr*)&a, sizeof(a)) != 0) {
+    snprintf(why, whyLen, "connect: %s", strerror(errno));
+    close(fd);
+    return false;
+  }
+  const int fl = fcntl(fd, F_GETFL, 0);
+  if (fl < 0 || fcntl(fd, F_SETFL, fl | O_NONBLOCK) != 0) {
+    snprintf(why, whyLen, "O_NONBLOCK: %s", strerror(errno));
+    close(fd);
+    return false;
+  }
+  u->fd = fd;
+  u->closed = false;
+  u->forkUnwatched = !gdakiCtrlLaForkWatch(fd);
+  return true;
+}
+// One message (and an fd with SCM_RIGHTS, or -1). False: not sent (the connection is then closed). A full socket blocks
+// up to 200 ms (REVIEW_P3 nit 12): no helper step sends here (LEAVING is gdakiTsStop's, the rest the setup thread's and
+// a spare's driver's).
+static bool gdakiCtrlLaUnixSend(struct gdakiCtrlLaUnix* u, const struct glUnixMsg* m, int passFd) {
+  if (u->fd < 0 || u->closed) return false;
+  struct iovec iov;
+  iov.iov_base = (void*)m;
+  iov.iov_len = sizeof(*m);
+  union {
+    char b[CMSG_SPACE(sizeof(int))];
+    struct cmsghdr align;
+  } cb;
+  struct msghdr mh;
+  memset(&mh, 0, sizeof(mh));
+  mh.msg_iov = &iov;
+  mh.msg_iovlen = 1;
+  if (passFd >= 0) {
+    memset(&cb, 0, sizeof(cb));
+    mh.msg_control = cb.b;
+    mh.msg_controllen = sizeof(cb.b);
+    struct cmsghdr* c = CMSG_FIRSTHDR(&mh);
+    c->cmsg_level = SOL_SOCKET;
+    c->cmsg_type = SCM_RIGHTS;
+    c->cmsg_len = CMSG_LEN(sizeof(int));
+    memcpy(CMSG_DATA(c), &passFd, sizeof(int));
+  }
+  for (int tries = 0; tries < 200; tries++) {  // a full socket: up to 200 ms
+    const ssize_t n = sendmsg(u->fd, &mh, MSG_NOSIGNAL);
+    if (n == (ssize_t)sizeof(*m)) {
+      u->sent++;
+      return true;
+    }
+    if (n < 0 && (errno == EAGAIN || errno == EWOULDBLOCK || errno == EINTR)) {
+      struct pollfd pf = {u->fd, POLLOUT, 0};
+      (void)poll(&pf, 1, 1);
+      continue;
+    }
+    break;
+  }
+  u->closed = true;
+  return false;
+}
+// REGISTER (a rank) or SPARE_HELLO (a spare, nonzero nonce) with this process's own pidfd. False with why.
+static bool gdakiCtrlLaUnixHello(struct gdakiCtrlLaUnix* u, int role, int32_t rank, uint32_t inc, uint64_t nonce, char* why,
+                                 size_t whyLen) {
+  if (rank < 0 || (role == GDAKI_CTRL_LA_ROLE_SPARE && (nonce == 0 || inc == 0))) {
+    snprintf(why, whyLen, "a %s needs a rank%s", role == GDAKI_CTRL_LA_ROLE_SPARE ? "spare HELLO" : "REGISTER",
+             role == GDAKI_CTRL_LA_ROLE_SPARE ? ", a nonzero nonce and an incarnation above 0" : "");
+    return false;
+  }
+  const int pidfd = (int)syscall(SYS_pidfd_open, getpid(), 0);
+  if (pidfd < 0) {
+    snprintf(why, whyLen, "pidfd_open: %s", strerror(errno));
+    return false;
+  }
+  struct glUnixMsg m;
+  gdakiCtrlLaUnixMsgInit(&m, role == GDAKI_CTRL_LA_ROLE_SPARE ? GL_U_SPARE_HELLO : GL_U_REGISTER, rank, inc, nonce);
+  const bool ok = gdakiCtrlLaUnixSend(u, &m, pidfd);
+  close(pidfd);  // the launcher holds its own copy
+  if (!ok) {
+    snprintf(why, whyLen, "the message could not be sent");
+    return false;
+  }
+  u->role = role;
+  u->rank = rank;
+  u->inc = inc;
+  u->nonce = nonce;
+  u->acked = false;
+  return true;
+}
+// INFO (above): no fd, no nonce. False: not sent.
+static bool gdakiCtrlLaUnixInfo(struct gdakiCtrlLaUnix* u, int32_t rank) {
+  struct glUnixMsg m;
+  gdakiCtrlLaUnixMsgInit(&m, (uint16_t)GDAKI_CTRL_LA_U_INFO, rank, 0, 0);
+  u->infoSent = gdakiCtrlLaUnixSend(u, &m, -1);
+  u->infoAcked = false;
+  return u->infoSent;
+}
+static bool gdakiCtrlLaUnixLeaving(struct gdakiCtrlLaUnix* u) {
+  if (u->leavingSent || u->role != GDAKI_CTRL_LA_ROLE_RANK) return u->leavingSent;
+  struct glUnixMsg m;
+  gdakiCtrlLaUnixMsgInit(&m, GL_U_LEAVING, u->rank, u->inc, u->nonce);
+  u->leavingSent = gdakiCtrlLaUnixSend(u, &m, -1);
+  return u->leavingSent;
+}
+// SPARE_STATUS: READY (replay, the FETCH buffer, the Resume entry done) or REPLAY_FAILED with why.
+static bool gdakiCtrlLaUnixStatus(struct gdakiCtrlLaUnix* u, bool ready, const char* why) {
+  struct glUnixMsg m;
+  gdakiCtrlLaUnixMsgInit(&m, GL_U_SPARE_STATUS, u->rank, u->inc, u->nonce);
+  m.h.sub = ready ? GL_US_READY : GL_US_REPLAY_FAILED;
+  if (why != nullptr) {
+    const int n = snprintf((char*)m.body, GL_U_BODY_BYTES, "%s", why);
+    m.h.bodyBytes = (uint16_t)std::min<int>(n + 1, (int)GL_U_BODY_BYTES);
+  }
+  const bool ok = gdakiCtrlLaUnixSend(u, &m, -1);
+  if (ok && ready) u->readySent = true;
+  return ok;
+}
+// ACT_TALK from the spare: ANSWER (64 B record), FETCH_EP (112 B), FETCH_DONE (80 B).
+static bool gdakiCtrlLaUnixTalk(struct gdakiCtrlLaUnix* u, uint32_t sub, const void* body, size_t len) {
+  if (len > GL_U_BODY_BYTES) return false;
+  struct glUnixMsg m;
+  gdakiCtrlLaUnixMsgInit(&m, GL_U_ACT_TALK, u->rank, u->inc, u->nonce);
+  m.h.sub = sub;
+  if (len) memcpy(m.body, body, len);
+  m.h.bodyBytes = (uint16_t)len;
+  return gdakiCtrlLaUnixSend(u, &m, -1);
+}
+// Read what is queued (non-blocking): HELLO_ACK, ACT_BYTES (record + blob), ACT_TALK. EOF or an error: closed, and the
+// line `launcher Unix socket closed (EOF|<errno name>)` once. Returns the messages taken.
+static int gdakiCtrlLaUnixPoll(struct gdakiCtrlLaUnix* u, const struct gdakiCtrlLaLog& log, int me) {
+  if (u->fd < 0 || u->closed) return 0;
+  int taken = 0;
+  std::vector<uint8_t>& buf = u->rbuf;  // made once (REVIEW_P3 nit 1: not 65 792 B zeroed per call)
+  if (buf.size() != sizeof(struct glUnixMsg) + GL_U_MAX_PAYLOAD) buf.resize(sizeof(struct glUnixMsg) + GL_U_MAX_PAYLOAD);
+  for (;;) {
+    union {
+      char b[CMSG_SPACE(sizeof(int) * 4)];
+      struct cmsghdr align;
+    } cb;
+    struct iovec iov;
+    iov.iov_base = buf.data();
+    iov.iov_len = buf.size();
+    struct msghdr mh;
+    memset(&mh, 0, sizeof(mh));
+    mh.msg_iov = &iov;
+    mh.msg_iovlen = 1;
+    mh.msg_control = cb.b;
+    mh.msg_controllen = sizeof(cb.b);
+    const ssize_t n = recvmsg(u->fd, &mh, MSG_DONTWAIT | MSG_CMSG_CLOEXEC);
+    if (n < 0 && (errno == EAGAIN || errno == EWOULDBLOCK || errno == EINTR)) return taken;
+    for (struct cmsghdr* c = CMSG_FIRSTHDR(&mh); n > 0 && c != nullptr; c = CMSG_NXTHDR(&mh, c))  // no fd is expected
+      if (c->cmsg_level == SOL_SOCKET && c->cmsg_type == SCM_RIGHTS)
+        for (size_t j = 0; j < (c->cmsg_len - CMSG_LEN(0)) / sizeof(int); j++) {
+          int f;
+          memcpy(&f, CMSG_DATA(c) + j * sizeof(int), sizeof(int));
+          close(f);
+        }
+    if (n <= 0) {
+      u->closed = true;
+      gdakiCtrlLaSay(log, "GIN/RC: rank %d: launcher Unix socket closed (%s)", me, n == 0 ? "EOF" : gdakiCtrlLaErrWord(errno));
+      return taken;
+    }
+    const struct glUnixMsg* m = (const struct glUnixMsg*)buf.data();
+    if (gl_unix_check(m, (size_t)n) != GL_R_NONE) continue;
+    u->received++;
+    taken++;
+    switch (m->h.kind) {
+      case GL_U_HELLO_ACK:
+        memcpy(&u->ack, m->body, sizeof(u->ack));
+        u->ackStatus = u->ack.status;
+        u->ackReason = m->h.reason;
+        u->ackInc = m->h.incarnation;
+        u->acked = m->h.rank == u->rank && m->h.incarnation == u->inc && m->h.nonce == u->nonce;
+        break;
+      case GL_U_ACT_BYTES:
+        memcpy(&u->act, m->body, sizeof(u->act));
+        u->blob.assign(buf.data() + sizeof(struct glUnixMsg), buf.data() + sizeof(struct glUnixMsg) + m->h.payloadBytes);
+        u->haveAct = true;
+        break;
+      case GL_U_ACT_TALK:
+        u->talk.push_back(*m);
+        break;
+      case GL_U_INFO_ACK:  // INFO's answer: its body is HELLO_ACK's (an OK answer names no page slot)
+        if (m->h.sub == GL_U_INFO && m->h.nonce == 0 && m->h.bodyBytes >= sizeof(struct glUHelloAck)) {
+          memcpy(&u->info, m->body, sizeof(u->info));
+          u->infoAcked = u->infoSent;
+        }
+        break;
+      default:
+        break;
+    }
+  }
+}
+// Wait up to ms for the socket to have something (the caller polls it then).
+static void gdakiCtrlLaUnixWait(const struct gdakiCtrlLaUnix* u, int ms) {
+  if (u->fd < 0 || u->closed) return;
+  struct pollfd pf = {u->fd, POLLIN, 0};
+  (void)poll(&pf, 1, ms);
+}
+static void gdakiCtrlLaUnixClose(struct gdakiCtrlLaUnix* u) {
+  if (u->fd >= 0) {
+    gdakiCtrlLaForkUnwatch(u->fd);
+    close(u->fd);
+  }
+  u->fd = -1;
+}
+
+// ---- the launchers' RNIC side: a transport table and one record QP pairing per launcher ----
+// li: the launcher's index: node order when the all-gather's fields add them (gdakiCtrlLaAgTake); one added before or
+// otherwise (the own one at REGISTER without the fields, a ward's registration) goes at the end. Within a rank li is
+// fixed (creditOff = creditOff0 + 8 li). The host's table is the ring's (int2); the
+// unit test's bridges to the launcher core's in-process transport. Every call returns 0 on success.
+struct gdakiCtrlLaTx {
+  void* arg = nullptr;
+  int (*udSend)(void* arg, int li, const struct glEp* to, uint32_t qkey, const struct glMsg* m) = nullptr;
+  int (*rcCreate)(void* arg, int li, uint32_t gen, struct glEp* local) = nullptr;  // INIT, RECVs posted, a fresh PSN
+  int (*rcConnect)(void* arg, int li, const struct glEp* remote) = nullptr;         // RTR, RTS
+  int (*rcSend)(void* arg, int li, const struct glMsg* m) = nullptr;
+};
+struct gdakiCtrlLaPeer {
+  uint32_t node = 0;
+  bool known = false;               // its UD endpoint and Q_Key are known (the own one's HELLO_ACK, or the all-gather)
+  struct glEp ud;
+  uint32_t qkey = 0;
+  struct glRegion page;
+  uint32_t creditOff = 0;           // 2a-2-C step 5: its page's consumed word for this rank (glPageCredit.consumed; the
+                                    // launcher's PAIR or PAIR_ACK); 0: none named (no credit READ)
+  struct gdakiCtrlPairSt pair;      // the record QP's pairing (gin-control (ring)'s model; the launcher's `from`)
+  struct glEp local, remote;
+  bool connected = false, qpErr = false;
+  std::vector<struct glRegNoteBody> note;  // by rank: the launcher's latest REG_NOTE
+  std::vector<uint8_t> haveNote;
+  uint64_t beat = 0;
+  double beatMs = -1;               // when the page's beat was seen to change (-1: never read)
+  bool lostSaid = false;
+  uint64_t rx = 0, tx = 0, spawnRefused = 0;
+};
+// The buddy's fence of one peer (design v3 4.4 3).
+struct gdakiCtrlLaFence {
+  bool armed = false;               // a hold of (peer, dead) started here
+  uint32_t dead = 0;
+  bool sent = false, nak = false, reported = false, windowSaid = false, noPathSaid = false;
+  double sentMs = 0;
+};
+// ---- the window line's cells (REVIEW_P3 막는 문제 1; design v3 4.4, EXPERIMENT.md 6 "펜스 뒤 생존 window에 바뀐 칸") ----
+// A cell is 64 bytes of this rank's memory that a dead peer's RDMA could still write: its windows on the context's
+// collComm, its signal and counter tables (the host's regions). Up to 16 cells per region, spread evenly, the first at
+// its start and the last ending at its end. A cell's value is its bytes' FNV-1a hash. The snapshot is taken at the
+// judgement, before the hold start's quiesce moves any QP (gdakiCtrlOnJudgement); the comparison comes when the fence
+// word stands (FENCED: "after the fence"; EXITED: "after the judgement") or, without it, at the hold's end.
+#define GDAKI_CTRL_LA_CELL_BYTES 64u
+#define GDAKI_CTRL_LA_CELLS_PER_REGION 16u
+struct gdakiCtrlLaRegion {
+  const void* p;
+  uint64_t bytes;
+};
+struct gdakiCtrlLaCellsIo {
+  void* arg = nullptr;
+  void (*regions)(void* arg, std::vector<struct gdakiCtrlLaRegion>* out) = nullptr;
+  bool (*read)(void* arg, const void* src, void* dst, size_t n) = nullptr;  // false: the cell is unreadable
+};
+struct gdakiCtrlLaSnap {
+  bool have = false;
+  uint32_t dead = 0;
+  std::vector<uint64_t> v;
+  std::vector<uint8_t> ok;
+};
+static void gdakiCtrlLaCellPlan(uint64_t bytes, std::vector<uint64_t>* off) {
+  off->clear();
+  if (bytes == 0) return;
+  const uint64_t cb = GDAKI_CTRL_LA_CELL_BYTES;
+  const uint64_t room = bytes > cb ? bytes - cb : 0;  // the last cell's start
+  const uint64_t n = std::min<uint64_t>(GDAKI_CTRL_LA_CELLS_PER_REGION, bytes / cb > 0 ? bytes / cb : 1);
+  for (uint64_t i = 0; i < n; i++) off->push_back(n > 1 ? room * i / (n - 1) : 0);
+  off->erase(std::unique(off->begin(), off->end()), off->end());
+}
+static uint64_t gdakiCtrlLaCellHash(const uint8_t* p, size_t n) {
+  uint64_t h = 0xcbf29ce484222325ull;
+  for (size_t i = 0; i < n; i++) h = (h ^ p[i]) * 0x100000001b3ull;
+  return h;
+}
+static void gdakiCtrlLaCellsTake(const struct gdakiCtrlLaCellsIo& io, std::vector<uint64_t>* v, std::vector<uint8_t>* ok) {
+  v->clear();
+  ok->clear();
+  if (io.regions == nullptr || io.read == nullptr) return;
+  std::vector<struct gdakiCtrlLaRegion> regs;
+  io.regions(io.arg, &regs);
+  std::vector<uint64_t> off;
+  uint8_t b[GDAKI_CTRL_LA_CELL_BYTES];
+  for (const auto& g : regs) {
+    gdakiCtrlLaCellPlan(g.bytes, &off);
+    for (uint64_t o : off) {
+      const size_t n = (size_t)std::min<uint64_t>(GDAKI_CTRL_LA_CELL_BYTES, g.bytes - o);
+      const bool good = io.read(io.arg, (const uint8_t*)g.p + o, b, n);
+      v->push_back(good ? gdakiCtrlLaCellHash(b, n) : 0);
+      ok->push_back(good ? 1 : 0);
+    }
+  }
+}
+// The cells that changed against the snapshot; *unreadable: those not read either time (or no snapshot of this hold).
+static uint32_t gdakiCtrlLaCellsDiff(const struct gdakiCtrlLaSnap& s, uint32_t dead, const std::vector<uint64_t>& v,
+                                     const std::vector<uint8_t>& ok, uint32_t* unreadable) {
+  uint32_t changed = 0, bad = 0;
+  const bool have = s.have && s.dead == dead && s.v.size() == v.size();
+  for (size_t i = 0; i < v.size(); i++) {
+    if (!have || !s.ok[i] || !ok[i]) bad++;
+    else if (s.v[i] != v[i]) changed++;
+  }
+  if (!have && v.empty() && s.have) bad = (uint32_t)s.v.size();
+  *unreadable = bad;
+  return changed;
+}
+// The buddy's activation of one peer through its launcher.
+enum : uint32_t {
+  GDAKI_CTRL_LA_ACT_NONE = 0, GDAKI_CTRL_LA_ACT_SENT = 1, GDAKI_CTRL_LA_ACT_LATER = 2, GDAKI_CTRL_LA_ACT_ACCEPTED = 3,
+  GDAKI_CTRL_LA_ACT_READY = 4, GDAKI_CTRL_LA_ACT_REFUSED = 5, GDAKI_CTRL_LA_ACT_ABORTED = 6, GDAKI_CTRL_LA_ACT_LOST = 7
+};
+struct gdakiCtrlLaAct {
+  uint32_t state = GDAKI_CTRL_LA_ACT_NONE;
+  uint32_t inc = 0;                 // the new incarnation asked for
+  uint32_t reqSeq = 0;              // the ACTIVATE's message number
+  int li = -1;
+  double sentMs = 0, laterMs = 0, acceptedMs = 0;
+  int nLater = 0;
+  uint32_t spareState = 0, spareAgeMs = 0, reason = 0;
+  struct glRsActivate ans;
+  bool haveEp = false, haveDone = false;
+  bool laterSaid = false;           // the LATER line of the host was given
+  uint8_t ep[GL_FETCH_EP_BYTES];
+  uint8_t done[GL_FETCH_DONE_BYTES];
+  char why[96] = {0};
+};
+struct gdakiCtrlLaLink {
+  int me = -1, nranks = 0;
+  uint32_t inc = 0;
+  uint64_t nonce = 0;
+  uint32_t qkey = 0;                // this rank's UD Q_Key (gdakiCtrlQkeyOf(nonce))
+  struct glEp ud;                   // this rank's UD QP (the ring's; gdakiCtrlLauncherSetup)
+  struct glRegion page;             // this rank's status page (phase 1's)
+  uint32_t creditOff0 = 0;          // creditOff of launcher 0 in that page (gdakiCtrlPageCreditOffL(layout, 0))
+  int own = -1;                     // the own node's launcher index
+  int nLaunchers = 0;               // the communicator's launchers (0: not known yet; the all-gather's count)
+  std::vector<struct gdakiCtrlLaPeer> la;
+  std::vector<int> laOf;            // rank -> its node's launcher index (-1: not known)
+  struct gdakiCtrlLaUnix unix;
+  std::vector<uint64_t> fencedPlus1;  // by rank: the fence word (0 none, i + 1 incarnation i ended)
+  std::vector<uint64_t> leftPlus1;    // by rank: i + 1 of the latest LEFT the lineage took (0 none)
+  std::vector<uint32_t> endKind, endNode;  // by rank: what raised the word last (GL_K_FENCED, GL_K_EXITED), from which node
+  std::vector<struct gdakiCtrlLaFence> fence;
+  std::vector<struct gdakiCtrlLaSnap> snap;  // by peer: the window cells at its judgement (gdakiCtrlLaOnJudgement)
+  struct gdakiCtrlLaCellsIo cells;
+  std::vector<struct gdakiCtrlLaAct> act;
+  struct gdakiCtrlLaTx tx;
+  struct gdakiCtrlLaLog log;
+  // the lineage's verdict on an ended (rank, inc): true for CURRENT and HELD_OLD (the host: gdakiLnClassify)
+  bool (*lnOk)(void* arg, int rank, uint32_t inc) = nullptr;
+  void* lnArg = nullptr;
+  double laterMs = GDAKI_CTRL_LATER_MS_DEFAULT, stallMs = GDAKI_CTRL_LAUNCHER_STALL_MS_DEFAULT;
+  double answerMs = GDAKI_CTRL_LA_ANSWER_MS, pairBoundMs = GL_REPAIR_MS;
+  uint32_t seq = 0;
+  bool leaving = false, latched = false;
+  struct {
+    bool valid = false;
+    uint32_t flags = 0, inc = 0;
+  } regSent;                        // the last STORE_REQ tail's registration (gdakiCtrlLaTailFill)
+  bool pairOk = true;               // the clock pairs (false: a spare before its activation; it must not take the rank's
+                                    // pairing at a launcher while the original lives, gl_on_pair drops older QPs)
+  int fwdSock = -1, fwdPeer = -1;    // the buddy: where FETCH_DONE's 80 B go (the FETCH waiter reads the other end)
+  // a blocking wait for the Unix socket (REGISTER's answer, INFO's, a spare's ACT_BYTES): null polls the socket (the
+  // host); the unit test steps its launchers here
+  void (*waitHook)(void* arg, int ms) = nullptr;
+  void* waitArg = nullptr;
+};
+static void gdakiCtrlLaInit(struct gdakiCtrlLaLink* k, int me, int nranks, uint32_t inc, uint64_t nonce, int nLaunchers) {
+  k->me = me;
+  k->nranks = nranks;
+  k->inc = inc;
+  k->nonce = nonce;
+  k->qkey = gdakiCtrlQkeyOf(nonce);
+  memset(&k->ud, 0, sizeof(k->ud));
+  memset(&k->page, 0, sizeof(k->page));
+  k->nLaunchers = nLaunchers;
+  k->la.clear();
+  k->laOf.assign((size_t)nranks, -1);
+  k->fencedPlus1.assign((size_t)nranks, GDAKI_CTRL_FENCE_NONE);
+  k->leftPlus1.assign((size_t)nranks, 0u);
+  k->endKind.assign((size_t)nranks, 0u);
+  k->endNode.assign((size_t)nranks, 0u);
+  k->fence.assign((size_t)nranks, gdakiCtrlLaFence());
+  k->snap.assign((size_t)nranks, gdakiCtrlLaSnap());
+  k->act.assign((size_t)nranks, gdakiCtrlLaAct());
+}
+static int gdakiCtrlLaIndexOfNode(const struct gdakiCtrlLaLink* k, uint32_t node);
+// A launcher of the communicator (its node, UD endpoint, Q_Key, page): its index, a new one at the end (-1: too many).
+static int gdakiCtrlLaAddLauncher(struct gdakiCtrlLaLink* k, uint32_t node, const struct glEp& ud, uint32_t qkey,
+                                  const struct glRegion& page) {
+  int li = gdakiCtrlLaIndexOfNode(k, node);
+  if (li >= 0) return li;
+  if (k->la.size() >= GDAKI_CTRL_PAGE_MAX_LAUNCHERS) return -1;
+  li = (int)k->la.size();
+  k->la.emplace_back();
+  struct gdakiCtrlLaPeer& p = k->la[(size_t)li];
+  memset(&p.ud, 0, sizeof(p.ud));
+  memset(&p.page, 0, sizeof(p.page));
+  memset(&p.local, 0, sizeof(p.local));
+  memset(&p.remote, 0, sizeof(p.remote));
+  p.note.assign((size_t)k->nranks, glRegNoteBody());
+  p.haveNote.assign((size_t)k->nranks, 0);
+  p.node = node;
+  p.ud = ud;
+  p.qkey = qkey;
+  p.page = page;
+  p.known = true;
+  gdakiCtrlPairInit(&p.pair, GDAKI_CTRL_PAIR_QP_RECORD, k->me, (int32_t)(GL_FROM_LAUNCHER | node));
+  return li;
+}
+// The node launcher of `rank` (the all-gather's launcher node of each rank; a ward's registration).
+static void gdakiCtrlLaSetRankNode(struct gdakiCtrlLaLink* k, int rank, uint32_t node) {
+  const int li = gdakiCtrlLaIndexOfNode(k, node);
+  if (rank >= 0 && rank < k->nranks && li >= 0) k->laOf[(size_t)rank] = li;
+}
+// The context's nonce (after the all-gather; the link is made before it for INFO): REGISTER, SPARE_HELLO, the messages.
+static void gdakiCtrlLaSetNonce(struct gdakiCtrlLaLink* k, uint64_t nonce) {
+  k->nonce = nonce;
+  k->qkey = gdakiCtrlQkeyOf(nonce);
+}
+// This rank's all-gather field from the INFO answer (REVIEW_P3 막는 문제 2): magic 0 without an OK answer.
+static void gdakiCtrlLaAgOf(const struct gdakiCtrlLaUnix& u, struct gdakiCtrlLaAgInfo* out) {
+  memset(out, 0, sizeof(*out));
+  if (!u.infoAcked || u.info.status != GL_UA_OK) return;
+  static_assert(sizeof(out->ud) == sizeof(u.info.ud), "the field's endpoint is launcher_msg.h's glEp");
+  out->magic = GDAKI_CTRL_LA_AG_MAGIC;
+  out->node = u.info.node;
+  out->qkey = u.info.qkey;
+  memcpy(&out->ud, &u.info.ud, sizeof(out->ud));
+  out->pageAddr = u.info.page.addr;
+  out->pageRkey = u.info.page.rkey;
+  out->pageLen = u.info.page.len;
+}
+// The communicator's launcher count from every rank's field (int2): the distinct nodes named, so every rank that sees the
+// same fields gets the same count (the page layout's nL, gdakiCtrlRingLaunchers; gdakiCtrlLaAgTake's count too).
+static int gdakiCtrlLaAgCount(const struct gdakiCtrlLaAgInfo* by, int n) {
+  std::vector<uint32_t> nodes;
+  for (int r = 0; by != nullptr && r < n; r++)
+    if (by[r].magic == GDAKI_CTRL_LA_AG_MAGIC) nodes.push_back(by[r].node);
+  std::sort(nodes.begin(), nodes.end());
+  return (int)(std::unique(nodes.begin(), nodes.end()) - nodes.begin());
+}
+// Every rank's field after the all-gather: the launchers they name, added in node order (an earlier one stays where it
+// is), each rank's node launcher, the launcher count (gdakiCtrlLaAllPaired). Returns the count.
+static int gdakiCtrlLaAgTake(struct gdakiCtrlLaLink* k, const struct gdakiCtrlLaAgInfo* by, int n) {
+  std::vector<uint32_t> nodes;
+  for (int r = 0; r < n; r++)
+    if (by[r].magic == GDAKI_CTRL_LA_AG_MAGIC) nodes.push_back(by[r].node);
+  std::sort(nodes.begin(), nodes.end());
+  nodes.erase(std::unique(nodes.begin(), nodes.end()), nodes.end());
+  for (uint32_t node : nodes)
+    for (int r = 0; r < n; r++)
+      if (by[r].magic == GDAKI_CTRL_LA_AG_MAGIC && by[r].node == node) {
+        struct glEp ud;
+        memcpy(&ud, &by[r].ud, sizeof(ud));
+        const struct glRegion page = {by[r].pageAddr, by[r].pageRkey, by[r].pageLen};
+        (void)gdakiCtrlLaAddLauncher(k, node, ud, by[r].qkey, page);
+        break;
+      }
+  for (int r = 0; r < n && r < k->nranks; r++)
+    if (by[r].magic == GDAKI_CTRL_LA_AG_MAGIC) gdakiCtrlLaSetRankNode(k, r, by[r].node);
+  k->nLaunchers = (int)nodes.size();
+  if (k->me >= 0 && k->me < k->nranks && k->laOf[(size_t)k->me] >= 0) k->own = k->laOf[(size_t)k->me];
+  return k->nLaunchers;
+}
+static int gdakiCtrlLaIndexOfNode(const struct gdakiCtrlLaLink* k, uint32_t node) {
+  for (size_t i = 0; i < k->la.size(); i++)
+    if (k->la[i].known && k->la[i].node == node) return (int)i;
+  return -1;
+}
+static void gdakiCtrlLaMsgInit(struct gdakiCtrlLaLink* k, struct glMsg* m, uint16_t kind, int32_t rank, uint32_t inc,
+                               uint32_t node) {
+  memset(m, 0, sizeof(*m));
+  m->h.magic = GL_MAGIC;
+  m->h.version = (uint16_t)GL_WIRE_VERSION;
+  m->h.kind = kind;
+  m->h.rank = rank;
+  m->h.incarnation = inc;
+  m->h.nonce = k->nonce;
+  m->h.from = k->me;
+  m->h.node = node;
+  m->h.seq = ++k->seq;
+  struct timespec ts;
+  clock_gettime(CLOCK_MONOTONIC, &ts);
+  m->h.monoNs = (uint64_t)ts.tv_sec * 1000000000ull + (uint64_t)ts.tv_nsec;
+}
+// One message on launcher li's record QP: only once it is connected (nothing before CONNECTED, design v2 2.5 step 3).
+static int gdakiCtrlLaSendTo(struct gdakiCtrlLaLink* k, int li, const struct glMsg* m) {
+  if (li < 0 || li >= (int)k->la.size() || !k->la[(size_t)li].connected || k->tx.rcSend == nullptr) return -1;
+  struct gdakiCtrlLaPeer& p = k->la[(size_t)li];
+  if (k->tx.rcSend(k->tx.arg, li, m) != 0) {
+    p.qpErr = true;
+    p.connected = false;
+    return -1;
+  }
+  p.tx++;
+  return 0;
+}
+// This rank's PAIR(record) to launcher li (setup; its record QP lost: gen + 1). The launcher answers PAIR_ACK on UD.
+static void gdakiCtrlLaPairBody(struct gdakiCtrlLaLink* k, int li, uint32_t gen, struct glPairBody* b) {
+  memset(b, 0, sizeof(*b));
+  b->gen = gen;
+  b->qkey = k->qkey;
+  b->qp = k->la[(size_t)li].local;
+  b->ud = k->ud;
+  b->page = k->page;
+  b->creditOff = k->creditOff0 + 8u * (uint32_t)li;
+}
+static bool gdakiCtrlLaPairSend(struct gdakiCtrlLaLink* k, int li, uint32_t gen) {
+  struct gdakiCtrlLaPeer& p = k->la[(size_t)li];
+  struct glMsg m;
+  gdakiCtrlLaMsgInit(k, &m, GL_K_PAIR, k->me, k->inc, p.node);
+  m.h.sub = GL_PAIR_RECORD;
+  struct glPairBody b;
+  gdakiCtrlLaPairBody(k, li, gen, &b);
+  memcpy(m.body, &b, sizeof(b));
+  m.h.bodyBytes = (uint16_t)sizeof(b);
+  return k->tx.udSend != nullptr && k->tx.udSend(k->tx.arg, li, &p.ud, p.qkey, &m) == 0;
+}
+static void gdakiCtrlLaPairStart(struct gdakiCtrlLaLink* k, int li, double now) {
+  struct gdakiCtrlLaPeer& p = k->la[(size_t)li];
+  if (!p.known) return;
+  if (gdakiCtrlPairStart(&p.pair, now, k->pairBoundMs) != GDAKI_CTRL_PA_SEND_PAIR) return;
+  p.connected = false;
+  memset(&p.local, 0, sizeof(p.local));
+  if (k->tx.rcCreate == nullptr || k->tx.rcCreate(k->tx.arg, li, p.pair.mine, &p.local) != 0) return;  // the tick resends
+  (void)gdakiCtrlLaPairSend(k, li, p.pair.mine);
+}
+// Every launcher not paired (or lost) starts a pairing; the clock resends and gives up (gdakiCtrlPairTick).
+static void gdakiCtrlLaPairTick(struct gdakiCtrlLaLink* k, double now) {
+  if (!k->pairOk) return;
+  for (size_t i = 0; i < k->la.size(); i++) {
+    struct gdakiCtrlLaPeer& p = k->la[i];
+    if (!p.known) continue;
+    if (p.pair.state == GDAKI_CTRL_PS_IDLE || (p.qpErr && p.pair.state == GDAKI_CTRL_PS_UP)) {
+      p.qpErr = false;
+      gdakiCtrlLaPairStart(k, (int)i, now);
+      continue;
+    }
+    if (gdakiCtrlPairTick(&p.pair, now) == GDAKI_CTRL_PA_RESEND_PAIR && p.pair.state == GDAKI_CTRL_PS_STARTED) {
+      // never a PAIR without a QP (int2): a create that failed at the start is tried again first
+      if (p.local.qpn == 0 &&
+          (k->tx.rcCreate == nullptr || k->tx.rcCreate(k->tx.arg, (int)i, p.pair.mine, &p.local) != 0))
+        continue;
+      (void)gdakiCtrlLaPairSend(k, (int)i, p.pair.mine);
+    }
+  }
+}
+static bool gdakiCtrlLaAllPaired(const struct gdakiCtrlLaLink* k) {
+  if (k->la.empty() || k->nLaunchers <= 0 || (int)k->la.size() != k->nLaunchers) return false;
+  for (const auto& p : k->la)
+    if (!p.known || !p.connected) return false;
+  return true;
+}
+// The arming view of this rank (launcher_msg.h glArmView) from the own launcher's answers and notes.
+static struct glArmView gdakiCtrlLaArmViewOf(const struct gdakiCtrlLaLink* k) {
+  struct glArmView v;
+  memset(&v, 0, sizeof(v));
+  v.inc = k->inc;
+  v.regAcked = k->unix.acked && k->unix.ackStatus == GL_UA_OK && k->unix.role == GDAKI_CTRL_LA_ROLE_RANK ? 1u : 0u;
+  v.regAckInc = k->unix.ackInc;
+  v.leaving = k->leaving || k->unix.leavingSent ? 1u : 0u;
+  v.allPaired = gdakiCtrlLaAllPaired(k) ? 1u : 0u;
+  if (k->own >= 0 && k->own < (int)k->la.size() && k->me >= 0 && k->me < k->nranks) {
+    const struct gdakiCtrlLaPeer& p = k->la[(size_t)k->own];
+    v.ownPaired = p.connected ? 1u : 0u;
+    if (p.haveNote[(size_t)k->me]) {
+      const struct glRegNoteBody& n = p.note[(size_t)k->me];
+      v.notedReg = n.regState;
+      v.notedInc = n.regInc;
+      v.notedSpare = n.spareState;
+      v.notedSpareInc = n.spareInc;
+    }
+  }
+  return v;
+}
+static bool gdakiCtrlLaPathExists(const struct gdakiCtrlLaLink* k) {
+  const struct glArmView v = gdakiCtrlLaArmViewOf(k);
+  return gl_path_exists(&v) != 0;
+}
+// ---- the Unix socket's blocking waits (the setup thread; a spare's driver) ----
+static void gdakiCtrlLaWaitSock(struct gdakiCtrlLaLink* k, int ms) {
+  if (k->waitHook != nullptr) k->waitHook(k->waitArg, ms);
+  else gdakiCtrlLaUnixWait(&k->unix, ms);
+  (void)gdakiCtrlLaUnixPoll(&k->unix, k->log, k->me);
+}
+static bool gdakiCtrlLaOpenSock(struct gdakiCtrlLaLink* k, char* why, size_t whyLen) {
+  if (k->unix.fd >= 0) return !k->unix.closed;
+  char path[sizeof(((struct sockaddr_un*)nullptr)->sun_path)];
+  if (!gdakiCtrlLaSockPath(path, sizeof(path))) {
+    snprintf(why, whyLen, "the socket path is too long");
+    return false;
+  }
+  return gdakiCtrlLaUnixOpen(&k->unix, path, why, whyLen);
+}
+// INFO and its answer within waitMs (before the all-gather: no nonce). True: answered OK (k->unix.info).
+static bool gdakiCtrlLaInfoWait(struct gdakiCtrlLaLink* k, int waitMs) {
+  char why[160] = {0};
+  if (!gdakiCtrlLaOpenSock(k, why, sizeof(why)) || !gdakiCtrlLaUnixInfo(&k->unix, k->me)) return false;
+  const double end = gdakiQ4MonoMs() + waitMs;
+  while (!k->unix.infoAcked && !k->unix.closed && gdakiQ4MonoMs() < end) gdakiCtrlLaWaitSock(k, 5);
+  return k->unix.infoAcked && k->unix.info.status == GL_UA_OK;
+}
+// REGISTER (a rank) or SPARE_HELLO (a spare) and its answer within waitMs; NCCL_GIN_CTRL_LAUNCHER_NODE, when set, must be
+// the answer's node. True: registered; the own launcher known (added at the end unless the all-gather added it) and this
+// rank's node launcher set. False with why.
+static bool gdakiCtrlLaRegisterWait(struct gdakiCtrlLaLink* k, int role, uint32_t inc, int waitMs, char* why, size_t whyLen) {
+  why[0] = '\0';
+  if (gdakiCtrlLaOpenSock(k, why, whyLen) && gdakiCtrlLaUnixHello(&k->unix, role, k->me, inc, k->nonce, why, whyLen)) {
+    const double end = gdakiQ4MonoMs() + waitMs;
+    while (!k->unix.acked && !k->unix.closed && gdakiQ4MonoMs() < end) gdakiCtrlLaWaitSock(k, 5);
+    if (!k->unix.acked) snprintf(why, whyLen, "no answer from the launcher in %d ms", waitMs);
+    else if (k->unix.ackStatus != GL_UA_OK) snprintf(why, whyLen, "refused: %s", gl_reason_text(k->unix.ackReason));
+  } else if (why[0] == '\0') {
+    snprintf(why, whyLen, "the socket is closed");
+  }
+  const long envNode = gdakiCtrlLaNodeEnv();
+  if (why[0] == '\0' && envNode >= 0 && (uint32_t)envNode != k->unix.ack.node)
+    snprintf(why, whyLen, "%s=%ld but the launcher on the socket is node %u", GL_NODE_ENV, envNode, k->unix.ack.node);
+  if (why[0] != '\0') return false;
+  k->inc = inc;
+  k->own = gdakiCtrlLaAddLauncher(k, k->unix.ack.node, k->unix.ack.ud, k->unix.ack.qkey, k->unix.ack.page);
+  gdakiCtrlLaSetRankNode(k, k->me, k->unix.ack.node);
+  return k->own >= 0;
+}
+// The latch's condition (REVIEW_P12 고칠 것 5): the record QP to the own launcher is connected and the launcher holds
+// this incarnation's pidfd (its HELLO_ACK and its note ALIVE for inc).
+static bool gdakiCtrlLaPairedOwn(const struct gdakiCtrlLaLink* k) {
+  const struct glArmView v = gdakiCtrlLaArmViewOf(k);
+  return v.regAcked && v.regAckInc == v.inc && v.ownPaired && v.notedReg == GL_RS_ALIVE && v.notedInc == v.inc;
+}
+
+// The buddy's part of a ward's arming (design v3 5.4 7, 재검토 S14; REVIEW_P3 고칠 것 2): the buddy fences and activates
+// the ward through the ward's node launcher only, so its PAUSED of the ward's checkpoint is armable only while its
+// record QP to that launcher is CONNECTED (a revived buddy: after it paired again as its new incarnation) and it has not
+// left. The ward's CKPT_STABLE needs every PAUSED armable (allArmable), so the ward re-arms only after that pairing.
+static bool gdakiCtrlLaWardPathOk(const struct gdakiCtrlLaLink* k, int ward) {
+  const int li = ward >= 0 && ward < k->nranks ? k->laOf[(size_t)ward] : -1;
+  if (li < 0 || li >= (int)k->la.size() || k->leaving || k->unix.leavingSent || !k->pairOk) return false;
+  const struct gdakiCtrlLaPeer& p = k->la[(size_t)li];
+  return p.known && p.connected && !p.qpErr;
+}
+
+// ---- STORE_REQ's registration and CKPT_STABLE's arming (REVIEW_P3 고칠 것 3) ----
+// The tail's path is computed once and kept: CKPT_STABLE arms only when the buddy's registration (that tail) says the
+// path for this incarnation and the path exists now.
+static bool gdakiCtrlLaTailFill(struct gdakiCtrlLaLink* k, struct gdakiCtrlLaSpareReg* g) {
+  const bool path = gdakiCtrlLaPathExists(k);
+  memset(g, 0, sizeof(*g));
+  g->magic = GDAKI_CTRL_LA_SPAREREG_MAGIC;
+  g->version = GDAKI_CTRL_LA_SPAREREG_VERSION;
+  g->path = GDAKI_CTRL_LA_PATH_LAUNCHER;
+  g->node = k->own >= 0 && k->own < (int)k->la.size() ? k->la[(size_t)k->own].node : 0u;
+  g->rank = k->me;
+  g->inc = k->inc;
+  g->flags = path ? GDAKI_CTRL_LA_REG_F_PATH : 0u;
+  k->regSent.valid = true;
+  k->regSent.flags = g->flags;
+  k->regSent.inc = k->inc;
+  return path;
+}
+// *resend: the path exists but the registration the buddy holds does not say so (a new STORE_REQ carries it).
+static bool gdakiCtrlLaStableArm(struct gdakiCtrlLaLink* k, bool allArmable, bool* resend) {
+  const bool now = gdakiCtrlLaPathExists(k);
+  const bool held = k->regSent.valid && k->regSent.inc == k->inc && (k->regSent.flags & GDAKI_CTRL_LA_REG_F_PATH) != 0;
+  *resend = now && !held;
+  return allArmable && now && held;
+}
+
+// ---- the fence word and its lines ----
+// An ended (rank, inc) from launcher li (EXITED, FENCED): the word goes to max(word, inc + 1) when the lineage takes it.
+// The buddy's FENCED line and every survivor's window line come once per armed hold (gdakiCtrlLaFenceReport).
+// The judgement of (peer, dead) here, before the hold start's quiesce: the window cells' snapshot, once per (peer, dead).
+static void gdakiCtrlLaOnJudgement(struct gdakiCtrlLaLink* k, int peer, uint32_t dead) {
+  if (peer < 0 || peer >= k->nranks) return;
+  struct gdakiCtrlLaSnap& s = k->snap[(size_t)peer];
+  if (s.have && s.dead == dead) return;
+  gdakiCtrlLaCellsTake(k->cells, &s.v, &s.ok);
+  s.have = true;
+  s.dead = dead;
+}
+// The window line, once per armed hold: `after` is "fence" (the word stood by FENCED) or "judgement" (by EXITED, or the
+// hold ended without the word).
+static void gdakiCtrlLaWindowLine(struct gdakiCtrlLaLink* k, int peer, const char* after) {
+  struct gdakiCtrlLaFence& f = k->fence[(size_t)peer];
+  if (f.windowSaid) return;
+  f.windowSaid = true;
+  std::vector<uint64_t> v;
+  std::vector<uint8_t> ok;
+  gdakiCtrlLaCellsTake(k->cells, &v, &ok);
+  uint32_t unreadable = 0;
+  const uint32_t changed = gdakiCtrlLaCellsDiff(k->snap[(size_t)peer], f.dead, v, ok, &unreadable);
+  gdakiCtrlLaSay(k->log, "GIN/RC: rank %d: window check after the %s of rank %d: changed=%u cells "
+                 "against=snapshot_at_judgement unreadable=%u", k->me, after, peer, changed, unreadable);
+}
+static void gdakiCtrlLaFenceReport(struct gdakiCtrlLaLink* k, int peer, bool buddy) {
+  struct gdakiCtrlLaFence& f = k->fence[(size_t)peer];
+  if (!f.armed || !gdakiCtrlFencedIs(k->fencedPlus1[(size_t)peer], f.dead)) return;
+  if (buddy && !f.reported) {
+    f.reported = true;
+    gdakiCtrlLaSay(k->log, "GIN/RC: rank %d: rank %d (incarnation %u) fence FENCED (by %s from node %u)", k->me, peer, f.dead,
+                   k->endKind[(size_t)peer] == GL_K_EXITED ? "EXITED" : "FENCED", k->endNode[(size_t)peer]);
+  }
+  gdakiCtrlLaWindowLine(k, peer, k->endKind[(size_t)peer] == GL_K_EXITED ? "judgement" : "fence");
+}
+// The hold of (peer, f.dead) ended here without the fence word (a fallback, a cancel): the window line now.
+static void gdakiCtrlLaOnHoldEnd(struct gdakiCtrlLaLink* k, int peer) {
+  if (peer < 0 || peer >= k->nranks || !k->fence[(size_t)peer].armed) return;
+  gdakiCtrlLaWindowLine(k, peer, "judgement");
+}
+static void gdakiCtrlLaOnEnded(struct gdakiCtrlLaLink* k, int li, const struct glMsg& m) {
+  const int p = m.h.rank;
+  if (p < 0 || p >= k->nranks) return;
+  const uint32_t inc = m.h.incarnation;
+  if (k->lnOk != nullptr && !k->lnOk(k->lnArg, p, inc)) {
+    gdakiCtrlLaSay(k->log, "GIN/LN: rank %d: %s of rank %d incarnation %u from node %u is not this lineage's (FUTURE or "
+                   "STALE): the %s", k->me, m.h.kind == GL_K_EXITED ? "EXITED" : m.h.kind == GL_K_LEFT ? "LEFT" : "FENCED",
+                   p, inc, k->la[(size_t)li].node, m.h.kind == GL_K_LEFT ? "leave is not taken" : "fence word stays");
+    return;
+  }
+  if (m.h.kind == GL_K_LEFT) {  // a leave, never a fence: the judgement table's L input (REVIEW_P3 고칠 것 1)
+    k->leftPlus1[(size_t)p] = std::max<uint64_t>(k->leftPlus1[(size_t)p], (uint64_t)inc + 1u);
+    return;
+  }
+  const uint64_t w = gdakiCtrlFenceWord(inc);
+  if (w <= k->fencedPlus1[(size_t)p]) return;
+  k->fencedPlus1[(size_t)p] = w;
+  k->endKind[(size_t)p] = m.h.kind;
+  k->endNode[(size_t)p] = k->la[(size_t)li].node;
+}
+
+// ---- the judgement table's L inputs (design v3 4.2 L; REVIEW_P3 고칠 것 1) ----
+// Per rank, three words the helper publishes and the watch thread reads (no lock): LEFT's i + 1, the fence word (EXITED
+// or FENCED: "ended"), the registration word of the rank's node launcher's latest REG_NOTE (regInc << 32 | have << 8 |
+// regState). pullOk (the launcher page's READ, TODO(2a-2) 5) is not among them: until it exists L is 무응답 unless LEFT or
+// an end of that incarnation came.
+struct gdakiCtrlLaLIn {
+  bool left = false, ended = false, regAlive = false, regLeft = false;
+};
+static uint64_t gdakiCtrlLaRegWord(const struct gdakiCtrlLaLink* k, int p) {
+  const int li = p >= 0 && p < k->nranks ? k->laOf[(size_t)p] : -1;
+  if (li < 0 || li >= (int)k->la.size() || !k->la[(size_t)li].haveNote[(size_t)p]) return 0;
+  const struct glRegNoteBody& n = k->la[(size_t)li].note[(size_t)p];
+  return ((uint64_t)n.regInc << 32) | (1ull << 8) | (uint64_t)(n.regState & 0xffu);
+}
+static struct gdakiCtrlLaLIn gdakiCtrlLaLInOf(uint64_t leftPlus1, uint64_t fencedPlus1, uint64_t reg, uint32_t inc) {
+  struct gdakiCtrlLaLIn x;
+  x.left = leftPlus1 == (uint64_t)inc + 1u;
+  x.ended = gdakiCtrlFencedIs(fencedPlus1, inc);
+  const bool have = ((reg >> 8) & 1u) != 0;
+  const uint32_t st = (uint32_t)(reg & 0xffu), ri = (uint32_t)(reg >> 32);
+  x.regAlive = have && st == GL_RS_ALIVE && ri == inc;
+  x.regLeft = have && st == GL_RS_LEFT && ri == inc;
+  return x;
+}
+
+// 2a-2-C step 5: a launcher's creditOff (its PAIR's or PAIR_ACK's) names an aligned 8 B word inside its page past the head.
+static inline bool gdakiCtrlLaCreditOffOk(const struct glRegion& page, uint32_t off) {
+  return off >= 64u && off % 8u == 0 && (uint64_t)off + 8u <= (uint64_t)page.len;
+}
+// ---- messages from a launcher ----
+// UD: PAIR_ACK of this rank's PAIR, or the launcher's own PAIR (its re-pairing). RC: the rest. now: ms.
+static void gdakiCtrlLaOnUd(struct gdakiCtrlLaLink* k, const struct glMsg& m, double now) {
+  if (gl_msg_check(&m) != GL_R_NONE || m.h.nonce != k->nonce || (m.h.from & GL_FROM_LAUNCHER) == 0) return;
+  const int li = gdakiCtrlLaIndexOfNode(k, (uint32_t)m.h.from & ~(uint32_t)GL_FROM_LAUNCHER);
+  if (li < 0 || m.h.sub != GL_PAIR_RECORD || m.h.rank != k->me) return;
+  struct gdakiCtrlLaPeer& p = k->la[(size_t)li];
+  if (m.h.kind == GL_K_PAIR_ACK) {
+    struct glPairAckBody b;
+    memcpy(&b, m.body, sizeof(b));
+    if (b.status != 0) {
+      gdakiCtrlLaSay(k->log, "GIN/RC: rank %d: PAIR(record, gen %u) refused by the launcher of node %u (%s)", k->me, b.gen,
+                     p.node, gl_reason_text(m.h.reason));
+      return;
+    }
+    if (gdakiCtrlPairOnAck(&p.pair, b.gen, k->inc, true) != GDAKI_CTRL_PA_CONNECT) return;
+    if (k->tx.rcConnect == nullptr || k->tx.rcConnect(k->tx.arg, li, &b.qp) != 0) {
+      p.qpErr = true;
+      return;
+    }
+    p.remote = b.qp;
+    p.page = b.page;
+    p.creditOff = gdakiCtrlLaCreditOffOk(b.page, b.creditOff) ? b.creditOff : 0u;  // 2a-2-C step 5
+    p.connected = true;  // this side started: its CONNECTED goes first
+    struct glMsg c;
+    gdakiCtrlLaMsgInit(k, &c, GL_K_CONNECTED, k->me, k->inc, p.node);
+    if (gdakiCtrlLaSendTo(k, li, &c) != 0) return;
+    p.beatMs = -1;
+    gdakiCtrlLaSay(k->log, "GIN/RC: rank %d: record QP to the launcher of node %u paired (gen %u)", k->me, p.node, b.gen);
+    return;
+  }
+  if (m.h.kind == GL_K_PAIR) {  // the launcher re-pairs (its record QP to this rank was lost)
+    struct glPairBody b;
+    memcpy(&b, m.body, sizeof(b));
+    struct gdakiCtrlEndpoint theirs;
+    memcpy(&theirs, &b.qp, sizeof(theirs));
+    const uint32_t a = gdakiCtrlPairOnPair(&p.pair, b.gen, k->inc, true, &theirs, now);
+    struct glMsg ack;
+    gdakiCtrlLaMsgInit(k, &ack, GL_K_PAIR_ACK, k->me, k->inc, p.node);
+    ack.h.sub = GL_PAIR_RECORD;
+    ack.h.reqSeq = m.h.seq;
+    struct glPairAckBody ab;
+    memset(&ab, 0, sizeof(ab));
+    ab.gen = b.gen;
+    ab.page = k->page;
+    ab.qkey = k->qkey;
+    ab.creditOff = k->creditOff0 + 8u * (uint32_t)li;
+    if (a == GDAKI_CTRL_PA_TAKE) {
+      p.connected = false;
+      memset(&p.local, 0, sizeof(p.local));
+      if (k->tx.rcCreate == nullptr || k->tx.rcCreate(k->tx.arg, li, b.gen, &p.local) != 0 || k->tx.rcConnect == nullptr ||
+          k->tx.rcConnect(k->tx.arg, li, &b.qp) != 0) {
+        ab.status = 1;
+      } else {
+        p.remote = b.qp;
+        p.page = b.page;
+        p.creditOff = gdakiCtrlLaCreditOffOk(b.page, b.creditOff) ? b.creditOff : 0u;  // 2a-2-C step 5
+      }
+      ab.qp = p.local;
+    } else if (a == GDAKI_CTRL_PA_RESEND_ACK) {
+      ab.qp = p.local;
+    } else {
+      return;
+    }
+    memcpy(ack.body, &ab, sizeof(ab));
+    ack.h.bodyBytes = (uint16_t)sizeof(ab);
+    if (k->tx.udSend != nullptr) (void)k->tx.udSend(k->tx.arg, li, &p.ud, p.qkey, &ack);
+  }
+}
+static void gdakiCtrlLaOnRc(struct gdakiCtrlLaLink* k, int li, const struct glMsg& m, double now) {
+  (void)now;
+  if (li < 0 || li >= (int)k->la.size() || gl_msg_check(&m) != GL_R_NONE) return;
+  struct gdakiCtrlLaPeer& p = k->la[(size_t)li];
+  p.rx++;
+  if (m.h.kind == GL_K_CONNECTED) {  // the launcher started (its re-pairing): this side is up now
+    if (gdakiCtrlPairOnDone(&p.pair, p.pair.cur, k->inc, true) == GDAKI_CTRL_PA_UP) {
+      p.connected = true;
+      p.beatMs = -1;
+      gdakiCtrlLaSay(k->log, "GIN/RC: rank %d: record QP to the launcher of node %u re-paired (gen %u)", k->me, p.node,
+                     p.pair.cur);
+    }
+    return;
+  }
+  if (m.h.nonce != k->nonce) return;
+  const int r = m.h.rank;
+  switch (m.h.kind) {
+    case GL_K_REG_NOTE:
+      if (r >= 0 && r < k->nranks) {
+        memcpy(&p.note[(size_t)r], m.body, sizeof(struct glRegNoteBody));
+        p.haveNote[(size_t)r] = 1;
+        if (k->laOf[(size_t)r] < 0 && p.note[(size_t)r].regState != GL_RS_NONE) k->laOf[(size_t)r] = li;
+      }
+      return;
+    case GL_K_EXITED:
+    case GL_K_LEFT:
+    case GL_K_FENCED:
+      if (r >= 0 && r < k->nranks && k->laOf[(size_t)r] < 0) k->laOf[(size_t)r] = li;
+      gdakiCtrlLaOnEnded(k, li, m);
+      return;
+    case GL_K_FENCE_NAK:
+      if (r >= 0 && r < k->nranks && k->fence[(size_t)r].sent && k->fence[(size_t)r].dead == m.h.incarnation)
+        k->fence[(size_t)r].nak = true;
+      return;
+    case GL_K_REFUSED:  // SPAWN's answer (or a refused kind): a line, never a fallback (REVIEW2 고칠 것 1)
+      if (m.h.sub == GL_K_SPAWN) p.spawnRefused++;
+      gdakiCtrlLaSay(k->log, "GIN/RC: rank %d: the launcher of node %u refused %s of rank %d (incarnation %u): %s; no "
+                     "fallback on it", k->me, p.node, m.h.sub == GL_K_SPAWN ? "SPAWN" : "a message", r, m.h.incarnation,
+                     gl_reason_text(m.h.reason));
+      return;
+    case GL_K_ACT_ANSWER:
+    case GL_K_FETCH_EP:
+    case GL_K_FETCH_DONE: {
+      if (r < 0 || r >= k->nranks) return;
+      struct gdakiCtrlLaAct& a = k->act[(size_t)r];
+      // not this activation: another launcher, incarnation or ACTIVATE (the launcher echoes its seq, REVIEW_P3 nit 3)
+      if (a.li != li || a.inc != m.h.incarnation || a.state == GDAKI_CTRL_LA_ACT_NONE || m.h.reqSeq != a.reqSeq) return;
+      if (m.h.kind == GL_K_FETCH_EP) {
+        memcpy(a.ep, m.body, sizeof(a.ep));
+        a.haveEp = true;
+        return;
+      }
+      if (m.h.kind == GL_K_FETCH_DONE) {
+        memcpy(a.done, m.body, sizeof(a.done));
+        a.haveDone = true;
+        return;
+      }
+      struct glActAnswerBody b;
+      memcpy(&b, m.body, sizeof(b));
+      a.spareState = b.spareState;
+      a.spareAgeMs = b.spareAgeMs;
+      a.reason = m.h.reason;
+      snprintf(a.why, sizeof(a.why), "%.63s", b.why);
+      if (a.state != GDAKI_CTRL_LA_ACT_SENT && a.state != GDAKI_CTRL_LA_ACT_LATER) return;  // a final answer is final
+      if (m.h.sub == GL_RS_ACT_LATER) {
+        if (a.nLater++ == 0) {
+          a.state = GDAKI_CTRL_LA_ACT_LATER;
+          a.laterMs = now;
+        } else {
+          gdakiCtrlLaSay(k->log, "GIN/RC: rank %d: a second LATER for rank %d (incarnation %u) from node %u: ignored", k->me,
+                         r, a.inc, p.node);
+        }
+      } else if (m.h.sub == GL_RS_ACT_ACCEPTED) {
+        a.ans = b.record;
+        a.state = GDAKI_CTRL_LA_ACT_ACCEPTED;
+        a.acceptedMs = now;
+      } else {
+        a.ans = b.record;
+        a.state = GDAKI_CTRL_LA_ACT_REFUSED;
+      }
+      return;
+    }
+    default:
+      return;
+  }
+}
+// The launcher page's beat (a READ of glPage line 0 by whoever reads it: int2, the helper over the record QP).
+static void gdakiCtrlLaOnBeat(struct gdakiCtrlLaLink* k, int li, uint64_t beat, double now) {
+  struct gdakiCtrlLaPeer& p = k->la[(size_t)li];
+  if (p.beatMs < 0 || beat != p.beat) {
+    p.beat = beat;
+    p.beatMs = now;
+  }
+}
+// Launcher li is lost: its record QP is in error, or its page's beat stood stallMs (once read). *why: one word.
+static bool gdakiCtrlLaLost(const struct gdakiCtrlLaLink* k, int li, double now, const char** why) {
+  const struct gdakiCtrlLaPeer& p = k->la[(size_t)li];
+  if (p.qpErr || !p.connected) {
+    *why = p.qpErr ? "record_QP_error" : "not_paired";
+    return true;
+  }
+  if (p.beatMs >= 0 && now - p.beatMs >= k->stallMs) {
+    *why = "beat_stale";
+    return true;
+  }
+  return false;
+}
+
+// ---- the buddy: the fence (design v3 4.4 3) ----
+// The hold of (peer, dead) started here: the fence is armed (FENCED and the window line come once for it).
+static void gdakiCtrlLaFenceArm(struct gdakiCtrlLaLink* k, int peer, uint32_t dead) {
+  struct gdakiCtrlLaFence& f = k->fence[(size_t)peer];
+  if (f.armed && f.dead == dead) return;
+  f = gdakiCtrlLaFence();
+  f.armed = true;
+  f.dead = dead;
+}
+// Every HOLDING is in (the caller's decision): FENCE to the dead rank's launcher unless the word already says FENCED.
+// 1 fenced, 0 not yet, -1 fall back (FENCE_NAK, no launcher of the peer, the launcher lost, the send failed).
+static int gdakiCtrlLaFence(struct gdakiCtrlLaLink* k, int peer, uint32_t dead, double now, bool buddy) {
+  gdakiCtrlLaFenceArm(k, peer, dead);
+  struct gdakiCtrlLaFence& f = k->fence[(size_t)peer];
+  if (gdakiCtrlFencedIs(k->fencedPlus1[(size_t)peer], dead)) return 1;
+  if (f.nak) return -1;
+  const int li = k->laOf[(size_t)peer];
+  const char* lw = nullptr;
+  if (li < 0 || gdakiCtrlLaLost(k, li, now, &lw)) {
+    if (!f.sent || li < 0) {  // FENCE never went (REVIEW_P3 nit 7): a line of its own, once
+      if (buddy && !f.noPathSaid) {
+        f.noPathSaid = true;
+        char node[16];
+        if (li >= 0) snprintf(node, sizeof(node), "%u", k->la[(size_t)li].node);
+        else snprintf(node, sizeof(node), "unknown");
+        gdakiCtrlLaSay(k->log, "GIN/RC: rank %d: rank %d (incarnation %u) fence: no path to the launcher of node %s (%s): "
+                       "FENCE not sent", k->me, peer, dead, node, li < 0 ? "not_known" : lw);
+      }
+      return -1;
+    }
+    gdakiCtrlLaSay(k->log, "GIN/RC: rank %d: rank %d (incarnation %u) fence: the launcher of node %u is lost (%s) "
+                   "(STOP_launcher)", k->me, peer, dead, k->la[(size_t)li].node, lw);
+    return -1;
+  }
+  if (f.sent) return 0;
+  struct glMsg m;
+  gdakiCtrlLaMsgInit(k, &m, GL_K_FENCE, peer, dead, k->la[(size_t)li].node);
+  if (gdakiCtrlLaSendTo(k, li, &m) != 0) return -1;
+  f.sent = true;
+  f.sentMs = now;
+  if (buddy)
+    gdakiCtrlLaSay(k->log, "GIN/RC: rank %d: rank %d (incarnation %u) fence FENCING: FENCE sent to the launcher of node %u",
+                   k->me, peer, dead, k->la[(size_t)li].node);
+  return 0;
+}
+
+// The activation gate's launcher part (gdakiCtrlActFenceOk's body, the buddy, once every HOLDING is in): the fence step,
+// its FENCED report or its FENCE_NAK line. GO (the word says FENCED), WAIT, or FALLBACK with why (the caller falls back).
+enum : int { GDAKI_CTRL_LA_GATE_WAIT = 0, GDAKI_CTRL_LA_GATE_GO = 1, GDAKI_CTRL_LA_GATE_FALLBACK = -1 };
+static int gdakiCtrlLaGate(struct gdakiCtrlLaLink* k, int peer, uint32_t dead, double now, char* why, size_t whyLen) {
+  if (peer < 0 || peer >= k->nranks) {
+    snprintf(why, whyLen, "no such peer");
+    return GDAKI_CTRL_LA_GATE_FALLBACK;
+  }
+  const int f = gdakiCtrlLaFence(k, peer, dead, now, true);
+  if (f > 0) gdakiCtrlLaFenceReport(k, peer, true);
+  if (f < 0) {
+    if (k->fence[(size_t)peer].nak) {
+      const int li = k->laOf[(size_t)peer];
+      gdakiCtrlLaSay(k->log, "GIN/RC: rank %d: rank %d (incarnation %u) fence FENCE_NAK from node %u: nothing held, "
+                     "falling back", k->me, peer, dead, li >= 0 ? k->la[(size_t)li].node : 0u);
+    }
+    snprintf(why, whyLen, "the fence of the peer's dead incarnation cannot complete (FENCE_NAK, no launcher path, or the "
+                          "launcher is lost)");
+    return GDAKI_CTRL_LA_GATE_FALLBACK;
+  }
+  return gdakiCtrlFencedIs(k->fencedPlus1[(size_t)peer], dead) ? GDAKI_CTRL_LA_GATE_GO : GDAKI_CTRL_LA_GATE_WAIT;
+}
+
+// ---- the buddy: the activation through the launcher (design v3 5.4 4) ----
+enum : int { GDAKI_CTRL_LA_AS_WAIT = 0, GDAKI_CTRL_LA_AS_ACCEPTED = 1, GDAKI_CTRL_LA_AS_FALLBACK = -1 };
+// ACTIVATE (the 64 B record and the blob's region in this rank's outbox) to the launcher of the peer's node. False: not
+// sent (no launcher path).
+static bool gdakiCtrlLaActStart(struct gdakiCtrlLaLink* k, int peer, const struct glRsActivate& rec,
+                                const struct glRegion& blob, uint64_t xferId, double now) {
+  struct gdakiCtrlLaAct& a = k->act[(size_t)peer];
+  a = gdakiCtrlLaAct();
+  const int li = peer >= 0 && peer < k->nranks ? k->laOf[(size_t)peer] : -1;
+  const char* lw = nullptr;
+  if (li < 0 || gdakiCtrlLaLost(k, li, now, &lw)) return false;
+  struct glMsg m;
+  gdakiCtrlLaMsgInit(k, &m, GL_K_ACTIVATE, peer, rec.incarnation, k->la[(size_t)li].node);
+  struct glActivateBody b;
+  memset(&b, 0, sizeof(b));
+  b.record = rec;
+  b.blob = blob;
+  b.xferId = xferId;
+  memcpy(m.body, &b, sizeof(b));
+  m.h.bodyBytes = (uint16_t)sizeof(b);
+  if (gdakiCtrlLaSendTo(k, li, &m) != 0) return false;
+  a.state = GDAKI_CTRL_LA_ACT_SENT;
+  a.inc = rec.incarnation;
+  a.reqSeq = m.h.seq;
+  a.li = li;
+  a.sentMs = now;
+  return true;
+}
+static void gdakiCtrlLaAbort(struct gdakiCtrlLaLink* k, int peer) {
+  struct gdakiCtrlLaAct& a = k->act[(size_t)peer];
+  struct glMsg m;
+  gdakiCtrlLaMsgInit(k, &m, GL_K_ABORT, peer, a.inc, a.li >= 0 ? k->la[(size_t)a.li].node : 0u);
+  (void)gdakiCtrlLaSendTo(k, a.li, &m);
+  a.state = GDAKI_CTRL_LA_ACT_ABORTED;
+}
+// One step: ACCEPTED (the answer echoes the rank and the incarnation), WAIT, or FALLBACK with why (REFUSED; no first
+// answer within answerMs: ABORT; LATER and laterMs since it: ABORT; the launcher lost: its line with (STOP_launcher)).
+static int gdakiCtrlLaActStep(struct gdakiCtrlLaLink* k, int peer, double now, char* why, size_t whyLen) {
+  struct gdakiCtrlLaAct& a = k->act[(size_t)peer];
+  switch (a.state) {
+    case GDAKI_CTRL_LA_ACT_ACCEPTED:
+    case GDAKI_CTRL_LA_ACT_READY:
+      if (a.ans.rank != peer || a.ans.incarnation != a.inc) {
+        snprintf(why, whyLen, "the launcher's ACCEPTED names rank %d incarnation %u, not %u", (int)a.ans.rank,
+                 a.ans.incarnation, a.inc);
+        return GDAKI_CTRL_LA_AS_FALLBACK;
+      }
+      return GDAKI_CTRL_LA_AS_ACCEPTED;
+    case GDAKI_CTRL_LA_ACT_REFUSED:
+      snprintf(why, whyLen, "the peer's spare refused the activation (launcher: %s)", gl_reason_text(a.reason));
+      return GDAKI_CTRL_LA_AS_FALLBACK;
+    case GDAKI_CTRL_LA_ACT_SENT:
+    case GDAKI_CTRL_LA_ACT_LATER: {
+      const char* lw = nullptr;
+      if (gdakiCtrlLaLost(k, a.li, now, &lw)) {
+        gdakiCtrlLaSay(k->log, "GIN/RC: rank %d: the launcher of node %u is lost (%s) during rank %d's activation "
+                       "(incarnation %u): falling back (STOP_launcher)", k->me, k->la[(size_t)a.li].node, lw, peer, a.inc);
+        if (strcmp(lw, "beat_stale") == 0) gdakiCtrlLaAbort(k, peer);  // ABORTED (its QP may still take it)
+        else a.state = GDAKI_CTRL_LA_ACT_LOST;
+        snprintf(why, whyLen, "the launcher of the peer's node is lost (%s)", lw);
+        return GDAKI_CTRL_LA_AS_FALLBACK;
+      }
+      if (a.state == GDAKI_CTRL_LA_ACT_SENT && now - a.sentMs >= k->answerMs) {
+        gdakiCtrlLaAbort(k, peer);
+        snprintf(why, whyLen, "no answer of the launcher to the activation within %.0f ms", k->answerMs);
+        return GDAKI_CTRL_LA_AS_FALLBACK;
+      }
+      if (a.state == GDAKI_CTRL_LA_ACT_LATER && now - a.laterMs >= k->laterMs) {
+        gdakiCtrlLaAbort(k, peer);
+        snprintf(why, whyLen, "the peer's spare is not READY %.0f ms after LATER (ABORT sent)", k->laterMs);
+        return GDAKI_CTRL_LA_AS_FALLBACK;
+      }
+      return GDAKI_CTRL_LA_AS_WAIT;
+    }
+    default:
+      snprintf(why, whyLen, "no activation in progress");
+      return GDAKI_CTRL_LA_AS_FALLBACK;
+  }
+}
+// After ACCEPTED: READY (or FAIL) for the spare's FETCH (gdakiMiActReady's 72 B) through the launcher.
+static bool gdakiCtrlLaFetchReady(struct gdakiCtrlLaLink* k, int peer, const void* ready72) {
+  struct gdakiCtrlLaAct& a = k->act[(size_t)peer];
+  struct glMsg m;
+  gdakiCtrlLaMsgInit(k, &m, GL_K_FETCH_READY, peer, a.inc, k->la[(size_t)a.li].node);
+  memcpy(m.body, ready72, GL_FETCH_READY_BYTES);
+  m.h.bodyBytes = (uint16_t)GL_FETCH_READY_BYTES;
+  if (gdakiCtrlLaSendTo(k, a.li, &m) != 0) return false;
+  a.state = GDAKI_CTRL_LA_ACT_READY;
+  return true;
+}
+// SPAWN of (peer, inc) at the buddy's hold start (decision 12): one WR, its REFUSED a line only.
+static void gdakiCtrlLaSpawn(struct gdakiCtrlLaLink* k, int peer, uint32_t inc) {
+  const int li = peer >= 0 && peer < k->nranks ? k->laOf[(size_t)peer] : -1;
+  if (li < 0) return;
+  struct glMsg m;
+  gdakiCtrlLaMsgInit(k, &m, GL_K_SPAWN, peer, inc, k->la[(size_t)li].node);
+  (void)gdakiCtrlLaSendTo(k, li, &m);
+}
+
+// ---- the spare ----
+// The ACTIVATE bytes' record as this spare takes it: 0 usable, else what is wrong (the spare answers REFUSED).
+static int gdakiCtrlLaSpareCheck(const struct glRsActivate& rec, int me, uint64_t nonce, uint32_t helloInc) {
+  if (rec.magic != GL_RS_ACT_MAGIC || rec.kind != GL_RS_ACT_ACTIVATE) return 1;
+  if (rec.nonce != nonce || rec.rank != me) return 2;
+  if (rec.incarnation != helloInc) return 3;
+  if (!gdakiCtrlLaActFencedOk(rec.reserved, rec.incarnation)) return 4;  // the record does not carry FENCED
+  return 0;
+}
+static const char* gdakiCtrlLaSpareCheckText(int c) {
+  switch (c) {
+    case 1: return "not an ACTIVATE";
+    case 2: return "another communicator or rank";
+    case 3: return "another incarnation than this spare's HELLO";
+    case 4: return "the record does not carry FENCED";
+    default: return "ok";
+  }
+}
+// The FETCH talk's relay (the spare's side; the bytes of today's activation connection after ACCEPTED): the caller's end
+// of a socketpair takes them as before (gdakiMiSpareActivateFetch: out 112 B FETCH_EP, in 72 B READY, out 80 B DONE); the
+// relay thread moves them to and from the launcher's ACT_TALK. ABORT from the launcher, the launcher socket's loss, the
+// caller's close (EOF, in any phase) or stop end it (the caller's read then fails: its FETCH gives up). The bytes the
+// caller wrote are read before stop is looked at (REVIEW_P3 고칠 것 4: DONE is relayed even when the end follows it).
+struct gdakiCtrlLaRelay {
+  int fd = -1;                 // the relay's end
+  std::thread th;
+  std::atomic<bool> stop{false};
+  std::atomic<bool> done{false};  // the thread ended (its last piece relayed or given up)
+  bool aborted = false;
+  bool callerGone = false;     // the caller's end closed before the talk's end
+  int moved = 0;               // pieces moved (EP, READY, DONE)
+};
+// 1 read, 0 the caller closed, -1 stopped, aborted or the launcher socket lost.
+static int gdakiCtrlLaRelayRead(int fd, void* p, size_t n, std::atomic<bool>* stop, struct gdakiCtrlLaUnix* u,
+                                const struct gdakiCtrlLaLog& log, int me, bool* aborted) {
+  size_t have = 0;
+  while (have < n) {
+    const ssize_t k = recv(fd, (char*)p + have, n - have, MSG_DONTWAIT);
+    if (k > 0) {
+      have += (size_t)k;
+      continue;
+    }
+    if (k == 0) return 0;
+    if (errno != EAGAIN && errno != EWOULDBLOCK && errno != EINTR) return 0;
+    if (stop->load(std::memory_order_acquire)) return -1;
+    (void)gdakiCtrlLaUnixPoll(u, log, me);
+    for (const auto& t : u->talk)
+      if (t.h.sub == GL_UT_ABORT) *aborted = true;
+    if (*aborted || u->closed) return -1;
+    struct pollfd pf[2] = {{fd, POLLIN, 0}, {u->fd, POLLIN, 0}};
+    (void)poll(pf, 2, 5);
+  }
+  return 1;
+}
+static void gdakiCtrlLaRelayBody(struct gdakiCtrlLaRelay* x, struct gdakiCtrlLaUnix* u, const struct gdakiCtrlLaLog& log,
+                                 int me) {
+  uint8_t ep[GL_FETCH_EP_BYTES], done[GL_FETCH_DONE_BYTES];
+  int rd = gdakiCtrlLaRelayRead(x->fd, ep, sizeof(ep), &x->stop, u, log, me, &x->aborted);
+  if (rd == 0) x->callerGone = true;
+  if (rd != 1 || !gdakiCtrlLaUnixTalk(u, GL_UT_FETCH_EP, ep, sizeof(ep))) return;
+  x->moved++;
+  bool got = false;  // the buddy's READY (or FAIL), relayed by the launcher
+  while (!got && !x->stop.load(std::memory_order_acquire) && !x->aborted && !u->closed && !x->callerGone) {
+    (void)gdakiCtrlLaUnixPoll(u, log, me);
+    while (!u->talk.empty()) {
+      const struct glUnixMsg t = u->talk.front();
+      u->talk.pop_front();
+      if (t.h.sub == GL_UT_ABORT) x->aborted = true;
+      else if (t.h.sub == GL_UT_FETCH_READY && !got) {
+        size_t off = 0;
+        while (off < GL_FETCH_READY_BYTES) {
+          const ssize_t k = send(x->fd, t.body + off, GL_FETCH_READY_BYTES - off, MSG_NOSIGNAL);
+          if (k <= 0) break;
+          off += (size_t)k;
+        }
+        got = off == GL_FETCH_READY_BYTES;
+        if (!got) x->callerGone = true;
+      }
+    }
+    if (!got && !x->aborted) {  // the launcher's socket and the caller's end (REVIEW_P3 고칠 것 5 (가): its close)
+      struct pollfd pf[2] = {{u->fd, POLLIN, 0}, {x->fd, POLLIN, 0}};
+      if (poll(pf, 2, 5) > 0 && (pf[1].revents & (POLLIN | POLLHUP | POLLERR)) != 0) {
+        char c;
+        const ssize_t k = recv(x->fd, &c, 1, MSG_PEEK | MSG_DONTWAIT);
+        if (k == 0 || (k < 0 && errno != EAGAIN && errno != EWOULDBLOCK && errno != EINTR)) x->callerGone = true;
+      }
+    }
+  }
+  if (!got) return;
+  x->moved++;
+  rd = gdakiCtrlLaRelayRead(x->fd, done, sizeof(done), &x->stop, u, log, me, &x->aborted);
+  if (rd == 0) x->callerGone = true;
+  if (rd == 1 && gdakiCtrlLaUnixTalk(u, GL_UT_FETCH_DONE, done, sizeof(done))) x->moved++;
+}
+static void gdakiCtrlLaRelayMain(struct gdakiCtrlLaRelay* x, struct gdakiCtrlLaUnix* u, struct gdakiCtrlLaLog log, int me) {
+  gdakiCtrlLaRelayBody(x, u, log, me);
+  shutdown(x->fd, SHUT_RDWR);
+  x->done.store(true, std::memory_order_release);
+}
+// Start the relay: *callerFd is the caller's end. False: no socketpair.
+static bool gdakiCtrlLaRelayStart(struct gdakiCtrlLaRelay* x, struct gdakiCtrlLaUnix* u, const struct gdakiCtrlLaLog& log,
+                                  int me, int* callerFd) {
+  int sv[2];
+  if (socketpair(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0, sv) != 0) return false;
+  x->fd = sv[1];
+  x->stop.store(false, std::memory_order_release);
+  x->done.store(false, std::memory_order_release);
+  x->aborted = false;
+  x->callerGone = false;
+  x->moved = 0;
+  *callerFd = sv[0];
+  x->th = std::thread(gdakiCtrlLaRelayMain, x, u, log, me);
+  return true;
+}
+// End the relay: graceMs > 0 (after the FETCH): the thread ends by itself (DONE relayed, or the caller's EOF) within
+// graceMs before stop is set (REVIEW_P3 고칠 것 4); 0 (a failure): stop now.
+static void gdakiCtrlLaRelayEnd(struct gdakiCtrlLaRelay* x, int graceMs) {
+  if (x->th.joinable() && graceMs > 0) {
+    const double end = gdakiQ4MonoMs() + graceMs;
+    while (!x->done.load(std::memory_order_acquire) && gdakiQ4MonoMs() < end) usleep(500);
+  }
+  x->stop.store(true, std::memory_order_release);
+  if (x->th.joinable()) x->th.join();
+  if (x->fd >= 0) close(x->fd);
+  x->fd = -1;
+}
+// A spare's REPLAY_FAILED (REVIEW_P3 고칠 것 9): its replay or its Resume refused before an activation was accepted
+// (the launcher answers the buddy REFUSED, design v3 5.2), once.
+static bool gdakiCtrlLaSpareFail(struct gdakiCtrlLaUnix* u, const char* why) {
+  if (u->role != GDAKI_CTRL_LA_ROLE_SPARE || u->failedSent || u->fd < 0 || u->closed) return false;
+  u->failedSent = gdakiCtrlLaUnixStatus(u, false, why);
+  return u->failedSent;
+}
+// The blob of ACT_BYTES on a socketpair's read end, for the reader of today's activation connection (gdakiMiActRecv).
+// -1: none.
+static int gdakiCtrlLaBlobFd(const std::vector<uint8_t>& blob) {
+  int sv[2];
+  if (socketpair(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0, sv) != 0) return -1;
+  int sz = (int)std::max<size_t>(blob.size() + 4096, 1u << 16);
+  (void)setsockopt(sv[1], SOL_SOCKET, SO_SNDBUF, &sz, sizeof(sz));
+  (void)setsockopt(sv[0], SOL_SOCKET, SO_RCVBUF, &sz, sizeof(sz));
+  size_t off = 0;
+  while (off < blob.size()) {
+    const ssize_t k = send(sv[1], blob.data() + off, blob.size() - off, MSG_NOSIGNAL | MSG_DONTWAIT);
+    if (k <= 0) break;
+    off += (size_t)k;
+  }
+  close(sv[1]);
+  if (off != blob.size()) {
+    close(sv[0]);
+    return -1;
+  }
+  return sv[0];
+}
+// ---- the host's glue, here for the unit test (REVIEW_P3 고칠 것 6): the buddy's activation step, the FETCH_DONE hand-off,
+// the spare's wait and its revival; the host gives the mirror's and the hold's parts as tables ----
+// FETCH_DONE through the launcher to the FETCH waiter (its socketpair's other end), then that end closed.
+static void gdakiCtrlLaFetchFwdStep(struct gdakiCtrlLaLink* k) {
+  if (k->fwdSock < 0 || k->fwdPeer < 0 || k->fwdPeer >= k->nranks) return;
+  struct gdakiCtrlLaAct& a = k->act[(size_t)k->fwdPeer];
+  if (!a.haveDone) return;
+  (void)send(k->fwdSock, a.done, sizeof(a.done), MSG_NOSIGNAL | MSG_DONTWAIT);
+  a.haveDone = false;
+  close(k->fwdSock);
+  k->fwdSock = -1;
+  k->fwdPeer = -1;
+}
+struct gdakiCtrlLaBuddyOps {
+  void* arg = nullptr;
+  void (*unlock)(void* arg) = nullptr;  // around the drain and the blob (the helper's time; the link's mutex is free)
+  void (*lock)(void* arg) = nullptr;
+  // mirror or store on: the drain step: 0 drained, > 0 not yet (the next step), < 0 fall back with why
+  int (*drain)(void* arg, int peer, uint32_t dead, uint64_t step, char* why, size_t whyLen) = nullptr;
+  // the blob's bytes for the record; false with why
+  bool (*blob)(void* arg, int peer, uint32_t dead, const struct glRsActivate& rec, std::vector<uint8_t>* bytes, char* why,
+               size_t whyLen) = nullptr;
+  // the blob into its slot (int2: the ring's launcher blob slot): its region and transfer id; false: no slot
+  bool (*outboxPut)(void* arg, const std::vector<uint8_t>& bytes, struct glRegion* out, uint64_t* xferId) = nullptr;
+  // after ACCEPTED: this rank's FETCH QP to the spare's endpoint (gdakiMiActAnswer::fetch); false with why
+  bool (*fetchConnect)(void* arg, int peer, uint32_t dead, const struct gdakiMiActAnswer& an, char* why, size_t whyLen) =
+    nullptr;
+  // the FETCH waiter on fd (it reads the spare's DONE, 80 B, and owns fd); false: none (fd is closed here)
+  bool (*waiter)(void* arg, int peer, uint32_t dead, int fd) = nullptr;
+};
+struct gdakiCtrlLaBuddyOut {
+  bool started = false;     // ACTIVATE went out in this step
+  bool laterNew = false;    // the first LATER is new in this step (the host's LATER line)
+  bool fetchReady = false;  // READY went to the spare (its FETCH runs)
+  bool endAct = false;      // the caller ends the mirror's activation (gdakiMiActEnd) with the fallback
+  char why[256] = {0};      // the fallback's reason
+  char fetchWhy[160] = {0}; // the FETCH handshake's failure (the host's GIN/MI line)
+};
+enum : int { GDAKI_CTRL_LA_BS_WAIT = 0, GDAKI_CTRL_LA_BS_ACTIVATED = 1, GDAKI_CTRL_LA_BS_FALLBACK = -1 };
+// One step of the buddy's activation of (peer, dead + 1) (gdakiHoldActivateSend's rdma body). The first step decorates
+// the record (pid and pidStart 0, reserved = FENCED, version MI with the blob) and sends ACTIVATE; the next ones read the
+// answer (gdakiCtrlLaActStep) and, mirror or store on, after ACCEPTED: the spare's FETCH endpoint within 1000 ms, this
+// rank's FETCH QP, READY through the launcher, the waiter on a socketpair the FETCH_DONE hand-off fills.
+static int gdakiCtrlLaBuddyStep(struct gdakiCtrlLaLink* k, int peer, const struct glRsActivate& rec0, uint32_t dead, bool mi,
+                                double now, const struct gdakiCtrlLaBuddyOps& ops, struct gdakiCtrlLaBuddyOut* out) {
+  struct gdakiCtrlLaAct& st = k->act[(size_t)peer];
+  if (st.state == GDAKI_CTRL_LA_ACT_NONE || st.inc != dead + 1u) {  // this activation's first step: ACTIVATE
+    struct glRsActivate rec = rec0;
+    rec.pid = 0;  // the launcher holds the pidfd; the record carries FENCED instead
+    rec.pidStart = 0;
+    rec.reserved = gdakiCtrlLaActFencedMark(rec.incarnation);
+    std::vector<uint8_t> bytes;
+    if (mi) {
+      if (ops.unlock != nullptr) ops.unlock(ops.arg);
+      const int dr = ops.drain != nullptr ? ops.drain(ops.arg, peer, dead, rec.step, out->why, sizeof(out->why)) : 0;
+      bool ok = dr == 0;
+      if (ok && (ops.blob == nullptr || !ops.blob(ops.arg, peer, dead, rec, &bytes, out->why, sizeof(out->why)))) {
+        ok = false;
+        out->endAct = true;
+        if (out->why[0] == '\0') snprintf(out->why, sizeof(out->why), "the activation blob could not be encoded");
+      }
+      if (ops.lock != nullptr) ops.lock(ops.arg);
+      if (dr > 0) return GDAKI_CTRL_LA_BS_WAIT;  // not drained yet: the next helper step
+      if (!ok) return GDAKI_CTRL_LA_BS_FALLBACK;
+      rec.version = GDAKI_RS_ACT_VERSION_MI;
+    }
+    struct glRegion at;
+    memset(&at, 0, sizeof(at));
+    uint64_t xferId = 0;
+    if (ops.outboxPut == nullptr || !ops.outboxPut(ops.arg, bytes, &at, &xferId) ||
+        !gdakiCtrlLaActStart(k, peer, rec, at, xferId, now)) {
+      out->endAct = mi;
+      snprintf(out->why, sizeof(out->why), "no launcher path for the peer's activation (no ring, or the blob does not fit its slot)");
+      return GDAKI_CTRL_LA_BS_FALLBACK;
+    }
+    out->started = true;
+    return GDAKI_CTRL_LA_BS_WAIT;  // the answer comes in a later step (event based: no asking again, design v3 5.4 4)
+  }
+  const int s = gdakiCtrlLaActStep(k, peer, now, out->why, sizeof(out->why));
+  if (st.nLater > 0 && !st.laterSaid) {
+    st.laterSaid = true;
+    out->laterNew = true;
+  }
+  if (s == GDAKI_CTRL_LA_AS_WAIT) return GDAKI_CTRL_LA_BS_WAIT;
+  if (s == GDAKI_CTRL_LA_AS_FALLBACK) {
+    out->endAct = mi;
+    return GDAKI_CTRL_LA_BS_FALLBACK;
+  }
+  if (!mi || st.state != GDAKI_CTRL_LA_ACT_ACCEPTED) return GDAKI_CTRL_LA_BS_ACTIVATED;
+  // the FETCH handshake: the spare's endpoint, this rank's READY
+  char w[160] = {0};
+  if (!st.haveEp) {
+    if (now - st.acceptedMs < 1000.0) return GDAKI_CTRL_LA_BS_WAIT;  // within 1000 ms (as the TCP path)
+    snprintf(w, sizeof(w), "no FETCH endpoint from the spare");
+  }
+  struct gdakiMiActAnswer an;
+  memset(&an, 0, sizeof(an));
+  static_assert(sizeof(an) == GL_FETCH_EP_BYTES, "the spare's FETCH endpoint is the relayed 112 B");
+  if (st.haveEp) memcpy(&an, st.ep, sizeof(an));
+  struct gdakiMiActReady rd;
+  memset(&rd, 0, sizeof(rd));
+  static_assert(sizeof(rd) == GL_FETCH_READY_BYTES, "READY is the relayed 72 B");
+  rd.magic = GDAKI_MI_ACTB_MAGIC;
+  if (w[0] != '\0') {
+  } else if (an.magic != GDAKI_MI_ACTB_MAGIC || an.ok != 1) {
+    an.why[sizeof(an.why) - 1] = '\0';
+    snprintf(w, sizeof(w), "no FETCH endpoint from the spare%s%.100s", an.magic == GDAKI_MI_ACTB_MAGIC ? ": " : "",
+             an.magic == GDAKI_MI_ACTB_MAGIC ? an.why : "");
+  } else if (ops.fetchConnect != nullptr && ops.fetchConnect(ops.arg, peer, dead, an, w, sizeof(w))) {
+    rd.kind = GDAKI_MI_ACT_READY;
+  } else if (w[0] == '\0') {
+    snprintf(w, sizeof(w), "no FETCH QP of this rank for the peer");
+  }
+  out->endAct = true;
+  if (rd.kind != GDAKI_MI_ACT_READY) {
+    rd.kind = GDAKI_MI_ACT_FAIL;
+    snprintf(rd.why, sizeof(rd.why), "%.63s", w);
+    (void)gdakiCtrlLaFetchReady(k, peer, &rd);
+    snprintf(out->fetchWhy, sizeof(out->fetchWhy), "%s", w);
+    snprintf(out->why, sizeof(out->why), "the peer's spare accepted its activation but the FETCH handshake failed");
+    return GDAKI_CTRL_LA_BS_FALLBACK;
+  }
+  int sv[2];
+  if (socketpair(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0, sv) != 0) {
+    sv[0] = sv[1] = -1;
+  } else if (ops.waiter == nullptr || !ops.waiter(ops.arg, peer, dead, sv[0])) {  // REVIEW_P3 nit 8: no waiter, no activation
+    close(sv[0]);
+    close(sv[1]);
+    sv[0] = sv[1] = -1;
+  }
+  if (sv[1] < 0) {
+    rd.kind = GDAKI_MI_ACT_FAIL;
+    snprintf(rd.why, sizeof(rd.why), "the buddy's FETCH waiter could not start");
+    (void)gdakiCtrlLaFetchReady(k, peer, &rd);
+    gdakiCtrlLaAbort(k, peer);  // after ACCEPTED only ABORT ends the launcher's activation (EXPERIMENT.md 9.5 (8))
+    snprintf(out->fetchWhy, sizeof(out->fetchWhy), "the buddy's FETCH waiter could not start");
+    snprintf(out->why, sizeof(out->why), "the peer's spare accepted its activation but the FETCH handshake failed");
+    return GDAKI_CTRL_LA_BS_FALLBACK;
+  }
+  if (!gdakiCtrlLaFetchReady(k, peer, &rd)) {
+    close(sv[1]);  // the waiter sees EOF
+    snprintf(out->why, sizeof(out->why), "READY could not be sent to the peer's spare through its launcher");
+    return GDAKI_CTRL_LA_BS_FALLBACK;
+  }
+  if (k->fwdSock >= 0) close(k->fwdSock);
+  k->fwdSock = sv[1];
+  k->fwdPeer = peer;
+  out->endAct = false;
+  out->fetchReady = true;
+  return GDAKI_CTRL_LA_BS_ACTIVATED;
+}
+// The spare: READY to its launcher, then its ACTIVATE (the launcher hands it over only after READY) within waitMs,
+// checked: the record (this communicator, this rank, the HELLO's incarnation, FENCED carried) and, mirror or store on,
+// the blob as today's reader takes it (blobRecv on a socketpair holding it); the FETCH relay before ACCEPTED (one that
+// cannot start is REFUSED); the answer as ACT_TALK ANSWER. 0: ACCEPTED (*actFd the FETCH talk's end with mi, else -1);
+// else what failed (GDAKI_CTRL_LA_ST_*) with why.
+struct gdakiCtrlLaSpareOps {
+  void* arg = nullptr;
+  void (*unlock)(void* arg) = nullptr;  // around the wait for the bytes
+  void (*lock)(void* arg) = nullptr;
+  // mirror or store on: today's reader of the blob on fd (gdakiMiActRecv): 0 usable, else REFUSED with why
+  int (*blobRecv)(void* arg, int fd, const struct glRsActivate& rec, char* why, size_t whyLen) = nullptr;
+};
+enum : int {
+  GDAKI_CTRL_LA_ST_OK = 0, GDAKI_CTRL_LA_ST_NO_HELLO = 1, GDAKI_CTRL_LA_ST_NO_READY = 2, GDAKI_CTRL_LA_ST_NO_ACT = 3,
+  GDAKI_CTRL_LA_ST_REFUSED = 4
+};
+static int gdakiCtrlLaSpareTake(struct gdakiCtrlLaLink* k, struct gdakiCtrlLaRelay* relay, int waitMs, bool mi,
+                                const struct gdakiCtrlLaSpareOps& ops, struct glRsActivate* act, int* actFd, char* why,
+                                size_t whyLen) {
+  *actFd = -1;
+  why[0] = '\0';
+  struct gdakiCtrlLaUnix& u = k->unix;
+  if (u.role != GDAKI_CTRL_LA_ROLE_SPARE || !u.acked || u.ackStatus != GL_UA_OK) return GDAKI_CTRL_LA_ST_NO_HELLO;
+  if (!gdakiCtrlLaUnixStatus(&u, true, nullptr)) return GDAKI_CTRL_LA_ST_NO_READY;
+  gdakiCtrlLaSay(k->log, "GIN/RS: spare rank %d: READY (incarnation %u) to the launcher of node %u; waiting for the "
+                 "activation", k->me, u.inc, u.ack.node);
+  const double deadline = gdakiQ4MonoMs() + waitMs;
+  while (!u.haveAct && !u.closed && gdakiQ4MonoMs() < deadline) {
+    if (ops.unlock != nullptr) ops.unlock(ops.arg);
+    if (k->waitHook != nullptr) k->waitHook(k->waitArg, 100);
+    else gdakiCtrlLaUnixWait(&u, 100);
+    if (ops.lock != nullptr) ops.lock(ops.arg);
+    (void)gdakiCtrlLaUnixPoll(&u, k->log, k->me);
+  }
+  if (!u.haveAct) {
+    snprintf(why, whyLen, "%s", u.closed ? " (its socket closed)" : "");
+    return GDAKI_CTRL_LA_ST_NO_ACT;
+  }
+  u.haveAct = false;
+  *act = u.act;
+  int code = gdakiCtrlLaSpareCheck(u.act, k->me, k->nonce, u.inc);
+  if (code != 0) snprintf(why, whyLen, "%s", gdakiCtrlLaSpareCheckText(code));
+  if (code == 0 && (mi || act->version == GDAKI_RS_ACT_VERSION_MI)) {
+    const int bfd = gdakiCtrlLaBlobFd(u.blob);
+    if (bfd < 0 || ops.blobRecv == nullptr) {
+      code = 3;
+      snprintf(why, whyLen, "the activation blob could not be read");
+    } else {
+      code = ops.blobRecv(ops.arg, bfd, *act, why, whyLen);
+    }
+    if (bfd >= 0) close(bfd);
+  }
+  // the FETCH relay before ACCEPTED (REVIEW_P3 고칠 것 5 (다)): one that cannot start is REFUSED (a final answer)
+  if (code == 0 && mi && !gdakiCtrlLaRelayStart(relay, &u, k->log, k->me, actFd)) {
+    code = 5;
+    snprintf(why, whyLen, "the FETCH relay could not start");
+  }
+  struct glRsActivate ans = *act;
+  ans.kind = code == 0 ? (uint32_t)GL_RS_ACT_ACCEPTED : (uint32_t)GL_RS_ACT_REFUSED;
+  const bool sent = gdakiCtrlLaUnixTalk(&u, GL_UT_ANSWER, &ans, sizeof(ans));
+  if (code != 0 || !sent) {
+    if (code == 0) snprintf(why, whyLen, "the answer could not be sent");
+    if (*actFd >= 0) {
+      close(*actFd);  // the relay sees EOF and ends
+      *actFd = -1;
+    }
+    gdakiCtrlLaRelayEnd(relay, 0);
+    return GDAKI_CTRL_LA_ST_REFUSED;
+  }
+  return GDAKI_CTRL_LA_ST_OK;
+}
+// The spare after its FETCH, the relay ended: this process registers as the new incarnation (the launcher swaps the
+// rank's pidfd: design v3 5.4 7) and pairs again with every launcher (its re-arming waits for that). False with why.
+static bool gdakiCtrlLaSpareRevive(struct gdakiCtrlLaLink* k, char* why, size_t whyLen) {
+  const uint32_t inc = k->unix.act.incarnation;
+  k->inc = inc;
+  for (auto& p : k->la) {
+    gdakiCtrlPairInit(&p.pair, GDAKI_CTRL_PAIR_QP_RECORD, k->me, (int32_t)(GL_FROM_LAUNCHER | p.node));
+    p.connected = false;
+  }
+  k->latched = false;
+  k->pairOk = true;
+  return gdakiCtrlLaRegisterWait(k, GDAKI_CTRL_LA_ROLE_RANK, inc, 1000, why, whyLen);
+}
+// ---- gin-control (launcher): link (end) ----
+// ---- gin-control (launcher): host ----
+NCCL_PARAM(GinCtrlLaterMs, GDAKI_CTRL_P_LATER_MS, GDAKI_CTRL_LATER_MS_DEFAULT);                 // 1000 (결정 4)
+NCCL_PARAM(GinCtrlLauncherStallMs, GDAKI_CTRL_P_LAUNCHER_STALL_MS, GDAKI_CTRL_LAUNCHER_STALL_MS_DEFAULT);  // 1000
+// r->ctrl->launcher: the link (above) of this context, made at gdakiTsStart (the setup thread; a spare before its
+// activation), then the helper's (its step in gdakiTsMain, the hold machine's calls), freed by gdakiCtrlLauncherFree. Its
+// mutex covers every use but the spare's FETCH relay thread (which alone touches the Unix socket while the spare's FETCH
+// runs). The launchers' RNIC side is the ring's (int2, below).
+struct gdakiCtrlLauncher {
+  struct gdakiCtrlLaLink k;
+  struct gdakiCtrlLaRelay relay;
+  std::mutex mu;
+  struct gdakiRecHost* r = nullptr;
+  bool registered = false;          // HELLO_ACK OK for the current role and incarnation
+  std::atomic<bool> spare{false};   // a spare process (NCCL_GIN_RESTORE_SPARE) before its activation (sparefix: atomic,
+                                    // Resume reads it without L->mu)
+  uint32_t resendSaidInc = 0;       // inc + 1 of the last "STORE_REQ goes again" line
+  // the judgement table's L inputs by rank (gdakiCtrlLaLInputs; the watch thread reads them without the mutex)
+  std::unique_ptr<std::atomic<uint64_t>[]> pubLeft, pubFenced, pubReg;
+  // 2a-2-C step 4: the launcher page pulls (helper): by launcher the last good pull's time (-1 none), by rank the word
+  // of the last pull of its node launcher's page; pubPull the watch thread's (gdakiCtrlLaPullPack, no mutex)
+  std::vector<double> pullMs;
+  std::vector<uint64_t> pullWord;
+  std::vector<int8_t> pullFound;
+  std::unique_ptr<std::atomic<uint64_t>[]> pubPull;
+  double stepMs = -1;               // int2: the helper's clock at the last gdakiCtrlLauncherStep
+};
+static_assert(GDAKI_CTRL_LAP_MAGIC == GL_PAGE_MAGIC && GDAKI_CTRL_LAP_HEAD == offsetof(struct glPage, reg) &&
+                  GDAKI_CTRL_LAP_SLOT == sizeof(struct glPageReg) && GDAKI_CTRL_LAP_REGS == GL_PAGE_REGS &&
+                  offsetof(struct glPageReg, nonce) == 0 && offsetof(struct glPageReg, reg) == 8 &&
+                  GDAKI_CTRL_LAP_RS_ALIVE == GL_RS_ALIVE && GDAKI_CTRL_LAP_RS_LEFT == GL_RS_LEFT &&
+                  GDAKI_CTRL_LAP_PULL_BYTES <= sizeof(struct glPage),
+              "the page region's pull layout is launcher_msg.h's glPage");
+static struct gdakiCtrlLauncher* gdakiCtrlLaOf(struct gdakiRecHost* r) {
+  return (r != nullptr && r->ctrl != nullptr) ? r->ctrl->launcher : nullptr;
+}
+static void gdakiCtrlLaNote(void* arg, const char* line) {
+  (void)arg;
+  GIN_TS_NOTE("%s mono_ms=%.3f", line, gdakiQ4MonoMs());
+}
+// The lineage's verdict on an ended (rank, inc) (helper): CURRENT or HELD_OLD raise the fence word (design 4.4 4).
+static bool gdakiCtrlLaLnOk(void* arg, int rank, uint32_t inc) {
+  struct gdakiRecHost* r = (struct gdakiRecHost*)arg;
+  if (rank == r->ctx->rank) return false;
+  const uint32_t c = gdakiLnClassify(gdakiLnOf(r, rank), inc);
+  return c == GDAKI_LN_CURRENT || c == GDAKI_LN_HELD_OLD;
+}
+// ---- the launchers' RNIC transport (the integration int2: TODO(2a-2) 1; impl/notes_int2.md) ----
+// The ring's (gin-control (ring): verbs back end, "the launchers' record QPs"): udSend is a datagram of envelope kind
+// GDAKI_CTRL_K_PAIR (`from` this rank, gen and seq 0, the 256 B glMsg) to the launcher's UD QP and Q_Key; rcCreate and
+// rcConnect make and connect launcher li's record QP (gdakiCtrlQpAttrLauncher: REMOTE_READ, max_dest_rd_atomic >= 1, 64
+// RECVs before RTR, a fresh PSN; the page's rxConsumedL[li] its consumed word); rcSend is a LAUNCHER envelope (seq from 1
+// per generation, ackSeq this rank's consumed count of that launcher's messages) on it, queued past the launcher's
+// window of 64. What comes back waits in the ring until gdakiCtrlLauncherStep hands it to gdakiCtrlLauncherOnEnvelope.
+// The helper's (the link calls these from the helper's step and the hold machine); no ring: -1 (no launcher path).
+static struct gdakiCtrlRing* gdakiCtrlLaRingOf(void* arg) {
+  struct gdakiRecHost* r = (struct gdakiRecHost*)arg;
+  return (r != nullptr && r->ctrl != nullptr) ? r->ctrl->ring : nullptr;
+}
+static int gdakiCtrlLaTxUd(void* arg, int li, const struct glEp* to, uint32_t qkey, const struct glMsg* m) {
+  struct gdakiCtrlRing* g = gdakiCtrlLaRingOf(arg);
+  if (g == nullptr || to == nullptr || m == nullptr) return -1;
+  struct gdakiCtrlEndpoint ud;
+  memcpy(&ud, to, sizeof(ud));
+  return gdakiCtrlRdmaLaUd(g, li, ud, qkey, m);
+}
+static int gdakiCtrlLaTxCreate(void* arg, int li, uint32_t gen, struct glEp* local) {
+  struct gdakiCtrlRing* g = gdakiCtrlLaRingOf(arg);
+  struct gdakiCtrlEndpoint e;
+  if (g == nullptr || local == nullptr || gdakiCtrlRdmaLaCreate(g, li, gen, &e) != 0) return -1;
+  memcpy(local, &e, sizeof(*local));
+  return 0;
+}
+static int gdakiCtrlLaTxConnect(void* arg, int li, const struct glEp* remote) {
+  struct gdakiCtrlRing* g = gdakiCtrlLaRingOf(arg);
+  if (g == nullptr || remote == nullptr) return -1;
+  struct gdakiCtrlEndpoint e;
+  memcpy(&e, remote, sizeof(e));
+  return gdakiCtrlRdmaLaConnect(g, li, e);
+}
+static int gdakiCtrlLaTxSend(void* arg, int li, const struct glMsg* m) {
+  struct gdakiCtrlRing* g = gdakiCtrlLaRingOf(arg);
+  return (g != nullptr && m != nullptr) ? gdakiCtrlRdmaLaSend(g, li, m) : -1;
+}
+// The window line's regions (gdakiCtrlLaCellsIo): this rank's windows on the context's collComm (registration order),
+// its signal and counter tables: what a peer's RDMA WRITE or atomic can reach (gdakiCkptRegions without the
+// ncclGinRestoreRegister buffers, which no peer writes). The helper reads a cell over the copy path (gdakiRecD2H).
+static void gdakiCtrlLaCellRegions(void* arg, std::vector<struct gdakiCtrlLaRegion>* out) {
+  struct gdakiRecHost* r = (struct gdakiRecHost*)arg;
+  out->clear();
+  {
+    std::lock_guard<std::mutex> lk(gdakiRsWinMu);
+    for (const auto& w : gdakiRsWins)
+      if (w.coll == (void*)r->ctx->collComm && !w.gone && w.hi > w.lo) out->push_back({(const void*)w.lo, (uint64_t)(w.hi - w.lo)});
+  }
+  struct gdaki_context* g = r->ctx;
+  if (g->signals_table && g->signals_table->buffer_bytes())
+    out->push_back({g->signals_table->gpu_ptr, (uint64_t)g->signals_table->buffer_bytes()});
+  if (g->counters_table && g->counters_table->buffer_bytes())
+    out->push_back({g->counters_table->gpu_ptr, (uint64_t)g->counters_table->buffer_bytes()});
+}
+static bool gdakiCtrlLaCellRead(void* arg, const void* src, void* dst, size_t n) {
+  return gdakiRecD2H((struct gdakiRecHost*)arg, dst, src, n) == ncclSuccess;
+}
+// The latch (phase 1's gdakiCtrlLauncherPairedLatch): once the own launcher is paired and holds this incarnation.
+static void gdakiCtrlLaLatchStep(struct gdakiCtrlLauncher* L) {
+  if (L->k.latched || !gdakiCtrlLaPairedOwn(&L->k)) return;
+  L->k.latched = true;
+  gdakiCtrlLauncherPairedLatch(L->r);
+  gdakiCtrlLaSay(L->k.log, "GIN/RC: rank %d: paired with the launcher of node %u, which holds incarnation %u: the "
+                 "activation gate requires FENCED", L->k.me, L->k.la[(size_t)L->k.own].node, L->k.inc);
+}
+// REGISTER (a rank) or SPARE_HELLO (a spare) and its answer within 1000 ms (the setup thread, after the all-gather: the
+// nonce; the launcher is the node's, always up during a hold). The line or the WARN.
+static void gdakiCtrlLaRegister(struct gdakiCtrlLauncher* L, int role, uint32_t inc) {
+  struct gdakiCtrlLaLink& k = L->k;
+  char why[160] = {0};
+  L->registered = gdakiCtrlLaRegisterWait(&k, role, inc, 1000, why, sizeof(why));
+  if (!L->registered) {
+    WARN("GIN/RC: rank %d: %s of incarnation %u at the node's launcher failed (%s): no launcher path, this rank is not armed "
+         "mono_ms=%.3f", k.me, role == GDAKI_CTRL_LA_ROLE_SPARE ? "spare HELLO" : "REGISTER", inc, why, gdakiQ4MonoMs());
+    return;
+  }
+  if (k.unix.forkUnwatched)
+    GIN_TS_NOTE("GIN/RC: rank %d: the launcher connection has no fork-watch slot (%d in use): a forked child keeps it "
+                "open mono_ms=%.3f", k.me, GDAKI_CTRL_LA_FORK_SLOTS, gdakiQ4MonoMs());
+  gdakiCtrlLaSay(k.log, "GIN/RC: rank %d: %s incarnation %u at the launcher of node %u (page slot %u)", k.me,
+                 role == GDAKI_CTRL_LA_ROLE_SPARE ? "spare said HELLO as" : "registered", inc, k.unix.ack.node,
+                 k.unix.ack.pageSlot);
+}
+// The link of this context, made at the first of gdakiCtrlLauncherQuery and gdakiCtrlLauncherSetup (no nonce yet: set at
+// the setup). Only a process that asks for the restore. Null: none.
+static struct gdakiCtrlLauncher* gdakiCtrlLaMake(struct gdakiRecHost* r) {
+  if (r == nullptr || r->ctrl == nullptr || r->ctx == nullptr) return nullptr;
+  if (r->ctrl->launcher != nullptr) return r->ctrl->launcher;
+  const struct gdakiRsCfg& c = gdakiRsProc();
+  if (!c.requested) return nullptr;  // no restore asked: no launcher
+  struct gdakiCtrlLauncher* L = new gdakiCtrlLauncher();
+  L->r = r;
+  struct gdakiCtrlLaLink& k = L->k;
+  const bool spare = c.spare >= 0;
+  L->spare = spare;
+  const uint32_t inc = spare ? gdakiCtrlLaSpareIncEnv() : gdakiRsSelfInc(r);
+  // this rank's UD endpoint, Q_Key, page and creditOff come at gdakiCtrlLauncherSetup (the ring's and the page's, after
+  // the all-gather); the launcher count and the other launchers from the all-gather's fields (gdakiCtrlLauncherAgTake)
+  gdakiCtrlLaInit(&k, r->ctx->rank, r->nranks, inc, 0, 0);
+  k.log.fn = gdakiCtrlLaNote;
+  k.lnOk = gdakiCtrlLaLnOk;
+  k.lnArg = r;
+  k.tx.arg = r;
+  k.tx.udSend = gdakiCtrlLaTxUd;
+  k.tx.rcCreate = gdakiCtrlLaTxCreate;
+  k.tx.rcConnect = gdakiCtrlLaTxConnect;
+  k.tx.rcSend = gdakiCtrlLaTxSend;
+  k.pairOk = !spare;  // a spare pairs as the new incarnation after its activation (gdakiCtrlLaSpareDone)
+  k.laterMs = (double)ncclParamGinCtrlLaterMs();
+  k.stallMs = (double)ncclParamGinCtrlLauncherStallMs();
+  L->pubLeft.reset(new std::atomic<uint64_t>[(size_t)r->nranks]());
+  L->pubFenced.reset(new std::atomic<uint64_t>[(size_t)r->nranks]());
+  L->pubReg.reset(new std::atomic<uint64_t>[(size_t)r->nranks]());
+  L->pubPull.reset(new std::atomic<uint64_t>[(size_t)r->nranks]());
+  L->pullWord.assign((size_t)r->nranks, 0u);
+  L->pullFound.assign((size_t)r->nranks, 0);
+  k.cells.arg = r;  // the window line's cells (REVIEW_P3 막는 문제 1)
+  k.cells.regions = gdakiCtrlLaCellRegions;
+  k.cells.read = gdakiCtrlLaCellRead;
+  r->ctrl->launcher = L;
+  return L;
+}
+static void gdakiCtrlLauncherQuery(struct gdakiRecHost* r) {
+  struct gdakiCtrlLauncher* L = gdakiCtrlLaMake(r);
+  if (L == nullptr) return;
+  std::lock_guard<std::mutex> lk(L->mu);
+  if (!gdakiCtrlLaInfoWait(&L->k, GDAKI_CTRL_LA_INFO_MS))
+    GIN_TS_NOTE("GIN/RC: rank %d: the node's launcher gave no INFO answer within %d ms (%s): this rank's all-gather field "
+                "says no launcher path mono_ms=%.3f", L->k.me, GDAKI_CTRL_LA_INFO_MS,
+                L->k.unix.fd < 0 ? "no socket" : L->k.unix.closed ? "its socket closed"
+                : L->k.unix.infoAcked ? "refused" : "no answer",
+                gdakiQ4MonoMs());
+}
+static void gdakiCtrlLauncherAgInfo(struct gdakiRecHost* r, struct gdakiCtrlLaAgInfo* out) {
+  memset(out, 0, sizeof(*out));
+  struct gdakiCtrlLauncher* L = gdakiCtrlLaOf(r);
+  if (L == nullptr) return;
+  std::lock_guard<std::mutex> lk(L->mu);
+  gdakiCtrlLaAgOf(L->k.unix, out);
+}
+static void gdakiCtrlLauncherAgTake(struct gdakiRecHost* r, const struct gdakiCtrlLaAgInfo* byRank, int nranks) {
+  struct gdakiCtrlLauncher* L = gdakiCtrlLaOf(r);
+  if (L == nullptr || byRank == nullptr) return;
+  std::lock_guard<std::mutex> lk(L->mu);
+  (void)gdakiCtrlLaAgTake(&L->k, byRank, nranks);
+}
+static void gdakiCtrlLauncherSetup(struct gdakiRecHost* r) {
+  if (r == nullptr || r->ts == nullptr) return;
+  struct gdakiCtrlLauncher* L = gdakiCtrlLaMake(r);
+  if (L == nullptr) return;
+  std::lock_guard<std::mutex> lk(L->mu);
+  struct gdakiCtrlLaLink& k = L->k;
+  gdakiCtrlLaSetNonce(&k, r->ts->nonce);
+  // int2 (TODO(2a-2) 3): this rank's side of a launcher pairing is the ring's UD QP (its own Q_Key, chosen before the
+  // exchange: not the nonce's) and the status page (its rxConsumedL[li] at creditOff0 + 8 li); no ring or no page: the
+  // pairing has no transport (the link's PAIR fails, the rank is not armed, Resume 41)
+  {
+    const struct gdakiCtrlRing* g = r->ctrl->ring;
+    const struct gdakiCtrlPage* pg = gdakiPageOf(r);
+    if (g != nullptr) {
+      static_assert(sizeof(k.ud) == sizeof(g->udLocal), "the link's endpoint is the ring's");
+      memcpy(&k.ud, &g->udLocal, sizeof(k.ud));
+      k.qkey = g->qkey;
+    }
+    if (gdakiPageUp(pg)) {
+      k.page.addr = (uint64_t)(uintptr_t)pg->page;
+      k.page.rkey = pg->pageMr->rkey;
+      k.page.len = pg->layout.bytes;
+      k.creditOff0 = gdakiCtrlPageCreditOffL(pg->layout, 0);
+    }
+  }
+  if (L->spare && k.inc == 0) {
+    WARN("GIN/RC: rank %d: %s is not an incarnation above 0: the spare says no HELLO mono_ms=%.3f", k.me,
+         GDAKI_CTRL_LA_SPARE_INC_ENV, gdakiQ4MonoMs());
+    return;
+  }
+  gdakiCtrlLaRegister(L, L->spare ? GDAKI_CTRL_LA_ROLE_SPARE : GDAKI_CTRL_LA_ROLE_RANK, k.inc);
+}
+// ---- the launcher page pull (2a-2-C step 4; the L input's pullOk and registration word, design v3 4.2 L) ----
+// One successful beat READ of launcher li that read the slots (L->mu held): its time and, for every rank of that node,
+// the word of its slot (gdakiCtrlLaPageRegOf; none: "no information"). A READ of 16 B (a shorter page) is no pull.
+static void gdakiCtrlLaOnPull(struct gdakiCtrlLauncher* L, struct gdakiCtrlRing* g, int li, double now) {
+  static thread_local std::vector<uint8_t> buf(GDAKI_CTRL_LAP_PULL_BYTES);
+  const size_t n = gdakiCtrlRdmaLaPullCopy(g, li, buf.data(), buf.size());
+  if (n < GDAKI_CTRL_LAP_PULL_BYTES) return;
+  for (int q = 0; q < L->k.nranks && q < (int)L->k.laOf.size(); q++) {
+    if (L->k.laOf[(size_t)q] != li) continue;
+    uint64_t w = 0;
+    const int f = gdakiCtrlLaPageRegOf(buf.data(), n, L->k.nonce, q, &w);
+    if (f < 0) return;  // not a launcher page: no pull
+    L->pullWord[(size_t)q] = w;
+    L->pullFound[(size_t)q] = (int8_t)f;
+  }
+  L->pullMs[(size_t)li] = now;
+}
+// Every rank's pull word for the watch thread: pullOk of its node launcher (gdakiCtrlLaPullOk) and its slot's word.
+static void gdakiCtrlLaPublishPull(struct gdakiCtrlLauncher* L, double now) {
+  if (!L->pubPull) return;
+  for (int q = 0; q < L->k.nranks && q < (int)L->k.laOf.size(); q++) {
+    const int li = L->k.laOf[(size_t)q];
+    bool ok = false;
+    if (li >= 0 && li < (int)L->k.la.size() && (size_t)li < L->pullMs.size()) {
+      const struct gdakiCtrlLaPeer& p = L->k.la[(size_t)li];
+      const char* why = nullptr;
+      ok = gdakiCtrlLaPullOk(p.connected, p.qpErr, gdakiCtrlLaLost(&L->k, li, now, &why), L->pullMs[(size_t)li], now,
+                             L->k.stallMs);
+    }
+    L->pubPull[(size_t)q].store(gdakiCtrlLaPullPack(ok, L->pullFound[(size_t)q], L->pullWord[(size_t)q]),
+                                std::memory_order_release);
+  }
+}
+// The pull's L inputs of (peer, inc) for the watch thread (no lock): pullOk and the page's (ALIVE | LEFT, peer, inc).
+static void gdakiCtrlLaPullInputs(struct gdakiRecHost* r, int peer, uint32_t inc, bool* pullOk, bool* regAlive,
+                                  bool* regLeft) {
+  *pullOk = *regAlive = *regLeft = false;
+  struct gdakiCtrlLauncher* L = gdakiCtrlLaOf(r);
+  if (L == nullptr || !L->pubPull || peer < 0 || peer >= L->k.nranks) return;
+  gdakiCtrlLaPullL(L->pubPull[(size_t)peer].load(std::memory_order_acquire), inc, pullOk, regAlive, regLeft);
+}
+// The helper's step (gdakiTsMain): the socket (its loss: the line), the pairings' clock, the latch, the buddy's FETCH QP.
+static void gdakiCtrlLauncherStep(struct gdakiRecHost* r) {
+  struct gdakiCtrlLauncher* L = gdakiCtrlLaOf(r);
+  if (L == nullptr) return;
+  struct gdakiCtrlRing* g = r->ctrl->ring;
+  {  // int2 (TODO(2a-2) 2; REVIEW_P3 2a-2와 합칠 때 3): what the ring took from the launchers since the last step, before the
+     // link's step below (a FETCH_DONE reaches its waiter in this step); OnEnvelope takes the mutex itself
+    struct gdakiCtrlLaIn x;
+    while (gdakiCtrlRdmaLaTake(g, &x)) gdakiCtrlLauncherOnEnvelope(r, &x.env, x.body, x.ud);
+  }
+  gdakiCtrlEffEndedStep(r);  // 2a-2-C step 4: a launcher's EXITED or FENCED ends an effective pair at once (no lock)
+  std::lock_guard<std::mutex> lk(L->mu);
+  const double now = gdakiQ4MonoMs();
+  (void)gdakiCtrlLaUnixPoll(&L->k.unix, L->k.log, L->k.me);
+  // int2 (TODO(2a-2) 5): the launcher QPs' loss and the pages' beat. The beat's stall counts on this helper's clock across
+  // its own steps only: a gap of the helper itself (half the bound) restarts it, so a slow helper never calls a launcher
+  // lost before its next READ (a READ that never completes still ends in the bound: the launcher does not answer)
+  const bool gap = L->stepMs >= 0 && now - L->stepMs > L->k.stallMs / 2;
+  L->stepMs = now;
+  for (size_t li = 0; g != nullptr && li < L->k.la.size(); li++) {
+    struct gdakiCtrlLaPeer& p = L->k.la[li];
+    if (gdakiCtrlRdmaLaErrTake(g, (int)li) && p.connected) {
+      p.qpErr = true;
+      p.connected = false;
+    }
+    if (gap) p.beatMs = -1;
+    if (L->pullMs.size() <= li) L->pullMs.resize(li + 1, -1.0);
+    if (gap && L->pullMs[li] >= 0) L->pullMs[li] = now;  // the pull's bound restarts as the beat's (a slow helper)
+    uint64_t mv = 0, beat = 0, n = 0;
+    if (gdakiCtrlRdmaLaBeatTake(g, (int)li, &mv, &beat, &n) && (mv >> 32) == GL_PAGE_MAGIC) {
+      gdakiCtrlLaOnBeat(&L->k, (int)li, beat, now);
+      gdakiCtrlLaOnPull(L, g, (int)li, now);  // 2a-2-C step 4: the registration slots of the same READ
+    }
+    if (p.connected && !p.qpErr) gdakiCtrlRdmaLaBeatAsk(g, (int)li, p.page.addr, p.page.rkey, now, p.page.len);
+    // 2a-2-C step 5: the window toward the launcher shut: READ its page's consumed word for this rank (no credit SEND)
+    if (p.connected && !p.qpErr && p.creditOff != 0)
+      gdakiCtrlRdmaLaCreditAsk(g, (int)li, p.page.addr + p.creditOff, p.page.rkey, now);
+  }
+  gdakiCtrlLaPublishPull(L, now);
+  // the pairings once the ring can make their QPs (bound to the page: the launcher's consumed words are there); never a
+  // PAIR without a QP
+  if (g != nullptr && g->bound && !g->la.empty()) gdakiCtrlLaPairTick(&L->k, now);
+  gdakiCtrlLaLatchStep(L);
+  for (int p = 0; p < L->k.nranks; p++) {  // a hold that fell back without the fence word: its window line (막는 문제 1)
+    struct gdakiCtrlLaFence& f = L->k.fence[(size_t)p];
+    if (!f.armed || f.windowSaid) continue;
+    const uint32_t st = gdakiHoldPeerState(r, p, nullptr);
+    if (st == GDAKI_HOLD_FALLBACK || st == GDAKI_HOLD_CANCELLED) gdakiCtrlLaOnHoldEnd(&L->k, p);
+    else if (!gdakiHoldIsHeldState(st)) f.windowSaid = true;  // restored without the word here: no point before the new
+                                                              // incarnation writes (no line)
+  }
+  gdakiCtrlLaFetchFwdStep(&L->k);  // FETCH_DONE through the launcher: to the FETCH waiter
+
+}
+// The L inputs' words after a launcher message (the helper, L->mu held).
+static void gdakiCtrlLaPublish(struct gdakiCtrlLauncher* L) {
+  for (int p = 0; p < L->k.nranks; p++) {
+    L->pubLeft[(size_t)p].store(L->k.leftPlus1[(size_t)p], std::memory_order_release);
+    L->pubFenced[(size_t)p].store(L->k.fencedPlus1[(size_t)p], std::memory_order_release);
+    L->pubReg[(size_t)p].store(gdakiCtrlLaRegWord(&L->k, p), std::memory_order_release);
+  }
+}
+static void gdakiCtrlLaLInputs(struct gdakiRecHost* r, int peer, uint32_t inc, bool* left, bool* ended, bool* regAlive,
+                               bool* regLeft) {
+  *left = *ended = *regAlive = *regLeft = false;
+  struct gdakiCtrlLauncher* L = gdakiCtrlLaOf(r);
+  if (L == nullptr || peer < 0 || peer >= L->k.nranks) return;
+  const struct gdakiCtrlLaLIn x = gdakiCtrlLaLInOf(L->pubLeft[(size_t)peer].load(std::memory_order_acquire),
+                                                   L->pubFenced[(size_t)peer].load(std::memory_order_acquire),
+                                                   L->pubReg[(size_t)peer].load(std::memory_order_acquire), inc);
+  *left = x.left;
+  *ended = x.ended;
+  *regAlive = x.regAlive;
+  *regLeft = x.regLeft;
+}
+// [2a-2 calls it] an envelope from a launcher.
+static void gdakiCtrlLauncherOnEnvelope(struct gdakiRecHost* r, const struct gdakiCtrlEnv* e, const void* body, bool ud) {
+  struct gdakiCtrlLauncher* L = gdakiCtrlLaOf(r);
+  if (L == nullptr || e == nullptr || body == nullptr || (e->from & GDAKI_CTRL_FROM_LAUNCHER) == 0) return;
+  std::lock_guard<std::mutex> lk(L->mu);
+  struct glMsg m;
+  memcpy(&m, body, sizeof(m));
+  const double now = gdakiQ4MonoMs();
+  if (ud) {
+    gdakiCtrlLaOnUd(&L->k, m, now);
+  } else {
+    const int li = gdakiCtrlLaIndexOfNode(&L->k, (uint32_t)e->from & ~(uint32_t)GDAKI_CTRL_FROM_LAUNCHER);
+    gdakiCtrlLaOnRc(&L->k, li, m, now);
+    if (li >= 0 && (m.h.kind == GL_K_EXITED || m.h.kind == GL_K_FENCED) && m.h.rank >= 0 && m.h.rank < L->k.nranks) {
+      const int p = m.h.rank;
+      gdakiLnFenced(r, p, m.h.incarnation);  // phase 1's page copy of the word (the report)
+      gdakiCtrlLaFenceReport(&L->k, p, gdakiHoldBuddyOf(p, L->k.nranks) == L->k.me);
+      // 2a-2-C step 4: the end of the incarnation the lineage took opens a timing window (an open FIN window stays; the
+      // reaction is gdakiCtrlEffEndedStep's, after the envelopes)
+      if (gdakiCtrlFencedIs(L->k.fencedPlus1[(size_t)p], m.h.incarnation))
+        gdakiCtrlWindowRequest(r, p, GDAKI_CTRL_WSRC_ENDED);
+    }
+    gdakiCtrlLaPublish(L);
+  }
+  gdakiCtrlLaLatchStep(L);
+}
+static void gdakiCtrlLauncherLeaving(struct gdakiRecHost* r) {
+  struct gdakiCtrlLauncher* L = gdakiCtrlLaOf(r);
+  if (L == nullptr) return;
+  std::lock_guard<std::mutex> lk(L->mu);
+  L->k.leaving = true;
+  if (L->registered && gdakiCtrlLaUnixLeaving(&L->k.unix))
+    GIN_TS_NOTE("GIN/RC: rank %d: LEAVING (incarnation %u) to the launcher of node %u mono_ms=%.3f", L->k.me, L->k.inc,
+                L->k.own >= 0 ? L->k.la[(size_t)L->k.own].node : 0u, gdakiQ4MonoMs());
+}
+static bool gdakiCtrlLaWardArmOk(struct gdakiRecHost* r, int ward) {
+  struct gdakiCtrlLauncher* L = gdakiCtrlLaOf(r);
+  if (L == nullptr) return false;
+  if (gdakiHoldBuddyOf(ward, L->k.nranks) != L->k.me) return true;  // only the ward's buddy talks to its launcher
+  std::lock_guard<std::mutex> lk(L->mu);
+  return gdakiCtrlLaWardPathOk(&L->k, ward);
+}
+static void gdakiCtrlLaStoreReqTail(struct gdakiRecHost* r, struct gdakiStoreReqSpare* sp) {
+  sp->magic = GDAKI_CTRL_LA_STORE_SPARE_MAGIC;
+  sp->haveSpare = 0;
+  sp->pid = 0;
+  sp->pidStart = 0;
+  struct gdakiCtrlLaSpareReg g;
+  memset(&g, 0, sizeof(g));
+  struct gdakiCtrlLauncher* L = gdakiCtrlLaOf(r);
+  if (L != nullptr) {
+    std::lock_guard<std::mutex> lk(L->mu);
+    gdakiCtrlLaLatchStep(L);
+    sp->haveSpare = gdakiCtrlLaTailFill(&L->k, &g) ? 1u : 0u;
+  }
+  memcpy(sp->spareAddr, &g, sizeof(g));
+}
+static bool gdakiCtrlLaStableArmable(struct gdakiRecHost* r, bool allArmable) {
+  struct gdakiCtrlLauncher* L = gdakiCtrlLaOf(r);
+  if (L == nullptr) return false;
+  bool resend = false, say = false, arm;
+  uint32_t inc;
+  {
+    std::lock_guard<std::mutex> lk(L->mu);
+    gdakiCtrlLaLatchStep(L);
+    arm = gdakiCtrlLaStableArm(&L->k, allArmable, &resend);
+    inc = L->k.inc;
+    say = resend && L->resendSaidInc != inc + 1u;
+    if (say) L->resendSaidInc = inc + 1u;
+  }
+  if (resend) {  // the buddy's registration lacks the path: the store's next request carries it (the helper's next step)
+    struct gdakiStoreState* st = gdakiStoreOf(r);
+    if (st != nullptr) {
+      std::lock_guard<std::mutex> lk(st->mu);
+      if (st->up.need == GDAKI_STORE_N_NONE) st->up.need = GDAKI_STORE_N_RETRY;
+    }
+    if (say)
+      GIN_TS_NOTE("GIN/RC: rank %d: a spare path of incarnation %u exists but the buddy's registration says none: this "
+                  "checkpoint is not armed, STORE_REQ goes again mono_ms=%.3f", L->k.me, inc, gdakiQ4MonoMs());
+  }
+  return arm;
+}
+static bool gdakiCtrlLaSpareRegCheck(struct gdakiRecHost* r, const void* reg32, int peer, uint32_t dead, char* why,
+                                     size_t whyLen) {
+  struct gdakiCtrlLaSpareReg g;
+  memcpy(&g, reg32, sizeof(g));
+  if (!gdakiCtrlLaSpareRegOk(g, peer, dead)) {
+    snprintf(why, whyLen, "the peer's registration is not a launcher path of incarnation %u (magic %08x, flags %u)", dead,
+             g.magic, g.flags);
+    return false;
+  }
+  struct gdakiCtrlLauncher* L = gdakiCtrlLaOf(r);
+  if (L == nullptr) {
+    snprintf(why, whyLen, "this rank has no launcher link");
+    return false;
+  }
+  std::lock_guard<std::mutex> lk(L->mu);
+  if (gdakiCtrlLaIndexOfNode(&L->k, g.node) < 0) {
+    snprintf(why, whyLen, "this rank does not know the launcher of node %u", g.node);  // REVIEW_P3 nit 4
+    return false;
+  }
+  gdakiCtrlLaSetRankNode(&L->k, peer, g.node);
+  return true;
+}
+// [3] the judgement's hook (every survivor's hold start, before gdakiTsQuiesce and gdakiCtrlPeerToErr move any QP toward
+// the peer): the window line's snapshot (REVIEW_P3 막는 문제 1). Reads its cells over the copy path (16 cells of 64 B per
+// region; the helper, a few ms).
+static void gdakiCtrlOnJudgement(struct gdakiRecHost* r, int peer, uint32_t inc) {
+  struct gdakiCtrlLauncher* L = gdakiCtrlLaOf(r);
+  if (L == nullptr || peer < 0 || peer >= L->k.nranks) return;
+  std::lock_guard<std::mutex> lk(L->mu);
+  gdakiCtrlLaOnJudgement(&L->k, peer, inc);
+}
+// [3] the hold start's hook (every survivor, after gdakiCtrlPeerToErr): the fence of (peer, inc) armed and at the buddy
+// SPAWN (decision 12; its REFUSED is a line only). A word that already says FENCED (EXITED before the hold start) gives
+// the buddy's FENCED line and the window line now.
+static void gdakiCtrlOnHoldStart(struct gdakiRecHost* r, int peer, uint32_t inc) {
+  struct gdakiCtrlLauncher* L = gdakiCtrlLaOf(r);
+  if (L == nullptr || peer < 0 || peer >= L->k.nranks) return;
+  std::lock_guard<std::mutex> lk(L->mu);
+  gdakiCtrlLaFenceArm(&L->k, peer, inc);
+  const bool buddy = gdakiHoldBuddyOf(peer, L->k.nranks) == L->k.me;
+  if (buddy) gdakiCtrlLaSpawn(&L->k, peer, inc + 1u);
+  gdakiCtrlLaFenceReport(&L->k, peer, buddy);
+}
+static int gdakiCtrlLauncherSend(struct gdakiRecHost* r, int node, const void* msg, size_t bytes) {
+  struct gdakiCtrlLauncher* L = gdakiCtrlLaOf(r);
+  if (L == nullptr || msg == nullptr || bytes != sizeof(struct glMsg) || node < 0) return -1;
+  std::lock_guard<std::mutex> lk(L->mu);
+  struct glMsg m;
+  memcpy(&m, msg, sizeof(m));
+  return gdakiCtrlLaSendTo(&L->k, gdakiCtrlLaIndexOfNode(&L->k, (uint32_t)node), &m);
+}
+// The buddy's fence step (gdakiCtrlActFenceOk, once every HOLDING is in).
+static int gdakiCtrlLaFenceStep(struct gdakiRecHost* r, int peer, uint32_t dead, uint64_t* word, char* why, size_t whyLen) {
+  struct gdakiCtrlLauncher* L = gdakiCtrlLaOf(r);
+  *word = GDAKI_CTRL_FENCE_NONE;
+  if (L == nullptr || peer < 0 || peer >= L->k.nranks) {
+    snprintf(why, whyLen, "this rank has no launcher link");
+    return GDAKI_CTRL_LA_GATE_FALLBACK;
+  }
+  std::lock_guard<std::mutex> lk(L->mu);
+  const int g = gdakiCtrlLaGate(&L->k, peer, dead, gdakiQ4MonoMs(), why, whyLen);
+  *word = L->k.fencedPlus1[(size_t)peer];
+  struct gdakiCtrlPage* pg = gdakiPageOf(r);  // phase 1's report of the fence (gdakiLnFenceOf's fenceSent)
+  if (pg != nullptr && peer < (int)pg->peers.size()) pg->peers[(size_t)peer].fenceSent = L->k.fence[(size_t)peer].sent;
+  return g;
+}
+// r->ctrl->launcher (gdakiCtrlFree, after the helper and the watch thread stopped).
+static void gdakiCtrlLauncherFree(struct gdakiRecHost* r) {
+  struct gdakiCtrlLauncher* L = gdakiCtrlLaOf(r);
+  if (L == nullptr) return;
