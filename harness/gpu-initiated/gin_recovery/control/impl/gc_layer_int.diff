+// ---- the liveness READ's completion classes (REVIEW_P12 막는 문제 5; design v3 4.2 R (10), (11), 4.3 floor rule) ----
+// The status codes are enum ibv_wc_status's (the live code below asserts each equals its IBV_WC_*). Only a retry-exceeded
+// completion (the data QP's 3.5-3.8 s) is "the hardware does not answer"; a remote access error is REMACC; a flush, a
+// local error or a remote operation error says this rank's probe QP is broken (re-pair it) and never feeds rows 10-12.
+enum : int {
+  GDAKI_CTRL_WC_SUCCESS = 0, GDAKI_CTRL_WC_LOC_LEN_ERR = 1, GDAKI_CTRL_WC_LOC_QP_OP_ERR = 2, GDAKI_CTRL_WC_LOC_PROT_ERR = 4,
+  GDAKI_CTRL_WC_WR_FLUSH_ERR = 5, GDAKI_CTRL_WC_REM_ACCESS_ERR = 10, GDAKI_CTRL_WC_REM_OP_ERR = 11,
+  GDAKI_CTRL_WC_RETRY_EXC_ERR = 12, GDAKI_CTRL_WC_RNR_RETRY_EXC_ERR = 13,
+};
+enum : uint32_t { GDAKI_CTRL_CQ_OK = 0, GDAKI_CTRL_CQ_REMACC = 1, GDAKI_CTRL_CQ_NORESP = 2, GDAKI_CTRL_CQ_BROKEN = 3 };
+static inline uint32_t gdakiCtrlProbeCqeClass(int status) {
+  if (status == GDAKI_CTRL_WC_SUCCESS) return GDAKI_CTRL_CQ_OK;
+  if (status == GDAKI_CTRL_WC_RETRY_EXC_ERR || status == GDAKI_CTRL_WC_RNR_RETRY_EXC_ERR) return GDAKI_CTRL_CQ_NORESP;
+  if (status == GDAKI_CTRL_WC_REM_ACCESS_ERR) return GDAKI_CTRL_CQ_REMACC;
+  return GDAKI_CTRL_CQ_BROKEN;
+}
+static inline const char* gdakiCtrlCqClassName(uint32_t c) {
+  switch (c) {
+    case GDAKI_CTRL_CQ_OK: return "ok";
+    case GDAKI_CTRL_CQ_REMACC: return "remote access error";
+    case GDAKI_CTRL_CQ_NORESP: return "retry exceeded (no response)";
+    default: return "probe QP broken (flush or local error)";
+  }
+}
+
+// ---- the liveness READ's wr_id: (kind 4 bits, peer 12, the QP generation's low 16, sequence 32) ----
+// The periodic READ carries its sequence, a window READ the window's number: a completion is matched to what it answers
+// (REVIEW_P12 막는 문제 4), and one of an older QP generation is recognized by its wr_id alone.
+enum : uint32_t { GDAKI_CTRL_PW_PERIODIC = 1, GDAKI_CTRL_PW_WIN1 = 2, GDAKI_CTRL_PW_WIN2 = 3 };
+static inline uint64_t gdakiCtrlProbeWrId(uint32_t kind, uint32_t peer, uint32_t gen, uint32_t seq) {
+  return ((uint64_t)(kind & 0xfu) << 60) | ((uint64_t)(peer & 0xfffu) << 48) | ((uint64_t)(gen & 0xffffu) << 32) | seq;
+}
+static inline uint32_t gdakiCtrlProbeWrKind(uint64_t id) { return (uint32_t)(id >> 60); }
+static inline uint32_t gdakiCtrlProbeWrPeer(uint64_t id) { return (uint32_t)(id >> 48) & 0xfffu; }
+static inline bool gdakiCtrlProbeWrGenIs(uint64_t id, uint32_t gen) { return ((uint32_t)(id >> 32) & 0xffffu) == (gen & 0xffffu); }
+static inline uint32_t gdakiCtrlProbeWrSeq(uint64_t id) { return (uint32_t)id; }
+
+// ---- the liveness READ QP's send queue (design v3 3.4: one periodic READ at a time; REVIEW_P12 막는 문제 4) ----
+// A periodic READ is never posted while one is outstanding: its timeout (PROBE_TIMEOUT_MS) is a report (R (12) once) and
+// the READ stays in flight until its completion, a success or an error (a dead peer's retry exceeded about 3.66 s later
+// is R (11)). The window's two READs take slots of their own; nothing is posted beyond the SQ depth
+// (GDAKI_CTRL_PROBE_SQ): gdakiCtrlProbeCanPost says so and maxOutstanding records the high mark (the model asserts it).
+struct gdakiCtrlProbeIo {
+  uint32_t outstanding = 0;     // READs posted whose completion is not seen yet (every kind)
+  uint32_t maxOutstanding = 0;  // the high mark (never above GDAKI_CTRL_PROBE_SQ)
+  bool periodicOut = false;     // the one periodic READ in flight
+  uint32_t periodicSeq = 0;
+  double periodicPostMs = 0;
+  bool timeoutSeen = false;     // its PROBE_TIMEOUT_MS passed (reported once; it stays in flight)
+  uint32_t nextSeq = 1;
+  uint64_t overruns = 0;        // posts refused for want of a slot
+};
+static inline bool gdakiCtrlProbeCanPost(const struct gdakiCtrlProbeIo* io, uint32_t need) {
+  return io->outstanding + need <= GDAKI_CTRL_PROBE_SQ;
+}
+// The periodic READ may go now: none in flight, its period passed, and a slot free beyond the `reserve` slots the open
+// window still needs. Returns the sequence it takes (0: not now).
+static inline uint32_t gdakiCtrlProbePeriodicDue(struct gdakiCtrlProbeIo* io, double nowMs, double dueMs, uint32_t reserve) {
+  if (io->periodicOut || nowMs < dueMs) return 0;
+  if (!gdakiCtrlProbeCanPost(io, 1u + reserve)) {
+    io->overruns++;
+    return 0;
+  }
+  return io->nextSeq == 0 ? (io->nextSeq = 1) : io->nextSeq;
+}
+static inline void gdakiCtrlProbeOnPosted(struct gdakiCtrlProbeIo* io, uint32_t kind, uint32_t seq, double nowMs) {
+  io->outstanding++;
+  if (io->outstanding > io->maxOutstanding) io->maxOutstanding = io->outstanding;
+  if (kind == GDAKI_CTRL_PW_PERIODIC) {
+    io->periodicOut = true;
+    io->periodicSeq = seq;
+    io->periodicPostMs = nowMs;
+    io->timeoutSeen = false;
+    io->nextSeq = seq + 1u;
+  }
+}
+// A completion of this QP (any status): its slot is free. True when it answers the periodic READ in flight (its result
+// is R's); a window READ's or an older READ's completion is not.
+static inline bool gdakiCtrlProbeOnCqe(struct gdakiCtrlProbeIo* io, uint32_t kind, uint32_t seq) {
+  if (io->outstanding > 0) io->outstanding--;
+  if (kind == GDAKI_CTRL_PW_PERIODIC && io->periodicOut && seq == io->periodicSeq) {
+    io->periodicOut = false;
+    return true;
+  }
+  return false;
+}
+// The periodic READ in flight past PROBE_TIMEOUT_MS: true once (R (12): suspicion and a line; it stays in flight).
+static inline bool gdakiCtrlProbeTimedOut(struct gdakiCtrlProbeIo* io, double nowMs, double timeoutMs) {
+  if (!io->periodicOut || io->timeoutSeen || nowMs - io->periodicPostMs <= timeoutMs) return false;
+  io->timeoutSeen = true;
+  return true;
+}
+// The QP was reset or replaced after its flushes were collected (a re-pairing): nothing it posted is in flight now.
+static inline void gdakiCtrlProbeIoReset(struct gdakiCtrlProbeIo* io) {
+  io->outstanding = 0;
+  io->periodicOut = false;
+  io->timeoutSeen = false;
+}
+
+// ---- the confirmation window's clock (design v3 4.2; REVIEW_P12 막는 문제 1) ----
+// Opened by the helper's witness FIN or RST with no BYE (or, for timing only, by an end report): READ1 of line 0 at t_F,
+// READ2 at t_F + W/2, the verdict at t_F + W (gdakiCtrlConfirmVerdict), whatever the completion times; a completion after
+// the verdict is dropped by the window's number. A window opened while the QP had no success in its generation, or
+// without two free slots, cannot confirm: its verdict comes at once. A new FIN of the same peer while one is open is
+// ignored.
+enum : uint32_t { GDAKI_CTRL_WS_IDLE = 0, GDAKI_CTRL_WS_OPEN = 1 };
+enum : uint32_t { GDAKI_CTRL_WSRC_NONE = 0, GDAKI_CTRL_WSRC_FIN = 1, GDAKI_CTRL_WSRC_RST = 2, GDAKI_CTRL_WSRC_ENDED = 3 };
+static inline const char* gdakiCtrlWsrcName(uint32_t s) {
+  return s == GDAKI_CTRL_WSRC_FIN ? "FIN" : s == GDAKI_CTRL_WSRC_RST ? "RST" : s == GDAKI_CTRL_WSRC_ENDED ? "END" : "?";
+}
+struct gdakiCtrlWindow {
+  uint32_t state = GDAKI_CTRL_WS_IDLE;
+  uint32_t no = 0;              // the window's number (in its READs' wr_id)
+  uint32_t src = GDAKI_CTRL_WSRC_NONE;
+  double tF = 0, endMs = 0;
+  bool countable = false;       // the QP RTS with one success in its generation at t_F, the READs posted on it
+  bool r1Posted = false, r2Posted = false, r1Done = false, r2Done = false, remacc = false;
+  uint64_t beat1 = 0, beat2 = 0, inc1 = 0, inc2 = 0;
+  double r1Ms = -1, r2Ms = -1;  // the completion times (reports)
+  uint32_t verdict = GDAKI_CTRL_CW_UNCONFIRMED;  // the last window's
+  uint64_t opened = 0, ignored = 0, late = 0;
+};
+static inline bool gdakiCtrlWindowOpen(struct gdakiCtrlWindow* w, uint32_t src, double tF, bool countable) {
+  if (w->state == GDAKI_CTRL_WS_OPEN) {
+    w->ignored++;
+    return false;
+  }
+  const uint32_t no = w->no + 1u;
+  const uint64_t opened = w->opened + 1u, ignored = w->ignored, late = w->late;
+  *w = gdakiCtrlWindow();
+  w->no = no;
+  w->opened = opened;
+  w->ignored = ignored;
+  w->late = late;
+  w->state = GDAKI_CTRL_WS_OPEN;
+  w->src = src;
+  w->tF = tF;
+  w->countable = countable;
+  return true;
+}
+enum : uint32_t { GDAKI_CTRL_WA_NONE = 0, GDAKI_CTRL_WA_POST1 = 1, GDAKI_CTRL_WA_POST2 = 2, GDAKI_CTRL_WA_JUDGE = 3 };
+// One action per call, in order: READ1 at once, READ2 from t_F + W/2, the verdict from t_F + W (at once when it cannot
+// confirm).
+static inline uint32_t gdakiCtrlWindowStep(const struct gdakiCtrlWindow* w, double nowMs, double wMs) {
+  if (w->state != GDAKI_CTRL_WS_OPEN) return GDAKI_CTRL_WA_NONE;
+  if (!w->countable) return GDAKI_CTRL_WA_JUDGE;
+  if (!w->r1Posted) return GDAKI_CTRL_WA_POST1;
+  if (!w->r2Posted && nowMs >= w->tF + wMs / 2.0) return GDAKI_CTRL_WA_POST2;
+  if (nowMs >= w->tF + wMs) return GDAKI_CTRL_WA_JUDGE;
+  return GDAKI_CTRL_WA_NONE;
+}
+static inline void gdakiCtrlWindowPosted(struct gdakiCtrlWindow* w, uint32_t which, bool ok) {
+  if (which == 1) w->r1Posted = true;
+  else w->r2Posted = true;
+  if (!ok) w->countable = false;  // a READ that could not be posted on the RTS QP: the window cannot confirm
+}
+// A completion of window `no`'s READ `which` (1, 2) of class `cls`; false: not the open window's (dropped).
+static inline bool gdakiCtrlWindowOnCqe(struct gdakiCtrlWindow* w, uint32_t no, uint32_t which, uint32_t cls,
+                                        uint64_t beat, uint64_t inc, double nowMs) {
+  if (w->state != GDAKI_CTRL_WS_OPEN || no != w->no) {
+    w->late++;
+    return false;
+  }
+  if (cls == GDAKI_CTRL_CQ_OK) {
+    if (which == 1) {
+      w->r1Done = true;
+      w->beat1 = beat;
+      w->inc1 = inc;
+      w->r1Ms = nowMs;
+    } else {
+      w->r2Done = true;
+      w->beat2 = beat;
+      w->inc2 = inc;
+      w->r2Ms = nowMs;
+    }
+  } else if (cls == GDAKI_CTRL_CQ_REMACC) {
+    w->remacc = true;
+  } else if (cls == GDAKI_CTRL_CQ_BROKEN) {
+    w->countable = false;  // this rank's QP broke: the window cannot confirm (never NORESP)
+  }  // NORESP: the READ stays not done (NORESP at t_F + W)
+  return true;
+}
+static inline uint32_t gdakiCtrlWindowJudge(struct gdakiCtrlWindow* w, uint64_t incExpected, double nowMs) {
+  w->verdict = gdakiCtrlConfirmVerdict(w->countable, w->remacc, w->r1Done, w->r2Done, incExpected, w->inc1, w->inc2,
+                                       w->beat1, w->beat2);
+  w->state = GDAKI_CTRL_WS_IDLE;
+  w->endMs = nowMs;
+  return w->verdict;
+}
+
+// ---- the helper's busy word as this reader sees it (design v3 3.1: the bound on the reader's own clock) ----
+struct gdakiCtrlBusySeen {
+  uint32_t no = 0;        // the busy number last seen (0: not busy)
+  double firstMs = 0;     // when this reader first saw it
+  uint32_t boundMs = 0;
+};
+enum : uint32_t { GDAKI_CTRL_BZ_NONE = 0, GDAKI_CTRL_BZ_IN = 1, GDAKI_CTRL_BZ_OVER = 2 };
+// *overMs: with BZ_OVER, how long ago the bound ended (the helper stall counts from there, design 4.2 row 18).
+static inline uint32_t gdakiCtrlBusySeenAt(const struct gdakiCtrlBusySeen* s, double nowMs, double* overMs) {
+  *overMs = 0;
+  if (s->no == 0) return GDAKI_CTRL_BZ_NONE;
+  const double end = s->firstMs + (double)s->boundMs;
+  if (nowMs <= end) return GDAKI_CTRL_BZ_IN;
+  *overMs = nowMs - end;
+  return GDAKI_CTRL_BZ_OVER;
+}
+// A READ's busy word at `nowMs`: a new number starts the bound on this reader's clock.
+static inline uint32_t gdakiCtrlBusySeenStep(struct gdakiCtrlBusySeen* s, uint64_t word, double nowMs, double* overMs) {
+  const uint32_t no = gdakiCtrlBusyNoOf(word);
+  if (no == 0) s->no = 0;
+  else if (no != s->no) {
+    s->no = no;
+    s->firstMs = nowMs;
+    s->boundMs = gdakiCtrlBusyBoundOf(word);
+  }
+  return gdakiCtrlBusySeenAt(s, nowMs, overMs);
+}
+
+// ---- R, L and W (design v3 4.2; REVIEW_P12 고칠 것 1, 2) ----
+// R from what this reader knows of peer p. The order (written into notes_fix12.md for the design): PROBE_MS = 0 is (13);
+// the last periodic READ's error class next: REMACC (10), retry exceeded (11), a broken probe QP (13, never 10-12); a
+// periodic READ in flight past its timeout (12); no success in this QP generation, or a page of another process (13);
+// then the watch beat: not risen is (2)-(5); risen: the helper side, busy within its bound (6), stale (7)-(9), a helper
+// beat below SUSPECT_MS (1). The helper stall counts from the busy bound's end when a busy number was seen.
+struct gdakiCtrlRFacts {
+  bool probeOff = false;
+  uint32_t lastCls = GDAKI_CTRL_CQ_OK;  // the last completed periodic READ's class
+  bool timedOut = false;                // the periodic READ in flight past PROBE_TIMEOUT_MS
+  bool okInGen = false;                 // the QP RTS with one success in its generation
+  bool pageOk = true;                   // the last successful READ's incNonce is the expected one
+  bool watchRose = false;
+  double watchStaleMs = 0;
+  uint32_t busy = GDAKI_CTRL_BZ_NONE;
+  double busyOverMs = 0;
+  double helperStaleMs = 0;
+  bool guardOk = true, vetoClear = true;
+  double suspectMs = GDAKI_CTRL_SUSPECT_MS_DEFAULT, stallMs = GDAKI_CTRL_STALL_MS_DEFAULT;
+};
+static inline uint32_t gdakiCtrlRDerive(const struct gdakiCtrlRFacts& f) {
+  if (f.probeOff) return GDAKI_CTRL_R_UNCONFIRMED;
+  if (f.lastCls == GDAKI_CTRL_CQ_REMACC) return GDAKI_CTRL_R_REMACC;
+  if (f.lastCls == GDAKI_CTRL_CQ_NORESP) return GDAKI_CTRL_R_HW_NORESP;
+  if (f.lastCls == GDAKI_CTRL_CQ_BROKEN) return GDAKI_CTRL_R_UNCONFIRMED;
+  if (f.timedOut) return GDAKI_CTRL_R_TIMEOUT_ONLY;
+  if (!f.okInGen || !f.pageOk) return GDAKI_CTRL_R_UNCONFIRMED;
+  if (!f.watchRose)
+    return gdakiCtrlRofStale(false, f.watchStaleMs, f.suspectMs, f.stallMs, f.guardOk, f.vetoClear, false);
+  if (f.busy == GDAKI_CTRL_BZ_IN) return GDAKI_CTRL_R_HELPER_BUSY;
+  double hs = f.helperStaleMs;
+  if (f.busy == GDAKI_CTRL_BZ_OVER && f.busyOverMs < hs) hs = f.busyOverMs;
+  return gdakiCtrlRofStale(false, hs, f.suspectMs, f.stallMs, f.guardOk, f.vetoClear, true);
+}
+// L (design v3 4.2): the launcher's words and messages. Phase 1 has no launcher: "no pairing with the launcher" is
+// 무응답 by definition, so every R (11) is row 10 here; until phase 3 derives L, rows 10-12 carry no reaction (report
+// only; REVIEW_P12 고칠 것 2).
+static inline uint32_t gdakiCtrlLOf(bool launcherPaired, bool leftSeen, bool endedSeen, bool pullOk, bool regAlive,
+                                    bool regLeft) {
+  if (leftSeen || (pullOk && regLeft)) return GDAKI_CTRL_L_LEFT;
+  if (endedSeen) return GDAKI_CTRL_L_ENDED;
+  if (!launcherPaired || !pullOk) return GDAKI_CTRL_L_NORESP;
+  return regAlive ? GDAKI_CTRL_L_ALIVE : GDAKI_CTRL_L_NOINFO;
+}
+// W: an open window; the verdict of the window that ends now; the witness off; a spent FIN or RST (the witness is
+// unknown until a new pairing); else normal.
+static inline uint32_t gdakiCtrlWOf(bool witnessOn, bool windowOpen, bool windowEnds, uint32_t endVerdict,
+                                    bool witnessUnknown) {
+  if (windowOpen) return GDAKI_CTRL_W_OPEN;
+  if (windowEnds) return gdakiCtrlWofConfirm(endVerdict);
+  if (!witnessOn) return GDAKI_CTRL_W_OFF;
+  return witnessUnknown ? GDAKI_CTRL_W_UNKNOWN : GDAKI_CTRL_W_OK;
+}
+
+// ---- the fence word's step (design v3 4.4 4): FENCED or EXITED of (peer, inc) ----
+// CURRENT and HELD_OLD raise the word to max(word, inc + 1); FUTURE and STALE leave it; it never goes down.
+static inline uint64_t gdakiLnFencedStep(uint64_t word, uint32_t cls, uint32_t inc) {
+  if (cls != GDAKI_LN_CURRENT && cls != GDAKI_LN_HELD_OLD) return word;
+  const uint64_t w = gdakiCtrlFenceWord(inc);
+  return w > word ? w : word;
+}
+
+// ---- the verdict mailbox (watch -> helper; REVIEW_P12 막는 문제 6) ----
+// One 64-bit word per (peer, kind): the watch thread stores a verdict once (its latch), the helper takes it with an
+// exchange to 0 and acts once. 0: empty.
+static inline uint64_t gdakiCtrlMailPack(uint32_t row, uint32_t verdict, uint32_t cause, uint32_t inc) {
+  return (1ull << 63) | ((uint64_t)(row & 0x1fu) << 48) | ((uint64_t)(verdict & 0xffu) << 40) |
+         ((uint64_t)(cause & 0xffu) << 32) | inc;
+}
+static inline uint32_t gdakiCtrlMailRow(uint64_t m) { return (uint32_t)(m >> 48) & 0x1fu; }
+static inline uint32_t gdakiCtrlMailVerdict(uint64_t m) { return (uint32_t)(m >> 40) & 0xffu; }
+static inline uint32_t gdakiCtrlMailCause(uint64_t m) { return (uint32_t)(m >> 32) & 0xffu; }
+static inline uint32_t gdakiCtrlMailInc(uint64_t m) { return (uint32_t)m; }
+
+// ---- the test switch FREEZE_PAGE (EXPERIMENT.md 9.9 "박동 쓰기만 멈춤") ----
+// "<ms>": the watch thread writes neither beat for <ms>; "<ms>:helper": helperBeat only (watchBeat still rises). The
+// freeze starts when the communicator is first armed (ncclGinRestoreResume) plus an optional "@<after ms>". False: not a
+// valid value (the switch stays off).
+struct gdakiCtrlFreezeSpec {
+  bool on = false, helperOnly = false;
+  double lenMs = 0, afterMs = 0;
+};
+static inline bool gdakiCtrlFreezeParse(const char* s, struct gdakiCtrlFreezeSpec* out) {
+  struct gdakiCtrlFreezeSpec f;
+  if (s == nullptr || *s == 0) return false;
+  char* e = nullptr;
+  const double len = strtod(s, &e);
+  if (e == s || len <= 0) return false;
+  f.lenMs = len;
+  if (strncmp(e, ":helper", 7) == 0) {
+    f.helperOnly = true;
+    e += 7;
+  }
+  if (*e == '@') {
+    const char* a = e + 1;
+    f.afterMs = strtod(a, &e);
+    if (e == a || f.afterMs < 0) return false;
+  }
+  if (*e != 0) return false;
+  f.on = true;
+  *out = f;
+  return true;
+}
+// ---- gin-control (page): pure functions (end) ----
+
+// ---- the status page, the probe, the confirmation window (host state) ----
+static_assert(GDAKI_CTRL_WC_SUCCESS == (int)IBV_WC_SUCCESS && GDAKI_CTRL_WC_LOC_LEN_ERR == (int)IBV_WC_LOC_LEN_ERR &&
+                  GDAKI_CTRL_WC_LOC_QP_OP_ERR == (int)IBV_WC_LOC_QP_OP_ERR &&
+                  GDAKI_CTRL_WC_LOC_PROT_ERR == (int)IBV_WC_LOC_PROT_ERR &&
+                  GDAKI_CTRL_WC_WR_FLUSH_ERR == (int)IBV_WC_WR_FLUSH_ERR &&
+                  GDAKI_CTRL_WC_REM_ACCESS_ERR == (int)IBV_WC_REM_ACCESS_ERR &&
+                  GDAKI_CTRL_WC_REM_OP_ERR == (int)IBV_WC_REM_OP_ERR &&
+                  GDAKI_CTRL_WC_RETRY_EXC_ERR == (int)IBV_WC_RETRY_EXC_ERR &&
+                  GDAKI_CTRL_WC_RNR_RETRY_EXC_ERR == (int)IBV_WC_RNR_RETRY_EXC_ERR,
+              "the liveness READ's completion classes use enum ibv_wc_status's values");
+// The scaffold's pairing of the liveness READ QPs over record 55 (phase 2a-1's model; region "gin-control (ring)":
+// below, because the model is there): the helper's state, its step and record 55's receiver.
+struct gdakiCtrlProbePairing;
+static void gdakiCtrlProbePairingStep(struct gdakiRecHost* r);
+static void gdakiCtrlProbeSetupRecv(struct gdakiRecHost* r, int from, const struct gdakiTsMsg& m);
+static void gdakiCtrlProbePairingFree(struct gdakiCtrlProbePairing* p);
+
+// The operations the helper asks of the watch thread on one peer's liveness READ QP (REVIEW_P12 고칠 것 12): the watch
+// thread owns the QP and its CQ; the helper's pairing only asks and reads the result.
+enum : uint32_t {
+  GDAKI_CTRL_PO_NONE = 0,
+  GDAKI_CTRL_PO_PREPARE = 1,  // to INIT for generation `gen` with a fresh PSN (the PAIR's side): ERR, flushes, RESET
+  GDAKI_CTRL_PO_CONNECT = 2,  // RTR, RTS toward `remote` for `gen` (a QP connected before, or prepared for another
+                              // generation, is reset first with a fresh PSN); the peer's page and incNonce with it
+  GDAKI_CTRL_PO_TOERR = 3,    // ERR (the hold start's fence step 1)
+};
+struct gdakiCtrlProbeReq {
+  uint32_t seq = 0;  // the helper's request number (the watch thread answers each once)
+  uint32_t op = GDAKI_CTRL_PO_NONE;
+  uint32_t gen = 0;
+  bool haveAvoid = false;
+  uint32_t avoidPsn = 0;            // the last pairing's PSN: a fresh draw differs from it (REVIEW_P12 nit 9)
+  struct gdakiCtrlEndpoint remote;  // CONNECT
+  struct gdakiCtrlRegion page;      // CONNECT: the peer's status page
+  uint64_t incNonce = 0;            // CONNECT: the peer's incNonce under the lineage's current incarnation
+};
+struct gdakiCtrlProbeRes {
+  uint32_t seq = 0;  // the request it answers
+  bool ok = false;
+  uint32_t gen = 0;
+  struct gdakiCtrlEndpoint local;  // the QP's endpoint now (a fresh PSN after a PREPARE or a reset)
+  char why[192] = {0};
+};
+// Per peer. Watch-thread state unless the comment says otherwise.
+struct gdakiCtrlPeerProbe {
+  struct gdakiProbeQp qp;
+  bool hasQp = false;                   // a liveness READ QP was made at the setup (fixed before the page is published:
+                                        // the helper reads this, never qp, which the watch thread may make again)
+  struct gdakiCtrlProbeIo io;
+  struct gdakiCtrlWindow win;
+  struct gdakiCtrlRegion remotePage;    // the peer's status page (addr, rkey, len)
+  bool haveRemote = false;
+  uint64_t incExp = 0;                  // the peer's expected incNonce (from the pairing)
+  uint32_t preparedGen = 0;             // the QP is at INIT for this generation (a PREPARE; 0: not)
+  // the handoff (under the page mutex): helper -> watch
+  struct gdakiCtrlProbeReq req;
+  bool toErrReq = false;                // gdakiProbeToErr (the hold start)
+  uint32_t winReqSeq = 0, winReqSrc = 0;
+  double winReqMs = 0;                  // t_F: the helper's clock when it saw the FIN or RST
+  // watch -> helper (under the page mutex)
+  struct gdakiCtrlProbeRes res;
+  uint32_t reqDone = 0, winSeen = 0;    // watch: the last request and window request taken
+  // watch -> helper, atomic: the verdict mailboxes and the "this QP broke in generation g" word (g + 1; 0 none)
+  std::atomic<uint64_t> stallMail{0}, winMail{0};
+  std::atomic<uint32_t> errGenPlus1{0};
+  std::atomic<uint32_t> okGen{0};       // the QP generation that had a successful READ (the link's PROBE_FAIL_N count)
+  // helper -> watch, atomic: the data path's veto (the last time the peer's responder count moved on this rank's QPs)
+  std::atomic<int64_t> rmsnMoveUs{0};
+  // the stall trackers and the judgement inputs
+  struct gdakiCtrlStale watchStale, helperStale;
+  struct gdakiCtrlBusySeen busy;
+  bool watchRose = false, pageOk = true, byeSeen = false, witnessUnknown = false;
+  uint32_t lastCls = GDAKI_CTRL_CQ_OK;
+  double lastOkMs = -1e18, nextReadMs = 0, postMs = 0;
+  std::vector<double> theirStale;       // the peer's page staleMs[] (its view of every rank), from the last success
+  struct gdakiCtrlJudgement last = gdakiCtrlJudgementOfRow(13);  // row 13 until a READ says more (REVIEW_P12 nit 4)
+  uint32_t latchedInc = 0;              // the incarnation (+ 1) a stall verdict was posted for (0: none)
+  bool suspectLogged = false;
+  // reports (the probe summary)
+  uint64_t reads = 0, ok = 0, remacc = 0, noresp = 0, broken = 0, timeouts = 0, torn = 0, otherInc = 0;
+  std::vector<float> latUs;
+  bool fenceSent = false;               // phase 3 sets it when this rank sent FENCE for the peer's dead incarnation
+};
+struct gdakiCtrlPage {
+  void* page = nullptr;              // the 4 KiB status page (REMOTE_READ), host memory
+  struct ibv_mr* pageMr = nullptr;
+  struct gdakiCtrlPageHead* head = nullptr;
+  uint8_t* rd = nullptr;             // the READ buffers: one slot per peer and per launcher (LOCAL_WRITE, one MR)
+  size_t rdSlot = 0, rdBytes = 0;    // a slot: the page's used part rounded to 64 B, then the window's two line-0 READs
+  struct ibv_mr* rdMr = nullptr;
+  struct gdakiCtrlPageLayout layout;
+  std::vector<struct gdakiCtrlPeerProbe> peers;  // by rank
+  std::vector<uint64_t> fencedPlus1;             // the fence word, by logical rank (helper; 0 = none, i + 1 = i fenced)
+  std::mutex mu;                                 // the handoff (requests, results, window requests)
+  uint64_t beat = 0;
+  double lastBeatMs = 0, gapMaxMs = 0;           // the watch beat's largest gap (W's basis, 결정 5), the frozen time out
+  uint32_t nLaunchers = 0;                       // the communicator's node launchers (launcher_msg.h): the page layout's
+                                                 // nL, the same as the ring's (gdakiCtrlRdmaCreate); phase 3 sets it
+  struct gdakiCtrlBusyTrack busy;                // helperBusy's serial (impl/rs_ctrl_api.h, the watch thread's)
+  int probeMs = GDAKI_CTRL_PROBE_MS_DEFAULT, suspectMs = GDAKI_CTRL_SUSPECT_MS_DEFAULT;
+  int stallMs = GDAKI_CTRL_STALL_MS_DEFAULT, wMs = GDAKI_CTRL_CONFIRM_MS_DEFAULT;
+  int probeTimeoutMs = GDAKI_CTRL_PROBE_TIMEOUT_MS_DEFAULT, probeFailN = GDAKI_CTRL_PROBE_FAIL_N_DEFAULT;
+  int vetoMs = GDAKI_CTRL_STALL_RMSN_MS_DEFAULT;
+  bool witnessOn = true;
+  std::atomic<bool> up{false};                   // the page MR and the READ MR are registered (set last)
+  std::atomic<bool> launcherPaired{false};       // a latch: phase 3 sets it once per context, it never goes down
+  struct gdakiCtrlFreezeSpec freeze;             // the test switch (research builds)
+  double freezeFromMs = -1, freezeToMs = -1;
+  bool freezeLogged = false;
+  struct gdakiCtrlProbePairing* pairing = nullptr;  // helper: the scaffold's pairing state (region "gin-control (ring)")
+  int me = -1;
+};
+
+// The page, once published complete (REVIEW_P12 고칠 것 3: a release store of the finished page, an acquire load here).
+static struct gdakiCtrlPage* gdakiPageOf(struct gdakiRecHost* r) {
+  if (r == nullptr || r->ctrl == nullptr) return nullptr;
+  return __atomic_load_n(&r->ctrl->page, __ATOMIC_ACQUIRE);
+}
+static bool gdakiPageUp(const struct gdakiCtrlPage* pg) { return pg != nullptr && pg->up.load(std::memory_order_acquire); }
+static uint8_t* gdakiPageRd(struct gdakiCtrlPage* pg, int peer) { return pg->rd + (size_t)peer * pg->rdSlot; }
+static size_t gdakiPageWinOff(const struct gdakiCtrlPage* pg, uint32_t which) {
+  return pg->rdSlot - 2 * sizeof(struct gdakiCtrlPageHead) + (which - 1u) * sizeof(struct gdakiCtrlPageHead);
+}
+// "Is this pair's record channel up" is the preparation stage's seam gdakiCtrlChanUp(r, peer) (two-argument form).
+
+static void gdakiCtrlPageDelete(struct gdakiCtrlPage* pg) {  // a page never published, or at the context's teardown
+  if (pg == nullptr) return;
+  for (auto& pp : pg->peers) gdakiProbeQpDestroy(&pp.qp);
+  if (pg->pageMr != nullptr) (void)wrap_ibv_dereg_mr(pg->pageMr);
+  if (pg->rdMr != nullptr) (void)wrap_ibv_dereg_mr(pg->rdMr);
+  free(pg->page);
+  free(pg->rd);
+  gdakiCtrlProbePairingFree(pg->pairing);
+  delete pg;
+}
+// Bring the page up once (NCCL_GIN_CTRL_PAGE=1), on the setup thread (gdakiTsStart): the thresholds' range check
+// (gdakiCtrlThresholdsOk: out of range, the page stays off with a WARN, the scaffold's fail-fast), the 4 KiB status page
+// (REMOTE_READ), one READ slot per peer and per launcher (LOCAL_WRITE, one MR), one liveness-READ QP per gated peer. The
+// page is published only when it is complete (a release store; the watch thread loads it with acquire).
+static void gdakiPageSetup(struct gdakiRecHost* r) {
+  struct gdakiCtrlState* st = r != nullptr ? r->ctrl : nullptr;  // made by gdakiTsSetup before its all-gather (prep)
+  if (st == nullptr || gdakiPageOf(r) != nullptr || r->ts == nullptr) return;
+  if (ncclParamGinCtrlPage() == 0) return;  // the scaffold is off by default
+  struct gdaki_context* g = r->ctx;
+  struct gdakiCtrlThresholds t;
+  t.probeMs = ncclParamGinTsProbeMs();
+  t.probeTimeoutMs = ncclParamGinCtrlProbeTimeoutMs();
+  t.confirmMs = ncclParamGinCtrlConfirmMs();
+  t.suspectMs = ncclParamGinTsSuspectMs();
+  t.stallMs = ncclParamGinTsStallMs();
+  t.restoreMs = ncclParamGinRestoreMs();
+  char why[160];
+  if (!gdakiCtrlThresholdsOk(t, why, sizeof(why))) {
+    WARN("GIN/RC: rank %d: the liveness thresholds are out of range (%s): the status page stays off mono_ms=%.3f",
+         g->rank, why, gdakiQ4MonoMs());
+    return;
+  }
+  struct ibv_pd* pd = (g != nullptr && g->collComm != nullptr) ? g->collComm->ib.pd : nullptr;
+  if (pd == nullptr) return;
+  struct gdakiCtrlPage* pg = new gdakiCtrlPage();
+  pg->me = g->rank;
+  pg->probeMs = (int)t.probeMs;
+  pg->suspectMs = (int)t.suspectMs;
+  pg->stallMs = (int)t.stallMs;
+  pg->probeTimeoutMs = (int)t.probeTimeoutMs;
+  pg->wMs = (int)t.confirmMs;  // no silent clamp: the range check refused a W below 20
+  pg->probeFailN = (int)std::max<int64_t>(1, ncclParamGinTsProbeFailN());
+  pg->vetoMs = (int)std::max<int64_t>(0, ncclParamGinTsStallRmsnMs());
+  pg->witnessOn = ncclParamGinCtrlWitness() != 0;
+  const int nranks = r->nranks;
+  pg->peers = std::vector<struct gdakiCtrlPeerProbe>((size_t)std::max(0, nranks));
+  pg->fencedPlus1.assign((size_t)std::max(0, nranks), GDAKI_CTRL_FENCE_NONE);
+#ifndef NCCL_GIN_TS_PRODUCTION
+  const char* fz = getenv("NCCL_GIN_TS_TEST_FREEZE_PAGE");
+  if (fz != nullptr && *fz && !gdakiCtrlFreezeParse(fz, &pg->freeze))
+    WARN("GIN/RC: rank %d: test switch FREEZE_PAGE=%s is not <ms>[:helper][@<after ms>]: off", g->rank, fz);
+#endif
+  if (!gdakiCtrlPageLayoutOf((uint32_t)nranks, pg->nLaunchers, &pg->layout)) {
+    WARN("GIN/RC: rank %d: the status page does not fit %d ranks; the page stays off mono_ms=%.3f", g->rank, nranks,
+         gdakiQ4MonoMs());
+    gdakiCtrlPageDelete(pg);
+    return;
+  }
+  pg->rdSlot = (((size_t)pg->layout.bytes + 63u) & ~(size_t)63u) + 2 * sizeof(struct gdakiCtrlPageHead);
+  pg->rdBytes = ((pg->rdSlot * ((size_t)nranks + GDAKI_CTRL_PAGE_MAX_LAUNCHERS)) + 4095u) & ~(size_t)4095u;
+  void* rd = nullptr;
+  if (posix_memalign(&pg->page, 4096, GDAKI_CTRL_PAGE_BYTES) != 0 || pg->page == nullptr ||
+      posix_memalign(&rd, 4096, pg->rdBytes) != 0 || rd == nullptr) {
+    WARN("GIN/RC: rank %d: the status page could not be allocated mono_ms=%.3f", g->rank, gdakiQ4MonoMs());
+    free(rd);
+    gdakiCtrlPageDelete(pg);
+    return;
+  }
+  pg->rd = (uint8_t*)rd;
+  memset(pg->page, 0, GDAKI_CTRL_PAGE_BYTES);
+  memset(pg->rd, 0, pg->rdBytes);
+  pg->head = (struct gdakiCtrlPageHead*)pg->page;
+  // the page MR before any liveness READ QP (design 3.5's registration order)
+  if (wrap_ibv_reg_mr(&pg->pageMr, pd, pg->page, GDAKI_CTRL_PAGE_BYTES, IBV_ACCESS_LOCAL_WRITE | IBV_ACCESS_REMOTE_READ) !=
+          ncclSuccess ||
+      wrap_ibv_reg_mr(&pg->rdMr, pd, pg->rd, pg->rdBytes, IBV_ACCESS_LOCAL_WRITE) != ncclSuccess) {
+    WARN("GIN/RC: rank %d: the status page MR could not be registered mono_ms=%.3f", g->rank, gdakiQ4MonoMs());
+    gdakiCtrlPageDelete(pg);
+    return;
+  }
+  for (int p = 0; p < nranks; p++) {
+    struct gdakiCtrlPeerProbe& pp = pg->peers[(size_t)p];
+    pp.theirStale.assign((size_t)nranks, 0.0);
+    if (p == g->rank || !r->ts->peers[p].gated) continue;
+    if (gdakiProbeQpCreate(r, p, &pp.qp, why, sizeof(why)) != ncclSuccess)
+      WARN("GIN/RC: rank %d: the liveness READ QP to rank %d could not be created (%s) mono_ms=%.3f", g->rank, p, why,
+           gdakiQ4MonoMs());
+    else
+      pp.hasQp = true;
+  }
+  pg->lastBeatMs = gdakiQ4MonoMs();
+  pg->up.store(true, std::memory_order_release);
+  __atomic_store_n(&st->page, pg, __ATOMIC_RELEASE);  // published complete
+  GIN_TS_NOTE("GIN/RC: rank %d: status page up (%u B in use, probe_ms=%d stall_ms=%d W=%d) mono_ms=%.3f", g->rank,
+              pg->layout.bytes, pg->probeMs, pg->stallMs, pg->wMs, gdakiQ4MonoMs());
+}
+
+// The probe summary (rows_gc.py PROBESUM), one line per peer, at the teardown.
+static void gdakiCtrlProbeSummary(struct gdakiRecHost* r, struct gdakiCtrlPage* pg) {
+  for (int p = 0; p < (int)pg->peers.size(); p++) {
+    struct gdakiCtrlPeerProbe& pp = pg->peers[(size_t)p];
+    if (p == pg->me || pp.qp.q == nullptr) continue;
+    std::vector<float> l = pp.latUs;
+    float med = 0, mx = 0;
+    if (!l.empty()) {
+      std::nth_element(l.begin(), l.begin() + (long)(l.size() / 2), l.end());
+      med = l[l.size() / 2];
+      mx = *std::max_element(l.begin(), l.end());
+    }
+    GIN_TS_NOTE("GIN/RC: rank %d: probe summary peer=%d reads=%lu ok=%lu remacc=%lu noresp=%lu timeout=%lu gen=%u "
+                "lat_med_us=%.1f lat_max_us=%.1f beat_gap_max_ms=%.3f torn=%lu after_end_reads=0 after_end_ok=0 "
+                "broken=%lu other_page=%lu sq_max=%u W=%d W_rule=%d mono_ms=%.3f", pg->me, p, (unsigned long)pp.reads,
+                (unsigned long)pp.ok, (unsigned long)pp.remacc, (unsigned long)pp.noresp, (unsigned long)pp.timeouts,
+                pp.qp.gen, (double)med, (double)mx, pg->gapMaxMs, (unsigned long)pp.torn, (unsigned long)pp.broken,
+                (unsigned long)pp.otherInc, pp.io.maxOutstanding, pg->wMs,
+                gdakiCtrlConfirmW(GDAKI_CTRL_CONFIRM_FACTOR, pg->gapMaxMs), gdakiQ4MonoMs());
+  }
+  (void)r;
+}
+static void gdakiCtrlPageFree(struct gdakiRecHost* r) {  // [1] the free hook gdakiCtrlFree calls (threads stopped)
+  struct gdakiCtrlState* st = (r != nullptr) ? r->ctrl : nullptr;
+  struct gdakiCtrlPage* pg = gdakiPageOf(r);
+  if (pg == nullptr) return;
+  gdakiCtrlProbeSummary(r, pg);
+  gdakiCtrlPageDelete(pg);
+  __atomic_store_n(&st->page, (struct gdakiCtrlPage*)nullptr, __ATOMIC_RELEASE);
+}
+
+// Write this rank's judgement words into the status page, once per ms (design 3.1, 3.3; REVIEW_P12 nit 1), and measure
+// the beat's largest gap (W's basis, 결정 5). The watch thread is the only writer. FREEZE_PAGE holds the beats.
+static void gdakiPageBeatStep(struct gdakiRecHost* r, struct gdakiCtrlPage* pg, double nowMs) {
+  if (pg->head == nullptr || nowMs - pg->lastBeatMs < 1.0) return;
+  struct gdaki_context* g = r->ctx;
+  bool freezeAll = false, freezeHelper = false;
+  if (pg->freeze.on) {
+    if (pg->freezeFromMs < 0 && r->hold != nullptr && r->hold->commArmed.load(std::memory_order_acquire) != 0) {
+      pg->freezeFromMs = nowMs + pg->freeze.afterMs;
+      pg->freezeToMs = pg->freezeFromMs + pg->freeze.lenMs;
+    }
+    if (pg->freezeFromMs >= 0 && nowMs >= pg->freezeFromMs && nowMs < pg->freezeToMs) {
+      if (!pg->freezeLogged) {
+        pg->freezeLogged = true;
+        GIN_TS_NOTE("GIN/RC: rank %d: test switch FREEZE_PAGE=%.0f%s: %s frozen mono_ms=%.3f", g->rank, pg->freeze.lenMs,
+                    pg->freeze.helperOnly ? ":helper" : "", pg->freeze.helperOnly ? "helperBeat" : "watchBeat and helperBeat",
+                    nowMs);
+      }
+      freezeAll = !pg->freeze.helperOnly;
+      freezeHelper = true;
+    }
+  }
+  const double gap = nowMs - pg->lastBeatMs;
+  pg->lastBeatMs = nowMs;
+  if (freezeAll) return;
+  if (pg->beat > 0 && gap > pg->gapMaxMs) pg->gapMaxMs = gap;  // a frozen stretch moves lastBeatMs: not a gap
+  gdakiCtrlWordStore(&pg->head->watchBeat, ++pg->beat);
+  if (!freezeHelper) {
+    const int64_t hb = r->ts->heartbeatUs.load(std::memory_order_acquire);
+    gdakiCtrlWordStore(&pg->head->helperBeat, (uint64_t)hb);
+  }
+  const int64_t bz = r->ts->busySinceUs.load(std::memory_order_acquire);
+  const int64_t fw = r->fwSinceUs.load(std::memory_order_acquire);
+  gdakiCtrlWordStore(&pg->head->helperBusy, gdakiCtrlBusyOf(&pg->busy, bz, r->ts->roundMs, fw, r->ts->fwMs));
+  gdakiCtrlWordStore(&pg->head->incNonce, gdakiCtrlIncNonce(gdakiRsSelfInc(r), r->ts->nonce));
+  gdakiCtrlWordStore(&pg->head->flags, gdakiCtrlPageFlags(false, true, gdakiMiOn(r)));
+  // staleMs[q]: this rank's view of q (the larger of its two beats' stalls), for the other ranks' partition guard (one
+  // writer: this thread; design 3.4, REVIEW_P12 막는 문제 3)
+  uint64_t* sw = (uint64_t*)((uint8_t*)pg->page + pg->layout.staleMsOff);
+  for (int q = 0; q < (int)pg->peers.size(); q++) {
+    const struct gdakiCtrlPeerProbe& pp = pg->peers[(size_t)q];
+    double s = 0;
+    if (q != pg->me && pp.watchStale.have) {
+      s = std::max(nowMs - pp.watchStale.firstMs, pp.helperStale.have ? nowMs - pp.helperStale.firstMs : 0.0);
+      if (s < 0) s = 0;
+    }
+    gdakiCtrlWordStore(&sw[q], (uint64_t)s);
+  }
+}
+
+// One signaled READ of `bytes` of the peer's page into `local` (this peer's slot of the READ buffer). 0 posted.
+static int gdakiProbePost(struct gdakiCtrlPage* pg, struct gdakiCtrlPeerProbe& pp, uint8_t* local, uint32_t bytes,
+                          uint64_t wrId) {
+  if (pp.qp.q == nullptr || pp.qp.q->qp == nullptr || !pp.haveRemote || !gdakiCtrlProbeCanPost(&pp.io, 1)) return -1;
+  struct ibv_sge sg;
+  memset(&sg, 0, sizeof(sg));
+  sg.addr = (uint64_t)(uintptr_t)local;
+  sg.length = bytes;
+  sg.lkey = pg->rdMr->lkey;
+  struct ibv_send_wr wr, *bad = nullptr;
+  memset(&wr, 0, sizeof(wr));
+  wr.wr_id = wrId;
+  wr.sg_list = &sg;
+  wr.num_sge = 1;
+  wr.opcode = IBV_WR_RDMA_READ;
+  wr.send_flags = IBV_SEND_SIGNALED;
+  wr.wr.rdma.remote_addr = pp.remotePage.addr;
+  wr.wr.rdma.rkey = pp.remotePage.rkey;
+  if (wrap_ibv_post_send(pp.qp.q->qp, &wr, &bad) != ncclSuccess) return -1;
+  pp.qp.q->outstanding++;
+  return 0;
+}
+// The QP broke (an error completion of this generation, or a failed post): its software state, and the helper's word
+// (the pairing re-pairs it).
+static void gdakiProbeBroke(struct gdakiCtrlPeerProbe& pp) {
+  if (!pp.qp.connected) return;  // already: the first error of the generation counts
+  const uint32_t gen = pp.qp.gen;
+  gdakiProbeQpOnError(&pp.qp);
+  pp.errGenPlus1.store(gen + 1u, std::memory_order_release);
+}
+// Collect the QP's flushes before a RESET (bounded 100 ms): true when nothing is in flight any more.
+static bool gdakiProbeDrain(struct gdakiCtrlPeerProbe& pp) {
+  const double t0 = gdakiQ4MonoMs();
+  while (pp.io.outstanding > 0 && pp.qp.q != nullptr && pp.qp.q->cq != nullptr && gdakiQ4MonoMs() - t0 < 100.0) {
+    struct ibv_wc wc[8];
+    int n = 0;
+    if (wrap_ibv_poll_cq(pp.qp.q->cq, 8, wc, &n) != ncclSuccess) break;
+    for (int k = 0; k < n; k++) {
+      (void)gdakiCtrlProbeOnCqe(&pp.io, gdakiCtrlProbeWrKind(wc[k].wr_id), gdakiCtrlProbeWrSeq(wc[k].wr_id));
+      if (pp.qp.q->outstanding > 0) pp.qp.q->outstanding--;
+    }
+    if (n == 0) std::this_thread::sleep_for(std::chrono::microseconds(20));
+  }
+  return pp.io.outstanding == 0;
+}
+// A request of the helper's pairing on the peer's liveness READ QP (the watch thread is its only owner).
+static void gdakiProbeDoReq(struct gdakiRecHost* r, struct gdakiCtrlPage* pg, int p, const struct gdakiCtrlProbeReq& q,
+                            struct gdakiCtrlProbeRes* res) {
+  struct gdakiCtrlPeerProbe& pp = pg->peers[(size_t)p];
+  res->seq = q.seq;
+  res->ok = false;
+  res->gen = q.gen;
+  res->why[0] = 0;
+  if (pp.qp.q == nullptr || pp.qp.q->qp == nullptr) {
+    snprintf(res->why, sizeof(res->why), "no liveness READ QP");
+    return;
+  }
+  char why[128] = {0};
+  if (q.op == GDAKI_CTRL_PO_TOERR) {
+    struct ibv_qp_attr a;
+    memset(&a, 0, sizeof(a));
+    a.qp_state = IBV_QPS_ERR;
+    (void)wrap_ibv_modify_qp(pp.qp.q->qp, &a, IBV_QP_STATE);
+    gdakiProbeQpOnError(&pp.qp);  // no re-pairing word: the hold start's own ERR
+    pp.haveRemote = false;
+    if (pp.win.state == GDAKI_CTRL_WS_OPEN) pp.win.countable = false;
+    res->ok = true;
+    return;
+  }
+  // a QP that ever connected, or one prepared for another generation, is reset (ERR, its flushes collected, RESET, INIT,
+  // a fresh PSN); one prepared for this generation is answered as it is (the model's "reuse")
+  const bool reuse = q.op == GDAKI_CTRL_PO_CONNECT && !pp.qp.connected && !pp.qp.q->err && pp.preparedGen != 0 &&
+                     pp.preparedGen == q.gen && pp.io.outstanding == 0;
+  pp.preparedGen = 0;
+  if (!reuse) {
+    // an open window's READs are flushed and collected here, not answered: it cannot confirm (never NORESP from this
+    // rank's own re-pairing)
+    if (pp.win.state == GDAKI_CTRL_WS_OPEN) pp.win.countable = false;
+    if (pp.qp.connected || pp.qp.q->err || pp.io.outstanding > 0) {
+      struct ibv_qp_attr a;
+      memset(&a, 0, sizeof(a));
+      a.qp_state = IBV_QPS_ERR;
+      (void)wrap_ibv_modify_qp(pp.qp.q->qp, &a, IBV_QP_STATE);
+      gdakiProbeQpOnError(&pp.qp);
+      if (!gdakiProbeDrain(pp)) {  // its flushes did not come: a new QP (nothing of the old one completes then)
+        gdakiProbeQpDestroy(&pp.qp);
+        if (gdakiProbeQpCreate(r, p, &pp.qp, why, sizeof(why)) != ncclSuccess) {
+          snprintf(res->why, sizeof(res->why), "a new liveness READ QP could not be created (%s)", why);
+          return;
+        }
+      }
+    }
+    gdakiCtrlProbeIoReset(&pp.io);
+    if (gdakiProbeQpReconnect(&pp.qp, nullptr, q.gen, why, sizeof(why)) != ncclSuccess) {
+      snprintf(res->why, sizeof(res->why), "%s", why);
+      return;
+    }
+    while (q.haveAvoid && pp.qp.local.psn == (q.avoidPsn & 0xffffffu)) {  // a fresh PSN (REVIEW_P12 nit 9)
+      pp.qp.q->psn = gdakiMiHostQpPsn();
+      pp.qp.local.psn = pp.qp.q->psn;
+    }
+  }
+  pp.qp.gen = q.gen;
+  if (q.op == GDAKI_CTRL_PO_PREPARE) pp.preparedGen = q.gen;
+  if (q.op == GDAKI_CTRL_PO_CONNECT) {
+    if (gdakiProbeQpConnect(&pp.qp, &q.remote, q.gen, why, sizeof(why)) != ncclSuccess) {
+      snprintf(res->why, sizeof(res->why), "%s", why);
+      return;
+    }
+    pp.remotePage = q.page;
+    pp.haveRemote = q.page.addr != 0 && q.page.rkey != 0 && q.page.len >= sizeof(struct gdakiCtrlPageHead);
+    pp.incExp = q.incNonce;
+    pp.watchStale = gdakiCtrlStale();
+    pp.helperStale = gdakiCtrlStale();
+    pp.busy = gdakiCtrlBusySeen();
+    pp.lastCls = GDAKI_CTRL_CQ_OK;
+    pp.pageOk = true;
+    pp.witnessUnknown = false;
+    pp.nextReadMs = gdakiQ4MonoMs();
+  }
+  res->local = pp.qp.local;
+  res->ok = true;
+}
+
+// One judgement of peer p from what this reader knows now (the watch thread); `wEnds` with the window verdict `cw` at
+// t_F + W. A stall verdict goes into the helper's mailbox once per incarnation (the latch).
+static void gdakiProbeJudge(struct gdakiRecHost* r, struct gdakiCtrlPage* pg, int p, double nowMs, bool wEnds, uint32_t cw) {
+  struct gdakiCtrlPeerProbe& pp = pg->peers[(size_t)p];
+  struct gdakiCtrlRFacts f;
+  f.probeOff = pg->probeMs == 0;
+  f.lastCls = pp.lastCls;
+  f.timedOut = pp.io.periodicOut && pp.io.timeoutSeen;
+  f.okInGen = gdakiProbeQpOkInGen(&pp.qp);
+  f.pageOk = pp.pageOk;
+  f.watchRose = pp.watchRose;
+  f.watchStaleMs = pp.watchStale.have ? pp.watchStale.lastMs - pp.watchStale.firstMs : 0;
+  f.helperStaleMs = pp.helperStale.have ? pp.helperStale.lastMs - pp.helperStale.firstMs : 0;
+  f.busy = gdakiCtrlBusySeenAt(&pp.busy, nowMs, &f.busyOverMs);
+  f.suspectMs = (double)pg->suspectMs;
+  f.stallMs = (double)pg->stallMs;
+  // the partition guard: the other survivors' view of p (their page word staleMs[p], from this rank's last READ of them)
+  double others[GDAKI_CTRL_PAGE_MAX_RANKS];
+  bool valid[GDAKI_CTRL_PAGE_MAX_RANKS];
+  int no = 0;
+  for (int k = 0; k < (int)pg->peers.size() && no < (int)GDAKI_CTRL_PAGE_MAX_RANKS; k++) {
+    if (k == pg->me || k == p || pg->peers[(size_t)k].qp.q == nullptr) continue;
+    const struct gdakiCtrlPeerProbe& pk = pg->peers[(size_t)k];
+    others[no] = pk.theirStale.size() > (size_t)p ? pk.theirStale[(size_t)p] : 0;
+    const double kStale = pk.watchStale.have ? pk.watchStale.lastMs - pk.watchStale.firstMs : 1e18;
+    valid[no] = nowMs - pk.lastOkMs <= 3.0 * pg->probeMs && kStale < (double)pg->suspectMs && pk.pageOk;
+    no++;
+  }
+  const uint32_t guard = gdakiCtrlPartitionGuard(others, valid, no, (double)pg->stallMs, (double)pg->probeMs);
+  f.guardOk = guard == GDAKI_CTRL_PG_PASS;
+  const int64_t mv = pp.rmsnMoveUs.load(std::memory_order_acquire);
+  f.vetoClear = mv == 0 || nowMs - (double)mv / 1000.0 > (double)pg->vetoMs;
+  const uint32_t R = gdakiCtrlRDerive(f);
+  const uint32_t L = gdakiCtrlLOf(pg->launcherPaired.load(std::memory_order_acquire), false, false, false, false, false);
+  const uint32_t B = pp.byeSeen ? GDAKI_CTRL_B_SEEN : GDAKI_CTRL_B_NONE;
+  const uint32_t W = gdakiCtrlWOf(pg->witnessOn, pp.win.state == GDAKI_CTRL_WS_OPEN, wEnds, cw, pp.witnessUnknown);
+  pp.last = gdakiCtrlJudge(L, B, W, R);
+  const uint32_t inc = gdakiCtrlIncOf(pp.incExp);
+  if (pp.last.row == 18 && !pp.suspectLogged) {
+    pp.suspectLogged = true;
+    const bool helper = R == GDAKI_CTRL_R_HELPER_SUSPECT || R == GDAKI_CTRL_R_HELPER_GUARDED;
+    GIN_TS_NOTE("GIN/RC: rank %d: rank %d suspected (kind=%s stale_ms=%.1f)%s mono_ms=%.3f", pg->me, p,
+                helper ? "helper" : "watch", helper ? f.helperStaleMs : f.watchStaleMs,
+                guard == GDAKI_CTRL_PG_FRESH  ? " (partition guard: another survivor sees it fresh)"
+                : guard == GDAKI_CTRL_PG_SELF ? " (partition guard: no other survivor readable; this rank suspects itself)"
+                : !f.vetoClear                ? " (the data path's veto: its responder count moved)"
+                                              : "",
+                nowMs);
+  } else if (pp.last.row == 20) {
+    pp.suspectLogged = false;
+  }
+  if ((pp.last.verdict == GDAKI_CTRL_V_STALL || pp.last.verdict == GDAKI_CTRL_V_STALL_HELPER) && pp.latchedInc != inc + 1u) {
+    pp.latchedInc = inc + 1u;  // the latch: once per incarnation
+    pp.stallMail.store(gdakiCtrlMailPack(pp.last.row, pp.last.verdict, pp.last.cause, inc), std::memory_order_release);
+  }
+}
+// A window's verdict at t_F + W (or at once when it cannot confirm): the judgement with W = the window's end, a line,
+// the helper's mailbox; the witness is unknown from now (rows 8, 9).
+static void gdakiProbeWindowEnd(struct gdakiRecHost* r, struct gdakiCtrlPage* pg, int p, double nowMs) {
+  struct gdakiCtrlPeerProbe& pp = pg->peers[(size_t)p];
+  const uint32_t cw = gdakiCtrlWindowJudge(&pp.win, pp.incExp, nowMs);
+  static const char* kName[] = {"alive", "STALE", "NORESP", "REMACC", "unconfirmed"};
+  GIN_TS_NOTE("GIN/RC: rank %d: confirm window for rank %d closed: %s (opened by %s at %.3f, READ1 %s%.3f, READ2 %s%.3f, "
+              "W=%d) mono_ms=%.3f", pg->me, p, kName[cw <= 4 ? cw : 4], gdakiCtrlWsrcName(pp.win.src), pp.win.tF,
+              pp.win.r1Done ? "+" : "not done ", pp.win.r1Done ? pp.win.r1Ms - pp.win.tF : 0.0,
+              pp.win.r2Done ? "+" : "not done ", pp.win.r2Done ? pp.win.r2Ms - pp.win.tF : 0.0, pg->wMs, nowMs);
+  gdakiProbeJudge(r, pg, p, nowMs, true, cw);
+  if (pp.win.src != GDAKI_CTRL_WSRC_ENDED)
+    pp.winMail.store(gdakiCtrlMailPack(pp.last.row, pp.last.verdict, pp.last.cause, gdakiCtrlIncOf(pp.incExp)),
+                     std::memory_order_release);
+  pp.witnessUnknown = true;  // the FIN or RST is spent (design 4.2 W: 모름)
+}
+
+// One peer's probe, run by the watch thread every step: the handoff, the completions by wr_id, the periodic READ (one at
+// a time), its timeout, the window, the judgement.
+static void gdakiProbePeerStep(struct gdakiRecHost* r, struct gdakiCtrlPage* pg, int p, double nowMs) {
+  struct gdakiCtrlPeerProbe& pp = pg->peers[(size_t)p];
+  bool doReq = false, toErr = false;
+  struct gdakiCtrlProbeReq q;
+  uint32_t wsrc = 0;
+  double wtf = 0;
+  {
+    std::lock_guard<std::mutex> lk(pg->mu);
+    if (pp.req.seq != pp.reqDone) {
+      q = pp.req;
+      doReq = true;
+    }
+    if (pp.toErrReq) {
+      toErr = true;
+      pp.toErrReq = false;
+    }
+    if (pp.winReqSeq != pp.winSeen) {
+      pp.winSeen = pp.winReqSeq;
+      wsrc = pp.winReqSrc;
+      wtf = pp.winReqMs;
+    }
+  }
+  if (toErr) {  // the hold start's fence step 1 (design 4.4)
+    struct gdakiCtrlProbeReq e;
+    e.op = GDAKI_CTRL_PO_TOERR;
+    struct gdakiCtrlProbeRes dummy;
+    gdakiProbeDoReq(r, pg, p, e, &dummy);
+  }
+  if (doReq) {
+    struct gdakiCtrlProbeRes res;
+    gdakiProbeDoReq(r, pg, p, q, &res);
+    std::lock_guard<std::mutex> lk(pg->mu);
+    pp.res = res;
+    pp.res.gen = q.gen;
+    pp.reqDone = q.seq;
+  }
+  if (pp.qp.q == nullptr || pp.qp.q->cq == nullptr) return;
+  // the completions, each matched by its wr_id (REVIEW_P12 막는 문제 4, 5)
+  struct ibv_wc wc[8];
+  int n = 0;
+  if (pp.io.outstanding > 0 && wrap_ibv_poll_cq(pp.qp.q->cq, 8, wc, &n) == ncclSuccess) {
+    for (int k = 0; k < n; k++) {
+      const uint64_t id = wc[k].wr_id;
+      const uint32_t kind = gdakiCtrlProbeWrKind(id), seq = gdakiCtrlProbeWrSeq(id);
+      const uint32_t cls = gdakiCtrlProbeCqeClass((int)wc[k].status);
+      if (pp.qp.q->outstanding > 0) pp.qp.q->outstanding--;
+      const bool periodic = gdakiCtrlProbeOnCqe(&pp.io, kind, seq);
+      const bool thisGen = gdakiCtrlProbeWrGenIs(id, pp.qp.gen) && pp.qp.connected;
+      if (cls != GDAKI_CTRL_CQ_OK && thisGen) gdakiProbeBroke(pp);  // the first error of this generation
+      if (!gdakiCtrlProbeWrGenIs(id, pp.qp.gen)) continue;           // an older generation's: its slot only
+      if (kind == GDAKI_CTRL_PW_PERIODIC && periodic) {
+        pp.reads++;
+        if (cls == GDAKI_CTRL_CQ_OK) {
+          const uint8_t* b = gdakiPageRd(pg, p);
+          struct gdakiCtrlPageHead h;
+          memcpy(&h, b, sizeof(h));  // REVIEW_P12 nit 6: a copy, not a cast
+          pp.ok++;
+          if (pp.latUs.size() < 65536) pp.latUs.push_back((float)((nowMs - pp.postMs) * 1000.0));
+          gdakiProbeQpOnSuccess(&pp.qp, pp.qp.gen);
+          pp.okGen.store(pp.qp.gen, std::memory_order_release);
+          pp.lastCls = GDAKI_CTRL_CQ_OK;
+          pp.lastOkMs = nowMs;
+          pp.pageOk = h.incNonce == pp.incExp;  // design 3.2: another process's page is never the stall clock's
+          if (!pp.pageOk) {
+            pp.otherInc++;
+          } else {
+            (void)gdakiCtrlStaleOnRead(&pp.watchStale, h.watchBeat, nowMs, (double)pg->probeMs, &pp.watchRose);
+            (void)gdakiCtrlStaleOnRead(&pp.helperStale, h.helperBeat, nowMs, (double)pg->probeMs);
+            double over = 0;
+            (void)gdakiCtrlBusySeenStep(&pp.busy, h.helperBusy, nowMs, &over);
+            pp.byeSeen = pp.byeSeen || (h.flags & GDAKI_CTRL_PF_LEAVING) != 0;
+            uint64_t w[GDAKI_CTRL_PAGE_MAX_RANKS];
+            const size_t nw = std::min(pp.theirStale.size(), (size_t)GDAKI_CTRL_PAGE_MAX_RANKS);
+            if (pg->layout.staleMsOff + 8u * nw <= pg->layout.bytes) {
+              memcpy(w, b + pg->layout.staleMsOff, 8u * nw);
+              for (size_t i = 0; i < nw; i++) pp.theirStale[i] = (double)w[i];
+            }
+          }
+        } else {
+          pp.lastCls = cls;
+          if (cls == GDAKI_CTRL_CQ_REMACC) pp.remacc++;
+          else if (cls == GDAKI_CTRL_CQ_NORESP) pp.noresp++;
+          else pp.broken++;
+          WARN("GIN/RC: rank %d: liveness READ of rank %d: %s (status %d) mono_ms=%.3f", pg->me, p,
+               gdakiCtrlCqClassName(cls), (int)wc[k].status, nowMs);
+        }
+        gdakiProbeJudge(r, pg, p, nowMs, false, 0);
+      } else if (kind == GDAKI_CTRL_PW_WIN1 || kind == GDAKI_CTRL_PW_WIN2) {
+        const uint32_t which = kind == GDAKI_CTRL_PW_WIN1 ? 1u : 2u;
+        struct gdakiCtrlPageHead h;
+        memset(&h, 0, sizeof(h));
+        if (cls == GDAKI_CTRL_CQ_OK) {
+          memcpy(&h, gdakiPageRd(pg, p) + gdakiPageWinOff(pg, which), sizeof(h));
+          gdakiProbeQpOnSuccess(&pp.qp, pp.qp.gen);
+        }
+        (void)gdakiCtrlWindowOnCqe(&pp.win, seq, which, cls, h.watchBeat, h.incNonce, nowMs);
+      }
+    }
+  }
+  // the periodic READ's timeout: a report (R (12)), the READ stays in flight
+  if (gdakiCtrlProbeTimedOut(&pp.io, nowMs, (double)pg->probeTimeoutMs)) {
+    pp.timeouts++;
+    GIN_TS_NOTE("GIN/RC: rank %d: probe of rank %d timed out (no CQE in %d ms) mono_ms=%.3f", pg->me, p,
+                pg->probeTimeoutMs, nowMs);
+    gdakiProbeJudge(r, pg, p, nowMs, false, 0);
+  }
+  // the window
+  if (wsrc != 0) {
+    const bool countable = gdakiProbeQpOkInGen(&pp.qp) && pp.haveRemote && gdakiCtrlProbeCanPost(&pp.io, 2);
+    if (gdakiCtrlWindowOpen(&pp.win, wsrc, wtf, countable))
+      GIN_TS_NOTE("GIN/RC: rank %d: confirm window for rank %d opened by %s W=%d%s mono_ms=%.3f", pg->me, p,
+                  gdakiCtrlWsrcName(wsrc), pg->wMs, countable ? "" : " (cannot confirm: no READ of this generation)", nowMs);
+  }
+  for (int guard = 0; guard < 3; guard++) {
+    const uint32_t a = gdakiCtrlWindowStep(&pp.win, nowMs, (double)pg->wMs);
+    if (a == GDAKI_CTRL_WA_NONE) break;
+    if (a == GDAKI_CTRL_WA_JUDGE) {
+      gdakiProbeWindowEnd(r, pg, p, nowMs);
+      break;
+    }
+    const uint32_t which = a == GDAKI_CTRL_WA_POST1 ? 1u : 2u;
+    const uint64_t id = gdakiCtrlProbeWrId(which == 1 ? GDAKI_CTRL_PW_WIN1 : GDAKI_CTRL_PW_WIN2, (uint32_t)p, pp.qp.gen,
+                                           pp.win.no);
+    const bool ok = gdakiProbeQpIsRts(&pp.qp) &&
+                    gdakiProbePost(pg, pp, gdakiPageRd(pg, p) + gdakiPageWinOff(pg, which),
+                                   (uint32_t)sizeof(struct gdakiCtrlPageHead), id) == 0;
+    if (ok) gdakiCtrlProbeOnPosted(&pp.io, which == 1 ? GDAKI_CTRL_PW_WIN1 : GDAKI_CTRL_PW_WIN2, pp.win.no, nowMs);
+    gdakiCtrlWindowPosted(&pp.win, which, ok);
+  }
+  // the periodic READ: one at a time (REVIEW_P12 막는 문제 4), never into the open window's reserved slots
+  if (pg->probeMs == 0 || !pp.haveRemote || !gdakiProbeQpIsRts(&pp.qp)) return;
+  const uint32_t reserve =
+      pp.win.state == GDAKI_CTRL_WS_OPEN ? (uint32_t)!pp.win.r1Posted + (uint32_t)!pp.win.r2Posted : 0u;
+  const uint32_t seq = gdakiCtrlProbePeriodicDue(&pp.io, nowMs, pp.nextReadMs, reserve);
+  if (seq == 0) return;
+  pp.nextReadMs = nowMs + (double)pg->probeMs;
+  const uint32_t bytes = std::min<uint32_t>(pg->layout.bytes, pp.remotePage.len);
+  if (gdakiProbePost(pg, pp, gdakiPageRd(pg, p), bytes, gdakiCtrlProbeWrId(GDAKI_CTRL_PW_PERIODIC, (uint32_t)p, pp.qp.gen,
+                                                                           seq)) == 0) {
+    gdakiCtrlProbeOnPosted(&pp.io, GDAKI_CTRL_PW_PERIODIC, seq, nowMs);
+    pp.postMs = nowMs;
+  } else {
+    gdakiProbeBroke(pp);  // a failed post: the QP is not usable (the pairing re-pairs it)
+  }
+}
+
+// The watch-thread hook (one call from gdakiQ4Watch): the beat and each peer's probe. A no-op until the page is up.
+static void gdakiCtrlPageStep(struct gdakiRecHost* r) {
+  if (r == nullptr || r->ts == nullptr) return;  // only a context that asked for transparent recovery has a page
+  struct gdakiCtrlPage* pg = gdakiPageOf(r);
+  if (!gdakiPageUp(pg)) return;  // published complete on the setup thread (gdakiPageSetup)
+  const double nowMs = gdakiQ4MonoMs();
+  gdakiPageBeatStep(r, pg, nowMs);
+  for (int p = 0; p < (int)pg->peers.size(); p++)
+    if (p != pg->me && pg->peers[(size_t)p].hasQp) gdakiProbePeerStep(r, pg, p, nowMs);  // a lost QP still answers requests
+}
+
+// ---- the helper's side (helper thread only) ----
+// The window request: a witness FIN or RST with no BYE (gdakiTsSocketLost), or an end report for timing only; t_F is the
+// helper's clock now. The watch thread opens the window at its next step.
+static void gdakiCtrlWindowRequest(struct gdakiRecHost* r, int peer, uint32_t src) {
+  struct gdakiCtrlPage* pg = gdakiPageOf(r);
+  if (!gdakiPageUp(pg) || peer < 0 || peer >= (int)pg->peers.size() || peer == pg->me) return;
+  struct gdakiCtrlPeerProbe& pp = pg->peers[(size_t)peer];
+  std::lock_guard<std::mutex> lk(pg->mu);
+  pp.winReqMs = gdakiQ4MonoMs();
+  pp.winReqSrc = src;
+  pp.winReqSeq++;
+}
+// gdakiTsSocketLost's hook (rdma build): the cause names of ln4's pump ("FIN"; ECONNRESET is the RST).
+static void gdakiCtrlOnSocketLost(struct gdakiRecHost* r, int peer, const char* cause, bool left) {
+  if (left || cause == nullptr) return;  // a BYE came first: the FIN is "left", no window (design 4.2 B)
+  if (strcmp(cause, "FIN") == 0) gdakiCtrlWindowRequest(r, peer, GDAKI_CTRL_WSRC_FIN);
+  else if (strcmp(cause, "ECONNRESET") == 0) gdakiCtrlWindowRequest(r, peer, GDAKI_CTRL_WSRC_RST);
+}
+// The data path's veto input (the helper's QP watch, gdakiDetWatchStep): the peer's responder count on this rank's QP
+// moved since the last sample, i.e. the peer's GPU still sends (EXPERIMENT.md 9.3: NCCL_GIN_TS_STALL_RMSN_MS). Without
+// the QP watch (NCCL_GIN_TS_QPWATCH_MS = 0) no sample comes and the veto stays clear.
+static void gdakiCtrlVetoObserve(struct gdakiRecHost* r, int peer, int qpIdx, uint32_t rmsn) {
+  struct gdakiCtrlPage* pg = gdakiPageOf(r);
+  if (!gdakiPageUp(pg) || peer < 0 || peer >= (int)pg->peers.size() || qpIdx < 0) return;
+  static thread_local std::vector<uint32_t> lastRmsn;  // the helper's own (one helper per context; indexes by QP)
+  static thread_local std::vector<uint8_t> have;
+  if ((size_t)qpIdx >= lastRmsn.size()) {
+    lastRmsn.resize((size_t)qpIdx + 1, 0);
+    have.resize((size_t)qpIdx + 1, 0);
+  }
+  if (have[(size_t)qpIdx] && lastRmsn[(size_t)qpIdx] != (rmsn & 0xffffffu))
+    pg->peers[(size_t)peer].rmsnMoveUs.store((int64_t)(gdakiQ4MonoMs() * 1000.0), std::memory_order_release);
+  lastRmsn[(size_t)qpIdx] = rmsn & 0xffffffu;
+  have[(size_t)qpIdx] = 1;
+}
+// The helper's request of a QP operation; 0 when one is pending already (the caller waits for its result).
+static uint32_t gdakiCtrlProbeAsk(struct gdakiRecHost* r, int peer, const struct gdakiCtrlProbeReq& q) {
+  struct gdakiCtrlPage* pg = gdakiPageOf(r);
+  if (!gdakiPageUp(pg) || peer < 0 || peer >= (int)pg->peers.size()) return 0;
+  struct gdakiCtrlPeerProbe& pp = pg->peers[(size_t)peer];
+  std::lock_guard<std::mutex> lk(pg->mu);
+  if (pp.req.seq != pp.reqDone) return 0;
+  pp.req = q;
+  pp.req.seq = pp.reqDone + 1u == 0 ? 1u : pp.reqDone + 1u;
+  return pp.req.seq;
+}
+// The result of request `seq`: true once it is there (*out a copy).
+static bool gdakiCtrlProbeAnswer(struct gdakiRecHost* r, int peer, uint32_t seq, struct gdakiCtrlProbeRes* out) {
+  struct gdakiCtrlPage* pg = gdakiPageOf(r);
+  if (!gdakiPageUp(pg) || peer < 0 || peer >= (int)pg->peers.size() || seq == 0) return false;
+  struct gdakiCtrlPeerProbe& pp = pg->peers[(size_t)peer];
+  std::lock_guard<std::mutex> lk(pg->mu);
+  if (pp.reqDone != seq || pp.res.seq != seq) return false;
+  *out = pp.res;
+  return true;
+}
+// The watch thread's "this QP broke in generation g" (taken once): g + 1, 0 none.
+static uint32_t gdakiCtrlProbeErrTake(struct gdakiRecHost* r, int peer) {
+  struct gdakiCtrlPage* pg = gdakiPageOf(r);
+  if (!gdakiPageUp(pg) || peer < 0 || peer >= (int)pg->peers.size()) return 0;
+  return pg->peers[(size_t)peer].errGenPlus1.exchange(0, std::memory_order_acq_rel);
+}
+
+// Phase 1's reaction to a software stall verdict (rows 14, 15), on the helper (REVIEW_P12 막는 문제 6): STALLED(52) to
+// every rank, then decline the peer (no launcher and no FENCED in phase 1: the fence and the restore are phase 3's; this
+// is the NCCL_GIN_RESTORE_FENCE=none shape). 결정 1: a helper-only stall (row 15) takes the same path as row 14.
+static void gdakiCtrlStallDecline(struct gdakiRecHost* r, int peer, uint32_t inc, const char* cause) {
+  struct gdakiHold* h = gdakiHoldOf(r);
+  const int told = h != nullptr ? gdakiHoldBroadcast(r, GDAKI_TS_CTRL_STALLED, peer, inc, -1) : 0;
+  char why[96];
+  snprintf(why, sizeof(why), "liveness stall judged (%s)", (cause != nullptr && cause[0]) ? cause : "STALL");
+  WARN("GIN/RC: rank %d: rank %d (incarnation %u) judged stalled (%s); STALLED to %d rank(s); phase 1 declines (no "
+       "launcher, no fence yet) mono_ms=%.3f", r->ctx->rank, peer, inc, why, told, gdakiQ4MonoMs());
+  gdakiTsDecline(r, peer, why, false, 0, gdakiCause::PeerDead, GDAKI_UA_PEER_DEAD);
+}
+// The helper's step (gdakiTsMain, every loop): the mailboxes, taken once each, and the scaffold's pairing.
+static void gdakiCtrlPageHelperStep(struct gdakiRecHost* r) {
+  struct gdakiCtrlPage* pg = gdakiPageOf(r);
+  if (!gdakiPageUp(pg) || r->ts == nullptr) return;
+  for (int p = 0; p < (int)pg->peers.size(); p++) {
+    if (p == pg->me) continue;
+    struct gdakiCtrlPeerProbe& pp = pg->peers[(size_t)p];
+    const uint64_t sm = pp.stallMail.exchange(0, std::memory_order_acq_rel);
+    if (sm != 0) {
+      const uint32_t inc = gdakiCtrlMailInc(sm);
+      const struct gdakiTsPeer& pe = r->ts->peers[(size_t)p];
+      if (inc != gdakiLnOf(r, p).cur)  // judged on another incarnation's page than the lineage's current one: dropped
+        GIN_TS_NOTE("GIN/LN: rank %d: stall verdict of rank %d for incarnation %u dropped (current %u) mono_ms=%.3f",
+                    pg->me, p, inc, gdakiLnOf(r, p).cur, gdakiQ4MonoMs());
+      else if (!pe.declined)
+        gdakiCtrlStallDecline(r, p, inc, gdakiCtrlCauseName(gdakiCtrlMailCause(sm)));
+    }
+    const uint64_t wm = pp.winMail.exchange(0, std::memory_order_acq_rel);
+    if (wm != 0) {
+      const uint32_t row = gdakiCtrlMailRow(wm);
+      if (row == 8)
+        GIN_TS_NOTE("GIN/RC: rank %d: witness of rank %d lost; liveness alive mono_ms=%.3f (table row 8)", pg->me, p,
+                    gdakiQ4MonoMs());
+      else
+        GIN_TS_NOTE("GIN/RC: rank %d: confirm window of rank %d: table row %u%s%s; phase 1 reports it (the reaction stays "
+                    "ln4's socket rule until phase 2a-2 moves the records off the socket) mono_ms=%.3f", pg->me, p, row,
+                    gdakiCtrlMailCause(wm) != GDAKI_CTRL_C_NONE ? ", cause " : "",
+                    gdakiCtrlCauseName(gdakiCtrlMailCause(wm)), gdakiQ4MonoMs());
+    }
+  }
+  gdakiCtrlProbePairingStep(r);
+}
+
+// ---- the hooks (phase 1's real bodies; they replace the preparation stage's placeholders) ----
+// The launcher-paired latch (phase 3 calls it once the context's launcher pairing stands; never cleared: REVIEW_P12 고칠
+// 것 5, the gate does not move between FENCED and /proc inside one hold).
+[[maybe_unused]] static void gdakiCtrlLauncherPairedLatch(struct gdakiRecHost* r) {
+  struct gdakiCtrlPage* pg = gdakiPageOf(r);
+  if (pg != nullptr) pg->launcherPaired.store(true, std::memory_order_release);
+}
+// The buddy's activation fence gate (design 4.4; REVIEW_PREP main-list fix 9), the last condition of
+// gdakiHoldActivateDecide's rdma branch (helper): gdakiCtrlActGate over the latch and the fence word (the /proc verdict is
+// the decision's own check before it: GO here). Waiting, the fence's report name once per (peer, dead) (gdakiLnFenceOf).
+static bool gdakiCtrlActFenceOk(struct gdakiRecHost* r, int peer, uint32_t dead) {
+  struct gdakiCtrlPage* pg = gdakiPageOf(r);
+  const bool paired = pg != nullptr && pg->launcherPaired.load(std::memory_order_acquire);
+  const uint64_t word = (pg != nullptr && peer >= 0 && peer < (int)pg->fencedPlus1.size()) ? pg->fencedPlus1[(size_t)peer]
+                                                                                           : GDAKI_CTRL_FENCE_NONE;
+  const int v = gdakiCtrlActGate(paired, gdakiCtrlFencedIs(word, dead), GDAKI_RS_ACT_GO);
+  if (v != GDAKI_RS_ACT_GO && pg != nullptr) {
+    static thread_local uint64_t lastSaid = ~0ull;
+    const uint64_t key = ((uint64_t)(uint32_t)peer << 32) | dead;
+    if (key != lastSaid) {
+      lastSaid = key;
+      const struct gdakiLnView lv = gdakiLnOf(r, peer);
+      const bool sent = peer >= 0 && peer < (int)pg->peers.size() && pg->peers[(size_t)peer].fenceSent;
+      GIN_TS_NOTE("GIN/RC: rank %d: rank %d (incarnation %u) fence %s: the activation waits for FENCED mono_ms=%.3f",
+                  r->ctx->rank, peer, dead, gdakiLnFenceName(gdakiLnFenceOf(lv.phase, lv.dead, word, sent)),
+                  gdakiQ4MonoMs());
+    }
+  }
+  return v == GDAKI_RS_ACT_GO;
+}
+// FENCED(peer, inc) into the fence word (design 4.4; gdakiLnFencedStep: CURRENT or HELD_OLD only, never down). In
+// phase 1 (no launcher) this is reached only by a relayed FENCED record (record 54), which this experiment does not
+// produce; it is here for phase 3 (gdakiCtrlOnRecord also opens a timing window on it).
+static void gdakiLnFenced(struct gdakiRecHost* r, int peer, uint32_t inc) {
+  struct gdakiCtrlPage* pg = gdakiPageOf(r);
+  if (pg == nullptr || peer < 0 || peer >= (int)pg->fencedPlus1.size()) return;
+  pg->fencedPlus1[(size_t)peer] = gdakiLnFencedStep(pg->fencedPlus1[(size_t)peer], gdakiLnClassify(gdakiLnOf(r, peer), inc), inc);
+}
+// The liveness READ QP toward `peer` into ERR, through the watch thread's request word (design v2 2.1's handoff): the
+// helper sets the request, the watch thread (which owns the QP) moves it. Called by gdakiCtrlPeerToErr at the hold start.
+static void gdakiProbeToErr(struct gdakiRecHost* r, int peer) {
+  struct gdakiCtrlPage* pg = gdakiPageOf(r);
+  if (pg == nullptr || peer < 0 || peer >= (int)pg->peers.size()) return;
+  std::lock_guard<std::mutex> lk(pg->mu);
+  pg->peers[(size_t)peer].toErrReq = true;
+}
+
+// Records 52-55 handled in the hold drain (a survivor and a held peer's buddy take them in arrival order). 53 DISPUTE is
+// received only: the detection design's stall disagreement sends it (REVIEW_P12 nit 15). 55 is the scaffold's pairing.
+static void gdakiCtrlOnRecord(struct gdakiRecHost* r, int from, const struct gdakiTsMsg& m) {
+  switch (m.type) {
+    case GDAKI_TS_CTRL_STALLED:
+      GIN_TS_NOTE("GIN/RC: rank %d: STALLED(rank %d, incarnation %u) from rank %d mono_ms=%.3f", r->ctx->rank, m.arg,
+                  (uint32_t)m.round, from, gdakiQ4MonoMs());
+      break;
+    case GDAKI_TS_CTRL_DISPUTE:
+      GIN_TS_NOTE("GIN/RC: rank %d: DISPUTE(rank %d, incarnation %u) from rank %d mono_ms=%.3f", r->ctx->rank, m.arg,
+                  (uint32_t)m.round, from, gdakiQ4MonoMs());
+      break;
+    case GDAKI_TS_CTRL_FENCED:  // from the launcher's relay (phase 3): the fence word, and a timing window
+      gdakiLnFenced(r, m.arg, (uint32_t)m.round);
+      gdakiCtrlWindowRequest(r, m.arg, GDAKI_CTRL_WSRC_ENDED);
+      break;
+    case GDAKI_TS_CTRL_PROBE_SETUP:
+      gdakiCtrlProbeSetupRecv(r, from, m);
+      break;
+    default:
+      break;
+  }
+}
