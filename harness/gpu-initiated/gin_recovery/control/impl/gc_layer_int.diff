+static bool gdakiProbeQpIsRts(const struct gdakiProbeQp* q) {
+  return q != nullptr && q->q != nullptr && q->q->qp != nullptr && q->connected && !q->q->err;
+}
+static bool gdakiProbeQpOkInGen(const struct gdakiProbeQp* q) { return gdakiProbeQpIsRts(q) && q->okInGen; }
+static void gdakiProbeQpOnSuccess(struct gdakiProbeQp* q, uint32_t gen) {
+  if (q != nullptr && q->connected && gen == q->gen) q->okInGen = true;  // another generation's completion: ignored
+}
+static void gdakiProbeQpOnError(struct gdakiProbeQp* q) {
+  if (q == nullptr) return;
+  if (q->q != nullptr) q->q->err = true;
+  q->connected = false;
+  q->okInGen = false;
+}
+// QUERY_QP (a firmware command): the QP's state as enum ibv_qp_state, -1 without a QP or on failure. Setup and
+// diagnostics only (a line at the setup, a test); never the watch thread's step (design v3 4.3).
+[[maybe_unused]] static int gdakiProbeQpQueryState(const struct gdakiProbeQp* q) {
+  if (q == nullptr || q->q == nullptr || q->q->qp == nullptr) return -1;
+  struct ibv_qp_attr a;
+  struct ibv_qp_init_attr ia;
+  memset(&a, 0, sizeof(a));
+  memset(&ia, 0, sizeof(ia));
+  return wrap_ibv_query_qp(q->q->qp, &a, IBV_QP_STATE, &ia) == ncclSuccess ? (int)a.qp_state : -1;
+}
+static void gdakiProbeQpDestroy(struct gdakiProbeQp* q) {
+  if (q == nullptr) return;
+  gdakiMiHostQpDestroy(q->q);  // kept (with a WARN) when the QP or its CQ cannot be destroyed
+  *q = gdakiProbeQp();
+}
