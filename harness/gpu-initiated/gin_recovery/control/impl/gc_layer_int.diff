+  GDAKI_CTRL_ST_STATE_OUT = 4, GDAKI_CTRL_ST_RKEYS_IN = 5, GDAKI_CTRL_ST_RKEYS_OUT = 6, GDAKI_CTRL_ST_DONE = 7
