+[[maybe_unused]] static ncclResult_t gdakiCtrlCqCreate(struct gdakiRecHost* r, int depth, bool withChannel,
+                                                      struct gdakiCtrlCq** out, char* why, size_t whyLen) {
+  *out = nullptr;
+  struct gdaki_context* g = r != nullptr ? r->ctx : nullptr;
+  struct ibv_context* ictx = (g != nullptr && g->collComm != nullptr) ? g->collComm->ib.context : nullptr;
+  if (ictx == nullptr || depth < 1) {
+    snprintf(why, whyLen, "no GIN context for a CQ (depth %d)", depth);
+    return ncclInternalError;
+  }
+  struct gdakiCtrlCq* c = new gdakiCtrlCq();
+  (void)ncclIbStatsInit(&c->stats);
+  if (withChannel && wrap_ibv_create_comp_channel(&c->channel, ictx) != ncclSuccess) {
+    delete c;
+    snprintf(why, whyLen, "cannot create a completion channel");
+    return ncclSystemError;
