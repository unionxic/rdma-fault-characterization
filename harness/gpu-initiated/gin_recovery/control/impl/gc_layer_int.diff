+  struct gdakiTsMsg ack;           // the REJOIN_ACK taken (its nrp: the survivor's endpoints)
+  // the survivor
+  bool parked = false;
+  double parkedMs = 0;
+  struct gdakiTsMsg park;          // the REJOIN parked for the hold's acceptance (gdakiCtrlRjParkedTake)
+  bool accStarted = false;         // its pairings were TAKEn (gdakiCtrlRjAcceptStep), for (accInc, accGen)
+  bool accProbeAsked = false;      // the liveness READ QP's CONNECT of this try is with the watch thread
+  uint32_t accInc = 0, accGen = 0;
+  uint64_t accAnswered = 0;        // the liveness READ QP link's answers before its CONNECT was asked
+  // REVIEW_INT3 F3: the record QP TAKEn for the REJOIN of (accInc, accGen) from the spare's (accRecQpn, accRecPsn): kept
+  // through a failed acceptance (the spare's record QP may be connected to it already); the same REJOIN again goes on
+  // from the liveness READ QP's step. That step's transient part (the watch thread takes the CONNECT, the CONNECT works)
+  // gets GDAKI_CTRL_RJ_ACC_TRIES tries GDAKI_CTRL_RJ_RESEND_MS / GDAKI_CTRL_RJ_ACC_TRIES apart; after the last its
+  // pairing goes back to accPrbWas (a later REJOIN takes it again).
