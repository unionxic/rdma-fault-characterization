+// The launcher's consumed word c (its 32-bit count of gen's messages) as an ackIn: a count of this generation's SENDs
+// (never above seqOut), never back (the launcher's window as gdakiCtrlRingLearnConsumed's for a rank); another
+// generation's word is ignored.
+static inline uint64_t gdakiCtrlLaLearnAck(uint32_t gen, uint64_t seqOut, uint64_t ackIn, uint64_t word) {
+  if ((uint32_t)(word >> 32) != gen) return ackIn;
+  const uint32_t behind = (uint32_t)seqOut - (uint32_t)word;
+  if ((uint64_t)behind > seqOut) return ackIn;
+  const uint64_t c = seqOut - behind;
+  return c > ackIn ? c : ackIn;
+}
+// The credit READ is due: something waits past the shut window (seqOut - ackIn = the launcher's RQ), none in flight,
+// the last one at least GDAKI_CTRL_CREDIT_READ_MS ago.
+static inline bool gdakiCtrlLaCreditDue(bool pending, bool shut, bool out, double lastMs, double nowMs) {
+  return pending && shut && !out && nowMs - lastMs >= GDAKI_CTRL_CREDIT_READ_MS;
+}
