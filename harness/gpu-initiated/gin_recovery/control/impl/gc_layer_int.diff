+// One per launcher li of the communicator (the all-gather's, node order; index li = the page's rxConsumedL[li]). The
+// launcher's verbs transport is its peer: envelope kind LAUNCHER + the 256 B launcher message, seq from 1 per (QP,
+// direction, generation), ackSeq = how many of the other side's messages this side consumed; the launcher posts 64 RECVs
+// and reposts at once (launcher_transport_verbs.c GL_V_RQ), so this side sends while seq - its ackSeq < 64 and queues
+// past that. The launcher's datagrams (PAIR, PAIR_ACK) and messages wait in laIn until the launcher link's step takes them
+// (gdakiCtrlLauncherStep: never inside the CQ loop, never under the link's mutex). The activation blob has its own
+// REMOTE_READ slot (the launcher READs it on this QP while the outbox halves stay 2b's: REVIEW_P3 2a-2와 합칠 때 8).
+#define GDAKI_CTRL_LA_RQ 64u               // RECVs per launcher record QP (the launcher's GL_V_RQ window)
+#define GDAKI_CTRL_LA_SQ 32u               // send slots per launcher record QP
+#define GDAKI_CTRL_LA_FRAME_BYTES 512u     // one RECV or send slot: the 64 B envelope + 256 B message, rounded
+#define GDAKI_CTRL_LA_PEND_MAX 256u        // messages queued past the launcher's window
+#define GDAKI_CTRL_LA_IN_MAX 512u          // launcher datagrams and messages waiting for the link's step
+#define GDAKI_CTRL_LA_BLOB_BYTES 65536u    // the activation blob's slot (launcher_msg.h GL_U_MAX_PAYLOAD)
+#define GDAKI_CTRL_LA_BEAT_MS 50.0         // the launcher page's beat READ, at most this often (its beat: every 10 ms)
+#define GDAKI_CTRL_WR_LA_PEER 0xf00u       // a work request's `peer` of launcher li: GDAKI_CTRL_WR_LA_PEER + li
+struct gdakiCtrlRdmaLa {
+  struct gdakiMiHostQp* q = nullptr;       // the record QP to the launcher (the helper's CQ)
+  uint32_t gen = 0;                        // the pairing's generation the QP is of (its envelopes' gen)
+  bool connected = false, err = false, errTaken = true;
+  uint64_t seqOut = 0, ackIn = 0, seqIn = 0;  // sent in gen; the launcher's consumed count of them; taken from it in gen
+  uint32_t sBusy = 0;                      // send slots in flight (a bit each)
+  std::deque<std::vector<uint8_t>> pend;   // 256 B messages past the window
+  struct gdakiCtrlEndpoint ud;             // the launcher's UD QP (its Q_Key in qkey)
+  uint32_t qkey = 0;
+  bool haveUd = false;
+  struct ibv_ah* ah = nullptr;
+  bool beatOut = false, beatOk = false;    // the beat READ in flight; its last completion succeeded
+  uint32_t beatLen = 0;                    // the bytes the last beat READ asked for (16, or the pull's 2048)
+  uint64_t beatDone = 0;                   // READ completions (any status)
+  double beatPostMs = -1e18;
