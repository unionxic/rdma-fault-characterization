+// ---- gin-control (page): pure functions (begin; impl/gc_unit_p1.cc compiles this region on the CPU) ----
+// The pieces of phase 1's judgement that are not the table: the window end's W value, the activation gate, the
+// confirmation window's width and its clock, the liveness READ's slots, completion classes and wr_id, the stall
+// definition, the partition guard, the R, L and W inputs, the fence word's step and the verdict mailbox. No host state,
+// no verbs. The table (gdakiCtrlJudge), the window's verdict (gdakiCtrlConfirmVerdict) and the fence report names
+// (gdakiLnFenceOf, gdakiLnFenceName) are impl/rs_ctrl_api.h's.
+
+// A confirm verdict (GDAKI_CTRL_CW_*) as the window-end W value (the header asserts W_END_ALIVE + verdict).
+static inline uint32_t gdakiCtrlWofConfirm(uint32_t cw) {
+  return cw <= GDAKI_CTRL_CW_UNCONFIRMED ? GDAKI_CTRL_W_END_ALIVE + cw : GDAKI_CTRL_W_END_UNCONFIRMED;
+}
+// The activation gate's verdict (EXPERIMENT.md 9.4, 3절 gate_fenced; design 4.4): a launcher-paired context requires the
+// buddy's fence word = dead + 1 (FENCED), else the /proc verdict (gdakiRsActExamine's GDAKI_RS_ACT_GO/WAIT).
+static inline int gdakiCtrlActGate(bool launcherPaired, bool fenced, int procVerdict) {
+  if (launcherPaired) return fenced ? GDAKI_RS_ACT_GO : GDAKI_RS_ACT_WAIT;
+  return procVerdict;
+}
+// The width the margin rule gives from the fault-free watch-beat gap max (ms), clamped to [CONFIRM_MS_MIN, 50]: a report
+// (the probe summary), never the W in use.
+static inline int gdakiCtrlConfirmW(int factor, double gapMaxMs) {
+  double w = (double)factor * gapMaxMs;
+  if (w < (double)GDAKI_CTRL_CONFIRM_MS_MIN) w = (double)GDAKI_CTRL_CONFIRM_MS_MIN;
+  if (w > 50.0) w = 50.0;
+  return (int)(w + 0.5);
+}
+// The stall definition (design 3.4). The stall length is measured between this reader's own two successful READs: on each
+// successful READ with value `beat` at `nowMs`, if the gap since the last successful READ exceeded 2 x probeMs (the
+// reader itself stalled, or READs failed in between) the origin is reset to now; a beat ahead of the last one (the
+// wrapping compare) resets it too; else the stall is now - origin. *rose: the beat advanced since the last READ.
+struct gdakiCtrlStale {
+  uint64_t val = 0;
+  double firstMs = 0, lastMs = 0;
+  bool have = false;
+};
+static inline double gdakiCtrlStaleOnRead(struct gdakiCtrlStale* s, uint64_t beat, double nowMs, double probeMs,
+                                          bool* rose = nullptr) {
+  const bool adv = s->have && gdakiCtrlBeatAdvanced(s->val, beat);
+  if (rose != nullptr) *rose = adv;
+  if (s->have && (nowMs - s->lastMs) > 2.0 * probeMs) s->firstMs = nowMs;  // the reader's own gap: reset the origin
+  if (!s->have || beat != s->val) {
+    s->val = beat;
+    s->firstMs = nowMs;
+  }
+  s->have = true;
+  s->lastMs = nowMs;
+  return nowMs - s->firstMs;
+}
+// The partition guard's threshold (design 3.4): every value at least STALL_MS - 2 x probeMs.
+static inline bool gdakiCtrlStallGuard(const double* otherStaleMs, int nOthers, double stallMs, double probeMs) {
+  const double bar = stallMs - 2.0 * probeMs;
+  for (int i = 0; i < nOthers; i++)
+    if (otherStaleMs[i] < bar) return false;
+  return true;
+}
+// The partition guard (design v3 3.4; REVIEW_P12 막는 문제 3). For a stall of peer p this rank compares what the OTHER
+// survivors k report about p (k's page word staleMs[p], from this rank's last successful READ of k's page) with the bar:
+// valid[k] says that READ is recent (within 3 x PROBE_MS) and k itself is not stale to this rank. PASS: every valid k
+// sees p stale too. FRESH: some survivor sees p's beat fresh (this rank's view is not the peer's stall). SELF: no other
+// survivor can be read: this rank, alone in seeing everyone stale, suspects itself and does not judge. With no other
+// survivor at all (two ranks) there is no third view: PASS, the stall rests on this rank's view alone (a line for the
+// design, notes_fix12.md).
+// A view below 0 is "k never saw p" (gdakiCtrlStaleOfWord): not a view, never FRESH (REVIEW_FIX12_P2B 고칠 것 2).
+enum : uint32_t { GDAKI_CTRL_PG_PASS = 0, GDAKI_CTRL_PG_FRESH = 1, GDAKI_CTRL_PG_SELF = 2 };
+static inline uint32_t gdakiCtrlPartitionGuard(const double* otherStaleOfP, const bool* valid, int nOthers, double stallMs,
+                                               double probeMs) {
+  if (nOthers <= 0) return GDAKI_CTRL_PG_PASS;
+  int nValid = 0;
+  for (int k = 0; k < nOthers; k++) {
+    if (!valid[k] || otherStaleOfP[k] < 0) continue;
+    nValid++;
+    if (!gdakiCtrlStallGuard(&otherStaleOfP[k], 1, stallMs, probeMs)) return GDAKI_CTRL_PG_FRESH;
+  }
+  return nValid == 0 ? GDAKI_CTRL_PG_SELF : GDAKI_CTRL_PG_PASS;
+}
+// The page word staleMs[q]: this rank's view of q in ms, or GDAKI_CTRL_STALE_UNSEEN when it has no successful READ of q
+// in the QP's pairing (0 is "fresh", never "unknown").
+#define GDAKI_CTRL_STALE_UNSEEN 0xffffffffffffffffull
+static inline uint64_t gdakiCtrlStaleWord(bool seen, double ms) {
+  if (!seen) return GDAKI_CTRL_STALE_UNSEEN;
+  return ms <= 0 ? 0 : ms >= 1e18 ? GDAKI_CTRL_STALE_UNSEEN - 1u : (uint64_t)ms;
+}
+static inline double gdakiCtrlStaleOfWord(uint64_t w) { return w == GDAKI_CTRL_STALE_UNSEEN ? -1.0 : (double)w; }
+// ---- the device progress line (live; user decision 2026-10-22: the liveness a peer reads must be the GPU's own) ----
+// One READ of a peer's line (impl/rs_ctrl_api.h devLine: the GIN context 0's device QP array, one element of `stride`
+// bytes per peer QP) gives, per element, the GPU's post index (sq_rsvd_index at offPosted) and its poll index
+// (cq_sq.cqe_ci at offPolled, in the same WQE index space: the window [cqe_ci, sq_rsvd_index) is posted and not yet seen
+// complete by a GPU poll). posted, polled: their sums; pending: the sum of the windows.
+struct gdakiCtrlDevSum {
+  uint64_t posted = 0, polled = 0, pending = 0;
+};
+static inline struct gdakiCtrlDevSum gdakiCtrlDevSumOf(const uint8_t* line, uint32_t bytes, uint32_t stride,
+                                                       uint32_t offPosted, uint32_t offPolled) {
+  struct gdakiCtrlDevSum d;
+  if (line == nullptr || stride < 8u || offPosted + 8u > stride || offPolled + 8u > stride) return d;
+  for (uint32_t o = 0; o + stride <= bytes; o += stride) {
+    uint64_t a = 0, c = 0;
+    memcpy(&a, line + o + offPosted, 8);
+    memcpy(&c, line + o + offPolled, 8);
+    d.posted += a;
+    d.polled += c;
+    if (a > c) d.pending += a - c;
+  }
+  return d;
+}
+// The value the stall clock keeps for a line: any change of either sum changes it (a recovery's rebase too).
+static inline uint64_t gdakiCtrlDevValue(const struct gdakiCtrlDevSum& d) {
+  return d.posted * 0x9E3779B97F4A7C15ull + d.polled;
+}
+// The GPU's stall clock (the design 3.4 stall definition over the device line, between this reader's own two successful
+// READs of it): a changed line resets the origin (*rose), and so does a quiet one (*quiet: nothing pending, the GPU has
+// seen every WQE it posted complete: a compute phase without sends, a finished kernel, the time before the first kernel
+// is not a GPU stall). Returns the GPU's stall in ms.
+static inline double gdakiCtrlDevOnRead(struct gdakiCtrlStale* s, const struct gdakiCtrlDevSum& d, double nowMs,
+                                        double probeMs, bool* rose = nullptr, bool* quiet = nullptr) {
+  const uint64_t v = gdakiCtrlDevValue(d);
+  const bool changed = s->have && v != s->val;
+  double st = gdakiCtrlStaleOnRead(s, v, nowMs, probeMs);
+  if (d.pending == 0) {
+    s->firstMs = nowMs;
+    st = 0;
+  }
+  if (rose != nullptr) *rose = changed;
+  if (quiet != nullptr) *quiet = d.pending == 0;
+  return st;
+}
+// The R value of one beat from a reader's facts (vetoClear = no data-path progress of the peer within STALL_RMSN_MS;
+// guardOk = the partition guard passed; helper = this is the helperBeat, not the watchBeat). A rising beat is (1); a
+// helper beat below SUSPECT_MS is (1) too. The veto is the watch beat's only (design v3 4.2 R (4), (5)): R (8), (9) are
+// the guard alone, so a helper-only stall reaches row 15 while the GPU still sends (REVIEW_FIX12_P2B 막는 문제 3).
+static inline uint32_t gdakiCtrlRofStale(bool rose, double staleMs, double suspectMs, double stallMs, bool guardOk,
+                                         bool vetoClear, bool helper) {
+  if (rose) return GDAKI_CTRL_R_ROSE;
+  if (staleMs < suspectMs) return helper ? GDAKI_CTRL_R_ROSE : GDAKI_CTRL_R_STALE_LT_SUSPECT;
+  if (staleMs < stallMs) return helper ? GDAKI_CTRL_R_HELPER_SUSPECT : GDAKI_CTRL_R_STALE_SUSPECT;
+  if (!guardOk || (!helper && !vetoClear)) return helper ? GDAKI_CTRL_R_HELPER_GUARDED : GDAKI_CTRL_R_STALE_GUARDED;
+  return helper ? GDAKI_CTRL_R_HELPER_STALL : GDAKI_CTRL_R_STALL;
+}
+
+// ---- the liveness READ's completion classes (REVIEW_P12 막는 문제 5; design v3 4.2 R (10), (11), 4.3 floor rule) ----
+// The status codes are enum ibv_wc_status's (the live code below asserts each equals its IBV_WC_*). Only a retry-exceeded
+// completion (the data QP's 3.5-3.8 s) is "the hardware does not answer"; a remote access error is REMACC; a flush, a
+// local error or a remote operation error says this rank's probe QP is broken (re-pair it) and never feeds rows 10-12.
+enum : int {
+  GDAKI_CTRL_WC_SUCCESS = 0, GDAKI_CTRL_WC_LOC_LEN_ERR = 1, GDAKI_CTRL_WC_LOC_QP_OP_ERR = 2, GDAKI_CTRL_WC_LOC_PROT_ERR = 4,
+  GDAKI_CTRL_WC_WR_FLUSH_ERR = 5, GDAKI_CTRL_WC_REM_ACCESS_ERR = 10, GDAKI_CTRL_WC_REM_OP_ERR = 11,
+  GDAKI_CTRL_WC_RETRY_EXC_ERR = 12, GDAKI_CTRL_WC_RNR_RETRY_EXC_ERR = 13,
+};
+enum : uint32_t { GDAKI_CTRL_CQ_OK = 0, GDAKI_CTRL_CQ_REMACC = 1, GDAKI_CTRL_CQ_NORESP = 2, GDAKI_CTRL_CQ_BROKEN = 3 };
+static inline uint32_t gdakiCtrlProbeCqeClass(int status) {
+  if (status == GDAKI_CTRL_WC_SUCCESS) return GDAKI_CTRL_CQ_OK;
+  if (status == GDAKI_CTRL_WC_RETRY_EXC_ERR || status == GDAKI_CTRL_WC_RNR_RETRY_EXC_ERR) return GDAKI_CTRL_CQ_NORESP;
+  if (status == GDAKI_CTRL_WC_REM_ACCESS_ERR) return GDAKI_CTRL_CQ_REMACC;
+  return GDAKI_CTRL_CQ_BROKEN;
+}
+static inline const char* gdakiCtrlCqClassName(uint32_t c) {
+  switch (c) {
+    case GDAKI_CTRL_CQ_OK: return "ok";
+    case GDAKI_CTRL_CQ_REMACC: return "remote access error";
+    case GDAKI_CTRL_CQ_NORESP: return "retry exceeded (no response)";
+    default: return "probe QP broken (flush or local error)";
+  }
+}
+
+// ---- the liveness READ's wr_id: (kind 4 bits, peer 12, the QP generation's low 16, sequence 32) ----
+// The periodic READ carries its sequence, a window READ the window's number: a completion is matched to what it answers
+// (REVIEW_P12 막는 문제 4), and one of an older QP generation is recognized by its wr_id alone.
+// Live: GDAKI_CTRL_PW_DEV is the periodic pair's second READ (the device progress line), with the page READ's sequence.
+enum : uint32_t { GDAKI_CTRL_PW_PERIODIC = 1, GDAKI_CTRL_PW_WIN1 = 2, GDAKI_CTRL_PW_WIN2 = 3, GDAKI_CTRL_PW_DEV = 4 };
+static inline uint64_t gdakiCtrlProbeWrId(uint32_t kind, uint32_t peer, uint32_t gen, uint32_t seq) {
+  return ((uint64_t)(kind & 0xfu) << 60) | ((uint64_t)(peer & 0xfffu) << 48) | ((uint64_t)(gen & 0xffffu) << 32) | seq;
+}
+static inline uint32_t gdakiCtrlProbeWrKind(uint64_t id) { return (uint32_t)(id >> 60); }
+static inline uint32_t gdakiCtrlProbeWrPeer(uint64_t id) { return (uint32_t)(id >> 48) & 0xfffu; }
+static inline bool gdakiCtrlProbeWrGenIs(uint64_t id, uint32_t gen) { return ((uint32_t)(id >> 32) & 0xffffu) == (gen & 0xffffu); }
+static inline uint32_t gdakiCtrlProbeWrSeq(uint64_t id) { return (uint32_t)id; }
+
+// ---- the liveness READ QP's send queue (design v3 3.4: one periodic READ at a time; REVIEW_P12 막는 문제 4) ----
+// A periodic READ is never posted while one is outstanding: its timeout (PROBE_TIMEOUT_MS) is a report (R (12) once) and
+// the READ stays in flight until its completion, a success or an error (a dead peer's retry exceeded about 3.66 s later
+// is R (11)). The window's two READs take slots of their own; nothing is posted beyond the SQ depth
+// (GDAKI_CTRL_PROBE_SQ): gdakiCtrlProbeCanPost says so and maxOutstanding records the high mark (the model asserts it).
+// Live: the periodic READ is a pair, the page READ and the device line's READ (GDAKI_CTRL_PW_DEV, the same sequence),
+// posted in one step and judged when both completed; the next pair waits for both. The bound: the pair's 2 + the
+// window's 2 = GDAKI_CTRL_PROBE_SQ (4). A peer without a device line keeps the single READ (need 1).
+struct gdakiCtrlProbeIo {
+  uint32_t outstanding = 0;     // READs posted whose completion is not seen yet (every kind)
+  uint32_t maxOutstanding = 0;  // the high mark (never above GDAKI_CTRL_PROBE_SQ)
+  bool periodicOut = false;     // the one periodic READ (live: pair) in flight
+  uint32_t periodicLeft = 0;    // live: READs of the pair in flight not completed yet (1 or 2 at the post)
+  uint32_t maxPeriodicLeft = 0; // live: the high mark of periodicLeft (never above 2)
+  uint32_t periodicSeq = 0;
+  double periodicPostMs = 0;
+  bool timeoutSeen = false;     // its PROBE_TIMEOUT_MS passed (reported once; it stays in flight)
+  uint32_t nextSeq = 1;
+  uint64_t overruns = 0;        // posts refused for want of a slot
+};
+static inline bool gdakiCtrlProbeCanPost(const struct gdakiCtrlProbeIo* io, uint32_t need) {
+  return io->outstanding + need <= GDAKI_CTRL_PROBE_SQ;
+}
+// The periodic READ may go now: none in flight, its period passed, and a slot free beyond the `reserve` slots the open
+// window still needs. Returns the sequence it takes (0: not now).
+// `need`: the READs of one period (live: 2 with the peer's device line, else 1).
+static inline uint32_t gdakiCtrlProbePeriodicDue(struct gdakiCtrlProbeIo* io, double nowMs, double dueMs, uint32_t reserve,
+                                                 uint32_t need = 1) {
+  if (io->periodicOut || nowMs < dueMs) return 0;
+  if (!gdakiCtrlProbeCanPost(io, need + reserve)) {
+    io->overruns++;
+    return 0;
+  }
+  return io->nextSeq == 0 ? (io->nextSeq = 1) : io->nextSeq;
+}
+static inline void gdakiCtrlProbeOnPosted(struct gdakiCtrlProbeIo* io, uint32_t kind, uint32_t seq, double nowMs) {
+  io->outstanding++;
+  if (io->outstanding > io->maxOutstanding) io->maxOutstanding = io->outstanding;
+  if (kind == GDAKI_CTRL_PW_PERIODIC) {
+    io->periodicOut = true;
+    io->periodicLeft = 1;
+    io->periodicSeq = seq;
+    io->periodicPostMs = nowMs;
+    io->timeoutSeen = false;
+    io->nextSeq = seq + 1u;
+  } else if (kind == GDAKI_CTRL_PW_DEV && io->periodicOut && seq == io->periodicSeq) {
+    io->periodicLeft++;  // live: the pair's second READ
+  }
+  if (io->periodicLeft > io->maxPeriodicLeft) io->maxPeriodicLeft = io->periodicLeft;
+}
+// A completion of the periodic READ (live: pair) in flight, before gdakiCtrlProbeOnCqe takes it.
+static inline bool gdakiCtrlProbeIsPeriodic(const struct gdakiCtrlProbeIo* io, uint32_t kind, uint32_t seq) {
+  return (kind == GDAKI_CTRL_PW_PERIODIC || kind == GDAKI_CTRL_PW_DEV) && io->periodicOut && seq == io->periodicSeq;
+}
+// A completion of this QP (any status): its slot is free. True when it completes the periodic READ in flight (live: the
+// pair's last completion; its result is R's); a window READ's or an older READ's completion is not.
+static inline bool gdakiCtrlProbeOnCqe(struct gdakiCtrlProbeIo* io, uint32_t kind, uint32_t seq) {
+  if (io->outstanding > 0) io->outstanding--;
+  if (gdakiCtrlProbeIsPeriodic(io, kind, seq)) {
+    if (io->periodicLeft > 0) io->periodicLeft--;
+    if (io->periodicLeft > 0) return false;
+    io->periodicOut = false;
+    return true;
+  }
+  return false;
+}
+// The periodic READ in flight past PROBE_TIMEOUT_MS: true once (R (12): suspicion and a line; it stays in flight).
+static inline bool gdakiCtrlProbeTimedOut(struct gdakiCtrlProbeIo* io, double nowMs, double timeoutMs) {
+  if (!io->periodicOut || io->timeoutSeen || nowMs - io->periodicPostMs <= timeoutMs) return false;
+  io->timeoutSeen = true;
+  return true;
+}
+// The QP was reset or replaced after its flushes were collected (a re-pairing): nothing it posted is in flight now.
+static inline void gdakiCtrlProbeIoReset(struct gdakiCtrlProbeIo* io) {
+  io->outstanding = 0;
+  io->periodicOut = false;
+  io->periodicLeft = 0;
+  io->timeoutSeen = false;
+}
+
+// ---- the confirmation window's clock (design v3 4.2; REVIEW_P12 막는 문제 1) ----
+// Opened by the helper's witness FIN or RST with no BYE (or, for timing only, by an end report): READ1 of line 0 at t_F,
+// READ2 at t_F + W/2, the verdict at t_F + W (gdakiCtrlConfirmVerdict), whatever the completion times; a completion after
+// the verdict is dropped by the window's number. A window opened while the QP had no success in its generation, or
+// without two free slots, cannot confirm: its verdict comes at once. A new FIN of the same peer while one is open is
+// ignored. REVIEW_FIX12_P2B 막는 문제 1, 2: a remote access error of either READ decides the window (design 4.2's verdict
+// order puts REMACC first): the QP is in ERR after it, so READ2 is not asked for, and losing the QP afterwards (the
+// re-pairing it starts, the flush of READ2) does not undo it; the verdict still comes at t_F + W. One action per call and
+// one call per watch step (POST1, POST2, JUDGE in separate passes); a reader that first steps after t_F + W/2 cannot
+// confirm (never NORESP); the verdict waits until READ2 was out W/2 (max(t_F + W, READ2's post + W/2)), so NORESP is
+// always a READ out W/2 or more without its completion.
+enum : uint32_t { GDAKI_CTRL_WS_IDLE = 0, GDAKI_CTRL_WS_OPEN = 1 };
+enum : uint32_t { GDAKI_CTRL_WSRC_NONE = 0, GDAKI_CTRL_WSRC_FIN = 1, GDAKI_CTRL_WSRC_RST = 2, GDAKI_CTRL_WSRC_ENDED = 3 };
+static inline const char* gdakiCtrlWsrcName(uint32_t s) {
+  return s == GDAKI_CTRL_WSRC_FIN ? "FIN" : s == GDAKI_CTRL_WSRC_RST ? "RST" : s == GDAKI_CTRL_WSRC_ENDED ? "END" : "?";
+}
+struct gdakiCtrlWindow {
+  uint32_t state = GDAKI_CTRL_WS_IDLE;
+  uint32_t no = 0;              // the window's number (in its READs' wr_id)
+  uint32_t src = GDAKI_CTRL_WSRC_NONE;
+  double tF = 0, endMs = 0;
+  bool countable = false;       // the QP RTS with one success in its generation at t_F, the READs posted on it
+  bool r1Posted = false, r2Posted = false, r1Done = false, r2Done = false, remacc = false;
+  uint64_t beat1 = 0, beat2 = 0, inc1 = 0, inc2 = 0;
+  double r1Ms = -1, r2Ms = -1;  // the completion times (reports)
+  double r2PostMs = -1;         // READ2's post (the verdict waits until it was out W/2)
+  bool lateReader = false;      // the reader's first step came after t_F + W/2 (cannot confirm)
+  double lastStepMs = -1, stepGapMaxMs = 0;  // the reader's largest step gap within the window (a report)
+  uint32_t verdict = GDAKI_CTRL_CW_UNCONFIRMED;  // the last window's
+  uint64_t opened = 0, ignored = 0, late = 0;
+};
+// smoke3 (2a-2-C step 5): READ1 and READ2 read line 0's watchBeat, the host's, always: a process's death stops its
+// watch thread at once, while its GPU's progress line kept moving about 100 ms after SIGKILL (results/20261022_smoke3:
+// 9/9 kill windows read "alive"). The device line stays the input of the stall rows (14, 15) only (gdakiCtrlRDerive).
+static inline bool gdakiCtrlWindowOpen(struct gdakiCtrlWindow* w, uint32_t src, double tF, bool countable) {
+  if (w->state == GDAKI_CTRL_WS_OPEN) {
+    w->ignored++;
+    return false;
+  }
+  const uint32_t no = w->no + 1u;
+  const uint64_t opened = w->opened + 1u, ignored = w->ignored, late = w->late;
+  *w = gdakiCtrlWindow();
+  w->no = no;
+  w->opened = opened;
+  w->ignored = ignored;
+  w->late = late;
+  w->state = GDAKI_CTRL_WS_OPEN;
+  w->src = src;
+  w->tF = tF;
+  w->countable = countable;
+  return true;
+}
+enum : uint32_t { GDAKI_CTRL_WA_NONE = 0, GDAKI_CTRL_WA_POST1 = 1, GDAKI_CTRL_WA_POST2 = 2, GDAKI_CTRL_WA_JUDGE = 3 };
+// The verdict's time: t_F + W, or later when READ2 went late (it is out W/2 then).
+static inline double gdakiCtrlWindowJudgeAt(const struct gdakiCtrlWindow* w, double wMs) {
+  const double t = w->tF + wMs;
+  return w->r2Posted && w->r2PostMs + wMs / 2.0 > t ? w->r2PostMs + wMs / 2.0 : t;
+}
+// The window's QP is lost to it (this rank's own re-pairing, the hold start's ERR, a broken completion, a refused post):
+// it cannot confirm, unless a remote access error decided it already.
+static inline void gdakiCtrlWindowQpLost(struct gdakiCtrlWindow* w) {
+  if (w->state == GDAKI_CTRL_WS_OPEN && !w->remacc) w->countable = false;
+}
+// One action per call, in order: READ1 at once (a reader past t_F + W/2 cannot confirm), READ2 from t_F + W/2 unless
+// REMACC decided the window, the verdict at gdakiCtrlWindowJudgeAt (at once when it cannot confirm).
+static inline uint32_t gdakiCtrlWindowStep(struct gdakiCtrlWindow* w, double nowMs, double wMs) {
+  if (w->state != GDAKI_CTRL_WS_OPEN) return GDAKI_CTRL_WA_NONE;
+  if (w->lastStepMs >= 0 && nowMs - w->lastStepMs > w->stepGapMaxMs) w->stepGapMaxMs = nowMs - w->lastStepMs;
+  w->lastStepMs = nowMs;
+  if (!w->countable) return GDAKI_CTRL_WA_JUDGE;
+  if (!w->r1Posted) {
+    if (nowMs <= w->tF + wMs / 2.0) return GDAKI_CTRL_WA_POST1;
+    w->lateReader = true;  // READ1 would have less than W/2: the window cannot confirm (never NORESP)
+    w->countable = false;
+    return GDAKI_CTRL_WA_JUDGE;
+  }
+  if (!w->r2Posted && !w->remacc) return nowMs >= w->tF + wMs / 2.0 ? GDAKI_CTRL_WA_POST2 : GDAKI_CTRL_WA_NONE;
+  return nowMs >= gdakiCtrlWindowJudgeAt(w, wMs) ? GDAKI_CTRL_WA_JUDGE : GDAKI_CTRL_WA_NONE;
+}
+static inline void gdakiCtrlWindowPosted(struct gdakiCtrlWindow* w, uint32_t which, bool ok, double nowMs) {
+  if (which == 1) w->r1Posted = true;
+  else {
+    w->r2Posted = true;
+    w->r2PostMs = nowMs;
+  }
+  if (!ok) gdakiCtrlWindowQpLost(w);  // a READ that could not be posted on the RTS QP: the window cannot confirm
+}
+// A completion of window `no`'s READ `which` (1, 2) of class `cls`; false: not the open window's (dropped).
+static inline bool gdakiCtrlWindowOnCqe(struct gdakiCtrlWindow* w, uint32_t no, uint32_t which, uint32_t cls,
+                                        uint64_t beat, uint64_t inc, double nowMs) {
+  if (w->state != GDAKI_CTRL_WS_OPEN || no != w->no) {
+    w->late++;
+    return false;
+  }
+  if (cls == GDAKI_CTRL_CQ_OK) {
+    if (which == 1) {
+      w->r1Done = true;
+      w->beat1 = beat;
+      w->inc1 = inc;
+      w->r1Ms = nowMs;
+    } else {
+      w->r2Done = true;
+      w->beat2 = beat;
+      w->inc2 = inc;
+      w->r2Ms = nowMs;
+    }
+  } else if (cls == GDAKI_CTRL_CQ_REMACC) {
+    w->remacc = true;
+  } else if (cls == GDAKI_CTRL_CQ_BROKEN) {
+    gdakiCtrlWindowQpLost(w);  // this rank's QP broke (or READ2's flush after REMACC): cannot confirm, never NORESP
+  }  // NORESP: the READ stays not done (NORESP at t_F + W)
+  return true;
+}
+static inline uint32_t gdakiCtrlWindowJudge(struct gdakiCtrlWindow* w, uint64_t incExpected, double nowMs) {
+  w->verdict = gdakiCtrlConfirmVerdict(w->countable, w->remacc, w->r1Done, w->r2Done, incExpected, w->inc1, w->inc2,
+                                       w->beat1, w->beat2);
+  w->state = GDAKI_CTRL_WS_IDLE;
+  w->endMs = nowMs;
+  return w->verdict;
+}
+
+// ---- the handoff of a peer's liveness READ QP between the watch thread and the helper (REVIEW_FIX12_P2B 막는 문제 2,
+// 고칠 것 1, 4, 9) ----
+// The watch thread owns the QP's software state, its posts and its CQ; the helper runs every firmware command
+// (modify_qp, QP create and destroy). A request of the helper's pairing (PREPARE, CONNECT) goes NEW -> (the watch thread
+// plans it: REUSE a QP prepared for this generation and untouched since; RESET one with nothing in flight; DRAIN one
+// with READs in flight) -> ERR (DRAIN: the helper moves it to ERR) -> DRAIN (the watch thread collects the flushes, one
+// poll per step, bounded GDAKI_CTRL_PROBE_DRAIN_MS: then a new QP) -> FW (the helper's firmware; the watch thread does not
+// touch the QP) -> BACK (the watch thread applies the result) -> IDLE. The hold start's ERR cancels a request in progress:
+// it is answered "hold started" and the QP stays in ERR; a CONNECT whose incarnation the lineage no longer calls current
+// is refused too (design 4.4: no RTS toward an old incarnation).
+#define GDAKI_CTRL_PROBE_DRAIN_MS 100.0
+enum : uint32_t {
+  GDAKI_CTRL_PO_NONE = 0,
+  GDAKI_CTRL_PO_PREPARE = 1,  // to INIT for generation `gen` with a fresh PSN (the PAIR's side): ERR, flushes, RESET
+  GDAKI_CTRL_PO_CONNECT = 2,  // RTR, RTS toward `remote` for `gen` (a QP connected before, or prepared for another
+                              // generation, is reset first with a fresh PSN); the peer's page and incNonce with it
+  GDAKI_CTRL_PO_TOERR = 3,    // unused since the hold start's ERR is the helper's own (gdakiProbeToErr)
+};
+enum : uint32_t {
+  GDAKI_CTRL_PH_IDLE = 0, GDAKI_CTRL_PH_NEW = 1, GDAKI_CTRL_PH_ERR = 2, GDAKI_CTRL_PH_DRAIN = 3, GDAKI_CTRL_PH_FW = 4,
+  GDAKI_CTRL_PH_BACK = 5,
+};
+enum : uint32_t { GDAKI_CTRL_PP_REUSE = 0, GDAKI_CTRL_PP_RESET = 1, GDAKI_CTRL_PP_DRAIN = 2 };
+enum : uint32_t {  // the helper's firmware steps (bits), gdakiCtrlProbeFwPlan
+  GDAKI_CTRL_FW_REFUSE_HOLD = 1u, GDAKI_CTRL_FW_REFUSE_LINEAGE = 2u, GDAKI_CTRL_FW_NEWQP = 4u, GDAKI_CTRL_FW_RESET = 8u,
+  GDAKI_CTRL_FW_CONNECT = 16u,
+};
+struct gdakiCtrlProbeHand {
+  uint32_t phase = GDAKI_CTRL_PH_IDLE;
+  uint32_t seq = 0, done = 0;  // the request in progress, the last one answered
+  uint32_t op = 0, gen = 0;    // GDAKI_CTRL_PO_PREPARE or _CONNECT, for generation gen
+  uint32_t plan = GDAKI_CTRL_PP_REUSE;
+  bool cancel = false;         // the hold start's ERR came while it was in progress
+  bool drainOk = true;         // DRAIN: the flushes came within the bound (else a new QP)
+  double drainFromMs = -1;
+  uint64_t drainGiveUps = 0, refusedHold = 0, refusedLineage = 0;
+};
+static inline uint32_t gdakiCtrlProbePlan(uint32_t op, uint32_t gen, bool haveQp, bool connected, bool err,
+                                          uint32_t preparedGen, uint32_t outstanding) {
+  if (haveQp && op == GDAKI_CTRL_PO_CONNECT && !connected && !err && preparedGen != 0 && preparedGen == gen && outstanding == 0)
+    return GDAKI_CTRL_PP_REUSE;
+  return haveQp && outstanding > 0 ? GDAKI_CTRL_PP_DRAIN : GDAKI_CTRL_PP_RESET;
+}
+// The helper's request (0: one is in progress; the caller asks again later).
+static inline uint32_t gdakiCtrlHandAsk(struct gdakiCtrlProbeHand* h, uint32_t op, uint32_t gen) {
+  if (h->phase != GDAKI_CTRL_PH_IDLE) return 0;
+  h->seq = h->done + 1u == 0 ? 1u : h->done + 1u;
+  h->op = op;
+  h->gen = gen;
+  h->cancel = false;
+  h->drainOk = true;
+  h->drainFromMs = -1;
+  h->phase = GDAKI_CTRL_PH_NEW;
+  return h->seq;
+}
+// The watch thread takes a NEW request: true when the QP leaves use (the watch thread marks it not RTS, the open
+// window cannot confirm); the plan says what follows.
+static inline bool gdakiCtrlHandTake(struct gdakiCtrlProbeHand* h, bool haveQp, bool connected, bool err,
+                                     uint32_t preparedGen, uint32_t outstanding) {
+  if (h->phase != GDAKI_CTRL_PH_NEW) return false;
+  h->plan = gdakiCtrlProbePlan(h->op, h->gen, haveQp, connected, err, preparedGen, outstanding);
+  h->phase = h->plan == GDAKI_CTRL_PP_DRAIN ? GDAKI_CTRL_PH_ERR : GDAKI_CTRL_PH_FW;
+  return h->plan != GDAKI_CTRL_PP_REUSE;
+}
+static inline void gdakiCtrlHandErrDone(struct gdakiCtrlProbeHand* h, double nowMs) {  // the helper's ERR is done
+  if (h->phase != GDAKI_CTRL_PH_ERR) return;
+  h->phase = GDAKI_CTRL_PH_DRAIN;
+  h->drainFromMs = nowMs;
+}
+// The watch thread after its poll in DRAIN: 1 the QP passes to the helper (drained, or the bound passed: a new QP then,
+// nothing of the old one completes), 0 not yet.
+static inline int gdakiCtrlHandDrain(struct gdakiCtrlProbeHand* h, uint32_t outstanding, double nowMs) {
+  if (h->phase != GDAKI_CTRL_PH_DRAIN) return 0;
+  if (outstanding > 0 && nowMs - h->drainFromMs <= GDAKI_CTRL_PROBE_DRAIN_MS) return 0;
+  h->drainOk = outstanding == 0;
+  if (!h->drainOk) h->drainGiveUps++;
+  h->phase = GDAKI_CTRL_PH_FW;
+  return 1;
+}
+// A refusal keeps the QP out of RTS (ERR); one whose drain gave up is replaced still (its lost flushes never complete).
+static inline uint32_t gdakiCtrlProbeFwPlan(const struct gdakiCtrlProbeHand* h, bool haveQp, bool lnCurrent) {
+  const uint32_t newQp = !h->drainOk ? GDAKI_CTRL_FW_NEWQP : 0u;
+  if (h->cancel) return GDAKI_CTRL_FW_REFUSE_HOLD | newQp;
+  if (h->op == GDAKI_CTRL_PO_CONNECT && !lnCurrent) return GDAKI_CTRL_FW_REFUSE_LINEAGE | newQp;
+  uint32_t s = newQp;
+  if (!haveQp) s |= GDAKI_CTRL_FW_NEWQP;
+  if (h->plan != GDAKI_CTRL_PP_REUSE || (s & GDAKI_CTRL_FW_NEWQP)) s |= GDAKI_CTRL_FW_RESET;
+  if (h->op == GDAKI_CTRL_PO_CONNECT) s |= GDAKI_CTRL_FW_CONNECT;
+  return s;
+}
+static inline void gdakiCtrlHandFwDone(struct gdakiCtrlProbeHand* h) {
+  if (h->phase == GDAKI_CTRL_PH_FW) h->phase = GDAKI_CTRL_PH_BACK;
+}
+static inline void gdakiCtrlHandBack(struct gdakiCtrlProbeHand* h) {
+  if (h->phase != GDAKI_CTRL_PH_BACK) return;
+  h->done = h->seq;
+  h->phase = GDAKI_CTRL_PH_IDLE;
+}
+static inline bool gdakiCtrlHandWatchOwns(const struct gdakiCtrlProbeHand* h) { return h->phase != GDAKI_CTRL_PH_FW; }
+static inline void gdakiCtrlHandCancel(struct gdakiCtrlProbeHand* h) {  // the hold start's ERR
+  if (h->phase != GDAKI_CTRL_PH_IDLE && h->phase != GDAKI_CTRL_PH_BACK) h->cancel = true;
+}
+
+// ---- the helper's busy word as this reader sees it (design v3 3.1: the bound on the reader's own clock) ----
+struct gdakiCtrlBusySeen {
+  uint32_t no = 0;        // the busy number last seen (0: not busy)
+  double firstMs = 0;     // when this reader first saw it
+  uint32_t boundMs = 0;
+};
+enum : uint32_t { GDAKI_CTRL_BZ_NONE = 0, GDAKI_CTRL_BZ_IN = 1, GDAKI_CTRL_BZ_OVER = 2 };
+// *overMs: with BZ_OVER, how long ago the bound ended (the helper stall counts from there, design 4.2 row 18).
+static inline uint32_t gdakiCtrlBusySeenAt(const struct gdakiCtrlBusySeen* s, double nowMs, double* overMs) {
+  *overMs = 0;
+  if (s->no == 0) return GDAKI_CTRL_BZ_NONE;
+  const double end = s->firstMs + (double)s->boundMs;
+  if (nowMs <= end) return GDAKI_CTRL_BZ_IN;
+  *overMs = nowMs - end;
+  return GDAKI_CTRL_BZ_OVER;
+}
+// A READ's busy word at `nowMs`: a new number starts the bound on this reader's clock.
+static inline uint32_t gdakiCtrlBusySeenStep(struct gdakiCtrlBusySeen* s, uint64_t word, double nowMs, double* overMs) {
+  const uint32_t no = gdakiCtrlBusyNoOf(word);
+  if (no == 0) s->no = 0;
+  else if (no != s->no) {
+    s->no = no;
+    s->firstMs = nowMs;
+    s->boundMs = gdakiCtrlBusyBoundOf(word);
+  }
+  return gdakiCtrlBusySeenAt(s, nowMs, overMs);
+}
+
+// ---- R, L and W (design v3 4.2; REVIEW_P12 고칠 것 1, 2) ----
+// R from what this reader knows of peer p. The order (written into notes_fix12.md for the design): PROBE_MS = 0 is (13);
+// the last periodic READ's error class next: REMACC (10), retry exceeded (11), a broken probe QP (13, never 10-12); a
+// periodic READ in flight past its timeout (12); no success in this QP generation, or a page of another process (13);
+// then the watch beat: not risen is (2)-(5); risen: the helper side, busy within its bound (6), stale (7)-(9), a helper
+// beat below SUSPECT_MS (1). The helper stall counts from the busy bound's end when a busy number was seen.
+// Live (devMode: the peer's page names a device line; user decision 2026-10-22): after the same READ facts, a device line
+// not read yet in this QP generation is (13); then the two inputs side by side: the GPU's stall (the device line,
+// gdakiCtrlDevOnRead) gives (3)-(5) from SUSPECT_MS (with the partition guard and the data path's veto, as the watch beat
+// had); the host's stall (the watch beat, and the helper beat after its busy bound) gives (6)-(9) (the guard alone). The
+// more severe wins in the table's order: (5) row 14, (9) row 15, a GPU suspicion (3), (4), a host one (7), (8), busy (6);
+// else (2) when the GPU line is unchanged below SUSPECT_MS, (1) when it is fresh. So a GPU stalled under a live host is
+// row 14, a host stalled under a GPU that progresses (or is quiet) is row 15, both stalled is row 14, both alive row 20.
+struct gdakiCtrlRFacts {
+  bool probeOff = false;
+  uint32_t lastCls = GDAKI_CTRL_CQ_OK;  // the last completed periodic READ's class
+  bool timedOut = false;                // the periodic READ in flight past PROBE_TIMEOUT_MS
+  bool okInGen = false;                 // the QP RTS with one success in its generation
+  bool pageOk = true;                   // the last successful READ's incNonce is the expected one
+  bool watchRose = false;
+  double watchStaleMs = 0;
+  uint32_t busy = GDAKI_CTRL_BZ_NONE;
+  double busyOverMs = 0;
+  double helperStaleMs = 0;
+  bool guardOk = true, vetoClear = true;
+  double suspectMs = GDAKI_CTRL_SUSPECT_MS_DEFAULT, stallMs = GDAKI_CTRL_STALL_MS_DEFAULT;
+  bool devMode = false;                 // live: the peer's page names a device line (else the watch beat is R (2)-(5))
+  bool devOk = false;                   // live: a device line READ succeeded in this QP generation
+  double devStaleMs = 0;                // live: the GPU's stall (gdakiCtrlDevOnRead; 0 when changed or quiet)
+};
+static inline uint32_t gdakiCtrlRDerive(const struct gdakiCtrlRFacts& f) {
+  if (f.probeOff) return GDAKI_CTRL_R_UNCONFIRMED;
+  if (f.lastCls == GDAKI_CTRL_CQ_REMACC) return GDAKI_CTRL_R_REMACC;
+  if (f.lastCls == GDAKI_CTRL_CQ_NORESP) return GDAKI_CTRL_R_HW_NORESP;
+  if (f.lastCls == GDAKI_CTRL_CQ_BROKEN) return GDAKI_CTRL_R_UNCONFIRMED;
+  if (f.timedOut) return GDAKI_CTRL_R_TIMEOUT_ONLY;
+  if (!f.okInGen || !f.pageOk) return GDAKI_CTRL_R_UNCONFIRMED;
+  if (f.devMode) {  // live: the GPU's line and the host's beats
+    if (!f.devOk) return GDAKI_CTRL_R_UNCONFIRMED;
+    const uint32_t none = GDAKI_CTRL_R_N;
+    const uint32_t rd = f.devStaleMs >= f.suspectMs
+                            ? gdakiCtrlRofStale(false, f.devStaleMs, f.suspectMs, f.stallMs, f.guardOk, f.vetoClear, false)
+                            : none;
+    double hs = f.helperStaleMs;
+    if (f.busy == GDAKI_CTRL_BZ_OVER && f.busyOverMs < hs) hs = f.busyOverMs;
+    uint32_t rh;
+    if (f.watchStaleMs >= f.suspectMs)  // the watch thread itself: no busy bound excuses it
+      rh = gdakiCtrlRofStale(false, std::max(f.watchStaleMs, hs), f.suspectMs, f.stallMs, f.guardOk, true, true);
+    else if (f.busy == GDAKI_CTRL_BZ_IN)
+      rh = GDAKI_CTRL_R_HELPER_BUSY;
+    else
+      rh = gdakiCtrlRofStale(false, hs, f.suspectMs, f.stallMs, f.guardOk, true, true);
+    if (rd == GDAKI_CTRL_R_STALL) return rd;
+    if (rh == GDAKI_CTRL_R_HELPER_STALL) return rh;
+    if (rd != none) return rd;
+    if (rh != GDAKI_CTRL_R_ROSE) return rh;
+    return f.devStaleMs > 0 ? GDAKI_CTRL_R_STALE_LT_SUSPECT : GDAKI_CTRL_R_ROSE;
+  }
+  if (!f.watchRose)
+    return gdakiCtrlRofStale(false, f.watchStaleMs, f.suspectMs, f.stallMs, f.guardOk, f.vetoClear, false);
+  if (f.busy == GDAKI_CTRL_BZ_IN) return GDAKI_CTRL_R_HELPER_BUSY;
+  double hs = f.helperStaleMs;
+  if (f.busy == GDAKI_CTRL_BZ_OVER && f.busyOverMs < hs) hs = f.busyOverMs;
+  return gdakiCtrlRofStale(false, hs, f.suspectMs, f.stallMs, f.guardOk, f.vetoClear, true);
+}
+// L (design v3 4.2): the launcher's words and messages. Without the launcher pairing L is 무응답 by definition, so every
+// R (11) is row 10; rows 10-12 carry no reaction (report only; REVIEW_P12 고칠 것 2). Phase 3 gives LEFT and the end
+// (gdakiCtrlLaLInputs, REVIEW_P3 고칠 것 1); 2a-2-C step 4 gives pullOk and the registration word from the launcher
+// page's pull (gdakiCtrlLaPullInputs, gdakiCtrlLaPageRegOf): a word that is not (ALIVE, p, i) is "no information".
+static inline uint32_t gdakiCtrlLOf(bool launcherPaired, bool leftSeen, bool endedSeen, bool pullOk, bool regAlive,
+                                    bool regLeft) {
+  if (leftSeen || (pullOk && regLeft)) return GDAKI_CTRL_L_LEFT;
+  if (endedSeen) return GDAKI_CTRL_L_ENDED;
+  if (!launcherPaired || !pullOk) return GDAKI_CTRL_L_NORESP;
+  return regAlive ? GDAKI_CTRL_L_ALIVE : GDAKI_CTRL_L_NOINFO;
+}
+// W: an open window; the verdict of the window that ends now; the witness off; a spent FIN or RST (the witness is
+// unknown until a new pairing); else normal.
+static inline uint32_t gdakiCtrlWOf(bool witnessOn, bool windowOpen, bool windowEnds, uint32_t endVerdict,
+                                    bool witnessUnknown) {
+  if (windowOpen) return GDAKI_CTRL_W_OPEN;
+  if (windowEnds) return gdakiCtrlWofConfirm(endVerdict);
+  if (!witnessOn) return GDAKI_CTRL_W_OFF;
+  return witnessUnknown ? GDAKI_CTRL_W_UNKNOWN : GDAKI_CTRL_W_OK;
+}
