+// ---- gin-control (ring): libibverbs lookups (begin; impl/gc_unit_p2a2.cc puts its fake verbs in place of this) ----
+// ibv_create_ah, ibv_destroy_ah, ibv_get_cq_event and ibv_ack_cq_events have no wrapper in ibvwrap.h (and this layer
+// changes the host file only): looked up in the libibverbs NCCL already loaded (RTLD_NOLOAD), once. Phase 2a-2:
+// ibv_is_fork_initialized too (optional: missing, the setup's fork field is 0xff and Resume's condition 43 holds).
+struct gdakiCtrlVerbs {
+  bool tried = false, ok = false;
+  struct ibv_ah* (*createAh)(struct ibv_pd*, struct ibv_ah_attr*) = nullptr;
+  int (*destroyAh)(struct ibv_ah*) = nullptr;
+  int (*getCqEvent)(struct ibv_comp_channel*, struct ibv_cq**, void**) = nullptr;
+  void (*ackCqEvents)(struct ibv_cq*, unsigned int) = nullptr;
+  int (*isForkInit)(void) = nullptr;  // enum ibv_fork_status ibv_is_fork_initialized(void)
+  struct ibv_comp_channel* (*createChannel)(struct ibv_context*) = nullptr;
+  int (*destroyChannel)(struct ibv_comp_channel*) = nullptr;
+};
+static const struct gdakiCtrlVerbs* gdakiCtrlVerbsOf() {
+  static std::mutex mu;
+  static struct gdakiCtrlVerbs v;
+  std::lock_guard<std::mutex> lk(mu);
+  if (v.tried) return &v;
+  v.tried = true;
+  const char* names[] = {"libibverbs.so.1", "libibverbs.so"};  // REVIEW_P12 nit 14: no NCCL_IBVERBS_LIB (not NCCL's)
+  for (const char* n : names) {
+    if (n == nullptr) continue;
+    void* h = dlopen(n, RTLD_NOW | RTLD_NOLOAD);
+    if (h == nullptr) continue;
+    v.createAh = (struct ibv_ah * (*)(struct ibv_pd*, struct ibv_ah_attr*)) dlsym(h, "ibv_create_ah");
+    v.destroyAh = (int (*)(struct ibv_ah*))dlsym(h, "ibv_destroy_ah");
+    v.getCqEvent = (int (*)(struct ibv_comp_channel*, struct ibv_cq**, void**))dlsym(h, "ibv_get_cq_event");
+    v.ackCqEvents = (void (*)(struct ibv_cq*, unsigned int))dlsym(h, "ibv_ack_cq_events");
+    v.isForkInit = (int (*)(void))dlsym(h, "ibv_is_fork_initialized");
+    v.createChannel = (struct ibv_comp_channel * (*)(struct ibv_context*)) dlsym(h, "ibv_create_comp_channel");
+    v.destroyChannel = (int (*)(struct ibv_comp_channel*))dlsym(h, "ibv_destroy_comp_channel");
+    v.ok = v.createAh != nullptr && v.destroyAh != nullptr && v.getCqEvent != nullptr && v.ackCqEvents != nullptr &&
+           v.createChannel != nullptr && v.destroyChannel != nullptr;
+    if (v.ok) break;
+  }
+  return &v;
+}
+static ncclResult_t gdakiCtrlChannelCreate(struct ibv_comp_channel** out, struct ibv_context* ictx) {
+  const struct gdakiCtrlVerbs* v = gdakiCtrlVerbsOf();
+  *out = v->createChannel != nullptr ? v->createChannel(ictx) : nullptr;
+  return *out != nullptr ? ncclSuccess : ncclSystemError;
+}
+static void gdakiCtrlChannelDestroy(struct ibv_comp_channel* ch) {
+  const struct gdakiCtrlVerbs* v = gdakiCtrlVerbsOf();
+  if (ch != nullptr && v->destroyChannel != nullptr) (void)v->destroyChannel(ch);
+}
