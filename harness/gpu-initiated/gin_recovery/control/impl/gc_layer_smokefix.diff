+// Smoke fix 2: the communicator's teardown asks the watch thread for the summary (it owns the counters and the latency
+// vector) and waits up to 500 ms; a watch thread that does not step by then is not running, and the teardown writes it.
+static void gdakiCtrlProbeSummaryAtTeardown(struct gdakiRecHost* r) {
+  struct gdakiCtrlPage* pg = gdakiPageOf(r);
+  if (pg == nullptr || !gdakiPageUp(pg)) return;
+  int want = 0;
+  if (!pg->sumReq.compare_exchange_strong(want, 1, std::memory_order_acq_rel)) return;
+  const double t0 = gdakiQ4MonoMs();
+  while (pg->sumReq.load(std::memory_order_acquire) == 1 && gdakiQ4MonoMs() - t0 < 500.0)
+    std::this_thread::sleep_for(std::chrono::milliseconds(1));
+  want = 1;
+  if (pg->sumReq.compare_exchange_strong(want, 4, std::memory_order_acq_rel)) {
+    gdakiCtrlProbeSummary(r, pg);
+    pg->sumReq.store(2, std::memory_order_release);
+    return;
+  }
+  while (pg->sumReq.load(std::memory_order_acquire) == 4 && gdakiQ4MonoMs() - t0 < 1000.0)
+    std::this_thread::sleep_for(std::chrono::milliseconds(1));
+}
