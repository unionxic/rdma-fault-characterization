+// ---- the hooks (phase 1's real bodies; they replace the preparation stage's placeholders) ----
+// The buddy's activation fence gate (design 4.4; REVIEW_PREP main-list fix 9). Phase 1 fills the frame the prep-fix
+// agent calls from gdakiHoldActivateDecide's #if !NCCL_GIN_CTRL_TCP branch (bound at integration; see notes). A
+// launcher-paired context requires the fence word = dead + 1; phase 1 has no launcher, so this is true and the /proc
+// gate stands (gate_fenced).
+[[maybe_unused]] static bool gdakiCtrlActFenceOk(struct gdakiRecHost* r, int peer, uint32_t dead) {
+  const bool launcherPaired = false;  /* phase 3 binds the launcher-paired flag */
+  if (!launcherPaired) return true;
+  struct gdakiCtrlPage* pg = gdakiPageOf(r);
+  if (pg == nullptr || peer < 0 || peer >= (int)pg->fencedPlus1.size()) return false;
+  return gdakiCtrlFencedIs(pg->fencedPlus1[(size_t)peer], dead);
+}
+// FENCED(peer, inc) into the fence word: max(word, i + 1) when the lineage classifies inc as CURRENT or HELD_OLD (design
+// 4.4; FUTURE and STALE are dropped). The word never decreases. In phase 1 (no launcher) this is reached only by a
+// relayed FENCED record (record 54), which this experiment does not produce; it is here for phase 3.
+static void gdakiLnFenced(struct gdakiRecHost* r, int peer, uint32_t inc) {
+  struct gdakiCtrlPage* pg = gdakiPageOf(r);
+  if (pg == nullptr || peer < 0 || peer >= (int)pg->fencedPlus1.size()) return;
+  const struct gdakiLnView lv = gdakiLnOf(r, peer);
+  const uint32_t cls = gdakiLnClassify(lv, inc);
+  if (cls != GDAKI_LN_CURRENT && cls != GDAKI_LN_HELD_OLD) return;
+  const uint64_t w = gdakiCtrlFenceWord(inc);
+  if (w > pg->fencedPlus1[(size_t)peer]) pg->fencedPlus1[(size_t)peer] = w;  // never decreases (design 4.4)
+}
+// The liveness READ QP toward `peer` into ERR, through the watch thread's request word (design v2 2.1's handoff): the
+// helper sets the request, the watch thread (which owns the QP) moves it. Called by gdakiCtrlPeerToErr at the hold start.
+static void gdakiProbeToErr(struct gdakiRecHost* r, int peer) {
+  struct gdakiCtrlPage* pg = gdakiPageOf(r);
+  if (pg == nullptr || peer < 0 || peer >= (int)pg->peers.size()) return;
+  std::lock_guard<std::mutex> lk(pg->mu);
+  pg->peers[(size_t)peer].toErrReq = true;
+}
+
+// Records 52-54 handled in the hold drain (a survivor and a held peer's buddy take them in arrival order); 55 is the
+// scaffold's PROBE_SETUP.
+static void gdakiCtrlOnRecord(struct gdakiRecHost* r, int from, const struct gdakiTsMsg& m) {
+  switch (m.type) {
+    case GDAKI_TS_CTRL_STALLED:
+      GIN_TS_NOTE("GIN/RC: rank %d: STALLED(rank %d, incarnation %u) from rank %d mono_ms=%.3f", r->ctx->rank, m.arg,
+                  (uint32_t)m.round, from, gdakiQ4MonoMs());
+      break;
+    case GDAKI_TS_CTRL_DISPUTE:
+      GIN_TS_NOTE("GIN/RC: rank %d: DISPUTE(rank %d, incarnation %u) from rank %d mono_ms=%.3f", r->ctx->rank, m.arg,
+                  (uint32_t)m.round, from, gdakiQ4MonoMs());
+      break;
+    case GDAKI_TS_CTRL_FENCED:  // from the launcher's relay (phase 3): the fence word; phase 1 has no launcher
+      gdakiLnFenced(r, m.arg, (uint32_t)m.round);
+      break;
+    case GDAKI_TS_CTRL_PROBE_SETUP:
+      gdakiCtrlProbeSetupRecv(r, from, m);
+      break;
+    default:
+      break;
+  }
+}
