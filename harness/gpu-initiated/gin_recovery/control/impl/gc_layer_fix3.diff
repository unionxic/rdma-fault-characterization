+// ---- the handoff of a peer's liveness READ QP between the watch thread and the helper (REVIEW_FIX12_P2B 막는 문제 2,
+// 고칠 것 1, 4, 9) ----
+// The watch thread owns the QP's software state, its posts and its CQ; the helper runs every firmware command
+// (modify_qp, QP create and destroy). A request of the helper's pairing (PREPARE, CONNECT) goes NEW -> (the watch thread
+// plans it: REUSE a QP prepared for this generation and untouched since; RESET one with nothing in flight; DRAIN one
+// with READs in flight) -> ERR (DRAIN: the helper moves it to ERR) -> DRAIN (the watch thread collects the flushes, one
+// poll per step, bounded GDAKI_CTRL_PROBE_DRAIN_MS: then a new QP) -> FW (the helper's firmware; the watch thread does not
+// touch the QP) -> BACK (the watch thread applies the result) -> IDLE. The hold start's ERR cancels a request in progress:
+// it is answered "hold started" and the QP stays in ERR; a CONNECT whose incarnation the lineage no longer calls current
+// is refused too (design 4.4: no RTS toward an old incarnation).
+#define GDAKI_CTRL_PROBE_DRAIN_MS 100.0
+enum : uint32_t {
+  GDAKI_CTRL_PO_NONE = 0,
+  GDAKI_CTRL_PO_PREPARE = 1,  // to INIT for generation `gen` with a fresh PSN (the PAIR's side): ERR, flushes, RESET
+  GDAKI_CTRL_PO_CONNECT = 2,  // RTR, RTS toward `remote` for `gen` (a QP connected before, or prepared for another
+                              // generation, is reset first with a fresh PSN); the peer's page and incNonce with it
+  GDAKI_CTRL_PO_TOERR = 3,    // unused since the hold start's ERR is the helper's own (gdakiProbeToErr)
+};
+enum : uint32_t {
+  GDAKI_CTRL_PH_IDLE = 0, GDAKI_CTRL_PH_NEW = 1, GDAKI_CTRL_PH_ERR = 2, GDAKI_CTRL_PH_DRAIN = 3, GDAKI_CTRL_PH_FW = 4,
+  GDAKI_CTRL_PH_BACK = 5,
+};
+enum : uint32_t { GDAKI_CTRL_PP_REUSE = 0, GDAKI_CTRL_PP_RESET = 1, GDAKI_CTRL_PP_DRAIN = 2 };
+enum : uint32_t {  // the helper's firmware steps (bits), gdakiCtrlProbeFwPlan
+  GDAKI_CTRL_FW_REFUSE_HOLD = 1u, GDAKI_CTRL_FW_REFUSE_LINEAGE = 2u, GDAKI_CTRL_FW_NEWQP = 4u, GDAKI_CTRL_FW_RESET = 8u,
+  GDAKI_CTRL_FW_CONNECT = 16u,
+};
+struct gdakiCtrlProbeHand {
+  uint32_t phase = GDAKI_CTRL_PH_IDLE;
+  uint32_t seq = 0, done = 0;  // the request in progress, the last one answered
+  uint32_t op = 0, gen = 0;    // GDAKI_CTRL_PO_PREPARE or _CONNECT, for generation gen
+  uint32_t plan = GDAKI_CTRL_PP_REUSE;
+  bool cancel = false;         // the hold start's ERR came while it was in progress
+  bool drainOk = true;         // DRAIN: the flushes came within the bound (else a new QP)
+  double drainFromMs = -1;
+  uint64_t drainGiveUps = 0, refusedHold = 0, refusedLineage = 0;
+};
+static inline uint32_t gdakiCtrlProbePlan(uint32_t op, uint32_t gen, bool haveQp, bool connected, bool err,
+                                          uint32_t preparedGen, uint32_t outstanding) {
+  if (haveQp && op == GDAKI_CTRL_PO_CONNECT && !connected && !err && preparedGen != 0 && preparedGen == gen && outstanding == 0)
+    return GDAKI_CTRL_PP_REUSE;
+  return haveQp && outstanding > 0 ? GDAKI_CTRL_PP_DRAIN : GDAKI_CTRL_PP_RESET;
+}
+// The helper's request (0: one is in progress; the caller asks again later).
+static inline uint32_t gdakiCtrlHandAsk(struct gdakiCtrlProbeHand* h, uint32_t op, uint32_t gen) {
+  if (h->phase != GDAKI_CTRL_PH_IDLE) return 0;
+  h->seq = h->done + 1u == 0 ? 1u : h->done + 1u;
+  h->op = op;
+  h->gen = gen;
+  h->cancel = false;
+  h->drainOk = true;
+  h->drainFromMs = -1;
+  h->phase = GDAKI_CTRL_PH_NEW;
+  return h->seq;
+}
+// The watch thread takes a NEW request: true when the QP leaves use (the watch thread marks it not RTS, the open
+// window cannot confirm); the plan says what follows.
+static inline bool gdakiCtrlHandTake(struct gdakiCtrlProbeHand* h, bool haveQp, bool connected, bool err,
+                                     uint32_t preparedGen, uint32_t outstanding) {
+  if (h->phase != GDAKI_CTRL_PH_NEW) return false;
+  h->plan = gdakiCtrlProbePlan(h->op, h->gen, haveQp, connected, err, preparedGen, outstanding);
+  h->phase = h->plan == GDAKI_CTRL_PP_DRAIN ? GDAKI_CTRL_PH_ERR : GDAKI_CTRL_PH_FW;
+  return h->plan != GDAKI_CTRL_PP_REUSE;
+}
+static inline void gdakiCtrlHandErrDone(struct gdakiCtrlProbeHand* h, double nowMs) {  // the helper's ERR is done
+  if (h->phase != GDAKI_CTRL_PH_ERR) return;
+  h->phase = GDAKI_CTRL_PH_DRAIN;
+  h->drainFromMs = nowMs;
+}
+// The watch thread after its poll in DRAIN: 1 the QP passes to the helper (drained, or the bound passed: a new QP then,
+// nothing of the old one completes), 0 not yet.
+static inline int gdakiCtrlHandDrain(struct gdakiCtrlProbeHand* h, uint32_t outstanding, double nowMs) {
+  if (h->phase != GDAKI_CTRL_PH_DRAIN) return 0;
+  if (outstanding > 0 && nowMs - h->drainFromMs <= GDAKI_CTRL_PROBE_DRAIN_MS) return 0;
+  h->drainOk = outstanding == 0;
+  if (!h->drainOk) h->drainGiveUps++;
+  h->phase = GDAKI_CTRL_PH_FW;
+  return 1;
+}
+// A refusal keeps the QP out of RTS (ERR); one whose drain gave up is replaced still (its lost flushes never complete).
+static inline uint32_t gdakiCtrlProbeFwPlan(const struct gdakiCtrlProbeHand* h, bool haveQp, bool lnCurrent) {
+  const uint32_t newQp = !h->drainOk ? GDAKI_CTRL_FW_NEWQP : 0u;
+  if (h->cancel) return GDAKI_CTRL_FW_REFUSE_HOLD | newQp;
+  if (h->op == GDAKI_CTRL_PO_CONNECT && !lnCurrent) return GDAKI_CTRL_FW_REFUSE_LINEAGE | newQp;
+  uint32_t s = newQp;
+  if (!haveQp) s |= GDAKI_CTRL_FW_NEWQP;
+  if (h->plan != GDAKI_CTRL_PP_REUSE || (s & GDAKI_CTRL_FW_NEWQP)) s |= GDAKI_CTRL_FW_RESET;
+  if (h->op == GDAKI_CTRL_PO_CONNECT) s |= GDAKI_CTRL_FW_CONNECT;
+  return s;
+}
+static inline void gdakiCtrlHandFwDone(struct gdakiCtrlProbeHand* h) {
+  if (h->phase == GDAKI_CTRL_PH_FW) h->phase = GDAKI_CTRL_PH_BACK;
+}
+static inline void gdakiCtrlHandBack(struct gdakiCtrlProbeHand* h) {
+  if (h->phase != GDAKI_CTRL_PH_BACK) return;
+  h->done = h->seq;
+  h->phase = GDAKI_CTRL_PH_IDLE;
+}
+static inline bool gdakiCtrlHandWatchOwns(const struct gdakiCtrlProbeHand* h) { return h->phase != GDAKI_CTRL_PH_FW; }
+static inline void gdakiCtrlHandCancel(struct gdakiCtrlProbeHand* h) {  // the hold start's ERR
+  if (h->phase != GDAKI_CTRL_PH_IDLE && h->phase != GDAKI_CTRL_PH_BACK) h->cancel = true;
+}
