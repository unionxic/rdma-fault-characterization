+// The ward QP's ERR as the buddy's activation gate sees it (wardfix, impl/notes_wardfix.md): the hold start only asks the
+// store thread (gdakiCtrlStoreWardToErrAsk), so the ACTIVATE of dead + 1 waits until that thread reports the QP in ERR (a
+// late upload WRITE of the dead incarnation can then land nowhere before the successor's FETCH). Per ward, under st->mu:
+// NONE (never asked), ASKED (a job queued), DONE (no QP on this side, or the modify to ERR succeeded), FAILED (it did not).
+enum : int { GDAKI_CTRL_WERR_NONE = 0, GDAKI_CTRL_WERR_ASKED = 1, GDAKI_CTRL_WERR_DONE = 2, GDAKI_CTRL_WERR_FAILED = 3 };
+// The bound of the gate's wait for DONE from the ask (ms): the store thread runs one job before it at most (the one in
+// progress: a SERVE's MR registration or a FREE), then the one modify. Past it the gate falls back as on a FENCE_NAK.
+#define GDAKI_CTRL_WARD_ERR_WAIT_MS 2000.0
+// The store thread's verdict of one WARD_ERR job: no QP on this side (never served here, or dropped): nothing can land,
+// DONE; else the modify's result.
+static inline int gdakiCtrlStoreWardErrOutcome(bool haveQp, bool modifiedToErr) {
+  return (!haveQp || modifiedToErr) ? GDAKI_CTRL_WERR_DONE : GDAKI_CTRL_WERR_FAILED;
+}
+// Where the WARD_ERR job of ward d goes in the store thread's queue: ahead of every job but a SERVE of d itself (that one
+// may install a newer QP of d, which the ERR must then find): right after the last SERVE of d, else at the front.
+template <class J>
+static inline size_t gdakiCtrlStoreWardErrPos(const std::vector<J>& jobs, int d, int serveKind) {
+  size_t pos = 0;
+  for (size_t i = 0; i < jobs.size(); i++)
+    if (jobs[i].kind == serveKind && jobs[i].d == d) pos = i + 1;
+  return pos;
+}
+// The gate's ward part: 1 go (not this rank's ward, or DONE), 0 wait (ASKED within the bound; NONE: the caller asks now),
+// -1 fall back with *why (FAILED, or ASKED past the bound).
+static inline int gdakiCtrlStoreWardGate(bool due, int state, double askedMs, double nowMs, double boundMs,
+                                         const char** why) {
+  if (!due || state == GDAKI_CTRL_WERR_DONE) return 1;
+  if (state == GDAKI_CTRL_WERR_FAILED) {
+    *why = "the store thread's modify to ERR failed";
+    return -1;
+  }
+  if (state == GDAKI_CTRL_WERR_ASKED && nowMs - askedMs >= boundMs) {
+    *why = "the store thread did not report it in ERR within the bound";
+    return -1;
+  }
+  return 0;
+}
+// The activation gate (gdakiCtrlActFenceOk): FENCED (fenceGo) and the ward part (1, 0, -1 as above): 1 go, 0 not now, -1
+// fall back (a ward that cannot reach ERR, whatever the fence says).
+static inline int gdakiCtrlActWardJoin(bool fenceGo, int ward) {
+  if (ward < 0) return -1;
+  return (fenceGo && ward > 0) ? 1 : 0;
+}
