+// The WARD_ERR job of `peer` queued (st->mu held): ahead of the other wards' jobs (gdakiCtrlStoreWardErrPos), its state
+// ASKED from now (the gate's bound counts from here).
+static void gdakiCtrlStoreWardErrQueueLocked(struct gdakiStoreState* st, int peer) {
+  if (st->wardErr.size() != (size_t)st->n) {
+    st->wardErr.assign((size_t)st->n, GDAKI_CTRL_WERR_NONE);
+    st->wardErrAskMs.assign((size_t)st->n, 0.0);
+  }
+  struct gdakiStoreJob j;
+  j.kind = GDAKI_CTRL_STORE_JOB_WARD_ERR;
+  j.d = peer;
+  st->jobs.insert(st->jobs.begin() + (ptrdiff_t)gdakiCtrlStoreWardErrPos(st->jobs, peer, GDAKI_STORE_JOB_SERVE), j);
+  st->wardErr[(size_t)peer] = GDAKI_CTRL_WERR_ASKED;
+  st->wardErrAskMs[(size_t)peer] = gdakiQ4MonoMs();
+}
