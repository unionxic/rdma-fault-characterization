+// The activation gate's ward part (gdakiCtrlActFenceOk, the helper): 1 go, 0 wait, -1 fall back with *why
+// (gdakiCtrlStoreWardGate). Not this rank's ward, no store state (no ward QP): go. Never asked (the hold start's job was
+// not queued): asked now.
+static int gdakiCtrlStoreWardGateOf(struct gdakiRecHost* r, int peer, const char** why) {
+  if (r == nullptr || r->ctx == nullptr || !gdakiStoreOn(r)) return 1;
+  struct gdakiStoreState* st;
+  {
+    std::lock_guard<std::mutex> lk(gdakiStoreLifeMu);
+    st = r->mi.store;
+  }
+  if (st == nullptr) return 1;
+  const bool due = gdakiCtrlStoreWardErrDue(st->me, st->n, peer, gdakiHoldBuddyOf(peer, st->n));
+  if (!due) return 1;
+  int s;
+  double askMs;
+  bool asked = false;
+  {
+    std::lock_guard<std::mutex> lk(st->mu);
+    if (st->stop) {
+      *why = "the store is being torn down";
+      return -1;
+    }
+    if (st->wardErr.size() != (size_t)st->n || st->wardErr[(size_t)peer] == GDAKI_CTRL_WERR_NONE) {
+      gdakiCtrlStoreWardErrQueueLocked(st, peer);
+      asked = true;
+    }
+    s = st->wardErr[(size_t)peer];
+    askMs = st->wardErrAskMs[(size_t)peer];
+  }
+  if (asked) st->cv.notify_all();
+  return gdakiCtrlStoreWardGate(due, s, askMs, gdakiQ4MonoMs(), GDAKI_CTRL_WARD_ERR_WAIT_MS, why);
+}
