+// closed (its GPU stall stops below STALL_MS: row 18 at most); it opens (a) when every target is resolved (O saw the
+// target's restored line named, or O's hold of it ended, fallback too, or it left Z; never while O holds it in a quiet
+// state: HELD, COMMITTING, TIMED_OUT_HELD) and no progress came within G = SUSPECT_MS after the last resolution, or (b) at
+// the hard bound: X's raw stall >= 2 x STALL_MS whatever the target's state. The clocks are never reset for that; the
+// restore commit's (0, 0) rewrite of an element toward a target of the gate is not progress (the element stays
+// pending until its first post or poll). While the gate is closed O publishes the GPU part of staleMs[X] at most
+// STALL_MS - 2 x PROBE_MS - 1 (9 799 ms: FRESH in another observer's partition guard).
+#define GDAKI_CTRL_RMASK_W 2u  // rank sets: 2 words
+static_assert(GDAKI_CTRL_PAGE_MAX_RANKS <= 64u * GDAKI_CTRL_RMASK_W, "a rank set holds every rank of a page");
+struct gdakiCtrlRMask {
+  uint64_t w[GDAKI_CTRL_RMASK_W] = {0, 0};
+};
+static inline void gdakiCtrlRMaskSet(struct gdakiCtrlRMask* m, uint32_t k) {
+  if (k < 64u * GDAKI_CTRL_RMASK_W) m->w[k >> 6] |= 1ull << (k & 63u);
+}
+static inline bool gdakiCtrlRMaskHas(const struct gdakiCtrlRMask& m, uint32_t k) {
+  return k < 64u * GDAKI_CTRL_RMASK_W && (m.w[k >> 6] >> (k & 63u) & 1u) != 0;
+}
+static inline bool gdakiCtrlRMaskAny(const struct gdakiCtrlRMask& m) { return (m.w[0] | m.w[1]) != 0; }
+static inline bool gdakiCtrlRMaskMeets(const struct gdakiCtrlRMask& a, const struct gdakiCtrlRMask& b) {
+  return ((a.w[0] & b.w[0]) | (a.w[1] & b.w[1])) != 0;
+}
+// One element of a line (k: the QP to rank k; stride, offsets as gdakiCtrlDevSumOf). Out of the line: zeros.
+static inline struct gdakiCtrlDevSum gdakiCtrlDevElemOf(const uint8_t* line, uint32_t bytes, uint32_t stride,
+                                                        uint32_t offPosted, uint32_t offPolled, uint32_t k) {
+  struct gdakiCtrlDevSum d;
+  if (line == nullptr || stride < 8u || offPosted + 8u > stride || offPolled + 8u > stride ||
+      (uint64_t)(k + 1u) * stride > bytes)
+    return d;
+  memcpy(&d.posted, line + (size_t)k * stride + offPosted, 8);
+  memcpy(&d.polled, line + (size_t)k * stride + offPolled, 8);
+  d.pending = d.posted > d.polled ? d.posted - d.polled : 0;
+  return d;
+}
+struct gdakiCtrlDevElem {
+  struct gdakiCtrlStale s;     // the element's stall clock (gdakiCtrlDevOnRead over this element alone)
+  uint64_t posted = 0, polled = 0;
+  bool rw = false;             // the restore commit rewrote this pending element to (0, 0): held pending, no progress
+  uint64_t rwPolled = 0;       // the polled index before the rewrite (a torn (0, polled) READ is no progress either)
+};
+// One READ of the element at nowMs. holdRewrite: the element goes toward a target of X's gate (a pending element
+// rewritten to posted 0 is the commit's, not progress: the clock goes on until the first post or poll). *progress: the
+// element's value changed (a post or a poll).
+static inline double gdakiCtrlDevElemOnRead(struct gdakiCtrlDevElem* e, const struct gdakiCtrlDevSum& d, double nowMs,
+                                            double probeMs, bool holdRewrite, bool* progress = nullptr) {
+  if (progress != nullptr) *progress = false;
+  const bool rwNow = e->rw ? d.posted == 0 && (d.polled == 0 || d.polled == e->rwPolled)
+                           : holdRewrite && e->s.have && e->posted > e->polled && d.posted == 0;
+  if (rwNow) {  // the rewrite (or still it): the clock goes on, the reader's own gap rule as ever
+    if (!e->rw) e->rwPolled = e->polled;
+    e->rw = true;
+    if (nowMs - e->s.lastMs > 2.0 * probeMs) e->s.firstMs = nowMs;
+    e->s.lastMs = nowMs;
+    return nowMs - e->s.firstMs;
+  }
+  e->rw = false;  // a post or a poll after the rewrite: progress (the value differs, the clock below resets)
+  const bool changed = e->s.have && gdakiCtrlDevValue(d) != e->s.val;
+  const double st = gdakiCtrlDevOnRead(&e->s, d, nowMs, probeMs);
+  e->posted = d.posted;
+  e->polled = d.polled;
+  if (progress != nullptr) *progress = changed;
+  return st;
+}
+static inline double gdakiCtrlDevElemStale(const struct gdakiCtrlDevElem& e) {
+  return e.s.have ? e.s.lastMs - e.s.firstMs : 0;
+}
+// X's row of the snapshot from its elements (nCtx x n, context-major: e[c * n + k]): the raw stall (the largest element's;
+// *ctx its context, the lowest index on a tie, -1 when 0) and T(X) at tzMs. *firstMin: the oldest origin of an element
+// read (the page word's base: nowMs - firstMin; GDAKI_CTRL_FIRST_NONE when none was read).
+#define GDAKI_CTRL_FIRST_NONE (-1e18)
+static inline double gdakiCtrlStallTargets(const struct gdakiCtrlDevElem* e, uint32_t nCtx, uint32_t n, double tzMs,
+                                           struct gdakiCtrlRMask* t, int* ctx = nullptr, double* firstMin = nullptr) {
+  double m = 0, fm = GDAKI_CTRL_FIRST_NONE;
+  int kc = -1;
+  *t = gdakiCtrlRMask();
+  for (uint32_t c = 0; c < nCtx && c < GDAKI_CTRL_DEV_MAX_CTX; c++)
+    for (uint32_t k = 0; k < n && k < GDAKI_CTRL_PAGE_MAX_RANKS; k++) {
+      const struct gdakiCtrlDevElem& x = e[(size_t)c * n + k];
+      if (!x.s.have) continue;
+      if (fm == GDAKI_CTRL_FIRST_NONE || x.s.firstMs < fm) fm = x.s.firstMs;
+      const double v = gdakiCtrlDevElemStale(x);
+      if (v > m) {
+        m = v;
+        kc = (int)c;
+      }
+      if (v >= tzMs) gdakiCtrlRMaskSet(t, k);
+    }
+  if (ctx != nullptr) *ctx = kc;
+  if (firstMin != nullptr) *firstMin = fm;
+  return m;
+}
+// T_z: SUSPECT_MS - 2 x PROBE_MS (1 800 ms at the defaults).
+static inline double gdakiCtrlStallTz(double suspectMs, double probeMs) { return suspectMs - 2.0 * probeMs; }
+enum : uint32_t { GDAKI_CTRL_ROLE_NONE = 0, GDAKI_CTRL_ROLE_SOURCE = 1, GDAKI_CTRL_ROLE_DEPENDENT = 2, GDAKI_CTRL_ROLE_CYCLE = 3 };
+static inline const char* gdakiCtrlRoleName(uint32_t r) {
+  return r == GDAKI_CTRL_ROLE_SOURCE ? "source" : r == GDAKI_CTRL_ROLE_DEPENDENT ? "dependent"
+                                             : r == GDAKI_CTRL_ROLE_CYCLE    ? "cycle" : "none";
+}
+// The classifier over one snapshot: t[X] = T(X) for X in [0, n) (empty: X not in Z, or O has no valid view of it).
+// role[X]: NONE outside Z, else SOURCE, DEPENDENT (a SOURCE reached along T) or CYCLE.
+static inline void gdakiCtrlStallRoles(const struct gdakiCtrlRMask* t, uint32_t n, uint32_t* role) {
+  struct gdakiCtrlRMask z, reach;
+  n = std::min(n, (uint32_t)GDAKI_CTRL_PAGE_MAX_RANKS);
+  for (uint32_t x = 0; x < n; x++)
+    if (gdakiCtrlRMaskAny(t[x])) gdakiCtrlRMaskSet(&z, x);
+  for (uint32_t x = 0; x < n; x++) {
+    role[x] = GDAKI_CTRL_ROLE_NONE;
+    if (!gdakiCtrlRMaskHas(z, x)) continue;
+    struct gdakiCtrlRMask out;  // T(X) \ (Z \ {X})
+    for (uint32_t w = 0; w < GDAKI_CTRL_RMASK_W; w++) out.w[w] = t[x].w[w] & ~z.w[w];
+    if (gdakiCtrlRMaskAny(out) || gdakiCtrlRMaskHas(t[x], x)) {
+      role[x] = GDAKI_CTRL_ROLE_SOURCE;
+      gdakiCtrlRMaskSet(&reach, x);
+    }
+  }
+  for (bool more = true; more;) {  // DEPENDENT: a target reaches a SOURCE (the fixpoint along T)
+    more = false;
+    for (uint32_t x = 0; x < n; x++)
+      if (gdakiCtrlRMaskHas(z, x) && !gdakiCtrlRMaskHas(reach, x) && gdakiCtrlRMaskMeets(t[x], reach)) {
+        role[x] = GDAKI_CTRL_ROLE_DEPENDENT;
+        gdakiCtrlRMaskSet(&reach, x);
+        more = true;
+      }
+  }
+  for (uint32_t x = 0; x < n; x++)
+    if (gdakiCtrlRMaskHas(z, x) && !gdakiCtrlRMaskHas(reach, x)) role[x] = GDAKI_CTRL_ROLE_CYCLE;
+}
+// The wait gate of one subject X at O. NONE: X not gated (judged by its role); CLOSED: X is DEPENDENT and not judged;
+// OPEN: the gate opened (G or the hard bound), the 10 s rule judges X with its raw stall until X leaves Z.
+enum : uint32_t { GDAKI_CTRL_WG_NONE = 0, GDAKI_CTRL_WG_CLOSED = 1, GDAKI_CTRL_WG_OPEN = 2 };
+enum : uint32_t {
+  GDAKI_CTRL_WGE_NONE = 0,
+  GDAKI_CTRL_WGE_BEGAN = 1,      // closed now ("waiting (peer=...)")
+  GDAKI_CTRL_WGE_OPEN_G = 2,     // every target resolved, no progress within G ("wait ended")
+  GDAKI_CTRL_WGE_OPEN_HARD = 3,  // the hard bound ("wait ended")
+  GDAKI_CTRL_WGE_ENDED = 4,      // X left Z (progress) ("wait ended", unless it opened before)
+};
+struct gdakiCtrlWaitGate {
+  uint32_t st = GDAKI_CTRL_WG_NONE;
+  uint32_t how = GDAKI_CTRL_WGE_NONE;  // OPEN: GDAKI_CTRL_WGE_OPEN_G or _HARD
+  struct gdakiCtrlRMask tgt;           // the direct targets (T(X) at the close, and every target added while closed)
+  uint32_t evAt[GDAKI_CTRL_PAGE_MAX_RANKS] = {};  // each target's resolution count when it became a target
+  double sinceMs = 0, resMs = -1;      // the close; when every target became resolved (-1: not every one is)
+};
+// One step of X's gate with this snapshot (role: X's, tX = T(X), rawMs: X's raw stall). Per rank k: inZ (k in Z with a
+// valid view), seen (a valid view of k), quiet (O holds k in HELD, COMMITTING or TIMED_OUT_HELD), ev[k] (O's resolution
+// events of k: its restored line named, its hold ended). Returns the event (GDAKI_CTRL_WGE_*).
+static inline uint32_t gdakiCtrlWaitGateStep(struct gdakiCtrlWaitGate* g, uint32_t role, const struct gdakiCtrlRMask& tX,
+                                             double rawMs, const struct gdakiCtrlRMask& inZ,
+                                             const struct gdakiCtrlRMask& seen, const struct gdakiCtrlRMask& quiet,
+                                             const uint32_t* ev, uint32_t n, double nowMs, double gMs, double hardMs) {
+  n = std::min(n, (uint32_t)GDAKI_CTRL_PAGE_MAX_RANKS);
+  if (!gdakiCtrlRMaskAny(tX)) {  // X left Z: the wait is over (progress), whatever the gate was
+    if (g->st == GDAKI_CTRL_WG_NONE) return GDAKI_CTRL_WGE_NONE;
+    *g = gdakiCtrlWaitGate();
+    return GDAKI_CTRL_WGE_ENDED;
+  }
+  if (g->st == GDAKI_CTRL_WG_OPEN) return GDAKI_CTRL_WGE_NONE;
+  bool began = false;
+  if (role == GDAKI_CTRL_ROLE_DEPENDENT) {
+    if (g->st == GDAKI_CTRL_WG_NONE) {
+      *g = gdakiCtrlWaitGate();
+      g->st = GDAKI_CTRL_WG_CLOSED;
+      g->sinceMs = nowMs;
+      began = true;
+    }
+    for (uint32_t k = 0; k < n; k++)  // the direct targets are kept; a new one counts from now
+      if (gdakiCtrlRMaskHas(tX, k) && !gdakiCtrlRMaskHas(g->tgt, k)) {
+        gdakiCtrlRMaskSet(&g->tgt, k);
+        g->evAt[k] = ev[k];
+      }
+  } else if (g->st == GDAKI_CTRL_WG_NONE) {
+    return GDAKI_CTRL_WGE_NONE;  // SOURCE or CYCLE, not gated
+  }
+  if (rawMs >= hardMs) {  // the hard bound: whatever the targets' state (ARMED, HELD, judged or not)
+    g->st = GDAKI_CTRL_WG_OPEN;
+    g->how = GDAKI_CTRL_WGE_OPEN_HARD;
+    return GDAKI_CTRL_WGE_OPEN_HARD;
+  }
+  bool all = true;
+  for (uint32_t k = 0; k < n && all; k++) {
+    if (!gdakiCtrlRMaskHas(g->tgt, k)) continue;
+    const bool resolved = !gdakiCtrlRMaskHas(quiet, k) &&
+                          (ev[k] != g->evAt[k] || (gdakiCtrlRMaskHas(seen, k) && !gdakiCtrlRMaskHas(inZ, k)));
+    all = resolved;
+  }
+  if (!all) g->resMs = -1;
+  else if (g->resMs < 0) g->resMs = nowMs;
+  if (all && nowMs - g->resMs >= gMs) {
+    g->st = GDAKI_CTRL_WG_OPEN;
+    g->how = GDAKI_CTRL_WGE_OPEN_G;
+    return GDAKI_CTRL_WGE_OPEN_G;
+  }
+  return began ? GDAKI_CTRL_WGE_BEGAN : GDAKI_CTRL_WGE_NONE;
+}
+// The judgement's GPU stall of X: below STALL_MS while the gate is closed (row 18 at most, no latch), raw otherwise.
+static inline double gdakiCtrlWaitCap(double rawMs, bool closed, double stallMs) {
+  return closed && rawMs >= stallMs ? stallMs - 1.0 : rawMs;
+}
+// The GPU part of the page word staleMs[X]: at most STALL_MS - 2 x PROBE_MS - 1 while the gate is closed (another
+// observer's partition guard reads it FRESH), raw otherwise.
+static inline double gdakiCtrlWaitPageGpu(double rawMs, bool closed, double stallMs, double probeMs) {
+  const double cap = stallMs - 2.0 * probeMs - 1.0;
+  return closed && rawMs > cap ? cap : rawMs;
+}
+// The role word the watch thread publishes per peer for the helper (its effective role: DEPENDENT while the gate is
+// closed; the gate; the hard bound passed), and the helper's two questions about a GPU stall mail: in the step's first
+// group (SOURCE, CYCLE, a mail that is not a GPU stall), and processed at all (else dropped: not put back, the next READ
+// makes it again when it holds). A mail past the hard bound is always processed.
+static inline uint32_t gdakiCtrlRoleWord(uint32_t role, uint32_t gate, bool hard) {
+  const uint32_t r = gate == GDAKI_CTRL_WG_CLOSED ? GDAKI_CTRL_ROLE_DEPENDENT : role;
+  return (r & 3u) | ((gate & 3u) << 2) | (hard ? 16u : 0u);
+}
+static inline uint32_t gdakiCtrlRoleWordRole(uint32_t w) { return w & 3u; }
+static inline uint32_t gdakiCtrlRoleWordGate(uint32_t w) { return (w >> 2) & 3u; }
+static inline bool gdakiCtrlStallMailFirst(bool gpu, uint32_t w) {
+  return !gpu || gdakiCtrlRoleWordRole(w) != GDAKI_CTRL_ROLE_DEPENDENT || (w & 16u) != 0;
+}
+static inline bool gdakiCtrlStallMailKeep(bool gpu, uint32_t w) {
+  return gdakiCtrlStallMailFirst(gpu, w) || gdakiCtrlRoleWordGate(w) == GDAKI_CTRL_WG_OPEN;
+}
