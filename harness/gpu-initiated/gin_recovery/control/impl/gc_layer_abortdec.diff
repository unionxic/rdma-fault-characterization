+// gin-control (abortdec): the UD table's bytes at the head of the activation blob's rest (its header's count); a rest it
+// cannot be is all of it (gdakiCtrlActUdGet refuses it then, as before). The bytes after it: the abort decisions' "GAAD".
+static inline size_t gdakiCtrlActUdLenOf(const uint8_t* p, size_t n, int nranks) {
+  struct gdakiCtrlActUdHdr h;
+  if (n < sizeof(h) || nranks <= 0) return n;
+  memcpy(&h, p, sizeof(h));
+  if (h.magic != GDAKI_CTRL_ACT_UD_MAGIC || h.count > (uint32_t)nranks) return n;
+  const size_t u = sizeof(h) + (size_t)h.count * sizeof(struct gdakiCtrlActUd);
+  return u <= n ? u : n;
+}
