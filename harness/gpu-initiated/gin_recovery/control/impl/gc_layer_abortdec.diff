+  auto is = [](const char* s, const char* w) { return s != nullptr && strcmp(s, w) == 0; };
+  if (why != nullptr && strncmp(why, "restore fallback", 16) == 0) return GDAKI_AD_C_FALLBACK;
+  if (has(why, "(STALL_HELPER)") || is(lostCause, "STALL_HELPER")) return GDAKI_AD_C_STALL_HELPER;
+  if (has(why, "(STALL)") || is(lostCause, "STALL")) return GDAKI_AD_C_STALL;
+  if (has(why, "FIN") || has(why, "EXITED") || has(why, "REMACC") || has(lostCause, "FIN") || is(lostCause, "EXITED") ||
+      has(lostCause, "REMACC") || is(lostCause, "ECONNREFUSED"))
+    return GDAKI_AD_C_FIN;
+  if (has(why, "NORESP") || is(lostCause, "NORESP")) return GDAKI_AD_C_NORESP;
+  return GDAKI_AD_C_OTHER;
+}
+// An entry of the log. Its state: this rank's own; taken and stored (the view incomplete), deferred (HELD_OLD), applied,
+// late; dropped (stale target, about this rank: kept for the key only, never sent on).
+enum : uint32_t {
+  GDAKI_AD_S_OWN = 1,
+  GDAKI_AD_S_PENDING = 2,
+  GDAKI_AD_S_DEFERRED = 3,
+  GDAKI_AD_S_APPLIED = 4,
+  GDAKI_AD_S_LATE = 5,
+  GDAKI_AD_S_STALE = 6,
+  GDAKI_AD_S_SELF = 7,
+};
+struct gdakiAdEntry {
+  uint64_t commHash = 0, gen = 0;  // the communicator (Resume's commHash) and its generation (the setup's lowest salt)
+  int32_t target = -1;
+  uint32_t targetInc = 0;
+  int32_t decider = -1;
+  uint32_t deciderInc = 0, no = 0, cause = 0;
+  double deciderDeadlineMs = -1;  // the release on the decider's clock (-1: none): reported, never compared here
+  double deadlineMs = -1;         // the release on this rank's clock (own: the decider's; taken: arrival + remaining)
+  double learnedMs = 0;
+  int32_t from = -1;              // the rank it came from (-1: this rank's own; the blob's: the buddy)
+  bool blob = false;              // it came in the activation blob
+  uint32_t state = 0;
+};
+static inline bool gdakiAdSameKey(const struct gdakiAdEntry& a, const struct gdakiAdEntry& b) {
+  return a.decider == b.decider && a.deciderInc == b.deciderInc && a.no == b.no;
+}
+static inline double gdakiAdRemainingMs(const struct gdakiAdEntry& e, double nowMs) {
+  return e.deadlineMs < 0 ? -1.0 : std::max(0.0, e.deadlineMs - nowMs);
+}
+static inline bool gdakiAdOpen(const struct gdakiAdEntry& e, double nowMs) { return e.deadlineMs < 0 || e.deadlineMs >= nowMs; }
+static inline bool gdakiAdForwardable(const struct gdakiAdEntry& e) {
+  return e.state == GDAKI_AD_S_OWN || e.state == GDAKI_AD_S_PENDING || e.state == GDAKI_AD_S_DEFERRED ||
+         e.state == GDAKI_AD_S_APPLIED || e.state == GDAKI_AD_S_LATE;
+}
+// Record 57: from, nonce (gdakiHoldSend), arg target, round its incarnation, nqp the decision number, pad the cause,
+// executed[0] the decider, [1] its incarnation, [2] the forwarder's own incarnation (the receiver checks it against its
+// lineage of `from`), t[0] the remaining ms (-1: none), t[1] commHash and t[2] the generation (bits as they are), t[3]
+// the decider's release on its clock.
+static inline void gdakiAdMsgOf(const struct gdakiAdEntry& e, uint32_t fwdInc, double nowMs, struct gdakiTsMsg* m) {
+  memset(m, 0, sizeof(*m));
+  m->type = GDAKI_TS_CTRL_ABORT_DECIDED;
+  m->arg = e.target;
+  m->round = e.targetInc;
+  m->nqp = e.no;
+  m->pad = e.cause;
+  m->executed[0] = (uint32_t)e.decider;
+  m->executed[1] = e.deciderInc;
+  m->executed[2] = fwdInc;
+  m->t[0] = gdakiAdRemainingMs(e, nowMs);
+  memcpy(&m->t[1], &e.commHash, sizeof(e.commHash));
+  memcpy(&m->t[2], &e.gen, sizeof(e.gen));
+  m->t[3] = e.deciderDeadlineMs;
+}
+static inline struct gdakiAdEntry gdakiAdOfMsg(const struct gdakiTsMsg& m, int from, double nowMs, uint32_t* fwdInc) {
+  struct gdakiAdEntry e;
+  e.target = m.arg;
+  e.targetInc = (uint32_t)m.round;
+  e.no = m.nqp;
+  e.cause = m.pad;
+  e.decider = (int32_t)m.executed[0];
+  e.deciderInc = m.executed[1];
+  *fwdInc = m.executed[2];
+  memcpy(&e.commHash, &m.t[1], sizeof(e.commHash));
+  memcpy(&e.gen, &m.t[2], sizeof(e.gen));
+  e.deciderDeadlineMs = m.t[3];
+  e.deadlineMs = m.t[0] < 0 ? -1.0 : nowMs + m.t[0];
+  e.learnedMs = nowMs;
+  e.from = from;
+  return e;
+}
+// The activation blob's part after the UD table: a header and fixed entries.
+#define GDAKI_AD_BLOB_MAGIC 0x44414147u  // "GAAD"
+#define GDAKI_AD_BLOB_MAX_N 256u
+struct gdakiAdBlobHdr {
+  uint32_t magic, version, count, rsv;
+};
+struct gdakiAdWire {
+  uint64_t commHash, gen;
+  int32_t target;
+  uint32_t targetInc;
+  int32_t decider;
+  uint32_t deciderInc, no, cause;
+  double remainingMs, deciderDeadlineMs;
+  uint32_t fwdInc, rsv;
+};
+static_assert(sizeof(struct gdakiAdBlobHdr) == 16 && sizeof(struct gdakiAdWire) == 64, "the blob's GAAD layout");
+#define GDAKI_AD_BLOB_PAYLOAD 65536u  // the launcher's largest payload (launcher_msg.h GL_U_MAX_PAYLOAD) holds the whole blob
+#define GDAKI_AD_BLOB_MAX (sizeof(struct gdakiAdBlobHdr) + (size_t)GDAKI_AD_BLOB_MAX_N * sizeof(struct gdakiAdWire))
+static inline struct gdakiAdWire gdakiAdWireOf(const struct gdakiAdEntry& e, uint32_t fwdInc, double nowMs) {
+  struct gdakiAdWire w;
+  memset(&w, 0, sizeof(w));
+  w.commHash = e.commHash;
+  w.gen = e.gen;
+  w.target = e.target;
+  w.targetInc = e.targetInc;
+  w.decider = e.decider;
+  w.deciderInc = e.deciderInc;
+  w.no = e.no;
+  w.cause = e.cause;
+  w.remainingMs = gdakiAdRemainingMs(e, nowMs);
+  w.deciderDeadlineMs = e.deciderDeadlineMs;
+  w.fwdInc = fwdInc;
+  return w;
+}
+static inline struct gdakiAdEntry gdakiAdOfWire(const struct gdakiAdWire& w, int from, double nowMs) {
+  struct gdakiAdEntry e;
+  e.commHash = w.commHash;
+  e.gen = w.gen;
+  e.target = w.target;
+  e.targetInc = w.targetInc;
+  e.decider = w.decider;
+  e.deciderInc = w.deciderInc;
+  e.no = w.no;
+  e.cause = w.cause;
+  e.deciderDeadlineMs = w.deciderDeadlineMs;
+  e.deadlineMs = w.remainingMs < 0 ? -1.0 : nowMs + w.remainingMs;
+  e.learnedMs = nowMs;
+  e.from = from;
+  e.blob = true;
+  return e;
+}
+static inline void gdakiAdBlobPut(const std::vector<struct gdakiAdWire>& w, std::vector<uint8_t>* out) {
+  const struct gdakiAdBlobHdr h = {GDAKI_AD_BLOB_MAGIC, 1u, (uint32_t)w.size(), 0u};
+  const size_t at = out->size(), wb = w.size() * sizeof(struct gdakiAdWire);
+  out->resize(at + sizeof(h) + wb);
+  memcpy(out->data() + at, &h, sizeof(h));
+  if (wb) memcpy(out->data() + at + sizeof(h), w.data(), wb);
+}
+// None (n 0) is true with no entry; else the header and exactly `count` entries (at most GDAKI_AD_BLOB_MAX_N), each
+// naming ranks in range. False: damaged.
+static inline bool gdakiAdBlobGet(const uint8_t* p, size_t n, int nranks, std::vector<struct gdakiAdWire>* out) {
+  out->clear();
+  if (n == 0) return true;
+  struct gdakiAdBlobHdr h;
+  if (n < sizeof(h) || nranks <= 0) return false;
+  memcpy(&h, p, sizeof(h));
+  if (h.magic != GDAKI_AD_BLOB_MAGIC || h.version != 1u || h.count > GDAKI_AD_BLOB_MAX_N ||
+      n != sizeof(h) + (size_t)h.count * sizeof(struct gdakiAdWire))
+    return false;
+  out->resize(h.count);
+  if (h.count) memcpy(out->data(), p + sizeof(h), (size_t)h.count * sizeof(struct gdakiAdWire));
+  for (const struct gdakiAdWire& w : *out)
+    if (w.target < 0 || w.target >= nranks || w.decider < 0 || w.decider >= nranks) return false;
+  return true;
+}
+// A taken decision's action (arrival, and every later check of a stored or deferred one: dup false, fwdCurrent true).
+enum : uint32_t {
+  GDAKI_AD_RX_OTHER = 0,      // another communicator or generation: dropped
+  GDAKI_AD_RX_DUP = 1,        // its key is in the log: counted
+  GDAKI_AD_RX_FWD_STALE = 2,  // the forwarder is not this rank's current incarnation of it: dropped
+  GDAKI_AD_RX_SELF = 3,       // about this rank: a line only (this process's own path is not this piece's)
+  GDAKI_AD_RX_PEND = 4,       // this rank's lineage view is not complete (a spare before its REJOIN_ACKs): stored
+  GDAKI_AD_RX_LATE = 5,       // this rank declined the target, or applied a decision about that incarnation: no effect
+  GDAKI_AD_RX_STALE = 6,      // the target's incarnation is STALE or FUTURE here: dropped
+  GDAKI_AD_RX_DEFER = 7,      // HELD_OLD: this rank holds that incarnation (the hold in progress): checked when it ends
+  GDAKI_AD_RX_APPLY = 8,      // CURRENT: applied now
+};
+struct gdakiAdRxIn {
+  bool sameComm = false, sameGen = false;
+  bool dup = false;
+  bool fwdCurrent = true;
+  bool self = false;
+  bool lnComplete = true;
+  bool ownJudged = false;  // this rank declined the target (or made its own decision about it)
+  bool applied = false;    // a decision about the target's incarnation was applied here
+  uint32_t targetCls = GDAKI_LN_CURRENT;  // gdakiLnClassify of the target's incarnation (read once the view is complete)
+};
+static inline uint32_t gdakiAdRxAction(const struct gdakiAdRxIn& in) {
+  if (!in.sameComm || !in.sameGen) return GDAKI_AD_RX_OTHER;
+  if (in.dup) return GDAKI_AD_RX_DUP;
+  if (!in.fwdCurrent) return GDAKI_AD_RX_FWD_STALE;
+  if (in.self) return GDAKI_AD_RX_SELF;
+  if (!in.lnComplete) return GDAKI_AD_RX_PEND;
+  if (in.ownJudged || in.applied) return GDAKI_AD_RX_LATE;
+  switch (in.targetCls) {
+    case GDAKI_LN_CURRENT: return GDAKI_AD_RX_APPLY;
+    case GDAKI_LN_HELD_OLD: return GDAKI_AD_RX_DEFER;
+    default: return GDAKI_AD_RX_STALE;
+  }
+}
+// A peer's send key: its incarnation and its record channel's generation. Moves the epoch on every change (true: a key
+// after the first, which resends what is open; *first: this was the first key).
+struct gdakiAdKey {
+  bool keyed = false;
+  uint32_t inc = 0, gen = 0, epoch = 0;
+};
+static inline bool gdakiAdKeyMove(struct gdakiAdKey* k, uint32_t inc, uint32_t gen, bool* first) {
+  *first = false;
+  if (k->keyed && k->inc == inc && k->gen == gen) return false;
+  *first = !k->keyed;
+  k->keyed = true;
+  k->inc = inc;
+  k->gen = gen;
+  k->epoch++;
+  return !*first;
+}
+// Whether an entry goes to a peer in its current epoch: 0 no, 1 the first send (an own entry in the epoch it was made in),
+// 2 a resend (a later epoch, the entry still open). epochAt: the peer's epoch when the entry was added (the first key
+// sets it for what was there); sentEpoch: the epoch it went in (0: never).
+static inline int gdakiAdTxWhat(bool own, uint32_t epochAt, uint32_t sentEpoch, uint32_t epoch, bool open) {
+  if (epoch == 0 || sentEpoch == epoch) return 0;
+  if (own && epoch == epochAt) return 1;
+  if (epoch > epochAt && open) return 2;
+  return 0;
+}
+// ---- gin-control (page): abort decisions, pure (end) ----
+// ---- gin-control (page): abort decisions, host (begin; impl/gc_unit_abortdec.cc compiles this region too) ----
+struct gdakiAdLog {
+  struct gdakiAdEntry e;
+  std::vector<uint32_t> epochAt;    // by peer
+  std::vector<uint32_t> sentEpoch;  // by peer
+};
+struct gdakiAdPeerSt {
+  struct gdakiAdKey key;
+  uint64_t tx = 0, resend = 0, rxApplied = 0, rxDup = 0, rxStale = 0, rxOther = 0, rxLate = 0, rxDeferred = 0;
+};
+struct gdakiAdState {
+  struct gdakiRecHost* r = nullptr;
+  std::mutex mu;  // the watcher's own entries against the helper (and the spare's driver before its helper)
+  int me = -1, n = 0;
+  uint64_t commHash = 0, gen = 0;
+  uint32_t nextNo = 1;
+  bool lnComplete = true;  // false from a spare's activation blob until its REJOIN_ACKs are in
+  std::vector<struct gdakiAdLog> log;
+  std::vector<struct gdakiAdPeerSt> peers;
+};
+static std::mutex gdakiAdRegMu;
+static std::vector<struct gdakiAdState*> gdakiAdReg;
+static struct gdakiAdState* gdakiAdOf(struct gdakiRecHost* r) {
+  if (r == nullptr || r->ctx == nullptr || r->nranks <= 0) return nullptr;
+  std::lock_guard<std::mutex> lk(gdakiAdRegMu);
+  for (struct gdakiAdState* a : gdakiAdReg)
+    if (a->r == r) return a;
+  struct gdakiAdState* a = new gdakiAdState();
+  a->r = r;
+  a->me = r->ctx->rank;
+  a->n = r->nranks;
+  a->peers.resize((size_t)a->n);
+  gdakiAdReg.push_back(a);
+  return a;
+}
+static void gdakiAdFree(struct gdakiRecHost* r) {
+  std::lock_guard<std::mutex> lk(gdakiAdRegMu);
+  for (size_t i = 0; i < gdakiAdReg.size(); i++)
+    if (gdakiAdReg[i]->r == r) {
+      delete gdakiAdReg[i];
+      gdakiAdReg.erase(gdakiAdReg.begin() + (long)i);
+      return;
+    }
+}
+static void gdakiAdSetCommHash(struct gdakiRecHost* r, uint64_t commHash) {
+  struct gdakiAdState* a = gdakiAdOf(r);
+  if (a == nullptr) return;
+  std::lock_guard<std::mutex> lk(a->mu);
+  a->commHash = commHash;
+}
+static void gdakiAdSetGen(struct gdakiRecHost* r, uint64_t gen) {
+  struct gdakiAdState* a = gdakiAdOf(r);
+  if (a == nullptr) return;
+  std::lock_guard<std::mutex> lk(a->mu);
+  a->gen = gen;
+}
+static uint32_t gdakiAdCauseOf(const char* lostCause, const char* why) { return gdakiAdCauseFrom(lostCause, why); }
+// The incarnation a decline of `peer` names: its hold cell's (the held, dead one while a hold runs; the live one
+// otherwise), without the lineage read (the watcher calls it too); no hold state: the known one.
+static uint32_t gdakiAdTargetInc(struct gdakiRecHost* r, int peer) {
+  struct gdakiHold* h = gdakiHoldOf(r);
+  if (h != nullptr && peer >= 0 && peer < h->nranks && peer != h->rank) return gdakiHoldIncOf(gdakiHoldLoad(h->cells[peer]));
+  return gdakiRsPeerInc(r, peer);
+}
+static void gdakiAdAppendLocked(struct gdakiAdState* a, const struct gdakiAdEntry& e) {
+  struct gdakiAdLog l;
+  l.e = e;
+  l.epochAt.resize((size_t)a->n, 0u);
+  l.sentEpoch.resize((size_t)a->n, 0u);
+  for (int q = 0; q < a->n; q++) l.epochAt[(size_t)q] = a->peers[(size_t)q].key.epoch;
+  a->log.push_back(l);
+}
+static const char* gdakiAdRxName(uint32_t x) {
+  switch (x) {
+    case GDAKI_AD_RX_OTHER: return "another communicator or generation: dropped";
+    case GDAKI_AD_RX_DUP: return "a duplicate";
+    case GDAKI_AD_RX_FWD_STALE: return "the forwarder is not its current incarnation here: dropped";
+    case GDAKI_AD_RX_SELF: return "about this rank: noted only";
+    case GDAKI_AD_RX_PEND: return "stored until this process's lineage view is complete";
+    case GDAKI_AD_RX_LATE: return "late (this rank declined it or applied a decision about it already): no effect";
+    case GDAKI_AD_RX_STALE: return "the target's incarnation is not current here: dropped";
+    case GDAKI_AD_RX_DEFER: return "deferred: this rank holds that incarnation (checked again when the hold ends)";
+    default: return "applied";
+  }
+}
+// When this rank's waits that name no peer are released (ms from now): 0 up already, -1 not scheduled.
+static double gdakiAdUaLeftMs(struct gdakiRecHost* r) {
+  std::lock_guard<std::mutex> lk(gdakiUaMu);
+  for (auto& x : gdakiUaReg)
+    if (x.comm == r->commKey) {
+      if (x.why != 0 || x.allWhy != 0) return 0.0;
+      return x.degradedAtMs != 0 ? std::max(0.0, x.degradedAtMs - gdakiQ4MonoMs()) : -1.0;
+    }
+  return -1.0;
+}
+// Apply: the decline's terminal effect through gdakiTsDecline with the policy hook off (gdakiAdApplyAt set), never a
+// FAIL; the input pause's end that the hook would note first (gdakiCkptPauseGatesEnded) is noted here.
+static void gdakiAdApply(struct gdakiRecHost* r, const struct gdakiAdEntry& e) {
+  char why[200];
+  snprintf(why, sizeof(why), "ABORT_DECIDED(rank %d, incarnation %u, no. %u, cause %s) of rank %d (incarnation %u): a "
+           "confirmed abort decision", e.target, e.targetInc, e.no, gdakiAdCauseName(e.cause), e.decider, e.deciderInc);
+  gdakiCkptPauseGatesEnded(r, e.target);
+  const double at = e.deadlineMs;
+  const double* const prev = gdakiAdApplyAt;
+  gdakiAdApplyAt = &at;
+  gdakiTsDecline(r, e.target, why, false, 0, gdakiCause::PeerDead, GDAKI_UA_PEER_DEAD);
+  gdakiAdApplyAt = prev;
+}
+static void gdakiAdCount(struct gdakiAdPeerSt* ps, uint32_t x, bool arrival) {
+  if (ps == nullptr) return;
+  switch (x) {
+    case GDAKI_AD_RX_OTHER: ps->rxOther++; break;
+    case GDAKI_AD_RX_DUP: ps->rxDup++; break;
+    case GDAKI_AD_RX_FWD_STALE: case GDAKI_AD_RX_SELF: case GDAKI_AD_RX_STALE: ps->rxStale++; break;
+    case GDAKI_AD_RX_PEND: case GDAKI_AD_RX_DEFER: if (arrival) ps->rxDeferred++; break;
+    case GDAKI_AD_RX_LATE: ps->rxLate++; break;
+    default: ps->rxApplied++; break;
+  }
+}
+// The check of a taken entry (arrival: idx -1, fwdCurrent read from the record; a stored or deferred one: its index).
+// Under no lock on entry; the lineage reads are the helper's (a spare's blob entries before its helper: stored at once).
+static void gdakiAdCheck(struct gdakiRecHost* r, struct gdakiAdState* a, struct gdakiAdEntry e, bool fwdCurrent, long idx) {
+  struct gdakiAdRxIn in;
+  struct gdakiTs* ts = r->ts;
+  const bool targetOk = e.target >= 0 && e.target < a->n;
+  {
+    std::lock_guard<std::mutex> lk(a->mu);
+    in.sameComm = e.commHash == a->commHash;
+    in.sameGen = e.gen == a->gen;
+    in.lnComplete = a->lnComplete;
+    for (size_t i = 0; i < a->log.size(); i++) {
+      const struct gdakiAdEntry& x = a->log[i].e;
+      if (idx < 0 && gdakiAdSameKey(x, e)) in.dup = true;
+      if ((long)i == idx || x.target != e.target) continue;
+      if (x.state == GDAKI_AD_S_OWN) in.ownJudged = true;
+      if (x.state == GDAKI_AD_S_APPLIED && x.targetInc == e.targetInc) in.applied = true;
+    }
+  }
+  in.fwdCurrent = fwdCurrent;
+  in.self = e.target == a->me;
+  if (!targetOk) in.sameComm = false;  // a target outside the communicator: not this communicator's
+  if (targetOk && ts != nullptr && e.target < (int)ts->peers.size() && ts->peers[(size_t)e.target].declined)
+    in.ownJudged = true;
+  if (in.sameComm && in.sameGen && !in.dup && in.fwdCurrent && !in.self && in.lnComplete && !in.ownJudged && !in.applied)
+    in.targetCls = gdakiLnClassify(gdakiLnOf(r, e.target), e.targetInc);
+  const uint32_t x = gdakiAdRxAction(in);
+  const uint32_t was = idx >= 0 ? e.state : 0u;
+  uint32_t st = 0;
+  switch (x) {
+    case GDAKI_AD_RX_PEND: st = GDAKI_AD_S_PENDING; break;
+    case GDAKI_AD_RX_DEFER: st = GDAKI_AD_S_DEFERRED; break;
+    case GDAKI_AD_RX_LATE: st = GDAKI_AD_S_LATE; break;
+    case GDAKI_AD_RX_STALE: case GDAKI_AD_RX_FWD_STALE: st = GDAKI_AD_S_STALE; break;
+    case GDAKI_AD_RX_SELF: st = GDAKI_AD_S_SELF; break;
+    case GDAKI_AD_RX_APPLY: st = GDAKI_AD_S_APPLIED; break;
+    default: break;  // other, duplicate: not logged
+  }
+  if (idx >= 0 && st == 0) st = GDAKI_AD_S_STALE;  // a stored one that no longer names this communicator: dropped
+  if (idx >= 0 && st == was) return;  // still stored or deferred: nothing new
+  {
+    std::lock_guard<std::mutex> lk(a->mu);
+    const int c = e.from >= 0 && e.from < a->n ? e.from : -1;
+    gdakiAdCount(c >= 0 ? &a->peers[(size_t)c] : nullptr, x, idx < 0);
+    if (st != 0) {
+      e.state = st;
+      if (idx < 0) gdakiAdAppendLocked(a, e);
+      else if ((size_t)idx < a->log.size()) a->log[(size_t)idx].e.state = st;
+    }
+  }
+  double left = -1.0;
+  if (x == GDAKI_AD_RX_APPLY) {
+    gdakiAdApply(r, e);
+    left = gdakiAdUaLeftMs(r);
+  }
+  char rel[64] = {0};
+  if (x == GDAKI_AD_RX_APPLY && left >= 0) snprintf(rel, sizeof(rel), ", waits released in %.1f ms", left);
+  else if (x == GDAKI_AD_RX_APPLY) snprintf(rel, sizeof(rel), ", no release scheduled");
+  GIN_TS_NOTE("GIN/RC: rank %d: ABORT_DECIDED(rank %d, incarnation %u, no. %u, cause %s) of rank %d (incarnation %u) from "
+              "rank %d via %s%s: %s%s%s mono_ms=%.3f", a->me, e.target, e.targetInc, e.no, gdakiAdCauseName(e.cause),
+              e.decider, e.deciderInc, e.from, e.blob ? "the activation blob" : "record 57",
+              idx >= 0 ? " (checked again)" : "", gdakiAdRxName(x), rel,
+              x == GDAKI_AD_RX_APPLY ? " (no hold, no fence)" : "", gdakiQ4MonoMs());
+}
+static void gdakiAdOnRecord(struct gdakiRecHost* r, int from, const struct gdakiTsMsg& m) {
+  struct gdakiAdState* a = gdakiAdOf(r);
+  if (a == nullptr) return;
+  uint32_t fwdInc = 0;
+  const struct gdakiAdEntry e = gdakiAdOfMsg(m, from, gdakiQ4MonoMs(), &fwdInc);
+  const bool fwdCurrent =
+      from >= 0 && from < a->n && from != a->me && gdakiLnClassify(gdakiLnOf(r, from), fwdInc) == GDAKI_LN_CURRENT;
+  gdakiAdCheck(r, a, e, fwdCurrent, -1);
+}
+// Record 57 to every peer it is owed to (helper only).
+static void gdakiAdPump(struct gdakiRecHost* r, struct gdakiAdState* a) {
+  struct gdakiTs* ts = r->ts;
+  if (ts == nullptr) return;
+  const uint32_t selfInc = gdakiRsSelfInc(r);
+  for (int q = 0; q < a->n && q < (int)ts->peers.size(); q++) {
+    if (q == a->me) continue;
+    const struct gdakiLnView lv = gdakiLnOf(r, q);
+    if (lv.phase != GDAKI_LN_LIVE || !gdakiCtrlChanUp(r, q)) continue;  // not live here, or no channel yet: later
+    const uint32_t gen = gdakiCtrlChanGen(r, q, ts->peers[(size_t)q]);
+    struct Out {
+      size_t i;
+      int what;
+      struct gdakiAdEntry e;
+    };
+    std::vector<struct Out> out;
+    uint32_t epoch = 0;
+    bool again = false;
+    {
+      std::lock_guard<std::mutex> lk(a->mu);
+      struct gdakiAdPeerSt& ps = a->peers[(size_t)q];
+      bool first = false;
+      again = gdakiAdKeyMove(&ps.key, lv.cur, gen, &first);
+      epoch = ps.key.epoch;
+      if (first)  // what this rank had before it first saw the peer is the peer's too (no re-broadcast)
+        for (struct gdakiAdLog& l : a->log)
+          if (l.epochAt[(size_t)q] == 0) l.epochAt[(size_t)q] = epoch;
+      const double now = gdakiQ4MonoMs();
+      for (size_t i = 0; i < a->log.size(); i++) {
+        const struct gdakiAdLog& l = a->log[i];
+        if (!gdakiAdForwardable(l.e) || l.e.target == q || (l.e.decider == q && l.e.deciderInc == lv.cur)) continue;
+        const int w = gdakiAdTxWhat(l.e.state == GDAKI_AD_S_OWN, l.epochAt[(size_t)q], l.sentEpoch[(size_t)q], epoch,
+                                    gdakiAdOpen(l.e, now));
+        if (w != 0) out.push_back({i, w, l.e});
+      }
+    }
+    if (again && !out.empty())
+      GIN_TS_NOTE("GIN/RC: rank %d: rank %d's record channel is live again (incarnation %u, generation %u): %zu open "
+                  "abort decision(s) owed to it mono_ms=%.3f", a->me, q, lv.cur, gen, out.size(), gdakiQ4MonoMs());
+    for (const struct Out& o : out) {
+      struct gdakiTsMsg m;
+      const double now = gdakiQ4MonoMs();
+      gdakiAdMsgOf(o.e, selfInc, now, &m);
+      if (gdakiHoldSend(r, q, &m) != 0) break;  // the channel went down or stayed full: the next step
+      {
+        std::lock_guard<std::mutex> lk(a->mu);
+        struct gdakiAdPeerSt& ps = a->peers[(size_t)q];
+        if (o.i < a->log.size() && ps.key.epoch == epoch) a->log[o.i].sentEpoch[(size_t)q] = epoch;
+        ps.tx++;
+        if (o.what == 2) ps.resend++;
+      }
+      GIN_TS_NOTE("GIN/RC: rank %d: ABORT_DECIDED(rank %d, incarnation %u, no. %u, cause %s) of rank %d (incarnation %u) "
+                  "%s rank %d (incarnation %u), %.1f ms left mono_ms=%.3f", a->me, o.e.target, o.e.targetInc, o.e.no,
+                  gdakiAdCauseName(o.e.cause), o.e.decider, o.e.deciderInc, o.what == 2 ? "sent again to" : "sent to", q,
+                  lv.cur, m.t[0], now);
+    }
+  }
+}
+// A move of the communicator's words this rank made (gdakiTsDecline, gdakiHoldWatchdog): its log entry; the helper
+// sends it at once when it is not inside a round (else at its next step), the watcher never sends.
+static void gdakiAdOnTransition(struct gdakiRecHost* r, int peer, uint32_t targetInc, uint32_t cause,
+                                const struct gdakiUaTrans& t, bool watcher) {
+  if (t.kind == 0) return;
+  struct gdakiAdState* a = gdakiAdOf(r);
+  if (a == nullptr) return;
+  const uint32_t selfInc = gdakiRsSelfInc(r);
+  const double now = gdakiQ4MonoMs();
+  struct gdakiAdEntry e;
+  {
+    std::lock_guard<std::mutex> lk(a->mu);
+    e.commHash = a->commHash;
+    e.gen = a->gen;
+    e.target = peer;
+    e.targetInc = targetInc;
+    e.decider = a->me;
+    e.deciderInc = selfInc;
+    e.no = a->nextNo++;
+    e.cause = t.kind == 2 ? (uint32_t)GDAKI_AD_C_EVERY : cause;
+    e.deciderDeadlineMs = e.deadlineMs = t.deadlineMs;
+    e.learnedMs = now;
+    e.from = -1;
+    e.state = GDAKI_AD_S_OWN;
+    gdakiAdAppendLocked(a, e);
+  }
+  GIN_TS_NOTE("GIN/RC: rank %d: confirmed abort decision no. %u (incarnation %u): rank %d (incarnation %u), cause %s, "
+              "waits that name no peer released %s%.1f ms (%s) mono_ms=%.3f", a->me, e.no, selfInc, peer, targetInc,
+              gdakiAdCauseName(e.cause), t.deadlineMs < 0 ? "never: " : "in ",
+              t.deadlineMs < 0 ? 0.0 : std::max(0.0, t.deadlineMs - now),
+              watcher ? "the watcher's move: the helper sends it" : "sent by the helper", now);
+  if (!watcher && gdakiTsInHelper && gdakiTsOwner == r && r->ts != nullptr &&
+      r->ts->busySinceUs.load(std::memory_order_acquire) == 0)
+    gdakiAdPump(r, a);
+}
+// Every helper step: the stored and deferred entries checked again (once the view is complete), then the sends.
+static void gdakiAdHelperStep(struct gdakiRecHost* r) {
+  struct gdakiAdState* a = gdakiAdOf(r);
+  if (a == nullptr) return;
+  std::vector<std::pair<long, struct gdakiAdEntry>> again;
+  {
+    std::lock_guard<std::mutex> lk(a->mu);
+    if (a->lnComplete)
+      for (size_t i = 0; i < a->log.size(); i++)
+        if (a->log[i].e.state == GDAKI_AD_S_PENDING || a->log[i].e.state == GDAKI_AD_S_DEFERRED)
+          again.push_back({(long)i, a->log[i].e});
+  }
+  for (const auto& x : again) gdakiAdCheck(r, a, x.second, true, x.first);
+  gdakiAdPump(r, a);
+}
+// The buddy, building rank `peer`'s activation blob: the open entries not about it ("GAAD" after the UD table).
+static void gdakiAdBlobFor(struct gdakiRecHost* r, int peer, std::vector<uint8_t>* bytes) {
+  struct gdakiAdState* a = gdakiAdOf(r);
+  if (a == nullptr) return;
+  const uint32_t selfInc = gdakiRsSelfInc(r);
+  const double now = gdakiQ4MonoMs();
+  std::vector<struct gdakiAdWire> w;
+  {
+    std::lock_guard<std::mutex> lk(a->mu);
+    for (const struct gdakiAdLog& l : a->log)
+      if (gdakiAdForwardable(l.e) && gdakiAdOpen(l.e, now) && l.e.target != peer) w.push_back(gdakiAdWireOf(l.e, selfInc, now));
+  }
+  // the newest that fit: GDAKI_AD_BLOB_MAX_N, and the launcher's payload with what the blob holds already
+  const size_t room = bytes->size() + sizeof(struct gdakiAdBlobHdr) < GDAKI_AD_BLOB_PAYLOAD
+                          ? (GDAKI_AD_BLOB_PAYLOAD - bytes->size() - sizeof(struct gdakiAdBlobHdr)) / sizeof(struct gdakiAdWire)
+                          : 0u;
+  const size_t keep = std::min<size_t>(GDAKI_AD_BLOB_MAX_N, room);
+  if (w.size() > keep) {
+    GIN_TS_NOTE("GIN/RC: rank %d: %zu open abort decision(s) for rank %d's activation blob, %zu fit: the newest go (the "
+                "rest by record 57 once its channel is live) mono_ms=%.3f", a->me, w.size(), peer, keep, now);
+    w.erase(w.begin(), w.end() - (long)keep);
+  }
+  if (w.empty()) return;
+  gdakiAdBlobPut(w, bytes);
+  GIN_TS_NOTE("GIN/RC: rank %d: %zu open abort decision(s) in rank %d's activation blob mono_ms=%.3f", a->me, w.size(), peer,
+              now);
+}
+// The spare, reading its activation blob (before its REJOINs): every entry stored (its view is not complete yet).
+static bool gdakiAdBlobTake(struct gdakiRecHost* r, const uint8_t* p, size_t n) {
+  std::vector<struct gdakiAdWire> w;
+  if (!gdakiAdBlobGet(p, n, r != nullptr ? r->nranks : 0, &w)) return false;
+  if (w.empty()) return true;
+  struct gdakiAdState* a = gdakiAdOf(r);
+  if (a == nullptr) return true;
+  {
+    std::lock_guard<std::mutex> lk(a->mu);
+    a->lnComplete = false;
+  }
+  const int buddy = gdakiHoldBuddyOf(a->me, a->n);
+  const double now = gdakiQ4MonoMs();
+  for (const struct gdakiAdWire& x : w) gdakiAdCheck(r, a, gdakiAdOfWire(x, buddy, now), true, -1);
+  return true;
+}
+static void gdakiAdLineageComplete(struct gdakiRecHost* r) {
+  struct gdakiAdState* a = gdakiAdOf(r);
+  if (a == nullptr) return;
+  size_t n = 0;
+  {
+    std::lock_guard<std::mutex> lk(a->mu);
+    if (a->lnComplete) return;
+    a->lnComplete = true;
+    for (const struct gdakiAdLog& l : a->log) n += l.e.state == GDAKI_AD_S_PENDING ? 1u : 0u;
+  }
+  GIN_TS_NOTE("GIN/RC: rank %d: the lineage view is complete (REJOIN_ACKs in): %zu stored abort decision(s) checked by the "
+              "helper now mono_ms=%.3f", a->me, n, gdakiQ4MonoMs());
+}
+static void gdakiAdSummaryOf(struct gdakiRecHost* r, int peer, char* out, size_t len) {
+  struct gdakiAdPeerSt ps;
+  struct gdakiAdState* a = gdakiAdOf(r);
+  if (a != nullptr && peer >= 0 && peer < a->n) {
+    std::lock_guard<std::mutex> lk(a->mu);
+    ps = a->peers[(size_t)peer];
+  }
+  snprintf(out, len, "ad_tx=%lu ad_rx_applied=%lu ad_rx_dup=%lu ad_rx_stale=%lu ad_rx_other=%lu ad_rx_late=%lu "
+           "ad_rx_deferred=%lu ad_resend=%lu", (unsigned long)ps.tx, (unsigned long)ps.rxApplied, (unsigned long)ps.rxDup,
+           (unsigned long)ps.rxStale, (unsigned long)ps.rxOther, (unsigned long)ps.rxLate, (unsigned long)ps.rxDeferred,
+           (unsigned long)ps.resend);
+}
