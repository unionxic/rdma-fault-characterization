+// The device staging: allocated at the first checkpoint of an image size (and again only when the image grows), freed
+// in gdakiStoreFree. Never while a copy may still read it (gdakiSnapStageWait first).
+static bool gdakiSnapStageAlloc(struct gdakiRecHost* r, struct gdakiStoreState* st, uint64_t image) {
+  struct gdakiSnapStage& s = st->snap;
+  if (gdakiSnapStageFits(s, image)) return true;
+  if (s.dev != nullptr) (void)cudaFree(s.dev);
+  s.dev = nullptr;
+  s.bytes = 0;
+  if (cudaMalloc(&s.dev, (size_t)image) != cudaSuccess) {
+    s.dev = nullptr;
+    WARN("GIN/CTRL: rank %d: cannot allocate %lu bytes of GPU memory for the checkpoint snapshot (mirror off) "
+         "mono_ms=%.3f", r->ctx->rank, (unsigned long)image, gdakiQ4MonoMs());
+    return false;
+  }
+  s.bytes = image;
+  INFO(NCCL_NET, "GIN/CTRL: rank %d: device staging of %lu bytes for the checkpoint snapshot (mirror off) mono_ms=%.3f",
+       r->ctx->rank, (unsigned long)image, gdakiQ4MonoMs());
+  return true;
+}
+// "staging busy": the previous snapshot's copy to the pinned slot did not end (its synchronize failed): wait for the
+// copy stream before this checkpoint's pause starts (the D2D would overwrite what the copy may still read). A line when
+// it waits; false (no checkpoint now, backed off) when the stream does not end cleanly.
+static bool gdakiSnapStageWait(struct gdakiRecHost* r, struct gdakiCkpt* ck, struct gdakiStoreState* st, uint64_t step) {
+  struct gdakiSnapStage& s = st->snap;
+  if (!s.busy) return true;
+  s.nBusyWaits++;
+  const double t0 = gdakiQ4MonoMs();
+  const bool synced = ck->copyStream != nullptr && cudaStreamSynchronize(ck->copyStream) == cudaSuccess;
+  gdakiSnapReleased(&s, synced);
+  GIN_TS_NOTE("GIN/CTRL: rank %d: staging busy: the device staging still held checkpoint %lu's snapshot before checkpoint "
+              "%lu's pause; waited %.0f us for the copy stream (%s) waits=%lld mono_ms=%.3f", r->ctx->rank,
+              (unsigned long)s.busyCkpt, (unsigned long)step, (gdakiQ4MonoMs() - t0) * 1000.0,
+              synced ? "free now" : "it failed: no checkpoint now", s.nBusyWaits, gdakiQ4MonoMs());
+  return synced;
+}
+// A plan's copies on the copy stream (queued only; the caller synchronizes): D2D from the regions (cudaMemcpyDefault:
+// a region outside GPU memory is copied too), D2H from the device staging into the pinned slot.
+static bool gdakiSnapRun(struct gdakiStoreState* st, const std::vector<struct gdakiCkptRegionSrc>& regs,
+                         const struct gdakiSnapCopy* c, int n, cudaStream_t stream) {
+  uint8_t* dev = (uint8_t*)st->snap.dev;
+  for (int i = 0; i < n; i++) {
+    const bool d2d = c[i].kind == GDAKI_SNAP_D2D;
+    if (c[i].region >= regs.size()) return false;
+    if (cudaMemcpyAsync(d2d ? (void*)(dev + c[i].dstOff) : (void*)(st->stage + c[i].dstOff),
+                        d2d ? regs[c[i].region].src : (const void*)(dev + c[i].srcOff), (size_t)c[i].bytes,
+                        d2d ? cudaMemcpyDefault : cudaMemcpyDeviceToHost, stream) != cudaSuccess)
+      return false;
+  }
+  return true;
+}
