+// The mirror-off checkpoint pause as a GPU-side snapshot (the user's choice of 2026-10-22; impl/notes_snap.md). Inside the
+// input pause only one device-to-device copy per image region into a device staging buffer laid out as the image (region
+// i at off[i]), on the checkpoint's copy stream; after the pause (the helper armed the WRITE: CKPT_RESUME went out) one
+// copy per region from the device staging into the pinned slot (where 2b's D2H put it), the header and the blob, then
+// 2b's WRITE. CKPT_STABLE still follows the WRITE's end (the helper's CONFIRMING). The mirror on keeps 2b's pause (D2H).
+enum : uint32_t { GDAKI_SNAP_D2D = 1, GDAKI_SNAP_D2H = 2 };
+struct gdakiSnapCopy {
+  uint32_t kind;    // GDAKI_SNAP_D2D: region -> device staging; GDAKI_SNAP_D2H: device staging -> pinned slot
+  uint32_t region;  // the region whose bytes move
+  uint64_t dstOff;  // D2D: in the device staging; D2H: in the pinned slot (its header first)
+  uint64_t srcOff;  // D2D: 0 (the region's start); D2H: in the device staging
+  uint64_t bytes;
+};
+// The pause's copies (n regions at off[], bytes[]): one D2D per region, nothing else. out: GDAKI_CKPT_MAX_REGIONS entries.
+static inline int gdakiSnapPausePlan(const uint64_t* off, const uint64_t* bytes, int n, struct gdakiSnapCopy* out) {
+  int k = 0;
+  for (int i = 0; i < n && i < GDAKI_CKPT_MAX_REGIONS; i++) out[k++] = {GDAKI_SNAP_D2D, (uint32_t)i, off[i], 0, bytes[i]};
+  return k;
+}
+// The copies after the pause: one D2H per region into the slot at 2b's offsets (header room first), from the snapshot.
+static inline int gdakiSnapAfterPlan(const uint64_t* off, const uint64_t* bytes, int n, struct gdakiSnapCopy* out) {
+  int k = 0;
+  for (int i = 0; i < n && i < GDAKI_CKPT_MAX_REGIONS; i++)
+    out[k++] = {GDAKI_SNAP_D2H, (uint32_t)i, GDAKI_STORE_HDR_BYTES + off[i], off[i], bytes[i]};
+  return k;
+}
+// A plan's bytes by kind (the pause model: host-side bytes are the D2H ones).
+struct gdakiSnapBytes {
+  uint64_t d2d = 0, d2h = 0;
+};
+static inline struct gdakiSnapBytes gdakiSnapBytesOf(const struct gdakiSnapCopy* c, int n) {
+  struct gdakiSnapBytes b;
+  for (int i = 0; i < n; i++) (c[i].kind == GDAKI_SNAP_D2D ? b.d2d : b.d2h) += c[i].bytes;
+  return b;
+}
+// The device staging buffer (struct gdakiStoreState::snap; the application thread only). busy: from the pause's first
+// D2D of checkpoint busyCkpt until the copy stream is known idle again (its synchronize returned cudaSuccess after the
+// D2H, or after the pause's copies when no D2H follows); a failed synchronize leaves it busy, and the next pause does not
+// start before the stream ended (gdakiSnapStageWait).
+struct gdakiSnapStage {
+  void* dev = nullptr;  // cudaMalloc'd, `bytes` long (the image's layout size)
+  uint64_t bytes = 0;
+  bool busy = false;
+  uint64_t busyCkpt = 0;
+  long long nBusyWaits = 0;
+};
+static inline bool gdakiSnapStageFits(const struct gdakiSnapStage& s, uint64_t image) {
+  return s.dev != nullptr && s.bytes >= image;
+}
+// the pause's D2D copies are queued: the staging holds (or gets) checkpoint ckpt's snapshot, busy until the copy stream
+// is known idle after its D2H (or after the pause's copies when no D2H follows)
+static inline void gdakiSnapTaken(struct gdakiSnapStage* s, uint64_t ckpt) {
+  s->busy = true;
+  s->busyCkpt = ckpt;
+}
+// no copy reads the staging any more: its D2H ended (synced == true), or the checkpoint ended before a D2H was queued
+static inline void gdakiSnapReleased(struct gdakiSnapStage* s, bool synced) {
+  if (synced) s->busy = false;
+}
+// the device staging the mirror off adds per rank (the memory line): the image's layout size; 0 with the mirror on
+static inline uint64_t gdakiSnapDevBytes(bool miOn, uint64_t image) { return miOn ? 0 : image; }
+#endif  // !NCCL_GIN_CTRL_TCP
