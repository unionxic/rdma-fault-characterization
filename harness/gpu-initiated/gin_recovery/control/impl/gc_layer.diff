+static_assert(sizeof(gdakiTsMsg::nrp) == GDAKI_CTRL_NRP_BYTES, "gdakiTsMsg::nrp holds the REJOIN's control endpoints");
+static_assert(offsetof(struct gdakiTsMsg, nrp) % 8 == 0, "gdakiTsMsg::nrp is 8 B aligned (gdakiCtrlNrpPut/Get copy it)");
+static_assert(GDAKI_CTRL_QPT_RC == (uint32_t)IBV_QPT_RC && GDAKI_CTRL_QPT_UD == (uint32_t)IBV_QPT_UD, "the QP types");
+static_assert(GDAKI_CTRL_ACC_LOCAL_WRITE == (uint32_t)IBV_ACCESS_LOCAL_WRITE &&
+                  GDAKI_CTRL_ACC_REMOTE_WRITE == (uint32_t)IBV_ACCESS_REMOTE_WRITE &&
