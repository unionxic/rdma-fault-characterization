+// ---- an owner thread's CQ (design v2 2.1; impl/rs_ctrl_api.h's lifetime rule) ----
+// One per owner thread (the helper's: GDAKI_CTRL_HELPER_CQ with a completion channel; the watch thread's:
+// GDAKI_CTRL_WATCH_CQ), its own ncclIbStats as cq_context (the async-event thread counts a CQ error there); destroyed
+// after every QP on it.
+struct gdakiCtrlCq {
+  struct ncclIbStats stats;
+  struct ibv_cq* cq = nullptr;
+  struct ibv_comp_channel* channel = nullptr;
+};
+[[maybe_unused]] static ncclResult_t gdakiCtrlCqCreate(struct gdakiRecHost* r, int depth, bool withChannel,
+                                                      struct gdakiCtrlCq** out, char* why, size_t whyLen) {
+  *out = nullptr;
+  struct gdaki_context* g = r != nullptr ? r->ctx : nullptr;
+  struct ibv_context* ictx = (g != nullptr && g->collComm != nullptr) ? g->collComm->ib.context : nullptr;
+  if (ictx == nullptr || depth < 1) {
+    snprintf(why, whyLen, "no GIN context for a CQ (depth %d)", depth);
+    return ncclInternalError;
+  }
+  struct gdakiCtrlCq* c = new gdakiCtrlCq();
+  (void)ncclIbStatsInit(&c->stats);
+  if (withChannel && wrap_ibv_create_comp_channel(&c->channel, ictx) != ncclSuccess) {
+    delete c;
+    snprintf(why, whyLen, "cannot create a completion channel");
+    return ncclSystemError;
+  }
+  if (wrap_ibv_create_cq(&c->cq, ictx, depth, &c->stats, c->channel, 0) != ncclSuccess) {
+    if (c->channel != nullptr) (void)wrap_ibv_destroy_comp_channel(c->channel);
+    delete c;
+    snprintf(why, whyLen, "cannot create a CQ of %d entries", depth);
+    return ncclSystemError;
+  }
+  *out = c;
+  return ncclSuccess;
+}
+// After every QP on it is destroyed. False: kept (a CQ that cannot be destroyed keeps its stats alive, as the template).
+[[maybe_unused]] static bool gdakiCtrlCqDestroy(struct gdakiCtrlCq* c) {
+  if (c == nullptr) return true;
+  if (c->cq != nullptr && wrap_ibv_destroy_cq(c->cq) != ncclSuccess) {
+    WARN("GIN/RC: a control CQ could not be destroyed; its state is kept mono_ms=%.3f", gdakiQ4MonoMs());
+    return false;
+  }
+  c->cq = nullptr;
+  if (c->channel != nullptr) (void)wrap_ibv_destroy_comp_channel(c->channel);
+  delete c;
+  return true;
+}
