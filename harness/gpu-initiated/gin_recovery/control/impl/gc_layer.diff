+// ---- the liveness READ QP (impl/rs_ctrl_api.h; the watch thread owns it once phase 1 hands it over) ----
+static ncclResult_t gdakiProbeQpCreate(struct gdakiRecHost* r, int peer, struct gdakiProbeQp* out, char* why, size_t whyLen) {
+  if (out == nullptr) {
+    snprintf(why, whyLen, "no probe QP slot");
+    return ncclInvalidUsage;
+  }
+  *out = gdakiProbeQp();
+  struct gdakiMiQpEndpoint v1;
+  const struct gdakiCtrlQpAttr attr = gdakiCtrlQpAttrProbe((uint8_t)ncclParamIbTimeout(), nullptr);
+  const ncclResult_t res = gdakiMiHostQpCreate(r, 1, &out->q, &v1, why, whyLen, attr);
+  if (res != ncclSuccess) return res;
+  out->local = gdakiCtrlEndpointOf(v1, GDAKI_CTRL_QPT_RC);
+  out->peer = peer;
+  return ncclSuccess;
+}
+static void gdakiProbeQpEndpoint(const struct gdakiProbeQp* q, struct gdakiCtrlEndpoint* out) {
+  if (q != nullptr && out != nullptr) *out = q->local;
+}
+static ncclResult_t gdakiProbeQpConnect(struct gdakiProbeQp* q, const struct gdakiCtrlEndpoint* remote, uint32_t gen,
+                                        char* why, size_t whyLen) {
+  if (q == nullptr || q->q == nullptr || remote == nullptr || !gdakiCtrlEndpointOk(*remote) ||
+      remote->qpType != GDAKI_CTRL_QPT_RC) {
+    snprintf(why, whyLen, "no probe QP or not a well-formed RC endpoint");
+    return ncclInvalidUsage;
+  }
+  const ncclResult_t res = gdakiMiHostQpConnect(q->q, gdakiCtrlEndpointV1(*remote), why, whyLen);
+  if (res != ncclSuccess) return res;
+  q->remote = *remote;
+  q->gen = gen;
+  q->connected = true;
+  return ncclSuccess;
+}
+// ERR or RTS -> RESET -> INIT with a fresh PSN (q->local carries it), then RTR/RTS toward `remote` when it is given (the
+// answering side of a PAIR); the caller has collected the QP's flushed completions first (phase 1's handoff).
+static ncclResult_t gdakiProbeQpReconnect(struct gdakiProbeQp* q, const struct gdakiCtrlEndpoint* remote, uint32_t gen,
+                                          char* why, size_t whyLen) {
+  if (q == nullptr || q->q == nullptr || q->q->qp == nullptr) {
+    snprintf(why, whyLen, "no probe QP");
+    return ncclInvalidUsage;
+  }
+  struct gdakiMiHostQp* h = q->q;
+  struct ibv_qp_attr a;
+  memset(&a, 0, sizeof(a));
+  a.qp_state = IBV_QPS_RESET;
+  if (wrap_ibv_modify_qp(h->qp, &a, IBV_QP_STATE) != ncclSuccess) {
+    snprintf(why, whyLen, "cannot move the probe QP to RESET");
+    return ncclSystemError;
+  }
+  memset(&a, 0, sizeof(a));
+  a.qp_state = IBV_QPS_INIT;
+  a.pkey_index = h->pkeyIndex;
+  a.port_num = h->port;
+  a.qp_access_flags = (int)h->attr.access;
+  if (wrap_ibv_modify_qp(h->qp, &a, IBV_QP_STATE | IBV_QP_PKEY_INDEX | IBV_QP_PORT | IBV_QP_ACCESS_FLAGS) != ncclSuccess) {
+    snprintf(why, whyLen, "cannot move the probe QP back to INIT");
+    return ncclSystemError;
+  }
+  h->psn = gdakiMiHostQpPsn();
+  h->err = false;
+  h->outstanding = 0;
+  q->local.psn = h->psn;
+  q->connected = false;
+  q->gen = gen;
+  if (remote == nullptr) return ncclSuccess;
+  return gdakiProbeQpConnect(q, remote, gen, why, whyLen);
+}
+static bool gdakiProbeQpIsRts(const struct gdakiProbeQp* q) {
+  if (q == nullptr || q->q == nullptr || q->q->qp == nullptr) return false;
+  struct ibv_qp_attr a;
+  struct ibv_qp_init_attr ia;
+  memset(&a, 0, sizeof(a));
+  memset(&ia, 0, sizeof(ia));
+  return wrap_ibv_query_qp(q->q->qp, &a, IBV_QP_STATE, &ia) == ncclSuccess && a.qp_state == IBV_QPS_RTS;
+}
+static void gdakiProbeQpDestroy(struct gdakiProbeQp* q) {
+  if (q == nullptr) return;
+  gdakiMiHostQpDestroy(q->q);  // kept (with a WARN) when the QP or its CQ cannot be destroyed
+  *q = gdakiProbeQp();
+}
