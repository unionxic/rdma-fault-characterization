+    uint32_t v = doca_gpu_dev_verbs_load_relaxed_sys_global((uint32_t*)(cqe + 4 * w));
+    out[4 * w + 0] = v & 0xff;
+    out[4 * w + 1] = (v >> 8) & 0xff;
+    out[4 * w + 2] = (v >> 16) & 0xff;
+    out[4 * w + 3] = (v >> 24) & 0xff;
+  }
+}
