+// mode sq_wqe_pi is only maintained when DOCA_GPUNETIO_VERBS_GPU_CODE_OPT_CPU_PROXY_UPDATE_PI is
+// passed to submit. Stock NCCL never passes it (its CQ is a ring, whose poll does not look at
+// sq_wqe_pi), so with NCCL_GIN_GDAKI_CQ_TYPE=collapsed the first SQ wrap spins forever. Set the
+// flag for collapsed CQs only; ring CQs (stock) get the stock code options.
+NCCL_DEVICE_INLINE static uint32_t q4CollapsedCodeOpt(doca_gpu_dev_verbs_qp* qp, uint32_t codeOpt) {
+  const uint8_t t = doca_gpu_dev_verbs_load_const((uint8_t*)&qp->cq_sq.cq_type);
+  return (t & DOCA_GPUNETIO_VERBS_CQ_FLAG_COLLAPSED) ? (codeOpt | DOCA_GPUNETIO_VERBS_GPU_CODE_OPT_CPU_PROXY_UPDATE_PI)
