+// ---------------------------------------------------------------------------
+// GIN transparent recovery S1 (research build): device pause gate (struct ncclGinTsGate in the
+// reserved2 padding of the device QP, ncclGinTsGate2 in reserved1). Off (flags == 0, the default):
+// one plain load of the gate flags per post/flush/wait and nothing else; the slow paths below are
+// out of line so they do not change the code of the stock paths.
+// ---------------------------------------------------------------------------
+static_assert(offsetof(struct doca_gpu_dev_verbs_qp, reserved2) % 8 == 0, "gate must be 8-byte aligned");
+static_assert(sizeof(((struct doca_gpu_dev_verbs_qp*)0)->reserved2) == sizeof(struct ncclGinTsGate),
+              "gate must fill reserved2 exactly");
+static_assert(offsetof(struct doca_gpu_dev_verbs_qp, reserved1) % 8 == 0, "gate2 must be 8-byte aligned");
+static_assert(sizeof(((struct doca_gpu_dev_verbs_qp*)0)->reserved1) == sizeof(struct ncclGinTsGate2),
+              "gate2 must fill reserved1 exactly");
+static_assert(sizeof(struct doca_gpu_dev_verbs_qp) % 8 == 0, "device QP array stride must keep the gate aligned");
+#define NCCL_GIN_TS_EPOCH_ANY 0xffffffffu  // tsPollEnter: accept the current stable epoch
+#define NCCL_GIN_TS_EPOCH_BAD 0xfffffffeu  // request: no valid ticket (declined / no stable epoch in time)
+
+NCCL_DEVICE_INLINE static struct ncclGinTsGate* tsGate(doca_gpu_dev_verbs_qp* qp) {
+  return reinterpret_cast<struct ncclGinTsGate*>(qp->reserved2);
+}
+NCCL_DEVICE_INLINE static struct ncclGinTsGate2* tsGate2(doca_gpu_dev_verbs_qp* qp) {
+  return reinterpret_cast<struct ncclGinTsGate2*>(qp->reserved1);
+}
+// Written once by the host before any kernel can use the QP, so a plain (cacheable) load is enough.
+NCCL_DEVICE_INLINE static bool tsOn(doca_gpu_dev_verbs_qp* qp) { return (tsGate(qp)->flags & NCCL_GIN_TS_F_ON) != 0; }
+NCCL_DEVICE_INLINE static uint32_t tsLoadAcquireSys(uint32_t* p) {
+  uint32_t v;
+  asm volatile("ld.acquire.sys.global.u32 %0, [%1];" : "=r"(v) : "l"(p) : "memory");
+  return v;
+}
+NCCL_DEVICE_INLINE static uint32_t tsLoadRelaxedSys(uint32_t* p) {
+  uint32_t v;
+  asm volatile("ld.relaxed.sys.global.u32 %0, [%1];" : "=r"(v) : "l"(p) : "memory");
+  return v;
+}
+NCCL_DEVICE_INLINE static uint64_t tsLoadRelaxedSys64(uint64_t* p) {
+  uint64_t v;
+  asm volatile("ld.relaxed.sys.global.u64 %0, [%1];" : "=l"(v) : "l"(p) : "memory");
+  return v;
+}
+// Release decrement: everything this thread did before (WQE writes, index atomics, doorbell record,
+// CQ consumer index) is visible before the host can read the counter as 0.
+NCCL_DEVICE_INLINE static void tsReleaseDec(uint32_t* p) {
+  asm volatile("red.release.sys.global.add.u32 [%0], %1;" ::"l"(p), "r"(0xffffffffu) : "memory");
+}
+NCCL_DEVICE_INLINE static uint64_t tsNowNs() {
+  uint64_t t;
+  asm volatile("mov.u64 %0, %%globaltimer;" : "=l"(t));
+  return t;
+}
+
+// Enter the post critical section of `qp` (before a WQE slot is reserved). Dekker with the host,
+// which writes pause=1 and afterwards reads `active` (two copies on one stream, the read issued
+// only after the write completed): our increment is ordered before our pause load by the
+// system-scope sequentially consistent fence, so the host either reads active > 0 (and waits for
+// us) or we read pause == 1 (and back out). A parked poster is uncounted and holds no WQE slot. The
+// acquire load makes the posting code below read the QP state the host left after a recovery.
+__device__ __noinline__ static void tsGateEnter(doca_gpu_dev_verbs_qp* qp) {
+  struct ncclGinTsGate* g = tsGate(qp);
+  while (true) {
+    atomicAdd(&g->active, 1u);
+    __threadfence_system();
+    if (tsLoadAcquireSys(&g->pause) == 0) return;
+    tsReleaseDec(&g->active);
+    // Parked until the host publishes or declines (it always clears pause, within its bounded round).
+    while (tsLoadAcquireSys(&g->pause) != 0) __nanosleep(1000);
+  }
+}
+NCCL_DEVICE_INLINE static void tsGateLeave(doca_gpu_dev_verbs_qp* qp) { tsReleaseDec(&tsGate(qp)->active); }
+// A WQE that is not one request message at the responder (NOP, DUMP) or one S1 does not replay (READ)
+// was posted in this epoch: the host then declines, because it counts executed WQEs by the responder's
+// message sequence number.
+#define NCCL_GIN_TS_NONMSG_NOP 0x1u
+#define NCCL_GIN_TS_NONMSG_DUMP 0x2u
+#define NCCL_GIN_TS_NONMSG_READ 0x4u
+NCCL_DEVICE_INLINE static void tsMarkNonMsg(doca_gpu_dev_verbs_qp* qp, uint32_t bit) { atomicOr(&tsGate(qp)->nonmsg, bit); }
+
+// Counted poll region. A waiter polls (and may advance cq_sq.cqe_ci) only inside it, and only while
+// the epoch is stable and unchanged; the host makes the epoch odd, then waits for pollers == 0 before
+// it rewrites cqe_ci, cqe_rsvd, the indices or lbase. Same Dekker argument as the gate. Callers park
+// (tsParkStable) before entering, so a recovery in progress sees no counter traffic from them.
+// *e: NCCL_GIN_TS_EPOCH_ANY (set to the current stable epoch) or the epoch that must still be current.
+NCCL_DEVICE_INLINE static void tsPollLeave(doca_gpu_dev_verbs_qp* qp) { tsReleaseDec(&tsGate2(qp)->pollers); }
+NCCL_DEVICE_INLINE static bool tsPollEnter(doca_gpu_dev_verbs_qp* qp, uint32_t* e) {
+  struct ncclGinTsGate* g = tsGate(qp);
+  atomicAdd(&tsGate2(qp)->pollers, 1u);
+  __threadfence_system();
+  const uint32_t cur = tsLoadAcquireSys(&g->epoch);
+  if ((cur & 1u) == 0 && (*e == NCCL_GIN_TS_EPOCH_ANY || cur == *e) && tsLoadRelaxedSys(&g->status) == 0) {
+    *e = cur;
+    return true;
+  }
+  tsPollLeave(qp);
+  return false;
+}
+
+// A waiter whose bound expired while it waited for stable epoch `next`. Commit point with the host
+// (Dekker): we record `next` in abandoned, fence, then read commit; the host writes commit = next,
+// then reads abandoned. Either the host sees us (it declines: nothing of that round executes) or we
+// see its commit (we keep waiting: the round is publishing and our operation is being re-posted).
+// Returns true if the waiter must fail.
+NCCL_DEVICE_INLINE static bool tsGiveUp(doca_gpu_dev_verbs_qp* qp, uint32_t next) {
+  atomicMax(&tsGate2(qp)->abandoned, next);
+  __threadfence_system();
+  return tsLoadAcquireSys(&tsGate(qp)->commit) < next;
+}
+
+// Park until the epoch is stable and differs from `notEpoch` (NCCL_GIN_TS_EPOCH_ANY: any stable epoch).
+// false: declined, or the bound expired and the give-up won. After a lost give-up (the host committed)
+// the waiter waits one more bound for the publication before it fails regardless.
+NCCL_DEVICE_INLINE static bool tsParkStable(doca_gpu_dev_verbs_qp* qp, uint32_t notEpoch) {
+  struct ncclGinTsGate* g = tsGate(qp);
+  const uint64_t holdNs = (uint64_t)tsLoadRelaxedSys(&g->waitMs) * 1000000ull;
+  uint64_t t0 = tsNowNs();
+  bool committed = false;
+  NVCC_PRAGMA_UNROLL_DISABLED
+  while (true) {
+    const uint32_t cur = tsLoadAcquireSys(&g->epoch);
+    if (tsLoadRelaxedSys(&g->status) != 0) return false;
+    if ((cur & 1u) == 0 && cur != notEpoch) return true;
+    if (tsNowNs() - t0 > holdNs) {
+      if (committed) return false;  // the host committed and did not publish within a further bound
+      // The stable epoch we wait for: the next one after an odd epoch, else the one after notEpoch.
+      const uint32_t next = (cur & 1u) ? cur + 1u : notEpoch + 2u;
+      if (tsGiveUp(qp, next)) return false;
+      committed = true;
+      t0 = tsNowNs();
+    }
+    __nanosleep(1000);
+  }
+}
+
+// A logical ticket for everything posted so far on `qp`: *logicalCount = lbase + sq_rsvd_index, read
+// inside the counted region (where neither can change). stay = keep the region entered on success
+// (flush polls next; *epoch and *phys then describe the entered state). false: declined or gave up.
+template <enum doca_gpu_dev_verbs_resource_sharing_mode doca_sharing_mode>
+__device__ __noinline__ static bool tsTicket(doca_gpu_dev_verbs_qp* qp, uint32_t* epoch, uint64_t* phys,
+                                             uint64_t* logicalCount, bool stay) {
+  struct ncclGinTsGate* g = tsGate(qp);
+  while (true) {
+    if (!tsParkStable(qp, NCCL_GIN_TS_EPOCH_ANY)) return false;
+    uint32_t e = NCCL_GIN_TS_EPOCH_ANY;
+    if (!tsPollEnter(qp, &e)) continue;  // went odd (or declined) in between: park again
+    const uint64_t n = doca_gpu_dev_verbs_atomic_read<uint64_t, doca_sharing_mode>(&qp->sq_rsvd_index);
+    *epoch = e;
+    *phys = n;
+    *logicalCount = tsLoadRelaxedSys64(&g->lbase) + n;
+    if (!stay) tsPollLeave(qp);
+    return true;
+  }
+}
