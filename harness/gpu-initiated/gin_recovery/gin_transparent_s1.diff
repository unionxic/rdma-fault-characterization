+// mapped to ibv_wc_status by mlx5_handle_error_cqe() in providers/mlx5/cq.c.
+NCCL_DEVICE_INLINE static uint8_t q4Classify(uint8_t syndrome, uint8_t vendor) {
+  switch (syndrome) {
+  case 0x05:
