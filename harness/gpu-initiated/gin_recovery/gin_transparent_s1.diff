+// op_own byte of a CQE slot (system-scope load of the last dword).
+NCCL_DEVICE_INLINE static uint32_t q4CqeTailChunk(const uint8_t* cqe) {
+  return doca_gpu_dev_verbs_bswap32(doca_gpu_dev_verbs_load_relaxed_sys_global((uint32_t*)(cqe + 60)));
+}
