+static const char* gdakiQ4CqStr(uint8_t t) {
+  switch (t) {
+  case DOCA_GPUNETIO_VERBS_CQ_64B: return "ring";
+  case DOCA_GPUNETIO_VERBS_CQ_64B_COLLAPSED: return "collapsed";
+  case DOCA_GPUNETIO_VERBS_CQ_64B_COLLAPSED_HOST: return "collapsed_host";
+  default: return "?";
+  }
+}
