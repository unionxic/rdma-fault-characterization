+// ---------------------------------------------------------------------------
+// GIN fault-injection test hook (research build; default OFF).
+//   env NCCL_GIN_FAULT_INJECT=local_err:<ms>  or  peer_err:<ms>
+// A detached host thread waits <ms> after the GDAKI context is created (inside
+// ncclDevCommCreate, just before the first GIN op is issued from the device)
+// and then moves *this rank's* GDAKI QP(s) to the DOCA_VERBS_QP_STATE_ERR state
+// with doca_verbs_qp_modify (which maps to the mlx5 QP_2ERR devx command, the
+// GDAKI equivalent of ibv_modify_qp->ERR). On the initiator this reproduces F1
+// (local_err); on the target, F3 (peer_err). Both tokens do the same thing; the
+// fault class depends only on which rank the env var is set on. Inert unless
+// the env var is present, so the stock path is unchanged.
+// ---------------------------------------------------------------------------
+extern thread_local bool ncclGinFaultUserCtx;   // gin/gin_host.cc
+
+static double ncclGinGdakiFaultMonoMs() {
+  struct timespec t;
+  clock_gettime(CLOCK_MONOTONIC, &t);
+  return t.tv_sec * 1e3 + t.tv_nsec * 1e-6;
+}
+
+// Moves this rank's peer-connected GDAKI QPs (and companions) to ERR; logs fire/done times.
+static void ncclGinGdakiFaultFire(struct gdaki_context* gdaki_ctx, const char* shotTag) {
+  const int nranks = gdaki_ctx->collComm->nranks;
+  const int ncontexts = gdaki_ctx->nContexts;
+  const int myRank = gdaki_ctx->rank;
+  doca_verbs_qp_attr_t* errAttr = nullptr;
+  if (doca_verbs_qp_attr_create(&errAttr) != DOCA_SUCCESS) {
+    WARN("GIN/FAULT: GDAKI fault could not allocate qp attr");
+    return;
+  }
+  doca_verbs_qp_attr_set_next_state(errAttr, DOCA_VERBS_QP_STATE_ERR);
+  int moved = 0, total = 0;
+  double t0 = ncclGinGdakiFaultMonoMs();
+  // Only the QPs connected to other ranks (qp_idx = rank + ctx*nranks, rank != self);
+  // the self-loop QPs are not on the wire between the two nodes.
+  for (int c = 0; c < ncontexts; c++) {
+    for (int r = 0; r < nranks; r++) {
+      if (r == myRank) continue;
+      int i = r + c * nranks;
+      struct doca_gpu_verbs_qp_hl* q[2] = {gdaki_ctx->gqps ? gdaki_ctx->gqps[i] : nullptr,
+                                           gdaki_ctx->companion_gqps ? gdaki_ctx->companion_gqps[i] : nullptr};
+      for (int k = 0; k < 2; k++) {
+        if (!q[k] || !q[k]->qp) continue;
+        total++;
+        if (doca_verbs_qp_modify(q[k]->qp, errAttr, DOCA_VERBS_QP_ATTR_NEXT_STATE) == DOCA_SUCCESS) moved++;
+      }
+    }
+  }
+  double t1 = ncclGinGdakiFaultMonoMs();
+  doca_verbs_qp_attr_destroy(errAttr);
+  WARN("GIN/FAULT: GDAKI fault fired%s: moved %d/%d GIN QP(s) to ERR fire_mono_ms=%.3f done_mono_ms=%.3f", shotTag,
+       moved, total, t0, t1);
+}
+
+// GIN recovery (research build): multi-shot hook, defined with the recovery code below.
+static void gdakiRecHookStart(struct gdaki_context* gdaki_ctx, const std::vector<int>& delays, const char* spec);
+
+static void ncclGinGdakiFaultInjectArm(struct gdaki_context* gdaki_ctx) {
+  const char* spec = getenv("NCCL_GIN_FAULT_INJECT");
+  if (!spec || !*spec) return;
+  // Only the GDAKI contexts of a user devComm (set in gin/gin_host.cc); NCCL's
+  // internal symmetric-kernel devComm also creates GDAKI contexts.
+  if (!ncclGinFaultUserCtx) return;
+  int delayMs = -1;
+  if (sscanf(spec, "local_err:%d", &delayMs) != 1 && sscanf(spec, "peer_err:%d", &delayMs) != 1) return;
+  if (delayMs < 0) return;
+  // GIN recovery (research build): "local_err:<ms>,<ms>,..." -- with NCCL_GIN_FAULT_RECOVERY=1 the
+  // k-th delay (k >= 2) counts from the (k-1)-th recovery commit on this rank (see gdakiRecHookStart).
+  std::vector<int> delays;
+  for (const char* p = strchr(spec, ':'); p && *p; p = strchr(p, ',')) {
+    delays.push_back(atoi(p + 1));
+    p++;
+  }
+  if (gdaki_ctx->rec != nullptr && delays.size() >= 1) {
+    gdakiRecHookStart(gdaki_ctx, delays, spec);
+    return;
+  }
+  if (delays.size() > 1)
+    WARN("GIN/FAULT: %s lists %zu shots; only the first fires without NCCL_GIN_FAULT_RECOVERY=1", spec, delays.size());
+  const int nranks = gdaki_ctx->collComm->nranks;
+  const int ncontexts = gdaki_ctx->nContexts;
+  const int nqps = ncontexts * (nranks + 1); // main-QP array: per-(ctx,rank) QPs + self-loop responders
+  WARN("GIN/FAULT: GDAKI fault hook armed (%s): %d context(s) x %d peer(s) (%d main QPs incl. self-loop), fires in "
+       "%d ms", spec, ncontexts, nranks - 1, nqps, delayMs);
+  std::thread([gdaki_ctx, delayMs]() {
+    std::this_thread::sleep_for(std::chrono::milliseconds(delayMs));
+    ncclGinGdakiFaultFire(gdaki_ctx, "");
+  }).detach();
+}
