+static const char* gdakiQ4PathStr(uint8_t p) {
+  switch (p) {
+  case NCCL_GIN_Q4_PATH_WAIT_TIMEOUT: return "wait-timeout";
+  case NCCL_GIN_Q4_PATH_FLUSH_TIMEOUT: return "flush-timeout";
+  case NCCL_GIN_Q4_PATH_WAIT_BLOCKING: return "wait-blocking";
+  case NCCL_GIN_Q4_PATH_FLUSH_BLOCKING: return "flush-blocking";
+  case NCCL_GIN_Q4_PATH_ABORTABLE: return "abortable";
+  default: return "?";
+  }
+}
