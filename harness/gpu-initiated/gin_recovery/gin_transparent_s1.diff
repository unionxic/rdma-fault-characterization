+  case 0x05: return 5;   // IBV_WC_WR_FLUSH_ERR
+  case 0x06: return 6;   // IBV_WC_MW_BIND_ERR
+  case 0x10: return 7;   // IBV_WC_BAD_RESP_ERR
+  case 0x11: return 8;   // IBV_WC_LOC_ACCESS_ERR
+  case 0x12: return 9;   // IBV_WC_REM_INV_REQ_ERR
+  case 0x13: return 10;  // IBV_WC_REM_ACCESS_ERR
+  case 0x14: return 11;  // IBV_WC_REM_OP_ERR
+  case 0x15: return 12;  // IBV_WC_RETRY_EXC_ERR
+  case 0x16: return 13;  // IBV_WC_RNR_RETRY_EXC_ERR
+  case 0x22: return 16;  // IBV_WC_REM_ABORT_ERR
