+// See the note near the top of this file. Reads NCCL_GIN_FAULT_INJECT and, if
+// it requests local_err/peer_err, arms a detached thread that moves every GIN
+// proxy send-QP on this rank to ERR after the requested delay.
+static double ncclGinFaultMonoMs() {
+  struct timespec t;
+  clock_gettime(CLOCK_MONOTONIC, &t);
+  return t.tv_sec * 1e3 + t.tv_nsec * 1e-6;
+}
+
+static void ncclGinFaultInjectArmProxy(struct ncclRmaIbProxyCtx* rmaProxyCtx) {
+  const char* spec = getenv("NCCL_GIN_FAULT_INJECT");
+  if (!spec || !*spec) return;
+  // Only the GIN-proxy contexts of a user devComm (set in gin/gin_host.cc).
+  // The host-RMA proxy (rma/rma_proxy.cc) and NCCL's internal devComm also
+  // create RMA-IB-proxy contexts; those are left alone.
+  if (!ncclGinFaultUserCtx) return;
+  int delayMs = -1;
+  if (sscanf(spec, "local_err:%d", &delayMs) != 1 && sscanf(spec, "peer_err:%d", &delayMs) != 1) return;
+  if (delayMs < 0) return;
+  int nContexts = rmaProxyCtx[0].nContexts;
+  int nranks = rmaProxyCtx[0].nranks;
+  int myRank = rmaProxyCtx[0].rank;
+  WARN("GIN/FAULT: proxy fault hook armed (%s): %d GIN context(s) x %d peer(s), fires in %d ms", spec, nContexts,
+       nranks - 1, delayMs);
+  std::thread([rmaProxyCtx, nContexts, nranks, myRank, delayMs]() {
+    std::this_thread::sleep_for(std::chrono::milliseconds(delayMs));
+    int moved = 0, total = 0;
+    double t0 = ncclGinFaultMonoMs();
+    auto toErr = [&](struct ncclIbNetCommBase* base) {
+      for (int q = 0; q < base->nqps; q++) {
+        struct ibv_qp* qp = base->qps[q].qp;
+        if (!qp) continue;
+        total++;
+        struct ibv_qp_attr attr;
+        memset(&attr, 0, sizeof(attr));
+        attr.qp_state = IBV_QPS_ERR;
+        if (wrap_ibv_modify_qp(qp, &attr, IBV_QP_STATE) == ncclSuccess) moved++;
+      }
+    };
+    // Move BOTH this rank's send-side QPs (initiator/local_err path) and its
+    // recv-side QPs (target/peer_err path: the QPs that receive the peer's
+    // writes) to ERR, so the fault surfaces regardless of which rank we are.
+    for (int c = 0; c < nContexts; c++) {
+      struct ncclRmaIbProxyCtx* gc = &rmaProxyCtx[c];
+      for (int r = 0; r < nranks; r++) {
+        if (r == myRank) continue;
+        if (gc->fullSendComm && gc->fullSendComm[r]) toErr(&((struct ncclIbSendComm*)gc->fullSendComm[r])->base);
+        if (gc->fullRecvComm && gc->fullRecvComm[r]) toErr(&((struct ncclIbRecvComm*)gc->fullRecvComm[r])->base);
+      }
+    }
+    double t1 = ncclGinFaultMonoMs();
+    WARN("GIN/FAULT: proxy fault fired: moved %d/%d GIN QP(s) to ERR fire_mono_ms=%.3f done_mono_ms=%.3f", moved,
+         total, t0, t1);
+  }).detach();
+}
