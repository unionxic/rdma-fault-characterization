+// Visit this rank's peer-connected main QPs (same set as the fault hook).
+template <typename F>
+static void gdakiQ4ForPeerQps(struct gdaki_context* g, F fn) {
+  const int nranks = g->collComm->nranks;
+  const int rankOff = g->rank % g->rankStride;
+  for (int c = 0; c < g->nContexts; c++) {
+    for (int r = 0; r < nranks; r++) {
+      if (r == g->rank || (r % g->rankStride) != rankOff) continue;
+      struct doca_gpu_verbs_qp_hl* q = g->gqps ? g->gqps[r + c * nranks] : nullptr;
+      if (q && q->qp && q->qp_gverbs) fn(q);
+    }
+  }
+}
+
+// Host QP state by QUERY_QP (doca_gpu_verbs_query_last_error: has_error = state==ERR).
+static int gdakiQ4QpErr(struct doca_gpu_verbs_qp_hl* q, double* us) {
+  struct doca_gpu_verbs_qp_error_info info;
+  double t0 = gdakiQ4MonoMs();
+  doca_error_t s = doca_gpu_verbs_query_last_error(q->qp_gverbs, &info);
+  if (us) *us = (gdakiQ4MonoMs() - t0) * 1e3;
+  if (s != DOCA_SUCCESS) return -1;
+  return info.has_error ? 1 : 0;
+}
+
+static void gdakiQ4Handle(struct gdakiQ4Host* q, const struct ncclGinGdakiQ4Record& r, double monoMs) {
+  struct gdaki_context* g = q->ctx;
+  const bool isErr = (r.kind == NCCL_GIN_Q4_KIND_ERR_CQE);
+  if (isErr) {
+    // Make ncclCommGetAsyncError report it now: the GIN async result (read when GIN proxy
+    // threads exist) and the flag consulted by ncclGinGdakiQueryLastError (always).
+    if (g->rec) {
+      // GIN recovery: keep the record for ncclGinFaultQuery (before the flags below are raised).
+      std::lock_guard<std::mutex> lk(q->lastMu);
+      q->lastErr = r;
+      q->lastErrMonoMs = monoMs;
+      q->nErrSinceRec++;
+    }
+    if (gdakiTsRoutes(g->rec, r)) {
+      // GIN transparent recovery: the helper thread owns the fault now; the error surfaces only if it
+      // declines (gdakiTsDecline sets the same flags). Records of QPs without a gate (self loop) are
+      // handled as Q4 does.
+      gdakiTsPushFault(g->rec, r, monoMs);
+    } else {
+      q->hasError.store(1, std::memory_order_release);
+      if (q->asyncResult) {
+        __atomic_store_n(q->asyncResult, ncclRemoteError, __ATOMIC_RELEASE);
+        if (g->rec) q->setAsync.store(1, std::memory_order_release);  // GIN recovery may clear it
+      }
+    }
+    q->nErr++;
+  } else {
+    q->nDump++;
+  }
+  if (++q->nLogged > 64) return;  // bounded logging; counts are kept
+  const bool rootErr = (r.root_opcode == 0xd || r.root_opcode == 0xe);
+  const gdakiQ4ClassText ct = gdakiQ4Class(r.cls, r.vendor_err);
+  const int st = rootErr ? gdakiQ4WcStatus(r.syndrome) : 0;
+  WARN("GIN/Q4: %s rank=%d seq=%u ctx=%u peer=%u qpn=%#x wqe=%u path=%s cq=%s fp=%d/%#x syndrome=%#x hw_err=%#x/%#x "
+       "class=%s fault=%s cause=\"%s\" action=\"%s\" root_op=%#x polled[wqe=%u op=%#x syn=%#x ve=%#x] "
+       "window[err=%u ok=%u root_idx=%lu ticket=%lu cqe_ci=%lu] cq_buffer_err=%u/%u gtimer_ns=%lu mono_ms=%.3f",
+       isErr ? "device-classified error CQE" : "device wait-timeout dump", g->rank, r.seq, r.ctx_id, r.peer, r.qpn,
+       r.wqe_counter, gdakiQ4PathStr(r.path), gdakiQ4CqStr(r.cq_type), st, rootErr ? r.vendor_err : 0,
+       rootErr ? r.syndrome : 0, r.hw_err_synd, r.hw_synd_type, ct.name, ct.fault, ct.cause, ct.action, r.root_opcode,
+       r.polled_wqe_counter, r.polled_opcode, r.polled_syndrome, r.polled_vendor_err, r.n_err_window, r.n_ok_window,
+       (unsigned long)r.root_index, (unsigned long)r.ticket, (unsigned long)r.cqe_ci, r.n_err_buffer, r.cqe_num,
+       (unsigned long)r.gtimer_ns, monoMs);
+  if (r.late_valid)
+    WARN("GIN/Q4: collapsed slot re-read rank=%d seq=%u late[wqe=%u op=%#x syn=%#x ve=%#x after_us=%.1f]", g->rank,
+         r.seq, r.late_wqe_counter, r.late_opcode, r.late_syndrome, r.late_vendor_err, r.late_delay_ns / 1e3);
+  // Diagnostic: direct host QUERY_QP of the QP the record came from (not while the transparent-recovery
+  // helper owns the QPs).
+  if (gdakiTsActive(g->rec)) return;
+  gdakiQ4ForPeerQps(g, [&](struct doca_gpu_verbs_qp_hl* qh) {
+    uint32_t qpn = 0;
+    if (doca_verbs_qp_get_qpn(qh->qp, &qpn) != DOCA_SUCCESS || qpn != r.qpn) return;
+    double us = 0;
+    int e = gdakiQ4QpErr(qh, &us);
+    WARN("GIN/Q4: host QUERY_QP rank=%d qpn=%#x state=%s query_us=%.0f mono_ms=%.3f", g->rank, qpn,
+         e < 0 ? "query-failed" : e ? "ERR" : "not-ERR", us, gdakiQ4MonoMs());
+  });
+}
+
+static void gdakiQ4Watch(struct gdakiQ4Host* q) {
+  volatile uint32_t* words = (volatile uint32_t*)q->rec_h;
+  const int wpr = sizeof(struct ncclGinGdakiQ4Record) / 4;
+  std::vector<int> qpState;
+  double nextWatch = gdakiQ4MonoMs();
+  while (!q->stop.load(std::memory_order_acquire)) {
+    for (int s = 0; s < NCCL_GIN_GDAKI_Q4_NSLOTS; s++) {
+      volatile uint32_t* w = words + s * wpr;
+      const uint32_t magic = w[0], seq = w[1];
+      if (magic != NCCL_GIN_GDAKI_Q4_MAGIC || seq == 0 || seq == q->lastSeq[s]) continue;
+      const double monoMs = gdakiQ4MonoMs();
+      std::atomic_thread_fence(std::memory_order_acquire);
+      struct ncclGinGdakiQ4Record r;
+      uint32_t* dst = (uint32_t*)&r;
+      for (int i = 0; i < wpr; i++) dst[i] = w[i];
+      std::atomic_thread_fence(std::memory_order_acquire);
+      if (w[1] != seq || w[0] != NCCL_GIN_GDAKI_Q4_MAGIC) continue;  // being rewritten; next round
+      q->lastSeq[s] = seq;
+      gdakiQ4Handle(q, r, monoMs);
+    }
+    if (q->qpWatchMs > 0 && gdakiQ4MonoMs() >= nextWatch) {
+      nextWatch += q->qpWatchMs;
+      int i = 0;
+      gdakiQ4ForPeerQps(q->ctx, [&](struct doca_gpu_verbs_qp_hl* qh) {
+        double us = 0;
+        int e = gdakiQ4QpErr(qh, &us);
+        if (i >= (int)qpState.size()) qpState.push_back(-2);
+        if (e != qpState[i]) {
+          uint32_t qpn = 0;
+          doca_verbs_qp_get_qpn(qh->qp, &qpn);
+          WARN("GIN/Q4: QPWATCH rank=%d qpn=%#x state %s -> %s query_us=%.0f mono_ms=%.3f", q->ctx->rank, qpn,
+               qpState[i] == -2 ? "init" : qpState[i] ? "ERR" : "not-ERR", e < 0 ? "query-failed" : e ? "ERR" : "not-ERR",
+               us, gdakiQ4MonoMs());
+          qpState[i] = e;
+        }
+        i++;
+      });
+    }
+    if (q->pollUs > 0) std::this_thread::sleep_for(std::chrono::microseconds(q->pollUs));
+  }
+}
+
+static ncclResult_t gdakiQ4Alloc(struct gdaki_context* g, struct gdakiQ4Host** out) {
+  *out = nullptr;
+  if (ncclParamGinFaultClassify() == 0) return ncclSuccess;
+  ncclResult_t ret = ncclSuccess;
+  struct ncclGinGdakiQ4 init;
+  struct gdakiQ4Host* q = new gdakiQ4Host();
+  q->ctx = g;
+  q->pollUs = (int)std::max<int64_t>(0, ncclParamGinFaultClassifyPollUs());
+  q->qpWatchMs = (int)std::max<int64_t>(0, ncclParamGinQ4QpWatchMs());
+  q->asyncResult = ncclGinQ4AsyncResult;
+  NCCLCHECKGOTO(ncclCudaHostCalloc(&q->rec_h, NCCL_GIN_GDAKI_Q4_NSLOTS), ret, fail);
+  CUDACHECKGOTO(cudaHostGetDevicePointer((void**)&q->rec_d, q->rec_h, 0), ret, fail);
+  NCCLCHECKGOTO(ncclCudaCalloc(&q->dev, 1, nullptr), ret, fail);
+  memset(&init, 0, sizeof(init));
+  init.mbx = q->rec_d;
+  init.nslots = NCCL_GIN_GDAKI_Q4_NSLOTS;
+  init.late_read_ns = (uint32_t)std::max<int64_t>(0, ncclParamGinQ4LateReadUs()) * 1000u;
+  NCCLCHECKGOTO(ncclCudaMemcpy<struct ncclGinGdakiQ4>(q->dev, &init, 1), ret, fail);
+  *out = q;
+  return ncclSuccess;
+fail:
+  if (q->dev) ncclCudaFree(q->dev, nullptr);
+  if (q->rec_h) ncclCudaHostFree(q->rec_h);
+  delete q;
+  return ret;
+}
+
+static void gdakiQ4Start(struct gdakiQ4Host* q) {
+  if (!q) return;
+  q->th = std::thread(gdakiQ4Watch, q);
+  WARN("GIN/Q4: device error classification ON rank=%d mailbox=%d x %zu B host-mapped poll_us=%d qpwatch_ms=%d "
+       "async_result=%s",
+       q->ctx->rank, NCCL_GIN_GDAKI_Q4_NSLOTS, sizeof(struct ncclGinGdakiQ4Record), q->pollUs, q->qpWatchMs,
+       q->asyncResult ? "gin" : "query-only");
+}
+
+// Stop (join) the mailbox watcher without freeing the mailbox: done before the recovery host is freed,
+// because the watcher's record handling reads the context's recovery host.
+static void gdakiQ4Stop(struct gdakiQ4Host* q) {
+  if (q && q->th.joinable()) {
+    q->stop.store(true, std::memory_order_release);
+    q->th.join();
+  }
+}
+
+static void gdakiQ4Free(struct gdakiQ4Host* q) {
+  if (!q) return;
+  if (q->th.joinable()) {
+    q->stop.store(true, std::memory_order_release);
+    q->th.join();
+  }
+  INFO(NCCL_NET, "GIN/Q4: mailbox closed: %d error record(s), %d timeout dump(s)", q->nErr, q->nDump);
+  if (q->dev) ncclCudaFree(q->dev, nullptr);
+  if (q->rec_h) ncclCudaHostFree(q->rec_h);
+  delete q;
+}
+
+// NCCL_GIN_GDAKI_CQ_TYPE -> qp_init_attr. Returns ncclInvalidUsage if the requested type cannot work here.
+static ncclResult_t gdakiQ4ApplyCqType(struct doca_gpu_verbs_qp_init_attr_hl* a, int rank) {
+  const char* s = getenv("NCCL_GIN_GDAKI_CQ_TYPE");
+  if (s == nullptr || *s == '\0' || strcmp(s, "ring") == 0) return ncclSuccess;  // stock
+  if (strcmp(s, "collapsed") == 0) {
+    a->cq_type = DOCA_GPUNETIO_VERBS_CQ_64B_COLLAPSED;
+    a->cq_collapsed = true;
+  } else if (strncmp(s, "collapsed_host", 14) == 0) {
+    const bool force = strcmp(s, "collapsed_host_force") == 0;
+    const bool gdr = doca_gpu_gdrcopy_is_supported();
+    if (!gdr && !force) {
+      WARN("GIN/Q4: NCCL_GIN_GDAKI_CQ_TYPE=collapsed_host refused on rank %d: GDRCopy is not available "
+           "(doca_gpu_gdrcopy_is_supported()=0). DOCA needs it to map the GPU-resident device QP array to the CPU "
+           "(doca_gpu_verbs_export_multi_qps_dev: need_cpu_mapping -> assert(support_gdrcopy), "
+           "DOCA_GPU_MEM_TYPE_GPU_CPU) so the CPU progress thread can advance cqe_ci.",
+           rank);
+      return ncclInvalidUsage;
+    }
+    a->cq_type = DOCA_GPUNETIO_VERBS_CQ_64B_COLLAPSED_HOST;
+    a->cq_collapsed = true;
+  } else {
+    WARN("GIN/Q4: unknown NCCL_GIN_GDAKI_CQ_TYPE=%s (ring|collapsed|collapsed_host)", s);
+    return ncclInvalidUsage;
+  }
+  WARN("GIN/Q4: GDAKI CQ type %s (cq_type=%d cq_collapsed=%d) rank=%d", s, (int)a->cq_type, (int)a->cq_collapsed, rank);
+  return ncclSuccess;
+}
+
+// ---------------------------------------------------------------------------
+// GIN recovery (research build; default OFF), layered on the Q4 classifier above.
+//   NCCL_GIN_FAULT_RECOVERY=1            enable (needs NCCL_GIN_FAULT_CLASSIFY=1; user devComms only)
+//   NCCL_GIN_RECOVERY_DRAIN_MS=<ms>      bound on waiting for the CQE of the last posted WQE (1000)
+//   NCCL_GIN_FAULT_INJECT_WAIT_S=<s>     multi-shot hook: bound on waiting for the next commit (60)
+// Host API (nccl.h): ncclGinFaultQuery, ncclGinRecoverPrepare, ncclGinRecoverCommit,
+// ncclGinRecoverAbort. Design and safety argument: harness/gpu-initiated/gin_recovery/
+// RECOVERY_DESIGN.md. In short: with every GPU producer stopped, Prepare pauses the CPU-proxy
+// doorbell thread for this context, checks that each peer QP is quiescent (no half-posted or
+// unsubmitted WQE), moves it to ERR and waits for the CQE of its last WQE; Commit (after the
+// peer did the same) resets the QP (2RST), restarts the device WQE index space at 0 with
+// cqe_rsvd advanced by the WQEs of the ending epoch, zeroes the doorbell record / proxy
+// mailbox / proxy counter and the get tickets, and reconnects with the connect-time attributes
+// and fresh PSNs (INIT/RTR/RTS), then clears the Q4 error state.
+// ---------------------------------------------------------------------------
+NCCL_PARAM(GinFaultRecovery, "GIN_FAULT_RECOVERY", 0);
+NCCL_PARAM(GinRecoveryDrainMs, "GIN_RECOVERY_DRAIN_MS", 1000);
+NCCL_PARAM(GinFaultInjectWaitS, "GIN_FAULT_INJECT_WAIT_S", 60);
+// Diagnostic A/B only (default: the design). NCCL_GIN_RECOVERY_DIAG=doca_cqe_rsvd sets cqe_rsvd to the
+// ending epoch's WQE count like doca_gpu_verbs_reset_tracking_and_memory (not cumulative);
+// =keep_proxy_db leaves the CPU-proxy doorbell mailbox (cpu_db) and its counter unreset;
+// =keep_gpu_dbr leaves the GPU-memory doorbell record unreset (GPU doorbell mode);
+// =keep_gpu_pi leaves the device sq_wqe_pi (GPU doorbell producer index) unreset.
+static int gdakiRecDiag() {
+  static int v = -1;
+  if (v < 0) {
+    const char* e = getenv("NCCL_GIN_RECOVERY_DIAG");
+    v = (e && strcmp(e, "doca_cqe_rsvd") == 0) ? 1 : (e && strcmp(e, "keep_proxy_db") == 0) ? 2 :
+        (e && strcmp(e, "keep_gpu_dbr") == 0) ? 3 : (e && strcmp(e, "keep_gpu_pi") == 0) ? 4 : 0;
+    if (v) WARN("GIN/REC: DIAGNOSTIC mode NCCL_GIN_RECOVERY_DIAG=%s (breaks the recovery on purpose)", e);
+  }
+  return v;
+}
+extern thread_local void* ncclGinRecCommKey;  // gin/gin_host.cc
+
+struct gdakiRecQp {
+  bool used = false;             // a peer-connected main QP of this rank
+  int ctxIdx = 0, peer = 0, qpIdx = 0;
+  struct gdaki_exch_info exch;   // connect-time info of the peer QP (copy)
+  uint8_t lag = 0;               // connect-time LAG TX port affinity
+  struct doca_gpu_dev_verbs_qp snap;  // device QP struct at Prepare
+  uint64_t epochWqes = 0;        // sq_rsvd_index at Prepare = WQEs of the ending epoch
+  uint32_t newSqPsn = 0;
+  int dbMode = 0;                // GDAKI_REC_DB_* at Prepare (v2)
+};
+
+struct gdakiRecHost {
+  void* commKey = nullptr;
+  struct gdaki_context* ctx = nullptr;
+  std::vector<gdakiRecQp> qps;   // indexed by qp_idx = rank + ctx * nranks
+  std::atomic<int> paused{0};    // proxy progress skips this context while set
+  std::atomic<int> busy{0};      // proxy progress calls inside this context
+  std::mutex opMu;               // Prepare/Commit bodies vs. the test hook's fire
+  int state = 0;                 // 0 idle, 1 prepared
+  int preparedPeer = -1;
+  cudaStream_t stream = nullptr; // private non-blocking stream: never waits for user kernels
+  uint8_t* pinned = nullptr;     // pinned staging for D2H/H2D copies
+  size_t pinnedSize = 0;
+  std::mt19937 rng;
+  int nCommits = 0, nAborts = 0;
+  // multi-shot test hook (NCCL_GIN_FAULT_INJECT with a list)
+  std::thread hookTh;
+  std::mutex hookMu;
+  std::condition_variable hookCv;
+  bool hookStop = false;
+  uint64_t commits = 0;
+  int armShot = 0, armTotal = 0;  // delay -1: Commit fires this shot after RTS, before it returns
+  struct gdakiTs* ts = nullptr;   // GIN transparent recovery S1: nullptr unless NCCL_GIN_FAULT_TRANSPARENT=1
+};
+
+static std::mutex gdakiRecRegMu;
+static std::vector<struct gdakiRecHost*> gdakiRecReg;
+
+// Proxy progress guard: with recovery off (rec == nullptr) it does nothing.
+struct gdakiRecProgressGuard {
+  struct gdakiRecHost* r;
+  bool skip = false;
+  explicit gdakiRecProgressGuard(struct gdakiRecHost* r_) : r(r_) {
+    if (r == nullptr) return;
+    r->busy.fetch_add(1, std::memory_order_seq_cst);
+    if (r->paused.load(std::memory_order_seq_cst)) {
+      r->busy.fetch_sub(1, std::memory_order_seq_cst);
+      r = nullptr;
+      skip = true;
+    }
+  }
+  ~gdakiRecProgressGuard() {
+    if (r) r->busy.fetch_sub(1, std::memory_order_seq_cst);
+  }
+};
+
+static ncclResult_t gdakiRecPause(struct gdakiRecHost* r) {
+  r->paused.store(1, std::memory_order_seq_cst);
+  const double t0 = gdakiQ4MonoMs();
+  while (r->busy.load(std::memory_order_seq_cst) != 0) {
+    if (gdakiQ4MonoMs() - t0 > 1000) {
+      r->paused.store(0, std::memory_order_seq_cst);
+      WARN("GIN/REC: proxy progress did not leave the context within 1 s");
+      return ncclInternalError;
+    }
+    std::this_thread::yield();
+  }
+  return ncclSuccess;
+}
+
+static void gdakiRecResume(struct gdakiRecHost* r) { r->paused.store(0, std::memory_order_seq_cst); }
+
+static ncclResult_t gdakiRecD2H(struct gdakiRecHost* r, void* dst, const void* src, size_t n) {
+  if (n > r->pinnedSize) return ncclInternalError;
+  CUDACHECK(cudaMemcpyAsync(r->pinned, src, n, cudaMemcpyDeviceToHost, r->stream));
+  CUDACHECK(cudaStreamSynchronize(r->stream));
+  memcpy(dst, r->pinned, n);
+  return ncclSuccess;
+}
+
+static ncclResult_t gdakiRecH2D(struct gdakiRecHost* r, void* dst, const void* src, size_t n) {
+  if (n > r->pinnedSize) return ncclInternalError;
+  memcpy(r->pinned, src, n);
+  CUDACHECK(cudaMemcpyAsync(dst, r->pinned, n, cudaMemcpyHostToDevice, r->stream));
+  CUDACHECK(cudaStreamSynchronize(r->stream));
+  return ncclSuccess;
+}
+
+// A CQE at ring position `pos` belongs to the current lap and to WQE `wqeIdx` (ring CQ).
+static bool gdakiRecCqeCurrent(const uint8_t* cqe, uint64_t pos, uint32_t cqeNum, uint64_t wqeIdx) {
+  const uint16_t wc = ((uint16_t)cqe[60] << 8) | cqe[61];
+  const uint8_t opown = cqe[63];
+  const bool owner = (opown & DOCA_GPUNETIO_IB_MLX5_CQE_OWNER_MASK) != 0;
+  return owner == ((pos & cqeNum) != 0) && wc == (uint16_t)(wqeIdx & 0xffff);
+}
+
+static void gdakiRecFind(void* key, std::vector<struct gdakiRecHost*>& out) {
+  // GIN transparent recovery: a helper thread acts on its own GDAKI context only.
+  if (gdakiTsOwner != nullptr) {
+    if (gdakiTsOwner->commKey == key) out.push_back(gdakiTsOwner);
+    return;
+  }
+  std::lock_guard<std::mutex> lk(gdakiRecRegMu);
+  for (auto* r : gdakiRecReg)
+    if (r->commKey == key) out.push_back(r);
+}
+
+static uint32_t gdakiRecQpn(struct doca_gpu_verbs_qp_hl* q) {
+  uint32_t qpn = 0;
+  doca_verbs_qp_get_qpn(q->qp, &qpn);
+  return qpn;
+}
+
+static ncclResult_t gdakiRecModify(struct doca_gpu_verbs_qp_hl* q, enum doca_verbs_qp_state st) {
+  doca_verbs_qp_attr_t* a = nullptr;
+  if (doca_verbs_qp_attr_create(&a) != DOCA_SUCCESS) return ncclSystemError;
+  doca_verbs_qp_attr_set_next_state(a, st);
+  doca_error_t e = doca_verbs_qp_modify(q->qp, a, DOCA_VERBS_QP_ATTR_NEXT_STATE);
+  doca_verbs_qp_attr_destroy(a);
+  if (e != DOCA_SUCCESS) {
+    WARN("GIN/REC: modify qpn=%#x -> state %d failed (%d)", gdakiRecQpn(q), (int)st, (int)e);
+    return ncclSystemError;
+  }
+  return ncclSuccess;
+}
+
+// The peer-connected QPs of `r` to `peer`, in GIN-context order.
+template <typename F>
+static void gdakiRecForPeer(struct gdakiRecHost* r, int peer, F fn) {
+  const int nranks = r->ctx->collComm->nranks;
+  for (int c = 0; c < r->ctx->nContexts; c++) {
+    const int i = peer + c * nranks;
+    if (i < (int)r->qps.size() && r->qps[i].used) fn(r->qps[i], r->ctx->gqps[i]);
+  }
+}
+
+static void gdakiRecAllToErr(struct gdakiRecHost* r, int peer) {
+  gdakiRecForPeer(r, peer, [&](gdakiRecQp&, struct doca_gpu_verbs_qp_hl* q) { (void)gdakiRecModify(q, DOCA_VERBS_QP_STATE_ERR); });
+}
+
+// GIN recovery v2 (GPU doorbells): the doorbell path of a GDAKI QP, as DOCA resolved it at export.
+//   CPU proxy (PeerMappingOverride off): the GPU publishes its producer index in the host-mapped
+//     mailbox cpu_db; a CPU thread (NCCL "GIN P" progress thread) writes the host-memory doorbell
+//     record and rings the UAR doorbell.
+//   GPU_SM_DB (UAR mapped into the GPU, e.g. PeerMappingOverride=1): the GPU itself rings the UAR
+//     doorbell and writes the doorbell record, which lives in GPU memory; sq_wqe_pi tracks the last
+//     index it submitted. There is no CPU-side doorbell state.
+// Other modes (BlueFlame, no-DBR, SW-emulated DBR, free-flow proxy) are not supported by recovery.
+enum { GDAKI_REC_DB_UNSUPPORTED = 0, GDAKI_REC_DB_CPU_PROXY = 1, GDAKI_REC_DB_GPU = 2 };
+static int gdakiRecDbMode(struct doca_gpu_verbs_qp* v) {
+  const int h = (int)v->qp_cpu->nic_handler;
+  if (v->cpu_proxy && h == DOCA_GPUNETIO_VERBS_NIC_HANDLER_CPU_PROXY &&
+      v->send_dbr_mode_ext == DOCA_GPUNETIO_VERBS_SEND_DBR_MODE_EXT_VALID_DBR)
+    return GDAKI_REC_DB_CPU_PROXY;
+  if (!v->cpu_proxy && h == DOCA_GPUNETIO_VERBS_NIC_HANDLER_GPU_SM_DB &&
+      v->send_dbr_mode_ext == DOCA_GPUNETIO_VERBS_SEND_DBR_MODE_EXT_VALID_DBR)
+    return GDAKI_REC_DB_GPU;
+  return GDAKI_REC_DB_UNSUPPORTED;
+}
+static const char* gdakiNicHandlerStr(int h) {
+  switch (h) {
+  case DOCA_GPUNETIO_VERBS_NIC_HANDLER_CPU_PROXY: return "CPU_PROXY";
+  case DOCA_GPUNETIO_VERBS_NIC_HANDLER_GPU_SM_DB: return "GPU_SM_DB";
+  case DOCA_GPUNETIO_VERBS_NIC_HANDLER_GPU_SM_BF: return "GPU_SM_BF";
+  case DOCA_GPUNETIO_VERBS_NIC_HANDLER_GPU_SM_NO_DBR: return "GPU_SM_NO_DBR";
+  case DOCA_GPUNETIO_VERBS_NIC_HANDLER_CPU_PROXY_FREE_FLOW: return "CPU_PROXY_FREE_FLOW";
+  default: return "?";
+  }
+}
+
+// Once per GDAKI context: the doorbell mode DOCA chose for its main QPs (the doorbell mode is not
+// logged anywhere in stock NCCL/DOCA). WARN when the Q4 classifier or recovery is on, INFO otherwise.
+static void gdakiDbModeLog(struct gdaki_context* g, bool needsProxyProgress) {
+  int nGpu = 0, nProxy = 0, nOther = 0, total = 0;
+  const char* first = "?";
+  const int nq = g->nContexts * (g->collComm->nranks + 1);
+  for (int i = 0; i < nq; i++) {
+    struct doca_gpu_verbs_qp_hl* q = g->gqps ? g->gqps[i] : nullptr;
+    if (q == nullptr || q->qp_gverbs == nullptr || q->qp_gverbs->qp_cpu == nullptr) continue;
+    const int h = (int)q->qp_gverbs->qp_cpu->nic_handler;
+    if (total == 0) first = gdakiNicHandlerStr(h);
+    total++;
+    if (h == DOCA_GPUNETIO_VERBS_NIC_HANDLER_GPU_SM_DB && !q->qp_gverbs->cpu_proxy) nGpu++;
+    else if (h == DOCA_GPUNETIO_VERBS_NIC_HANDLER_CPU_PROXY && q->qp_gverbs->cpu_proxy) nProxy++;
+    else nOther++;
+  }
+  const bool loud = ncclParamGinFaultClassify() || ncclParamGinFaultRecovery();
+  const char* mode = (nGpu == total) ? "GPU" : (nProxy == total) ? "CPU_PROXY" : "MIXED";
+  if (loud)
+    WARN("GIN/GDAKI: doorbell mode=%s rank=%d user_ctx=%d main_qps=%d gpu_sm_db=%d cpu_proxy=%d other=%d "
+         "first_nic_handler=%s needsProxyProgress=%d",
+         mode, g->rank, (int)ncclGinFaultUserCtx, total, nGpu, nProxy, nOther, first, (int)needsProxyProgress);
+  else
+    INFO(NCCL_NET | NCCL_INIT, "GIN/GDAKI: doorbell mode=%s rank=%d main_qps=%d gpu_sm_db=%d cpu_proxy=%d other=%d "
+         "needsProxyProgress=%d", mode, g->rank, total, nGpu, nProxy, nOther, (int)needsProxyProgress);
+}
+
+static void gdakiRecRegister(struct gdaki_context* g) {
+  struct gdakiRecHost* r = g->rec;
+  if (r == nullptr) return;
+  if (g->q4 == nullptr) {
+    WARN("GIN/REC: NCCL_GIN_FAULT_RECOVERY=1 needs NCCL_GIN_FAULT_CLASSIFY=1; recovery disabled on rank %d", g->rank);
+    gdakiTsFree(r);
+    delete r;
+    g->rec = nullptr;
+    return;
+  }
+  uint32_t cqeMax = 1;
+  while (cqeMax < g->qp_sq_size) cqeMax <<= 1;
+  r->pinnedSize = std::max<size_t>((size_t)cqeMax * DOCA_GPUNETIO_VERBS_CQE_SIZE, sizeof(struct doca_gpu_dev_verbs_qp)) + 4096;
+  if (cudaStreamCreateWithFlags(&r->stream, cudaStreamNonBlocking) != cudaSuccess ||
+      cudaHostAlloc((void**)&r->pinned, r->pinnedSize, cudaHostAllocDefault) != cudaSuccess) {
+    WARN("GIN/REC: could not allocate the recovery stream/staging; recovery disabled on rank %d", g->rank);
+    if (r->stream) cudaStreamDestroy(r->stream);
+    gdakiTsFree(r);
+    delete r;
+    g->rec = nullptr;
+    return;
+  }
+  std::random_device rd;
+  r->rng.seed(rd() ^ (uint32_t)clockNano() ^ ((uint32_t)g->rank << 24));
+  int n = 0;
+  for (auto& q : r->qps) n += q.used ? 1 : 0;
+  {
+    std::lock_guard<std::mutex> lk(gdakiRecRegMu);
+    gdakiRecReg.push_back(r);
+  }
+  WARN("GIN/REC: recovery ON rank=%d peer_qps=%d contexts=%d drain_ms=%ld (API: ncclGinRecoverPrepare/Commit)", g->rank,
+       n, g->nContexts, (long)ncclParamGinRecoveryDrainMs());
+  gdakiTsStart(r);  // GIN transparent recovery S1 (only if gdakiTsSetup enabled it)
+}
+
+static void gdakiRecFree(struct gdakiRecHost* r) {
+  if (r == nullptr) return;
+  gdakiTsFree(r);  // GIN transparent recovery: stop the helper before anything it uses goes away
+  {
+    std::lock_guard<std::mutex> lk(gdakiRecRegMu);
+    gdakiRecReg.erase(std::remove(gdakiRecReg.begin(), gdakiRecReg.end(), r), gdakiRecReg.end());
+  }
+  {
+    std::lock_guard<std::mutex> lk(r->hookMu);
+    r->hookStop = true;
+  }
+  r->hookCv.notify_all();
+  if (r->hookTh.joinable()) r->hookTh.join();
+  if (r->stream) cudaStreamDestroy(r->stream);
+  if (r->pinned) cudaFreeHost(r->pinned);
+  INFO(NCCL_NET, "GIN/REC: closed: %d commit(s), %d abort(s)", r->nCommits, r->nAborts);
+  delete r;
+}
+
+// Multi-shot fault hook: shot 1 fires delays[0] ms after context creation; shot k > 1 fires
+// delays[k-1] ms after the recovery commit that followed shot k-1 on this rank (0 = at once).
+// A delay of -1 fires shot k *inside* that commit, after the QPs reached RTS and before Commit
+// returns, so the application's replay meets a QP in ERR (a fault during the recovery itself).
+// Joined on context destruction.
+static void gdakiRecHookStart(struct gdaki_context* g, const std::vector<int>& delays, const char* spec) {
+  struct gdakiRecHost* r = g->rec;
+  const int nranks = g->collComm->nranks;
+  WARN("GIN/FAULT: GDAKI fault hook armed (%s): %d context(s) x %d peer(s), %zu shot(s); shot 1 fires in %d ms, "
+       "shot k>1 fires its delay after the recovery commit that followed shot k-1",
+       spec, g->nContexts, nranks - 1, delays.size(), delays[0]);
+  r->hookTh = std::thread([g, r, delays]() {
+    const double waitS = (double)ncclParamGinFaultInjectWaitS();
+    uint64_t commitsAtFire = 0;
+    for (size_t k = 0; k < delays.size(); k++) {
+      std::unique_lock<std::mutex> lk(r->hookMu);
+      if (k > 0 && delays[k] < 0) {
+        r->armShot = (int)k + 1;
+        r->armTotal = (int)delays.size();
+        bool ok = r->hookCv.wait_for(lk, std::chrono::duration<double>(waitS),
+                                     [&] { return r->hookStop || r->armShot == 0; });
+        if (r->hookStop) return;
+        if (!ok) {
+          r->armShot = 0;
+          WARN("GIN/FAULT: shot %zu/%zu cancelled: no recovery commit within %.0f s", k + 1, delays.size(), waitS);
+          return;
+        }
+        commitsAtFire = r->commits;  // the commit that fired it has already counted itself
+        continue;
+      }
+      if (k > 0) {
+        bool ok = r->hookCv.wait_for(lk, std::chrono::duration<double>(waitS),
+                                     [&] { return r->hookStop || r->commits > commitsAtFire; });
+        if (r->hookStop) return;
+        if (!ok) {
+          WARN("GIN/FAULT: shot %zu/%zu cancelled: no recovery commit within %.0f s", k + 1, delays.size(), waitS);
+          return;
+        }
+      }
+      if (delays[k] > 0 &&
+          r->hookCv.wait_for(lk, std::chrono::milliseconds(delays[k]), [&] { return r->hookStop; }))
+        return;
+      if (r->hookStop) return;
+      lk.unlock();
+      std::lock_guard<std::mutex> op(r->opMu);  // never inside a Prepare/Commit body
+      {
+        std::lock_guard<std::mutex> lk2(r->hookMu);
+        commitsAtFire = r->commits;
+      }
+      char tag[48];
+      snprintf(tag, sizeof(tag), " (shot %zu/%zu)", k + 1, delays.size());
+      ncclGinGdakiFaultFire(g, tag);
+    }
+  });
+}
+
+static const char* gdakiRecStateStr(int s) { return s == 0 ? "idle" : s == 1 ? "prepared" : "?"; }
+
+NCCL_API(ncclResult_t, ncclGinFaultQuery, ncclComm_t comm, int waitMs, ncclGinFaultInfo_t* info);
+ncclResult_t ncclGinFaultQuery(ncclComm_t comm, int waitMs, ncclGinFaultInfo_t* info) {
+  if (info == nullptr) return ncclInvalidArgument;
+  memset(info, 0, sizeof(*info));
+  std::vector<struct gdakiRecHost*> rs;
+  gdakiRecFind((void*)comm, rs);
+  if (rs.empty()) return ncclInvalidUsage;
+  const double deadline = gdakiQ4MonoMs() + std::max(0, waitMs);
+  do {
+    for (auto* r : rs) {
+      struct gdakiQ4Host* q = r->ctx->q4;
+      std::lock_guard<std::mutex> lk(q->lastMu);
+      if (q->nErrSinceRec == 0 || (info->valid && q->lastErrMonoMs <= info->hostMonoMs)) continue;
+      const struct ncclGinGdakiQ4Record& e = q->lastErr;
+      const bool rootErr = (e.root_opcode == 0xd || e.root_opcode == 0xe);
+      info->valid = 1;
+      info->cls = e.cls;
+      info->wcStatus = rootErr ? gdakiQ4WcStatus(e.syndrome) : 0;
+      info->vendorErr = rootErr ? e.vendor_err : 0;
+      info->syndrome = rootErr ? e.syndrome : 0;
+      info->peer = (int)e.peer;
+      info->ctxId = (int)e.ctx_id;
+      info->qpn = e.qpn;
+      info->wqeCounter = e.wqe_counter;
+      info->seq = e.seq;
+      info->nRecords = q->nErrSinceRec;
+      info->gtimerNs = e.gtimer_ns;
+      info->hostMonoMs = q->lastErrMonoMs;
+      info->recoverable = (e.cls == NCCL_GIN_Q4_CLASS_LOCAL_QP_ERR) ? 1 : (e.cls == NCCL_GIN_Q4_CLASS_RETRY_EXC) ? 2 : 0;
+      snprintf(info->className, sizeof(info->className), "%s", gdakiQ4Class(e.cls, e.vendor_err).name);
+    }
+    if (info->valid) break;
+    std::this_thread::sleep_for(std::chrono::microseconds(20));
+  } while (gdakiQ4MonoMs() < deadline);
+  return ncclSuccess;
+}
+
+NCCL_API(ncclResult_t, ncclGinRecoverPrepare, ncclComm_t comm, int peer, ncclGinRecoverToken_t* local,
+         ncclGinRecoverStats_t* stats);
+ncclResult_t ncclGinRecoverPrepare(ncclComm_t comm, int peer, ncclGinRecoverToken_t* local,
+                                   ncclGinRecoverStats_t* stats) {
+  if (local == nullptr) return ncclInvalidArgument;
+  ncclGinRecoverStats_t st;
+  memset(&st, 0, sizeof(st));
+  memset(local, 0, sizeof(*local));
+  local->magic = NCCL_GIN_RECOVERY_TOKEN_MAGIC;
+  std::vector<struct gdakiRecHost*> rs;
+  gdakiRecFind((void*)comm, rs);
+  if (rs.empty()) {
+    WARN("GIN/REC: prepare: no recovery-enabled GDAKI context on this communicator");
+    return ncclInvalidUsage;
+  }
+  if (!gdakiTsInHelper) {
+    for (auto* r_ : rs)
+      if (gdakiTsActive(r_)) {
+        WARN("GIN/REC: %s: transparent recovery (NCCL_GIN_FAULT_TRANSPARENT=1) owns the QPs", __func__);
+        return ncclInvalidUsage;
+      }
+  }
+  const double t0 = gdakiQ4MonoMs();
+  ncclResult_t ret = ncclSuccess;
+  std::vector<std::unique_lock<std::mutex>> ops;
+  std::vector<struct gdakiRecHost*> pausedRs;
+  const char* why = nullptr;
+
+  // 1. configuration (checked before anything is touched)
+  for (auto* r : rs) {
+    struct gdaki_context* g = r->ctx;
+    if (peer < 0 || peer >= g->collComm->nranks || peer == g->rank) { why = "invalid peer"; goto decline; }
+    if (r->state != 0) { why = "a recovery is already prepared"; goto decline; }
+    if (g->companion_gqps != nullptr) { why = "companion (counter) QPs present"; goto decline; }
+    int n = 0;
+    gdakiRecForPeer(r, peer, [&](gdakiRecQp&, struct doca_gpu_verbs_qp_hl* q) {
+      n++;
+      struct doca_gpu_verbs_qp* v = q->qp_gverbs;
+      if (gdakiRecDbMode(v) == GDAKI_REC_DB_UNSUPPORTED)
+        why = "doorbell mode is neither CPU proxy nor GPU_SM_DB";
+      else if (v->cq_type != DOCA_GPUNETIO_VERBS_CQ_64B)
+        why = "CQ is not a ring CQ";
+      else if (v->qp_gpu == nullptr)
+        why = "QP not exported";
+    });
+    if (why) goto decline;
+    if (n == 0) { why = "no QP to this peer"; goto decline; }
+    if ((int)local->nqp + n > NCCL_GIN_RECOVERY_MAX_QPS) { why = "too many QPs"; goto decline; }
+    local->nqp += n;
+  }
+  local->nqp = 0;
+
+  // 2. pause the proxy doorbell thread, ring any pending doorbell, snapshot and check quiescence
+  for (auto* r : rs) {
+    ops.emplace_back(r->opMu);
+    if (gdakiRecPause(r) != ncclSuccess) { why = "cannot pause proxy progress"; goto decline; }
+    pausedRs.push_back(r);
+    bool bad = false;
+    gdakiRecForPeer(r, peer, [&](gdakiRecQp& rq, struct doca_gpu_verbs_qp_hl* q) {
+      if (bad) return;
+      struct doca_gpu_verbs_qp* v = q->qp_gverbs;
+      rq.dbMode = gdakiRecDbMode(v);
+      if (rq.dbMode == GDAKI_REC_DB_CPU_PROXY) {
+        bool progressed = false;
+        doca_gpu_verbs_cpu_proxy_progress(v, &progressed);  // ring a doorbell the proxy has not rung yet
+      }
+      if (gdakiRecD2H(r, &rq.snap, v->qp_gpu, sizeof(rq.snap)) != ncclSuccess) { bad = true; why = "cannot read device QP"; return; }
+      const uint64_t S = rq.snap.sq_rsvd_index, R = rq.snap.sq_ready_index;
+      if (rq.dbMode == GDAKI_REC_DB_CPU_PROXY) {
+        const uint64_t P = __atomic_load_n(v->cpu_db, __ATOMIC_ACQUIRE);
+        if (R != S || P != S || v->sq_wqe_pi_last != S) {
+          WARN("GIN/REC: prepare: qpn=%#x not quiescent: sq_rsvd_index=%lu sq_ready_index=%lu proxy_db=%lu rung=%lu",
+               gdakiRecQpn(q), (unsigned long)S, (unsigned long)R, (unsigned long)P, (unsigned long)v->sq_wqe_pi_last);
+          bad = true;
+          why = "GPU producer not quiescent";
+          return;
+        }
+      } else {
+        // GPU doorbell: the GPU's submit raised sq_wqe_pi to the submitted index, rang the UAR and
+        // wrote the doorbell record (GPU memory, big-endian 16-bit counter) itself.
+        uint32_t dbr = 0;
+        if (gdakiRecD2H(r, &dbr, v->qp_cpu->sq_dbrec, sizeof(dbr)) != ncclSuccess) { bad = true; why = "cannot read doorbell record"; return; }
+        const uint32_t dbrHost = be32toh(dbr);
+        if (R != S || rq.snap.sq_wqe_pi != S || dbrHost != (uint32_t)(S & 0xffff)) {
+          WARN("GIN/REC: prepare: qpn=%#x not quiescent (GPU doorbell): sq_rsvd_index=%lu sq_ready_index=%lu "
+               "sq_wqe_pi=%lu dbrec=%u",
+               gdakiRecQpn(q), (unsigned long)S, (unsigned long)R, (unsigned long)rq.snap.sq_wqe_pi, dbrHost);
+          bad = true;
+          why = "GPU producer not quiescent";
+          return;
+        }
+      }
+      rq.epochWqes = S;
+    });
+    if (bad) goto decline;
+  }
+
+  // 3. every QP of the pair set -> ERR (stops retransmission and execution of the old incarnation)
+  {
+    const double e0 = gdakiQ4MonoMs();
+    for (auto* r : rs) {
+      bool bad = false;
+      gdakiRecForPeer(r, peer, [&](gdakiRecQp&, struct doca_gpu_verbs_qp_hl* q) {
+        if (!bad && gdakiRecModify(q, DOCA_VERBS_QP_STATE_ERR) != ncclSuccess) bad = true;
+      });
+      if (bad) { why = "modify to ERR failed"; goto decline; }
+    }
+    st.errUs = (gdakiQ4MonoMs() - e0) * 1e3;
+  }
+
+  // 4. drain: the CQE of the last WQE of the epoch is in the ring (all earlier ones are too)
+  {
+    const double d0 = gdakiQ4MonoMs();
+    const double deadline = d0 + (double)ncclParamGinRecoveryDrainMs();
+    for (auto* r : rs) {
+      bool bad = false;
+      gdakiRecForPeer(r, peer, [&](gdakiRecQp& rq, struct doca_gpu_verbs_qp_hl* q) {
+        if (bad || rq.epochWqes == 0) return;
+        const struct doca_gpu_dev_verbs_cq& cq = rq.snap.cq_sq;
+        const uint32_t cqeNum = cq.cqe_num;
+        if ((size_t)cqeNum * DOCA_GPUNETIO_VERBS_CQE_SIZE > r->pinnedSize) { bad = true; why = "CQ too large"; return; }
+        const uint64_t last = rq.epochWqes - 1;
+        const uint64_t pos = last + cq.cqe_rsvd;
+        const uint8_t* slotAddr = cq.cqe_daddr + (pos & (cqeNum - 1)) * DOCA_GPUNETIO_VERBS_CQE_SIZE;
+        uint8_t cqe[64];
+        while (true) {
+          if (gdakiRecD2H(r, cqe, slotAddr, sizeof(cqe)) != ncclSuccess) { bad = true; why = "cannot read CQ"; return; }
+          if (gdakiRecCqeCurrent(cqe, pos, cqeNum, last)) break;
+          if (gdakiQ4MonoMs() > deadline) {
+            WARN("GIN/REC: prepare: qpn=%#x drain timeout: CQE of WQE %lu (ring pos %lu) not written after %ld ms "
+                 "(wqe_counter=%u op_own=%#x)",
+                 gdakiRecQpn(q), (unsigned long)last, (unsigned long)pos, (long)ncclParamGinRecoveryDrainMs(),
+                 ((unsigned)cqe[60] << 8) | cqe[61], cqe[63]);
+            bad = true;
+            why = "drain timeout";
+            return;
+          }
+          std::this_thread::sleep_for(std::chrono::microseconds(50));
+        }
+        // Diagnostics: current CQEs of the unconsumed window [cqe_ci, S).
+        std::vector<uint8_t> ring((size_t)cqeNum * DOCA_GPUNETIO_VERBS_CQE_SIZE);
+        if (gdakiRecD2H(r, ring.data(), cq.cqe_daddr, ring.size()) != ncclSuccess) return;
+        uint64_t lo = cq.cqe_ci;
+        if (rq.epochWqes > cqeNum && lo < rq.epochWqes - cqeNum) lo = rq.epochWqes - cqeNum;
+        for (uint64_t i = lo; i < rq.epochWqes; i++) {
+          const uint64_t p = i + cq.cqe_rsvd;
+          const uint8_t* c = ring.data() + (p & (cqeNum - 1)) * DOCA_GPUNETIO_VERBS_CQE_SIZE;
+          if (!gdakiRecCqeCurrent(c, p, cqeNum, i)) continue;
+          const uint8_t op = c[63] >> 4;
+          if (op == 0xd || op == 0xe) st.cqeErr++;
+          else st.cqeOk++;
+        }
+      });
+      if (bad) goto decline;
+    }
+    st.drainUs = (gdakiQ4MonoMs() - d0) * 1e3;
+  }
+
+  // 5. token: fresh 24-bit send PSN per QP
+  for (auto* r : rs) {
+    gdakiRecForPeer(r, peer, [&](gdakiRecQp& rq, struct doca_gpu_verbs_qp_hl* q) {
+      rq.newSqPsn = r->rng() & 0xffffff;
+      const unsigned n = local->nqp++;
+      local->qpn[n] = gdakiRecQpn(q);
+      local->remoteQpn[n] = (unsigned)rq.exch.qpn;
+      local->sqPsn[n] = rq.newSqPsn;
+      local->epochWqes[n] = rq.epochWqes;
+      st.epochWqes += rq.epochWqes;
+    });
+    r->state = 1;
+    r->preparedPeer = peer;
+  }
+  st.nqp = (int)local->nqp;
+  st.prepareUs = (gdakiQ4MonoMs() - t0) * 1e3;
+  if (stats) *stats = st;
+  INFO(NCCL_NET, "GIN/REC: prepared peer=%d qps=%d epoch_wqes=%llu cqe_err=%u cqe_ok=%u err_us=%.0f drain_us=%.0f total_us=%.0f",
+       peer, st.nqp, st.epochWqes, st.cqeErr, st.cqeOk, st.errUs, st.drainUs, st.prepareUs);
+  return ncclSuccess;
+
+decline:
+  for (auto* r : pausedRs) gdakiRecResume(r);
+  WARN("GIN/REC: prepare declined (peer=%d): %s", peer, why ? why : "?");
+  if (ret == ncclSuccess) ret = ncclInvalidUsage;
+  return ret;
+}
+
+NCCL_API(ncclResult_t, ncclGinRecoverCommit, ncclComm_t comm, int peer, const ncclGinRecoverToken_t* remote,
+         ncclGinRecoverStats_t* stats);
+ncclResult_t ncclGinRecoverCommit(ncclComm_t comm, int peer, const ncclGinRecoverToken_t* remote,
+                                  ncclGinRecoverStats_t* stats) {
+  if (remote == nullptr) return ncclInvalidArgument;
+  std::vector<struct gdakiRecHost*> rs;
+  gdakiRecFind((void*)comm, rs);
+  if (rs.empty()) return ncclInvalidUsage;
+  if (!gdakiTsInHelper) {
+    for (auto* r_ : rs)
+      if (gdakiTsActive(r_)) {
+        WARN("GIN/REC: %s: transparent recovery (NCCL_GIN_FAULT_TRANSPARENT=1) owns the QPs", __func__);
+        return ncclInvalidUsage;
+      }
+  }
+  ncclGinRecoverStats_t st;
+  if (stats) st = *stats;
+  else memset(&st, 0, sizeof(st));
+  // Validate before touching anything: same QP set, each end connected to the other.
+  {
+    unsigned n = 0;
+    bool bad = remote->magic != NCCL_GIN_RECOVERY_TOKEN_MAGIC;
+    for (auto* r : rs) {
+      if (r->state != 1 || r->preparedPeer != peer) {
+        WARN("GIN/REC: commit: context not prepared for peer %d (state %s)", peer, gdakiRecStateStr(r->state));
+        return ncclInvalidUsage;
+      }
+      gdakiRecForPeer(r, peer, [&](gdakiRecQp& rq, struct doca_gpu_verbs_qp_hl* q) {
+        if (n >= remote->nqp || remote->qpn[n] != (unsigned)rq.exch.qpn || remote->remoteQpn[n] != gdakiRecQpn(q))
+          bad = true;
+        n++;
+      });
+    }
+    if (bad || n != remote->nqp) {
+      WARN("GIN/REC: commit: peer token does not match the connected QPs (local %u, remote %u)", n, remote->nqp);
+      return ncclInvalidArgument;
+    }
+  }
+  const double t0 = gdakiQ4MonoMs();
+  ncclResult_t ret = ncclSuccess;
+  unsigned n = 0;
+  for (auto* r : rs) {
+    std::lock_guard<std::mutex> op(r->opMu);
+    struct gdaki_context* g = r->ctx;
+    const int nranks = g->collComm->nranks;
+    bool bad = false;
+    gdakiRecForPeer(r, peer, [&](gdakiRecQp& rq, struct doca_gpu_verbs_qp_hl* q) {
+      const unsigned idx = n++;
+      if (bad) return;
+      struct doca_gpu_verbs_qp* v = q->qp_gverbs;
+      // (a) 2RST: the NIC restarts this SQ at WQE counter 0; no CQE is written for it any more.
+      double a = gdakiQ4MonoMs();
+      if (gdakiRecModify(q, DOCA_VERBS_QP_STATE_RST) != ncclSuccess) { bad = true; return; }
+      double b = gdakiQ4MonoMs();
+      st.resetUs += (b - a) * 1e3;
+      // (b) doorbell state, while the QP is in RESET. CPU proxy: host-memory doorbell record,
+      // proxy mailbox and proxy counter. GPU doorbell: the doorbell record in GPU memory (the GPU's
+      // producer index sq_wqe_pi is part of the device struct below); no CPU-side state exists.
+      if (rq.dbMode == GDAKI_REC_DB_CPU_PROXY) {
+        __atomic_store_n(v->sq_dbrec, (__be32)0, __ATOMIC_RELEASE);
+        if (gdakiRecDiag() != 2) {
+          __atomic_store_n(&v->cpu_db[0], (uint64_t)0, __ATOMIC_RELEASE);
+          v->sq_wqe_pi_last = 0;
+        }
+      } else if (gdakiRecDiag() != 3) {
+        // (transparent recovery: a copy, not a memset, which may need a kernel slot the application holds)
+        if (gdakiTsInHelper ? gdakiTsZeroDev(r, v->qp_cpu->sq_dbrec, sizeof(uint32_t), 0) != ncclSuccess
+                            : (cudaMemsetAsync(v->qp_cpu->sq_dbrec, 0, sizeof(uint32_t), r->stream) != cudaSuccess ||
+                               cudaStreamSynchronize(r->stream) != cudaSuccess)) {
+          WARN("GIN/REC: commit: cannot clear the GPU doorbell record of qpn=%#x", gdakiRecQpn(q));
+          bad = true;
+          return;
+        }
+      }
+      // (c) device QP struct: new WQE index epoch; CQ mapping advanced by the WQEs of the old one.
+      struct doca_gpu_dev_verbs_qp nd = rq.snap;
+      nd.sq_rsvd_index = 0;
+      nd.sq_ready_index = 0;
+      nd.sq_wqe_pi = (gdakiRecDiag() == 4) ? rq.snap.sq_wqe_pi : 0;  // diag keep_gpu_pi: stale GPU producer index
+      nd.sq_lock = 0;
+      nd.cq_sq.cqe_ci = 0;
+      nd.cq_sq.cqe_rsvd = rq.snap.cq_sq.cqe_rsvd + rq.epochWqes;
+      if (gdakiRecDiag() == 1) nd.cq_sq.cqe_rsvd = rq.epochWqes;  // diagnostic: DOCA's formula
+      if (!gdakiTsInHelper) {
+        if (gdakiRecH2D(r, v->qp_gpu, &nd, sizeof(nd)) != ncclSuccess) { bad = true; return; }
+      } else {
+        // Transparent recovery: the application's kernel keeps running. Write only the fields the
+        // commit owns (indices, lock, CQ mapping); never the gate words in reserved1/reserved2, which
+        // parked posters and waiters still touch. Posters and pollers are excluded (gate counters 0).
+        const size_t sqEnd = offsetof(struct doca_gpu_dev_verbs_qp, reserved1);
+        const size_t cqOff = offsetof(struct doca_gpu_dev_verbs_qp, cq_sq);
+        if (gdakiRecH2D(r, v->qp_gpu, &nd, sqEnd) != ncclSuccess ||
+            gdakiRecH2D(r, (uint8_t*)v->qp_gpu + cqOff, (uint8_t*)&nd + cqOff, sizeof(nd.cq_sq)) != ncclSuccess) {
+          bad = true;
+          return;
+        }
+      }
+      v->qp_cpu->sq_rsvd_index = 0;
+      v->qp_cpu->sq_ready_index = 0;
+      v->qp_cpu->sq_wqe_pi = 0;
+      v->qp_cpu->sq_lock = 0;
+      v->qp_cpu->cq_sq.cqe_ci = 0;
+      v->qp_cpu->cq_sq.cqe_rsvd = nd.cq_sq.cqe_rsvd;
+      // (d) GIN get tickets of this (context, peer): WQE indices of the old epoch.
+      const size_t off = (size_t)rq.ctxIdx * nranks + rq.peer;
+      if (gdakiTsInHelper ? (gdakiTsZeroDev(r, g->last_issued_get + off, sizeof(uint64_t), 0) != ncclSuccess ||
+                             gdakiTsZeroDev(r, g->last_visible_get + off, sizeof(uint64_t), 0) != ncclSuccess)
+                          : (cudaMemsetAsync(g->last_issued_get + off, 0, sizeof(uint64_t), r->stream) != cudaSuccess ||
+                             cudaMemsetAsync(g->last_visible_get + off, 0, sizeof(uint64_t), r->stream) != cudaSuccess ||
+                             cudaStreamSynchronize(r->stream) != cudaSuccess)) {
+        WARN("GIN/REC: commit: cannot clear get tickets");
+        bad = true;
+        return;
+      }
+      double c = gdakiQ4MonoMs();
+      st.resyncUs += (c - b) * 1e3;
+      // (e) reconnect with the connect-time attributes and the fresh PSNs.
+      if (gdakiConnectQp(g, q, &rq.exch, rq.lag, remote->sqPsn[idx], rq.newSqPsn) != ncclSuccess) {
+        WARN("GIN/REC: commit: reconnect of qpn=%#x failed", gdakiRecQpn(q));
+        bad = true;
+        return;
+      }
+      st.connectUs += (gdakiQ4MonoMs() - c) * 1e3;
+      INFO(NCCL_NET, "GIN/REC: qpn=%#x -> remote %#x reconnected: epoch_wqes=%lu cqe_rsvd %lu->%lu rq_psn=%#x sq_psn=%#x",
+           gdakiRecQpn(q), rq.exch.qpn, (unsigned long)rq.epochWqes, (unsigned long)rq.snap.cq_sq.cqe_rsvd,
+           (unsigned long)nd.cq_sq.cqe_rsvd, remote->sqPsn[idx], rq.newSqPsn);
+    });
+    if (bad) {
+      // A half-reset pair must never carry traffic: leave every QP of this peer in ERR.
+      gdakiRecAllToErr(r, peer);
+      ret = ncclSystemError;
+    }
+  }
+  if (ret != ncclSuccess) {
+    for (auto* r : rs) {
+      r->state = 0;
+      r->nAborts++;
+      gdakiRecResume(r);
+    }
+    WARN("GIN/REC: commit failed (peer=%d); QPs left in ERR", peer);
+    return ret;
+  }
+  // Test hook (delay -1): fire the armed shot now, after RTS and before Commit returns.
+  for (auto* r : rs) {
+    int shot = 0, total = 0;
+    {
+      std::lock_guard<std::mutex> lk(r->hookMu);
+      shot = r->armShot;
+      total = r->armTotal;
+    }
+    if (shot > 0) {
+      char tag[64];
+      snprintf(tag, sizeof(tag), " (shot %d/%d, inside commit)", shot, total);
+      std::lock_guard<std::mutex> op(r->opMu);
+      ncclGinGdakiFaultFire(r->ctx, tag);
+    }
+  }
+  // Clear the Q4 error state: device sticky errors, host flag, the GIN async result it set.
+  // (Transparent recovery never raises them for a fault it recovers, and one it declined, possibly for
+  // another peer, must stay surfaced: skipped in the helper.)
+  for (auto* r : rs) {
+    struct gdakiQ4Host* q = r->ctx->q4;
+    if (!gdakiTsInHelper) {
+    if (cudaMemsetAsync(q->dev->sticky, 0, sizeof(q->dev->sticky), r->stream) != cudaSuccess ||
+        cudaStreamSynchronize(r->stream) != cudaSuccess) {
+      WARN("GIN/REC: commit: cannot clear the device error state");
+      ret = ncclUnhandledCudaError;
+    }
+    {
+      std::lock_guard<std::mutex> lk(q->lastMu);
+      q->nErrSinceRec = 0;
+    }
+    q->hasError.store(0, std::memory_order_release);
+    if (q->asyncResult && q->setAsync.exchange(0)) {
+      ncclResult_t expect = ncclRemoteError;
+      __atomic_compare_exchange_n(q->asyncResult, &expect, ncclSuccess, false, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE);
+    }
+    }
+    r->state = 0;
+    r->nCommits++;
+    gdakiRecResume(r);
+    {
+      std::lock_guard<std::mutex> op(r->opMu);
+      std::lock_guard<std::mutex> lk(r->hookMu);
+      r->commits++;
+      r->armShot = 0;
+    }
+    r->hookCv.notify_all();
+  }
+  st.commitUs = (gdakiQ4MonoMs() - t0) * 1e3;
+  if (stats) *stats = st;
+  INFO(NCCL_NET, "GIN/REC: committed peer=%d qps=%u reset_us=%.0f resync_us=%.0f connect_us=%.0f total_us=%.0f", peer, n,
+       st.resetUs, st.resyncUs, st.connectUs, st.commitUs);
+  return ret;
+}
+
+NCCL_API(ncclResult_t, ncclGinRecoverAbort, ncclComm_t comm, int peer);
+ncclResult_t ncclGinRecoverAbort(ncclComm_t comm, int peer) {
+  std::vector<struct gdakiRecHost*> rs;
+  gdakiRecFind((void*)comm, rs);
+  if (rs.empty()) return ncclInvalidUsage;
+  if (!gdakiTsInHelper) {
+    for (auto* r_ : rs)
+      if (gdakiTsActive(r_)) {
+        WARN("GIN/REC: %s: transparent recovery (NCCL_GIN_FAULT_TRANSPARENT=1) owns the QPs", __func__);
+        return ncclInvalidUsage;
+      }
+  }
+  for (auto* r : rs) {
+    if (r->state != 1) continue;
+    r->state = 0;
+    r->nAborts++;
+    gdakiRecResume(r);  // QPs stay in ERR; the Q4 error stays set
+    WARN("GIN/REC: recovery aborted (peer=%d); QPs left in ERR", peer);
+  }
+  return ncclSuccess;
+}
+
+// ===========================================================================
+// GIN transparent recovery S1 (research build; default OFF).
+//   NCCL_GIN_FAULT_TRANSPARENT=1  needs NCCL_GIN_FAULT_RECOVERY=1 and NCCL_GIN_FAULT_CLASSIFY=1; user devComm,
+//                                 GPU-rung doorbells (GPU_SM_DB), ring CQ, no companion QPs. Must be set on
+//                                 every rank (init is collective). Each GDAKI context has its own helper.
+//   NCCL_GIN_TS_HANDSHAKE_MS=<ms>  handshake bound (3000); the initiator waits for ACK this long plus the
+//                                 responder's quiesce and drain bounds, the responder for DONE twice this
+//   NCCL_GIN_TS_HOLD_MS=<ms>       device: bound on how long a waiter holds for one recovery (30000; it must
+//                                 exceed the host's own bounds for one round, ~quiesce+drain+2x handshake)
+//   NCCL_GIN_TS_QUIESCE_MS=<ms>    bound on waiting for in-gate posters to leave (5000)
+//   NCCL_GIN_TS_CONNECT_MS=<ms>    bound on the init-time socket setup (15000)
+//   NCCL_GIN_TS_DIAG=norebase|noring  negative controls only: waiters keep their stale ticket / the
+//                                 host does not ring the doorbell for the re-posted WQEs
+// The application's kernels and host code are unchanged. A helper thread per GDAKI context (not the
+// application) takes the device-classified fault from the Q4 mailbox, applies the policy (LOCAL_QP_ERR:
+// recover; RETRY_EXC: recover iff the peer's socket shows no FIN/RST; else decline), pauses the device
+// posters (gate in the QP padding), runs the existing Prepare/Commit (gin_recovery v1+v2) with the peer
+// over a library-owned TCP socket, learns from the peer's QPC how many of its WQEs the peer executed
+// (rmsn), re-posts the rest into the reset SQ, rings the doorbell from the host, and publishes a new
+// gate epoch with a logical base so device waiters that hold across the recovery rebase their ticket
+// (gin_gdaki.h tsPoll). Design and measurements: harness/gpu-initiated/gin_recovery/TRANSPARENT_S1.md.
+// ===========================================================================
+NCCL_PARAM(GinFaultTransparent, "GIN_FAULT_TRANSPARENT", 0);
+NCCL_PARAM(GinTsHandshakeMs, "GIN_TS_HANDSHAKE_MS", 3000);
+NCCL_PARAM(GinTsHoldMs, "GIN_TS_HOLD_MS", 30000);
+NCCL_PARAM(GinTsQuiesceMs, "GIN_TS_QUIESCE_MS", 5000);
+NCCL_PARAM(GinTsConnectMs, "GIN_TS_CONNECT_MS", 15000);
+
+#define GDAKI_TS_MAGIC 0x31535447u  // "GTS1"
+#define GDAKI_TS_DIAG_NOREBASE 0x1u
+#define GDAKI_TS_DIAG_NORING 0x2u
+enum { GDAKI_TS_HELLO = 1, GDAKI_TS_REQ = 2, GDAKI_TS_ACK = 3, GDAKI_TS_NACK = 4, GDAKI_TS_DONE = 5, GDAKI_TS_FAIL = 6 };
+
+static const char* gdakiTsMsgName(uint32_t t) {
+  switch (t) {
+  case GDAKI_TS_HELLO: return "HELLO";
+  case GDAKI_TS_REQ: return "REQ";
+  case GDAKI_TS_ACK: return "ACK";
+  case GDAKI_TS_NACK: return "NACK";
+  case GDAKI_TS_DONE: return "DONE";
+  case GDAKI_TS_FAIL: return "FAIL";
+  default: return "?";
+  }
+}
+
+// One fixed-size record on the helper socket.
+struct gdakiTsMsg {
+  uint32_t magic;
+  uint32_t type;
+  uint64_t round;  // initiator's round number (REQ/ACK/NACK/DONE of one round carry the same value)
+  int32_t from;
+  int32_t arg;     // REQ: fault class; NACK/FAIL: reason code
+  uint32_t nqp;
+  uint32_t pad;
+  ncclGinRecoverToken_t tok;                       // REQ/ACK: Prepare token of the sender
+  uint32_t executed[NCCL_GIN_RECOVERY_MAX_QPS];    // REQ/ACK: request messages of the receiver's QP (token
+                                                   // order) that the sender's QP executed in this incarnation
+  uint32_t nrp[NCCL_GIN_RECOVERY_MAX_QPS];         // REQ/ACK: sender's next_rcv_psn per QP (diagnostic)
+  double t[4];                                     // ACK: responder's quiesce/prepare/commit/total (us)
+};
+
+struct gdakiTsPeer {
+  int fd = -1;
+  bool gone = false;      // FIN/RST seen: recovery with this peer is no longer possible
+  bool declined = false;  // terminal
+  size_t have = 0;        // bytes of a partial record in buf
+  struct gdakiTsMsg buf;
+};
+
+struct gdakiTsQp {        // host copy, per qp_idx
+  uint32_t epoch = 0;     // current stable (even) epoch of the gate
+  uint64_t lbase = 0;     // host copy of gate.lbase (logical index of physical WQE 0 of the stable epoch)
+  uint32_t handled = 0;   // highest record epoch + 2 the helper has taken (for the lost-record scan)
+  int lostScans = 0;      // consecutive scans that saw gate.reported ahead of `handled`
+  uint32_t rmsn0 = 0;     // responder MSN at the start of the current incarnation
+};
+
+struct gdakiTsFault {
+  struct ncclGinGdakiQ4Record rec;
+  double monoMs;          // when the Q4 watcher read the record
+};
+
+struct gdakiTs {
+  std::thread th;
+  std::atomic<bool> stop{false};
+  std::mutex qMu;
+  std::vector<struct gdakiTsFault> faults;
+  std::vector<struct gdakiTsPeer> peers;  // by rank
+  std::vector<struct gdakiTsQp> qs;       // by qp_idx
+  uint32_t diag = 0;
+  int handshakeMs = 3000, holdMs = 30000, quiesceMs = 5000;
+  uint64_t round = 0;
+  int nRounds = 0, nRecovered = 0, nDeclined = 0, nStale = 0;
+  std::atomic<int> active{0};             // 1 once the helper runs (gdakiTsActive)
+};
+
+
+static uint32_t gdakiTsDiag() {
+  const char* e = getenv("NCCL_GIN_TS_DIAG");
+  if (e == nullptr) return 0;
+  uint32_t v = 0;
+  if (strstr(e, "norebase")) v |= GDAKI_TS_DIAG_NOREBASE;
+  if (strstr(e, "noring")) v |= GDAKI_TS_DIAG_NORING;
+  return v;
+}
+
+static bool gdakiTsActive(struct gdakiRecHost* r) {
+  return r != nullptr && r->ts != nullptr && r->ts->active.load(std::memory_order_acquire) != 0;
+}
+
+// Only faults on a gated QP (a peer with a helper socket) go to the helper.
+static bool gdakiTsRoutes(struct gdakiRecHost* r, const struct ncclGinGdakiQ4Record& rec) {
+  if (!gdakiTsActive(r)) return false;
+  const int p = (int)rec.peer;
+  return p >= 0 && p < (int)r->ts->peers.size() && p != r->ctx->rank && r->ts->peers[p].fd >= 0;
+}
+
+static void gdakiTsPushFault(struct gdakiRecHost* r, const struct ncclGinGdakiQ4Record& rec, double monoMs) {
+  std::lock_guard<std::mutex> lk(r->ts->qMu);
+  r->ts->faults.push_back({rec, monoMs});
+}
+
+// ---- socket helpers (every fd is non-blocking; every wait is bounded) ----
+static void gdakiTsSockOpts(int fd) {
+  int one = 1;
+  setsockopt(fd, IPPROTO_TCP, TCP_NODELAY, &one, sizeof(one));
+  // A host that dies without FIN/RST is detected by keepalive / user timeout within about 5 s.
+  setsockopt(fd, SOL_SOCKET, SO_KEEPALIVE, &one, sizeof(one));
+  int idle = 2, intvl = 1, cnt = 3;
+  unsigned int uto = 5000;
+  setsockopt(fd, IPPROTO_TCP, TCP_KEEPIDLE, &idle, sizeof(idle));
+  setsockopt(fd, IPPROTO_TCP, TCP_KEEPINTVL, &intvl, sizeof(intvl));
+  setsockopt(fd, IPPROTO_TCP, TCP_KEEPCNT, &cnt, sizeof(cnt));
+  setsockopt(fd, IPPROTO_TCP, TCP_USER_TIMEOUT, &uto, sizeof(uto));
+  int fl = fcntl(fd, F_GETFL, 0);
+  if (fl >= 0) fcntl(fd, F_SETFL, fl | O_NONBLOCK);
+}
+
+static int gdakiTsSend(int fd, struct gdakiTsMsg* m, int timeoutMs) {
+  m->magic = GDAKI_TS_MAGIC;
+  const char* p = (const char*)m;
+  size_t off = 0;
+  const double deadline = gdakiQ4MonoMs() + timeoutMs;
+  while (off < sizeof(*m)) {
+    ssize_t k = send(fd, p + off, sizeof(*m) - off, MSG_NOSIGNAL | MSG_DONTWAIT);
+    if (k > 0) {
+      off += (size_t)k;
+      continue;
+    }
+    if (k < 0 && (errno == EAGAIN || errno == EWOULDBLOCK || errno == EINTR)) {
+      int rem = (int)(deadline - gdakiQ4MonoMs());
+      if (rem <= 0) return -1;
+      struct pollfd pf = {fd, POLLOUT, 0};
+      (void)poll(&pf, 1, std::min(rem, 5));
+      continue;
+    }
+    return -1;
+  }
+  return 0;
+}
+
+// Reads what is available. 1: a whole record is in *out; 0: not yet; -1: FIN, error or bad magic.
+static int gdakiTsPump(struct gdakiTsPeer& pe, struct gdakiTsMsg* out) {
+  while (pe.have < sizeof(struct gdakiTsMsg)) {
+    ssize_t k = recv(pe.fd, (char*)&pe.buf + pe.have, sizeof(struct gdakiTsMsg) - pe.have, MSG_DONTWAIT);
+    if (k == 0) return -1;
+    if (k < 0) return (errno == EAGAIN || errno == EWOULDBLOCK || errno == EINTR) ? 0 : -1;
+    pe.have += (size_t)k;
+  }
+  *out = pe.buf;
+  pe.have = 0;
+  return out->magic == GDAKI_TS_MAGIC ? 1 : -1;
+}
+
+// Waits up to timeoutMs for one record. 1 record, 0 timeout, -1 FIN/error.
+static int gdakiTsRecv(struct gdakiTsPeer& pe, struct gdakiTsMsg* out, int timeoutMs, std::atomic<bool>* stop) {
+  const double deadline = gdakiQ4MonoMs() + timeoutMs;
+  while (true) {
+    int r = gdakiTsPump(pe, out);
+    if (r != 0) return r;
+    int rem = (int)(deadline - gdakiQ4MonoMs());
+    if (rem <= 0 || (stop && stop->load(std::memory_order_acquire))) return 0;
+    struct pollfd pf = {pe.fd, POLLIN, 0};
+    (void)poll(&pf, 1, std::min(rem, 5));
+  }
+}
+
+// Liveness from the socket: FIN or a TCP error = dead; EAGAIN = no evidence of death.
+static bool gdakiTsAlive(struct gdakiTsPeer& pe) {
+  if (pe.fd < 0 || pe.gone) return false;
+  if (pe.have > 0) return true;
+  char c;
+  ssize_t k = recv(pe.fd, &c, 1, MSG_PEEK | MSG_DONTWAIT);
+  if (k > 0) return true;
+  if (k == 0) return false;
+  return errno == EAGAIN || errno == EWOULDBLOCK || errno == EINTR;
+}
+
+// ---- gate access (device QP padding) ----
+static uint8_t* gdakiTsGateDev(struct doca_gpu_verbs_qp* v) {
+  return (uint8_t*)v->qp_gpu + offsetof(struct doca_gpu_dev_verbs_qp, reserved2);
+}
+
+static ncclResult_t gdakiTsGateWrite(struct gdakiRecHost* r, struct doca_gpu_verbs_qp* v, size_t off, const void* src,
+                                     size_t n) {
+  memcpy(v->qp_cpu->reserved2 + off, src, n);  // host shadow stays equal to the device copy
+  return gdakiRecH2D(r, gdakiTsGateDev(v) + off, src, n);
+}
+
+static ncclResult_t gdakiTsGateRead(struct gdakiRecHost* r, struct doca_gpu_verbs_qp* v, size_t off, void* dst,
+                                    size_t n) {
+  return gdakiRecD2H(r, dst, gdakiTsGateDev(v) + off, n);
+}
+
+static uint8_t* gdakiTsGate2Dev(struct doca_gpu_verbs_qp* v) {
+  return (uint8_t*)v->qp_gpu + offsetof(struct doca_gpu_dev_verbs_qp, reserved1);
+}
+
+// Fill device memory from pinned host memory with a copy (never a memset: that may be a kernel, which
+// cannot start while the application's kernels occupy the GPU).
+static ncclResult_t gdakiTsZeroDev(struct gdakiRecHost* r, void* dst, size_t n, uint8_t byte) {
+  if (n > r->pinnedSize) return ncclInternalError;
+  memset(r->pinned, byte, n);
+  CUDACHECK(cudaMemcpyAsync(dst, r->pinned, n, cudaMemcpyHostToDevice, r->stream));
+  CUDACHECK(cudaStreamSynchronize(r->stream));
+  return ncclSuccess;
+}
+
+// A device waiter of a QP to `peer` stopped waiting for the next stable epoch (tsGiveUp): the
+// application was told the operation failed, so this round must not publish (decline).
+static ncclResult_t gdakiTsAbandoned(struct gdakiRecHost* r, int peer, bool* any) {
+  ncclResult_t ret = ncclSuccess;
+  *any = false;
+  gdakiRecForPeer(r, peer, [&](gdakiRecQp& rq, struct doca_gpu_verbs_qp_hl* q) {
+    struct ncclGinTsGate2 g2;
+    if (gdakiRecD2H(r, &g2, gdakiTsGate2Dev(q->qp_gverbs), sizeof(g2)) != ncclSuccess) ret = ncclSystemError;
+    else if (g2.abandoned >= r->ts->qs[rq.qpIdx].epoch + 2u) *any = true;
+  });
+  return ret;
+}
+
+// Commit point (Dekker with tsGiveUp): write commit = the epoch this round publishes on every QP to
+// `peer`, then read abandoned. Past this point a waiter that reaches its bound keeps waiting.
+static ncclResult_t gdakiTsCommitPoint(struct gdakiRecHost* r, int peer, bool* abandoned) {
+  ncclResult_t ret = ncclSuccess;
+  gdakiRecForPeer(r, peer, [&](gdakiRecQp& rq, struct doca_gpu_verbs_qp_hl* q) {
+    const uint32_t c = r->ts->qs[rq.qpIdx].epoch + 2u;
+    if (ret == ncclSuccess &&
+        gdakiTsGateWrite(r, q->qp_gverbs, offsetof(struct ncclGinTsGate, commit), &c, sizeof(c)) != ncclSuccess)
+      ret = ncclSystemError;
+  });
+  if (ret != ncclSuccess) return ret;
+  return gdakiTsAbandoned(r, peer, abandoned);
+}
+
+// Executed request messages (rmsn delta) of every QP to `peer`, in token order; also next_rcv_psn.
+static ncclResult_t gdakiTsExecuted(struct gdakiRecHost* r, int peer, uint32_t* executed, uint32_t* nrp,
+                                    uint32_t* nqp) {
+  ncclResult_t ret = ncclSuccess;
+  unsigned i = 0;
+  gdakiRecForPeer(r, peer, [&](gdakiRecQp& rq, struct doca_gpu_verbs_qp_hl* q) {
+    uint32_t rmsn = 0, rcv = 0, st = 0;
+    if (i >= NCCL_GIN_RECOVERY_MAX_QPS || doca_verbs_qp_query_seq(q->qp, &rmsn, &rcv, nullptr, &st) != DOCA_SUCCESS) {
+      ret = ncclSystemError;
+      return;
+    }
+    executed[i] = (rmsn - r->ts->qs[rq.qpIdx].rmsn0) & 0xffffffu;
+    nrp[i] = rcv;
+    i++;
+  });
+  *nqp = i;
+  return ret;
+}
+
+// After a commit, before any traffic of the new incarnation: the responder MSN baseline.
+static ncclResult_t gdakiTsBaseline(struct gdakiRecHost* r, int peer) {
+  ncclResult_t ret = ncclSuccess;
+  gdakiRecForPeer(r, peer, [&](gdakiRecQp& rq, struct doca_gpu_verbs_qp_hl* q) {
+    uint32_t rmsn = 0;
+    if (doca_verbs_qp_query_seq(q->qp, &rmsn, nullptr, nullptr, nullptr) != DOCA_SUCCESS) {
+      ret = ncclSystemError;  // a stale baseline would miscount the next round: the caller declines
+      return;
+    }
+    if (rmsn != 0)
+      INFO(NCCL_NET, "GIN/TS: qpn=%#x rmsn=%u after reconnect (not reset by 2RST); used as the baseline",
+           gdakiRecQpn(q), rmsn);
+    r->ts->qs[rq.qpIdx].rmsn0 = rmsn;
+  });
+  return ret;
+}
+
+// Pause the posters of every QP to `peer` and wait until none is inside the gate.
+static ncclResult_t gdakiTsQuiesce(struct gdakiRecHost* r, int peer, const char** why) {
+  ncclResult_t ret = ncclSuccess;
+  gdakiRecForPeer(r, peer, [&](gdakiRecQp& rq, struct doca_gpu_verbs_qp_hl* q) {
+    if (ret != ncclSuccess) return;
+    struct gdakiTsQp& s = r->ts->qs[rq.qpIdx];
+    const uint32_t w[2] = {1u, s.epoch | 1u};  // pause = 1, epoch odd: a recovery owns the QP
+    if (gdakiTsGateWrite(r, q->qp_gverbs, offsetof(struct ncclGinTsGate, pause), w, sizeof(w)) != ncclSuccess) {
+      ret = ncclSystemError;
+      *why = "cannot write the gate";
+    }
+  });
+  if (ret != ncclSuccess) return ret;
+  // Stop the old incarnation now: posters blocked inside the gate (waiting for a free SQ slot) and
+  // waiters polling in the counted region only leave once their WQEs complete, which in ERR they do
+  // at once (flush CQEs). Prepare moves the QPs to ERR again (harmless). Every QP state change goes
+  // through opMu, like Prepare/Commit and the fault hook: two concurrent 2ERR_QP commands on one QP
+  // (helper + hook thread) hung the firmware command for ~100 s and leaked a command slot (measured).
+  {
+    std::lock_guard<std::mutex> op(r->opMu);
+    gdakiRecAllToErr(r, peer);
+  }
+  const double deadline = gdakiQ4MonoMs() + r->ts->quiesceMs;
+  gdakiRecForPeer(r, peer, [&](gdakiRecQp&, struct doca_gpu_verbs_qp_hl* q) {
+    while (ret == ncclSuccess) {
+      uint32_t active = 0;
+      struct ncclGinTsGate2 g2;
+      if (gdakiTsGateRead(r, q->qp_gverbs, offsetof(struct ncclGinTsGate, active), &active, sizeof(active)) !=
+            ncclSuccess ||
+          gdakiRecD2H(r, &g2, gdakiTsGate2Dev(q->qp_gverbs), sizeof(g2)) != ncclSuccess) {
+        ret = ncclSystemError;
+        *why = "cannot read the gate";
+        break;
+      }
+      if (active == 0 && g2.pollers == 0) break;
+      if (gdakiQ4MonoMs() > deadline) {
+        WARN("GIN/TS: qpn=%#x: %u poster(s) / %u poller(s) still inside the gate after %d ms", gdakiRecQpn(q),
+             active, g2.pollers, r->ts->quiesceMs);
+        ret = ncclSystemError;
+        *why = "posters/pollers did not leave the gate";
+        break;
+      }
+      std::this_thread::sleep_for(std::chrono::microseconds(20));
+    }
+  });
+  bool ab = false;
+  if (ret == ncclSuccess && (gdakiTsAbandoned(r, peer, &ab) != ncclSuccess || ab)) {
+    ret = ncclSystemError;
+    *why = "a device waiter already gave up (the application saw the error)";
+  }
+  return ret;
+}
+
+// A WQE that is not one request message (or a READ) in the ending epoch of any QP to `peer`.
+static ncclResult_t gdakiTsNonMsg(struct gdakiRecHost* r, int peer, uint32_t* any) {
+  ncclResult_t ret = ncclSuccess;
+  *any = 0;
+  gdakiRecForPeer(r, peer, [&](gdakiRecQp&, struct doca_gpu_verbs_qp_hl* q) {
+    uint32_t nm = 0;
+    if (gdakiTsGateRead(r, q->qp_gverbs, offsetof(struct ncclGinTsGate, nonmsg), &nm, sizeof(nm)) != ncclSuccess)
+      ret = ncclSystemError;
+    *any |= nm;
+  });
+  return ret;
+}
+
+struct gdakiTsReplayStats {
+  unsigned nqp = 0;
+  uint64_t replayed = 0;
+  char detail[256] = {0};  // per QP: S/U/n
+};
+
+// After Commit (QPs in RTS, device indices 0, cqe_rsvd advanced): per QP to `peer`, WQEs [U, S) of the
+// ending epoch were not executed by the peer (U = S - in-flight, in-flight from the peer's rmsn).
+// Copy them to physical slots [0, n) with their ctrl index rewritten, set the device producer indices
+// to n, publish the logical base of the new epoch (lbase += U), ring the doorbell from
+// the host (GPU_SM_DB: the doorbell record is in GPU memory; the UAR is also mapped on the host), and
+// finally publish the new stable epoch and clear pause.
+static ncclResult_t gdakiTsReplayResume(struct gdakiRecHost* r, int peer, const uint32_t* executed, uint32_t nqp,
+                                        struct gdakiTsReplayStats* rs, const char** why) {
+  ncclResult_t ret = ncclSuccess;
+  unsigned i = 0;
+  size_t dl = 0;
+  bool ab = false;
+  if (gdakiTsCommitPoint(r, peer, &ab) != ncclSuccess || ab) {  // before anything executes again
+    *why = "a device waiter gave up before the commit point";
+    return ncclSystemError;
+  }
+  gdakiRecForPeer(r, peer, [&](gdakiRecQp& rq, struct doca_gpu_verbs_qp_hl* q) {
+    const unsigned idx = i++;
+    if (ret != ncclSuccess) return;
+    struct doca_gpu_verbs_qp* v = q->qp_gverbs;
+    struct gdakiTsQp& s = r->ts->qs[rq.qpIdx];
+    if (idx >= nqp) {
+      ret = ncclInvalidUsage;
+      *why = "peer reported fewer QPs";
+      return;
+    }
+    const uint64_t S = rq.epochWqes;
+    const uint32_t inflight = ((uint32_t)(S & 0xffffffu) - executed[idx]) & 0xffffffu;
+    const uint32_t ringN = rq.snap.sq_wqe_num, mask = rq.snap.sq_wqe_mask;
+    if ((uint64_t)inflight > S || inflight > ringN) {
+      WARN("GIN/TS: qpn=%#x: peer executed %u of this epoch's %lu WQEs (mod 2^24): out of range", gdakiRecQpn(q),
+           executed[idx], (unsigned long)S);
+      ret = ncclInvalidUsage;
+      *why = "executed count out of range";
+      return;
+    }
+    const uint64_t U = S - inflight;
+    const uint32_t n = inflight;
+    // (a) re-post [U, S) at physical [0, n): read all first (slots may overlap), then write.
+    if (n > 0) {
+      std::vector<uint8_t> w((size_t)n * 64);
+      for (uint32_t j = 0; j < n && ret == ncclSuccess; j++) {
+        const uint8_t* src = rq.snap.sq_wqe_daddr + (size_t)((U + j) & mask) * 64;
+        if (gdakiRecD2H(r, w.data() + (size_t)j * 64, src, 64) != ncclSuccess) ret = ncclSystemError;
+      }
+      for (uint32_t j = 0; j < n && ret == ncclSuccess; j++) {
+        uint8_t* wq = w.data() + (size_t)j * 64;
+        uint32_t w0;
+        memcpy(&w0, wq, 4);
+        w0 = be32toh(w0);
+        const uint8_t opc = w0 & 0xff;
+        // S1 re-posts RDMA WRITE (idempotent) and a non-fetching use of ATOMIC_FA (GIN's signal ADD,
+        // result to a sink) only; anything else declines.
+        if (opc != 0x08 && opc != 0x12) {
+          WARN("GIN/TS: qpn=%#x: WQE %lu to re-post has opcode %#x (S1 re-posts RDMA_WRITE/ATOMIC_FA only)",
+               gdakiRecQpn(q), (unsigned long)(U + j), opc);
+          ret = ncclInvalidUsage;
+          *why = "unsupported opcode to re-post";
+          break;
+        }
+        w0 = (w0 & 0xff0000ffu) | ((j & 0xffffu) << 8);
+        w0 = htobe32(w0);
+        memcpy(wq, &w0, 4);
+        if (gdakiRecH2D(r, rq.snap.sq_wqe_daddr + (size_t)(j & mask) * 64, wq, 64) != ncclSuccess)
+          ret = ncclSystemError;
+      }
+      if (ret != ncclSuccess) {
+        if (*why == nullptr) *why = "cannot re-post WQEs";
+        return;
+      }
+    }
+    // (b) device producer indices: n reserved, ready and submitted (the host rings it below).
+    const uint64_t idxs[3] = {n, n, n};
+    static_assert(offsetof(struct doca_gpu_dev_verbs_qp, sq_ready_index) == 8 &&
+                    offsetof(struct doca_gpu_dev_verbs_qp, sq_wqe_pi) == 16,
+                  "sq_rsvd_index/sq_ready_index/sq_wqe_pi must be contiguous");
+    if (gdakiRecH2D(r, v->qp_gpu, idxs, sizeof(idxs)) != ncclSuccess) {
+      ret = ncclSystemError;
+      *why = "cannot write the device indices";
+      return;
+    }
+    v->qp_cpu->sq_rsvd_index = n;
+    v->qp_cpu->sq_ready_index = n;
+    v->qp_cpu->sq_wqe_pi = n;
+    // (c) logical base of the new epoch.
+    const uint32_t eNew = s.epoch + 2u;
+    const uint64_t lNew = s.lbase + U;
+    s.lbase = lNew;
+    if (gdakiTsGateWrite(r, v, offsetof(struct ncclGinTsGate, lbase), &lNew, 8) != ncclSuccess) {
+      ret = ncclSystemError;
+      *why = "cannot write lbase";
+      return;
+    }
+    // (d) doorbell from the host: doorbell record first, then the UAR (the NIC reads the record only on
+    // doorbell recovery; the 8-byte doorbell carries the producer index).
+    if (n > 0 && !(r->ts->diag & GDAKI_TS_DIAG_NORING)) {
+      const __be32 dbr = htobe32(n & 0xffffu);
+      void* uar = nullptr;
+      if (gdakiRecH2D(r, v->qp_cpu->sq_dbrec, &dbr, sizeof(dbr)) != ncclSuccess ||
+          doca_verbs_qp_get_uar_addr(q->qp, &uar) != DOCA_SUCCESS || uar == nullptr) {
+        ret = ncclSystemError;
+        *why = "cannot ring the doorbell";
+        return;
+      }
+      struct doca_gpunetio_ib_mlx5_wqe_ctrl_seg ctrl;
+      memset(&ctrl, 0, sizeof(ctrl));
+      ctrl.opmod_idx_opcode = htobe32(n << 8);
+      ctrl.qpn_ds = v->qp_cpu->sq_num_shift8_be;
+      std::atomic_thread_fence(std::memory_order_release);
+      reinterpret_cast<std::atomic<uint64_t>*>(uar)->store(*reinterpret_cast<uint64_t*>(&ctrl),
+                                                           std::memory_order_relaxed);
+#if defined(__x86_64__)
+      __builtin_ia32_sfence();  // flush a write-combining UAR mapping
+#endif
+    }
+    // (e) publish: nonmsg cleared for the new epoch, then the new stable epoch with posters released.
+    const uint32_t zero = 0;
+    if (gdakiTsGateWrite(r, v, offsetof(struct ncclGinTsGate, nonmsg), &zero, sizeof(zero)) != ncclSuccess) {
+      ret = ncclSystemError;
+      *why = "cannot clear nonmsg";
+      return;
+    }
+    const uint32_t pub[2] = {0u, eNew};
+    if (gdakiTsGateWrite(r, v, offsetof(struct ncclGinTsGate, pause), pub, sizeof(pub)) != ncclSuccess) {
+      ret = ncclSystemError;
+      *why = "cannot publish the epoch";
+      return;
+    }
+    s.epoch = eNew;
+    rs->nqp++;
+    rs->replayed += n;
+    if (dl < sizeof(rs->detail) - 1)
+      dl += snprintf(rs->detail + dl, sizeof(rs->detail) - dl, "%s%lu/%lu/%u", idx ? "," : "", (unsigned long)S,
+                     (unsigned long)U, n);
+  });
+  return ret;
+}
+
+// Terminal decline for `peer`: the error surfaces (device waiters and later waits return
+// ncclRemoteError; ncclCommGetAsyncError reports it) and the QPs stay in ERR, as without recovery.
+static void gdakiTsDecline(struct gdakiRecHost* r, int peer, const char* why, bool sendFail, int cls) {
+  struct gdakiTs* ts = r->ts;
+  struct gdakiTsPeer& pe = ts->peers[peer];
+  const bool first = !pe.declined;
+  pe.declined = true;
+  if (first) ts->nDeclined++;
+  if (r->state == 1 && r->preparedPeer == peer) (void)ncclGinRecoverAbort((ncclComm_t)r->commKey, peer);
+  {
+    std::lock_guard<std::mutex> op(r->opMu);  // QP state changes are serialized (see gdakiTsQuiesce)
+    gdakiRecAllToErr(r, peer);
+  }
+  gdakiRecForPeer(r, peer, [&](gdakiRecQp& rq, struct doca_gpu_verbs_qp_hl* q) {
+    struct gdakiTsQp& s = ts->qs[rq.qpIdx];
+    const uint32_t one = 1;
+    (void)gdakiTsGateWrite(r, q->qp_gverbs, offsetof(struct ncclGinTsGate, status), &one, sizeof(one));
+    s.epoch = (s.epoch | 1u) + 1u;  // even and newer than any epoch a waiter holds: holders wake, see status
+    const uint32_t pub[2] = {0u, s.epoch};
+    (void)gdakiTsGateWrite(r, q->qp_gverbs, offsetof(struct ncclGinTsGate, pause), pub, sizeof(pub));
+  });
+  struct gdakiQ4Host* q4 = r->ctx->q4;
+  if (gdakiTsZeroDev(r, q4->dev->sticky, sizeof(q4->dev->sticky), 1) != ncclSuccess)
+    WARN("GIN/TS: cannot set the device error state");
+  q4->hasError.store(1, std::memory_order_release);
+  if (q4->asyncResult) {
+    __atomic_store_n(q4->asyncResult, ncclRemoteError, __ATOMIC_RELEASE);
+    q4->setAsync.store(1, std::memory_order_release);
+  }
+  if (sendFail && pe.fd >= 0 && !pe.gone) {
+    struct gdakiTsMsg m;
+    memset(&m, 0, sizeof(m));
+    m.type = GDAKI_TS_FAIL;
+    m.from = r->ctx->rank;
+    m.arg = cls;
+    (void)gdakiTsSend(pe.fd, &m, 200);
+  }
+  WARN("GIN/TS: declined rank=%d peer=%d reason=\"%s\" class=%d mono_ms=%.3f (error surfaces; QPs left in ERR)",
+       r->ctx->rank, peer, why, cls, gdakiQ4MonoMs());
+}
+
+static const char* gdakiTsClassName(int cls) {
+  return gdakiQ4Class((uint8_t)cls, 0).name;
+}
+
+// Initiator: the device reported a fault on a QP to rec.peer.
+static void gdakiTsInitiate(struct gdakiRecHost* r, const struct gdakiTsFault& f) {
+  struct gdakiTs* ts = r->ts;
+  struct gdaki_context* g = r->ctx;
+  const struct ncclGinGdakiQ4Record& rec = f.rec;
+  const int nranks = g->collComm->nranks;
+  const int peer = (int)rec.peer;
+  const ncclComm_t comm = (ncclComm_t)r->commKey;
+  if (peer < 0 || peer >= nranks || peer == g->rank) return;
+  struct gdakiTsPeer& pe = ts->peers[peer];
+  if (pe.declined) return;
+  const int qpIdx = peer + (int)rec.ctx_id * nranks;
+  if (qpIdx < (int)ts->qs.size()) ts->qs[qpIdx].handled = std::max(ts->qs[qpIdx].handled, rec.ts_epoch + 2u);
+  if (qpIdx < (int)ts->qs.size() && ts->qs[qpIdx].epoch > rec.ts_epoch) {  // an earlier round covered it
+    ts->nStale++;
+    INFO(NCCL_NET, "GIN/TS: stale fault record (epoch %u < %u) ignored", rec.ts_epoch, ts->qs[qpIdx].epoch);
+    return;
+  }
+  const double t0 = gdakiQ4MonoMs();
+  const int cls = rec.cls;
+  // Policy (as gin_recovery's driver did, now inside the library).
+  if (cls == NCCL_GIN_Q4_CLASS_RETRY_EXC) {
+    if (!gdakiTsAlive(pe)) return gdakiTsDecline(r, peer, "RETRY_EXC and the peer's socket shows FIN/RST", false, cls);
+  } else if (cls != NCCL_GIN_Q4_CLASS_LOCAL_QP_ERR) {
+    char why[64];
+    snprintf(why, sizeof(why), "class %s is not recoverable", gdakiTsClassName(cls));
+    return gdakiTsDecline(r, peer, why, true, cls);
+  }
+  if (pe.gone || pe.fd < 0) return gdakiTsDecline(r, peer, "no helper socket to the peer", false, cls);
+  const uint64_t round = ++ts->round;
+  ts->nRounds++;
+  const char* why = nullptr;
+  ncclGinRecoverToken_t tok;
+  ncclGinRecoverStats_t st;
+  memset(&st, 0, sizeof(st));
+  struct gdakiTsMsg m, a;
+  uint32_t nm = 0, nqp = 0;
+  double tQ = 0, tP = 0, tA = 0, tC = 0;
+  struct gdakiTsReplayStats rs;
+  if (gdakiTsQuiesce(r, peer, &why) != ncclSuccess) return gdakiTsDecline(r, peer, why, true, cls);
+  tQ = gdakiQ4MonoMs();
+  if (ncclGinRecoverPrepare(comm, peer, &tok, &st) != ncclSuccess)
+    return gdakiTsDecline(r, peer, "prepare declined", true, cls);
+  if (gdakiTsNonMsg(r, peer, &nm) != ncclSuccess || nm != 0) {
+    snprintf(rs.detail, sizeof(rs.detail), "epoch posted a WQE S1 cannot count or re-post (mask %#x)", nm);
+    return gdakiTsDecline(r, peer, rs.detail, true, cls);
+  }
+  memset(&m, 0, sizeof(m));
+  m.type = GDAKI_TS_REQ;
+  m.round = round;
+  m.from = g->rank;
+  m.arg = cls;
+  m.tok = tok;
+  if (gdakiTsExecuted(r, peer, m.executed, m.nrp, &nqp) != ncclSuccess)
+    return gdakiTsDecline(r, peer, "QUERY_QP failed", true, cls);
+  m.nqp = nqp;
+  tP = gdakiQ4MonoMs();
+  if (gdakiTsSend(pe.fd, &m, ts->handshakeMs) != 0) {
+    pe.gone = true;
+    return gdakiTsDecline(r, peer, "cannot send REQ", false, cls);
+  }
+  // ACK (bounded: the handshake bound plus the responder's own quiesce and drain bounds). A REQ from
+  // the peer meanwhile is a collision: both sides decline (S1 has one initiator per QP pair).
+  const double deadline =
+    gdakiQ4MonoMs() + ts->handshakeMs + ts->quiesceMs + (double)ncclParamGinRecoveryDrainMs();
+  while (true) {
+    const int rem = (int)(deadline - gdakiQ4MonoMs());
+    const int got = rem > 0 ? gdakiTsRecv(pe, &a, rem, &ts->stop) : 0;
+    if (got < 0) {
+      pe.gone = true;
+      return gdakiTsDecline(r, peer, "peer closed the socket during the handshake", false, cls);
+    }
+    if (got == 0) return gdakiTsDecline(r, peer, "handshake timeout", true, cls);
+    if (a.type == GDAKI_TS_ACK && a.round == round) break;
+    if (a.type == GDAKI_TS_NACK || a.type == GDAKI_TS_FAIL)
+      return gdakiTsDecline(r, peer, a.type == GDAKI_TS_NACK ? "peer NACK" : "peer FAIL", false, cls);
+    if (a.type == GDAKI_TS_REQ) {
+      struct gdakiTsMsg n;
+      memset(&n, 0, sizeof(n));
+      n.type = GDAKI_TS_NACK;
+      n.round = a.round;
+      n.from = g->rank;
+      n.arg = 1;  // collision
+      (void)gdakiTsSend(pe.fd, &n, 200);
+      return gdakiTsDecline(r, peer, "simultaneous recovery from both ends (S1: one initiator)", false, cls);
+    }
+    WARN("GIN/TS: ignoring %s (round %lu) while waiting for ACK %lu", gdakiTsMsgName(a.type), (unsigned long)a.round,
+         (unsigned long)round);
+  }
+  tA = gdakiQ4MonoMs();
+  {
+    bool ab = false;
+    if (gdakiTsAbandoned(r, peer, &ab) != ncclSuccess || ab)
+      return gdakiTsDecline(r, peer, "a device waiter gave up during the handshake", true, cls);
+  }
+  if (ncclGinRecoverCommit(comm, peer, &a.tok, &st) != ncclSuccess)
+    return gdakiTsDecline(r, peer, "commit failed", true, cls);
+  if (gdakiTsBaseline(r, peer) != ncclSuccess) return gdakiTsDecline(r, peer, "QUERY_QP failed after commit", true, cls);
+  tC = gdakiQ4MonoMs();
+  if (gdakiTsReplayResume(r, peer, a.executed, a.nqp, &rs, &why) != ncclSuccess)
+    return gdakiTsDecline(r, peer, why ? why : "replay failed", true, cls);
+  const double tR = gdakiQ4MonoMs();
+  memset(&m, 0, sizeof(m));
+  m.type = GDAKI_TS_DONE;
+  m.round = round;
+  m.from = g->rank;
+  if (gdakiTsSend(pe.fd, &m, ts->handshakeMs) != 0) pe.gone = true;  // our side is already recovered
+  ts->nRecovered++;
+  WARN("GIN/TS: recovered rank=%d peer=%d role=initiator round=%lu class=%s fp=%d/%#x qps=%u S/U/n=[%s] replayed=%lu "
+       "rmsn_peer0=%u nrp_peer0=%#x t_mbx=%.3f t_start=%.3f quiesce_us=%.0f prepare_us=%.0f handshake_us=%.0f "
+       "commit_us=%.0f replay_us=%.0f total_us=%.0f mbx_to_resumed_us=%.0f peer_quiesce_us=%.0f peer_prepare_us=%.0f "
+       "peer_commit_us=%.0f t_resumed=%.3f",
+       g->rank, peer, (unsigned long)round, gdakiTsClassName(cls), gdakiQ4WcStatus(rec.syndrome), rec.vendor_err,
+       rs.nqp, rs.detail, (unsigned long)rs.replayed, a.executed[0], a.nrp[0], f.monoMs, t0, (tQ - t0) * 1e3,
+       (tP - tQ) * 1e3, (tA - tP) * 1e3, (tC - tA) * 1e3, (tR - tC) * 1e3, (tR - t0) * 1e3, (tR - f.monoMs) * 1e3,
+       a.t[0], a.t[1], a.t[2], tR);
+}
+
+// Responder: the peer asks to recover the QP pairs between us.
+static void gdakiTsRespond(struct gdakiRecHost* r, int peer, const struct gdakiTsMsg& req) {
+  struct gdakiTs* ts = r->ts;
+  struct gdaki_context* g = r->ctx;
+  const ncclComm_t comm = (ncclComm_t)r->commKey;
+  struct gdakiTsPeer& pe = ts->peers[peer];
+  struct gdakiTsMsg m;
+  auto nack = [&](int reason) {
+    memset(&m, 0, sizeof(m));
+    m.type = GDAKI_TS_NACK;
+    m.round = req.round;
+    m.from = g->rank;
+    m.arg = reason;
+    (void)gdakiTsSend(pe.fd, &m, 200);
+  };
+  if (pe.declined) return nack(2);
+  const double t0 = gdakiQ4MonoMs();
+  const char* why = nullptr;
+  ncclGinRecoverToken_t tok;
+  ncclGinRecoverStats_t st;
+  memset(&st, 0, sizeof(st));
+  uint32_t nm = 0, nqp = 0;
+  struct gdakiTsReplayStats rs;
+  if (gdakiTsQuiesce(r, peer, &why) != ncclSuccess) {
+    nack(3);
+    return gdakiTsDecline(r, peer, why, false, req.arg);
+  }
+  const double tQ = gdakiQ4MonoMs();
+  if (ncclGinRecoverPrepare(comm, peer, &tok, &st) != ncclSuccess) {
+    nack(4);
+    return gdakiTsDecline(r, peer, "prepare declined", false, req.arg);
+  }
+  if (gdakiTsNonMsg(r, peer, &nm) != ncclSuccess || nm != 0) {
+    nack(5);
+    return gdakiTsDecline(r, peer, "epoch posted a WQE S1 cannot count or re-post", false, req.arg);
+  }
+  memset(&m, 0, sizeof(m));
+  if (gdakiTsExecuted(r, peer, m.executed, m.nrp, &nqp) != ncclSuccess) {
+    nack(6);
+    return gdakiTsDecline(r, peer, "QUERY_QP failed", false, req.arg);
+  }
+  const double tP = gdakiQ4MonoMs();
+  if (ncclGinRecoverCommit(comm, peer, &req.tok, &st) != ncclSuccess) {
+    nack(7);
+    return gdakiTsDecline(r, peer, "commit failed", false, req.arg);
+  }
+  if (gdakiTsBaseline(r, peer) != ncclSuccess) {
+    nack(8);
+    return gdakiTsDecline(r, peer, "QUERY_QP failed after commit", false, req.arg);
+  }
+  const double tC = gdakiQ4MonoMs();
+  m.type = GDAKI_TS_ACK;
+  m.round = req.round;
+  m.from = g->rank;
+  m.nqp = nqp;
+  m.tok = tok;
+  m.t[0] = (tQ - t0) * 1e3;
+  m.t[1] = (tP - tQ) * 1e3;
+  m.t[2] = (tC - tP) * 1e3;
+  m.t[3] = (tC - t0) * 1e3;
+  if (gdakiTsSend(pe.fd, &m, ts->handshakeMs) != 0) {
+    pe.gone = true;
+    return gdakiTsDecline(r, peer, "cannot send ACK", false, req.arg);
+  }
+  // DONE: the initiator committed (its QPs are at RTR), so our own re-posted WQEs and new posts can go.
+  struct gdakiTsMsg d;
+  const int got = gdakiTsRecv(pe, &d, 2 * ts->handshakeMs, &ts->stop);  // initiator: commit + re-post (ms)
+  if (got < 0) {
+    pe.gone = true;
+    return gdakiTsDecline(r, peer, "peer closed the socket before DONE", false, req.arg);
+  }
+  if (got == 0) return gdakiTsDecline(r, peer, "DONE timeout", true, req.arg);
+  if (d.type != GDAKI_TS_DONE || d.round != req.round)
+    return gdakiTsDecline(r, peer, d.type == GDAKI_TS_FAIL ? "peer FAIL before DONE" : "unexpected record before DONE",
+                          false, req.arg);
+  const double tD = gdakiQ4MonoMs();
+  if (gdakiTsReplayResume(r, peer, req.executed, req.nqp, &rs, &why) != ncclSuccess)
+    return gdakiTsDecline(r, peer, why ? why : "replay failed", true, req.arg);
+  const double tR = gdakiQ4MonoMs();
+  ts->nRecovered++;
+  WARN("GIN/TS: recovered rank=%d peer=%d role=responder round=%lu class=%s qps=%u S/U/n=[%s] replayed=%lu "
+       "rmsn0=%u nrp0=%#x t_req=%.3f quiesce_us=%.0f prepare_us=%.0f commit_us=%.0f ack_to_done_us=%.0f replay_us=%.0f "
+       "total_us=%.0f t_resumed=%.3f",
+       g->rank, peer, (unsigned long)req.round, gdakiTsClassName(req.arg), rs.nqp, rs.detail,
+       (unsigned long)rs.replayed, m.executed[0], m.nrp[0], t0, (tQ - t0) * 1e3, (tP - tQ) * 1e3, (tC - tP) * 1e3,
+       (tD - tC) * 1e3, (tR - tD) * 1e3, (tR - t0) * 1e3, tR);
+}
+
+// Every 100 ms while idle: the device gates of each live peer. A waiter that gave up with no round
+// running (abandoned ahead of the stable epoch), or a fault record that never reached the helper
+// (gate.reported ahead of the records taken, for two scans; the 16-slot mailbox can overflow), would
+// otherwise leave the error invisible to the host: decline, which surfaces it.
+static void gdakiTsScan(struct gdakiRecHost* r) {
+  struct gdakiTs* ts = r->ts;
+  for (int p = 0; p < (int)ts->peers.size(); p++) {
+    if (ts->peers[p].fd < 0 || ts->peers[p].declined) continue;
+    const char* why = nullptr;
+    gdakiRecForPeer(r, p, [&](gdakiRecQp& rq, struct doca_gpu_verbs_qp_hl* q) {
+      if (why) return;
+      struct gdakiTsQp& s = ts->qs[rq.qpIdx];
+      struct ncclGinTsGate2 g2;
+      uint32_t reported = 0;
+      if (gdakiRecD2H(r, &g2, gdakiTsGate2Dev(q->qp_gverbs), sizeof(g2)) != ncclSuccess ||
+          gdakiTsGateRead(r, q->qp_gverbs, offsetof(struct ncclGinTsGate, reported), &reported, sizeof(reported)) !=
+            ncclSuccess)
+        return;
+      if (g2.abandoned >= s.epoch + 2u) why = "a device waiter gave up with no recovery running";
+      else if (reported >= s.epoch + 2u && reported > s.handled) {
+        if (++s.lostScans >= 2) why = "a fault record never reached the helper (mailbox overflow)";
+      } else s.lostScans = 0;
+    });
+    if (why) gdakiTsDecline(r, p, why, true, 0);
+  }
+}
+
+static void gdakiTsMain(struct gdakiRecHost* r) {
+  gdakiTsInHelper = true;
+  gdakiTsOwner = r;
+  struct gdakiTs* ts = r->ts;
+  struct gdaki_context* g = r->ctx;
+  if (cudaSetDevice(g->cuda_id) != cudaSuccess) WARN("GIN/TS: helper cannot select CUDA device %d", g->cuda_id);
+  std::vector<struct pollfd> pfds;
+  std::vector<int> who;
+  double nextScan = gdakiQ4MonoMs() + 100.0;
+  while (!ts->stop.load(std::memory_order_acquire)) {
+    pfds.clear();
+    who.clear();
+    for (int p = 0; p < (int)ts->peers.size(); p++) {
+      struct gdakiTsPeer& pe = ts->peers[p];
+      if (pe.fd < 0 || pe.gone) continue;
+      pfds.push_back({pe.fd, POLLIN, 0});
+      who.push_back(p);
+    }
+    if (!pfds.empty()) (void)poll(pfds.data(), pfds.size(), 1);
+    else std::this_thread::sleep_for(std::chrono::milliseconds(1));
+    for (size_t k = 0; k < pfds.size(); k++) {
+      if (!(pfds[k].revents & (POLLIN | POLLERR | POLLHUP))) continue;
+      const int p = who[k];
+      struct gdakiTsPeer& pe = ts->peers[p];
+      struct gdakiTsMsg msg;
+      int got;
+      while ((got = gdakiTsPump(pe, &msg)) == 1) {
+        if (msg.type == GDAKI_TS_REQ && msg.from == p) gdakiTsRespond(r, p, msg);
+        else if (msg.type == GDAKI_TS_FAIL) {
+          if (!pe.declined) gdakiTsDecline(r, p, "the peer declined", false, msg.arg);
+        } else
+          INFO(NCCL_NET, "GIN/TS: ignoring %s from rank %d while idle", gdakiTsMsgName(msg.type), p);
+        if (pe.gone) break;
+      }
+      if (got < 0 && !pe.gone) {
+        // FIN/RST while idle is not a fault (the peer may just be tearing down): recovery with this
+        // peer becomes impossible and a later fault on it is declined.
+        pe.gone = true;
+        INFO(NCCL_NET, "GIN/TS: rank %d: socket to rank %d closed", g->rank, p);
+      }
+    }
+    std::vector<struct gdakiTsFault> fs;
+    {
+      std::lock_guard<std::mutex> lk(ts->qMu);
+      fs.swap(ts->faults);
+    }
+    for (auto& f : fs) gdakiTsInitiate(r, f);
+    if (fs.empty() && gdakiQ4MonoMs() >= nextScan) {
+      gdakiTsScan(r);
+      nextScan = gdakiQ4MonoMs() + 100.0;
+    }
+  }
+}
+
+// Collective part of the setup, called by every rank inside ncclGinGdakiCreateContext when the
+// flags are set (they must be set on every rank): a TCP listen socket on the NCCL_SOCKET_IFNAME
+// interface, its address all-gathered over the GIN collComm, connect to higher ranks / accept from
+// lower ranks. Any local problem disables transparent recovery on this rank only (the peer's
+// handshake then times out and it declines) but never skips the all-gather.
+static ncclResult_t gdakiTsSetup(struct gdaki_context* g, struct ncclGinIbCollComm* cComm) {
+  if (!(ncclParamGinFaultRecovery() && ncclParamGinFaultTransparent() && ncclGinFaultUserCtx)) return ncclSuccess;
+  struct gdakiRecHost* r = g->rec;
+  const int nranks = cComm->nranks, rank = g->rank;
+  const int rankOff = rank % g->rankStride;
+  const char* why = nullptr;
+  if (r == nullptr) why = "recovery host missing";
+  else if (g->q4 == nullptr) why = "needs NCCL_GIN_FAULT_CLASSIFY=1";
+  else if (g->companion_gqps != nullptr) why = "companion (counter) QPs present";
+  if (why == nullptr) {
+    for (int p = rankOff; p < nranks && why == nullptr; p += g->rankStride) {
+      if (p == rank) continue;
+      gdakiRecForPeer(r, p, [&](gdakiRecQp&, struct doca_gpu_verbs_qp_hl* q) {
+        struct doca_gpu_verbs_qp* v = q->qp_gverbs;
+        if (gdakiRecDbMode(v) != GDAKI_REC_DB_GPU) why = "doorbell mode is not GPU_SM_DB";
+        else if (v->cq_type != DOCA_GPUNETIO_VERBS_CQ_64B) why = "CQ is not a ring CQ";
+        else if (v->qp_gpu == nullptr) why = "QP not exported";
+      });
+    }
+  }
+  struct gdakiTsAddr {
+    uint32_t magic;
+    int32_t rank;
+    union ncclSocketAddress a;
+  };
+  std::vector<struct gdakiTsAddr> all(nranks);
+  struct gdakiTsAddr mine;
+  memset(&mine, 0, sizeof(mine));
+  int ls = -1;
+  if (why == nullptr) {
+    char ifName[MAX_IF_NAME_SIZE + 1];
+    union ncclSocketAddress addr;
+    int nIfs = 0;
+    if (ncclFindInterfaces(ifName, &addr, MAX_IF_NAME_SIZE, 1, &nIfs) != ncclSuccess || nIfs == 0) {
+      why = "no socket interface";
+    } else {
+      socklen_t alen = addr.sa.sa_family == AF_INET6 ? sizeof(addr.sin6) : sizeof(addr.sin);
+      if (addr.sa.sa_family == AF_INET6) addr.sin6.sin6_port = 0;
+      else addr.sin.sin_port = 0;
+      ls = socket(addr.sa.sa_family, SOCK_STREAM, 0);
+      int one = 1;
+      if (ls < 0 || setsockopt(ls, SOL_SOCKET, SO_REUSEADDR, &one, sizeof(one)) != 0 ||
+          bind(ls, &addr.sa, alen) != 0 || listen(ls, nranks + 4) != 0 || getsockname(ls, &addr.sa, &alen) != 0) {
+        why = "cannot open the listen socket";
+      } else {
+        mine.magic = GDAKI_TS_MAGIC;
+        mine.rank = rank;
+        mine.a = addr;
+      }
+    }
+  }
+  // Responder MSN baselines before anyone can send on these QPs (every rank is inside this collective).
+  std::vector<uint32_t> rmsn0(r ? r->qps.size() : 0, 0);
+  if (why == nullptr) {
+    for (int p = rankOff; p < nranks; p += g->rankStride) {
+      if (p == rank) continue;
+      gdakiRecForPeer(r, p, [&](gdakiRecQp& rq, struct doca_gpu_verbs_qp_hl* q) {
+        uint32_t v = 0;
+        if (doca_verbs_qp_query_seq(q->qp, &v, nullptr, nullptr, nullptr) != DOCA_SUCCESS) why = "QUERY_QP failed";
+        rmsn0[rq.qpIdx] = v;
+      });
+    }
+  }
+  ncclResult_t ret = cComm->allGather(cComm, &mine, all.data(), sizeof(mine));
+  if (ret != ncclSuccess) {
+    if (ls >= 0) close(ls);
+    return ret;
+  }
+  struct gdakiTs* ts = nullptr;
+  const double deadline = gdakiQ4MonoMs() + (double)ncclParamGinTsConnectMs();
+  if (why == nullptr) {
+    ts = new gdakiTs();
+    ts->peers.resize(nranks);
+    ts->qs.resize(r->qps.size());
+    for (size_t i = 0; i < ts->qs.size(); i++) ts->qs[i].rmsn0 = rmsn0[i];
+    for (int p = rankOff; p < nranks && why == nullptr; p += g->rankStride)
+      if (p != rank && all[p].magic != GDAKI_TS_MAGIC) why = "a peer has transparent recovery off";
+  }
+  // connect to higher ranks (completes through the peer's backlog), then accept the lower ranks
+  for (int p = rankOff; p < nranks && why == nullptr; p += g->rankStride) {
+    if (p <= rank) continue;
+    const union ncclSocketAddress& pa = all[p].a;
+    socklen_t alen = pa.sa.sa_family == AF_INET6 ? sizeof(pa.sin6) : sizeof(pa.sin);
+    int fd = socket(pa.sa.sa_family, SOCK_STREAM, 0);
+    if (fd < 0) { why = "socket() failed"; break; }
+    gdakiTsSockOpts(fd);
+    int rc = connect(fd, &pa.sa, alen);
+    if (rc != 0 && errno != EINPROGRESS) { close(fd); why = "connect failed"; break; }
+    struct pollfd pf = {fd, POLLOUT, 0};
+    int err = 0;
+    socklen_t elen = sizeof(err);
+    if (rc != 0 && (poll(&pf, 1, std::max(1, (int)(deadline - gdakiQ4MonoMs()))) != 1 ||
+                    getsockopt(fd, SOL_SOCKET, SO_ERROR, &err, &elen) != 0 || err != 0)) {
+      close(fd);
+      why = "connect timed out";
+      break;
+    }
+    struct gdakiTsMsg h;
+    memset(&h, 0, sizeof(h));
+    h.type = GDAKI_TS_HELLO;
+    h.from = rank;
+    if (gdakiTsSend(fd, &h, std::max(1, (int)(deadline - gdakiQ4MonoMs()))) != 0) { close(fd); why = "hello failed"; break; }
+    ts->peers[p].fd = fd;
+  }
+  int lower = 0;
+  for (int p = rankOff; p < rank; p += g->rankStride) lower++;
+  while (why == nullptr && lower > 0) {
+    struct pollfd pf = {ls, POLLIN, 0};
+    const int rem = (int)(deadline - gdakiQ4MonoMs());
+    if (rem <= 0 || poll(&pf, 1, rem) != 1) { why = "accept timed out"; break; }
+    int fd = accept(ls, nullptr, nullptr);
+    if (fd < 0) continue;
+    gdakiTsSockOpts(fd);
+    struct gdakiTsPeer tmp;
+    tmp.fd = fd;
+    struct gdakiTsMsg h;
+    if (gdakiTsRecv(tmp, &h, std::max(1, (int)(deadline - gdakiQ4MonoMs())), nullptr) != 1 ||
+        h.type != GDAKI_TS_HELLO || h.from < 0 || h.from >= rank || ts->peers[h.from].fd >= 0) {
+      close(fd);
+      continue;
+    }
+    ts->peers[h.from].fd = fd;
+    lower--;
+  }
+  if (ls >= 0) close(ls);
+  if (why != nullptr) {
+    WARN("GIN/TS: transparent recovery OFF on rank %d: %s", rank, why);
+    if (ts) {
+      for (auto& pe : ts->peers)
+        if (pe.fd >= 0) close(pe.fd);
+      delete ts;
+    }
+    return ncclSuccess;
+  }
+  ts->diag = gdakiTsDiag();
+  ts->handshakeMs = (int)std::max<int64_t>(100, ncclParamGinTsHandshakeMs());
+  ts->holdMs = (int)std::max<int64_t>(100, ncclParamGinTsHoldMs());
+  ts->quiesceMs = (int)std::max<int64_t>(10, ncclParamGinTsQuiesceMs());
+  r->ts = ts;
+  return ncclSuccess;
+}
+
+// After gdakiRecRegister (recovery stream and staging exist): enable the gates and start the helper.
+static void gdakiTsStart(struct gdakiRecHost* r) {
+  if (r == nullptr || r->ts == nullptr) return;
+  struct gdakiTs* ts = r->ts;
+  struct gdaki_context* g = r->ctx;
+  bool ok = true;
+  int nq = 0;
+  for (int p = 0; p < (int)ts->peers.size() && ok; p++) {
+    if (ts->peers[p].fd < 0) continue;
+    gdakiRecForPeer(r, p, [&](gdakiRecQp&, struct doca_gpu_verbs_qp_hl* q) {
+      struct ncclGinTsGate gate;
+      memset(&gate, 0, sizeof(gate));
+      gate.flags = NCCL_GIN_TS_F_ON | ((ts->diag & GDAKI_TS_DIAG_NOREBASE) ? NCCL_GIN_TS_F_DIAG_NOREBASE : 0u);
+      gate.waitMs = (uint32_t)ts->holdMs;
+      struct ncclGinTsGate2 g2;
+      memset(&g2, 0, sizeof(g2));
