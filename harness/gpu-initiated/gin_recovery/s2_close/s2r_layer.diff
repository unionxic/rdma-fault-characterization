+// gin-s2-close test knob NCCL_GIN_TS_TEST_SOCK_MUTE=<start ms>:<length ms> (times from the start of the helper
+// thread, which follows the socket setup): attach a drop-everything classic BPF filter to every helper socket at the
+// start and detach it at the end. The kernel then discards every segment that arrives on those sockets (no FIN, no
+// RST), as a silent outage of the management network would, for these connections only. Test only.
+static void gdakiTsTestMute(struct gdakiTs* ts, int rank, double t0, int* state) {
+  if (ts->muteStartMs < 0 || *state >= 2) return;
+  const double now = gdakiQ4MonoMs();
+  if (*state == 0 && now >= t0 + ts->muteStartMs) {
+    struct sock_filter code[1] = {BPF_STMT(BPF_RET | BPF_K, 0)};
+    struct sock_fprog prog;
+    prog.len = 1;
+    prog.filter = code;
+    int n = 0, bad = 0;
+    for (auto& pe : ts->peers) {
+      if (pe.fd < 0) continue;
+      if (setsockopt(pe.fd, SOL_SOCKET, SO_ATTACH_FILTER, &prog, sizeof(prog)) == 0) n++;
+      else bad++;
+    }
+    if (bad) WARN("GIN/TS: TEST socket mute: SO_ATTACH_FILTER failed on %d socket(s) rank=%d errno=%d", bad, rank, errno);
+    WARN("GIN/TS: TEST socket mute on rank=%d peers=%d mono_ms=%.3f", rank, n, now);
+    *state = 1;
+  }
+  if (*state == 1 && now >= t0 + ts->muteStartMs + ts->muteLenMs) {
+    int n = 0, dummy = 0;
+    for (auto& pe : ts->peers) {
+      if (pe.fd < 0) continue;
+      if (setsockopt(pe.fd, SOL_SOCKET, SO_DETACH_FILTER, &dummy, sizeof(dummy)) == 0) n++;
+    }
+    WARN("GIN/TS: TEST socket mute off rank=%d peers=%d mono_ms=%.3f", rank, n, now);
+    *state = 2;
+  }
+}
