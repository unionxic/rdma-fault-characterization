# NVSHMEM IBGDA: CPU-proxy SQ doorbell-record knob (research, default OFF)
#
# Base: NVSHMEM commit 7bb2e99c + ../nvshmem/nvshmem_ibgda_fault_inject.diff (apply that first;
#       this diff is relative to the tree after it). File: src/modules/transport/ibgda/ibgda.cpp
# Apply: git apply ../nvshmem/nvshmem_ibgda_fault_inject.diff && git apply nvshmem_nrc_proxy_sq_dbr.diff
#
# NVSHMEM_IBGDA_PROXY_SQ_DBR=1
#   In the CPU-proxy NIC handlers (ibgda_rc_progress / ibgda_dci_progress) write the SQ
#   producer index to doorbell-record word 1 (MLX5_SND_DBR, byte offset dbr_offset + 4),
#   which is the word the GPU NIC handler writes (ibgda_get_device_qp: dbr_offset +
#   sizeof(__be32)). Stock (unset or 0) writes byte offset dbr_offset * sizeof(__be32),
#   i.e. word 0 (MLX5_RCV_DBR) for an RC endpoint, so the SQ record is never updated.
# NVSHMEM_IBGDA_FAULT_WATCH (from the base diff) additionally prints both doorbell-record
#   words of each RC endpoint ("[nvshmem-nrc] ... DBR word0(rq)=.. word1(sq)=..").
# Watch fix: the base diff's NVSHMEM_IBGDA_FAULT_WATCH thread held rc_endpoint_lock across its
#   sleep, which starves the CPU proxy (ibgda_rc_progress takes the same lock) and the
#   fault-inject thread, so no doorbell is rung while the watch runs. Here the lock is released
#   before the sleep; NVSHMEM_IBGDA_FAULT_WATCH_HOLD_LOCK=1 restores the old behaviour.
# With NVSHMEM_IBGDA_PROXY_SQ_DBR and NVSHMEM_IBGDA_FAULT_WATCH unset, the build behaves
# exactly like the base (stock NVSHMEM + default-off fault hooks).
# ---------------------------------------------------------------------------------------
diff --git a/src/modules/transport/ibgda/ibgda.cpp b/src/modules/transport/ibgda/ibgda.cpp
index c3f28ea..d10c961 100644
--- a/src/modules/transport/ibgda/ibgda.cpp
+++ b/src/modules/transport/ibgda/ibgda.cpp
@@ -473,6 +473,29 @@ int nvshmemt_ibgda_show_info(struct nvshmem_transport * /*transport*/, int /*sty
  * Utility functions end
  * ============================================================================= */
 
+/* NVSHMEM_IBGDA_PROXY_SQ_DBR (research knob, default 0 = stock behaviour).
+ * In the CPU-proxy NIC handlers the proxy writes the SQ producer index to
+ *   dbr_mobject->cpu_ptr + dbr_offset * sizeof(__be32)
+ * which for an RC endpoint (dbr_offset 0) is doorbell-record word 0, the RECEIVE counter
+ * (MLX5_RCV_DBR). The GPU handler writes word 1, the SEND counter (MLX5_SND_DBR), at
+ * dbr_offset + sizeof(__be32) (ibgda_get_device_qp). With 1, the proxy writes the same
+ * word as the GPU path. Read once. */
+static int ibgda_proxy_sq_dbr_fix(void) {
+    static int v = -1;
+    if (v < 0) {
+        const char *e = getenv("NVSHMEM_IBGDA_PROXY_SQ_DBR");
+        v = (e && e[0] == '1') ? 1 : 0;
+        if (v) fprintf(stderr, "[nvshmem-nrc] CPU proxy writes the SQ doorbell record (MLX5_SND_DBR)\n");
+    }
+    return v;
+}
+
+static inline __be32 *ibgda_proxy_dbrec(const struct ibgda_ep *ep) {
+    uintptr_t base = (uintptr_t)ep->qp_ctrl.dbr_mobject->aligned.cpu_ptr;
+    if (ibgda_proxy_sq_dbr_fix()) return (__be32 *)(base + ep->qp_ctrl.dbr_offset + sizeof(__be32));
+    return (__be32 *)(base + ep->qp_ctrl.dbr_offset * sizeof(__be32)); /* stock */
+}
+
