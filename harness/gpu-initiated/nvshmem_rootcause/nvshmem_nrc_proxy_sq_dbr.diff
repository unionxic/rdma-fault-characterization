     nvshmemt_ibgda_state_t *ibgda_state = (nvshmemt_ibgda_state_t *)t->state;
     int n_devs_selected = ibgda_state->n_devs_selected;
@@ -516,8 +539,7 @@ int ibgda_dci_progress(nvshmem_transport_t t) {
             if (prod_idx_cache[i] < prod_idx) {
                 ep = device->dci.eps[i];
 
-                dbrec = (__be32 *)((uintptr_t)ep->qp_ctrl.dbr_mobject->aligned.cpu_ptr +
-                                   ep->qp_ctrl.dbr_offset * sizeof(__be32));
+                dbrec = ibgda_proxy_dbrec(ep);
                 bf = (__be64 *)ep->uar_mobject->aligned.cpu_ptr;
 
                 memset((void *)&ctrl_seg, 0, sizeof(ctrl_seg));
@@ -580,8 +602,7 @@ int ibgda_rc_progress(nvshmem_transport_t t) {
                 goto out;
             }
             if (*prod_idx_cache < *prod_idx_snapshot) {
-                dbrec = (__be32 *)((uintptr_t)ep->qp_ctrl.dbr_mobject->aligned.cpu_ptr +
-                                   ep->qp_ctrl.dbr_offset * sizeof(__be32));
+                dbrec = ibgda_proxy_dbrec(ep);
                 bf = (__be64 *)ep->uar_mobject->aligned.cpu_ptr;
 
                 memset((void *)&ctrl_seg, 0, sizeof(ctrl_seg));
@@ -4675,8 +4696,15 @@ static void ibgda_fault_watch_arm(nvshmemt_ibgda_state_t *ibgda_state, int n_pes
         if (delay > 0) std::this_thread::sleep_for(std::chrono::milliseconds(delay));
         const double run_ms = 16000.0;
         double start = ibgda_fi_now_ms();
+        // nrc: the base hook held rc_endpoint_lock across the sleep below, which starves the
+        // CPU proxy (ibgda_rc_progress takes the same lock) and the fault-inject thread. The
+        // lock is now released before sleeping; NVSHMEM_IBGDA_FAULT_WATCH_HOLD_LOCK=1 restores
+        // the old behaviour (for the A/B).
+        const char *hold_env = getenv("NVSHMEM_IBGDA_FAULT_WATCH_HOLD_LOCK");
+        const bool hold_lock = hold_env && hold_env[0] == '1';
+        fprintf(stderr, "[nvshmem-nrc] watch hold_lock=%d\n", (int)hold_lock);
         while (ibgda_fi_now_ms() - start < run_ms) {
-            std::lock_guard<std::mutex> lock(ibgda_state->rc_endpoint_lock);
+            std::unique_lock<std::mutex> lock(ibgda_state->rc_endpoint_lock);
             for (int i = 0; i < ibgda_state->n_devs_selected; i++) {
                 int dev_idx = ibgda_state->selected_dev_ids[i];
                 struct ibgda_device *device =
@@ -4686,6 +4714,15 @@ static void ibgda_fault_watch_arm(nvshmemt_ibgda_state_t *ibgda_state, int n_pes
                     struct ibgda_ep *ep = device->rc.eps ? device->rc.eps[e] : NULL;
                     if (ep && ep->qp_type == NVSHMEMI_IBGDA_DEVICE_QP_TYPE_RC && ep->devx_qp) {
                         ibgda_fi_query_qp(ep->devx_qp, ep->qpn, "RC");
+                        // nrc: the QP doorbell record in host memory (CPU-proxy handlers):
+                        // word 0 = RQ counter (MLX5_RCV_DBR), word 1 = SQ counter (MLX5_SND_DBR).
+                        if (ep->qp_ctrl.dbr_mobject && ep->qp_ctrl.dbr_mobject->has_cpu_mapping &&
+                            ep->qp_ctrl.dbr_mobject->aligned.cpu_ptr) {
+                            const volatile __be32 *d = (const volatile __be32 *)(
+                                (uintptr_t)ep->qp_ctrl.dbr_mobject->aligned.cpu_ptr + ep->qp_ctrl.dbr_offset);
+                            fprintf(stderr, "[nvshmem-nrc] %.1f ms RC qpn=0x%x DBR word0(rq)=%u word1(sq)=%u\n",
+                                    ibgda_fi_now_ms(), ep->qpn, be32toh(d[0]), be32toh(d[1]));
+                        }
                         if (!qp_only && ep->send_cq && ep->send_cq->devx_cq)
                             ibgda_fi_query_cq(ep->send_cq->devx_cq, ep->send_cq->cqn, "RC");
                         if (!qp_only && ep->send_cq && ep->send_cq->cq_mobject)
@@ -4702,6 +4739,7 @@ static void ibgda_fault_watch_arm(nvshmemt_ibgda_state_t *ibgda_state, int n_pes
                     }
                 }
             }
+            if (!hold_lock) lock.unlock();
             std::this_thread::sleep_for(std::chrono::milliseconds(period));
         }
