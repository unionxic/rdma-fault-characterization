 typedef nvshmemi_ibgda_device_state_v2 nvshmemi_ibgda_device_state_t;
 
+/* ---------------------------------------------------------------------------------------------
+ * NVSHMEM_IBGDA_FT (research, default off): device-side classification of the root-cause error
+ * CQE, a host-mapped mailbox, and the state the host recovery path resyncs. See
+ * harness/gpu-initiated/nvshmem_ft/DESIGN.md.
+ * ------------------------------------------------------------------------------------------- */
+#define NVSHMEMI_IBGDA_FT_MAGIC 0x4e465442u /* "BTFN" */
+#define NVSHMEMI_IBGDA_FT_NSLOTS 16
+
+enum {
+    NVSHMEMI_IBGDA_FT_FLAG_ON = 1,          /* classification on: record + error return */
+    NVSHMEMI_IBGDA_FT_FLAG_CAPTURE_EXIT = 2, /* diagnostic: look at the slot only when the wait
+                                                exits (stock position), not in the spin loop */
+    NVSHMEMI_IBGDA_FT_FLAG_SENTINEL = 4,     /* the application runs the device sentinel */
+};
+
+/* Classes (same numbering as the NCCL GIN Q4 classifier). Syndromes: rdma-core
+ * providers/mlx5/mlx5dv.h MLX5_CQE_SYNDROME_*, mapped as in providers/mlx5/cq.c. */
+enum {
+    NVSHMEMI_IBGDA_FT_CLASS_NONE = 0,
+    NVSHMEMI_IBGDA_FT_CLASS_LOCAL_QP_ERR = 1,   /* 0x05 WR_FLUSH, vendor 0xf5 (head of SQ) */
+    NVSHMEMI_IBGDA_FT_CLASS_FLUSH_TRAILING = 2, /* 0x05 WR_FLUSH, vendor 0xf9 (behind an error) */
+    NVSHMEMI_IBGDA_FT_CLASS_FLUSH_OTHER = 3,
+    NVSHMEMI_IBGDA_FT_CLASS_LOC_PROT = 4,       /* 0x04 */
+    NVSHMEMI_IBGDA_FT_CLASS_REM_INV_REQ = 5,    /* 0x12 (0x8a) */
+    NVSHMEMI_IBGDA_FT_CLASS_REM_ACCESS = 6,     /* 0x13 (0x88) */
+    NVSHMEMI_IBGDA_FT_CLASS_RETRY_EXC = 7,      /* 0x15 (0x81) */
+    NVSHMEMI_IBGDA_FT_CLASS_RNR_RETRY_EXC = 8,  /* 0x16 (0x87) */
+    NVSHMEMI_IBGDA_FT_CLASS_LOC_LEN = 9,        /* 0x01 */
+    NVSHMEMI_IBGDA_FT_CLASS_LOC_QP_OP = 10,     /* 0x02 */
+    NVSHMEMI_IBGDA_FT_CLASS_REM_OP = 11,        /* 0x14 */
+    NVSHMEMI_IBGDA_FT_CLASS_REM_ABORT = 12,     /* 0x22 */
+    NVSHMEMI_IBGDA_FT_CLASS_LOC_ACCESS = 13,    /* 0x11 */
+    NVSHMEMI_IBGDA_FT_CLASS_BAD_RESP = 14,      /* 0x10 */
+    NVSHMEMI_IBGDA_FT_CLASS_OTHER = 15,
+};
+
+enum {
+    NVSHMEMI_IBGDA_FT_PATH_POLL = 1,     /* ibgda_poll_cq spin loop (quiet, slot wait) */
+    NVSHMEMI_IBGDA_FT_PATH_EXIT = 2,     /* ibgda_poll_cq after the wait was satisfied */
+    NVSHMEMI_IBGDA_FT_PATH_BOUNDED = 3,  /* nvshmemx_ibgda_ft_quiet_bounded */
+    NVSHMEMI_IBGDA_FT_PATH_SENTINEL = 4, /* nvshmemx_ibgda_ft_sentinel */
+};
+
+/* One mailbox record (256 B) in host-pinned mapped memory. The device writes the body with
+ * system-scope stores, __threadfence_system(), then seq, fence, then magic. */
+typedef struct {
+    uint32_t magic;
+    uint32_t seq;          /* 1-based */
+    uint32_t qpn;          /* QP the wait was on */
+    uint32_t cqe_sqpn;     /* root CQE s_wqe_opcode_qpn (host order) */
+    uint16_t wqe_counter;  /* root CQE wqe_counter */
+    uint8_t syndrome;      /* root CQE byte 55 */
+    uint8_t vendor_err;    /* root CQE byte 54 */
+    uint8_t cls;           /* NVSHMEMI_IBGDA_FT_CLASS_* */
+    uint8_t kind;          /* 1 = error CQE */
+    uint8_t path;          /* NVSHMEMI_IBGDA_FT_PATH_* */
+    uint8_t qp_type;       /* NVSHMEMI_IBGDA_DEVICE_QP_TYPE_* */
+    uint8_t hw_err_synd;   /* byte 52 */
+    uint8_t hw_synd_type;  /* byte 53 */
+    uint8_t root_opcode;   /* op_own >> 4 */
+    uint8_t upgrade;       /* 1 if this record replaces an earlier trailing-flush-only record */
+    int32_t mype;
+    int32_t peer;          /* RC: peer PE; DCI: -1 */
+    uint32_t qp_index;     /* index into globalmem.rcs / dcis */
+    uint64_t poll_idx;     /* index (WQE idx + 1) the wait was waiting for */
+    uint64_t cons_idx;
+    uint64_t prod_idx;
+    uint64_t ready_head;
+    uint64_t resv_head;
+    uint64_t gtimer_ns;    /* %globaltimer at capture */
+    uint32_t snap_tries;   /* reads needed for a consistent 64-B snapshot */
+    uint32_t pad0;
+    uint8_t root_cqe[64];  /* raw root CQE */
+    uint8_t reserved[96];
+} nvshmemi_ibgda_ft_record_t;
+static_assert(sizeof(nvshmemi_ibgda_ft_record_t) == 256, "nvshmemi_ibgda_ft_record_t must be 256 B");
+
+/* Device control block (GPU memory), pointed to by nvshmemi_ibgda_device_state_t::ft. */
+typedef struct {
+    nvshmemi_ibgda_ft_record_t *mbox; /* device alias of the host-mapped records */
+    uint32_t nslots;
+    uint32_t seq;              /* GPU atomic, 1-based record sequence */
+    uint32_t nerr;             /* QPs with a recorded error since the last recovery */
+    uint32_t flags;            /* copy of NVSHMEMI_IBGDA_FT_FLAG_* */
+    uint64_t sentinel_polls;   /* sentinel loop iterations (diagnostic) */
+    uint32_t sentinel_stop;    /* host sets 1 to end the sentinel */
+    uint32_t sentinel_running; /* sentinel sets 1 while it runs */
+    uint64_t reserved[4];
+} nvshmemi_ibgda_ft_dev_t;
+
+/* Host API of the IBGDA transport plugin (exported from nvshmem_transport_ibgda.so; an application
+ * resolves the nvshmemt_ibgda_ft_* symbols with dlopen(RTLD_NOLOAD) + dlsym). */
+#define NVSHMEMT_IBGDA_FT_API_VERSION 1
+#define NVSHMEMT_IBGDA_FT_MAX_QPS 8
+#define NVSHMEMT_IBGDA_FT_TOKEN_MAGIC 0x4654544bu /* "KTTF" */
+
+typedef struct {
+    int valid;          /* 1 if an unrecovered error record is present */
+    int cls;            /* NVSHMEMI_IBGDA_FT_CLASS_* */
+    int wc_status;      /* ibv_wc_status equivalent of the syndrome */
+    int opcode, syndrome, vendor_err, trailing, path, upgrade, snap_tries;
+    int peer, qp_type;
+    uint32_t qpn, wqe_counter, seq, nrecords;
+    uint64_t poll_idx, prod_idx, cons_idx, gtimer_ns;
+    double host_mono_ms; /* CLOCK_MONOTONIC (ms) when the watcher read the record */
+    char name[24], fault[24], cause[128], action[128];
+    int recover_hint; /* 1 recoverable class, 2 recoverable if the peer is alive, 0 decline */
+} nvshmemt_ibgda_ft_info_t;
+
+typedef struct {
+    uint32_t magic, nqps;
+    int32_t pe, peer;
+    struct {
+        uint32_t qpn, peer_qpn, sq_psn, prod_idx;
+    } qp[NVSHMEMT_IBGDA_FT_MAX_QPS];
+} nvshmemt_ibgda_ft_token_t;
+
+typedef struct {
+    uint32_t nqps, ndci_reset, drained, pad;
+    double to_err_ms, drain_ms, prepare_ms;       /* Prepare */
+    double rst_ms, resync_ms, connect_ms, commit_ms; /* Commit */
+    uint32_t prod_idx[NVSHMEMT_IBGDA_FT_MAX_QPS];  /* device producer index of each QP at Prepare */
+    uint32_t qp_state[NVSHMEMT_IBGDA_FT_MAX_QPS];  /* QUERY_QP state at Prepare (before 2ERR) */
+    char msg[160];
+} nvshmemt_ibgda_ft_stats_t;
+
