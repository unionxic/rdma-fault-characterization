+static void ibgda_ft_set_failed(const char *why) {
+    if (ibgda_ft.t) ibgda_ft.t->attr |= NVSHMEM_TRANSPORT_ATTR_FT_FAILED_BIT;
+    fprintf(stderr, "[nvshmem-ft] PE%d marked failed (%s): device collectives are skipped at teardown\n",
+            ibgda_ft.t ? ibgda_ft.t->my_pe : -1, why);
+}
