+/* NVSHMEM_IBGDA_FT (research): true once a transport was marked failed (declined recovery). */
+bool nvshmemi_ft_transport_failed() {
+    if (!nvshmemi_state || !nvshmemi_state->transports) return false;
+    for (int i = 0; i < nvshmemi_state->num_initialized_transports; i++) {
+        if (nvshmemi_state->transports[i] &&
+            (nvshmemi_state->transports[i]->attr & NVSHMEM_TRANSPORT_ATTR_FT_FAILED))
+            return true;
+    }
+    return false;
+}
+
 void nvshmemi_barrier(nvshmem_team_t team) {
+    if (nvshmemi_ft_transport_failed()) {
+        static bool warned = false;
+        if (!warned) {
+            fprintf(stderr, "[nvshmem-ft] transport marked failed: skipping device barrier\n");
+            warned = true;
+        }
+        return;
+    }
     nvshmem_quiet();
     nvshmemi_call_barrier_on_stream_kernel(team, nvshmemi_state->my_stream);
     CUDA_RUNTIME_CHECK(cudaStreamSynchronize(nvshmemi_state->my_stream));
