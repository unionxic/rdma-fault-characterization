+/* ---------------------------------------------------------------------------------------------
+ * NVSHMEM_IBGDA_FT (research, default off; host env NVSHMEM_IBGDA_FT=1 sets state->ft).
+ * Device-side classification of the root-cause error CQE on the collapsed send CQ. Every poll of
+ * a send CQ also looks at the slot's opcode while it spins; the first error CQE seen on a QP is
+ * snapshotted before the trailing flushes (5/0xf9, ~59 us later) overwrite it, kept as a sticky
+ * per-QP record in mvars, and published to a host-mapped mailbox. Waits on a failed QP return an
+ * error instead of spinning or reporting success. With state->ft == NULL nothing below runs.
+ * ------------------------------------------------------------------------------------------- */
+__device__ NVSHMEMI_STATIC NVSHMEMI_DEVICE_ALWAYS_INLINE nvshmemi_ibgda_ft_dev_t *ibgda_ft_dev() {
+    return (nvshmemi_ibgda_ft_dev_t *)ibgda_get_state()->ft;
+}
+
+__device__ NVSHMEMI_STATIC NVSHMEMI_DEVICE_ALWAYS_INLINE uint64_t ibgda_ft_globaltimer() {
+    uint64_t t;
+    asm volatile("mov.u64 %0, %%globaltimer;" : "=l"(t)::"memory");
+    return t;
+}
+
+/* The CQ struct points into the QP's mvars (cons_idx); recover the mvars from it. */
+__device__ NVSHMEMI_STATIC NVSHMEMI_DEVICE_ALWAYS_INLINE nvshmemi_ibgda_device_qp_management_t *
+ibgda_ft_mvars_of_cq(const nvshmemi_ibgda_device_cq_t *cq) {
+    return (nvshmemi_ibgda_device_qp_management_t *)((uintptr_t)cq->cons_idx -
+                                                     __builtin_offsetof(
+                                                         nvshmemi_ibgda_device_qp_management_t,
+                                                         tx_wq.cons_idx));
+}
+
+__device__ NVSHMEMI_STATIC NVSHMEMI_DEVICE_ALWAYS_INLINE bool ibgda_ft_is_err_opcode(uint8_t opown) {
+    uint8_t op = opown >> 4;
+    return op == MLX5_CQE_REQ_ERR || op == MLX5_CQE_RESP_ERR;
+}
+
+__device__ NVSHMEMI_STATIC NVSHMEMI_DEVICE_ALWAYS_INLINE uint8_t ibgda_ft_classify(uint8_t syndrome,
+                                                                                 uint8_t vendor) {
+    switch (syndrome) {
+        case 0x05:
+            return vendor == 0xf5   ? NVSHMEMI_IBGDA_FT_CLASS_LOCAL_QP_ERR
+                   : vendor == 0xf9 ? NVSHMEMI_IBGDA_FT_CLASS_FLUSH_TRAILING
+                                    : NVSHMEMI_IBGDA_FT_CLASS_FLUSH_OTHER;
+        case 0x04: return NVSHMEMI_IBGDA_FT_CLASS_LOC_PROT;
+        case 0x12: return NVSHMEMI_IBGDA_FT_CLASS_REM_INV_REQ;
+        case 0x13: return NVSHMEMI_IBGDA_FT_CLASS_REM_ACCESS;
+        case 0x15: return NVSHMEMI_IBGDA_FT_CLASS_RETRY_EXC;
+        case 0x16: return NVSHMEMI_IBGDA_FT_CLASS_RNR_RETRY_EXC;
+        case 0x01: return NVSHMEMI_IBGDA_FT_CLASS_LOC_LEN;
+        case 0x02: return NVSHMEMI_IBGDA_FT_CLASS_LOC_QP_OP;
+        case 0x14: return NVSHMEMI_IBGDA_FT_CLASS_REM_OP;
+        case 0x22: return NVSHMEMI_IBGDA_FT_CLASS_REM_ABORT;
+        case 0x11: return NVSHMEMI_IBGDA_FT_CLASS_LOC_ACCESS;
+        case 0x10: return NVSHMEMI_IBGDA_FT_CLASS_BAD_RESP;
+        default: return NVSHMEMI_IBGDA_FT_CLASS_OTHER;
+    }
+}
+
+__device__ NVSHMEMI_STATIC NVSHMEMI_DEVICE_ALWAYS_INLINE void ibgda_ft_st_sys32(uint32_t *p,
+                                                                              uint32_t v) {
+    asm volatile("st.relaxed.sys.global.u32 [%0], %1;" ::"l"(p), "r"(v) : "memory");
+}
+
+__device__ NVSHMEMI_STATIC NVSHMEMI_DEVICE_ALWAYS_INLINE uint32_t ibgda_ft_ld_u32(const void *p) {
+    uint32_t v;
+    asm volatile("ld.volatile.global.u32 %0, [%1];" : "=r"(v) : "l"(p) : "memory");
+    return v;
+}
+
+/* True once any error was recorded (or is being recorded) for the QP behind this CQ. */
+__device__ NVSHMEMI_STATIC NVSHMEMI_DEVICE_ALWAYS_INLINE bool ibgda_ft_cq_failed(
+    const nvshmemi_ibgda_device_cq_t *cq) {
+    return ibgda_atomic_read(&ibgda_ft_mvars_of_cq(cq)->ft_state) != 0;
+}
+
+/* Snapshot the error CQE in slot 0, record it as the QP's sticky first error and publish it to the
+ * host mailbox. Cold path: kept out of line so the poll loops stay small. Returns the syndrome. */
+__device__ __noinline__ static int ibgda_ft_capture(const nvshmemi_ibgda_device_cq_t *cq,
+                                                    uint64_t poll_idx, uint32_t path) {
+    nvshmemi_ibgda_ft_dev_t *ft = ibgda_ft_dev();
+    const uint32_t *cw = (const uint32_t *)cq->cqe; /* 16 words of the collapsed slot */
+    uint32_t w[16];
+    uint32_t tries = 0;
+
+    /* Consistent snapshot: word 15 (wqe_counter, signature, op_own) must be the same before and
+     * after the 64 bytes are read; a trailing flush that lands meanwhile changes it. */
+    for (;;) {
+        uint32_t a = ibgda_ft_ld_u32(&cw[15]);
+#pragma unroll
+        for (int i = 0; i < 16; i++) w[i] = ibgda_ft_ld_u32(&cw[i]);
+        uint32_t b = ibgda_ft_ld_u32(&cw[15]);
+        tries++;
