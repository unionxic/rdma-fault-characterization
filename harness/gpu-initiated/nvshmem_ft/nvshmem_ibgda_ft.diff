+/* Decode one mailbox record into the info struct. */
+static void ibgda_ft_decode(const nvshmemi_ibgda_ft_record_t *r, nvshmemt_ibgda_ft_info_t *o) {
+    memset(o, 0, sizeof(*o));
+    o->valid = 1;
+    o->cls = r->cls;
+    o->syndrome = r->syndrome;
+    o->vendor_err = r->vendor_err;
+    o->opcode = r->root_opcode;
+    o->wc_status = ibgda_ft_wc_status(r->syndrome);
+    o->trailing = (r->cls == NVSHMEMI_IBGDA_FT_CLASS_FLUSH_TRAILING);
+    o->path = r->path;
+    o->upgrade = r->upgrade;
+    o->snap_tries = (int)r->snap_tries;
+    o->peer = r->peer;
+    o->qp_type = r->qp_type;
+    o->qpn = r->qpn;
+    o->wqe_counter = r->wqe_counter;
+    o->seq = r->seq;
+    o->poll_idx = r->poll_idx;
+    o->prod_idx = r->prod_idx;
+    o->cons_idx = r->cons_idx;
+    o->gtimer_ns = r->gtimer_ns;
+    ibgda_ft_class_text(r->cls, r->vendor_err, o);
+}
+
+static void ibgda_ft_handle_record(const nvshmemi_ibgda_ft_record_t *r, double mono_ms) {
+    nvshmemt_ibgda_ft_info_t info;
+    ibgda_ft_decode(r, &info);
+    info.host_mono_ms = mono_ms;
+    {
+        std::lock_guard<std::mutex> g(ibgda_ft.mu);
+        ibgda_ft.nrecords++;
+        info.nrecords = ibgda_ft.nrecords;
+        /* Keep the first record since the last commit; an upgrade (root cause found after a
+         * trailing-only record) replaces it. */
+        if (!ibgda_ft.have_error.load() || (info.upgrade && ibgda_ft.first.trailing)) {
+            ibgda_ft.first = info;
+            ibgda_ft.have_error.store(1);
+        }
+    }
+    if (ibgda_ft.quiet_log) return;
+    fprintf(stderr,
+            "[nvshmem-ft] PE%d device-classified error CQE seq=%u qpn=0x%x qp_type=%s peer=%d "
+            "wqe=%u path=%s fp=%d/0x%02x syndrome=0x%02x class=%s fault=%s cause=\"%s\" "
+            "action=\"%s\" root_op=0x%x hw_err=0x%x/0x%x upgrade=%d snap_tries=%u poll_idx=%llu "
+            "prod=%llu cons=%llu ready=%llu gtimer_ns=%llu mono_ms=%.3f\n",
+            ibgda_ft.t->my_pe, r->seq, r->qpn,
+            r->qp_type == NVSHMEMI_IBGDA_DEVICE_QP_TYPE_RC ? "RC" : "DCI", r->peer, r->wqe_counter,
+            ibgda_ft_path_str(r->path), info.wc_status, r->vendor_err, r->syndrome, info.name,
+            info.fault, info.cause, info.action, r->root_opcode, r->hw_err_synd, r->hw_synd_type,
+            r->upgrade, r->snap_tries, (unsigned long long)r->poll_idx,
+            (unsigned long long)r->prod_idx, (unsigned long long)r->cons_idx,
+            (unsigned long long)r->ready_head, (unsigned long long)r->gtimer_ns, mono_ms);
+    /* Host view of the QP right after the record (DEVX QUERY_QP). */
+    int is_dci = 0;
+    struct ibgda_ep *ep = ibgda_ft_find_ep_by_qpn(r->qpn, &is_dci);
+    if (ep && ep->devx_qp) {
+        uint32_t s = 0, hw = 0, sw = 0;
+        double q0 = ibgda_ft_mono_ms();
+        int qs = ibgda_ft_query_qp(ep->devx_qp, ep->qpn, &s, &hw, &sw);
+        fprintf(stderr,
+                "[nvshmem-ft] PE%d host QUERY_QP qpn=0x%x ret=%d state=%u%s hw_sq_wqebb=%u "
+                "sw_sq_wqebb=%u query_us=%.0f\n",
+                ibgda_ft.t->my_pe, ep->qpn, qs, s, s == 6 ? "(ERR)" : s == 3 ? "(RTS)" : "", hw, sw,
+                (ibgda_ft_mono_ms() - q0) * 1e3);
+    }
+}
