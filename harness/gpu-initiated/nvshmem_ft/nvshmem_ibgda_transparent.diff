 typedef nvshmemi_ibgda_device_state_v2 nvshmemi_ibgda_device_state_t;
 
+/* ---------------------------------------------------------------------------------------------
+ * NVSHMEM_IBGDA_FT (research, default off): device-side classification of the root-cause error
+ * CQE, a host-mapped mailbox, and the state the host recovery path resyncs. See
+ * harness/gpu-initiated/nvshmem_ft/DESIGN.md.
+ * ------------------------------------------------------------------------------------------- */
+#define NVSHMEMI_IBGDA_FT_MAGIC 0x4e465442u /* "BTFN" */
+#define NVSHMEMI_IBGDA_FT_NSLOTS 16
+
+enum {
+    NVSHMEMI_IBGDA_FT_FLAG_ON = 1,          /* classification on: record + error return */
+    NVSHMEMI_IBGDA_FT_FLAG_CAPTURE_EXIT = 2, /* diagnostic: look at the slot only when the wait
+                                                exits (stock position), not in the spin loop */
+    NVSHMEMI_IBGDA_FT_FLAG_SENTINEL = 4,     /* the application runs the device sentinel */
+    /* v2 */
+    NVSHMEMI_IBGDA_FT_FLAG_RING_CQ = 8,      /* send CQs are non-collapsed rings (cc=0, oi=1); waits
+                                                walk them by consumer counter (mvars.ft_ring_ci) */
+    NVSHMEMI_IBGDA_FT_FLAG_BOUNDS = 16,      /* remote ranges are checked against the heap's
+                                                allocated chunks before an RMA/AMO is posted */
+    NVSHMEMI_IBGDA_FT_FLAG_TEST_TRIP = 32,   /* test-only: trip the ring-walk invariant check
+                                                (NVSHMEM_IBGDA_FT_TEST_TRIP) */
+    NVSHMEMI_IBGDA_FT_FLAG_PARK = 64,        /* v2.1: a QP with a recorded error is parked: posts
+                                                on it no longer advance its doorbell record or ring
+                                                the doorbell (they would only be flushed). Not set
+                                                with CAPTURE_EXIT (see ibgda_ft_init). */
+    NVSHMEMI_IBGDA_FT_FLAG_T1 = 128,         /* T1: transparent recovery inside the library (RC QPs
+                                                with a gate: posters pause, waits hold across a
+                                                recovery, a library helper thread recovers). Needs
+                                                RING_CQ and PARK. */
+};
+
+/* ---------------------------------------------------------------------------------------------
+ * T1 (NVSHMEM_IBGDA_FT_TRANSPARENT=1): per-RC-QP gate, 64 B in GPU memory.
+ *
+ * word: bits 63..32 = epoch (written by the host with a 4-byte copy): even = stable, odd = a
+ *       recovery owns the QP, bit 31 of the epoch = FAILED (terminal, declined). Bits 31..0 =
+ *       device threads inside the counted region (posters from reserve to submit, except while they
+ *       wait for a recovery, when they leave it; a waiter only while it records an error). Device
+ *       threads update it with 64-bit atomics whose return value carries the epoch: one location,
+ *       so the host's epoch write and every entry are totally ordered. The host rewrites QP state
+ *       only when nothing is counted.
+ * off:  D-index offset of the current epoch: a logical index L = D - off never changes across a
+ *       recovery (the device indices jump forward by delta = off_new - off_old).
+ * xbb:  WQEBBs posted (made ready) this epoch beyond one per network message (NOP, DUMP, 2-BB
+ *       atomics); the host uses it to map the responder's executed message count to a D index.
+ * abandoned / commit: give-up handshake between a device thread and the host's commit point.
+ * dfailed: set by a device thread that gave up (a second terminal flag, the host checks it).
+ * ------------------------------------------------------------------------------------------- */
+#define NVSHMEMI_IBGDA_FT_T1_ODD 1u
+#define NVSHMEMI_IBGDA_FT_T1_FAILED 0x80000000u
+#define NVSHMEMI_IBGDA_FT_T1_CNT 1ULL            /* one counted device thread */
+/* T1: mvars.ft_ring_ci carries the epoch (low 24 bits) above bit 40 of the ring counter. */
+#define NVSHMEMI_IBGDA_FT_T1_TAG_SHIFT 40
+#define NVSHMEMI_IBGDA_FT_T1_TAG_MASK 0xffffffu
+typedef struct {
+    unsigned long long word;
+    uint32_t pad_hold;
+    uint32_t abandoned;
+    uint32_t commit;
+    uint32_t dfailed;
+    unsigned long long off;
+    unsigned long long xbb;
+    uint32_t test;     /* T1 test knobs (NVSHMEMI_IBGDA_FT_T1_TEST_*) */
+    uint32_t pad0;
+    unsigned long long hflag; /* device pointer to a host-mapped uint32_t the host sets (plain
+                                 store, no CUDA call) when it declines: a held device wait reads it
+                                 over PCIe and fails even if the host's copies to this gate stall */
+    unsigned long long pad1;
+} __attribute__((__aligned__(64))) nvshmemi_ibgda_ft_gate_t;
+static_assert(sizeof(nvshmemi_ibgda_ft_gate_t) == 64, "nvshmemi_ibgda_ft_gate_t must be 64 B");
+enum {
+    NVSHMEMI_IBGDA_FT_T1_TEST_NOREMAP = 1, /* waiters keep their old D ticket (negative control) */
+};
+/* v2.1: bit 63 of a parked QP's prod_idx. The recording thread sets it with a device-scope
+ * atomicOr, so the low 63 bits keep the last index that was rung (report prod & ~MARK). */
+#define NVSHMEMI_IBGDA_FT_PARK_MARK (1ULL << 63)
+
+/* v2 test-only knobs (NVSHMEM_IBGDA_FT_TEST_SKIP=<comma list>): skip one step of the recovery
+ * resync (negative controls). Never set in production. */
+enum {
+    NVSHMEMI_IBGDA_FT_SKIP_IDX = 1 << 0,    /* keep tx_wq indices (resv/ready/prod/cons/get_*) */
+    NVSHMEMI_IBGDA_FT_SKIP_LOCK = 1 << 1,   /* keep post_send_lock */
+    NVSHMEMI_IBGDA_FT_SKIP_IBUF = 1 << 2,   /* keep ibuf head/tail */
+    NVSHMEMI_IBGDA_FT_SKIP_STICKY = 1 << 3, /* keep the per-QP sticky record (ft_state/fp/wqe/aux) */
+    NVSHMEMI_IBGDA_FT_SKIP_CQFILL = 1 << 4, /* do not refill the send CQ with 0xff */
+    NVSHMEMI_IBGDA_FT_SKIP_DBR = 1 << 5,    /* do not zero the QP doorbell record */
+    NVSHMEMI_IBGDA_FT_SKIP_NERR = 1 << 6,   /* do not clear ft_dev.nerr and the host record */
+    NVSHMEMI_IBGDA_FT_SKIP_DCI = 1 << 7,    /* do not reset local DCIs left in ERR */
+    NVSHMEMI_IBGDA_FT_SKIP_PSN = 1 << 8,    /* reconnect with PSN 0 instead of fresh random PSNs */
+    NVSHMEMI_IBGDA_FT_SKIP_FINBAR = 1 << 9, /* after a decline, do not skip the teardown barriers */
+    NVSHMEMI_IBGDA_FT_SKIP_RINGCI = 1 << 10, /* ring mode: restart the consumer counter at 0 instead
+                                               of the CQ's producer counter */
+    NVSHMEMI_IBGDA_FT_SKIP_PARK = 1 << 11    /* v2.1: do not park failed QPs (v2 behaviour: fail-fast
+                                               posts keep ringing the doorbell) */
+};
+
+/* Classes (same numbering as the NCCL GIN Q4 classifier). Syndromes: rdma-core
+ * providers/mlx5/mlx5dv.h MLX5_CQE_SYNDROME_*, mapped as in providers/mlx5/cq.c. */
+enum {
+    NVSHMEMI_IBGDA_FT_CLASS_NONE = 0,
+    NVSHMEMI_IBGDA_FT_CLASS_LOCAL_QP_ERR = 1,   /* 0x05 WR_FLUSH, vendor 0xf5 (head of SQ) */
+    NVSHMEMI_IBGDA_FT_CLASS_FLUSH_TRAILING = 2, /* 0x05 WR_FLUSH, vendor 0xf9 (behind an error) */
+    NVSHMEMI_IBGDA_FT_CLASS_FLUSH_OTHER = 3,
+    NVSHMEMI_IBGDA_FT_CLASS_LOC_PROT = 4,       /* 0x04 */
+    NVSHMEMI_IBGDA_FT_CLASS_REM_INV_REQ = 5,    /* 0x12 (0x8a) */
+    NVSHMEMI_IBGDA_FT_CLASS_REM_ACCESS = 6,     /* 0x13 (0x88) */
+    NVSHMEMI_IBGDA_FT_CLASS_RETRY_EXC = 7,      /* 0x15 (0x81) */
+    NVSHMEMI_IBGDA_FT_CLASS_RNR_RETRY_EXC = 8,  /* 0x16 (0x87) */
+    NVSHMEMI_IBGDA_FT_CLASS_LOC_LEN = 9,        /* 0x01 */
+    NVSHMEMI_IBGDA_FT_CLASS_LOC_QP_OP = 10,     /* 0x02 */
+    NVSHMEMI_IBGDA_FT_CLASS_REM_OP = 11,        /* 0x14 */
+    NVSHMEMI_IBGDA_FT_CLASS_REM_ABORT = 12,     /* 0x22 */
+    NVSHMEMI_IBGDA_FT_CLASS_LOC_ACCESS = 13,    /* 0x11 */
+    NVSHMEMI_IBGDA_FT_CLASS_BAD_RESP = 14,      /* 0x10 */
+    NVSHMEMI_IBGDA_FT_CLASS_OTHER = 15,
+    /* v2: library-detected (no CQE), NVSHMEM_IBGDA_FT_BOUNDS=1 */
+    NVSHMEMI_IBGDA_FT_CLASS_OOB_WRITE = 16, /* put/p/AMO/signal target range outside an allocated
+                                               chunk of the symmetric heap: not posted */
+    NVSHMEMI_IBGDA_FT_CLASS_OOB_READ = 17,  /* get/g source range, same check: not posted */
+    NVSHMEMI_IBGDA_FT_CLASS_RING_INVARIANT = 18, /* ring walk: a consumed CQE's wqe_counter does not
+                                                    advance cons_idx by 1..ncqes (internal error;
+                                                    fails every later wait on the QP) */
+    NVSHMEMI_IBGDA_FT_CLASS_T1_DECLINED = 19, /* T1: the library declined (or a device wait gave up
+                                                 on) a recovery of this QP; reported by
+                                                 nvshmemx_ibgda_ft_status when the QP has no CQE
+                                                 record of its own */
+};
+
+/* v2: why a bounds check failed (record vendor_err byte of a library-detected record). */
+enum {
+    NVSHMEMI_IBGDA_FT_OOB_OUTSIDE_HEAP = 1, /* [off, off+len) not inside [0, heap_size) */
+    NVSHMEMI_IBGDA_FT_OOB_FREE = 2,         /* first byte in a free (unallocated) part of the heap */
+    NVSHMEMI_IBGDA_FT_OOB_CROSSES = 3,      /* starts in a chunk, ends past that chunk's end */
+};
+enum {
+    NVSHMEMI_IBGDA_FT_OP_PUT = 1,
+    NVSHMEMI_IBGDA_FT_OP_GET = 2,
+    NVSHMEMI_IBGDA_FT_OP_P = 3,
+    NVSHMEMI_IBGDA_FT_OP_G = 4,
+    NVSHMEMI_IBGDA_FT_OP_AMO = 5,
+    NVSHMEMI_IBGDA_FT_OP_AMO_FETCH = 6,
+    NVSHMEMI_IBGDA_FT_OP_PUT_SIGNAL = 7,    /* data range */
+    NVSHMEMI_IBGDA_FT_OP_SIGNAL = 8,        /* signal word of a put-with-signal */
+};
+
+enum {
+    NVSHMEMI_IBGDA_FT_PATH_POLL = 1,     /* ibgda_poll_cq spin loop (quiet, slot wait) */
+    NVSHMEMI_IBGDA_FT_PATH_EXIT = 2,     /* ibgda_poll_cq after the wait was satisfied */
+    NVSHMEMI_IBGDA_FT_PATH_BOUNDED = 3,  /* nvshmemx_ibgda_ft_quiet_bounded */
+    NVSHMEMI_IBGDA_FT_PATH_SENTINEL = 4, /* nvshmemx_ibgda_ft_sentinel */
+    NVSHMEMI_IBGDA_FT_PATH_BOUNDS = 5,   /* v2: device bounds check before posting */
+};
+
+/* One mailbox record (256 B) in host-pinned mapped memory. The device writes the body with
+ * system-scope stores, __threadfence_system(), then seq, fence, then magic. */
+typedef struct {
+    uint32_t magic;
+    uint32_t seq;          /* 1-based */
+    uint32_t qpn;          /* QP the wait was on */
+    uint32_t cqe_sqpn;     /* root CQE s_wqe_opcode_qpn (host order) */
+    uint16_t wqe_counter;  /* root CQE wqe_counter */
+    uint8_t syndrome;      /* root CQE byte 55 */
+    uint8_t vendor_err;    /* root CQE byte 54 */
+    uint8_t cls;           /* NVSHMEMI_IBGDA_FT_CLASS_* */
+    uint8_t kind;          /* 1 = error CQE, 2 = library-detected (bounds check, no CQE) */
+    uint8_t path;          /* NVSHMEMI_IBGDA_FT_PATH_* */
+    uint8_t qp_type;       /* NVSHMEMI_IBGDA_DEVICE_QP_TYPE_* */
+    uint8_t hw_err_synd;   /* byte 52 */
+    uint8_t hw_synd_type;  /* byte 53 */
+    uint8_t root_opcode;   /* op_own >> 4 */
+    uint8_t upgrade;       /* 1 if this record replaces an earlier trailing-flush-only record */
+    int32_t mype;
+    int32_t peer;          /* RC: peer PE; DCI: -1 */
+    uint32_t qp_index;     /* index into globalmem.rcs / dcis */
+    uint64_t poll_idx;     /* index (WQE idx + 1) the wait was waiting for */
+    uint64_t cons_idx;
+    uint64_t prod_idx;
+    uint64_t ready_head;
+    uint64_t resv_head;
+    uint64_t gtimer_ns;    /* %globaltimer at capture */
+    uint32_t snap_tries;   /* reads needed for a consistent 64-B snapshot */
+    uint32_t pad0;
+    uint8_t root_cqe[64];  /* raw root CQE */
+    /* v2 */
+    uint64_t ring_ci;      /* ring mode: consumer counter of the error CQE (else 0) */
+    uint64_t oob_off;      /* bounds: heap offset of the rejected remote range */
+    uint64_t oob_len;      /* bounds: its length */
+    uint64_t oob_chunk_end;/* bounds: end offset of the chunk that holds oob_off (0 if free) */
+    uint32_t oob_op;       /* bounds: NVSHMEMI_IBGDA_FT_OP_* */
+    uint32_t ring;         /* 1 if the CQ is a ring (NVSHMEM_IBGDA_FT_RING_CQ) */
+    uint32_t inv_d;        /* ring invariant record: the advance d computed for the consumed CQE */
+    uint32_t inv_ncqes;    /* ring invariant record: the bound (ncqes) it violated */
+    /* v2.1 (third review): the thread that recorded (and parked): flat CTA id, flat thread id in
+     * the CTA, SM id. With path = sentinel it is the sentinel kernel's thread. */
+    uint32_t by_cta;
+    uint32_t by_tid;
+    uint32_t by_smid;
+    /* T1: gate epoch (hi 32 bits of the gate word) when the record was written; t1 = 1 if the QP has
+     * a gate. The helper handles a record only if its epoch is the QP's current stable epoch. */
+    uint32_t t1_epoch;
+    uint32_t t1;
+    uint8_t reserved[28];
+} nvshmemi_ibgda_ft_record_t;
+static_assert(sizeof(nvshmemi_ibgda_ft_record_t) == 256, "nvshmemi_ibgda_ft_record_t must be 256 B");
+
+/* Device control block (GPU memory), pointed to by nvshmemi_ibgda_device_state_t::ft. */
+typedef struct {
+    nvshmemi_ibgda_ft_record_t *mbox; /* device alias of the host-mapped records */
+    uint32_t nslots;
+    uint32_t seq;              /* GPU atomic, 1-based record sequence */
+    uint32_t nerr;             /* QPs with a recorded error since the last recovery */
+    uint32_t flags;            /* copy of NVSHMEMI_IBGDA_FT_FLAG_* */
+    uint64_t sentinel_polls;   /* sentinel loop iterations (diagnostic) */
+    uint32_t sentinel_stop;    /* host sets 1 to end the sentinel */
+    uint32_t sentinel_running; /* sentinel sets 1 while it runs */
+    uint32_t test_trip;        /* test-only countdown: the ring consumption that brings it to 0 has
+                                  its d forced to 0 (NVSHMEM_IBGDA_FT_TEST_TRIP) */
+    uint32_t test_trip_mode;   /* 1 = v2.1 behaviour (record + error), 2 = emulate v2 (silent skip) */
+    uint32_t fetch_poisoned;   /* v2.1: fetches (AMO fetch, g) whose completion failed: they
+                                  returned the poison value (all bits 1) instead of the ibuf slot */
+    uint32_t pad1;
+    /* T1 (was reserved[2]): bound of a device wait held across a recovery (ns, %globaltimer), and
+     * the number of device threads that gave up after it. */
+    uint64_t t1_hold_ns;
+    uint32_t t1_gaveup;
+    uint32_t t1_pad;
+} nvshmemi_ibgda_ft_dev_t;
+
+/* Host API of the IBGDA transport plugin (exported from nvshmem_transport_ibgda.so; an application
+ * resolves the nvshmemt_ibgda_ft_* symbols with dlopen(RTLD_NOLOAD) + dlsym). */
+#define NVSHMEMT_IBGDA_FT_API_VERSION 3 /* 3: 64-bit prod_idx + parked flags in stats and token,
+                                            fetch_poisoned in info */
+#define NVSHMEMT_IBGDA_FT_MAX_QPS 8
+#define NVSHMEMT_IBGDA_FT_TOKEN_MAGIC 0x4654544bu /* "KTTF" */
+
+typedef struct {
+    int valid;          /* 1 if an unrecovered error record is present */
+    int cls;            /* NVSHMEMI_IBGDA_FT_CLASS_* */
+    int wc_status;      /* ibv_wc_status equivalent of the syndrome */
+    int opcode, syndrome, vendor_err, trailing, path, upgrade, snap_tries;
+    int peer, qp_type;
+    uint32_t qpn, wqe_counter, seq, nrecords;
+    uint64_t poll_idx, prod_idx, cons_idx, gtimer_ns;
+    double host_mono_ms; /* CLOCK_MONOTONIC (ms) when the watcher read the record */
+    char name[24], fault[24], cause[128], action[128];
+    int recover_hint; /* 1 recoverable class, 2 recoverable if the peer is alive, 0 decline */
+    /* v2 */
+    int kind;         /* 1 error CQE, 2 library-detected (bounds), 3 internal (ring invariant) */
+    int oob_op;
+    uint32_t inv_d, inv_ncqes;
+    uint64_t ring_ci, oob_off, oob_len, oob_chunk_end;
+    /* v2.1 (API 3) */
+    uint32_t fetch_poisoned; /* ft_dev.fetch_poisoned when the record was read */
+    uint32_t by_cta, by_tid, by_smid; /* the recording thread (record by_*) */
+} nvshmemt_ibgda_ft_info_t;
+
+typedef struct {
+    uint32_t magic, nqps;
+    int32_t pe, peer;
+    struct {
+        uint32_t qpn, peer_qpn, sq_psn, parked; /* parked: 1 if prod_idx carried the park mark */
+        uint64_t prod_idx;                      /* device producer index at Prepare, mark removed */
+    } qp[NVSHMEMT_IBGDA_FT_MAX_QPS];
+} nvshmemt_ibgda_ft_token_t;
+
+typedef struct {
+    uint32_t nqps, ndci_reset, drained;
+    uint32_t parked_mask; /* v2.1 (API 3): bit i = QP i was parked (prod_idx carried the mark) */
+    double to_err_ms, drain_ms, prepare_ms;       /* Prepare */
+    double rst_ms, resync_ms, connect_ms, commit_ms; /* Commit */
+    uint64_t prod_idx[NVSHMEMT_IBGDA_FT_MAX_QPS];  /* device producer index of each QP at Prepare
+                                                      (API 3: 64-bit, park mark removed) */
+    uint32_t qp_state[NVSHMEMT_IBGDA_FT_MAX_QPS];  /* QUERY_QP state at Prepare (before 2ERR) */
+    char msg[160];
+    /* v2, ring mode: per QP, device consumer counter before the commit, CQEs found unconsumed by
+     * a host scan, and the CQ producer counter (QUERY_CQ) the counter was set to */
+    uint64_t ring_ci_old[NVSHMEMT_IBGDA_FT_MAX_QPS];
+    uint32_t ring_scan[NVSHMEMT_IBGDA_FT_MAX_QPS];
+    uint32_t ring_pi[NVSHMEMT_IBGDA_FT_MAX_QPS];
+    uint32_t skip_mask; /* NVSHMEM_IBGDA_FT_TEST_SKIP bits in effect */
+    uint32_t pad2;
+} nvshmemt_ibgda_ft_stats_t;
