+/* QUERY_QP -> state, hw/sw SQ wqebb counters. Returns the DEVX status. */
+static int ibgda_ft_query_qp(struct mlx5dv_devx_obj *devx_qp, uint32_t qpn, uint32_t *state,
+                             uint32_t *hw_sq, uint32_t *sw_sq) {
+    uint8_t cmd_in[DEVX_ST_SZ_BYTES(query_qp_in)] = {0};
+    uint8_t cmd_out[DEVX_ST_SZ_BYTES(query_qp_out)] = {0};
+    DEVX_SET(query_qp_in, cmd_in, opcode, MLX5_CMD_OP_QUERY_QP);
+    DEVX_SET(query_qp_in, cmd_in, qpn, qpn);
+    int st = mlx5dv_devx_obj_query(devx_qp, cmd_in, sizeof(cmd_in), cmd_out, sizeof(cmd_out));
+    void *qpc = DEVX_ADDR_OF(query_qp_out, cmd_out, qpc);
+    if (state) *state = DEVX_GET(qpc, qpc, state);
+    if (hw_sq) *hw_sq = DEVX_GET(qpc, qpc, hw_sq_wqebb_counter);
+    if (sw_sq) *sw_sq = DEVX_GET(qpc, qpc, sw_sq_wqebb_counter);
+    return st;
+}
+
+/* 2ERR (opcode 0x507) or 2RST (0x50a): same command layout. */
+static int ibgda_ft_qp_cmd(struct mlx5dv_devx_obj *devx_qp, uint32_t qpn, uint16_t opcode) {
+    uint8_t cmd_in[DEVX_ST_SZ_BYTES(ibgda_fi_2err_qp_in)] = {0};
+    uint8_t cmd_out[DEVX_ST_SZ_BYTES(ibgda_fi_2err_qp_out)] = {0};
+    DEVX_SET(ibgda_fi_2err_qp_in, cmd_in, opcode, opcode);
+    DEVX_SET(ibgda_fi_2err_qp_in, cmd_in, qpn, qpn);
+    int status = mlx5dv_devx_obj_modify(devx_qp, cmd_in, sizeof(cmd_in), cmd_out, sizeof(cmd_out));
+    if (status) {
+        fprintf(stderr, "[nvshmem-ft] qp cmd 0x%x qpn=0x%x failed ret=%d devx_status=0x%x syndrome=0x%x\n",
+                opcode, qpn, status, DEVX_GET(ibgda_fi_2err_qp_out, cmd_out, status),
+                DEVX_GET(ibgda_fi_2err_qp_out, cmd_out, syndrome));
+    }
+    return status;
+}
+
+static struct ibgda_ep *ibgda_ft_find_ep_by_qpn(uint32_t qpn, int *is_dci) {
+    nvshmemt_ibgda_state_t *st = ibgda_ft.st;
+    int n_pes = ibgda_ft.t->n_pes;
+    for (int i = 0; i < st->n_devs_selected; i++) {
+        struct ibgda_device *device =
+            (struct ibgda_device *)st->common.devices + st->selected_dev_ids[i];
+        for (int e = 0; e < device->rc.num_eps_per_pe * n_pes; e++) {
+            struct ibgda_ep *ep = device->rc.eps ? device->rc.eps[e] : NULL;
+            if (ep && ep->qpn == qpn) {
+                if (is_dci) *is_dci = 0;
+                return ep;
+            }
+        }
+        for (int e = 0; e < device->dci.num_eps; e++) {
+            struct ibgda_ep *ep = device->dci.eps ? device->dci.eps[e] : NULL;
+            if (ep && ep->qpn == qpn) {
+                if (is_dci) *is_dci = 1;
+                return ep;
+            }
+        }
+    }
+    return NULL;
+}
+
+/* Decode one mailbox record into the info struct. */
+static void ibgda_ft_decode(const nvshmemi_ibgda_ft_record_t *r, nvshmemt_ibgda_ft_info_t *o) {
+    memset(o, 0, sizeof(*o));
+    o->valid = 1;
+    o->cls = r->cls;
+    o->syndrome = r->syndrome;
+    o->vendor_err = r->vendor_err;
+    o->opcode = r->root_opcode;
+    o->wc_status = ibgda_ft_wc_status(r->syndrome);
+    o->trailing = (r->cls == NVSHMEMI_IBGDA_FT_CLASS_FLUSH_TRAILING);
+    o->path = r->path;
+    o->upgrade = r->upgrade;
+    o->snap_tries = (int)r->snap_tries;
+    o->peer = r->peer;
+    o->qp_type = r->qp_type;
+    o->qpn = r->qpn;
+    o->wqe_counter = r->wqe_counter;
+    o->seq = r->seq;
+    o->poll_idx = r->poll_idx;
+    o->prod_idx = r->prod_idx;
+    o->cons_idx = r->cons_idx;
+    o->gtimer_ns = r->gtimer_ns;
+    o->kind = r->kind;
+    o->ring_ci = r->ring_ci;
+    o->oob_off = r->oob_off;
+    o->oob_len = r->oob_len;
+    o->oob_chunk_end = r->oob_chunk_end;
+    o->oob_op = (int)r->oob_op;
+    o->inv_d = r->inv_d;
+    o->inv_ncqes = r->inv_ncqes;
+    o->by_cta = r->by_cta;
+    o->by_tid = r->by_tid;
+    o->by_smid = r->by_smid;
+    if (r->kind == 2 || r->kind == 3) o->wc_status = -1; /* no error CQE */
+    ibgda_ft_class_text(r->cls, r->vendor_err, o);
+}
+
+static void ibgda_ft_handle_record(const nvshmemi_ibgda_ft_record_t *r, double mono_ms) {
+    nvshmemt_ibgda_ft_info_t info;
+    ibgda_ft_decode(r, &info);
+    info.host_mono_ms = mono_ms;
+    /* T1: a record of a gated RC QP belongs to the library's helper (the application's error view
+     * shows only a declined recovery). */
+    const bool t1 = t1_take_record(r, mono_ms);
+    {
+        std::lock_guard<std::mutex> g(ibgda_ft.mu);
+        ibgda_ft.nrecords++;
+        info.nrecords = ibgda_ft.nrecords;
+        /* Keep the first record since the last commit; an upgrade (root cause found after a
+         * trailing-only record) replaces it. */
+        if (!t1 && (!ibgda_ft.have_error.load() || (info.upgrade && ibgda_ft.first.trailing))) {
+            ibgda_ft.first = info;
+            ibgda_ft.have_error.store(1);
+        }
+    }
+    if (ibgda_ft.quiet_log) return;
+    if (r->kind == 3) {
+        const uint32_t w15 = ((const uint32_t *)r->root_cqe)[15];
+        fprintf(stderr,
+                "[nvshmem-ft] PE%d device ring-walk invariant violated seq=%u qpn=0x%x peer=%d "
+                "path=%s ring_ci=%llu wqe_counter=%u op_own=0x%02x cons=%llu d=%u (valid 1..%u) "
+                "poll_idx=%llu prod=%llu class=%s cause=\"%s\" action=\"%s\" already_recorded=%d "
+                "gtimer_ns=%llu mono_ms=%.3f\n",
+                ibgda_ft.t->my_pe, r->seq, r->qpn, r->peer, ibgda_ft_path_str(r->path),
+                (unsigned long long)r->ring_ci, r->wqe_counter, w15 >> 24,
+                (unsigned long long)r->cons_idx, r->inv_d, r->inv_ncqes,
+                (unsigned long long)r->poll_idx, (unsigned long long)r->prod_idx, info.name,
+                info.cause, info.action, r->upgrade, (unsigned long long)r->gtimer_ns, mono_ms);
+        return;
+    }
+    if (r->kind == 2) {
+        fprintf(stderr,
+                "[nvshmem-ft] PE%d device bounds check rejected an operation seq=%u qpn=0x%x peer=%d "
+                "op=%u off=0x%llx len=%llu chunk_end=0x%llx heap_size=0x%llx class=%s why=%u "
+                "cause=\"%s\" action=\"%s\" already_recorded=%d gtimer_ns=%llu mono_ms=%.3f\n",
+                ibgda_ft.t->my_pe, r->seq, r->qpn, r->peer, r->oob_op,
+                (unsigned long long)r->oob_off, (unsigned long long)r->oob_len,
+                (unsigned long long)r->oob_chunk_end, (unsigned long long)ibgda_ft.heap_size,
+                info.name, r->vendor_err, info.cause, info.action, r->upgrade,
+                (unsigned long long)r->gtimer_ns, mono_ms);
+        return;
+    }
+    fprintf(stderr,
+            "[nvshmem-ft] PE%d device-classified error CQE seq=%u qpn=0x%x qp_type=%s peer=%d "
+            "wqe=%u path=%s fp=%d/0x%02x syndrome=0x%02x class=%s fault=%s cause=\"%s\" "
+            "action=\"%s\" root_op=0x%x hw_err=0x%x/0x%x upgrade=%d snap_tries=%u poll_idx=%llu "
+            "prod=%llu cons=%llu ready=%llu gtimer_ns=%llu mono_ms=%.3f ring=%u ring_ci=%llu "
+            "by_cta=%u by_tid=%u by_sm=%u\n",
+            ibgda_ft.t->my_pe, r->seq, r->qpn,
+            r->qp_type == NVSHMEMI_IBGDA_DEVICE_QP_TYPE_RC ? "RC" : "DCI", r->peer, r->wqe_counter,
+            ibgda_ft_path_str(r->path), info.wc_status, r->vendor_err, r->syndrome, info.name,
+            info.fault, info.cause, info.action, r->root_opcode, r->hw_err_synd, r->hw_synd_type,
+            r->upgrade, r->snap_tries, (unsigned long long)r->poll_idx,
+            (unsigned long long)r->prod_idx, (unsigned long long)r->cons_idx,
+            (unsigned long long)r->ready_head, (unsigned long long)r->gtimer_ns, mono_ms, r->ring,
+            (unsigned long long)r->ring_ci, r->by_cta, r->by_tid, r->by_smid);
+    if (t1) {
+        fprintf(stderr, "[nvshmem-ft] PE%d record seq=%u handed to the T1 helper (epoch %u)\n",
+                ibgda_ft.t->my_pe, r->seq, r->t1_epoch);
+        return; /* QP commands belong to the helper (one QP state change at a time) */
+    }
+    /* Host view of the QP right after the record (DEVX QUERY_QP). */
+    int is_dci = 0;
+    struct ibgda_ep *ep = ibgda_ft_find_ep_by_qpn(r->qpn, &is_dci);
+    if (ep && ep->devx_qp) {
+        uint32_t s = 0, hw = 0, sw = 0;
+        double q0 = ibgda_ft_mono_ms();
+        std::unique_lock<std::mutex> lk(ibgda_ft.st->rc_endpoint_lock, std::defer_lock);
+        if (t1_active()) lk.lock(); /* T1: one DEVX command per QP at a time */
+        int qs = ibgda_ft_query_qp(ep->devx_qp, ep->qpn, &s, &hw, &sw);
+        fprintf(stderr,
+                "[nvshmem-ft] PE%d host QUERY_QP qpn=0x%x ret=%d state=%u%s hw_sq_wqebb=%u "
+                "sw_sq_wqebb=%u query_us=%.0f\n",
+                ibgda_ft.t->my_pe, ep->qpn, qs, s, s == 6 ? "(ERR)" : s == 3 ? "(RTS)" : "", hw, sw,
+                (ibgda_ft_mono_ms() - q0) * 1e3);
+    }
+}
+
+static void ibgda_ft_watcher_main() {
+    const int wpr = sizeof(nvshmemi_ibgda_ft_record_t) / 4;
+    while (!ibgda_ft.stop.load()) {
+        for (int s = 0; s < NVSHMEMI_IBGDA_FT_NSLOTS; s++) {
+            volatile uint32_t *w = (volatile uint32_t *)&ibgda_ft.mbox_h[s];
+            uint32_t magic = w[0], seq = w[1];
+            if (magic != NVSHMEMI_IBGDA_FT_MAGIC || seq == 0 || seq == ibgda_ft.last_seq[s]) continue;
+            std::atomic_thread_fence(std::memory_order_acquire);
+            nvshmemi_ibgda_ft_record_t r;
+            uint32_t *rw = (uint32_t *)&r;
+            for (int i = 0; i < wpr; i++) rw[i] = w[i];
+            std::atomic_thread_fence(std::memory_order_acquire);
+            if (w[1] != seq || w[0] != NVSHMEMI_IBGDA_FT_MAGIC) continue; /* being rewritten */
+            ibgda_ft.last_seq[s] = seq;
+            ibgda_ft_handle_record(&r, ibgda_ft_mono_ms());
+        }
+        t1_watchdog();
+        std::this_thread::sleep_for(std::chrono::microseconds(ibgda_ft.poll_us));
+    }
+}
+
+static void ibgda_ft_set_failed(const char *why) {
+    if (ibgda_ft.skip & NVSHMEMI_IBGDA_FT_SKIP_FINBAR) { /* v2 (C) negative control, test-only */
+        fprintf(stderr, "[nvshmem-ft] PE%d TEST_SKIP finbar: not marking the transport failed (%s); "
+                        "teardown runs the stock barriers\n", ibgda_ft.t ? ibgda_ft.t->my_pe : -1, why);
+        return;
+    }
+    if (ibgda_ft.t) ibgda_ft.t->attr |= NVSHMEM_TRANSPORT_ATTR_FT_FAILED_BIT;
+    fprintf(stderr, "[nvshmem-ft] PE%d marked failed (%s): device collectives are skipped at teardown\n",
+            ibgda_ft.t ? ibgda_ft.t->my_pe : -1, why);
+}
+
+/* v2 (B): (re)build the device chunk table from the latest heap snapshot. Caller holds heap_mu.
+ * Returns 1 if the device-state fields changed (the host library must push the device state), 0
+ * if only the table contents changed or nothing was done, <0 on error. */
+static int ibgda_ft_bounds_upload(nvshmemi_ibgda_device_state_t *dstate) {
+    if (!ibgda_ft.enabled || !ibgda_ft.bounds || ibgda_ft.heap_size == 0 || dstate == NULL) return 0;
+    const uint32_t shift = 9; /* NVSHMEMI_MALLOC_ALIGNMENT */
+    const uint32_t ngran = (uint32_t)(ibgda_ft.heap_size >> shift);
+    std::vector<uint32_t> tbl(ngran, 0u);
+    bool aligned = true;
+    for (size_t i = 0; i < ibgda_ft.heap_off.size(); i++) {
+        uint64_t o = ibgda_ft.heap_off[i], l = ibgda_ft.heap_len[i];
+        if ((o & 511) || (l & 511) || o + l > ibgda_ft.heap_size) {
+            aligned = false;
+            break;
+        }
+        for (uint64_t g = o >> shift; g < (o + l) >> shift; g++) tbl[g] = (uint32_t)((o + l) >> shift);
+    }
+    int changed = 0;
+    if (!aligned) {
+        /* Cannot express the chunks at 512-B granularity: fall back to the heap-level check. */
+        fprintf(stderr, "[nvshmem-ft] PE%d bounds: heap chunk not 512-B aligned; heap-level check only\n",
+                ibgda_ft.t->my_pe);
+        if (dstate->ft_obj_ngran != 0) changed = 1;
+        dstate->ft_obj_ngran = 0;
+        return changed;
+    }
+    if (ibgda_ft.obj_tbl_d == NULL || ibgda_ft.obj_ngran != ngran) {
+        if (ibgda_ft.obj_tbl_d) cudaFree(ibgda_ft.obj_tbl_d);
+        ibgda_ft.obj_tbl_d = NULL;
+        if (cudaMalloc((void **)&ibgda_ft.obj_tbl_d, (size_t)ngran * 4)) return -1;
+        ibgda_ft.obj_ngran = ngran;
+        changed = 1;
+    }
+    if (cudaMemcpyAsync(ibgda_ft.obj_tbl_d, tbl.data(), (size_t)ngran * 4, cudaMemcpyHostToDevice,
+                        ibgda_ft.stream) ||
+        cudaStreamSynchronize(ibgda_ft.stream))
+        return -2;
+    if (dstate->ft_obj_end != ibgda_ft.obj_tbl_d || dstate->ft_obj_ngran != ngran ||
+        dstate->ft_obj_shift != shift)
+        changed = 1;
+    dstate->ft_obj_end = ibgda_ft.obj_tbl_d;
+    dstate->ft_obj_ngran = ngran;
+    dstate->ft_obj_shift = shift;
+    return changed;
+}
+
+/* v2 (B): the host library publishes its allocator's in-use chunks (offsets from the heap base)
+ * after every symmetric allocation and free (NVSHMEM_IBGDA_FT=1 and NVSHMEM_IBGDA_FT_BOUNDS=1).
+ * Returns 1 if the host library must push the device state (table pointer set or changed). */
+extern "C" __attribute__((visibility("default"))) int nvshmemt_ibgda_ft_heap_objects(
+    const uint64_t *off, const uint64_t *len, int n, uint64_t heap_base, uint64_t heap_size) {
+    std::lock_guard<std::mutex> g(ibgda_ft.heap_mu);
+    ibgda_ft.heap_off.assign(off, off + (n > 0 ? n : 0));
+    ibgda_ft.heap_len.assign(len, len + (n > 0 ? n : 0));
+    ibgda_ft.heap_base = heap_base;
+    ibgda_ft.heap_size = heap_size;
+    ibgda_ft.heap_updates++;
+    if (!ibgda_ft.enabled || !ibgda_ft.bounds || !ibgda_ft.t) return 0;
+    int r = ibgda_ft_bounds_upload((nvshmemi_ibgda_device_state_t *)ibgda_ft.t->type_specific_shared_state);
+    return r > 0 ? 1 : 0;
+}
+
+static uint32_t ibgda_ft_parse_skip(const char *sv) {
+    static const struct { const char *name; uint32_t bit; } k[] = {
+        {"idx", NVSHMEMI_IBGDA_FT_SKIP_IDX},       {"lock", NVSHMEMI_IBGDA_FT_SKIP_LOCK},
+        {"ibuf", NVSHMEMI_IBGDA_FT_SKIP_IBUF},     {"sticky", NVSHMEMI_IBGDA_FT_SKIP_STICKY},
+        {"cqfill", NVSHMEMI_IBGDA_FT_SKIP_CQFILL}, {"dbr", NVSHMEMI_IBGDA_FT_SKIP_DBR},
+        {"nerr", NVSHMEMI_IBGDA_FT_SKIP_NERR},     {"dci", NVSHMEMI_IBGDA_FT_SKIP_DCI},
+        {"psn", NVSHMEMI_IBGDA_FT_SKIP_PSN},       {"finbar", NVSHMEMI_IBGDA_FT_SKIP_FINBAR},
+        {"ringci", NVSHMEMI_IBGDA_FT_SKIP_RINGCI}, {"park", NVSHMEMI_IBGDA_FT_SKIP_PARK}};
+    uint32_t m = 0;
+    if (!sv) return 0;
+    std::string str(sv);
+    size_t p = 0;
+    while (p <= str.size()) {
+        size_t q = str.find(',', p);
+        std::string tok = str.substr(p, q == std::string::npos ? std::string::npos : q - p);
+        bool found = tok.empty();
+        for (auto &e : k)
+            if (tok == e.name) {
+                m |= e.bit;
+                found = true;
+            }
+        if (!found) fprintf(stderr, "[nvshmem-ft] unknown NVSHMEM_IBGDA_FT_TEST_SKIP item '%s'\n", tok.c_str());
+        if (q == std::string::npos) break;
+        p = q + 1;
+    }
+    return m;
+}
+
+/* Called at the end of the first connect_endpoints. */
+static int ibgda_ft_init(nvshmem_transport_t t, nvshmemt_ibgda_state_t *st,
+                         nvshmemi_ibgda_device_state_t *dstate) {
+    const char *on = getenv("NVSHMEM_IBGDA_FT");
+    if (!on || atoi(on) == 0) return 0;
+    const char *bd = getenv("NVSHMEM_IBGDA_FT_BOUNDS");
+    ibgda_ft.ring = (ibgda_ft_ring_cq_mode == 1);
+    ibgda_ft.bounds = bd && atoi(bd) != 0;
+    ibgda_ft.skip = ibgda_ft_parse_skip(getenv("NVSHMEM_IBGDA_FT_TEST_SKIP"));
+    /* v2.1 test-only: NVSHMEM_IBGDA_FT_TEST_TRIP=ring_d:<n> (the n-th consumed ring CQE fails the
+     * invariant check -> RING_INVARIANT record + error) or ring_d_silent:<n> (emulates v2: the
+     * CQE is consumed without advancing cons_idx and without a record). Ring mode only. */
+    uint32_t trip_n = 0, trip_mode = 0;
+    {
+        const char *tt = getenv("NVSHMEM_IBGDA_FT_TEST_TRIP");
+        if (tt && !strncmp(tt, "ring_d_silent:", 14)) {
+            trip_mode = 2;
+            trip_n = (uint32_t)atoi(tt + 14);
+        } else if (tt && !strncmp(tt, "ring_d:", 7)) {
+            trip_mode = 1;
+            trip_n = (uint32_t)atoi(tt + 7);
+        } else if (tt && *tt) {
+            fprintf(stderr, "[nvshmem-ft] unknown NVSHMEM_IBGDA_FT_TEST_TRIP '%s'\n", tt);
+        }
+        if (trip_n == 0) trip_mode = 0;
+    }
+    const char *pu = getenv("NVSHMEM_IBGDA_FT_POLL_US");
+    const char *cap = getenv("NVSHMEM_IBGDA_FT_CAPTURE");
+    const char *dm = getenv("NVSHMEM_IBGDA_FT_DRAIN_MS");
+    const char *ql = getenv("NVSHMEM_IBGDA_FT_QUIET");
+    ibgda_ft.poll_us = pu ? atoi(pu) : 50;
+    if (ibgda_ft.poll_us < 1) ibgda_ft.poll_us = 1;
+    ibgda_ft.drain_ms = dm ? atoi(dm) : 1000;
+    ibgda_ft.quiet_log = ql && atoi(ql) != 0;
+    ibgda_ft.flags = NVSHMEMI_IBGDA_FT_FLAG_ON;
+    if (cap && !strcmp(cap, "exit")) ibgda_ft.flags |= NVSHMEMI_IBGDA_FT_FLAG_CAPTURE_EXIT;
+    if (ibgda_ft.ring) ibgda_ft.flags |= NVSHMEMI_IBGDA_FT_FLAG_RING_CQ;
+    if (ibgda_ft.bounds) ibgda_ft.flags |= NVSHMEMI_IBGDA_FT_FLAG_BOUNDS;
+    if (trip_mode && ibgda_ft.ring) ibgda_ft.flags |= NVSHMEMI_IBGDA_FT_FLAG_TEST_TRIP;
+    /* v2.1: park (see ibgda_ft_park). Not with CAPTURE_EXIT: that diagnostic makes the collapsed
+     * poll read the slot only when the wait's own WQE completed, and a parked (never rung) WQE
+     * never completes, so such a wait would spin forever (third review; measured on v2.1). */
+    if (!(ibgda_ft.skip & NVSHMEMI_IBGDA_FT_SKIP_PARK) &&
+        !(ibgda_ft.flags & NVSHMEMI_IBGDA_FT_FLAG_CAPTURE_EXIT))
+        ibgda_ft.flags |= NVSHMEMI_IBGDA_FT_FLAG_PARK;
+    ibgda_ft.t = t;
+    ibgda_ft.st = st;
+    ibgda_ft.prep.assign(t->n_pes, ibgda_ft_prep());
+    memset(ibgda_ft.last_seq, 0, sizeof(ibgda_ft.last_seq));
+    ibgda_ft.have_error.store(0);
+    ibgda_ft.nrecords = 0;
+    ibgda_ft.commits.store(0);
+    ibgda_ft.fire_in_commit.store(0);
+
+    int status = cudaStreamCreateWithFlags(&ibgda_ft.stream, cudaStreamNonBlocking);
+    if (status) goto fail;
+    status = cudaHostAlloc(&ibgda_ft.pinned, 4096, cudaHostAllocDefault);
+    if (status) goto fail;
+    status = cudaHostAlloc((void **)&ibgda_ft.mbox_h,
+                           NVSHMEMI_IBGDA_FT_NSLOTS * sizeof(nvshmemi_ibgda_ft_record_t),
+                           cudaHostAllocMapped);
+    if (status) goto fail;
+    memset(ibgda_ft.mbox_h, 0, NVSHMEMI_IBGDA_FT_NSLOTS * sizeof(nvshmemi_ibgda_ft_record_t));
+    status = cudaHostGetDevicePointer((void **)&ibgda_ft.mbox_d, ibgda_ft.mbox_h, 0);
+    if (status) goto fail;
+    status = cudaMalloc((void **)&ibgda_ft.dev_d, sizeof(nvshmemi_ibgda_ft_dev_t));
+    if (status) goto fail;
+    {
+        nvshmemi_ibgda_ft_dev_t h;
+        memset(&h, 0, sizeof(h));
+        h.mbox = ibgda_ft.mbox_d;
+        h.nslots = NVSHMEMI_IBGDA_FT_NSLOTS;
+        h.flags = ibgda_ft.flags;
+        h.test_trip = (ibgda_ft.flags & NVSHMEMI_IBGDA_FT_FLAG_TEST_TRIP) ? trip_n : 0;
+        h.test_trip_mode = (ibgda_ft.flags & NVSHMEMI_IBGDA_FT_FLAG_TEST_TRIP) ? trip_mode : 0;
+        status = cudaMemcpy(ibgda_ft.dev_d, &h, sizeof(h), cudaMemcpyHostToDevice);
+        if (status) goto fail;
+    }
+    if (ibgda_ft.ring) {
+        /* v2.1: the no-lap argument (DESIGN of ibgda_ft_ring_poll) needs nwqes <= ncqes for every
+         * send queue; both are round_up_pow2(QP_DEPTH) here. Checked, not assumed. */
+        for (int i = 0; i < st->n_devs_selected; i++) {
+            struct ibgda_device *device =
+                (struct ibgda_device *)st->common.devices + st->selected_dev_ids[i];
+            for (int e = 0; e < device->rc.num_eps_per_pe * t->n_pes; e++) {
+                struct ibgda_ep *ep = device->rc.eps ? device->rc.eps[e] : NULL;
+                if (ep && ep->send_cq && ep->sq_cnt > ep->send_cq->num_cqe) {
+                    status = -2;
+                    goto fail;
+                }
+            }
+            for (int e = 0; e < device->dci.num_eps; e++) {
+                struct ibgda_ep *ep = device->dci.eps ? device->dci.eps[e] : NULL;
+                if (ep && ep->send_cq && ep->sq_cnt > ep->send_cq->num_cqe) {
+                    status = -2;
+                    goto fail;
+                }
+            }
+        }
+    }
+    dstate->ft = ibgda_ft.dev_d;
+    dstate->ft_flags = ibgda_ft.flags;
+    ibgda_ft.enabled = true;
+    {
+        /* v2 (B): table from the heap snapshot the host library published before connect */
+        std::lock_guard<std::mutex> g(ibgda_ft.heap_mu);
+        if (ibgda_ft_bounds_upload(dstate) < 0) {
+            status = -1;
+            ibgda_ft.enabled = false;
+            goto fail;
+        }
+    }
+    /* T1 (NVSHMEM_IBGDA_FT_TRANSPARENT=1): gates, sockets, helper; adds FLAG_T1. Last, after every
+     * FT resource exists (nothing below can fail). */
+    t1_init(t, st, dstate);
+    ibgda_ft.stop.store(false);
+    ibgda_ft.watcher = std::thread(ibgda_ft_watcher_main);
+    fprintf(stderr,
+            "[nvshmem-ft] PE%d enabled: classifier=%s mailbox=%d x %zu B poll_us=%d handler=%s "
+            "recovery=%s rc_per_pe=%d ring_cq=%d bounds=%d(%s, %u granules, %zu chunks, %u snapshots) "
+            "test_skip=0x%x test_trip=%s:%u sq=%u cq=%u park=%d\n",
+            t->my_pe,
+            ibgda_ft.ring ? "ring-walk"
+            : (ibgda_ft.flags & NVSHMEMI_IBGDA_FT_FLAG_CAPTURE_EXIT) ? "exit-only(diag)" : "in-loop",
+            NVSHMEMI_IBGDA_FT_NSLOTS, sizeof(nvshmemi_ibgda_ft_record_t), ibgda_ft.poll_us,
+            ibgda_nic_handler == IBGDA_NIC_HANDLER_GPU ? "GPU" : "CPU-proxy",
+            ibgda_nic_handler == IBGDA_NIC_HANDLER_GPU ? "available" : "declined (CPU-proxy handler)",
+            st->common.options->IBGDA_NUM_RC_PER_PE, ibgda_ft.ring ? 1 : 0, ibgda_ft.bounds ? 1 : 0,
+            !ibgda_ft.bounds ? "off" : dstate->ft_obj_ngran ? "chunk table" : "heap-level until the "
+                                                                               "first snapshot",
+            dstate->ft_obj_ngran, ibgda_ft.heap_off.size(), ibgda_ft.heap_updates, ibgda_ft.skip,
+            !(ibgda_ft.flags & NVSHMEMI_IBGDA_FT_FLAG_TEST_TRIP) ? "off"
+            : trip_mode == 2                                     ? "ring_d_silent"
+                                                                 : "ring_d",
+            (ibgda_ft.flags & NVSHMEMI_IBGDA_FT_FLAG_TEST_TRIP) ? trip_n : 0,
+            (unsigned)ibgda_round_up_pow2_or_0(ibgda_qp_depth),
+            (unsigned)ibgda_round_up_pow2_or_0(ibgda_qp_depth),
+            (ibgda_ft.flags & NVSHMEMI_IBGDA_FT_FLAG_PARK) ? 1 : 0);
+    return 0;
+fail:
+    fprintf(stderr, "[nvshmem-ft] PE%d init failed (cuda %d); FT stays off\n", t->my_pe, status);
+    dstate->ft = NULL;
+    dstate->ft_flags = 0;
+    dstate->ft_obj_end = NULL;
+    dstate->ft_obj_ngran = 0;
+    /* v2: ring CQs cannot be polled by the stock (collapsed) device code: fail the connect. */
+    return ibgda_ft.ring ? NVSHMEMX_ERROR_INTERNAL : 0;
+}
+
+static void ibgda_ft_fini(nvshmemi_ibgda_device_state_t *dstate) {
+    if (!ibgda_ft.enabled) return;
+    t1_fini();
+    ibgda_ft.stop.store(true);
+    if (ibgda_ft.watcher.joinable()) ibgda_ft.watcher.join();
+    ibgda_ft.enabled = false;
+    if (dstate) {
+        dstate->ft = NULL;
+        dstate->ft_flags = 0;
+        dstate->ft_obj_end = NULL;
+        dstate->ft_obj_ngran = 0;
+    }
+    {
+        std::lock_guard<std::mutex> g(ibgda_ft.heap_mu);
+        if (ibgda_ft.obj_tbl_d) cudaFree(ibgda_ft.obj_tbl_d);
+        ibgda_ft.obj_tbl_d = NULL;
+        ibgda_ft.obj_ngran = 0;
+    }
+    if (ibgda_ft.dev_d) cudaFree(ibgda_ft.dev_d);
+    if (ibgda_ft.mbox_h) cudaFreeHost(ibgda_ft.mbox_h);
+    if (ibgda_ft.pinned) cudaFreeHost(ibgda_ft.pinned);
+    if (ibgda_ft.stream) cudaStreamDestroy(ibgda_ft.stream);
+    ibgda_ft.dev_d = NULL;
+    ibgda_ft.mbox_h = NULL;
+    ibgda_ft.pinned = NULL;
+    ibgda_ft.stream = 0;
+}
+
+/* RC endpoints to `peer`, in (device, slot) order: the same order on both sides. */
+static int ibgda_ft_rc_eps(int peer, struct ibgda_ep **eps, struct ibgda_device **devs, int max) {
+    nvshmemt_ibgda_state_t *st = ibgda_ft.st;
+    int n_pes = ibgda_ft.t->n_pes, n = 0;
+    for (int i = 0; i < st->n_devs_selected; i++) {
+        struct ibgda_device *device =
+            (struct ibgda_device *)st->common.devices + st->selected_dev_ids[i];
+        for (int e = 0; e < device->rc.num_eps_per_pe * n_pes; e++) {
+            if (e % n_pes != peer) continue;
+            struct ibgda_ep *ep = device->rc.eps ? device->rc.eps[e] : NULL;
+            if (!ep) continue;
+            if (n >= max) return -1;
+            eps[n] = ep;
+            devs[n] = device;
+            n++;
+        }
+    }
+    return n;
+}
+
+/* Copy one QP's device management variables to the host (non-blocking stream). */
+static int ibgda_ft_read_mvars(nvshmemi_ibgda_device_qp_t *qp_d,
+                               nvshmemi_ibgda_device_qp_management_t *out) {
+    int s = cudaMemcpyAsync(ibgda_ft.pinned, &qp_d->mvars, sizeof(*out), cudaMemcpyDeviceToHost,
+                            ibgda_ft.stream);
+    if (!s) s = cudaStreamSynchronize(ibgda_ft.stream);
+    if (!s) memcpy(out, ibgda_ft.pinned, sizeof(*out));
+    return s;
+}
+
+/* v2 (A): QUERY_CQ -> producer counter (24 bits). Returns the DEVX status. */
+static int ibgda_ft_query_cq_pi(struct ibgda_cq *cq, uint32_t *pi) {
+    uint8_t cmd_in[DEVX_ST_SZ_BYTES(ibgda_fi_query_cq_in)] = {0};
+    uint8_t cmd_out[DEVX_ST_SZ_BYTES(ibgda_fi_query_cq_out)] = {0};
+    DEVX_SET(ibgda_fi_query_cq_in, cmd_in, opcode, MLX5_CMD_OP_QUERY_CQ);
+    DEVX_SET(ibgda_fi_query_cq_in, cmd_in, cqn, cq->cqn);
+    int st = mlx5dv_devx_obj_query(cq->devx_cq, cmd_in, sizeof(cmd_in), cmd_out, sizeof(cmd_out));
+    void *cqc = DEVX_ADDR_OF(ibgda_fi_query_cq_out, cmd_out, cq_context);
+    *pi = DEVX_GET(cqc, cqc, producer_counter);
+    return st;
+}
+
+/* v2 (A): the device consumer counter a ring CQ must restart from after its QP was reset. The
+ * NIC's producer counter keeps running across a QP reset (the CQ is not reset), so the counter
+ * is set to it: QUERY_CQ producer_counter, cross-checked against a host scan of the ring from
+ * the old counter (the unconsumed CQEs: the error CQE and its flushes). Returns 0 and *new_ci. */
+static int ibgda_ft_ring_resume_ci(struct ibgda_ep *ep, uint64_t ci_old, uint64_t *new_ci,
+                                   uint32_t *scan_out, uint32_t *pi_out) {
+    struct ibgda_cq *cq = ep->send_cq;
+    const uint32_t n = cq->num_cqe;
+    std::vector<uint8_t> buf((size_t)n * NVSHMEMI_IBGDA_CQE_SIZE);
+    int s = cudaMemcpyAsync(buf.data(), cq->cq_mobject->aligned.gpu_ptr, buf.size(),
+                            cudaMemcpyDeviceToHost, ibgda_ft.stream);
+    if (!s) s = cudaStreamSynchronize(ibgda_ft.stream);
+    if (s) return -1;
+    uint32_t scan = 0;
+    while (scan < n) {
+        const uint64_t c = ci_old + scan;
+        const uint8_t opown = buf[(size_t)(c & (n - 1)) * NVSHMEMI_IBGDA_CQE_SIZE + 63];
+        if ((opown >> 4) == 0xf || (uint32_t)(opown & 1) != ((c & n) ? 1u : 0u)) break;
+        scan++;
+    }
+    uint32_t pi = 0;
+    if (ibgda_ft_query_cq_pi(cq, &pi)) return -2;
+    const uint32_t ahead = (pi - (uint32_t)ci_old) & 0xffffffu; /* CQEs produced since ci_old */
+    *scan_out = scan;
+    *pi_out = pi;
+    /* The scan cannot see more than one lap; QUERY_CQ must agree with it unless the ring wrapped
+     * (then only QUERY_CQ is right, and it is used). */
+    if (ahead < scan || ahead > (1u << 22)) return -3;
+    *new_ci = (ibgda_ft.skip & NVSHMEMI_IBGDA_FT_SKIP_RINGCI) ? 0 : ci_old + ahead;
+    return 0;
+}
+
+/* Device-side resync of one QP while it is in RESET: refill its collapsed CQ with the creation
+ * pattern (0xff: opcode invalid, wqe_counter 0xffff), zero its doorbell record, then zero its
+ * management variables (indices, lock, FT sticky record) = the state ibgda_get_device_qp_mvars
+ * gives a new QP. The CQ goes first so that a sentinel never sees a stale error CQE together with
+ * a cleared sticky record.
+ * v2: ring mode (A) restarts the ring consumer counter at the CQ's producer counter instead of 0
+ * (read before the refill); the test-only knobs (C) skip single steps. */
+#define IBGDA_FT_SKIP_MVARS                                                           \
+    (NVSHMEMI_IBGDA_FT_SKIP_IDX | NVSHMEMI_IBGDA_FT_SKIP_LOCK | NVSHMEMI_IBGDA_FT_SKIP_IBUF | \
+     NVSHMEMI_IBGDA_FT_SKIP_STICKY)
+static int ibgda_ft_resync_qp(struct ibgda_ep *ep, nvshmemi_ibgda_device_qp_t *qp_d,
+                              uint64_t *ring_ci_old = NULL, uint32_t *ring_scan = NULL,
+                              uint32_t *ring_pi = NULL) {
+    const uint32_t skip = ibgda_ft.skip;
+    const bool host_built = ibgda_ft.ring || (skip & IBGDA_FT_SKIP_MVARS);
+    nvshmemi_ibgda_device_qp_management_t m;
+    uint64_t new_ci = 0;
+    int s = 0;
+    if (host_built) {
+        if (ibgda_ft_read_mvars(qp_d, &m)) return -1;
+        if (ibgda_ft.ring) {
+            uint32_t scan = 0, pi = 0;
+            int r = ibgda_ft_ring_resume_ci(ep, m.ft_ring_ci, &new_ci, &scan, &pi);
+            if (ring_ci_old) *ring_ci_old = m.ft_ring_ci;
+            if (ring_scan) *ring_scan = scan;
+            if (ring_pi) *ring_pi = pi;
+            if (r) {
+                fprintf(stderr, "[nvshmem-ft] PE%d ring resync of qpn 0x%x failed (%d): ci=%llu scan=%u "
+                                "cq_pi=%u\n", ibgda_ft.t->my_pe, ep->qpn, r,
+                        (unsigned long long)m.ft_ring_ci, scan, pi);
+                return -2;
+            }
+        }
+    }
+    if (!(skip & NVSHMEMI_IBGDA_FT_SKIP_CQFILL))
+        s = cudaMemsetAsync(ep->send_cq->cq_mobject->base.gpu_ptr, 0xff,
+                            ep->send_cq->cq_mobject->base.size, ibgda_ft.stream);
+    if (!s && !(skip & NVSHMEMI_IBGDA_FT_SKIP_DBR))
+        s = cudaMemsetAsync((char *)ep->qp_ctrl.dbr_mobject->aligned.gpu_ptr + ep->qp_ctrl.dbr_offset,
+                            0, IBGDA_DBRSIZE, ibgda_ft.stream);
+    if (!s) s = cudaStreamSynchronize(ibgda_ft.stream);
+    if (!s && !host_built)
+        s = cudaMemsetAsync(&qp_d->mvars, 0, sizeof(nvshmemi_ibgda_device_qp_management_t),
+                            ibgda_ft.stream);
+    if (!s && host_built) {
+        nvshmemi_ibgda_device_qp_management_t z;
+        memset(&z, 0, sizeof(z)); /* = ibgda_get_device_qp_mvars (setup), then the kept fields */
+        if (skip & NVSHMEMI_IBGDA_FT_SKIP_IDX) z.tx_wq = m.tx_wq;
+        if (skip & NVSHMEMI_IBGDA_FT_SKIP_LOCK) z.post_send_lock = m.post_send_lock;
+        if (skip & NVSHMEMI_IBGDA_FT_SKIP_IBUF) z.ibuf = m.ibuf;
+        if (skip & NVSHMEMI_IBGDA_FT_SKIP_STICKY) {
+            z.ft_state = m.ft_state;
+            z.ft_fp = m.ft_fp;
+            z.ft_wqe = m.ft_wqe;
+            z.ft_aux = m.ft_aux;
+        }
+        z.ft_ring_ci = new_ci;
+        memcpy(ibgda_ft.pinned, &z, sizeof(z));
+        s = cudaMemcpyAsync(&qp_d->mvars, ibgda_ft.pinned, sizeof(z), cudaMemcpyHostToDevice,
+                            ibgda_ft.stream);
+    }
+    if (!s) s = cudaStreamSynchronize(ibgda_ft.stream);
+    return s;
+}
+
+static bool ibgda_ft_quiescent(const nvshmemi_ibgda_device_qp_management_t *m) {
+    /* v2.1: a parked QP (bit 63 of prod_idx set) has rung nothing since its error was recorded;
+     * every WQE the device made ready was either rung before (index <= prod) or dropped. */
+    const uint64_t prod = m->tx_wq.prod_idx & ~NVSHMEMI_IBGDA_FT_PARK_MARK;
+    const bool parked = (m->tx_wq.prod_idx & NVSHMEMI_IBGDA_FT_PARK_MARK) != 0;
+    return m->post_send_lock == 0 && m->tx_wq.resv_head == m->tx_wq.ready_head &&
+           (parked ? prod <= m->tx_wq.ready_head : m->tx_wq.ready_head == prod) &&
+           m->ibuf.head == m->ibuf.tail;
+}
+
+extern "C" __attribute__((visibility("default"))) int nvshmemt_ibgda_ft_enabled(void) {
+    return ibgda_ft.enabled ? NVSHMEMT_IBGDA_FT_API_VERSION : 0;
+}
+
+extern "C" __attribute__((visibility("default"))) uint32_t nvshmemt_ibgda_ft_commits(void) {
+    return ibgda_ft.commits.load();
+}
+
+/* 1 and *out filled if an unrecovered error record exists (waits up to wait_ms for one). */
+extern "C" __attribute__((visibility("default"))) int nvshmemt_ibgda_ft_query(
+    nvshmemt_ibgda_ft_info_t *out, int wait_ms) {
+    if (!ibgda_ft.enabled) return -1;
+    double t0 = ibgda_ft_mono_ms();
+    for (;;) {
+        if (ibgda_ft.have_error.load()) {
+            std::lock_guard<std::mutex> g(ibgda_ft.mu);
+            if (out) {
+                *out = ibgda_ft.first;
+                /* v2.1: fetches that returned the poison value so far (ibgda_ft_fetch_check) */
+                uint32_t np = 0;
+                if (cudaMemcpyAsync(&np, &ibgda_ft.dev_d->fetch_poisoned, sizeof(np),
+                                    cudaMemcpyDeviceToHost, ibgda_ft.stream) == cudaSuccess &&
+                    cudaStreamSynchronize(ibgda_ft.stream) == cudaSuccess)
+                    out->fetch_poisoned = np;
+            }
+            return 1;
+        }
+        if (ibgda_ft_mono_ms() - t0 >= wait_ms) break;
+        std::this_thread::sleep_for(std::chrono::microseconds(20));
+    }
+    if (out) memset(out, 0, sizeof(*out));
+    return 0;
+}
+
+extern "C" __attribute__((visibility("default"))) int nvshmemt_ibgda_ft_mark_failed(void) {
+    if (!ibgda_ft.t) return -1;
+    ibgda_ft_set_failed("application");
+    return 0;
+}
+
+/* Stop a running device sentinel (see nvshmemx_ibgda_ft_sentinel); waits up to wait_ms. */
+extern "C" __attribute__((visibility("default"))) int nvshmemt_ibgda_ft_sentinel_stop(int wait_ms,
+                                                                                    uint64_t *polls) {
+    if (!ibgda_ft.enabled) return -1;
+    uint32_t one = 1;
+    memcpy(ibgda_ft.pinned, &one, sizeof(one));
+    int s = cudaMemcpyAsync(&ibgda_ft.dev_d->sentinel_stop, ibgda_ft.pinned, sizeof(one),
+                            cudaMemcpyHostToDevice, ibgda_ft.stream);
+    if (!s) s = cudaStreamSynchronize(ibgda_ft.stream);
+    double t0 = ibgda_ft_mono_ms();
+    nvshmemi_ibgda_ft_dev_t h;
+    do {
+        s = cudaMemcpyAsync(ibgda_ft.pinned, ibgda_ft.dev_d, sizeof(h), cudaMemcpyDeviceToHost,
+                            ibgda_ft.stream);
+        if (!s) s = cudaStreamSynchronize(ibgda_ft.stream);
+        memcpy(&h, ibgda_ft.pinned, sizeof(h));
+        if (s || h.sentinel_running == 0) break;
+        std::this_thread::sleep_for(std::chrono::microseconds(100));
+    } while (ibgda_ft_mono_ms() - t0 < wait_ms);
+    if (polls) *polls = h.sentinel_polls;
+    return (s == 0 && h.sentinel_running == 0) ? 0 : -1;
+}
+
+/* Prepare: pause nothing (the GPU handler has no proxy); check that the device is quiescent on
+ * every RC QP to `peer`, move them to ERR, wait until the NIC has flushed every posted WQE, draw
+ * fresh send PSNs. Returns 0 and the local token, or <0 (decline; QPs possibly left in ERR). */
+extern "C" __attribute__((visibility("default"))) int nvshmemt_ibgda_ft_prepare(
+    int peer, nvshmemt_ibgda_ft_token_t *tok, nvshmemt_ibgda_ft_stats_t *stats) {
+    nvshmemt_ibgda_ft_stats_t lst;
+    nvshmemt_ibgda_ft_stats_t *S = stats ? stats : &lst;
+    memset(S, 0, sizeof(*S));
+    if (!ibgda_ft.enabled) return -1;
+    if (t1_active()) return -1; /* T1: the library runs recovery itself */
+    if (ibgda_nic_handler != IBGDA_NIC_HANDLER_GPU) {
+        snprintf(S->msg, sizeof(S->msg), "declined: recovery needs the GPU NIC handler");
+        return -2;
+    }
+    if (peer < 0 || peer >= ibgda_ft.t->n_pes || peer == ibgda_ft.t->my_pe) return -3;
+    std::lock_guard<std::mutex> opg(ibgda_ft.op_mu);
+    std::lock_guard<std::mutex> lk(ibgda_ft.st->rc_endpoint_lock);
+    double t0 = ibgda_ft_mono_ms();
+    nvshmemi_ibgda_device_state_t *dstate =
+        (nvshmemi_ibgda_device_state_t *)ibgda_ft.t->type_specific_shared_state;
+    struct ibgda_ep *eps[NVSHMEMT_IBGDA_FT_MAX_QPS];
+    struct ibgda_device *devs[NVSHMEMT_IBGDA_FT_MAX_QPS];
+    int n = ibgda_ft_rc_eps(peer, eps, devs, NVSHMEMT_IBGDA_FT_MAX_QPS);
+    if (n <= 0) {
+        snprintf(S->msg, sizeof(S->msg), "declined: %s RC QPs to PE %d",
+                 n == 0 ? "no" : "too many", peer);
+        return -4;
+    }
+    nvshmemi_ibgda_device_qp_management_t mv[NVSHMEMT_IBGDA_FT_MAX_QPS];
+    for (int i = 0; i < n; i++) {
+        if (ibgda_ft_read_mvars(&dstate->globalmem.rcs[eps[i]->user_index], &mv[i])) return -5;
+        if (!ibgda_ft_quiescent(&mv[i])) {
+            snprintf(S->msg, sizeof(S->msg),
+                     "declined: QP 0x%x not quiescent (lock=%d resv=%llu ready=%llu prod=%llu "
+                     "parked=%d ibuf %llu/%llu)",
+                     eps[i]->qpn, mv[i].post_send_lock, (unsigned long long)mv[i].tx_wq.resv_head,
+                     (unsigned long long)mv[i].tx_wq.ready_head,
+                     (unsigned long long)(mv[i].tx_wq.prod_idx & ~NVSHMEMI_IBGDA_FT_PARK_MARK),
+                     (mv[i].tx_wq.prod_idx & NVSHMEMI_IBGDA_FT_PARK_MARK) ? 1 : 0,
+                     (unsigned long long)mv[i].ibuf.head, (unsigned long long)mv[i].ibuf.tail);
+            return -6;
+        }
+        /* v2.1: 64-bit index without the park mark (API 3; was truncated to 32 bits, and a parked
+         * QP then read 0), plus a parked bit. */
+        S->prod_idx[i] = mv[i].tx_wq.prod_idx & ~NVSHMEMI_IBGDA_FT_PARK_MARK;
+        if (mv[i].tx_wq.prod_idx & NVSHMEMI_IBGDA_FT_PARK_MARK) S->parked_mask |= 1u << i;
+        ibgda_ft_query_qp(eps[i]->devx_qp, eps[i]->qpn, &S->qp_state[i], NULL, NULL);
+    }
+    /* No old-incarnation WQE may execute after this: every QP of the pair goes to ERR. */
+    for (int i = 0; i < n; i++) {
+        if (S->qp_state[i] != 6 && ibgda_ft_qp_cmd(eps[i]->devx_qp, eps[i]->qpn, MLX5_CMD_OP_2ERR_QP))
+            return -7;
+    }
+    double t1 = ibgda_ft_mono_ms();
+    S->to_err_ms = t1 - t0;
+    /* Drain: the NIC flushes [consumer, P) after the ERR transition, P = the send word of the
+     * doorbell record (../nvshmem_rootcause); wait until its consumer reached P. v2.1: P is read
+     * from the record, not taken from the device producer index: they are equal unless the QP was
+     * parked (FT_FLAG_PARK), when posts after the error were counted but never rung. */
+    uint32_t dbr_sq[NVSHMEMT_IBGDA_FT_MAX_QPS];
+    for (int i = 0; i < n; i++) {
+        uint32_t w[2] = {0, 0};
+        if (cudaMemcpyAsync(ibgda_ft.pinned,
+                            (char *)eps[i]->qp_ctrl.dbr_mobject->aligned.gpu_ptr + eps[i]->qp_ctrl.dbr_offset,
+                            sizeof(w), cudaMemcpyDeviceToHost, ibgda_ft.stream) ||
+            cudaStreamSynchronize(ibgda_ft.stream))
+            return -5;
+        memcpy(w, ibgda_ft.pinned, sizeof(w));
+        dbr_sq[i] = be32toh(w[1]) & 0xffff; /* word 1 = send producer (GPU handler) */
+    }
+    int drained = 0;
+    uint32_t last_hw = 0, last_sw = 0;
+    for (;;) {
+        drained = 1;
+        for (int i = 0; i < n; i++) {
+            uint32_t s = 0, hw = 0, sw = 0;
+            ibgda_ft_query_qp(eps[i]->devx_qp, eps[i]->qpn, &s, &hw, &sw);
+            if (s != 6 || hw != dbr_sq[i]) drained = 0;
+            if (i == 0) {
+                last_hw = hw;
+                last_sw = sw;
+            }
+        }
+        if (drained || ibgda_ft_mono_ms() - t1 > ibgda_ft.drain_ms) break;
+        std::this_thread::sleep_for(std::chrono::microseconds(50));
+    }
+    double t2 = ibgda_ft_mono_ms();
+    S->drain_ms = t2 - t1;
+    S->drained = drained;
+    if (!drained) {
+        uint32_t cq_pi = 0;
+        ibgda_ft_query_cq_pi(eps[0]->send_cq, &cq_pi);
+        snprintf(S->msg, sizeof(S->msg),
+                 "declined: NIC did not flush every posted WQE in %d ms (hw_sq %u sw_sq %u dbr %u "
+                 "ready16 %u prod %llu cq_pi %u ring_ci %llu parked %d)",
+                 ibgda_ft.drain_ms, last_hw, last_sw, dbr_sq[0],
+                 (unsigned)(mv[0].tx_wq.ready_head & 0xffff),
+                 (unsigned long long)(mv[0].tx_wq.prod_idx & ~NVSHMEMI_IBGDA_FT_PARK_MARK), cq_pi,
+                 (unsigned long long)mv[0].ft_ring_ci,
+                 (mv[0].tx_wq.prod_idx & NVSHMEMI_IBGDA_FT_PARK_MARK) ? 1 : 0);
+        return -8;
+    }
+    std::random_device rd;
+    tok->magic = NVSHMEMT_IBGDA_FT_TOKEN_MAGIC;
+    tok->nqps = n;
+    tok->pe = ibgda_ft.t->my_pe;
+    tok->peer = peer;
+    ibgda_ft_prep &p = ibgda_ft.prep[peer];
+    p.nqps = n;
+    for (int i = 0; i < n; i++) {
+        uint32_t psn = ((uint32_t)rd() ^ ((uint32_t)rd() << 7)) & 0xffffff;
+        if (ibgda_ft.skip & NVSHMEMI_IBGDA_FT_SKIP_PSN) psn = 0; /* v2 (C) test-only: stock PSN */
+        p.sq_psn[i] = psn;
+        tok->qp[i].qpn = eps[i]->qpn;
+        tok->qp[i].peer_qpn = eps[i]->ft_peer.qpn;
+        tok->qp[i].sq_psn = psn;
+        tok->qp[i].prod_idx = mv[i].tx_wq.prod_idx & ~NVSHMEMI_IBGDA_FT_PARK_MARK;
+        tok->qp[i].parked = (mv[i].tx_wq.prod_idx & NVSHMEMI_IBGDA_FT_PARK_MARK) ? 1u : 0u;
+    }
+    p.prepared = true;
+    S->nqps = n;
+    S->prepare_ms = ibgda_ft_mono_ms() - t0;
+    snprintf(S->msg, sizeof(S->msg), "prepared %d QP(s)", n);
+    return 0;
+}
+
+/* Reset one DCI of this PE that is not in RTS (local only: DCIs have no fixed peer). */
+static int ibgda_ft_reset_dci(struct ibgda_device *device, struct ibgda_ep *ep,
+                              nvshmemi_ibgda_device_qp_t *qp_d) {
+    nvshmemt_ibgda_state_t *st = ibgda_ft.st;
+    nvshmemi_ibgda_device_qp_management_t m;
+    if (ibgda_ft_read_mvars(qp_d, &m)) return -1;
+    if (!ibgda_ft_quiescent(&m)) return -2;
+    if (ibgda_ft_qp_cmd(ep->devx_qp, ep->qpn, MLX5_CMD_OP_2RST_QP)) return -3;
+    if (ibgda_ft_resync_qp(ep, qp_d)) return -4;
+    if (ibgda_qp_rst2init(st, ep, device, ep->portid)) return -5;
+    if (ibgda_dci_init2rtr(st, ep, device, ep->portid)) return -6;
+    if (ibgda_qp_rtr2rts(st, ep, device, 0)) return -7;
+    return 0;
+}
+
+/* Commit: with the peer's token, reset every RC QP to `peer` (RESET, device resync, INIT, RTR with
+ * rq_psn = peer's new sq_psn, RTS with our new sq_psn), reset any local DCI left in ERR, clear the
+ * FT error state. On failure the QPs are left in ERR or RESET (declined). */
+extern "C" __attribute__((visibility("default"))) int nvshmemt_ibgda_ft_commit(
+    int peer, const nvshmemt_ibgda_ft_token_t *remote, nvshmemt_ibgda_ft_stats_t *stats) {
+    nvshmemt_ibgda_ft_stats_t lst;
+    nvshmemt_ibgda_ft_stats_t *S = stats ? stats : &lst;
+    if (!ibgda_ft.enabled) return -1;
+    if (t1_active()) return -1; /* T1: the library runs recovery itself */
+    if (peer < 0 || peer >= ibgda_ft.t->n_pes) return -3;
+    int rc = 0;
+    {
+        std::lock_guard<std::mutex> opg(ibgda_ft.op_mu);
+        std::lock_guard<std::mutex> lk(ibgda_ft.st->rc_endpoint_lock);
+        nvshmemt_ibgda_state_t *st = ibgda_ft.st;
+        ibgda_ft_prep &p = ibgda_ft.prep[peer];
+        nvshmemi_ibgda_device_state_t *dstate =
+            (nvshmemi_ibgda_device_state_t *)ibgda_ft.t->type_specific_shared_state;
+        struct ibgda_ep *eps[NVSHMEMT_IBGDA_FT_MAX_QPS];
+        struct ibgda_device *devs[NVSHMEMT_IBGDA_FT_MAX_QPS];
+        int n = ibgda_ft_rc_eps(peer, eps, devs, NVSHMEMT_IBGDA_FT_MAX_QPS);
+        if (!p.prepared) {
+            snprintf(S->msg, sizeof(S->msg), "declined: commit without prepare");
+            return -10;
+        }
+        if (!remote || remote->magic != NVSHMEMT_IBGDA_FT_TOKEN_MAGIC || (int)remote->nqps != n ||
+            remote->pe != peer || remote->peer != ibgda_ft.t->my_pe || n != (int)p.nqps) {
+            snprintf(S->msg, sizeof(S->msg), "declined: token mismatch");
+            return -11;
+        }
+        for (int i = 0; i < n; i++) {
+            if (remote->qp[i].qpn != eps[i]->ft_peer.qpn || remote->qp[i].peer_qpn != eps[i]->qpn) {
+                snprintf(S->msg, sizeof(S->msg), "declined: QPN mismatch at %d (0x%x/0x%x)", i,
+                         remote->qp[i].qpn, remote->qp[i].peer_qpn);
+                return -12;
+            }
+        }
+        double t0 = ibgda_ft_mono_ms();
+        for (int i = 0; i < n; i++)
+            if (ibgda_ft_qp_cmd(eps[i]->devx_qp, eps[i]->qpn, MLX5_CMD_OP_2RST_QP)) return -13;
+        double t1 = ibgda_ft_mono_ms();
+        S->skip_mask = ibgda_ft.skip;
+        for (int i = 0; i < n; i++)
+            if (ibgda_ft_resync_qp(eps[i], &dstate->globalmem.rcs[eps[i]->user_index],
+                                   &S->ring_ci_old[i], &S->ring_scan[i], &S->ring_pi[i])) {
+                snprintf(S->msg, sizeof(S->msg), "declined: device resync of QP 0x%x failed%s",
+                         eps[i]->qpn, ibgda_ft.ring ? " (ring counter)" : "");
+                return -14;
+            }
+        double t2 = ibgda_ft_mono_ms();
+        for (int i = 0; i < n; i++) {
+            struct ibgda_ep *ep = eps[i];
+            struct ibgda_rc_handle h;
+            memset(&h, 0, sizeof(h));
+            h.qpn = ep->ft_peer.qpn;
+            h.lid = ep->ft_peer.lid;
+            h.spn = ep->ft_peer.spn;
+            h.iid = ep->ft_peer.iid;
+            if (ep->ah) { /* init2rtr creates a fresh AH from the same attributes */
+                ftable.destroy_ah(ep->ah);
+                ep->ah = NULL;
+            }
+            if (ibgda_qp_rst2init(st, ep, devs[i], ep->portid)) return -15;
+            if (ibgda_rc_init2rtr(st, ep, devs[i], ep->portid, &h, remote->qp[i].sq_psn)) return -16;
+            if (ibgda_qp_rtr2rts(st, ep, devs[i], p.sq_psn[i])) return -17;
+        }
+        double t3 = ibgda_ft_mono_ms();
+        /* Local DCIs left in ERR (the fault hook moves every QP of the PE). */
+        S->ndci_reset = 0;
+        for (int d = 0; d < st->n_devs_selected && !(ibgda_ft.skip & NVSHMEMI_IBGDA_FT_SKIP_DCI);
+             d++) {
+            struct ibgda_device *device =
+                (struct ibgda_device *)st->common.devices + st->selected_dev_ids[d];
+            for (int e = 0; e < device->dci.num_eps; e++) {
+                struct ibgda_ep *ep = device->dci.eps ? device->dci.eps[e] : NULL;
+                if (!ep || !ep->devx_qp) continue;
+                uint32_t s = 0;
+                ibgda_ft_query_qp(ep->devx_qp, ep->qpn, &s, NULL, NULL);
+                if (s == 3) continue;
+                int r = ibgda_ft_reset_dci(device, ep,
+                                           &dstate->globalmem.dcis[e * st->n_devs_selected + d]);
+                if (r) {
+                    fprintf(stderr, "[nvshmem-ft] PE%d DCI 0x%x reset failed (%d)\n",
+                            ibgda_ft.t->my_pe, ep->qpn, r);
+                    return -18;
+                }
+                S->ndci_reset++;
+            }
+        }
+        /* Clear the device error counter and the host record. */
+        if (!(ibgda_ft.skip & NVSHMEMI_IBGDA_FT_SKIP_NERR)) {
+            uint32_t z = 0;
+            memcpy(ibgda_ft.pinned, &z, sizeof(z));
+            if (cudaMemcpyAsync(&ibgda_ft.dev_d->nerr, ibgda_ft.pinned, sizeof(z),
+                                cudaMemcpyHostToDevice, ibgda_ft.stream) ||
+                cudaStreamSynchronize(ibgda_ft.stream))
+                return -19;
+        }
+        if (!(ibgda_ft.skip & NVSHMEMI_IBGDA_FT_SKIP_NERR)) {
+            std::lock_guard<std::mutex> g(ibgda_ft.mu);
+            ibgda_ft.have_error.store(0);
+            memset(&ibgda_ft.first, 0, sizeof(ibgda_ft.first));
+        }
+        p.prepared = false;
+        S->rst_ms = t1 - t0;
+        S->resync_ms = t2 - t1;
+        S->connect_ms = t3 - t2;
+        S->commit_ms = ibgda_ft_mono_ms() - t0;
+        S->nqps = n;
+        snprintf(S->msg, sizeof(S->msg), "committed %d QP(s), %u DCI(s) reset", n, S->ndci_reset);
+        ibgda_ft.commits.fetch_add(1);
+    }
+    /* Test hook: a shot scheduled "inside the commit" fires now, after RTS (hits the replay). */
+    if (ibgda_ft.fire_in_commit.exchange(0)) {
+        fprintf(stderr, "[nvshmem-fault-inject] in-commit shot fire_mono_ms=%.3f\n", ibgda_ft_mono_ms());
+        ibgda_fi_all_qps_to_err(ibgda_ft.st, ibgda_ft.t->n_pes);
+    }
+    return rc;
+}
+
+/* Abort: forget a prepared recovery, leave the QPs in ERR and mark the transport failed so that
+ * teardown skips device collectives. */
+extern "C" __attribute__((visibility("default"))) int nvshmemt_ibgda_ft_abort(int peer) {
+    if (!ibgda_ft.enabled) return -1;
+    if (t1_active()) return -1; /* T1: the library runs recovery itself */
+    {
+        std::lock_guard<std::mutex> opg(ibgda_ft.op_mu);
+        if (peer >= 0 && peer < (int)ibgda_ft.prep.size()) ibgda_ft.prep[peer].prepared = false;
+        std::lock_guard<std::mutex> lk(ibgda_ft.st->rc_endpoint_lock);
+        struct ibgda_ep *eps[NVSHMEMT_IBGDA_FT_MAX_QPS];
+        struct ibgda_device *devs[NVSHMEMT_IBGDA_FT_MAX_QPS];
+        int n = peer >= 0 ? ibgda_ft_rc_eps(peer, eps, devs, NVSHMEMT_IBGDA_FT_MAX_QPS) : 0;
+        for (int i = 0; i < n; i++) {
+            uint32_t s = 0;
+            ibgda_ft_query_qp(eps[i]->devx_qp, eps[i]->qpn, &s, NULL, NULL);
+            if (s != 6) ibgda_ft_qp_cmd(eps[i]->devx_qp, eps[i]->qpn, MLX5_CMD_OP_2ERR_QP);
+        }
+    }
+    ibgda_ft_set_failed("recovery declined/aborted");
+    return 0;
+}
+/* ===================== end NVSHMEM_IBGDA_FT ===================== */
+
+/* ==========================================================================
+ * T1 (research): transparent recovery inside the library.
+ *
+ *   NVSHMEM_IBGDA_FT_TRANSPARENT=1   (needs NVSHMEM_IBGDA_FT=1, NVSHMEM_IBGDA_FT_RING_CQ=1, park, the
+ *                                    GPU NIC handler; every PE must set it)
+ *   NVSHMEM_IBGDA_FT_T1_HOLD_MS      bound of a device wait held across a recovery (60000; floor
+ *                                    max(ROUND_MS + 3 x HANDSHAKE, 2 x HANDSHAKE + GID_WAIT) + 5000 =
+ *                                    93000 by default: the hold starts at the device record, and rounds
+ *                                    serialize per process)
+ *   NVSHMEM_IBGDA_FT_T1_COPY_MS      bound of one device-state copy on the helper's stream (2000); a
+ *                                    copy that does not complete declines the round, and the decline
+ *                                    reaches held device waits through a host-mapped mirror word
+ *   NVSHMEM_IBGDA_FT_T1_ROUND_MS     watchdog: a round longer than this before its commit point is
+ *                                    declined (25000; floor QUIESCE + drain + HANDSHAKE + 2 x GID_WAIT
+ *                                    + 5000 = 73000 by default)
+ *   NVSHMEM_IBGDA_FT_T1_QUIESCE_MS   bound on device posters stopping (2000)
+ *   NVSHMEM_IBGDA_FT_T1_HANDSHAKE_MS bound on each handshake step with the peer (5000)
+ *   NVSHMEM_IBGDA_FT_T1_GID_WAIT_MS  bound on waiting for the local RoCE address to come back (30000)
+ *   NVSHMEM_IBGDA_FT_T1_IFNAME       interface of the library socket (default
+ *                                    NVSHMEM_BOOTSTRAP_UID_SOCK_IFNAME, else the first IPv4 one)
+ *   NVSHMEM_IBGDA_FT_T1_TEST_SKIP    test-only negative controls: remap (waiters keep the stale D
+ *                                    ticket), ring (no host doorbell for the re-post), rotate (the
+ *                                    send ring is not moved), prefix (re-post from the completed
+ *                                    index, ignoring the responder's executed count), gid (no GID
+ *                                    re-lookup)
+ *
+ * A helper thread per process owns recovery. The watcher hands it every device record of a gated
+ * RC QP (the application sees none of them). Policy: LOCAL_QP_ERR recover; RETRY_EXC recover
+ * unless the peer's library socket shows FIN (a socket lost with an error, reset or timeout, is a
+ * lost management path: it is re-dialed, and a fault while it is down declines as "OOB path down",
+ * not as the peer's death); everything else decline. The lower PE of a pair runs the initiator
+ * side (the higher PE asks it with NOTIFY). Local DCIs the fault left in ERR are reset before the
+ * commit point with host copies (no kernel launch), never fatally. A round (both sides):
+ *   quiesce (epoch odd, QPs to ERR, wait until no device thread is counted; held posters leave the
+ *   count) -> drain -> walk the unfinished WQEs [C, R) (only RDMA WRITE, non-fetching atomics, NOPs
+ *   may be re-posted) -> executed count of the peer's requests from this QP's rmsn (QUERY_QP) ->
+ *   REQ / ACK (counts, PSNs) -> 2RST -> GID re-lookup by value -> commit point (give-up handshake;
+ *   nothing device-visible is written before it) -> rebase: every index jumps to B (multiple of
+ *   65536 above every old index), the send ring rotates so that the first unexecuted WQE U is at
+ *   slot 0, ring CQ counter from QUERY_CQ -> INIT/RTR/RTS (fresh PSNs) -> re-post [U, R) with a
+ *   host doorbell -> new rmsn baseline -> publish {off, epoch} -> DONE (responder publishes after).
+ * Decline: QPs to ERR, gate FAILED (terminal), FAIL to the peer, host error record, transport
+ * marked failed (teardown skips device collectives).
+ * ========================================================================== */
+#include <sys/socket.h>
+#include <netinet/in.h>
+#include <netinet/tcp.h>
+#include <arpa/inet.h>
+#include <ifaddrs.h>
+#include <net/if.h>
+#include <poll.h>
+#include <fcntl.h>
+#include <deque>
+
+#ifndef MLX5_CMD_OP_RTS2RTS_QP
+#define MLX5_CMD_OP_RTS2RTS_QP 0x505
+#endif
+
+enum {
+    T1_SKIP_REMAP = 1 << 0,
+    T1_SKIP_RING = 1 << 1,
+    T1_SKIP_ROTATE = 1 << 2,
+    T1_SKIP_PREFIX = 1 << 3,
+    T1_SKIP_GID = 1 << 4,
+};
+
+enum { T1_M_HELLO = 1, T1_M_REQ, T1_M_ACK, T1_M_NACK, T1_M_DONE, T1_M_FAIL, T1_M_NOTIFY };
+#define T1_MAGIC 0x31544e56u /* "VNT1" */
+
+struct t1_msg {
+    uint32_t magic, type, from_pe, round;
+    int32_t cls, status;
+    uint32_t nqps, pad;
+    struct {
+        uint32_t qpn, peer_qpn, sq_psn, exec; /* exec: the peer's messages this QP executed */
+    } qp[NVSHMEMT_IBGDA_FT_MAX_QPS];
+    char text[160];
+    uint8_t reserved[512 - 32 - 16 * NVSHMEMT_IBGDA_FT_MAX_QPS - 160];
+};
+static_assert(sizeof(t1_msg) == 512, "t1_msg must be 512 B");
+
+struct t1_qpstate {
+    uint32_t epoch;  /* current stable epoch (even) */
+    uint64_t off;    /* gate->off of the current epoch */
+    uint64_t e0;     /* D index of the first WQE of the epoch */
+    uint32_t rmsn0;  /* this QP's rmsn at the start of the epoch */
+    bool failed;
+    int lost_scans;  /* idle scans that saw a sticky error without a mailbox record */
+};
+
+/* What one side learned about one QP during a round. */
+struct t1_qpround {
+    struct ibgda_ep *ep;
+    struct ibgda_device *dev;
+    uint32_t gi;                        /* gate / rcs index */
+    nvshmemi_ibgda_device_qp_management_t m;
+    nvshmemi_ibgda_ft_gate_t g;
+    uint64_t V, R, P, C;                /* reserved, ready, rung, completed (D indices) */
+    uint32_t nwqes;
+    std::vector<uint8_t> sq;            /* host copy of the send ring */
+    std::vector<uint64_t> wstart;       /* WQE starts in [C, R) */
+    std::vector<uint8_t> wbb, wmsg;     /* their WQEBBs and network messages */
+    uint64_t msgs_cr, xbb_cr;
+    uint32_t exec_peer;                 /* peer's messages this QP executed this epoch */
+    uint32_t sq_psn;
+    uint64_t U, B, delta;
+    uint64_t U_exec; /* executed prefix from the responder's count (U differs only with TEST_SKIP=prefix) */
+    uint64_t xbb_new;
+    bool rewritten;   /* device-visible state of this QP was rewritten (indices, ring, CQ) */
+    uint64_t off_new; /* the gate offset that matches the rewritten indices */
+};
+
+struct t1_state {
+    bool on;
+    int hold_ms, round_ms, quiesce_ms, handshake_ms, gid_wait_ms, copy_ms;
+    std::atomic<bool> stream_stalled; /* a copy did not complete within copy_ms: the stream is not
+                                         touched (the pinned buffer may still be in flight) until a
+                                         query shows it drained */
+    std::atomic<bool> helper_done;
+    uint32_t *hflag, *hflag_d; /* the decline mirror, one host-mapped word per gate (host/device ptr) */
+    uint32_t skip;
+    nvshmemi_ibgda_ft_gate_t *gates_d;
+    uint32_t ngates;
+    std::vector<t1_qpstate> qs;
+    std::vector<int> fd;
+    std::vector<int> peer_fin;  /* FIN seen on the peer's library socket: the peer process is gone */
+    std::vector<int> sock_err;  /* errno that killed the socket (reset, timeout): OOB lost, not death */
+    std::vector<double> sock_next_dial;
+    std::vector<uint32_t> peer_ip, peer_port; /* the peers' listeners (re-dial) */
+    int ls;                     /* our listener, kept open for re-dials */
+    std::vector<std::string> rx;
+    std::atomic<int> dci_pending; /* local DCIs left in ERR by a round: retried from the idle scan */
+    std::atomic<uint32_t> dci_reset, dci_failed;
+    cudaStream_t stream;
+    uint8_t *pin; /* pinned staging */
+    std::thread *helper; /* heap: a process that exits without nvshmem_finalize must not abort in a
+                            joinable std::thread destructor */
+    std::atomic<bool> stop;
+    std::atomic<double> heartbeat;
+    std::atomic<double> round_t0;
+    std::atomic<int> round_state; /* T1_RS_* */
+    size_t pin_bytes;
+    std::mutex qmu;
+    std::deque<std::pair<nvshmemi_ibgda_ft_record_t, double>> q;
+    uint32_t round_seq;
+    std::atomic<uint32_t> rounds_ok, rounds_declined;
+    int cuda_dev; /* the device the transport runs on (the helper thread uses it) */
+    /* saved local GID per selected device (index into selected_dev_ids), for the re-lookup */
+    std::vector<union ibv_gid> gid;
+    std::vector<int> gid_ver;
+};
+static t1_state ibgda_t1;
+enum { T1_RS_IDLE = 0, T1_RS_RUNNING = 1, T1_RS_COMMITTING = 2, T1_RS_TIMED_OUT = 3 };
+static bool t1_active() { return ibgda_t1.on; }
+static void t1_beat() { ibgda_t1.heartbeat.store(ibgda_ft_mono_ms()); }
+
+static void t1_log(const char *fmt, ...) __attribute__((format(printf, 1, 2)));
+static void t1_log(const char *fmt, ...) {
+    char buf[1024];
+    va_list ap;
+    va_start(ap, fmt);
+    vsnprintf(buf, sizeof(buf), fmt, ap);
+    va_end(ap);
+    fprintf(stderr, "[nvshmem-t1] PE%d %.3f %s\n", ibgda_ft.t ? ibgda_ft.t->my_pe : -1,
+            ibgda_ft_mono_ms(), buf);
+}
+
+static nvshmemi_ibgda_ft_gate_t *t1_gate_d(uint32_t gi) { return ibgda_t1.gates_d + gi; }
+
+/* Bounded wait for the helper's stream: a cudaStreamQuery poll up to copy_ms, or less when a round
+ * is running and its budget ends sooner (never below 100 ms). A copy that does not complete leaves
+ * the stream marked stalled; later copies are refused until a query shows the stream drained (the
+ * pinned buffer may still be in flight), and the round declines. */
+static int t1_sync() {
+    double bound = ibgda_t1.copy_ms;
+    const double r0 = ibgda_t1.round_t0.load();
+    if (r0 > 0) bound = std::max(100.0, std::min(bound, r0 + ibgda_t1.round_ms - ibgda_ft_mono_ms()));
+    const double t0 = ibgda_ft_mono_ms();
+    for (;;) {
+        const cudaError_t q = cudaStreamQuery(ibgda_t1.stream);
+        if (q == cudaSuccess) return 0;
+        if (q != cudaErrorNotReady) return -1;
+        if (ibgda_ft_mono_ms() - t0 > bound) {
+            if (!ibgda_t1.stream_stalled.exchange(true))
+                t1_log("device-state copy did not complete within %.0f ms: the GPU stream is stalled; "
+                       "copies are refused until it drains", bound);
+            return -1;
+        }
+        std::this_thread::sleep_for(std::chrono::microseconds(20));
+    }
+}
+
+/* 0 if the stream may be used (it is idle, or it drained since it stalled) */
+static int t1_stream_ok() {
+    if (!ibgda_t1.stream_stalled.load()) return 0;
+    if (cudaStreamQuery(ibgda_t1.stream) != cudaSuccess) return -1;
+    ibgda_t1.stream_stalled.store(false);
+    t1_log("the GPU stream drained; copies resume");
+    return 0;
+}
+
+static int t1_d2h(void *dst, const void *src_d, size_t n) {
+    if (n > ibgda_t1.pin_bytes || t1_stream_ok()) return -1;
+    if (cudaMemcpyAsync(ibgda_t1.pin, src_d, n, cudaMemcpyDeviceToHost, ibgda_t1.stream)) return -1;
+    if (t1_sync()) return -1;
+    memcpy(dst, ibgda_t1.pin, n);
+    return 0;
+}
+
+static int t1_h2d(void *dst_d, const void *src, size_t n) {
+    if (n > ibgda_t1.pin_bytes || t1_stream_ok()) return -1;
+    memcpy(ibgda_t1.pin, src, n);
+    if (cudaMemcpyAsync(dst_d, ibgda_t1.pin, n, cudaMemcpyHostToDevice, ibgda_t1.stream)) return -1;
+    return t1_sync();
+}
+
+/* The decline mirror: a plain store the device reads over PCIe (no CUDA call, so it reaches a held
+ * device wait even when the copies to the gate stall). */
+static void t1_hflag_fail(uint32_t gi) {
+    if (ibgda_t1.hflag && gi < ibgda_t1.ngates) {
+        __atomic_store_n(&ibgda_t1.hflag[gi], 1u, __ATOMIC_SEQ_CST);
+        std::atomic_thread_fence(std::memory_order_seq_cst);
+    }
+}
+
+/* Ring CQ counter resync for T1: the CQ read is a bounded copy without the lock, the QUERY_CQ a
+ * DEVX command under rc_endpoint_lock (as ibgda_ft_ring_resume_ci, which holds no lock itself). */
+static int t1_ring_resume_ci(struct ibgda_ep *ep, uint64_t ci_old, uint64_t *new_ci, uint32_t *scan_out,
+                             uint32_t *pi_out) {
+    struct ibgda_cq *cq = ep->send_cq;
+    const uint32_t n = cq->num_cqe;
+    std::vector<uint8_t> buf((size_t)n * NVSHMEMI_IBGDA_CQE_SIZE);
+    if (t1_d2h(buf.data(), cq->cq_mobject->aligned.gpu_ptr, buf.size())) return -1;
+    uint32_t scan = 0;
+    while (scan < n) {
+        const uint64_t c = ci_old + scan;
+        const uint8_t opown = buf[(size_t)(c & (n - 1)) * NVSHMEMI_IBGDA_CQE_SIZE + 63];
+        if ((opown >> 4) == 0xf || (uint32_t)(opown & 1) != ((c & n) ? 1u : 0u)) break;
+        scan++;
+    }
+    uint32_t pi = 0;
+    {
+        std::lock_guard<std::mutex> lk(ibgda_ft.st->rc_endpoint_lock);
+        if (ibgda_ft_query_cq_pi(cq, &pi)) return -2;
+    }
+    const uint32_t ahead = (pi - (uint32_t)ci_old) & 0xffffffu;
+    *scan_out = scan;
+    *pi_out = pi;
+    if (ahead < scan || ahead > (1u << 22)) return -3;
+    *new_ci = (ibgda_ft.skip & NVSHMEMI_IBGDA_FT_SKIP_RINGCI) ? 0 : ci_old + ahead;
+    return 0;
+}
+
+static int t1_gate_read(uint32_t gi, nvshmemi_ibgda_ft_gate_t *out) {
+    return t1_d2h(out, t1_gate_d(gi), sizeof(*out));
+}
+
+/* The host writes only the epoch half of the gate word (4 bytes); device threads update the whole
+ * 64-bit word with atomics (the counted half). */
+static int t1_gate_write_hi(uint32_t gi, uint32_t hi) {
+    return t1_h2d((char *)t1_gate_d(gi) + 4, &hi, 4);
+}
+
+static int t1_gate_write(uint32_t gi, size_t off, const void *v, size_t n) {
+    return t1_h2d((char *)t1_gate_d(gi) + off, v, n);
+}
+
+static uint32_t t1_counted(const nvshmemi_ibgda_ft_gate_t &g) { return (uint32_t)(g.word & 0xffffffffULL); }
+static uint32_t t1_hi(const nvshmemi_ibgda_ft_gate_t &g) { return (uint32_t)(g.word >> 32); }
+
+/* QUERY_QP: state, rmsn, next_rcv_psn. Every DEVX command of the helper, queries included, runs
+ * under rc_endpoint_lock, like the fault hook's (one command per QP at a time). */
+static int t1_query_qp(struct ibgda_ep *ep, uint32_t *state, uint32_t *rmsn, uint32_t *rcv_psn,
+                       uint32_t *hw_sq) {
+    std::lock_guard<std::mutex> lk(ibgda_ft.st->rc_endpoint_lock);
+    uint8_t cmd_in[DEVX_ST_SZ_BYTES(query_qp_in)] = {0};
+    uint8_t cmd_out[DEVX_ST_SZ_BYTES(query_qp_out)] = {0};
+    DEVX_SET(query_qp_in, cmd_in, opcode, MLX5_CMD_OP_QUERY_QP);
+    DEVX_SET(query_qp_in, cmd_in, qpn, ep->qpn);
+    int st = mlx5dv_devx_obj_query(ep->devx_qp, cmd_in, sizeof(cmd_in), cmd_out, sizeof(cmd_out));
+    void *qpc = DEVX_ADDR_OF(query_qp_out, cmd_out, qpc);
+    if (state) *state = DEVX_GET(qpc, qpc, state);
+    if (rmsn) *rmsn = DEVX_GET(qpc, qpc, rmsn);
+    if (rcv_psn) *rcv_psn = DEVX_GET(qpc, qpc, next_rcv_psn);
+    if (hw_sq) *hw_sq = DEVX_GET(qpc, qpc, hw_sq_wqebb_counter);
+    return st;
+}
+
+/* ------------------------------------------------------------------ library socket per peer */
+static int t1_if_addr(struct in_addr *out) {
+    const char *ifn = getenv("NVSHMEM_IBGDA_FT_T1_IFNAME");
+    if (!ifn || !*ifn) ifn = getenv("NVSHMEM_BOOTSTRAP_UID_SOCK_IFNAME");
+    struct ifaddrs *ifa = NULL;
+    if (getifaddrs(&ifa)) return -1;
+    int found = -1;
+    for (struct ifaddrs *i = ifa; i; i = i->ifa_next) {
+        if (!i->ifa_addr || i->ifa_addr->sa_family != AF_INET) continue;
+        if (ifn && *ifn) {
+            if (strcmp(i->ifa_name, ifn)) continue;
+        } else if (i->ifa_flags & IFF_LOOPBACK) {
+            continue;
+        }
+        *out = ((struct sockaddr_in *)i->ifa_addr)->sin_addr;
+        found = 0;
+        break;
+    }
+    freeifaddrs(ifa);
+    return found;
+}
+
+static void t1_sockopts(int fd) {
+    int one = 1, idle = 2, intvl = 1, cnt = 3;
+    unsigned int uto = 5000;
+    setsockopt(fd, IPPROTO_TCP, TCP_NODELAY, &one, sizeof(one));
+    setsockopt(fd, SOL_SOCKET, SO_KEEPALIVE, &one, sizeof(one));
+    setsockopt(fd, IPPROTO_TCP, TCP_KEEPIDLE, &idle, sizeof(idle));
+    setsockopt(fd, IPPROTO_TCP, TCP_KEEPINTVL, &intvl, sizeof(intvl));
+    setsockopt(fd, IPPROTO_TCP, TCP_KEEPCNT, &cnt, sizeof(cnt));
+    setsockopt(fd, IPPROTO_TCP, TCP_USER_TIMEOUT, &uto, sizeof(uto));
+    fcntl(fd, F_SETFL, fcntl(fd, F_GETFL) | O_NONBLOCK);
+}
+
+static void t1_sock_lost(int peer, int err);
+static int t1_send(int peer, t1_msg *m) {
+    int fd = ibgda_t1.fd[peer];
+    if (fd < 0) return -1;
+    m->magic = T1_MAGIC;
+    m->from_pe = (uint32_t)ibgda_ft.t->my_pe;
+    const char *p = (const char *)m;
+    size_t o = 0;
+    double t0 = ibgda_ft_mono_ms();
+    while (o < sizeof(*m)) {
+        ssize_t k = send(fd, p + o, sizeof(*m) - o, MSG_NOSIGNAL);
+        if (k > 0) {
+            o += (size_t)k;
+            continue;
+        }
+        if (k < 0 && (errno == EAGAIN || errno == EWOULDBLOCK) && ibgda_ft_mono_ms() - t0 < 1000) {
+            struct pollfd pf = {fd, POLLOUT, 0};
+            poll(&pf, 1, 10);
+            continue;
+        }
+        if (k < 0 && errno != EAGAIN && errno != EWOULDBLOCK && errno != EPIPE) t1_sock_lost(peer, errno);
+        return -1;
+    }
+    return 0;
+}
+
+/* The peer's library socket died with an error (ECONNRESET, ETIMEDOUT from keepalive or
+ * TCP_USER_TIMEOUT, ...): that is a lost out-of-band path, not the peer's death. Linux reports the
+ * error once and then recv() == 0, so the socket is closed here, before the 0 could be mistaken for
+ * a FIN, and the helper re-dials the peer's listener until the path is back. */
+static void t1_sock_lost(int peer, int err) {
+    if (ibgda_t1.fd[peer] >= 0) close(ibgda_t1.fd[peer]);
+    ibgda_t1.fd[peer] = -1;
+    ibgda_t1.rx[peer].clear();
+    ibgda_t1.sock_err[peer] = err ? err : EIO;
+    ibgda_t1.sock_next_dial[peer] = 0;
+    t1_log("peer %d library socket lost (%s): OOB path lost, not the peer's death; re-dialing", peer,
+           strerror(err));
+}
+
+/* Liveness of the peer's library socket: 1 FIN seen, 0 no evidence of death. Only a clean FIN
+ * counts as death (an RST or a keepalive timeout comes from a management-network outage). */
+static int t1_peer_fin(int peer) {
+    if (ibgda_t1.peer_fin[peer]) return 1;
+    int fd = ibgda_t1.fd[peer];
+    if (fd < 0) return 0;
+    char c;
+    ssize_t k = recv(fd, &c, 1, MSG_PEEK | MSG_DONTWAIT);
+    if (k == 0) {
+        ibgda_t1.peer_fin[peer] = 1;
+    } else if (k < 0 && errno != EAGAIN && errno != EWOULDBLOCK && errno != EINTR) {
+        t1_sock_lost(peer, errno);
+    }
+    return ibgda_t1.peer_fin[peer];
+}
+
+static int t1_sock_setup_connected(int peer, int fd) {
+    t1_sockopts(fd);
+    ibgda_t1.fd[peer] = fd;
+    ibgda_t1.sock_err[peer] = 0;
+    ibgda_t1.rx[peer].clear();
+    struct sockaddr_in la;
+    socklen_t ll = sizeof(la);
+    memset(&la, 0, sizeof(la));
+    getsockname(fd, (struct sockaddr *)&la, &ll);
+    return (int)ntohs(la.sin_port);
+}
+
+/* One re-dial attempt to a peer whose socket was lost. The lower PE connects to the higher PE's
+ * listener (bounded connect); the higher PE accepts on its listener (t1_sock_accept). */
+static void t1_sock_redial(int peer) {
+    if (ibgda_t1.fd[peer] >= 0 || ibgda_t1.peer_fin[peer] || ibgda_ft.t->my_pe > peer) return;
+    const double now = ibgda_ft_mono_ms();
+    if (now < ibgda_t1.sock_next_dial[peer]) return;
+    ibgda_t1.sock_next_dial[peer] = now + 500;
+    struct sockaddr_in pa;
+    memset(&pa, 0, sizeof(pa));
+    pa.sin_family = AF_INET;
+    pa.sin_addr.s_addr = ibgda_t1.peer_ip[peer];
+    pa.sin_port = htons((uint16_t)ibgda_t1.peer_port[peer]);
+    int fd = socket(AF_INET, SOCK_STREAM, 0);
+    if (fd < 0) return;
+    fcntl(fd, F_SETFL, fcntl(fd, F_GETFL) | O_NONBLOCK);
+    int r = connect(fd, (struct sockaddr *)&pa, sizeof(pa));
+    if (r < 0 && errno == EINPROGRESS) {
+        struct pollfd pf = {fd, POLLOUT, 0};
+        if (poll(&pf, 1, 1000) > 0) {
+            int se = 0;
+            socklen_t sl = sizeof(se);
+            getsockopt(fd, SOL_SOCKET, SO_ERROR, &se, &sl);
+            r = se == 0 ? 0 : -1;
+        }
+    }
+    if (r != 0) {
+        close(fd);
+        return;
+    }
+    const int lport = t1_sock_setup_connected(peer, fd);
+    t1_msg h;
+    memset(&h, 0, sizeof(h));
+    h.type = T1_M_HELLO;
+    if (t1_send(peer, &h)) {
+        t1_sock_lost(peer, errno);
+        return;
+    }
+    t1_log("peer %d library socket re-dialed (local port %d)", peer, lport);
+}
+
+/* The higher PE's side of a re-dial: accept a connection on the listener and read its HELLO. */
+static void t1_sock_accept(int wait_ms) {
+    if (ibgda_t1.ls < 0) return;
+    struct pollfd pf = {ibgda_t1.ls, POLLIN, 0};
+    if (poll(&pf, 1, wait_ms) <= 0) return;
+    int fd = accept(ibgda_t1.ls, NULL, NULL);
+    if (fd < 0) return;
+    t1_msg h;
+    size_t o = 0;
+    double t0 = ibgda_ft_mono_ms();
+    while (o < sizeof(h) && ibgda_ft_mono_ms() - t0 < 2000) {
+        ssize_t r = recv(fd, (char *)&h + o, sizeof(h) - o, MSG_DONTWAIT);
+        if (r > 0)
+            o += (size_t)r;
+        else if (r == 0)
+            break;
+        else
+            usleep(1000);
+    }
+    const int p = (int)h.from_pe;
+    if (o != sizeof(h) || h.magic != T1_MAGIC || h.type != T1_M_HELLO || p >= ibgda_ft.t->my_pe ||
+        p < 0 || ibgda_t1.peer_fin[p]) {
+        close(fd);
+        return;
+    }
+    if (ibgda_t1.fd[p] >= 0) close(ibgda_t1.fd[p]); /* the peer saw the loss first */
+    const int lport = t1_sock_setup_connected(p, fd);
+    t1_log("peer %d library socket re-accepted (local port %d)", p, lport);
+}
+
+/* Wait up to wait_ms for a lost socket to come back (both sides keep dialing / accepting). */
+static bool t1_sock_ensure(int peer, int wait_ms) {
+    const double deadline = ibgda_ft_mono_ms() + wait_ms;
+    while (ibgda_t1.fd[peer] < 0 && !ibgda_t1.peer_fin[peer] && !ibgda_t1.stop.load()) {
+        if (ibgda_ft.t->my_pe < peer)
+            t1_sock_redial(peer);
+        else
+            t1_sock_accept(50);
+        if (ibgda_t1.fd[peer] >= 0) break;
+        if (ibgda_ft_mono_ms() > deadline) break;
+        t1_beat();
+        std::this_thread::sleep_for(std::chrono::milliseconds(20));
+    }
+    return ibgda_t1.fd[peer] >= 0;
+}
+
+/* Receive one message from `peer` (0 none within wait_ms, 1 got one, -1 socket closed). */
+static int t1_recv(int peer, t1_msg *m, int wait_ms) {
+    int fd = ibgda_t1.fd[peer];
+    if (fd < 0) return -1;
+    std::string &rx = ibgda_t1.rx[peer];
+    double t0 = ibgda_ft_mono_ms();
+    for (;;) {
+        if (rx.size() >= sizeof(t1_msg)) {
+            memcpy(m, rx.data(), sizeof(*m));
+            rx.erase(0, sizeof(*m));
+            if (m->magic != T1_MAGIC) return -1;
+            return 1;
+        }
+        char buf[4096];
+        ssize_t k = recv(fd, buf, sizeof(buf), MSG_DONTWAIT);
+        if (k > 0) {
+            rx.append(buf, (size_t)k);
+            continue;
+        }
+        if (k == 0) {
+            ibgda_t1.peer_fin[peer] = 1;
+            return -1;
+        }
+        if (errno != EAGAIN && errno != EWOULDBLOCK && errno != EINTR) {
+            t1_sock_lost(peer, errno);
+            return -1;
+        }
+        const double left = wait_ms - (ibgda_ft_mono_ms() - t0);
+        if (left <= 0 || ibgda_t1.stop.load()) return 0;
+        t1_beat();
+        struct pollfd pf = {fd, POLLIN, 0};
+        poll(&pf, 1, left > 2 ? 2 : (int)left + 1);
+    }
+}
+
+/* Collective (every PE that set NVSHMEM_IBGDA_FT_TRANSPARENT calls it, ok or not): one allgather
+ * of {ok, address}; T1 goes on only if every PE is ok. */
+static int t1_sockets_setup(nvshmem_transport_t t, int ok) {
+    const int n = t->n_pes, me = t->my_pe;
+    ibgda_t1.fd.assign(n, -1);
+    ibgda_t1.peer_fin.assign(n, 0);
+    ibgda_t1.sock_err.assign(n, 0);
+    ibgda_t1.sock_next_dial.assign(n, 0.0);
+    ibgda_t1.peer_ip.assign(n, 0);
+    ibgda_t1.peer_port.assign(n, 0);
+    ibgda_t1.ls = -1;
+    ibgda_t1.rx.assign(n, std::string());
+    struct in_addr ia;
+    memset(&ia, 0, sizeof(ia));
+    if (ok && t1_if_addr(&ia)) {
+        t1_log("no IPv4 address for the library socket");
+        ok = 0;
+    }
+    int ls = -1;
+    struct sockaddr_in a;
+    memset(&a, 0, sizeof(a));
+    if (ok) {
+        ls = socket(AF_INET, SOCK_STREAM, 0);
+        int one = 1;
+        setsockopt(ls, SOL_SOCKET, SO_REUSEADDR, &one, sizeof(one));
+        a.sin_family = AF_INET;
+        a.sin_addr = ia;
+        a.sin_port = 0;
+        if (bind(ls, (struct sockaddr *)&a, sizeof(a)) || listen(ls, n)) ok = 0;
+        socklen_t al = sizeof(a);
+        getsockname(ls, (struct sockaddr *)&a, &al);
+    }
+    struct {
+        uint32_t ok;
+        uint32_t ip;
+        uint32_t port;
+    } mine = {(uint32_t)ok, a.sin_addr.s_addr, (uint32_t)ntohs(a.sin_port)}, *all;
+    all = (decltype(all))calloc(n, sizeof(mine));
+    int st = t->boot_handle->allgather(&mine, all, sizeof(mine), t->boot_handle);
+    int all_ok = st == 0;
+    for (int p = 0; p < n && all_ok; p++) all_ok = all[p].ok != 0;
+    if (!all_ok) {
+        free(all);
+        if (ls >= 0) close(ls);
+        t1_log("transparent mode off: not every PE could enable it");
+        return -1;
+    }
+    for (int p = 0; p < n; p++) {
+        ibgda_t1.peer_ip[p] = all[p].ip;
+        ibgda_t1.peer_port[p] = all[p].port;
+    }
+    /* lower PE connects, higher PE accepts */
+    int rc = 0;
+    std::string ports;
+    for (int p = me + 1; p < n && !rc; p++) {
+        struct sockaddr_in pa;
+        memset(&pa, 0, sizeof(pa));
+        pa.sin_family = AF_INET;
+        pa.sin_addr.s_addr = all[p].ip;
+        pa.sin_port = htons((uint16_t)all[p].port);
+        int fd = -1;
+        double t0 = ibgda_ft_mono_ms();
+        for (;;) {
+            fd = socket(AF_INET, SOCK_STREAM, 0);
+            if (connect(fd, (struct sockaddr *)&pa, sizeof(pa)) == 0) break;
+            close(fd);
+            fd = -1;
+            if (ibgda_ft_mono_ms() - t0 > 15000) break;
+            usleep(20000);
+        }
+        if (fd < 0) {
+            rc = -1;
+            break;
+        }
+        {
+            const int lport = t1_sock_setup_connected(p, fd);
+            char b[48];
+            snprintf(b, sizeof(b), " peer%d:local_port=%d", p, lport);
+            ports += b;
+        }
+        t1_msg h;
+        memset(&h, 0, sizeof(h));
+        h.type = T1_M_HELLO;
+        if (t1_send(p, &h)) rc = -1;
+    }
+    for (int k = 0; k < me && !rc; k++) {
+        struct pollfd pf = {ls, POLLIN, 0};
+        if (poll(&pf, 1, 15000) <= 0) {
+            rc = -1;
+            break;
+        }
+        int fd = accept(ls, NULL, NULL);
+        if (fd < 0) {
+            rc = -1;
+            break;
+        }
+        t1_sockopts(fd);
+        /* read HELLO to learn the peer */
+        t1_msg h;
+        size_t o = 0;
+        double t0 = ibgda_ft_mono_ms();
+        while (o < sizeof(h) && ibgda_ft_mono_ms() - t0 < 15000) {
+            ssize_t r = recv(fd, (char *)&h + o, sizeof(h) - o, MSG_DONTWAIT);
+            if (r > 0)
+                o += (size_t)r;
+            else if (r == 0)
+                break;
+            else
+                usleep(1000);
+        }
+        if (o != sizeof(h) || h.magic != T1_MAGIC || h.type != T1_M_HELLO || (int)h.from_pe >= me) {
+            close(fd);
+            rc = -1;
+            break;
+        }
+        {
+            const int lport = t1_sock_setup_connected((int)h.from_pe, fd);
+            char b[48];
+            snprintf(b, sizeof(b), " peer%d:local_port=%d", (int)h.from_pe, lport);
+            ports += b;
+        }
+    }
+    /* the listener stays open: a lost socket is re-dialed (lower PE) / re-accepted (higher PE) */
+    if (rc == 0) {
+        fcntl(ls, F_SETFL, fcntl(ls, F_GETFL) | O_NONBLOCK);
+        ibgda_t1.ls = ls;
+    } else {
+        close(ls);
+    }
+    /* every PE must have its connections, or T1 stays off everywhere */
+    {
+        uint32_t mine2 = rc == 0 ? 1u : 0u;
+        std::vector<uint32_t> all2(n, 0);
+        int st2 = t->boot_handle->allgather(&mine2, all2.data(), sizeof(mine2), t->boot_handle);
+        for (int p = 0; p < n && !st2; p++)
+            if (!all2[p]) st2 = -1;
+        if (st2) rc = -1;
+    }
+    free(all);
+    if (rc) {
+        for (int p = 0; p < n; p++)
+            if (ibgda_t1.fd[p] >= 0) {
+                close(ibgda_t1.fd[p]);
+                ibgda_t1.fd[p] = -1;
+            }
+        if (ibgda_t1.ls >= 0) close(ibgda_t1.ls);
+        ibgda_t1.ls = -1;
+        t1_log("transparent mode off: library socket setup failed on some PE");
+        return rc;
+    }
+    t1_log("library socket on %s: listener port %u, connected to %d peer(s):%s", inet_ntoa(ia),
+           (unsigned)ntohs(a.sin_port), n - 1, ports.c_str());
+    return rc;
+}
+
+/* ------------------------------------------------------------------ GID re-lookup by value */
+static int t1_gid_lookup(int di, struct ibgda_device *device, int port, int *out_idx,
+                         double *waited_ms) {
+    const union ibv_gid &want = ibgda_t1.gid[di];
+    const int ver = ibgda_t1.gid_ver[di];
+    const char *name = ftable.get_device_name(device->common_device.context->device);
+    const int tbl = device->common_device.port_attr[port - 1].gid_tbl_len;
+    double t0 = ibgda_ft_mono_ms();
+    for (;;) {
+        for (int i = 0; i < tbl; i++) {
+            union ibv_gid g;
+            if (ftable.query_gid(device->common_device.context, port, i, &g)) continue;
+            if (memcmp(&g, &want, sizeof(g))) continue;
+            int v = 0;
+            if (ib_roce_get_version_num(name, port, i, &v) || v != ver) continue;
+            *out_idx = i;
+            *waited_ms = ibgda_ft_mono_ms() - t0;
+            return 0;
+        }
+        if (ibgda_ft_mono_ms() - t0 > ibgda_t1.gid_wait_ms || ibgda_t1.stop.load()) break;
+        t1_beat();
+        std::this_thread::sleep_for(std::chrono::milliseconds(50));
+    }
+    *waited_ms = ibgda_ft_mono_ms() - t0;
+    return -1;
+}
+
+/* ------------------------------------------------------------------ one side of a round */
+static const char *t1_class_name(int cls) {
+    nvshmemt_ibgda_ft_info_t o;
+    memset(&o, 0, sizeof(o));
+    ibgda_ft_class_text(cls, 0, &o);
+    static thread_local char n[24];
+    snprintf(n, sizeof(n), "%s", o.name);
+    return n;
+}
+
+/* Record a declined recovery for nvshmemt_ibgda_ft_query (the application's host view). */
+static void t1_host_record(int peer, int cls, const char *why) {
+    std::lock_guard<std::mutex> g(ibgda_ft.mu);
+    nvshmemt_ibgda_ft_info_t info;
+    memset(&info, 0, sizeof(info));
+    info.valid = 1;
+    info.cls = cls ? cls : NVSHMEMI_IBGDA_FT_CLASS_T1_DECLINED;
+    info.peer = peer;
+    info.host_mono_ms = ibgda_ft_mono_ms();
+    ibgda_ft_class_text(info.cls, 0, &info);
+    snprintf(info.cause, sizeof(info.cause), "T1 recovery declined: %s", why);
+    if (!ibgda_ft.have_error.load()) {
+        ibgda_ft.first = info;
+        ibgda_ft.have_error.store(1);
+    }
+    ibgda_ft.nrecords++;
+}
+
+struct t1_qpround;
+static void t1_decline(int peer, int cls, const char *why, bool tell_peer,
+                       const std::vector<t1_qpround> *rq = NULL) {
+    struct ibgda_ep *eps[NVSHMEMT_IBGDA_FT_MAX_QPS];
+    struct ibgda_device *devs[NVSHMEMT_IBGDA_FT_MAX_QPS];
+    int n = ibgda_ft_rc_eps(peer, eps, devs, NVSHMEMT_IBGDA_FT_MAX_QPS);
+    {
+        std::lock_guard<std::mutex> lk(ibgda_ft.st->rc_endpoint_lock);
+        for (int i = 0; i < n; i++) {
+            uint32_t s = 0;
+            ibgda_ft_query_qp(eps[i]->devx_qp, eps[i]->qpn, &s, NULL, NULL);
+            if (s != 6) ibgda_ft_qp_cmd(eps[i]->devx_qp, eps[i]->qpn, MLX5_CMD_OP_2ERR_QP);
+        }
+    }
+    /* the mirror first (reaches a held device wait without a CUDA call), then the gate */
+    for (int i = 0; i < n; i++)
+        if (eps[i]->user_index < ibgda_t1.ngates) t1_hflag_fail(eps[i]->user_index);
+    /* a QP whose indices were already rewritten: publish the matching offset first, so that held
+     * posters shift their reservations before they continue fail-fast */
+    if (rq)
+        for (const auto &r : *rq)
+            if (r.rewritten) t1_gate_write(r.gi, offsetof(nvshmemi_ibgda_ft_gate_t, off), &r.off_new, 8);
+    for (int i = 0; i < n; i++) {
+        uint32_t gi = eps[i]->user_index;
+        if (gi >= ibgda_t1.ngates) continue;
+        ibgda_t1.qs[gi].failed = true;
+        t1_gate_write_hi(gi, NVSHMEMI_IBGDA_FT_T1_FAILED | ibgda_t1.qs[gi].epoch);
+    }
+    ibgda_t1.rounds_declined.fetch_add(1);
+    t1_host_record(peer, cls, why);
+    t1_log("DECLINE peer=%d class=%s reason=\"%s\"", peer, t1_class_name(cls), why);
+    if (tell_peer && !t1_peer_fin(peer)) {
+        t1_msg m;
+        memset(&m, 0, sizeof(m));
+        m.type = T1_M_FAIL;
+        m.cls = cls;
+        snprintf(m.text, sizeof(m.text), "%s", why);
+        t1_send(peer, &m);
+    }
+    ibgda_ft_set_failed("T1 recovery declined");
+}
+
+/* Quiesce every gated QP to `peer`: epoch odd, QPs to ERR, wait until every counted device thread
+ * is held. */
+static int t1_quiesce(std::vector<t1_qpround> &q, double *ms, char *why, size_t wn) {
+    double t0 = ibgda_ft_mono_ms();
+    for (auto &r : q) {
+        if (t1_gate_read(r.gi, &r.g)) return -1;
+        const uint32_t hi = t1_hi(r.g);
+        if ((hi & NVSHMEMI_IBGDA_FT_T1_FAILED) || r.g.dfailed) {
+            snprintf(why, wn, "QP 0x%x already failed (gate 0x%x dfailed %u)", r.ep->qpn, hi, r.g.dfailed);
+            return -2;
+        }
+        if (hi != ibgda_t1.qs[r.gi].epoch) {
+            snprintf(why, wn, "QP 0x%x gate epoch %u, host expects %u", r.ep->qpn, hi,
+                     ibgda_t1.qs[r.gi].epoch);
+            return -2;
+        }
+        if (t1_gate_write_hi(r.gi, hi + NVSHMEMI_IBGDA_FT_T1_ODD)) return -1;
+    }
+    {
+        std::lock_guard<std::mutex> lk(ibgda_ft.st->rc_endpoint_lock);
+        for (auto &r : q) {
+            uint32_t s = 0;
+            ibgda_ft_query_qp(r.ep->devx_qp, r.ep->qpn, &s, NULL, NULL);
+            if (s != 6 && ibgda_ft_qp_cmd(r.ep->devx_qp, r.ep->qpn, MLX5_CMD_OP_2ERR_QP)) {
+                snprintf(why, wn, "2ERR of QP 0x%x failed", r.ep->qpn);
+                return -3;
+            }
+        }
+    }
+    for (;;) {
+        bool all = true;
+        for (auto &r : q) {
+            if (t1_gate_read(r.gi, &r.g)) return -1;
+            if (t1_counted(r.g) != 0) all = false;
+        }
+        if (all) break;
+        if (ibgda_ft_mono_ms() - t0 > ibgda_t1.quiesce_ms) {
+            snprintf(why, wn, "device threads did not stop in %d ms (counted %u)", ibgda_t1.quiesce_ms,
+                     t1_counted(q[0].g));
+            return -4;
+        }
+        t1_beat();
+        std::this_thread::sleep_for(std::chrono::microseconds(20));
+    }
+    /* `word` and `xbb` sit in different 32 B sectors of the gate: read it once more now that the
+     * count is 0, so that xbb includes the last poster's add */
+    for (auto &r : q)
+        if (t1_gate_read(r.gi, &r.g)) return -1;
+    *ms = ibgda_ft_mono_ms() - t0;
+    return 0;
+}
+
+/* Local DCIs left in ERR by the fault (the hook moves every QP of the PE). Reset one with host
+ * copies only: no kernel launch (a memset kernel could wait behind the application's persistent
+ * kernel). rc_endpoint_lock is taken only around the DEVX commands. Returns 0 reset, 1 left as
+ * it is (not in ERR / not quiescent: retried from the idle scan), <0 failed (left in ERR: the v2.2
+ * error path reports it). */
+static int t1_dci_reset_one(struct ibgda_device *device, struct ibgda_ep *ep,
+                            nvshmemi_ibgda_device_qp_t *qp_d, char *why, size_t wn) {
+    nvshmemt_ibgda_state_t *st = ibgda_ft.st;
+    uint32_t state = 0;
+    {
+        std::lock_guard<std::mutex> lk(st->rc_endpoint_lock);
+        if (ibgda_ft_query_qp(ep->devx_qp, ep->qpn, &state, NULL, NULL)) {
+            snprintf(why, wn, "QUERY_QP failed");
+            return -1;
+        }
+    }
+    if (state != 6) return 1; /* RTS (or in transition): nothing to do */
+    nvshmemi_ibgda_device_qp_management_t m;
+    if (t1_d2h(&m, &qp_d->mvars, sizeof(m))) {
+        snprintf(why, wn, "mvars read failed");
+        return -2;
+    }
+    if (!ibgda_ft_quiescent(&m)) {
+        snprintf(why, wn, "not quiescent (a device post in flight)");
+        return 1;
+    }
+    {
+        std::lock_guard<std::mutex> lk(st->rc_endpoint_lock);
+        if (ibgda_ft_qp_cmd(ep->devx_qp, ep->qpn, MLX5_CMD_OP_2RST_QP)) {
+            snprintf(why, wn, "2RST failed");
+            return -3;
+        }
+    }
+    /* device resync as ibgda_ft_resync_qp (host-built mvars), with bounded host copies and no lock
+     * (the QP is in RESET): ring counter from a CQ read + QUERY_CQ, CQ filled with 0xff, doorbell
+     * record zeroed, mvars reset */
+    uint64_t new_ci = 0;
+    if (ibgda_ft.ring) {
+        uint32_t scan = 0, pi = 0;
+        if (t1_ring_resume_ci(ep, m.ft_ring_ci, &new_ci, &scan, &pi)) {
+            snprintf(why, wn, "ring counter resync failed");
+            return -4;
+        }
+    }
+    {
+        const size_t cqsz = ep->send_cq->cq_mobject->base.size;
+        std::vector<uint8_t> ff(std::min(cqsz, ibgda_t1.pin_bytes), 0xff);
+        for (size_t o = 0; o < cqsz; o += ff.size()) {
+            const size_t n = std::min(ff.size(), cqsz - o);
+            if (t1_h2d((char *)ep->send_cq->cq_mobject->base.gpu_ptr + o, ff.data(), n)) {
+                snprintf(why, wn, "CQ fill failed");
+                return -5;
+            }
+        }
+        uint8_t z8[IBGDA_DBRSIZE];
+        memset(z8, 0, sizeof(z8));
+        if (t1_h2d((char *)ep->qp_ctrl.dbr_mobject->aligned.gpu_ptr + ep->qp_ctrl.dbr_offset, z8, sizeof(z8))) {
+            snprintf(why, wn, "doorbell record reset failed");
+            return -6;
+        }
+        nvshmemi_ibgda_device_qp_management_t z;
+        memset(&z, 0, sizeof(z));
+        z.ft_ring_ci = new_ci;
+        if (t1_h2d(&qp_d->mvars, &z, sizeof(z))) {
+            snprintf(why, wn, "mvars reset failed");
+            return -7;
+        }
+    }
+    {
+        std::lock_guard<std::mutex> lk(st->rc_endpoint_lock);
+        if (ibgda_qp_rst2init(st, ep, device, ep->portid) || ibgda_dci_init2rtr(st, ep, device, ep->portid) ||
+            ibgda_qp_rtr2rts(st, ep, device, 0)) {
+            snprintf(why, wn, "INIT/RTR/RTS failed");
+            return -8;
+        }
+    }
+    return 0;
+}
+
+/* Every local DCI: before the commit point of a round, and again from the idle scan while one is
+ * pending. Never fatal for the RC round. */
+static void t1_dci_reset_all(const char *when) {
+    nvshmemt_ibgda_state_t *st = ibgda_ft.st;
+    nvshmemi_ibgda_device_state_t *dstate =
+        (nvshmemi_ibgda_device_state_t *)ibgda_ft.t->type_specific_shared_state;
+    int reset = 0, pending = 0, failed = 0;
+    for (int d = 0; d < st->n_devs_selected; d++) {
+        struct ibgda_device *device = (struct ibgda_device *)st->common.devices + st->selected_dev_ids[d];
+        for (int e = 0; e < device->dci.num_eps; e++) {
+            struct ibgda_ep *ep = device->dci.eps ? device->dci.eps[e] : NULL;
+            if (!ep || !ep->devx_qp) continue;
+            char why[96] = {0};
+            const int r = t1_dci_reset_one(device, ep, &dstate->globalmem.dcis[e * st->n_devs_selected + d],
+                                           why, sizeof(why));
+            if (r == 0) {
+                reset++;
+                t1_log("DCI 0x%x reset (%s)", ep->qpn, when);
+            } else if (r > 0 && why[0]) {
+                pending++;
+                t1_log("DCI 0x%x left in ERR for now: %s (%s)", ep->qpn, why, when);
+            } else if (r < 0) {
+                failed++;
+                t1_log("DCI 0x%x reset failed: %s (%s); it stays in ERR", ep->qpn, why, when);
+            }
+        }
+    }
+    ibgda_t1.dci_pending.store(pending);
+    ibgda_t1.dci_reset.fetch_add((uint32_t)reset);
+    ibgda_t1.dci_failed.fetch_add((uint32_t)failed);
+}
+
+/* Read the device state, drain, walk [C, R) of the send ring. */
+static int t1_prepare(std::vector<t1_qpround> &q, double *ms, char *why, size_t wn) {
+    double t0 = ibgda_ft_mono_ms();
+    nvshmemi_ibgda_device_state_t *dstate =
+        (nvshmemi_ibgda_device_state_t *)ibgda_ft.t->type_specific_shared_state;
+    for (auto &r : q) {
+        if (t1_d2h(&r.m, &dstate->globalmem.rcs[r.gi].mvars, sizeof(r.m))) return -1;
+        r.V = r.m.tx_wq.resv_head;
+        r.R = r.m.tx_wq.ready_head;
+        r.P = r.m.tx_wq.prod_idx & ~NVSHMEMI_IBGDA_FT_PARK_MARK;
+        r.C = r.m.tx_wq.cons_idx;
+        r.nwqes = (uint32_t)r.ep->sq_cnt;
+        if (r.m.post_send_lock != 0) {
+            snprintf(why, wn, "QP 0x%x not quiescent (post_send_lock %d)", r.ep->qpn, r.m.post_send_lock);
+            return -6;
+        }
+        if (!(r.C <= r.P && r.P <= r.R && r.R <= r.V && r.R - r.C <= r.nwqes)) {
+            snprintf(why, wn, "QP 0x%x indices inconsistent (C %llu P %llu R %llu V %llu)", r.ep->qpn,
+                     (unsigned long long)r.C, (unsigned long long)r.P, (unsigned long long)r.R,
+                     (unsigned long long)r.V);
+            return -6;
+        }
+    }
+    /* drain: the NIC flushes up to the doorbell record's send word (the last index rung) */
+    double t1 = ibgda_ft_mono_ms();
+    for (auto &r : q) {
+        uint32_t w[2] = {0, 0};
+        if (t1_d2h(w, (char *)r.ep->qp_ctrl.dbr_mobject->aligned.gpu_ptr + r.ep->qp_ctrl.dbr_offset,
+                   sizeof(w)))
+            return -1;
+        const uint32_t dbr16 = be32toh(w[1]) & 0xffff;
+        for (;;) {
+            uint32_t s = 0, hw = 0;
+            t1_query_qp(r.ep, &s, NULL, NULL, &hw);
+            if (s == 6 && hw == dbr16) break;
+            t1_beat();
+            if (ibgda_ft_mono_ms() - t1 > ibgda_ft.drain_ms) {
+                snprintf(why, wn, "QP 0x%x: NIC did not flush every rung WQE in %d ms (hw %u dbr %u state %u)",
+                         r.ep->qpn, ibgda_ft.drain_ms, hw, dbr16, s);
+                return -8;
+            }
+            std::this_thread::sleep_for(std::chrono::microseconds(50));
+        }
+    }
+    /* walk [C, R): only RDMA WRITE, non-fetching atomics and NOPs may be re-posted */
+    for (auto &r : q) {
+        r.sq.resize((size_t)r.nwqes * 64);
+        const void *sq_d = (const void *)((uintptr_t)r.ep->qp_ctrl.wq_mobject->aligned.gpu_ptr +
+                                          r.ep->qp_ctrl.wq_offset);
+        if (t1_d2h(r.sq.data(), sq_d, r.sq.size())) return -1;
+        const uint64_t ibuf0 = (uint64_t)(uintptr_t)r.ep->qp_ctrl.internal_buf.mem_object->aligned.gpu_ptr;
+        const uint32_t mask = r.nwqes - 1;
+        r.wstart.clear();
+        r.wbb.clear();
+        r.wmsg.clear();
+        r.msgs_cr = r.xbb_cr = 0;
+        uint64_t x = r.C;
+        while (x < r.R) {
+            const uint8_t *w = &r.sq[(size_t)(x & mask) * 64];
+            uint32_t w0, w1;
+            memcpy(&w0, w, 4);
+            memcpy(&w1, w + 4, 4);
+            w0 = be32toh(w0);
+            w1 = be32toh(w1);
+            const uint32_t opcode = w0 & 0xff, ds = w1 & 0x3f, qpn = w1 >> 8;
+            if (qpn != r.ep->qpn || ds == 0) {
+                snprintf(why, wn, "QP 0x%x: unreadable WQE at %llu (qpn 0x%x ds %u)", r.ep->qpn,
+                         (unsigned long long)x, qpn, ds);
+                return -9;
+            }
+            const uint32_t nbb = (ds * 16 + 63) / 64;
+            uint32_t msg = 1;
+            bool ok = false;
+            switch (opcode) {
+                case MLX5_OPCODE_RDMA_WRITE:
+                case MLX5_OPCODE_RDMA_WRITE_IMM:
+                    ok = true;
+                    break;
+                case MLX5_OPCODE_NOP:
+                    ok = true;
+                    msg = 0;
+                    break;
+                case MLX5_OPCODE_ATOMIC_FA:
+                case MLX5_OPCODE_ATOMIC_CS:
+                case MLX5_OPCODE_ATOMIC_MASKED_FA:
+                case MLX5_OPCODE_ATOMIC_MASKED_CS: {
+                    /* the data segment is the last 16 B of the WQE; laddr = ibuf slot 0 means the
+                     * result is discarded (non-fetching AMO, signal) */
+                    const uint64_t off = (uint64_t)(ds - 1) * 16 + 8;
+                    uint8_t la[8];
+                    for (int b = 0; b < 8; b++)
+                        la[b] = r.sq[(size_t)(((x + (off + b) / 64) & mask) * 64 + (off + b) % 64)];
+                    uint64_t laddr;
+                    memcpy(&laddr, la, 8);
+                    laddr = be64toh(laddr);
+                    ok = (laddr == ibuf0);
+                    break;
+                }
+                default:
+                    ok = false;
+            }
+            if (!ok) {
+                snprintf(why, wn, "QP 0x%x: WQE opcode 0x%x at %llu cannot be re-posted (fetch, READ or "
+                         "DUMP in the unfinished range)", r.ep->qpn, opcode, (unsigned long long)x);
+                return -10;
+            }
+            r.wstart.push_back(x);
+            r.wbb.push_back((uint8_t)nbb);
+            r.wmsg.push_back((uint8_t)msg);
+            r.msgs_cr += msg;
+            r.xbb_cr += nbb - msg;
+            x += nbb;
+        }
+        if (x != r.R) {
+            snprintf(why, wn, "QP 0x%x: WQE walk ended at %llu, ready %llu", r.ep->qpn,
+                     (unsigned long long)x, (unsigned long long)r.R);
+            return -9;
+        }
+    }
+    *ms = ibgda_ft_mono_ms() - t0;
+    return 0;
+}
+
+/* Executed prefix of my requests on QP r: the peer's QP executed `exec` messages (mod 2^24) of
+ * this epoch [e0, R). */
+static int t1_prefix(t1_qpround &r, uint32_t exec, char *why, size_t wn) {
+    const t1_qpstate &s = ibgda_t1.qs[r.gi];
+    const uint64_t xbb_epoch = r.g.xbb; /* WQEBBs beyond one per message, made ready this epoch */
+    if (r.R < s.e0 || (r.R - s.e0) < xbb_epoch) {
+        snprintf(why, wn, "QP 0x%x: epoch accounting inconsistent (e0 %llu R %llu xbb %llu)", r.ep->qpn,
+                 (unsigned long long)s.e0, (unsigned long long)r.R, (unsigned long long)xbb_epoch);
+        return -1;
+    }
+    const uint64_t msgs_total = (r.R - s.e0) - xbb_epoch;
+    if (msgs_total < r.msgs_cr) {
+        snprintf(why, wn, "QP 0x%x: %llu messages this epoch < %llu unfinished", r.ep->qpn,
+                 (unsigned long long)msgs_total, (unsigned long long)r.msgs_cr);
+        return -1;
+    }
+    const uint64_t before_c = msgs_total - r.msgs_cr;
+    const uint32_t k = (exec - (uint32_t)before_c) & 0xffffffu;
+    if (k > r.msgs_cr) {
+        snprintf(why, wn, "QP 0x%x: responder executed %u messages, %llu completed before C, %llu "
+                 "unfinished: no consistent prefix", r.ep->qpn, exec, (unsigned long long)before_c,
+                 (unsigned long long)r.msgs_cr);
+        return -1;
+    }
+    uint64_t U = r.C;
+    uint32_t left = k;
+    for (size_t i = 0; i < r.wstart.size() && left > 0; i++) {
+        U = r.wstart[i] + r.wbb[i];
+        left -= r.wmsg[i];
+    }
+    r.U_exec = U;
+    if (ibgda_t1.skip & T1_SKIP_PREFIX) U = r.C; /* negative control: re-post from C */
+    if (U > r.P) {
+        snprintf(why, wn, "QP 0x%x: executed prefix %llu beyond the rung index %llu", r.ep->qpn,
+                 (unsigned long long)U, (unsigned long long)r.P);
+        return -1;
+    }
+    r.U = U;
+    r.B = (r.V | 0xffffULL) + 1ULL;
+    r.delta = r.B - U;
+    r.xbb_new = 0;
+    for (size_t i = 0; i < r.wstart.size(); i++)
+        if (r.wstart[i] >= U) r.xbb_new += (uint64_t)(r.wbb[i] - r.wmsg[i]);
+    return 0;
+}
+
+/* 2RST, GID re-lookup, rebase + ring rotation + CQ counter, INIT/RTR/RTS with the new PSNs. */
+static int t1_commit(std::vector<t1_qpround> &q, const t1_msg &peer, double *ms, double *gid_ms,
+                     int *gid_old, int *gid_new, char *why, size_t wn) {
+    double t0 = ibgda_ft_mono_ms();
+    nvshmemt_ibgda_state_t *st = ibgda_ft.st;
+    nvshmemi_ibgda_device_state_t *dstate =
+        (nvshmemi_ibgda_device_state_t *)ibgda_ft.t->type_specific_shared_state;
+    {
+        std::lock_guard<std::mutex> lk(st->rc_endpoint_lock);
+        for (auto &r : q)
+            if (ibgda_ft_qp_cmd(r.ep->devx_qp, r.ep->qpn, MLX5_CMD_OP_2RST_QP)) {
+                snprintf(why, wn, "2RST of QP 0x%x failed", r.ep->qpn);
+                return -13;
+            }
+    }
+    /* GID: the local address may have come back at another index (address flap) */
+    *gid_ms = 0;
+    *gid_old = *gid_new = -1;
+    std::vector<int> sgid(q.size(), -1);
+    for (size_t i = 0; i < q.size(); i++) {
+        auto &r = q[i];
+        int di = -1;
+        for (int d = 0; d < st->n_devs_selected; d++)
+            if ((struct ibgda_device *)st->common.devices + st->selected_dev_ids[d] == r.dev) di = d;
+        const int port = r.ep->portid;
+        const int old = r.dev->common_device.gid_info[port - 1].local_gid_index;
+        *gid_old = old;
+        if (di < 0 || (ibgda_t1.skip & T1_SKIP_GID) ||
+            r.dev->common_device.port_attr[port - 1].link_layer != IBV_LINK_LAYER_ETHERNET) {
+            sgid[i] = old;
+            *gid_new = old;
+            continue;
+        }
+        int idx = -1;
+        double w = 0;
+        if (t1_gid_lookup(di, r.dev, port, &idx, &w)) {
+            *gid_ms += w;
+            snprintf(why, wn, "local RoCE GID not present after %.0f ms", w);
+            return -20;
+        }
+        *gid_ms += w;
+        sgid[i] = idx;
+        *gid_new = idx;
+        if (idx != old) t1_log("GID re-lookup: QP 0x%x sgid index %d -> %d (waited %.1f ms)", r.ep->qpn, old, idx, w);
+    }
+    /* Commit point (give-up handshake), before the first device-visible write: commit = next, then
+     * read abandoned. A device wait that gave up before this is seen here and the round declines
+     * with the device state untouched; one that times out later sees the commit and waits one more
+     * bound. The watchdog can no longer end the round after this point. */
+    for (auto &r : q) {
+        const uint32_t next = ibgda_t1.qs[r.gi].epoch + 2;
+        if (t1_gate_write(r.gi, offsetof(nvshmemi_ibgda_ft_gate_t, commit), &next, 4)) return -1;
+    }
+    std::atomic_thread_fence(std::memory_order_seq_cst);
+    for (auto &r : q) {
+        const uint32_t next = ibgda_t1.qs[r.gi].epoch + 2;
+        if (t1_gate_read(r.gi, &r.g)) return -1;
+        if (r.g.abandoned >= next || r.g.dfailed) {
+            snprintf(why, wn, "a device wait gave up before the commit point (abandoned %u, dfailed %u)",
+                     r.g.abandoned, r.g.dfailed);
+            return -21;
+        }
+    }
+    {
+        int exp = T1_RS_RUNNING;
+        if (!ibgda_t1.round_state.compare_exchange_strong(exp, T1_RS_COMMITTING)) {
+            snprintf(why, wn, "watchdog: the round ran longer than %d ms", ibgda_t1.round_ms);
+            return -22;
+        }
+    }
+    /* device resync while the QPs are in RESET and every device thread is held or parked: bounded
+     * copies without the lock (rc_endpoint_lock is taken only around the DEVX commands: QUERY_CQ
+     * inside t1_ring_resume_ci, INIT/RTR/RTS below), so that a stalled copy cannot block the fault
+     * hook, the watcher's QUERY_QP or the watchdog */
+    for (auto &r : q) {
+        nvshmemi_ibgda_device_qp_t *qp_d = &dstate->globalmem.rcs[r.gi];
+        uint64_t new_ci = 0;
+        uint32_t scan = 0, pi = 0;
+        if (t1_ring_resume_ci(r.ep, r.m.ft_ring_ci, &new_ci, &scan, &pi)) {
+            snprintf(why, wn, "ring CQ counter of QP 0x%x: scan %u pi %u ci %llu", r.ep->qpn, scan, pi,
+                     (unsigned long long)r.m.ft_ring_ci);
+            return -14;
+        }
+        /* the ring counter carries the new epoch above bit 40 (see ibgda_t1_ring_wait) */
+        new_ci = ((uint64_t)((ibgda_t1.qs[r.gi].epoch + 2) & NVSHMEMI_IBGDA_FT_T1_TAG_MASK)
+                  << NVSHMEMI_IBGDA_FT_T1_TAG_SHIFT) |
+                 (new_ci & ((1ULL << NVSHMEMI_IBGDA_FT_T1_TAG_SHIFT) - 1));
+        /* CQ creation pattern and doorbell record zero, by copies (no memset kernel) */
+        {
+            const size_t cqb = r.ep->send_cq->cq_mobject->base.size;
+            if (cqb > ibgda_t1.pin_bytes || t1_stream_ok()) return -14;
+            memset(ibgda_t1.pin, 0xff, cqb);
+            if (cudaMemcpyAsync(r.ep->send_cq->cq_mobject->base.gpu_ptr, ibgda_t1.pin, cqb,
+                                cudaMemcpyHostToDevice, ibgda_t1.stream) ||
+                t1_sync())
+                return -14;
+            uint64_t z = 0;
+            if (t1_h2d((char *)r.ep->qp_ctrl.dbr_mobject->aligned.gpu_ptr + r.ep->qp_ctrl.dbr_offset, &z, 8))
+                return -14;
+        }
+        /* send ring: rotate so that WQE U sits at slot 0 (= D index B), fix the index field of
+         * every WQE that will be re-posted */
+        const uint32_t mask = r.nwqes - 1;
+        std::vector<uint8_t> nsq(r.sq.size());
+        if (ibgda_t1.skip & T1_SKIP_ROTATE) {
+            nsq = r.sq;
+        } else {
+            for (uint64_t x = r.U; x < r.U + r.nwqes; x++)
+                memcpy(&nsq[(size_t)((x + r.delta) & mask) * 64], &r.sq[(size_t)(x & mask) * 64], 64);
+        }
+        for (size_t i = 0; i < r.wstart.size(); i++) {
+            const uint64_t x = r.wstart[i];
+            if (x < r.U) continue;
+            uint8_t *w = &nsq[(size_t)((x + r.delta) & mask) * 64];
+            uint32_t w0;
+            memcpy(&w0, w, 4);
+            w0 = be32toh(w0);
+            w0 = (w0 & 0xff0000ffu) | ((uint32_t)((x + r.delta) & 0xffff) << 8);
+            w0 = htobe32(w0);
+            memcpy(w, &w0, 4);
+        }
+        void *sq_d = (void *)((uintptr_t)r.ep->qp_ctrl.wq_mobject->aligned.gpu_ptr + r.ep->qp_ctrl.wq_offset);
+        if (t1_h2d(sq_d, nsq.data(), nsq.size())) return -14;
+        /* management variables: every index jumps by delta (B = U + delta, a multiple of 65536) */
+        nvshmemi_ibgda_device_qp_management_t z = r.m;
+        z.post_send_lock = 0;
+        z.tx_wq.resv_head = r.V + r.delta;
+        z.tx_wq.ready_head = r.R + r.delta;
+        z.tx_wq.prod_idx = r.R + r.delta; /* the re-post below rings up to here; un-parks */
+        z.tx_wq.cons_idx = r.B;
+        if (r.m.tx_wq.get_tail < r.m.tx_wq.get_head) {
+            z.tx_wq.get_head = r.B;
+            z.tx_wq.get_tail = r.B - 1;
+        } else {
+            z.tx_wq.get_head = z.tx_wq.get_tail = r.B;
+        }
+        z.ft_state = z.ft_fp = z.ft_wqe = z.ft_aux = 0;
+        z.ft_ring_ci = new_ci;
+        /* only the fields the host owns: not ibuf, which fetches reserve outside the gate */
+        const size_t o_ibuf = offsetof(nvshmemi_ibgda_device_qp_management_t, ibuf);
+        const size_t o_ft = offsetof(nvshmemi_ibgda_device_qp_management_t, ft_state);
+        if (t1_h2d(&qp_d->mvars, &z, o_ibuf) ||
+            t1_h2d((char *)&qp_d->mvars + o_ft, (const char *)&z + o_ft, sizeof(z) - o_ft))
+            return -14;
+        r.rewritten = true; /* a later decline publishes the matching offset before FAILED */
+        r.off_new = ibgda_t1.qs[r.gi].off + r.delta;
+        (void)scan;
+    }
+    double t2 = ibgda_ft_mono_ms();
+    {
+        std::lock_guard<std::mutex> lkc(st->rc_endpoint_lock);
+        for (size_t i = 0; i < q.size(); i++) {
+            auto &r = q[i];
+            struct ibgda_rc_handle h;
+            memset(&h, 0, sizeof(h));
+            h.qpn = r.ep->ft_peer.qpn;
+            h.lid = r.ep->ft_peer.lid;
+            h.spn = r.ep->ft_peer.spn;
+            h.iid = r.ep->ft_peer.iid;
+            if (r.ep->ah) {
+                ftable.destroy_ah(r.ep->ah);
+                r.ep->ah = NULL;
+            }
+            if (ibgda_qp_rst2init(st, r.ep, r.dev, r.ep->portid) ||
+                ibgda_rc_init2rtr(st, r.ep, r.dev, r.ep->portid, &h, peer.qp[i].sq_psn, sgid[i]) ||
+                ibgda_qp_rtr2rts(st, r.ep, r.dev, r.sq_psn)) {
+                snprintf(why, wn, "reconnect of QP 0x%x failed", r.ep->qpn);
+                return -16;
+            }
+        }
+        /* (local DCIs: reset before the commit point by t1_dci_reset_all, never here) */
+    }
+    (void)t2;
+    *ms = ibgda_ft_mono_ms() - t0;
+    return 0;
+}
+
+/* Commit point, re-post with a host doorbell, rmsn baseline, publish. */
+static int t1_finish(std::vector<t1_qpround> &q, double *ms, char *why, size_t wn) {
+    double t0 = ibgda_ft_mono_ms();
+    /* test hook: a shot scheduled "inside the commit" fires now, after RTS and before the re-post is
+     * rung, so that it hits the re-posted WQEs */
+    if (ibgda_ft.fire_in_commit.exchange(0)) {
+        fprintf(stderr, "[nvshmem-fault-inject] in-commit shot fire_mono_ms=%.3f\n", ibgda_ft_mono_ms());
+        ibgda_fi_all_qps_to_err(ibgda_ft.st, ibgda_ft.t->n_pes);
+    }
+    /* publish off and xbb first: a poster that leaves its hold with FAILED after this point (a
+     * decline after the rewrite) reads the offset that matches the rotated ring, before the NIC can
+     * run the re-post; the epoch (below) makes them visible to every other poster */
+    for (auto &r : q) {
+        t1_qpstate &s = ibgda_t1.qs[r.gi];
+        const uint64_t off = s.off + r.delta;
+        if (t1_gate_write(r.gi, offsetof(nvshmemi_ibgda_ft_gate_t, off), &off, 8) ||
+            t1_gate_write(r.gi, offsetof(nvshmemi_ibgda_ft_gate_t, xbb), &r.xbb_new, 8))
+            return -1;
+    }
+    /* re-post [U, R) = new [B, R + delta): doorbell record, then the UAR, from the host */
+    for (auto &r : q) {
+        if (r.R <= r.U || (ibgda_t1.skip & T1_SKIP_RING)) continue;
+        /* a device wait that gave up after a second bound writes at its unshifted slot: do not let
+         * the NIC run the re-post over it */
+        if (t1_gate_read(r.gi, &r.g)) return -1;
+        if (r.g.dfailed) {
+            snprintf(why, wn, "a device wait gave up after the commit point (dfailed, before the re-post)");
+            return -23;
+        }
+        const uint64_t prod = r.R + r.delta;
+        uint32_t w1 = htobe32((uint32_t)(prod & 0xffff));
+        if (t1_h2d((char *)r.ep->qp_ctrl.dbr_mobject->aligned.gpu_ptr + r.ep->qp_ctrl.dbr_offset + 4, &w1, 4))
+            return -1;
+        struct mlx5_wqe_ctrl_seg cs;
+        memset(&cs, 0, sizeof(cs));
+        cs.opmod_idx_opcode = htobe32((uint32_t)(prod & 0xffff) << 8);
+        cs.qpn_ds = htobe32(r.ep->qpn << 8);
+        std::atomic_thread_fence(std::memory_order_seq_cst);
+        volatile uint64_t *bf = (volatile uint64_t *)r.ep->uar_mobject->aligned.cpu_ptr;
+        uint64_t v;
+        memcpy(&v, &cs, 8);
+        *bf = v;
+        std::atomic_thread_fence(std::memory_order_seq_cst);
+    }
+    /* publish the epoch (off and xbb are already in place) */
+    for (auto &r : q) {
+        t1_qpstate &s = ibgda_t1.qs[r.gi];
+        const uint64_t off = s.off + r.delta;
+        if (t1_gate_read(r.gi, &r.g)) return -1;
+        if (r.g.dfailed) { /* a second bound expired (host stalled after its commit point) */
+            snprintf(why, wn, "a device wait gave up after the commit point (dfailed)");
+            return -23;
+        }
+        if (t1_gate_write_hi(r.gi, s.epoch + 2)) return -1;
+        s.epoch += 2;
+        s.off = off;
+        s.e0 = r.B;
+        s.lost_scans = 0;
+    }
+    *ms = ibgda_ft_mono_ms() - t0;
+    return 0;
+}
+
+static int t1_rmsn(t1_qpround &r, uint32_t *rmsn) {
+    uint32_t s = 0;
+    return t1_query_qp(r.ep, &s, rmsn, NULL, NULL);
+}
+
+static bool t1_build(int peer, std::vector<t1_qpround> &q) {
+    struct ibgda_ep *eps[NVSHMEMT_IBGDA_FT_MAX_QPS];
+    struct ibgda_device *devs[NVSHMEMT_IBGDA_FT_MAX_QPS];
+    int n = ibgda_ft_rc_eps(peer, eps, devs, NVSHMEMT_IBGDA_FT_MAX_QPS);
+    if (n <= 0) return false;
+    q.clear();
+    std::random_device rd;
+    for (int i = 0; i < n; i++) {
+        if (eps[i]->user_index >= ibgda_t1.ngates) continue; /* created after init: no gate */
+        t1_qpround r = t1_qpround();
+        r.ep = eps[i];
+        r.dev = devs[i];
+        r.gi = eps[i]->user_index;
+        r.sq_psn = ((uint32_t)rd() ^ ((uint32_t)rd() << 7)) & 0xffffff;
+        r.rewritten = false;
+        r.off_new = 0;
+        q.push_back(r);
+    }
+    return !q.empty();
+}
+
+/* One round with `peer`. initiator: I send REQ; responder: `req` is the peer's REQ. */
+static void t1_round(int peer, int cls, bool initiator, const t1_msg *req) {
+    double t0 = ibgda_ft_mono_ms();
+    ibgda_t1.round_t0.store(t0);
+    ibgda_t1.round_state.store(T1_RS_RUNNING);
+    char why[256] = {0};
+    std::vector<t1_qpround> q;
+    const uint32_t round = initiator ? ++ibgda_t1.round_seq : req->round;
+    double tq = 0, tp = 0, tc = 0, tf = 0, tg = 0, t_hs0 = 0, t_hs = 0;
+    int gid_old = -1, gid_new = -1;
+    int rc = 0;
+    t1_msg m, a;
+    memset(&m, 0, sizeof(m));
+    memset(&a, 0, sizeof(a));
+    if (!t1_build(peer, q)) {
+        snprintf(why, sizeof(why), "no RC QPs to PE %d", peer);
+        rc = -1;
+    }
+    if (!rc && q.size() > NVSHMEMT_IBGDA_FT_MAX_QPS) rc = -1;
+    for (auto &r : q)
+        if (!rc && ibgda_t1.qs[r.gi].failed) {
+            snprintf(why, sizeof(why), "QP 0x%x already declined", r.ep->qpn);
+            rc = -1;
+        }
+    if (!rc) rc = t1_quiesce(q, &tq, why, sizeof(why));
+    if (!rc) rc = t1_prepare(q, &tp, why, sizeof(why));
+    /* local DCIs the fault left in ERR: before the commit point (the watchdog still covers this),
+     * host copies only, never fatal for this round */
+    if (!rc) t1_dci_reset_all("round");
+    if (!rc) {
+        for (auto &r : q) {
+            uint32_t rmsn = 0;
+            if (t1_rmsn(r, &rmsn)) {
+                snprintf(why, sizeof(why), "QUERY_QP of 0x%x failed", r.ep->qpn);
+                rc = -1;
+                break;
+            }
+            r.exec_peer = (rmsn - ibgda_t1.qs[r.gi].rmsn0) & 0xffffffu;
+        }
+    }
+    const t1_msg *pk = NULL; /* the peer's token */
+    if (!rc) {
+        m.round = round;
+        m.cls = cls;
+        m.nqps = (uint32_t)q.size();
+        for (size_t i = 0; i < q.size(); i++) {
+            m.qp[i].qpn = q[i].ep->qpn;
+            m.qp[i].peer_qpn = q[i].ep->ft_peer.qpn;
+            m.qp[i].sq_psn = q[i].sq_psn;
+            m.qp[i].exec = q[i].exec_peer;
+        }
+        t_hs0 = ibgda_ft_mono_ms();
+        if (initiator) {
+            m.type = T1_M_REQ;
+            if (t1_send(peer, &m)) {
+                snprintf(why, sizeof(why), "cannot send REQ");
+                rc = -30;
+            }
+            /* the responder may wait for its RoCE address inside its commit (GID re-lookup) */
+            const double ack_deadline = ibgda_ft_mono_ms() + ibgda_t1.handshake_ms + ibgda_t1.gid_wait_ms;
+            while (!rc) {
+                const int left = (int)(ack_deadline - ibgda_ft_mono_ms());
+                int k = left > 0 ? t1_recv(peer, &a, left) : 0;
+                if (k <= 0) {
+                    snprintf(why, sizeof(why), "%s", k == 0 ? "no ACK within the handshake bound"
+                                                            : "peer socket closed during the handshake");
+                    rc = -31;
+                } else if (a.type == T1_M_ACK && a.round == round) {
+                    pk = &a;
+                    break;
+                } else if (a.type == T1_M_FAIL || a.type == T1_M_NACK) {
+                    snprintf(why, sizeof(why), "the peer declined: %s", a.text);
+                    rc = -32;
+                } /* anything else (a stale NOTIFY, ...) is ignored */
+            }
+            t_hs = ibgda_ft_mono_ms() - t_hs0;
+        } else {
+            pk = req;
+        }
+    }
+    if (!rc && (pk->nqps != q.size())) {
+        snprintf(why, sizeof(why), "token mismatch (%u QPs vs %zu)", pk->nqps, q.size());
+        rc = -11;
+    }
+    for (size_t i = 0; !rc && i < q.size(); i++) {
+        if (pk->qp[i].qpn != q[i].ep->ft_peer.qpn || pk->qp[i].peer_qpn != q[i].ep->qpn) {
+            snprintf(why, sizeof(why), "QPN mismatch at %zu", i);
+            rc = -12;
+        } else {
+            rc = t1_prefix(q[i], pk->qp[i].exec, why, sizeof(why));
+        }
+    }
+    if (!rc) rc = t1_commit(q, *pk, &tc, &tg, &gid_old, &gid_new, why, sizeof(why));
+    if (!rc) {
+        /* new rmsn baseline: after RTS, before the peer's re-post can reach this QP */
+        for (auto &r : q) {
+            uint32_t rmsn = 0;
+            if (t1_rmsn(r, &rmsn)) rc = -1;
+            ibgda_t1.qs[r.gi].rmsn0 = rmsn;
+        }
+    }
+    if (!rc && !initiator) {
+        m.type = T1_M_ACK;
+        if (t1_send(peer, &m)) {
+            snprintf(why, sizeof(why), "cannot send ACK");
+            rc = -33;
+        }
+        /* the initiator commits (incl. its GID wait) before it sends DONE */
+        const double done_deadline = ibgda_ft_mono_ms() + 2 * ibgda_t1.handshake_ms + ibgda_t1.gid_wait_ms;
+        while (!rc) {
+            const int left = (int)(done_deadline - ibgda_ft_mono_ms());
+            int k = left > 0 ? t1_recv(peer, &a, left) : 0;
+            if (k <= 0) {
+                snprintf(why, sizeof(why), "%s", k == 0 ? "no DONE within the bound"
+                                                        : "peer socket closed before DONE");
+                rc = -34;
+            } else if (a.type == T1_M_DONE && a.round == round) {
+                break;
+            } else if (a.type == T1_M_FAIL) {
+                snprintf(why, sizeof(why), "the peer declined: %s", a.text);
+                rc = -35;
+            }
+        }
+        t_hs = ibgda_ft_mono_ms() - t_hs0;
+    }
+    if (!rc) rc = t1_finish(q, &tf, why, sizeof(why));
+    if (!rc && initiator) {
+        t1_msg d;
+        memset(&d, 0, sizeof(d));
+        d.type = T1_M_DONE;
+        d.round = round;
+        t1_send(peer, &d);
+    }
+    if (rc) {
+        t1_decline(peer, cls,
+                   why[0] ? why
+                          : ibgda_t1.stream_stalled.load()
+                                ? "a device-state copy did not complete within the bound (GPU stream stalled)"
+                                : "internal error",
+                   true, &q);
+    } else {
+        ibgda_t1.rounds_ok.fetch_add(1);
+        ibgda_ft.commits.fetch_add(1);
+        char per[512] = {0};
+        size_t o = 0;
+        for (auto &r : q)
+            o += snprintf(per + o, sizeof(per) - o,
+                          " qpn=0x%x C=%llu U=%llu Uexec=%llu P=%llu R=%llu V=%llu reposted=%llu B=%llu "
+                          "exec_by_peer=%u epoch=%u", r.ep->qpn, (unsigned long long)r.C, (unsigned long long)r.U,
+                          (unsigned long long)r.U_exec,
+                          (unsigned long long)r.P, (unsigned long long)r.R, (unsigned long long)r.V,
+                          (unsigned long long)(r.R - r.U), (unsigned long long)r.B, pk->qp[&r - &q[0]].exec,
+                          ibgda_t1.qs[r.gi].epoch);
+        t1_log("RECOVERED %s peer=%d class=%s round=%u total_ms=%.3f quiesce_ms=%.3f prepare_ms=%.3f "
+               "handshake_ms=%.3f commit_ms=%.3f gid_ms=%.1f sgid=%d->%d finish_ms=%.3f dci_reset=%u "
+               "dci_pending=%d dci_failed=%u%s",
+               initiator ? "initiator" : "responder", peer, t1_class_name(cls), round,
+               ibgda_ft_mono_ms() - t0, tq, tp, t_hs, tc, tg, gid_old, gid_new, tf, ibgda_t1.dci_reset.load(),
+               ibgda_t1.dci_pending.load(), ibgda_t1.dci_failed.load(), per);
+    }
+    ibgda_t1.round_state.store(T1_RS_IDLE);
+    ibgda_t1.round_t0.store(0);
+    t1_beat();
+}
+
+/* A fault on a QP to `peer` (device record or a lost-record scan). */
+static void t1_fault(int peer, int cls, const char *src) {
+    if (peer < 0 || peer >= ibgda_ft.t->n_pes || peer == ibgda_ft.t->my_pe) return;
+    bool fin = t1_peer_fin(peer) != 0;
+    const char *why = NULL;
+    char buf[160];
+    if (!fin && ibgda_t1.fd[peer] < 0 &&
+        (cls == NVSHMEMI_IBGDA_FT_CLASS_LOCAL_QP_ERR || cls == NVSHMEMI_IBGDA_FT_CLASS_RETRY_EXC)) {
+        /* the OOB path is down (socket lost with an error): give it one handshake bound to come back */
+        t1_sock_ensure(peer, ibgda_t1.handshake_ms);
+        fin = t1_peer_fin(peer) != 0;
+    }
+    if (cls == NVSHMEMI_IBGDA_FT_CLASS_LOCAL_QP_ERR || cls == NVSHMEMI_IBGDA_FT_CLASS_RETRY_EXC) {
+        if (fin && cls == NVSHMEMI_IBGDA_FT_CLASS_RETRY_EXC)
+            why = "RETRY_EXC and the peer's library socket shows FIN (peer process gone)";
+        else if (ibgda_t1.fd[peer] < 0 && !fin) {
+            snprintf(buf, sizeof(buf), "the peer's library socket is lost (%s) and not back within %d ms "
+                     "(OOB path down, peer liveness unknown)", strerror(ibgda_t1.sock_err[peer]),
+                     ibgda_t1.handshake_ms);
+            why = buf;
+        }
+    } else {
+        snprintf(buf, sizeof(buf), "class %s is not recoverable", t1_class_name(cls));
+        why = buf;
+    }
+    t1_log("FAULT peer=%d class=%s source=%s peer_fin=%d -> %s", peer, t1_class_name(cls), src,
+           fin ? 1 : 0, why ? "decline" : "recover");
+    if (why) {
+        t1_decline(peer, cls, why, !fin);
+        return;
+    }
+    if (ibgda_ft.t->my_pe < peer) {
+        t1_round(peer, cls, true, NULL);
+        return;
+    }
+    /* the lower PE leads: ask it, then serve its REQ */
+    t1_msg m, a;
+    memset(&m, 0, sizeof(m));
+    m.type = T1_M_NOTIFY;
+    m.cls = cls;
+    if (t1_send(peer, &m)) {
+        t1_decline(peer, cls, "cannot reach the peer's library socket", false);
+        return;
+    }
+    ibgda_t1.round_t0.store(ibgda_ft_mono_ms());
+    ibgda_t1.round_state.store(T1_RS_RUNNING);
+    const double deadline = ibgda_ft_mono_ms() + 2 * ibgda_t1.handshake_ms;
+    for (;;) {
+        const int left = (int)(deadline - ibgda_ft_mono_ms());
+        int k = left > 0 ? t1_recv(peer, &a, left) : 0;
+        if (k <= 0) {
+            t1_decline(peer, cls, "the peer did not start a round after NOTIFY", k == 0);
+            break;
+        }
+        if (a.type == T1_M_REQ) {
+            t1_round(peer, a.cls, false, &a);
+            return;
+        }
+        if (a.type == T1_M_FAIL) {
+            t1_decline(peer, cls, "the peer declined", false);
+            break;
+        }
+    }
+    ibgda_t1.round_state.store(T1_RS_IDLE);
+    ibgda_t1.round_t0.store(0);
+}
+
+/* Idle scan: a device wait that gave up, or a sticky error without a mailbox record. */
+static void t1_scan() {
+    nvshmemi_ibgda_device_state_t *dstate =
+        (nvshmemi_ibgda_device_state_t *)ibgda_ft.t->type_specific_shared_state;
+    for (int peer = 0; peer < ibgda_ft.t->n_pes; peer++) {
+        if (peer == ibgda_ft.t->my_pe) continue;
+        struct ibgda_ep *eps[NVSHMEMT_IBGDA_FT_MAX_QPS];
+        struct ibgda_device *devs[NVSHMEMT_IBGDA_FT_MAX_QPS];
+        int n = ibgda_ft_rc_eps(peer, eps, devs, NVSHMEMT_IBGDA_FT_MAX_QPS);
+        for (int i = 0; i < n; i++) {
+            const uint32_t gi = eps[i]->user_index;
+            if (gi >= ibgda_t1.ngates) continue;
+            t1_qpstate &s = ibgda_t1.qs[gi];
+            if (s.failed) continue;
+            nvshmemi_ibgda_ft_gate_t g;
+            if (t1_gate_read(gi, &g)) continue;
+            if (g.dfailed) {
+                t1_decline(peer, 0, "a device wait gave up (hold bound) with no round in progress", true);
+                break;
+            }
+            nvshmemi_ibgda_device_qp_management_t mv;
+            if (t1_d2h(&mv, &dstate->globalmem.rcs[gi].mvars, sizeof(mv))) continue;
+            if (mv.ft_state >= 2 && (mv.ft_fp >> 24) != 0 && t1_hi(g) == s.epoch) {
+                if (++s.lost_scans >= 2) {
+                    s.lost_scans = 0;
+                    t1_log("sticky error on QP 0x%x without a mailbox record (fp 0x%08x)", eps[i]->qpn, mv.ft_fp);
+                    t1_fault(peer, (int)(mv.ft_fp & 0xff), "scan");
+                    break;
+                }
+            } else {
+                s.lost_scans = 0;
+            }
+        }
+    }
+}
+
+static void t1_helper_main() {
+    cudaSetDevice(ibgda_t1.cuda_dev);
+    double last_scan = ibgda_ft_mono_ms();
+    while (!ibgda_t1.stop.load()) {
+        ibgda_t1.heartbeat.store(ibgda_ft_mono_ms());
+        /* 1. device records */
+        std::pair<nvshmemi_ibgda_ft_record_t, double> it;
+        bool have = false;
+        {
+            std::lock_guard<std::mutex> g(ibgda_t1.qmu);
+            if (!ibgda_t1.q.empty()) {
+                it = ibgda_t1.q.front();
+                ibgda_t1.q.pop_front();
+                have = true;
+            }
+        }
+        if (have) {
+            const nvshmemi_ibgda_ft_record_t &r = it.first;
+            const uint32_t gi = r.qp_index;
+            if (gi < ibgda_t1.qs.size() && !ibgda_t1.qs[gi].failed) {
+                if (r.t1_epoch == ibgda_t1.qs[gi].epoch)
+                    t1_fault(r.peer, r.cls, "device record");
+                else
+                    t1_log("record seq=%u for QP 0x%x from epoch %u ignored (current %u)", r.seq, r.qpn,
+                           r.t1_epoch, ibgda_t1.qs[gi].epoch);
+            }
+            continue;
+        }
+        /* 2. messages from peers; a lost socket is re-dialed (lower PE) or re-accepted (higher PE) */
+        bool any = false, lost_lower = false;
+        for (int p = 0; p < ibgda_ft.t->n_pes; p++) {
+            if (p == ibgda_ft.t->my_pe || ibgda_t1.peer_fin[p]) continue;
+            if (ibgda_t1.fd[p] < 0) {
+                if (ibgda_ft.t->my_pe < p)
+                    t1_sock_redial(p);
+                else
+                    lost_lower = true;
+                continue;
+            }
+            t1_msg m;
+            int k = t1_recv(p, &m, 0);
+            if (k < 0) {
+                if (ibgda_t1.peer_fin[p]) t1_log("peer %d library socket closed (FIN)", p);
+                continue;
+            }
+            if (k == 0) continue;
+            any = true;
+            if (m.type == T1_M_REQ) {
+                t1_round(p, m.cls, false, &m);
+            } else if (m.type == T1_M_NOTIFY) {
+                if (ibgda_ft.t->my_pe < p) t1_fault(p, m.cls, "peer NOTIFY");
+            } else if (m.type == T1_M_FAIL) {
+                bool live = false;
+                struct ibgda_ep *eps[NVSHMEMT_IBGDA_FT_MAX_QPS];
+                struct ibgda_device *devs[NVSHMEMT_IBGDA_FT_MAX_QPS];
+                int n = ibgda_ft_rc_eps(p, eps, devs, NVSHMEMT_IBGDA_FT_MAX_QPS);
+                for (int i = 0; i < n; i++)
+                    if (eps[i]->user_index < ibgda_t1.ngates) live |= !ibgda_t1.qs[eps[i]->user_index].failed;
+                if (live) t1_decline(p, m.cls, "the peer declined", false);
+            }
+        }
+        if (ibgda_t1.ls >= 0) t1_sock_accept(0); /* a lower PE may have re-dialed before we saw the loss */
+        (void)lost_lower;
+        if (any) continue;
+        /* 3. idle scan every 100 ms */
+        if (ibgda_ft_mono_ms() - last_scan > 100) {
+            t1_scan();
+            if (ibgda_t1.dci_pending.load()) t1_dci_reset_all("scan");
+            last_scan = ibgda_ft_mono_ms();
+        }
+        std::this_thread::sleep_for(std::chrono::microseconds(50));
+    }
+    ibgda_t1.helper_done.store(true);
+}
+
+/* Bounded join of the helper (teardown, atexit): every blocking step of the helper is bounded
+ * (copies by copy_ms, socket waits by stop), so it ends within a few seconds; if it does not, it is
+ * detached with a warning rather than blocking exit behind a running kernel. */
+static void t1_join_helper() {
+    if (!ibgda_t1.helper) return;
+    const double deadline = ibgda_ft_mono_ms() + ibgda_t1.copy_ms + 3000;
+    while (!ibgda_t1.helper_done.load() && ibgda_ft_mono_ms() < deadline)
+        std::this_thread::sleep_for(std::chrono::milliseconds(2));
+    if (ibgda_t1.helper_done.load()) {
+        if (ibgda_t1.helper->joinable()) ibgda_t1.helper->join();
+    } else {
+        t1_log("WARNING: the helper did not stop within %d ms; detached", ibgda_t1.copy_ms + 3000);
+        if (ibgda_t1.helper->joinable()) ibgda_t1.helper->detach();
+    }
+}
+
+/* Watcher hook: hand a record of a gated RC QP to the helper. Returns true if it was taken. */
+static bool t1_take_record(const nvshmemi_ibgda_ft_record_t *r, double mono_ms) {
+    if (!ibgda_t1.on || !r->t1 || r->qp_type != NVSHMEMI_IBGDA_DEVICE_QP_TYPE_RC) return false;
+    std::lock_guard<std::mutex> g(ibgda_t1.qmu);
+    ibgda_t1.q.push_back(std::make_pair(*r, mono_ms));
+    return true;
+}
+
+/* Watcher hook: the helper's watchdog. */
+static void t1_watchdog() {
+    if (!ibgda_t1.on) return;
+    const double now = ibgda_ft_mono_ms();
+    const double r0 = ibgda_t1.round_t0.load();
+    int exp = T1_RS_RUNNING;
+    /* a round still before its commit point after ROUND_MS: it declines at its commit point (the
+     * decline records the error); a round past it is left to finish. round_t0 is re-read so that
+     * the start time and the state belong to the same round. */
+    if (r0 > 0 && now - r0 > ibgda_t1.round_ms && ibgda_t1.round_t0.load() == r0 &&
+        ibgda_t1.round_state.compare_exchange_strong(exp, T1_RS_TIMED_OUT)) {
+        if (ibgda_t1.round_t0.load() == r0) {
+            t1_log("WATCHDOG: round running for %.0f ms (limit %d) before its commit point: it will "
+                   "decline", now - r0, ibgda_t1.round_ms);
+        } else { /* the timed-out round ended and another started meanwhile: undo */
+            int to = T1_RS_TIMED_OUT;
+            ibgda_t1.round_state.compare_exchange_strong(to, T1_RS_RUNNING);
+        }
+    }
+    bool queued;
+    {
+        std::lock_guard<std::mutex> g(ibgda_t1.qmu);
+        queued = !ibgda_t1.q.empty();
+    }
+    static bool warned = false;
+    if (queued && ibgda_t1.round_state.load() == T1_RS_IDLE && now - ibgda_t1.heartbeat.load() > 1000 &&
+        !warned) {
+        warned = true;
+        t1_log("WATCHDOG: records queued and the helper's heartbeat is %.0f ms old",
+               now - ibgda_t1.heartbeat.load());
+        t1_host_record(-1, 0, "watchdog: helper not running");
+    }
+}
+
+static int t1_env(const char *n, int d) {
+    const char *v = getenv(n);
+    return v && *v ? atoi(v) : d;
+}
+
+/* Called at the end of ibgda_ft_init (FT on, every other FT resource ready). 0 ok or T1 not
+ * requested; <0 T1 stays off. Collective when NVSHMEM_IBGDA_FT_TRANSPARENT is set. */
+static int t1_init(nvshmem_transport_t t, nvshmemt_ibgda_state_t *st, nvshmemi_ibgda_device_state_t *dstate) {
+    const char *on = getenv("NVSHMEM_IBGDA_FT_TRANSPARENT");
+    if (!on || atoi(on) == 0) return 0;
+    int ok = 1;
+    if (!ibgda_ft.ring || !(ibgda_ft.flags & NVSHMEMI_IBGDA_FT_FLAG_PARK) ||
+        ibgda_nic_handler != IBGDA_NIC_HANDLER_GPU || ibgda_ft.bounds) {
+        fprintf(stderr, "[nvshmem-t1] PE%d NVSHMEM_IBGDA_FT_TRANSPARENT needs RING_CQ=1, park, the GPU NIC "
+                        "handler, and no BOUNDS; transparent mode stays off\n", t->my_pe);
+        ok = 0;
+    }
+    ibgda_t1.hold_ms = t1_env("NVSHMEM_IBGDA_FT_T1_HOLD_MS", 60000);
+    ibgda_t1.round_ms = t1_env("NVSHMEM_IBGDA_FT_T1_ROUND_MS", 25000);
+    ibgda_t1.quiesce_ms = t1_env("NVSHMEM_IBGDA_FT_T1_QUIESCE_MS", 2000);
+    ibgda_t1.handshake_ms = t1_env("NVSHMEM_IBGDA_FT_T1_HANDSHAKE_MS", 5000);
+    ibgda_t1.gid_wait_ms = t1_env("NVSHMEM_IBGDA_FT_T1_GID_WAIT_MS", 30000);
+    ibgda_t1.copy_ms = std::max(100, t1_env("NVSHMEM_IBGDA_FT_T1_COPY_MS", 2000));
+    ibgda_t1.stream_stalled.store(false);
+    ibgda_t1.helper_done.store(false);
+    ibgda_t1.hflag = ibgda_t1.hflag_d = NULL;
+    {
+        /* Bounds. The initiator's longest phase before its commit point is quiesce + drain + the ACK
+         * wait (handshake + the responder's GID wait) + its own GID wait; the watchdog (ROUND_MS)
+         * must not end a round inside it, so ROUND_MS has that floor. A device wait spends one bound
+         * before the commit point and one more after it; the host's longest phase after the commit
+         * point is the responder's DONE wait (2 x handshake + GID wait). HOLD_MS must cover both, or a
+         * device give-up could land just before the commit point (declining a round whose address is
+         * back) or write under a live re-post. */
+        const int pre = ibgda_t1.quiesce_ms + ibgda_ft.drain_ms + ibgda_t1.handshake_ms + 2 * ibgda_t1.gid_wait_ms;
+        const int post = 2 * ibgda_t1.handshake_ms + ibgda_t1.gid_wait_ms;
+        const int min_round = pre + 5000;
+        if (ibgda_t1.round_ms < min_round) {
+            if (getenv("NVSHMEM_IBGDA_FT_T1_ROUND_MS"))
+                fprintf(stderr, "[nvshmem-t1] PE%d NVSHMEM_IBGDA_FT_T1_ROUND_MS %d raised to %d (quiesce + drain + "
+                                "handshake + 2 x GID wait + 5 s)\n", t->my_pe, ibgda_t1.round_ms, min_round);
+            ibgda_t1.round_ms = min_round;
+        }
+        /* The device hold starts at the device record, before the round: the socket may be re-dialed
+         * (<= handshake), a higher PE waits NOTIFY -> REQ (<= 2 x handshake), and rounds serialize
+         * per process (one helper), so another peer's round may run first. */
+        const int min_hold = std::max(ibgda_t1.round_ms + 3 * ibgda_t1.handshake_ms, post) + 5000;
+        if (ibgda_t1.hold_ms < min_hold) {
+            if (getenv("NVSHMEM_IBGDA_FT_T1_HOLD_MS"))
+                fprintf(stderr, "[nvshmem-t1] PE%d NVSHMEM_IBGDA_FT_T1_HOLD_MS %d raised to %d (max(ROUND_MS + 3 x "
+                                "handshake, 2 x handshake + GID wait) + 5 s)\n", t->my_pe, ibgda_t1.hold_ms, min_hold);
+            ibgda_t1.hold_ms = min_hold;
+        }
+    }
+    ibgda_t1.skip = 0;
+    {
+        const char *sv = getenv("NVSHMEM_IBGDA_FT_T1_TEST_SKIP");
+        if (sv && strstr(sv, "remap")) ibgda_t1.skip |= T1_SKIP_REMAP;
+        if (sv && strstr(sv, "ring")) ibgda_t1.skip |= T1_SKIP_RING;
+        if (sv && strstr(sv, "rotate")) ibgda_t1.skip |= T1_SKIP_ROTATE;
+        if (sv && strstr(sv, "prefix")) ibgda_t1.skip |= T1_SKIP_PREFIX;
+        if (sv && strstr(sv, "gid")) ibgda_t1.skip |= T1_SKIP_GID;
+    }
+    const uint32_t nrc = (uint32_t)(dstate->num_rc_per_pe * dstate->num_devices_initialized * t->n_pes);
+    ibgda_t1.ngates = nrc;
+    /* staging: the largest send ring or CQ of any RC QP, plus room */
+    size_t need = 4096;
+    for (int p = 0; ok && p < t->n_pes; p++) {
+        if (p == t->my_pe) continue;
+        struct ibgda_ep *eps[NVSHMEMT_IBGDA_FT_MAX_QPS];
+        struct ibgda_device *devs[NVSHMEMT_IBGDA_FT_MAX_QPS];
+        int n = ibgda_ft_rc_eps(p, eps, devs, NVSHMEMT_IBGDA_FT_MAX_QPS);
+        if (n < 0) {
+            fprintf(stderr, "[nvshmem-t1] PE%d more than %d RC QPs to PE %d; transparent mode stays off\n",
+                    t->my_pe, NVSHMEMT_IBGDA_FT_MAX_QPS, p);
+            ok = 0;
+        }
+        for (int i = 0; i < n; i++) {
+            need = std::max(need, (size_t)eps[i]->sq_cnt * 64);
+            need = std::max(need, (size_t)eps[i]->send_cq->cq_mobject->base.size);
+        }
+    }
+    ibgda_t1.pin_bytes = need + 4096;
+    if (ok && (cudaGetDevice(&ibgda_t1.cuda_dev) ||
+               cudaStreamCreateWithFlags(&ibgda_t1.stream, cudaStreamNonBlocking) ||
+               cudaHostAlloc((void **)&ibgda_t1.pin, ibgda_t1.pin_bytes, cudaHostAllocDefault) ||
+               cudaMalloc((void **)&ibgda_t1.gates_d, (size_t)nrc * sizeof(nvshmemi_ibgda_ft_gate_t))))
+        ok = 0;
+    if (ok && (cudaHostAlloc((void **)&ibgda_t1.hflag, (size_t)std::max(1u, nrc) * 4, cudaHostAllocMapped) ||
+               cudaHostGetDevicePointer((void **)&ibgda_t1.hflag_d, ibgda_t1.hflag, 0)))
+        ok = 0;
+    if (ok) {
+        memset(ibgda_t1.hflag, 0, (size_t)std::max(1u, nrc) * 4);
+        std::vector<nvshmemi_ibgda_ft_gate_t> z(nrc);
+        memset((void *)z.data(), 0, z.size() * sizeof(z[0]));
+        for (uint32_t gi = 0; gi < nrc; gi++) {
+            z[gi].test = (ibgda_t1.skip & T1_SKIP_REMAP) ? NVSHMEMI_IBGDA_FT_T1_TEST_NOREMAP : 0;
+            z[gi].hflag = (unsigned long long)(uintptr_t)(ibgda_t1.hflag_d + gi);
+        }
+        if (cudaMemcpy(ibgda_t1.gates_d, z.data(), z.size() * sizeof(z[0]), cudaMemcpyHostToDevice)) ok = 0;
+    }
+    ibgda_t1.qs.assign(nrc, t1_qpstate());
+    for (auto &s : ibgda_t1.qs) memset((void *)&s, 0, sizeof(s));
+    /* rmsn baseline of every RC QP (fresh QPs: 0) */
+    for (int p = 0; ok && p < t->n_pes; p++) {
+        if (p == t->my_pe) continue;
+        struct ibgda_ep *eps[NVSHMEMT_IBGDA_FT_MAX_QPS];
+        struct ibgda_device *devs[NVSHMEMT_IBGDA_FT_MAX_QPS];
+        int n = ibgda_ft_rc_eps(p, eps, devs, NVSHMEMT_IBGDA_FT_MAX_QPS);
+        for (int i = 0; i < n; i++) {
+            uint32_t s = 0, rmsn = 0;
+            t1_query_qp(eps[i], &s, &rmsn, NULL, NULL);
+            if (eps[i]->user_index < nrc) ibgda_t1.qs[eps[i]->user_index].rmsn0 = rmsn;
+        }
+    }
+    /* local GID value per selected device, for the re-lookup */
+    ibgda_t1.gid.assign(st->n_devs_selected, ibv_gid());
+    ibgda_t1.gid_ver.assign(st->n_devs_selected, 0);
+    for (int d = 0; d < st->n_devs_selected; d++) {
+        struct ibgda_device *device = (struct ibgda_device *)st->common.devices + st->selected_dev_ids[d];
+        const int port = st->selected_port_ids[d];
+        ibgda_t1.gid[d] = device->common_device.gid_info[port - 1].local_gid;
+        int v = 0;
+        ib_roce_get_version_num(ftable.get_device_name(device->common_device.context->device), port,
+                                device->common_device.gid_info[port - 1].local_gid_index, &v);
+        ibgda_t1.gid_ver[d] = v;
+    }
+    if (t1_sockets_setup(t, ok)) return -1;
+    /* device side on: gates, flag, hold bound */
+    ibgda_ft.flags |= NVSHMEMI_IBGDA_FT_FLAG_T1;
+    dstate->ft_gates = ibgda_t1.gates_d;
+    dstate->ft_ngates = nrc;
+    dstate->ft_flags = ibgda_ft.flags;
+    {
+        const uint64_t hold_ns = (uint64_t)ibgda_t1.hold_ms * 1000000ULL;
+        if (cudaMemcpy(&ibgda_ft.dev_d->flags, &ibgda_ft.flags, 4, cudaMemcpyHostToDevice) ||
+            cudaMemcpy(&ibgda_ft.dev_d->t1_hold_ns, &hold_ns, 8, cudaMemcpyHostToDevice)) {
+            ibgda_ft.flags &= ~(uint32_t)NVSHMEMI_IBGDA_FT_FLAG_T1;
+            dstate->ft_flags = ibgda_ft.flags;
+            dstate->ft_gates = NULL;
+            dstate->ft_ngates = 0;
+            return -1;
+        }
+    }
+    ibgda_t1.on = true;
+    ibgda_t1.stop.store(false);
+    ibgda_t1.round_t0.store(0);
+    ibgda_t1.round_state.store(T1_RS_IDLE);
+    t1_beat();
+    ibgda_t1.dci_pending.store(0);
+    ibgda_t1.dci_reset.store(0);
+    ibgda_t1.dci_failed.store(0);
+    ibgda_t1.helper = new std::thread(t1_helper_main);
+    /* a process that exits without nvshmem_finalize: stop and join the helper before the static
+     * state's destructor runs (atexit handlers run before static destructors) */
+    static bool atexit_registered = false;
+    if (!atexit_registered) {
+        atexit_registered = true;
+        atexit([]() {
+            if (!ibgda_t1.on) return;
+            ibgda_t1.stop.store(true);
+            t1_join_helper();
+            for (uint32_t gi = 0; gi < ibgda_t1.ngates; gi++) t1_hflag_fail(gi);
+            ibgda_t1.on = false;
+        });
+    }
+    t1_log("enabled: gates=%u hold_ms=%d round_ms=%d quiesce_ms=%d handshake_ms=%d gid_wait_ms=%d copy_ms=%d "
+           "test_skip=0x%x sgid_index=%d roce_v%d pin=%zu",
+           nrc, ibgda_t1.hold_ms, ibgda_t1.round_ms, ibgda_t1.quiesce_ms, ibgda_t1.handshake_ms,
+           ibgda_t1.gid_wait_ms, ibgda_t1.copy_ms, ibgda_t1.skip,
+           ((struct ibgda_device *)st->common.devices + st->selected_dev_ids[0])
+               ->common_device.gid_info[st->selected_port_ids[0] - 1].local_gid_index,
+           ibgda_t1.gid_ver.empty() ? 0 : ibgda_t1.gid_ver[0], ibgda_t1.pin_bytes);
+    return 0;
+}
+
+/* Teardown: stop the helper (a round in progress declines at its next bounded wait), close the
+ * sockets, fail every gate so that a device wait still held returns. Nothing the device may still
+ * read is freed. */
+static void t1_fini() {
+    if (!ibgda_t1.on) return;
+    ibgda_t1.stop.store(true);
+    t1_join_helper();
+    for (uint32_t gi = 0; gi < ibgda_t1.ngates; gi++) t1_hflag_fail(gi); /* reaches held waits without a copy */
+    for (size_t p = 0; p < ibgda_t1.fd.size(); p++)
+        if (ibgda_t1.fd[p] >= 0) {
+            close(ibgda_t1.fd[p]);
+            ibgda_t1.fd[p] = -1;
+        }
+    if (ibgda_t1.ls >= 0) close(ibgda_t1.ls);
+    ibgda_t1.ls = -1;
+    /* no round can follow: fail every gate, so that a device wait still held returns at once */
+    for (uint32_t gi = 0; gi < ibgda_t1.ngates; gi++) {
+        nvshmemi_ibgda_ft_gate_t g;
+        if (t1_gate_read(gi, &g)) break;
+        if (!(t1_hi(g) & NVSHMEMI_IBGDA_FT_T1_FAILED))
+            t1_gate_write_hi(gi, NVSHMEMI_IBGDA_FT_T1_FAILED | t1_hi(g));
+    }
+    t1_log("teardown: rounds recovered %u, declined %u", ibgda_t1.rounds_ok.load(),
+           ibgda_t1.rounds_declined.load());
+    ibgda_t1.on = false;
+}
