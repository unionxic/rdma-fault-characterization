+/* ---------------------------------------------------------------------------------------------
+ * NVSHMEM_IBGDA_FT (research, default off; host env NVSHMEM_IBGDA_FT=1 sets state->ft).
+ * Device-side classification of the root-cause error CQE on the collapsed send CQ. Every poll of
+ * a send CQ also looks at the slot's opcode while it spins; the first error CQE seen on a QP is
+ * snapshotted before the trailing flushes (5/0xf9, ~59 us later) overwrite it, kept as a sticky
+ * per-QP record in mvars, and published to a host-mapped mailbox. Waits on a failed QP return an
+ * error instead of spinning or reporting success. With state->ft == NULL nothing below runs.
+ * ------------------------------------------------------------------------------------------- */
+__device__ NVSHMEMI_STATIC NVSHMEMI_DEVICE_ALWAYS_INLINE nvshmemi_ibgda_ft_dev_t *ibgda_ft_dev() {
+    return (nvshmemi_ibgda_ft_dev_t *)ibgda_get_state()->ft;
+}
+
+__device__ NVSHMEMI_STATIC NVSHMEMI_DEVICE_ALWAYS_INLINE uint64_t ibgda_ft_globaltimer() {
+    uint64_t t;
+    asm volatile("mov.u64 %0, %%globaltimer;" : "=l"(t)::"memory");
+    return t;
+}
+
+/* The CQ struct points into the QP's mvars (cons_idx); recover the mvars from it. */
+__device__ NVSHMEMI_STATIC NVSHMEMI_DEVICE_ALWAYS_INLINE nvshmemi_ibgda_device_qp_management_t *
+ibgda_ft_mvars_of_cq(const nvshmemi_ibgda_device_cq_t *cq) {
+    return (nvshmemi_ibgda_device_qp_management_t *)((uintptr_t)cq->cons_idx -
+                                                     __builtin_offsetof(
+                                                         nvshmemi_ibgda_device_qp_management_t,
+                                                         tx_wq.cons_idx));
+}
+
+/* T1 helpers (see the T1 section below). */
+/* Build-time knob (flag-off latency study, TRANSPARENT_T1.md): bit 0 = post hooks (reserve, submit,
+ * submit_ready), bit 1 = wait hooks (quiet, quiet_status, quiet_with_cst), bit 2 = the rest
+ * (status, bounded quiet, sentinel). 0 compiles every T1 device path out: the device code is then
+ * v2.2's, and NVSHMEM_IBGDA_FT_TRANSPARENT=1 is refused at init. */
+#ifndef NVSHMEMI_IBGDA_T1_DEVICE
+#define NVSHMEMI_IBGDA_T1_DEVICE 7
+#endif
+__device__ NVSHMEMI_STATIC NVSHMEMI_DEVICE_ALWAYS_INLINE bool ibgda_t1_on() {
+    return (NVSHMEMI_IBGDA_T1_DEVICE != 0) &&
+           (ibgda_get_state()->ft_flags & NVSHMEMI_IBGDA_FT_FLAG_T1) != 0;
+}
+__device__ NVSHMEMI_STATIC NVSHMEMI_DEVICE_ALWAYS_INLINE bool ibgda_t1_on_post() {
+    return (NVSHMEMI_IBGDA_T1_DEVICE & 1) && ibgda_t1_on();
+}
+__device__ NVSHMEMI_STATIC NVSHMEMI_DEVICE_ALWAYS_INLINE bool ibgda_t1_on_wait() {
+    return (NVSHMEMI_IBGDA_T1_DEVICE & 2) && ibgda_t1_on();
+}
+
+/* Gate of an RC QP, or NULL (DCI, or T1 off). Callers test ibgda_t1_on() first. */
+__device__ NVSHMEMI_STATIC NVSHMEMI_DEVICE_ALWAYS_INLINE nvshmemi_ibgda_ft_gate_t *ibgda_t1_gate(
+    const nvshmemi_ibgda_device_qp_t *qp) {
+    CONSTANT_ADDRESS_SPACE nvshmemi_ibgda_device_state_t *state = ibgda_get_state();
+    const uintptr_t off = (uintptr_t)qp - (uintptr_t)state->globalmem.rcs;
+    if (off >= (uintptr_t)state->ft_ngates * sizeof(nvshmemi_ibgda_device_qp_t)) return nullptr;
+    return (nvshmemi_ibgda_ft_gate_t *)state->ft_gates + off / sizeof(nvshmemi_ibgda_device_qp_t);
+}
+
+__device__ NVSHMEMI_STATIC NVSHMEMI_DEVICE_ALWAYS_INLINE nvshmemi_ibgda_device_qp_t *ibgda_t1_qp_of_cq(
+    const nvshmemi_ibgda_device_cq_t *cq) {
+    return (nvshmemi_ibgda_device_qp_t *)((uintptr_t)ibgda_ft_mvars_of_cq(cq) -
+                                          __builtin_offsetof(nvshmemi_ibgda_device_qp_t, mvars));
+}
+
+__device__ NVSHMEMI_STATIC NVSHMEMI_DEVICE_ALWAYS_INLINE uint32_t *ibgda_t1_hi(
+    nvshmemi_ibgda_ft_gate_t *g) {
+    return (uint32_t *)&g->word + 1; /* little endian: the epoch half */
+}
+
+__device__ NVSHMEMI_STATIC NVSHMEMI_DEVICE_ALWAYS_INLINE bool ibgda_ft_is_err_opcode(uint8_t opown) {
+    uint8_t op = opown >> 4;
+    return op == MLX5_CQE_REQ_ERR || op == MLX5_CQE_RESP_ERR;
+}
+
+__device__ NVSHMEMI_STATIC NVSHMEMI_DEVICE_ALWAYS_INLINE uint8_t ibgda_ft_classify(uint8_t syndrome,
+                                                                                 uint8_t vendor) {
+    switch (syndrome) {
+        case 0x05:
+            return vendor == 0xf5   ? NVSHMEMI_IBGDA_FT_CLASS_LOCAL_QP_ERR
+                   : vendor == 0xf9 ? NVSHMEMI_IBGDA_FT_CLASS_FLUSH_TRAILING
+                                    : NVSHMEMI_IBGDA_FT_CLASS_FLUSH_OTHER;
+        case 0x04: return NVSHMEMI_IBGDA_FT_CLASS_LOC_PROT;
+        case 0x12: return NVSHMEMI_IBGDA_FT_CLASS_REM_INV_REQ;
+        case 0x13: return NVSHMEMI_IBGDA_FT_CLASS_REM_ACCESS;
+        case 0x15: return NVSHMEMI_IBGDA_FT_CLASS_RETRY_EXC;
+        case 0x16: return NVSHMEMI_IBGDA_FT_CLASS_RNR_RETRY_EXC;
+        case 0x01: return NVSHMEMI_IBGDA_FT_CLASS_LOC_LEN;
+        case 0x02: return NVSHMEMI_IBGDA_FT_CLASS_LOC_QP_OP;
+        case 0x14: return NVSHMEMI_IBGDA_FT_CLASS_REM_OP;
+        case 0x22: return NVSHMEMI_IBGDA_FT_CLASS_REM_ABORT;
+        case 0x11: return NVSHMEMI_IBGDA_FT_CLASS_LOC_ACCESS;
+        case 0x10: return NVSHMEMI_IBGDA_FT_CLASS_BAD_RESP;
+        default: return NVSHMEMI_IBGDA_FT_CLASS_OTHER;
+    }
+}
+
+__device__ NVSHMEMI_STATIC NVSHMEMI_DEVICE_ALWAYS_INLINE void ibgda_ft_st_sys32(uint32_t *p,
+                                                                              uint32_t v) {
+    asm volatile("st.relaxed.sys.global.u32 [%0], %1;" ::"l"(p), "r"(v) : "memory");
+}
+
+__device__ NVSHMEMI_STATIC NVSHMEMI_DEVICE_ALWAYS_INLINE uint32_t ibgda_ft_ld_u32(const void *p) {
+    uint32_t v;
+    asm volatile("ld.volatile.global.u32 %0, [%1];" : "=r"(v) : "l"(p) : "memory");
+    return v;
+}
+
+/* True once any error was recorded (or is being recorded) for the QP behind this CQ. */
+__device__ NVSHMEMI_STATIC NVSHMEMI_DEVICE_ALWAYS_INLINE bool ibgda_ft_cq_failed(
+    const nvshmemi_ibgda_device_cq_t *cq) {
+    return ibgda_atomic_read(&ibgda_ft_mvars_of_cq(cq)->ft_state) != 0;
+}
+
+/* Publish one 256-byte record (64 words, words 0 and 1 ignored) to the host mailbox: invalidate
+ * magic, body with system-scope stores, fence, seq, fence, magic. Cold path. */
+__device__ __noinline__ static void ibgda_ft_mbox_publish(nvshmemi_ibgda_ft_dev_t *ft,
+                                                          const uint32_t *w) {
+    nvshmemi_ibgda_ft_record_t *mbox = *(nvshmemi_ibgda_ft_record_t *volatile *)&ft->mbox;
+    const uint32_t nslots = *(volatile uint32_t *)&ft->nslots;
+    if (mbox == nullptr || nslots == 0) return;
+    const uint32_t seq = atomicAdd(&ft->seq, 1u) + 1u;
+    uint32_t *dst = (uint32_t *)(mbox + ((seq - 1u) % nslots));
+    ibgda_ft_st_sys32(&dst[0], 0u);
+    __threadfence_system();
+    for (int i = 2; i < (int)(sizeof(nvshmemi_ibgda_ft_record_t) / 4); i++)
+        ibgda_ft_st_sys32(&dst[i], w[i]);
+    __threadfence_system();
+    ibgda_ft_st_sys32(&dst[1], seq);
+    __threadfence_system();
+    ibgda_ft_st_sys32(&dst[0], NVSHMEMI_IBGDA_FT_MAGIC);
+    __threadfence_system();
+}
+
+/* Which QP owns these management variables: index into globalmem.rcs / dcis, type, peer. */
+__device__ NVSHMEMI_STATIC NVSHMEMI_DEVICE_ALWAYS_INLINE void ibgda_ft_qp_of_mvars(
+    const nvshmemi_ibgda_device_qp_management_t *mv, uint32_t *qp_index, uint8_t *qp_type,
+    int32_t *peer) {
+    CONSTANT_ADDRESS_SPACE nvshmemi_ibgda_device_state_t *state = ibgda_get_state();
+    uintptr_t qp_addr = (uintptr_t)mv - __builtin_offsetof(nvshmemi_ibgda_device_qp_t, mvars);
+    uint32_t ndcis = state->num_shared_dcis + state->num_exclusive_dcis;
+    uintptr_t dci0 = (uintptr_t)state->globalmem.dcis;
+    *peer = -1;
+    if (dci0 && qp_addr >= dci0 && qp_addr < dci0 + ndcis * sizeof(nvshmemi_ibgda_device_qp_t)) {
+        *qp_index = (uint32_t)((qp_addr - dci0) / sizeof(nvshmemi_ibgda_device_qp_t));
+        *qp_type = NVSHMEMI_IBGDA_DEVICE_QP_TYPE_DCI;
+    } else {
+        *qp_index = (uint32_t)((qp_addr - (uintptr_t)state->globalmem.rcs) /
+                               sizeof(nvshmemi_ibgda_device_qp_t));
+        *qp_type = NVSHMEMI_IBGDA_DEVICE_QP_TYPE_RC;
+        *peer = (int32_t)(*qp_index % (uint32_t)nvshmemi_device_state_d.npes);
+    }
+}
+
+/* v2.1: park the QP behind these management variables. A QP with a recorded error (CQE error or
+ * ring invariant; not a bounds record, whose QP is healthy) should not be posted to any more: the
+ * slot wait fails fast after an error, and v2 went on writing WQEs and ringing the doorbell far past
+ * the NIC's flush point (up to 16 queues); the NIC then stopped flushing (measured) and the
+ * recovery drain never completed. Parking sets bit 63 of prod_idx (NVSHMEMI_IBGDA_FT_PARK_MARK):
+ * every later ibgda_post_send's atomicMax returns a larger old value, so it neither writes the
+ * doorbell record nor rings (posts are dropped; on a failed QP they would only be flushed). The
+ * low 63 bits keep the last index that was rung (atomicOr, not atomicMax), for reports. Recovery
+ * zeroes prod_idx and so un-parks.
+ *
+ * Memory-model scope (v2.1, third review). The park is a device-scope (.gpu) atomicOr, and it may
+ * run in any CTA or kernel: a poster's own wait, another CTA's quiet, or the sentinel kernel.
+ * Every other read-modify-write of prod_idx must then be a device-scope atomic too, or the
+ * accesses race formally. They are, on every QP this function parks:
+ *   - RC QPs: ibgda_get_rc() always reports shared_among_ctas = true (also through
+ *     ibgda_get_amo_qp and the qp_index APIs), so every post on an RC QP goes through
+ *     ibgda_submit_requests<true> -> ibgda_post_send<true> / ibgda_proxy_post_send<true>, a
+ *     device-scope atomicMax; ibgda_submit_ready (bounded quiet) always uses <true>.
+ *   - Shared DCIs: the same (<true>).
+ * The only block-scope RMW of prod_idx (atomicMax_block in ibgda_post_send<false>) is on an
+ * exclusive DCI: index < num_exclusive_dcis under the CTA or WARP DCI map (ibgda_get_dci), posted
+ * by its owning CTA. Such a DCI is never parked here: it keeps the v2 behaviour (fail-fast posts
+ * reach the NIC and are flushed). No instruction is added to any post path. */
+__device__ NVSHMEMI_STATIC NVSHMEMI_DEVICE_ALWAYS_INLINE void ibgda_ft_park(
+    nvshmemi_ibgda_device_qp_management_t *mv, uint8_t qp_type, uint32_t qp_index) {
+    CONSTANT_ADDRESS_SPACE nvshmemi_ibgda_device_state_t *state = ibgda_get_state();
+    if (!(state->ft_flags & NVSHMEMI_IBGDA_FT_FLAG_PARK)) return;
+    if (qp_type == NVSHMEMI_IBGDA_DEVICE_QP_TYPE_DCI && qp_index < state->num_exclusive_dcis &&
+        (state->dci_map_type == NVSHMEMI_IBGDA_DEVICE_QP_MAP_TYPE_CTA ||
+         state->dci_map_type == NVSHMEMI_IBGDA_DEVICE_QP_MAP_TYPE_WARP))
+        return; /* posted with block scope by its owning CTA: do not mix scopes */
+    atomicOr((unsigned long long int *)&mv->tx_wq.prod_idx,
+             (unsigned long long int)NVSHMEMI_IBGDA_FT_PARK_MARK);
+}
+
+/* Snapshot the error CQE at `slot` (slot 0 of a collapsed CQ, or the ring slot at consumer
+ * counter ring_ci), record it as the QP's sticky first error and publish it to the host mailbox.
+ * Cold path: kept out of line so the poll loops stay small. Returns the syndrome. */
+__device__ __noinline__ static int ibgda_ft_capture(const nvshmemi_ibgda_device_cq_t *cq,
+                                                    const void *slot, uint64_t poll_idx,
+                                                    uint32_t path, uint64_t ring_ci) {
+    nvshmemi_ibgda_ft_dev_t *ft = ibgda_ft_dev();
+    const uint32_t *cw = (const uint32_t *)slot; /* 16 words of the CQE */
+    uint32_t w[16];
+    uint32_t tries = 0;
+
+    /* Consistent snapshot: word 15 (wqe_counter, signature, op_own) must be the same before and
+     * after the 64 bytes are read; a trailing flush that lands meanwhile changes it (collapsed
+     * CQ). A ring slot does not change before the next lap. */
+    for (;;) {
+        uint32_t a = ibgda_ft_ld_u32(&cw[15]);
+#pragma unroll
+        for (int i = 0; i < 16; i++) w[i] = ibgda_ft_ld_u32(&cw[i]);
+        uint32_t b = ibgda_ft_ld_u32(&cw[15]);
+        tries++;
+        if (a == b && a == w[15]) break;
+        if (tries >= 8) break;
+    }
+    /* Little-endian words: byte 4k+j is bits 8j..8j+7 of w[k]. */
+    const uint8_t opown = (uint8_t)(w[15] >> 24);                            /* byte 63 */
+    const uint8_t syndrome = (uint8_t)(w[13] >> 24);                         /* byte 55 */
+    const uint8_t vendor = (uint8_t)(w[13] >> 16);                           /* byte 54 */
+    const uint8_t hw_err = (uint8_t)w[13];                                   /* byte 52 */
+    const uint8_t hw_type = (uint8_t)(w[13] >> 8);                           /* byte 53 */
+    const uint16_t wqe = (uint16_t)(((w[15] & 0xffu) << 8) | ((w[15] >> 8) & 0xffu)); /* 60-61 BE */
+    const uint32_t sqpn = __byte_perm(w[14], 0, 0x0123);                     /* 56-59 BE */
+    if (!ibgda_ft_is_err_opcode(opown)) {
+        /* The slot changed to a non-error CQE between the caller's read and ours: nothing to
+         * record here (cannot happen after a QP error; defensive). */
+        return 0;
+    }
+    const uint8_t cls = ibgda_ft_classify(syndrome, vendor);
+    const bool trailing = (cls == NVSHMEMI_IBGDA_FT_CLASS_FLUSH_TRAILING);
+
+    nvshmemi_ibgda_device_qp_management_t *mv = ibgda_ft_mvars_of_cq(cq);
+    bool upgrade = false;
+    uint32_t old = atomicCAS(&mv->ft_state, 0u, 1u);
+    if (old != 0u) {
+        /* Already recorded. A record that holds only a trailing flush may be replaced by a root
+         * cause seen later by another poller (for example the sentinel). */
+        if (old == 3u && !trailing && atomicCAS(&mv->ft_state, 3u, 1u) == 3u) {
+            upgrade = true;
+        } else {
+            return syndrome;
+        }
+    }
+    const uint64_t gt = ibgda_ft_globaltimer();
+    mv->ft_fp = ((uint32_t)(opown >> 4) << 24) | ((uint32_t)syndrome << 16) |
+                ((uint32_t)vendor << 8) | cls;
+    mv->ft_wqe = (uint32_t)wqe | ((uint32_t)(poll_idx & 0xffff) << 16);
+    mv->ft_aux = sqpn;
+    __threadfence();
+    atomicExch(&mv->ft_state, trailing ? 3u : 2u);
+    if (!upgrade) atomicAdd(&ft->nerr, 1u);
+
+    uint32_t qp_index;
+    uint8_t qp_type;
+    int32_t peer;
+    ibgda_ft_qp_of_mvars(mv, &qp_index, &qp_type, &peer);
+    uint32_t r[sizeof(nvshmemi_ibgda_ft_record_t) / 4];
+#pragma unroll
+    for (int i = 0; i < (int)(sizeof(r) / 4); i++) r[i] = 0u;
+    r[2] = cq->qpn;
+    r[3] = sqpn;
+    r[4] = (uint32_t)wqe | ((uint32_t)syndrome << 16) | ((uint32_t)vendor << 24);
+    r[5] = (uint32_t)cls | (1u << 8) | ((path & 0xffu) << 16) | ((uint32_t)qp_type << 24);
+    r[6] = (uint32_t)hw_err | ((uint32_t)hw_type << 8) | ((uint32_t)(opown >> 4) << 16) |
+           ((upgrade ? 1u : 0u) << 24);
+    r[7] = (uint32_t)nvshmemi_device_state_d.mype;
+    r[8] = (uint32_t)peer;
+    r[9] = qp_index;
+    const uint64_t vals[6] = {poll_idx,
+                              ibgda_atomic_read(cq->cons_idx),
+                              ibgda_atomic_read(cq->prod_idx),
+                              ibgda_atomic_read(cq->ready_head),
+                              ibgda_atomic_read(cq->resv_head),
+                              gt};
+#pragma unroll
+    for (int i = 0; i < 6; i++) {
+        r[10 + 2 * i] = (uint32_t)vals[i];
+        r[11 + 2 * i] = (uint32_t)(vals[i] >> 32);
+    }
+    r[22] = tries;
+#pragma unroll
+    for (int i = 0; i < 16; i++) r[24 + i] = w[i];
+    const bool ring = (ibgda_get_state()->ft_flags & NVSHMEMI_IBGDA_FT_FLAG_RING_CQ) != 0;
+    r[40] = (uint32_t)ring_ci;
+    r[41] = (uint32_t)(ring_ci >> 32);
+    r[49] = ring ? 1u : 0u;
+    r[52] = ibgda_get_ctaid(); /* v2.1: who records (and parks) */
+    r[53] = nvshmemi_thread_id_in_threadgroup<NVSHMEMI_THREADGROUP_BLOCK>();
+    r[54] = ibgda_get_smid();
+    if (ibgda_t1_on()) { /* T1: the gate epoch the error belongs to */
+        nvshmemi_ibgda_ft_gate_t *g = ibgda_t1_gate(ibgda_t1_qp_of_cq(cq));
+        if (g != nullptr) {
+            r[55] = ibgda_atomic_read(ibgda_t1_hi(g));
+            r[56] = 1u;
+        }
+    }
+    ibgda_ft_park(mv, qp_type, qp_index); /* v2.1: after the record's snapshot of prod_idx */
+    ibgda_ft_mbox_publish(ft, r);
+    return syndrome;
+}
+
+/* ---------------------------------------------------------------------------------------------
+ * v2 (A) ring-CQ mode, NVSHMEM_IBGDA_FT_RING_CQ=1: the send CQs are created non-collapsed (cc=0,
+ * oi=1), so the NIC writes CQE number k to slot k & (ncqes - 1) with owner bit !!(k & ncqes) and
+ * never overwrites an unconsumed CQE while at most ncqes CQEs are outstanding (flow control: the
+ * device posts WQE w only after cons_idx > w - nwqes, and nwqes <= ncqes). The consumer counter k
+ * lives in mvars.ft_ring_ci. A waiter walks the ring in order: a success CQE is consumed with a
+ * CAS on the counter (the winner, and only it, advances cons_idx from the CQE's wqe_counter); an
+ * error CQE is never consumed. So the first error CQE of a QP (its root cause) stays at the
+ * consumer position until recovery, every poll that reaches it records it and fails, and no
+ * sentinel or in-loop timing is needed. Exact 64-bit cons_idx: the CAS winner of CQE k reads
+ * cons_idx after the CAS; every CQE before k was claimed earlier and no later one yet, so
+ * w + 1 - nwqes <= cons_idx <= w (w = the CQE's WQE index) and d = (uint16)(wqe_counter + 1 -
+ * cons_idx) is the exact advance, 1 <= d <= nwqes <= ncqes. A d outside that range means the
+ * invariant is broken (bug or memory corruption): v2.1 records it (class RING_INVARIANT) and fails
+ * this and every later wait on the QP, instead of consuming the CQE silently (v2), which left the
+ * waiter spinning for a completion that had been consumed.
+ * No lap before the root cause is recorded, even with fail-fast posting: after an error cons_idx
+ * stops at the failing WQE w_err (error CQEs are never consumed), and a WQE with index >= cons_idx
+ * + nwqes can only be reserved after the slot wait (ibgda_wait_for_slot_availability) polled this
+ * ring, and that poll records the root cause before it returns -1 and lets posting continue. So
+ * at most nwqes CQEs (one per WQE in [w_err, cons_idx + nwqes)) are written from the root cause on
+ * before it is recorded, and slot k is rewritten only by CQE k + ncqes (nwqes == ncqes here, both
+ * round_up_pow2(QP_DEPTH); checked at init).
+ * ------------------------------------------------------------------------------------------- */
+/* v2.1: a consumed CQE broke the ring-walk invariant. Record it (sticky record with opcode 0xf so
+ * that every later wait on the QP fails, and a mailbox record the host logs). Cold path. */
+__device__ __noinline__ static void ibgda_ft_ring_invariant(const nvshmemi_ibgda_device_cq_t *cq,
+                                                            uint64_t idx, uint64_t ci, uint32_t w15,
+                                                            uint64_t cons, uint32_t d,
+                                                            uint32_t path) {
+    nvshmemi_ibgda_ft_dev_t *ft = ibgda_ft_dev();
+    if (ft == nullptr) return;
+    nvshmemi_ibgda_device_qp_management_t *mv = ibgda_ft_mvars_of_cq(cq);
+    const uint16_t wc = BSWAP16((uint16_t)(w15 & 0xffffu));
+    const uint8_t cls = NVSHMEMI_IBGDA_FT_CLASS_RING_INVARIANT;
+    const uint32_t old = atomicCAS(&mv->ft_state, 0u, 1u);
+    const bool first = (old == 0u);
+    if (first) {
+        mv->ft_fp = (0xfu << 24) | cls; /* opcode 0xf: not a CQE error, but it fails later waits */
+        mv->ft_wqe = (uint32_t)wc | ((uint32_t)(idx & 0xffff) << 16);
+        mv->ft_aux = d;
+        __threadfence();
+        atomicExch(&mv->ft_state, 2u);
+        atomicAdd(&ft->nerr, 1u);
+    }
+    uint32_t qp_index;
+    uint8_t qp_type;
+    int32_t peer;
+    ibgda_ft_qp_of_mvars(mv, &qp_index, &qp_type, &peer);
+    uint32_t r[sizeof(nvshmemi_ibgda_ft_record_t) / 4];
+#pragma unroll
+    for (int i = 0; i < (int)(sizeof(r) / 4); i++) r[i] = 0u;
+    r[2] = cq->qpn;
+    r[4] = (uint32_t)wc;
+    r[5] = (uint32_t)cls | (3u << 8) | ((path & 0xffu) << 16) | ((uint32_t)qp_type << 24);
+    r[6] = (0xfu << 16) | (first ? 0u : (1u << 24));
+    r[7] = (uint32_t)nvshmemi_device_state_d.mype;
+    r[8] = (uint32_t)peer;
+    r[9] = qp_index;
+    const uint64_t vals[6] = {idx,
+                              cons,
+                              ibgda_atomic_read(cq->prod_idx),
+                              ibgda_atomic_read(cq->ready_head),
+                              ibgda_atomic_read(cq->resv_head),
+                              ibgda_ft_globaltimer()};
+#pragma unroll
+    for (int i = 0; i < 6; i++) {
+        r[10 + 2 * i] = (uint32_t)vals[i];
+        r[11 + 2 * i] = (uint32_t)(vals[i] >> 32);
+    }
+    r[39] = w15; /* word 15 of the consumed CQE (root_cqe[60..63]) */
+    r[40] = (uint32_t)ci;
+    r[41] = (uint32_t)(ci >> 32);
+    r[49] = 1u;
+    r[50] = d;
+    r[51] = cq->ncqes;
+    r[52] = ibgda_get_ctaid();
+    r[53] = nvshmemi_thread_id_in_threadgroup<NVSHMEMI_THREADGROUP_BLOCK>();
+    r[54] = ibgda_get_smid();
+    if (ibgda_t1_on()) {
+        nvshmemi_ibgda_ft_gate_t *g = ibgda_t1_gate(ibgda_t1_qp_of_cq(cq));
+        if (g != nullptr) {
+            r[55] = ibgda_atomic_read(ibgda_t1_hi(g));
+            r[56] = 1u;
+        }
+    }
+    ibgda_ft_park(mv, qp_type, qp_index);
+    ibgda_ft_mbox_publish(ft, r);
+}
+
+/* v2.1 test-only (NVSHMEM_IBGDA_FT_TEST_TRIP): force d = 0 on the consumption that brings the
+ * countdown to 0. Returns the (possibly forced) d and whether to emulate v2's silent skip. */
+__device__ __noinline__ static uint32_t ibgda_ft_test_trip(uint32_t d, bool *silent) {
+    nvshmemi_ibgda_ft_dev_t *ft = ibgda_ft_dev();
+    *silent = false;
+    if (ft == nullptr) return d;
+    if (atomicSub(&ft->test_trip, 1u) != 1u) return d;
+    *silent = (*(volatile uint32_t *)&ft->test_trip_mode == 2u);
+    return 0u;
+}
+
+__device__ NVSHMEMI_STATIC NVSHMEMI_DEVICE_ALWAYS_INLINE int ibgda_ft_ring_poll(
+    nvshmemi_ibgda_device_cq_t *cq, uint64_t idx, int *error, uint32_t path, long long t0,
+    long long budget) {
+    nvshmemi_ibgda_device_qp_management_t *mv = ibgda_ft_mvars_of_cq(cq);
+    const uint32_t ncqes = cq->ncqes;
+    const uintptr_t base = (uintptr_t)cq->cqe;
+    unsigned long long *ci_p = (unsigned long long *)&mv->ft_ring_ci;
+    uint64_t ci = ibgda_atomic_read((uint64_t *)ci_p);
+    uint32_t spins = 0;
+    for (;;) {
+        const uintptr_t slot = base + ((uintptr_t)(ci & (ncqes - 1)) << 6);
+        const uint32_t w15 = ibgda_atomic_read((uint32_t *)(slot + 60));
+        const uint8_t opown = (uint8_t)(w15 >> 24);
+        const bool valid = ((opown >> 4) != MLX5_CQE_INVALID) &&
+                           ((uint32_t)(opown & 1u) == ((ci & ncqes) ? 1u : 0u));
+        if (valid) {
+            if (unlikely(ibgda_ft_is_err_opcode(opown))) {
+                IBGDA_MFENCE();
+                *error = ibgda_ft_capture(cq, (const void *)slot, idx, path, ci);
+                return -1;
+            }
+            if (atomicCAS(ci_p, (unsigned long long)ci, (unsigned long long)(ci + 1)) == ci) {
+                const uint16_t wc = BSWAP16((uint16_t)(w15 & 0xffffu));
+                const uint64_t cons = ibgda_atomic_read(cq->cons_idx);
+                uint32_t d = (uint16_t)(wc + 1u - (uint16_t)cons);
+                bool silent = false;
+                if (unlikely(ibgda_get_state()->ft_flags & NVSHMEMI_IBGDA_FT_FLAG_TEST_TRIP))
+                    d = ibgda_ft_test_trip(d, &silent);
+                ci++;
+                if (likely(d != 0 && d <= ncqes)) {
+                    atomicMax((unsigned long long int *)cq->cons_idx,
+                              (unsigned long long int)(cons + d));
+                    /* Done as soon as this wait is satisfied: a later CQE (possibly an error of a
+                     * later operation) is left to the next wait. */
+                    if (cons + d >= idx) return 0;
+                } else if (!silent) {
+                    /* v2.1: record the broken invariant and fail (v2 skipped it silently). */
+                    ibgda_ft_ring_invariant(cq, idx, ci - 1, w15, cons, d, path);
+                    *error = -1;
+                    return -1;
+                }
+            } else {
+                ci = ibgda_atomic_read((uint64_t *)ci_p);
+            }
+            continue;
+        }
+        if (ibgda_atomic_read(cq->cons_idx) >= idx) return 0;
+        if (unlikely(((++spins) & 0xffu) == 0u)) {
+            /* Another thread may have consumed past our position; a QP whose error CQE was
+             * recorded by another poller (and whose ring was reused after it) fails here. A
+             * library record (opcode 0: bounds check, healthy QP) does not fail a wait. */
+            ci = ibgda_atomic_read((uint64_t *)ci_p);
+            if (ibgda_atomic_read(&mv->ft_state) >= 2u && (ibgda_atomic_read(&mv->ft_fp) >> 24) != 0u)
+                return -1;
+            if (budget > 0 && clock64() - t0 > budget) return -2;
+        }
+    }
+}
+
+/* ---------------------------------------------------------------------------------------------
+ * T1 (NVSHMEM_IBGDA_FT_TRANSPARENT=1, with FT, RING_CQ and park): transparent recovery of RC QPs.
+ * The library's helper thread (host) recovers a failed QP pair while the application's kernels keep
+ * running; nothing of this reaches the application unless the recovery is declined.
+ *
+ * Device side, per RC QP (gate: nvshmemi_ibgda_ft_gate_t, see nvshmem_common_ibgda.h):
+ *  - Posters are counted from reserve to submit (ibgda_t1_enter / ibgda_t1_leave: one 64-bit
+ *    atomicAdd on the gate word, whose return value carries the epoch; a poster that finds a
+ *    recovery in progress backs out before reserving WQE slots and waits). Word layout: epoch (32)
+ *    | counted (32); the host rewrites QP state only when nothing is counted.
+ *  - A counted poster that cannot progress until the recovery is done (slot wait on a failed QP,
+ *    or the ready CAS behind a poster that is held) leaves the counted region (ibgda_t1_hold) and
+ *    writes nothing until the next stable epoch; then it shifts its reservation by delta = off_new -
+ *    off_old. The host moves the whole send ring by the same delta, so WQEs a held poster already
+ *    wrote are at the right slot.
+ *  - Waiters (quiet, fence, fetch waits) are not counted. They keep a logical ticket L = D - off
+ *    taken in one stable epoch, validate every completion they observe against that epoch
+ *    (seqlock: cons_idx is read, then the epoch; the host changes the epoch before it rewrites
+ *    anything), and wait across a recovery for the next stable epoch, then wait for D = L + off.
+ *    A waiter enters the counted region only to record an error CQE (capture + park).
+ *  - Device indices only grow: a recovery moves them to B = the next multiple of 65536 above every
+ *    old index, so a stale atomicMax from before the recovery is a no-op, and the NIC's own WQE
+ *    counter (restarted at 0 by 2RST) equals D mod 65536 again.
+ *  - Every wait that can outlast a recovery is bounded (ft_dev->t1_hold_ns, then the give-up
+ *    handshake with the host's commit point); giving up fails the QP (dfailed) and parks it.
+ * ------------------------------------------------------------------------------------------- */
+enum { IBGDA_T1_DONE = 0, IBGDA_T1_RESYNC = 1, IBGDA_T1_FAILED = -1 };
+
+__device__ NVSHMEMI_STATIC NVSHMEMI_DEVICE_ALWAYS_INLINE uint32_t ibgda_t1_ld_acq32(const void *p) {
+    uint32_t v;
+    asm volatile("ld.acquire.gpu.global.u32 %0, [%1];" : "=r"(v) : "l"(p) : "memory");
+    return v;
+}
+
+__device__ NVSHMEMI_STATIC NVSHMEMI_DEVICE_ALWAYS_INLINE uint64_t ibgda_t1_ld_acq64(const void *p) {
+    uint64_t v;
+    asm volatile("ld.acquire.gpu.global.u64 %0, [%1];" : "=l"(v) : "l"(p) : "memory");
+    return v;
+}
+
+/* The host's decline mirror: a host-mapped word the host writes without a CUDA call (its copies to
+ * the gate may stall behind a GPU that is full, see TRANSPARENT_T1.md). Read over PCIe, so only from
+ * the slow paths (a held wait, every few thousand polls). When it is set, the FAILED bit is also put
+ * into the gate so that every fast path sees it from then on. */
+__device__ __noinline__ static bool ibgda_t1_hflag_failed(nvshmemi_ibgda_ft_gate_t *g) {
+    const uint64_t p = ibgda_atomic_read((uint64_t *)&g->hflag);
+    if (p == 0ull) return false;
+    uint32_t v;
+    asm volatile("ld.relaxed.sys.global.u32 %0, [%1];" : "=r"(v) : "l"(p) : "memory");
+    if (v == 0u) return false;
+    atomicOr(ibgda_t1_hi(g), NVSHMEMI_IBGDA_FT_T1_FAILED);
+    return true;
+}
+
+/* Leave the counted region: every write before it (WQEs, indices, doorbell record, CQ consumption)
+ * is visible before the count drops. */
+__device__ NVSHMEMI_STATIC NVSHMEMI_DEVICE_ALWAYS_INLINE void ibgda_t1_leave(
+    nvshmemi_ibgda_ft_gate_t *g) {
+    asm volatile("red.release.gpu.global.add.u64 [%0], %1;" ::"l"(&g->word),
+                 "l"((unsigned long long)-1LL)
+                 : "memory");
+}
+
+__device__ NVSHMEMI_STATIC NVSHMEMI_DEVICE_ALWAYS_INLINE bool ibgda_t1_failed(
+    nvshmemi_ibgda_ft_gate_t *g, uint32_t hi) {
+    return (hi & NVSHMEMI_IBGDA_FT_T1_FAILED) || ibgda_atomic_read(&g->dfailed);
+}
+
+/* A QP whose recovery failed is parked (posts after the failure never ring). RC QPs are always
+ * posted with device-scope atomics (see ibgda_ft_park). */
+__device__ NVSHMEMI_STATIC NVSHMEMI_DEVICE_ALWAYS_INLINE void ibgda_t1_fail_park(
+    nvshmemi_ibgda_device_qp_t *qp) {
+    atomicOr((unsigned long long int *)&qp->mvars.tx_wq.prod_idx,
+             (unsigned long long int)NVSHMEMI_IBGDA_FT_PARK_MARK);
+}
+
+/* Give-up handshake (bound expired while waiting for the recovery that follows epoch `seen`).
+ * Device: abandoned = next; fence.sc.sys; read commit. Host (before its first device-visible
+ * write): commit = next; read abandoned. Either the host sees the give-up and declines without
+ * touching device state, or this thread sees that the host passed its commit point and waits one
+ * more bound. Returns true to keep waiting. */
+__device__ __noinline__ static bool ibgda_t1_giveup(nvshmemi_ibgda_ft_gate_t *g, uint32_t seen,
+                                                    bool second, nvshmemi_ibgda_device_qp_t *qp) {
+    const uint32_t next = (seen | NVSHMEMI_IBGDA_FT_T1_ODD) + 1u;
+    if (!second) {
+        atomicMax(&g->abandoned, next);
+        __threadfence_system();
+        const uint32_t c = ibgda_atomic_read(&g->commit);
+        if (c >= next) return true;
+    }
+    atomicExch(&g->dfailed, 1u);
+    atomicAdd(&ibgda_ft_dev()->t1_gaveup, 1u);
+    ibgda_t1_fail_park(qp);
+    return false;
+}
+
+/* Wait until the gate shows a stable epoch other than `seen`, or failure. Bounded: t1_hold_ns, or
+ * twice that when the host had passed its commit point. Returns the epoch or FAILED. */
+__device__ __noinline__ static uint32_t ibgda_t1_wait_stable(nvshmemi_ibgda_ft_gate_t *g,
+                                                             uint32_t seen,
+                                                             nvshmemi_ibgda_device_qp_t *qp) {
+    const uint64_t bound = ibgda_atomic_read(&ibgda_ft_dev()->t1_hold_ns);
+    uint64_t t0 = ibgda_ft_globaltimer();
+    bool second = false;
+    uint32_t it = 0;
+    for (;;) {
+        const uint32_t hi = ibgda_t1_ld_acq32(ibgda_t1_hi(g));
+        if (ibgda_t1_failed(g, hi)) return NVSHMEMI_IBGDA_FT_T1_FAILED;
+        if (!(hi & NVSHMEMI_IBGDA_FT_T1_ODD) && hi != seen) return hi;
+        if (((++it) & 15u) == 0u && ibgda_t1_hflag_failed(g)) return NVSHMEMI_IBGDA_FT_T1_FAILED;
+        if (ibgda_ft_globaltimer() - t0 > bound) {
+            if (!ibgda_t1_giveup(g, seen, second, qp)) return NVSHMEMI_IBGDA_FT_T1_FAILED;
+            second = true;
+            t0 = ibgda_ft_globaltimer();
+        }
+        __nanosleep(2000);
+    }
+}
+
+/* Counted entry of a poster, before it reserves WQE slots. Returns the stable epoch it entered in,
+ * or a value with FAILED set (the QP failed: the caller posts fail-fast into the parked QP). The
+ * caller is counted on return in both cases (ibgda_t1_leave balances it). */
+__device__ NVSHMEMI_STATIC NVSHMEMI_DEVICE_ALWAYS_INLINE uint32_t ibgda_t1_enter(
+    nvshmemi_ibgda_ft_gate_t *g, nvshmemi_ibgda_device_qp_t *qp) {
+    for (;;) {
+        const unsigned long long old = atomicAdd(&g->word, NVSHMEMI_IBGDA_FT_T1_CNT);
+        const uint32_t hi = (uint32_t)(old >> 32);
+        if (likely(!(hi & (NVSHMEMI_IBGDA_FT_T1_ODD | NVSHMEMI_IBGDA_FT_T1_FAILED)))) return hi;
+        if (hi & NVSHMEMI_IBGDA_FT_T1_FAILED) {
+            ibgda_t1_fail_park(qp);
+            return hi;
+        }
+        /* A recovery owns the QP: back out without a WQE slot, wait for the next stable epoch. */
+        atomicAdd(&g->word, (unsigned long long)-(long long)NVSHMEMI_IBGDA_FT_T1_CNT);
+        if (ibgda_t1_wait_stable(g, hi, qp) & NVSHMEMI_IBGDA_FT_T1_FAILED) {
+            atomicAdd(&g->word, NVSHMEMI_IBGDA_FT_T1_CNT);
+            ibgda_t1_fail_park(qp);
+            return NVSHMEMI_IBGDA_FT_T1_FAILED;
+        }
+    }
+}
+
+/* A counted poster that cannot progress until the recovery is done. It has written nothing the
+ * host must wait for (its WQEs, if any, are in the ring and move with it). It leaves the counted
+ * region (the host rewrites QP state when no device thread is counted), waits for the next stable
+ * epoch and enters again; the entry's return value says whether the host started another round
+ * meanwhile, and then it leaves and waits again (it wrote nothing in between). Returns the epoch
+ * (or FAILED; counted in both cases). *shift = the index shift to apply to its reservation, also
+ * after a failure (a host that declines after rewriting the indices publishes off first). */
+__device__ __noinline__ static uint32_t ibgda_t1_hold(nvshmemi_ibgda_ft_gate_t *g,
+                                                      nvshmemi_ibgda_device_qp_t *qp,
+                                                      uint64_t *shift) {
+    const uint64_t off0 = ibgda_t1_ld_acq64(&g->off); /* stable: we are counted */
+    uint32_t seen = ibgda_t1_ld_acq32(ibgda_t1_hi(g));
+    uint32_t ep;
+    ibgda_t1_leave(g); /* release: our writes before the count drops */
+    for (;;) {
+        ep = ibgda_t1_wait_stable(g, seen, qp);
+        const unsigned long long old = atomicAdd(&g->word, NVSHMEMI_IBGDA_FT_T1_CNT);
+        const uint32_t hi = (uint32_t)(old >> 32);
+        if (ep & NVSHMEMI_IBGDA_FT_T1_FAILED) break;
+        if (hi & NVSHMEMI_IBGDA_FT_T1_FAILED) {
+            ep = hi;
+            break;
+        }
+        if (!(hi & NVSHMEMI_IBGDA_FT_T1_ODD)) { /* entered in a stable epoch (ep, or a later one) */
+            ep = hi;
+            break;
+        }
+        /* the host started another round between our observation and the entry */
+        atomicAdd(&g->word, (unsigned long long)-(long long)NVSHMEMI_IBGDA_FT_T1_CNT);
+        seen = hi;
+    }
+    __threadfence();
+    *shift = ibgda_t1_ld_acq64(&g->off) - off0;
+    if (ep & NVSHMEMI_IBGDA_FT_T1_FAILED) ibgda_t1_fail_park(qp);
+    return ep;
+}
+
+/* After a shift, a poster held in the ready CAS rewrites the index field of the control segments of
+ * its own WQEs [base, base + n) (already moved to their new slots by the host). */
+__device__ __noinline__ static void ibgda_t1_fix_idx(nvshmemi_ibgda_device_qp_t *qp, uint64_t base,
+                                                     uint32_t n) {
+    uint64_t x = base;
+    while (x < base + n) {
+        uint32_t *w = (uint32_t *)ibgda_get_wqe_ptr(qp, (uint16_t)x);
+        const uint32_t w0 = BSWAP32(ibgda_atomic_read(&w[0]));
+        const uint32_t ds = BSWAP32(ibgda_atomic_read(&w[1])) & 0x3fu;
+        if (ds == 0) break;
+        ibgda_store_relaxed(&w[0], BSWAP32((w0 & 0xff0000ffu) | ((uint32_t)(x & 0xffffu) << 8)));
+        x += (ds * 16u + 63u) / 64u;
+    }
+    IBGDA_MEMBAR_NO_OPTIMIZATION(); /* another CTA's post_send may ring for this range */
+}
+
+/* An error CQE at ring position ci: record it (sticky record, park, mailbox) as v2.2 does. A
+ * waiter (not counted) does it inside the counted region, in the epoch it validated against, and
+ * only if the CQE is still the unconsumed entry at ci (ci carries the epoch tag); a counted
+ * poster does it directly. */
+__device__ __noinline__ static void ibgda_t1_record(nvshmemi_ibgda_device_cq_t *cq,
+                                                    nvshmemi_ibgda_ft_gate_t *g, uintptr_t slot,
+                                                    uint64_t ci, uint64_t idx, uint32_t ep,
+                                                    bool counted) {
+    nvshmemi_ibgda_device_qp_management_t *mv = ibgda_ft_mvars_of_cq(cq);
+    if (!counted) {
+        const unsigned long long old = atomicAdd(&g->word, NVSHMEMI_IBGDA_FT_T1_CNT);
+        if ((uint32_t)(old >> 32) != ep || ibgda_atomic_read(&mv->ft_ring_ci) != ci) {
+            ibgda_t1_leave(g);
+            return;
+        }
+    }
+    IBGDA_MFENCE();
+    ibgda_ft_capture(cq, (const void *)slot, idx, NVSHMEMI_IBGDA_FT_PATH_POLL, ci);
+    if (!counted) ibgda_t1_leave(g);
+}
+
+__device__ __noinline__ static void ibgda_t1_invariant(nvshmemi_ibgda_device_cq_t *cq,
+                                                       nvshmemi_ibgda_ft_gate_t *g, uint64_t idx,
+                                                       uint64_t ci, uint32_t w15, uint64_t cons,
+                                                       uint32_t d, uint32_t ep, bool counted) {
+    if (!counted) {
+        const unsigned long long old = atomicAdd(&g->word, NVSHMEMI_IBGDA_FT_T1_CNT);
+        if ((uint32_t)(old >> 32) != ep) {
+            ibgda_t1_leave(g);
+            return;
+        }
+    }
+    ibgda_ft_ring_invariant(cq, idx, ci, w15, cons, d, NVSHMEMI_IBGDA_FT_PATH_POLL);
+    if (!counted) ibgda_t1_leave(g);
+}
+
+/* Walk the ring CQ of a gated RC QP until cons_idx >= idx (the v2 ring walk, epoch-aware). The ring
+ * counter mvars.ft_ring_ci carries the epoch (low 24 bits) above bit 40, written by the host at
+ * every rebase, so a CAS on a counter value of an older epoch fails and a consumption always knows
+ * its epoch. counted = the caller is a counted poster (the host cannot rebase under it);
+ * otherwise every completion observation is validated against the epoch. Returns DONE (cons_idx
+ * >= idx observed in epoch ep), RESYNC (the epoch moved on, or an error is recorded on the QP: park
+ * or hold, then remap), or FAILED. */
+__device__ NVSHMEMI_STATIC NVSHMEMI_DEVICE_ALWAYS_INLINE int ibgda_t1_ring_wait(
+    nvshmemi_ibgda_device_cq_t *cq, nvshmemi_ibgda_ft_gate_t *g, uint64_t idx, uint32_t ep,
+    bool counted) {
+    nvshmemi_ibgda_device_qp_management_t *mv = ibgda_ft_mvars_of_cq(cq);
+    const uint32_t ncqes = cq->ncqes;
+    const uintptr_t base = (uintptr_t)cq->cqe;
+    unsigned long long *ci_p = (unsigned long long *)&mv->ft_ring_ci;
+    uint32_t *hi_p = ibgda_t1_hi(g);
+    uint64_t ci = ibgda_atomic_read((uint64_t *)ci_p);
+    uint32_t spins = 0;
+    for (;;) {
+        if (ibgda_atomic_read(cq->cons_idx) >= idx) {
+            if (counted) return IBGDA_T1_DONE;
+            asm volatile("fence.acq_rel.gpu;" ::: "memory");
+            return ibgda_atomic_read(hi_p) == ep ? IBGDA_T1_DONE : IBGDA_T1_RESYNC;
+        }
+        const uintptr_t slot = base + ((uintptr_t)(ci & (ncqes - 1)) << 6);
+        const uint32_t w15 = ibgda_atomic_read((uint32_t *)(slot + 60));
+        const uint8_t opown = (uint8_t)(w15 >> 24);
+        const bool valid = ((opown >> 4) != MLX5_CQE_INVALID) &&
+                           ((uint32_t)(opown & 1u) == ((ci & ncqes) ? 1u : 0u));
+        if (valid) {
+            if (unlikely(ibgda_ft_is_err_opcode(opown))) {
+                ibgda_t1_record(cq, g, slot, ci, idx, ep, counted);
+                return IBGDA_T1_RESYNC;
+            }
+            if (atomicCAS(ci_p, (unsigned long long)ci, (unsigned long long)(ci + 1)) == ci) {
+                const uint16_t wc = BSWAP16((uint16_t)(w15 & 0xffffu));
+                const uint32_t tag = (uint32_t)(ci >> NVSHMEMI_IBGDA_FT_T1_TAG_SHIFT);
+                uint32_t h = ep;
+                uint64_t cons;
+                ci++;
+                if (!counted) {
+                    /* the consumed CQE belongs to epoch `tag`; apply it only if that epoch is still
+                     * the stable one around the cons_idx read (else a round is in progress or has
+                     * rebased, and the rebase covers it) */
+                    h = ibgda_t1_ld_acq32(hi_p);
+                    if ((h & (NVSHMEMI_IBGDA_FT_T1_ODD | NVSHMEMI_IBGDA_FT_T1_FAILED)) ||
+                        (h & NVSHMEMI_IBGDA_FT_T1_TAG_MASK) != tag)
+                        return IBGDA_T1_RESYNC;
+                    cons = ibgda_t1_ld_acq64(cq->cons_idx);
+                    if (ibgda_atomic_read(hi_p) != h) return IBGDA_T1_RESYNC;
+                } else {
+                    cons = ibgda_t1_ld_acq64(cq->cons_idx);
+                }
+                const uint32_t d = (uint16_t)(wc + 1u - (uint16_t)cons);
+                if (likely(d != 0 && d <= ncqes)) {
+                    atomicMax((unsigned long long int *)cq->cons_idx,
+                              (unsigned long long int)(cons + d));
+                    if (h != ep) return IBGDA_T1_RESYNC; /* applied for epoch h; remap the ticket */
+                    if (cons + d >= idx) return IBGDA_T1_DONE;
+                } else {
+                    ibgda_t1_invariant(cq, g, idx, ci - 1, w15, cons, d, h, counted);
+                    return IBGDA_T1_RESYNC;
+                }
+            } else {
+                ci = ibgda_atomic_read((uint64_t *)ci_p);
+            }
+            continue;
+        }
+        if (unlikely(((++spins) & 0xffu) == 0u)) {
+            ci = ibgda_atomic_read((uint64_t *)ci_p);
+            const uint32_t hi = ibgda_atomic_read(hi_p);
+            if (ibgda_t1_failed(g, hi)) return IBGDA_T1_FAILED;
+            if ((spins & 0xfffu) == 0u && ibgda_t1_hflag_failed(g)) return IBGDA_T1_FAILED;
+            if (hi != ep) return IBGDA_T1_RESYNC;
+            if (ibgda_atomic_read(&mv->ft_state) >= 2u && (ibgda_atomic_read(&mv->ft_fp) >> 24) != 0u)
+                return IBGDA_T1_RESYNC;
+        }
+    }
+}
+
+/* Slot wait of a counted poster (reservation [wqe_idx, wqe_idx + n) in epoch ep). Holds across a
+ * recovery and returns the reservation shifted into the new epoch. A failed QP: returns at once
+ * (the poster then writes into the parked QP, as v2.2 does after an error). */
+__device__ NVSHMEMI_STATIC NVSHMEMI_DEVICE_ALWAYS_INLINE uint64_t ibgda_t1_slot_wait(
+    nvshmemi_ibgda_device_qp_t *qp, nvshmemi_ibgda_ft_gate_t *g, uint64_t wqe_idx, uint32_t n,
+    uint32_t ep) {
+    const uint16_t nwqes = qp->tx_wq.nwqes;
+    if (ep & NVSHMEMI_IBGDA_FT_T1_FAILED) return wqe_idx;
+    for (;;) {
+        if (likely(wqe_idx + n < (uint64_t)nwqes)) return wqe_idx;
+        nvshmemi_ibgda_device_cq_t cq = *qp->tx_wq.cq;
+        const int r = ibgda_t1_ring_wait(&cq, g, wqe_idx + n - nwqes, ep, true);
+        if (likely(r == IBGDA_T1_DONE) || r == IBGDA_T1_FAILED) return wqe_idx;
+        uint64_t sh = 0;
+        ep = ibgda_t1_hold(g, qp, &sh);
+        wqe_idx += sh;
+        if (ep & NVSHMEMI_IBGDA_FT_T1_FAILED) return wqe_idx;
+    }
+}
+
+/* Quiet of one gated RC QP: returns when every WQE made ready before the call has completed,
+ * across any number of recoveries; 0, or -1 when the QP failed (declined / gave up). *ticket =
+ * the final D index waited for. */
+__device__ NVSHMEMI_STATIC NVSHMEMI_DEVICE_ALWAYS_INLINE int ibgda_t1_quiet(
+    nvshmemi_ibgda_device_qp_t *qp, nvshmemi_ibgda_ft_gate_t *g, uint64_t *ticket) {
+    uint32_t *hi_p = ibgda_t1_hi(g);
+    uint32_t ep;
+    uint64_t off, L, D;
+    for (;;) { /* ticket: D and off from one stable epoch */
+        ep = ibgda_t1_ld_acq32(hi_p);
+        if (unlikely(ep & (NVSHMEMI_IBGDA_FT_T1_ODD | NVSHMEMI_IBGDA_FT_T1_FAILED))) {
+            if (ep & NVSHMEMI_IBGDA_FT_T1_FAILED) return -1;
+            if (ibgda_t1_wait_stable(g, ep, qp) & NVSHMEMI_IBGDA_FT_T1_FAILED) return -1;
+            continue;
+        }
+        off = ibgda_t1_ld_acq64(&g->off);
+        D = ibgda_t1_ld_acq64(&qp->mvars.tx_wq.ready_head);
+        if (likely(ibgda_atomic_read(hi_p) == ep)) break;
+    }
+    L = D - off;
+    const bool noremap = (ibgda_atomic_read(&g->test) & NVSHMEMI_IBGDA_FT_T1_TEST_NOREMAP) != 0;
+    for (;;) {
+        nvshmemi_ibgda_device_cq_t cq = *qp->tx_wq.cq;
+        const int r = ibgda_t1_ring_wait(&cq, g, D, ep, false);
+        if (likely(r == IBGDA_T1_DONE)) {
+            *ticket = D;
+            return 0;
+        }
+        if (r == IBGDA_T1_FAILED) return -1;
+        ep = ibgda_t1_wait_stable(g, ep, qp);
+        if (ep & NVSHMEMI_IBGDA_FT_T1_FAILED) return -1;
+        off = ibgda_t1_ld_acq64(&g->off);
+        if (!noremap) D = L + off; /* negative control: keep the stale D */
+    }
+}
+
+/* T1 view of the QP's failure for nvshmemx_ibgda_ft_status: only a declined / given-up recovery is
+ * an error; a fault being recovered is not. */
+__device__ NVSHMEMI_STATIC NVSHMEMI_DEVICE_ALWAYS_INLINE uint32_t ibgda_t1_status(
+    nvshmemi_ibgda_device_qp_t *qp) {
+    nvshmemi_ibgda_ft_gate_t *g = ibgda_t1_gate(qp);
+    nvshmemi_ibgda_device_qp_management_t *mv = &qp->mvars;
+    const uint32_t fp = ibgda_atomic_read(&mv->ft_state) >= 2u ? ibgda_atomic_read(&mv->ft_fp) : 0u;
+    if (g == nullptr) return fp; /* a QP created after init has no gate: v2.2 semantics */
+    if (!ibgda_t1_failed(g, ibgda_atomic_read(ibgda_t1_hi(g)))) return 0u;
+    return fp ? fp : ((0xfu << 24) | NVSHMEMI_IBGDA_FT_CLASS_T1_DECLINED);
+}
+
+/* ---------------------------------------------------------------------------------------------
+ * v2 (B) device bounds check, NVSHMEM_IBGDA_FT_BOUNDS=1: before an RMA/AMO is posted, the remote
+ * range [off, off + len) (off = address - heap_base, the same on every PE: the heap is symmetric)
+ * must lie inside one allocated chunk of the symmetric heap. The host library publishes its
+ * allocator's in-use chunks (mspace::inuse_chunks) as a per-512-B-granule table (entry = end
+ * granule of the chunk holding the granule, 0 = free); without a table the check is heap-level
+ * ([0, heap_size)). Granularity is the allocator's chunk: sizes are rounded up to 512 B, so an
+ * overrun into the padding of the same chunk, or a range that lies wholly inside another
+ * allocated object, is not detected. On violation nothing is posted; the QP to the peer gets a
+ * sticky library record (class OOB_WRITE/OOB_READ, fingerprint 0/0x00/<why>) that
+ * nvshmemx_ibgda_ft_status and the bounded quiet report, and the mailbox gets a record.
+ * ------------------------------------------------------------------------------------------- */
+__device__ NVSHMEMI_STATIC NVSHMEMI_DEVICE_ALWAYS_INLINE bool ibgda_ft_bounds_on() {
+    return (ibgda_get_state()->ft_flags & NVSHMEMI_IBGDA_FT_FLAG_BOUNDS) != 0;
+}
+
+/* 0 ok, else NVSHMEMI_IBGDA_FT_OOB_*; *chunk_end = end offset of the chunk holding off (0 free). */
+__device__ NVSHMEMI_STATIC NVSHMEMI_DEVICE_ALWAYS_INLINE int ibgda_ft_range_check(
+    uint64_t addr, uint64_t len, uint64_t *off_out, uint64_t *chunk_end) {
+    CONSTANT_ADDRESS_SPACE nvshmemi_ibgda_device_state_t *state = ibgda_get_state();
+    const uint64_t heap_size = (uint64_t)nvshmemi_device_state_d.heap_size;
+    const uint64_t off = addr - (uint64_t)nvshmemi_device_state_d.heap_base;
+    *off_out = off;
+    *chunk_end = 0;
+    if (len == 0) return 0;
+    if (off >= heap_size || len > heap_size - off) return NVSHMEMI_IBGDA_FT_OOB_OUTSIDE_HEAP;
+    const uint32_t *tbl = state->ft_obj_end;
+    const uint32_t shift = state->ft_obj_shift;
+    if (tbl == nullptr || (off >> shift) >= state->ft_obj_ngran) return 0;
+    const uint32_t endg = ibgda_atomic_read((uint32_t *)&tbl[off >> shift]);
+    *chunk_end = (uint64_t)endg << shift;
+    if (endg == 0) return NVSHMEMI_IBGDA_FT_OOB_FREE;
+    if (off + len > *chunk_end) return NVSHMEMI_IBGDA_FT_OOB_CROSSES;
+    return 0;
+}
+
+/* Record a rejected operation on the (first) RC QP to `pe` (DCI 0 without RCs). Cold path. */
+__device__ __noinline__ static void ibgda_ft_record_oob(int pe, uint64_t off, uint64_t len,
+                                                        uint64_t chunk_end, int why, int op) {
+    CONSTANT_ADDRESS_SPACE nvshmemi_ibgda_device_state_t *state = ibgda_get_state();
+    nvshmemi_ibgda_ft_dev_t *ft = (nvshmemi_ibgda_ft_dev_t *)state->ft;
+    if (ft == nullptr) return;
+    nvshmemi_ibgda_device_qp_t *qp = state->globalmem.rcs != nullptr
+                                         ? &state->globalmem.rcs[pe]
+                                         : &state->globalmem.dcis[0];
+    nvshmemi_ibgda_device_qp_management_t *mv = &qp->mvars;
+    const uint8_t cls = (op == NVSHMEMI_IBGDA_FT_OP_GET || op == NVSHMEMI_IBGDA_FT_OP_G)
+                            ? NVSHMEMI_IBGDA_FT_CLASS_OOB_READ
+                            : NVSHMEMI_IBGDA_FT_CLASS_OOB_WRITE;
+    const uint32_t old = atomicCAS(&mv->ft_state, 0u, 1u);
+    const bool first = (old == 0u);
+    if (first) {
+        mv->ft_fp = ((uint32_t)why << 8) | cls; /* opcode 0, syndrome 0: no CQE */
+        mv->ft_wqe = 0u;
+        mv->ft_aux = (uint32_t)off;
+        __threadfence();
+        atomicExch(&mv->ft_state, 2u);
+        atomicAdd(&ft->nerr, 1u);
+    }
+    uint32_t qp_index;
+    uint8_t qp_type;
+    int32_t peer;
+    ibgda_ft_qp_of_mvars(mv, &qp_index, &qp_type, &peer);
+    uint32_t r[sizeof(nvshmemi_ibgda_ft_record_t) / 4];
+#pragma unroll
+    for (int i = 0; i < (int)(sizeof(r) / 4); i++) r[i] = 0u;
+    r[2] = qp->qpn;
+    r[4] = ((uint32_t)why << 24);
+    r[5] = (uint32_t)cls | (2u << 8) | ((uint32_t)NVSHMEMI_IBGDA_FT_PATH_BOUNDS << 16) |
+           ((uint32_t)qp_type << 24);
+    r[6] = first ? 0u : (1u << 24); /* upgrade byte: 1 = a record already existed on this QP */
+    r[7] = (uint32_t)nvshmemi_device_state_d.mype;
+    r[8] = (uint32_t)pe;
+    r[9] = qp_index;
+    const uint64_t vals[6] = {0,
+                              ibgda_atomic_read(&mv->tx_wq.cons_idx),
+                              ibgda_atomic_read(&mv->tx_wq.prod_idx),
+                              ibgda_atomic_read(&mv->tx_wq.ready_head),
+                              ibgda_atomic_read(&mv->tx_wq.resv_head),
+                              ibgda_ft_globaltimer()};
+#pragma unroll
+    for (int i = 0; i < 6; i++) {
+        r[10 + 2 * i] = (uint32_t)vals[i];
+        r[11 + 2 * i] = (uint32_t)(vals[i] >> 32);
+    }
+    r[42] = (uint32_t)off;
+    r[43] = (uint32_t)(off >> 32);
