     INFO(NVSHMEM_MEM, "[%d] type: %s allocated %zu bytes, %zu count, %zu alignment ptr: %p",
          cfg_.mype, typeid(decltype(*this)).name(), size, count, alignment, ptr);
@@ -410,6 +475,7 @@ out:
 
