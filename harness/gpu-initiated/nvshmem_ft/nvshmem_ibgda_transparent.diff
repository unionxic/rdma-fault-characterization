+            a = "fix local MR/lkey, QP-only recover"; break;
+        case NVSHMEMI_IBGDA_FT_CLASS_LOC_LEN:
+            n = "LOC_LEN"; f = "loc_len"; c = "local length error"; a = "fix SGE length, QP-only recover";
+            break;
+        case NVSHMEMI_IBGDA_FT_CLASS_OOB_WRITE:
+        case NVSHMEMI_IBGDA_FT_CLASS_OOB_READ:
+            n = cls == NVSHMEMI_IBGDA_FT_CLASS_OOB_WRITE ? "OOB_WRITE" : "OOB_READ"; f = "oob_within_mr";
+            c = vendor == NVSHMEMI_IBGDA_FT_OOB_OUTSIDE_HEAP
+                    ? "remote range outside the symmetric heap (device bounds check, not posted)"
+                : vendor == NVSHMEMI_IBGDA_FT_OOB_FREE
+                    ? "remote range starts in unallocated heap (device bounds check, not posted)"
+                    : "remote range runs past the end of its heap chunk (device bounds check, not posted)";
+            a = "application addressing bug: fix offset/length; the QP is healthy; decline"; break;
+        case NVSHMEMI_IBGDA_FT_CLASS_T1_DECLINED:
+            n = "T1_DECLINED"; f = "declined";
+            c = "transparent recovery declined, or a device wait gave up";
+            a = "the QP pair stays in ERR; tear down"; break;
+        case NVSHMEMI_IBGDA_FT_CLASS_RING_INVARIANT:
+            n = "RING_INVARIANT"; f = "internal";
+            c = "ring walk: consumed CQE did not advance cons_idx by 1..ncqes; QP completion "
+                "tracking unreliable (bug or corruption)";
+            a = "decline (a recovery commit would reset the ring); report as a bug"; break;
+        default: break;
+    }
+    snprintf(o->name, sizeof(o->name), "%s", n);
+    snprintf(o->fault, sizeof(o->fault), "%s", f);
+    snprintf(o->cause, sizeof(o->cause), "%s", c);
+    snprintf(o->action, sizeof(o->action), "%s", a);
+    o->recover_hint = hint;
+}
+
+static const char *ibgda_ft_path_str(int p) {
+    switch (p) {
+        case NVSHMEMI_IBGDA_FT_PATH_POLL: return "poll";
+        case NVSHMEMI_IBGDA_FT_PATH_EXIT: return "poll-exit";
+        case NVSHMEMI_IBGDA_FT_PATH_BOUNDED: return "bounded";
+        case NVSHMEMI_IBGDA_FT_PATH_SENTINEL: return "sentinel";
+        default: return "?";
+    }
+}
