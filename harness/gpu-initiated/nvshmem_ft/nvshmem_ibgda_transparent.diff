+/* NVSHMEM_IBGDA_FT v2 (B, research, default off): publish the allocator's in-use chunks (offset
+ * from the heap base, size) to the IBGDA transport, which keeps the device table of its bounds
+ * check. Active only with NVSHMEM_IBGDA_FT=1 and NVSHMEM_IBGDA_FT_BOUNDS=1; the transport is looked
+ * up with dlopen(RTLD_NOLOAD) on every call (allocations are rare and collective), so nothing is
+ * cached across the plugin's lifetime. */
+static int nvshmemi_ft_bounds_enabled() {
+    static int enabled = -1;
+    if (enabled < 0) {
+        const char *on = getenv("NVSHMEM_IBGDA_FT");
+        const char *bd = getenv("NVSHMEM_IBGDA_FT_BOUNDS");
+        enabled = (on && atoi(on) != 0 && bd && atoi(bd) != 0) ? 1 : 0;
+    }
+    return enabled;
+}
+
+/* NVSHMEM_IBGDA_FT v2 (B), NVSHMEM_IBGDA_FT_BOUNDS_GUARD=<bytes> (with BOUNDS=1): a red zone after
+ * every symmetric allocation (rounded up to NVSHMEMI_MALLOC_ALIGNMENT), allocated with the object
+ * but published as free, so an overrun that starts at the end of an object lands in unallocated
+ * granules and the device check rejects it. Added before the symmetry check, so both PEs must use
+ * the same value. 0 (default): no red zone, the layout is the stock one. */
+static size_t nvshmemi_ft_heap_guard() {
+    static long guard = -1;
+    if (guard < 0) {
+        const char *g = getenv("NVSHMEM_IBGDA_FT_BOUNDS_GUARD");
+        long v = (nvshmemi_ft_bounds_enabled() && g) ? atol(g) : 0;
+        if (v < 0) v = 0;
+        guard = (long)(((size_t)v + NVSHMEMI_MALLOC_ALIGNMENT - 1) / NVSHMEMI_MALLOC_ALIGNMENT *
+                       NVSHMEMI_MALLOC_ALIGNMENT);
+    }
+    return (size_t)guard;
+}
+
+static void nvshmemi_ft_publish_heap(const std::map<void *, size_t> *chunks, void *base,
+                                     size_t size) {
+    if (!nvshmemi_ft_bounds_enabled() || !chunks || !base) return;
+    const size_t guard = nvshmemi_ft_heap_guard();
+    void *h = dlopen("nvshmem_transport_ibgda.so.7", RTLD_NOW | RTLD_NOLOAD);
+    if (!h) return;
+    typedef int (*fn_t)(const uint64_t *, const uint64_t *, int, uint64_t, uint64_t);
+    fn_t fn = (fn_t)dlsym(h, "nvshmemt_ibgda_ft_heap_objects");
+    if (fn) {
+        std::vector<uint64_t> off, len;
+        for (const auto &c : *chunks) {
+            off.push_back((uint64_t)((char *)c.first - (char *)base));
+            /* the red zone at the end of each chunk is published as free */
+            len.push_back((uint64_t)(c.second > guard ? c.second - guard : c.second));
+        }
+        if (fn(off.data(), len.data(), (int)off.size(), (uint64_t)base, (uint64_t)size) > 0)
+            nvshmemi_update_device_state();
+    }
+    dlclose(h);
+}
