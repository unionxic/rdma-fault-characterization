+/* NVSHMEM_IBGDA_FT (research): true once a transport was marked failed (declined recovery). */
+bool nvshmemi_ft_transport_failed() {
+    if (!nvshmemi_state || !nvshmemi_state->transports) return false;
+    for (int i = 0; i < nvshmemi_state->num_initialized_transports; i++) {
+        if (nvshmemi_state->transports[i] &&
+            (nvshmemi_state->transports[i]->attr & NVSHMEM_TRANSPORT_ATTR_FT_FAILED))
+            return true;
+    }
+    return false;
+}
