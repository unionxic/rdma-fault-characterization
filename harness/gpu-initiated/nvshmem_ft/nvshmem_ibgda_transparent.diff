+/* ---------------------------------------------------------------------------------------------
+ * NVSHMEM_IBGDA_FT device API (research). All return "no error" when the classifier is off.
+ * ------------------------------------------------------------------------------------------- */
+
+/* Packed fingerprint (opcode << 24 | syndrome << 16 | vendor_err << 8 | class) of the first error
+ * recorded on an RC QP to `pe`, or on any RC/DCI QP when pe < 0; 0 if there is none. */
+__device__ NVSHMEMI_DEVICE_ALWAYS_INLINE uint32_t nvshmemx_ibgda_ft_status(int pe) {
+    CONSTANT_ADDRESS_SPACE nvshmemi_ibgda_device_state_t *state = ibgda_get_state();
+    if (state->ft == nullptr) return 0;
+    const int npes = nvshmemi_device_state_d.npes;
+    const uint32_t nrcs = state->num_rc_per_pe * state->num_devices_initialized;
+    for (uint32_t i = 0; i < nrcs * (uint32_t)npes; i++) {
+        int qpe = (int)(i % (uint32_t)npes);
+        if (qpe == nvshmemi_device_state_d.mype || (pe >= 0 && qpe != pe)) continue;
+        if (ibgda_t1_on()) { /* T1: only a declined recovery (or a library record) is an error */
+            const uint32_t f = ibgda_t1_status(&state->globalmem.rcs[i]);
+            if (f) return f;
+            continue;
+        }
+        nvshmemi_ibgda_device_qp_management_t *mv = &state->globalmem.rcs[i].mvars;
+        uint32_t st = ibgda_atomic_read(&mv->ft_state);
+        if (st == 0) continue;
+        while (st == 1) st = ibgda_atomic_read(&mv->ft_state); /* capture in progress */
+        return ibgda_atomic_read(&mv->ft_fp);
+    }
+    if (pe < 0) {
+        const uint32_t ndcis = state->num_shared_dcis + state->num_exclusive_dcis;
+        for (uint32_t i = 0; i < ndcis; i++) {
+            nvshmemi_ibgda_device_qp_management_t *mv = &state->globalmem.dcis[i].mvars;
+            uint32_t st = ibgda_atomic_read(&mv->ft_state);
+            if (st == 0) continue;
+            while (st == 1) st = ibgda_atomic_read(&mv->ft_state);
+            return ibgda_atomic_read(&mv->ft_fp);
+        }
+    }
+    return 0;
+}
+
+/* Bounded poll of one send CQ up to idx: 0 done, -1 error CQE (recorded), -2 budget expired. */
+__device__ NVSHMEMI_STATIC NVSHMEMI_DEVICE_ALWAYS_INLINE int ibgda_ft_poll_cq_bounded(
+    nvshmemi_ibgda_device_cq_t *cq, uint64_t idx, long long t0, long long budget) {
+    struct mlx5_cqe64 *cqe64 = (struct mlx5_cqe64 *)cq->cqe;
+    const uint32_t ncqes = cq->ncqes;
+    const bool ft_on = ibgda_get_state()->ft != nullptr;
+    /* v2: a sticky record (an error CQE, or a library-detected bounds violation on a healthy QP)
+     * fails the bounded wait even when the indices say complete. */
+    if (ft_on && ibgda_ft_cq_failed(cq)) return -1;
+    uint64_t cons_idx = ibgda_atomic_read(cq->cons_idx);
+    if (cons_idx >= idx) return 0;
+    if (ft_on && (ibgda_get_state()->ft_flags & NVSHMEMI_IBGDA_FT_FLAG_RING_CQ)) {
+        int err = 0;
+        const int r = ibgda_ft_ring_poll(cq, idx, &err, NVSHMEMI_IBGDA_FT_PATH_BOUNDED, t0, budget);
+        IBGDA_MFENCE(); /* as the collapsed path: order later accesses after the completion */
+        return r;
+    }
+    while (ibgda_atomic_read(cq->prod_idx) < idx) {
+        if (clock64() - t0 > budget) return -2;
+    }
+    for (;;) {
+        uint32_t w15 = ibgda_atomic_read((uint32_t *)((uintptr_t)cqe64 + 60));
+        uint16_t wqe_counter = BSWAP16((uint16_t)(w15 & 0xffffu));
+        uint8_t opown = (uint8_t)(w15 >> 24);
+        if (ft_on && ibgda_ft_is_err_opcode(opown)) {
+            ibgda_ft_capture(cq, cq->cqe, idx, NVSHMEMI_IBGDA_FT_PATH_BOUNDED, 0);
+            return -1;
+        }
+        if (!((uint16_t)((uint16_t)idx - wqe_counter - (uint16_t)2) < ncqes)) {
+            ++wqe_counter;
+            uint64_t new_cons_idx = (idx & ~(0xffffULL) | wqe_counter) +
+                                    (((uint16_t)idx > wqe_counter) ? 0x10000ULL : 0x0);
+            atomicMax((unsigned long long int *)cq->cons_idx, (unsigned long long int)new_cons_idx);
+            IBGDA_MFENCE();
+            return ibgda_ft_is_err_opcode(ibgda_atomic_read(&cqe64->op_own)) ? -1 : 0;
+        }
+        if (clock64() - t0 > budget) return -2;
+    }
+}
+
+/* Bounded quiet (one thread) of every default RC QP to `pe`: 0 all complete, -1 an error CQE was
+ * recorded (see nvshmemx_ibgda_ft_status), -2 the clock64 budget expired first. */
+__device__ NVSHMEMI_DEVICE_ALWAYS_INLINE int nvshmemx_ibgda_ft_quiet_bounded(int pe,
+                                                                           long long budget) {
+    CONSTANT_ADDRESS_SPACE nvshmemi_ibgda_device_state_t *state = ibgda_get_state();
+    const int npes = nvshmemi_device_state_d.npes;
+    const uint32_t nrcs = state->num_default_rc_per_pe * state->num_devices_initialized;
+    const long long t0 = clock64();
+    int rc = 0;
+    if (ibgda_t1_on()) { /* T1: the wait holds across a recovery (the budget does not apply) */
+        for (uint32_t q = 0; q < nrcs; q++) {
+            nvshmemi_ibgda_device_qp_t *qp = &state->globalmem.rcs[q * (uint32_t)npes + (uint32_t)pe];
+            nvshmemi_ibgda_ft_gate_t *g = ibgda_t1_gate(qp);
+            uint64_t ticket = 0;
+            ibgda_submit_ready(qp);
+            if (g != nullptr && ibgda_t1_quiet(qp, g, &ticket) != 0) return -1;
+        }
+        return 0;
+    }
+    for (uint32_t q = 0; q < nrcs; q++) {
+        nvshmemi_ibgda_device_qp_t *qp = &state->globalmem.rcs[q * (uint32_t)npes + (uint32_t)pe];
+        uint64_t idx = ibgda_submit_ready(qp);
+        nvshmemi_ibgda_device_cq_t cq = *qp->tx_wq.cq;
+        int r = ibgda_ft_poll_cq_bounded(&cq, idx, t0, budget);
+        if (r == -1) return -1;
+        if (r == -2) rc = -2;
+    }
+    return rc;
+}
+
+/* Device sentinel (research): one thread polls the collapsed send-CQ slot of every RC and DCI QP
+ * and records the first error CQE of each, so the root cause is kept even when no wait is
+ * spinning when it arrives (it is overwritten by the trailing flushes ~59 us later). Runs until
+ * the host sets ft->sentinel_stop. Launch it alone in its own kernel on a non-blocking stream. */
+__device__ NVSHMEMI_DEVICE_ALWAYS_INLINE void nvshmemx_ibgda_ft_sentinel(unsigned int poll_ns) {
+    CONSTANT_ADDRESS_SPACE nvshmemi_ibgda_device_state_t *state = ibgda_get_state();
+    nvshmemi_ibgda_ft_dev_t *ft = (nvshmemi_ibgda_ft_dev_t *)state->ft;
+    if (ft == nullptr) return;
+    if (ibgda_t1_on()) return; /* T1: records come from gated waits */
+    const int npes = nvshmemi_device_state_d.npes;
+    const uint32_t nrc = state->num_rc_per_pe * state->num_devices_initialized * (uint32_t)npes;
+    const uint32_t ndci = state->num_shared_dcis + state->num_exclusive_dcis;
+    const bool ring = (state->ft_flags & NVSHMEMI_IBGDA_FT_FLAG_RING_CQ) != 0;
+    atomicExch(&ft->sentinel_running, 1u);
+    uint64_t polls = 0;
+    while (ibgda_ft_ld_u32(&ft->sentinel_stop) == 0u) {
+        for (uint32_t i = 0; i < nrc + ndci; i++) {
+            nvshmemi_ibgda_device_qp_t *qp;
+            if (i < nrc) {
+                if ((int)(i % (uint32_t)npes) == nvshmemi_device_state_d.mype) continue;
+                qp = &state->globalmem.rcs[i];
+            } else {
+                qp = &state->globalmem.dcis[i - nrc];
+            }
+            nvshmemi_ibgda_device_cq_t *cq = qp->tx_wq.cq;
+            struct mlx5_cqe64 *cqe64 = (struct mlx5_cqe64 *)cq->cqe;
+            uint64_t ci = 0;
+            if (ring) { /* v2: the slot at the consumer counter, if the NIC has written it */
+                ci = ibgda_atomic_read(&qp->mvars.ft_ring_ci);
+                cqe64 = (struct mlx5_cqe64 *)((uintptr_t)cq->cqe + ((ci & (cq->ncqes - 1)) << 6));
+            }
+            uint8_t opown = ibgda_atomic_read(&cqe64->op_own);
+            if (ring && (uint32_t)(opown & 1u) != ((ci & cq->ncqes) ? 1u : 0u)) opown = 0xf0;
+            if (ibgda_ft_is_err_opcode(opown)) {
+                uint32_t st = ibgda_atomic_read(&qp->mvars.ft_state);
+                if (st == 0u || st == 3u) {
+                    nvshmemi_ibgda_device_cq_t cqc = *cq;
+                    ibgda_ft_capture(&cqc, cqe64, ibgda_atomic_read(&qp->mvars.tx_wq.ready_head),
+                                     NVSHMEMI_IBGDA_FT_PATH_SENTINEL, ci);
+                }
+            }
+        }
+        polls++;
+        if (poll_ns) __nanosleep(poll_ns);
+    }
+    atomicAdd((unsigned long long int *)&ft->sentinel_polls, (unsigned long long int)polls);
+    atomicExch(&ft->sentinel_running, 0u);
+}
