+static void ibgda_ft_set_failed(const char *why) {
+    if (ibgda_ft.skip & NVSHMEMI_IBGDA_FT_SKIP_FINBAR) { /* v2 (C) negative control, test-only */
+        fprintf(stderr, "[nvshmem-ft] PE%d TEST_SKIP finbar: not marking the transport failed (%s); "
+                        "teardown runs the stock barriers\n", ibgda_ft.t ? ibgda_ft.t->my_pe : -1, why);
+        return;
+    }
+    if (ibgda_ft.t) ibgda_ft.t->attr |= NVSHMEM_TRANSPORT_ATTR_FT_FAILED_BIT;
+    fprintf(stderr, "[nvshmem-ft] PE%d marked failed (%s): device collectives are skipped at teardown\n",
+            ibgda_ft.t ? ibgda_ft.t->my_pe : -1, why);
+}
+
+/* v2 (B): (re)build the device chunk table from the latest heap snapshot. Caller holds heap_mu.
+ * Returns 1 if the device-state fields changed (the host library must push the device state), 0
+ * if only the table contents changed or nothing was done, <0 on error. */
+static int ibgda_ft_bounds_upload(nvshmemi_ibgda_device_state_t *dstate) {
+    if (!ibgda_ft.enabled || !ibgda_ft.bounds || ibgda_ft.heap_size == 0 || dstate == NULL) return 0;
+    const uint32_t shift = 9; /* NVSHMEMI_MALLOC_ALIGNMENT */
+    const uint32_t ngran = (uint32_t)(ibgda_ft.heap_size >> shift);
+    std::vector<uint32_t> tbl(ngran, 0u);
+    bool aligned = true;
+    for (size_t i = 0; i < ibgda_ft.heap_off.size(); i++) {
+        uint64_t o = ibgda_ft.heap_off[i], l = ibgda_ft.heap_len[i];
+        if ((o & 511) || (l & 511) || o + l > ibgda_ft.heap_size) {
+            aligned = false;
+            break;
+        }
+        for (uint64_t g = o >> shift; g < (o + l) >> shift; g++) tbl[g] = (uint32_t)((o + l) >> shift);
+    }
+    int changed = 0;
+    if (!aligned) {
+        /* Cannot express the chunks at 512-B granularity: fall back to the heap-level check. */
+        fprintf(stderr, "[nvshmem-ft] PE%d bounds: heap chunk not 512-B aligned; heap-level check only\n",
+                ibgda_ft.t->my_pe);
+        if (dstate->ft_obj_ngran != 0) changed = 1;
+        dstate->ft_obj_ngran = 0;
+        return changed;
+    }
+    if (ibgda_ft.obj_tbl_d == NULL || ibgda_ft.obj_ngran != ngran) {
+        if (ibgda_ft.obj_tbl_d) cudaFree(ibgda_ft.obj_tbl_d);
+        ibgda_ft.obj_tbl_d = NULL;
+        if (cudaMalloc((void **)&ibgda_ft.obj_tbl_d, (size_t)ngran * 4)) return -1;
+        ibgda_ft.obj_ngran = ngran;
+        changed = 1;
+    }
+    if (cudaMemcpyAsync(ibgda_ft.obj_tbl_d, tbl.data(), (size_t)ngran * 4, cudaMemcpyHostToDevice,
+                        ibgda_ft.stream) ||
+        cudaStreamSynchronize(ibgda_ft.stream))
+        return -2;
+    if (dstate->ft_obj_end != ibgda_ft.obj_tbl_d || dstate->ft_obj_ngran != ngran ||
+        dstate->ft_obj_shift != shift)
+        changed = 1;
+    dstate->ft_obj_end = ibgda_ft.obj_tbl_d;
+    dstate->ft_obj_ngran = ngran;
+    dstate->ft_obj_shift = shift;
+    return changed;
+}
+
+/* v2 (B): the host library publishes its allocator's in-use chunks (offsets from the heap base)
+ * after every symmetric allocation and free (NVSHMEM_IBGDA_FT=1 and NVSHMEM_IBGDA_FT_BOUNDS=1).
+ * Returns 1 if the host library must push the device state (table pointer set or changed). */
+extern "C" __attribute__((visibility("default"))) int nvshmemt_ibgda_ft_heap_objects(
+    const uint64_t *off, const uint64_t *len, int n, uint64_t heap_base, uint64_t heap_size) {
+    std::lock_guard<std::mutex> g(ibgda_ft.heap_mu);
+    ibgda_ft.heap_off.assign(off, off + (n > 0 ? n : 0));
+    ibgda_ft.heap_len.assign(len, len + (n > 0 ? n : 0));
+    ibgda_ft.heap_base = heap_base;
+    ibgda_ft.heap_size = heap_size;
+    ibgda_ft.heap_updates++;
+    if (!ibgda_ft.enabled || !ibgda_ft.bounds || !ibgda_ft.t) return 0;
+    int r = ibgda_ft_bounds_upload((nvshmemi_ibgda_device_state_t *)ibgda_ft.t->type_specific_shared_state);
+    return r > 0 ? 1 : 0;
+}
+
+static uint32_t ibgda_ft_parse_skip(const char *sv) {
+    static const struct { const char *name; uint32_t bit; } k[] = {
+        {"idx", NVSHMEMI_IBGDA_FT_SKIP_IDX},       {"lock", NVSHMEMI_IBGDA_FT_SKIP_LOCK},
+        {"ibuf", NVSHMEMI_IBGDA_FT_SKIP_IBUF},     {"sticky", NVSHMEMI_IBGDA_FT_SKIP_STICKY},
+        {"cqfill", NVSHMEMI_IBGDA_FT_SKIP_CQFILL}, {"dbr", NVSHMEMI_IBGDA_FT_SKIP_DBR},
+        {"nerr", NVSHMEMI_IBGDA_FT_SKIP_NERR},     {"dci", NVSHMEMI_IBGDA_FT_SKIP_DCI},
+        {"psn", NVSHMEMI_IBGDA_FT_SKIP_PSN},       {"finbar", NVSHMEMI_IBGDA_FT_SKIP_FINBAR},
+        {"ringci", NVSHMEMI_IBGDA_FT_SKIP_RINGCI}, {"park", NVSHMEMI_IBGDA_FT_SKIP_PARK}};
+    uint32_t m = 0;
+    if (!sv) return 0;
+    std::string str(sv);
+    size_t p = 0;
+    while (p <= str.size()) {
+        size_t q = str.find(',', p);
+        std::string tok = str.substr(p, q == std::string::npos ? std::string::npos : q - p);
+        bool found = tok.empty();
+        for (auto &e : k)
+            if (tok == e.name) {
+                m |= e.bit;
+                found = true;
+            }
+        if (!found) fprintf(stderr, "[nvshmem-ft] unknown NVSHMEM_IBGDA_FT_TEST_SKIP item '%s'\n", tok.c_str());
+        if (q == std::string::npos) break;
+        p = q + 1;
+    }
+    return m;
+}
+
+/* Called at the end of the first connect_endpoints. */
+static int ibgda_ft_init(nvshmem_transport_t t, nvshmemt_ibgda_state_t *st,
+                         nvshmemi_ibgda_device_state_t *dstate) {
+    const char *on = getenv("NVSHMEM_IBGDA_FT");
+    if (!on || atoi(on) == 0) return 0;
+    const char *bd = getenv("NVSHMEM_IBGDA_FT_BOUNDS");
+    ibgda_ft.ring = (ibgda_ft_ring_cq_mode == 1);
+    ibgda_ft.bounds = bd && atoi(bd) != 0;
+    ibgda_ft.skip = ibgda_ft_parse_skip(getenv("NVSHMEM_IBGDA_FT_TEST_SKIP"));
+    /* v2.1 test-only: NVSHMEM_IBGDA_FT_TEST_TRIP=ring_d:<n> (the n-th consumed ring CQE fails the
+     * invariant check -> RING_INVARIANT record + error) or ring_d_silent:<n> (emulates v2: the
+     * CQE is consumed without advancing cons_idx and without a record). Ring mode only. */
+    uint32_t trip_n = 0, trip_mode = 0;
+    {
+        const char *tt = getenv("NVSHMEM_IBGDA_FT_TEST_TRIP");
+        if (tt && !strncmp(tt, "ring_d_silent:", 14)) {
+            trip_mode = 2;
+            trip_n = (uint32_t)atoi(tt + 14);
+        } else if (tt && !strncmp(tt, "ring_d:", 7)) {
+            trip_mode = 1;
+            trip_n = (uint32_t)atoi(tt + 7);
+        } else if (tt && *tt) {
+            fprintf(stderr, "[nvshmem-ft] unknown NVSHMEM_IBGDA_FT_TEST_TRIP '%s'\n", tt);
+        }
+        if (trip_n == 0) trip_mode = 0;
+    }
+    const char *pu = getenv("NVSHMEM_IBGDA_FT_POLL_US");
+    const char *cap = getenv("NVSHMEM_IBGDA_FT_CAPTURE");
+    const char *dm = getenv("NVSHMEM_IBGDA_FT_DRAIN_MS");
+    const char *ql = getenv("NVSHMEM_IBGDA_FT_QUIET");
+    ibgda_ft.poll_us = pu ? atoi(pu) : 50;
+    if (ibgda_ft.poll_us < 1) ibgda_ft.poll_us = 1;
+    ibgda_ft.drain_ms = dm ? atoi(dm) : 1000;
+    ibgda_ft.quiet_log = ql && atoi(ql) != 0;
+    ibgda_ft.flags = NVSHMEMI_IBGDA_FT_FLAG_ON;
+    if (cap && !strcmp(cap, "exit")) ibgda_ft.flags |= NVSHMEMI_IBGDA_FT_FLAG_CAPTURE_EXIT;
+    if (ibgda_ft.ring) ibgda_ft.flags |= NVSHMEMI_IBGDA_FT_FLAG_RING_CQ;
+    if (ibgda_ft.bounds) ibgda_ft.flags |= NVSHMEMI_IBGDA_FT_FLAG_BOUNDS;
+    if (trip_mode && ibgda_ft.ring) ibgda_ft.flags |= NVSHMEMI_IBGDA_FT_FLAG_TEST_TRIP;
+    if (!(ibgda_ft.skip & NVSHMEMI_IBGDA_FT_SKIP_PARK)) ibgda_ft.flags |= NVSHMEMI_IBGDA_FT_FLAG_PARK;
+    ibgda_ft.t = t;
+    ibgda_ft.st = st;
+    ibgda_ft.prep.assign(t->n_pes, ibgda_ft_prep());
+    memset(ibgda_ft.last_seq, 0, sizeof(ibgda_ft.last_seq));
+    ibgda_ft.have_error.store(0);
+    ibgda_ft.nrecords = 0;
+    ibgda_ft.commits.store(0);
+    ibgda_ft.fire_in_commit.store(0);
+
+    int status = cudaStreamCreateWithFlags(&ibgda_ft.stream, cudaStreamNonBlocking);
+    if (status) goto fail;
+    status = cudaHostAlloc(&ibgda_ft.pinned, 4096, cudaHostAllocDefault);
+    if (status) goto fail;
+    status = cudaHostAlloc((void **)&ibgda_ft.mbox_h,
+                           NVSHMEMI_IBGDA_FT_NSLOTS * sizeof(nvshmemi_ibgda_ft_record_t),
+                           cudaHostAllocMapped);
+    if (status) goto fail;
+    memset(ibgda_ft.mbox_h, 0, NVSHMEMI_IBGDA_FT_NSLOTS * sizeof(nvshmemi_ibgda_ft_record_t));
+    status = cudaHostGetDevicePointer((void **)&ibgda_ft.mbox_d, ibgda_ft.mbox_h, 0);
+    if (status) goto fail;
+    status = cudaMalloc((void **)&ibgda_ft.dev_d, sizeof(nvshmemi_ibgda_ft_dev_t));
+    if (status) goto fail;
+    {
+        nvshmemi_ibgda_ft_dev_t h;
+        memset(&h, 0, sizeof(h));
+        h.mbox = ibgda_ft.mbox_d;
+        h.nslots = NVSHMEMI_IBGDA_FT_NSLOTS;
+        h.flags = ibgda_ft.flags;
+        h.test_trip = (ibgda_ft.flags & NVSHMEMI_IBGDA_FT_FLAG_TEST_TRIP) ? trip_n : 0;
+        h.test_trip_mode = (ibgda_ft.flags & NVSHMEMI_IBGDA_FT_FLAG_TEST_TRIP) ? trip_mode : 0;
+        status = cudaMemcpy(ibgda_ft.dev_d, &h, sizeof(h), cudaMemcpyHostToDevice);
+        if (status) goto fail;
+    }
+    if (ibgda_ft.ring) {
+        /* v2.1: the no-lap argument (DESIGN of ibgda_ft_ring_poll) needs nwqes <= ncqes for every
+         * send queue; both are round_up_pow2(QP_DEPTH) here. Checked, not assumed. */
+        for (int i = 0; i < st->n_devs_selected; i++) {
+            struct ibgda_device *device =
+                (struct ibgda_device *)st->common.devices + st->selected_dev_ids[i];
+            for (int e = 0; e < device->rc.num_eps_per_pe * t->n_pes; e++) {
+                struct ibgda_ep *ep = device->rc.eps ? device->rc.eps[e] : NULL;
+                if (ep && ep->send_cq && ep->sq_cnt > ep->send_cq->num_cqe) {
+                    status = -2;
+                    goto fail;
+                }
+            }
+            for (int e = 0; e < device->dci.num_eps; e++) {
+                struct ibgda_ep *ep = device->dci.eps ? device->dci.eps[e] : NULL;
+                if (ep && ep->send_cq && ep->sq_cnt > ep->send_cq->num_cqe) {
+                    status = -2;
+                    goto fail;
+                }
+            }
+        }
+    }
+    dstate->ft = ibgda_ft.dev_d;
+    dstate->ft_flags = ibgda_ft.flags;
+    ibgda_ft.enabled = true;
+    {
+        /* v2 (B): table from the heap snapshot the host library published before connect */
+        std::lock_guard<std::mutex> g(ibgda_ft.heap_mu);
+        if (ibgda_ft_bounds_upload(dstate) < 0) {
+            status = -1;
+            ibgda_ft.enabled = false;
+            goto fail;
+        }
+    }
+    ibgda_ft.stop.store(false);
+    ibgda_ft.watcher = std::thread(ibgda_ft_watcher_main);
+    fprintf(stderr,
+            "[nvshmem-ft] PE%d enabled: classifier=%s mailbox=%d x %zu B poll_us=%d handler=%s "
+            "recovery=%s rc_per_pe=%d ring_cq=%d bounds=%d(%s, %u granules, %zu chunks, %u snapshots) "
+            "test_skip=0x%x test_trip=%s:%u sq=%u cq=%u park=%d\n",
+            t->my_pe,
+            ibgda_ft.ring ? "ring-walk"
+            : (ibgda_ft.flags & NVSHMEMI_IBGDA_FT_FLAG_CAPTURE_EXIT) ? "exit-only(diag)" : "in-loop",
+            NVSHMEMI_IBGDA_FT_NSLOTS, sizeof(nvshmemi_ibgda_ft_record_t), ibgda_ft.poll_us,
+            ibgda_nic_handler == IBGDA_NIC_HANDLER_GPU ? "GPU" : "CPU-proxy",
+            ibgda_nic_handler == IBGDA_NIC_HANDLER_GPU ? "available" : "declined (CPU-proxy handler)",
+            st->common.options->IBGDA_NUM_RC_PER_PE, ibgda_ft.ring ? 1 : 0, ibgda_ft.bounds ? 1 : 0,
+            !ibgda_ft.bounds ? "off" : dstate->ft_obj_ngran ? "chunk table" : "heap-level until the "
+                                                                               "first snapshot",
+            dstate->ft_obj_ngran, ibgda_ft.heap_off.size(), ibgda_ft.heap_updates, ibgda_ft.skip,
+            !(ibgda_ft.flags & NVSHMEMI_IBGDA_FT_FLAG_TEST_TRIP) ? "off"
+            : trip_mode == 2                                     ? "ring_d_silent"
+                                                                 : "ring_d",
+            (ibgda_ft.flags & NVSHMEMI_IBGDA_FT_FLAG_TEST_TRIP) ? trip_n : 0,
+            (unsigned)ibgda_round_up_pow2_or_0(ibgda_qp_depth),
+            (unsigned)ibgda_round_up_pow2_or_0(ibgda_qp_depth),
+            (ibgda_ft.flags & NVSHMEMI_IBGDA_FT_FLAG_PARK) ? 1 : 0);
+    return 0;
+fail:
+    fprintf(stderr, "[nvshmem-ft] PE%d init failed (cuda %d); FT stays off\n", t->my_pe, status);
+    dstate->ft = NULL;
+    dstate->ft_flags = 0;
+    dstate->ft_obj_end = NULL;
+    dstate->ft_obj_ngran = 0;
+    /* v2: ring CQs cannot be polled by the stock (collapsed) device code: fail the connect. */
+    return ibgda_ft.ring ? NVSHMEMX_ERROR_INTERNAL : 0;
+}
+
+static void ibgda_ft_fini(nvshmemi_ibgda_device_state_t *dstate) {
+    if (!ibgda_ft.enabled) return;
+    ibgda_ft.stop.store(true);
+    if (ibgda_ft.watcher.joinable()) ibgda_ft.watcher.join();
+    ibgda_ft.enabled = false;
+    if (dstate) {
+        dstate->ft = NULL;
+        dstate->ft_flags = 0;
+        dstate->ft_obj_end = NULL;
+        dstate->ft_obj_ngran = 0;
+    }
+    {
+        std::lock_guard<std::mutex> g(ibgda_ft.heap_mu);
+        if (ibgda_ft.obj_tbl_d) cudaFree(ibgda_ft.obj_tbl_d);
+        ibgda_ft.obj_tbl_d = NULL;
+        ibgda_ft.obj_ngran = 0;
+    }
+    if (ibgda_ft.dev_d) cudaFree(ibgda_ft.dev_d);
+    if (ibgda_ft.mbox_h) cudaFreeHost(ibgda_ft.mbox_h);
+    if (ibgda_ft.pinned) cudaFreeHost(ibgda_ft.pinned);
+    if (ibgda_ft.stream) cudaStreamDestroy(ibgda_ft.stream);
+    ibgda_ft.dev_d = NULL;
+    ibgda_ft.mbox_h = NULL;
+    ibgda_ft.pinned = NULL;
+    ibgda_ft.stream = 0;
+}
+
+/* RC endpoints to `peer`, in (device, slot) order: the same order on both sides. */
+static int ibgda_ft_rc_eps(int peer, struct ibgda_ep **eps, struct ibgda_device **devs, int max) {
+    nvshmemt_ibgda_state_t *st = ibgda_ft.st;
+    int n_pes = ibgda_ft.t->n_pes, n = 0;
+    for (int i = 0; i < st->n_devs_selected; i++) {
+        struct ibgda_device *device =
+            (struct ibgda_device *)st->common.devices + st->selected_dev_ids[i];
+        for (int e = 0; e < device->rc.num_eps_per_pe * n_pes; e++) {
+            if (e % n_pes != peer) continue;
+            struct ibgda_ep *ep = device->rc.eps ? device->rc.eps[e] : NULL;
+            if (!ep) continue;
+            if (n >= max) return -1;
+            eps[n] = ep;
+            devs[n] = device;
+            n++;
+        }
+    }
+    return n;
+}
+
+/* Copy one QP's device management variables to the host (non-blocking stream). */
+static int ibgda_ft_read_mvars(nvshmemi_ibgda_device_qp_t *qp_d,
+                               nvshmemi_ibgda_device_qp_management_t *out) {
+    int s = cudaMemcpyAsync(ibgda_ft.pinned, &qp_d->mvars, sizeof(*out), cudaMemcpyDeviceToHost,
+                            ibgda_ft.stream);
+    if (!s) s = cudaStreamSynchronize(ibgda_ft.stream);
+    if (!s) memcpy(out, ibgda_ft.pinned, sizeof(*out));
+    return s;
+}
+
+/* v2 (A): QUERY_CQ -> producer counter (24 bits). Returns the DEVX status. */
+static int ibgda_ft_query_cq_pi(struct ibgda_cq *cq, uint32_t *pi) {
+    uint8_t cmd_in[DEVX_ST_SZ_BYTES(ibgda_fi_query_cq_in)] = {0};
+    uint8_t cmd_out[DEVX_ST_SZ_BYTES(ibgda_fi_query_cq_out)] = {0};
+    DEVX_SET(ibgda_fi_query_cq_in, cmd_in, opcode, MLX5_CMD_OP_QUERY_CQ);
+    DEVX_SET(ibgda_fi_query_cq_in, cmd_in, cqn, cq->cqn);
+    int st = mlx5dv_devx_obj_query(cq->devx_cq, cmd_in, sizeof(cmd_in), cmd_out, sizeof(cmd_out));
+    void *cqc = DEVX_ADDR_OF(ibgda_fi_query_cq_out, cmd_out, cq_context);
+    *pi = DEVX_GET(cqc, cqc, producer_counter);
+    return st;
+}
+
+/* v2 (A): the device consumer counter a ring CQ must restart from after its QP was reset. The
+ * NIC's producer counter keeps running across a QP reset (the CQ is not reset), so the counter
+ * is set to it: QUERY_CQ producer_counter, cross-checked against a host scan of the ring from
+ * the old counter (the unconsumed CQEs: the error CQE and its flushes). Returns 0 and *new_ci. */
+static int ibgda_ft_ring_resume_ci(struct ibgda_ep *ep, uint64_t ci_old, uint64_t *new_ci,
+                                   uint32_t *scan_out, uint32_t *pi_out) {
+    struct ibgda_cq *cq = ep->send_cq;
+    const uint32_t n = cq->num_cqe;
+    std::vector<uint8_t> buf((size_t)n * NVSHMEMI_IBGDA_CQE_SIZE);
+    int s = cudaMemcpyAsync(buf.data(), cq->cq_mobject->aligned.gpu_ptr, buf.size(),
+                            cudaMemcpyDeviceToHost, ibgda_ft.stream);
+    if (!s) s = cudaStreamSynchronize(ibgda_ft.stream);
+    if (s) return -1;
+    uint32_t scan = 0;
+    while (scan < n) {
+        const uint64_t c = ci_old + scan;
+        const uint8_t opown = buf[(size_t)(c & (n - 1)) * NVSHMEMI_IBGDA_CQE_SIZE + 63];
+        if ((opown >> 4) == 0xf || (uint32_t)(opown & 1) != ((c & n) ? 1u : 0u)) break;
+        scan++;
+    }
+    uint32_t pi = 0;
+    if (ibgda_ft_query_cq_pi(cq, &pi)) return -2;
+    const uint32_t ahead = (pi - (uint32_t)ci_old) & 0xffffffu; /* CQEs produced since ci_old */
+    *scan_out = scan;
+    *pi_out = pi;
+    /* The scan cannot see more than one lap; QUERY_CQ must agree with it unless the ring wrapped
+     * (then only QUERY_CQ is right, and it is used). */
+    if (ahead < scan || ahead > (1u << 22)) return -3;
+    *new_ci = (ibgda_ft.skip & NVSHMEMI_IBGDA_FT_SKIP_RINGCI) ? 0 : ci_old + ahead;
+    return 0;
+}
+
+/* Device-side resync of one QP while it is in RESET: refill its collapsed CQ with the creation
+ * pattern (0xff: opcode invalid, wqe_counter 0xffff), zero its doorbell record, then zero its
+ * management variables (indices, lock, FT sticky record) = the state ibgda_get_device_qp_mvars
+ * gives a new QP. The CQ goes first so that a sentinel never sees a stale error CQE together with
+ * a cleared sticky record.
+ * v2: ring mode (A) restarts the ring consumer counter at the CQ's producer counter instead of 0
+ * (read before the refill); the test-only knobs (C) skip single steps. */
+#define IBGDA_FT_SKIP_MVARS                                                           \
+    (NVSHMEMI_IBGDA_FT_SKIP_IDX | NVSHMEMI_IBGDA_FT_SKIP_LOCK | NVSHMEMI_IBGDA_FT_SKIP_IBUF | \
+     NVSHMEMI_IBGDA_FT_SKIP_STICKY)
+static int ibgda_ft_resync_qp(struct ibgda_ep *ep, nvshmemi_ibgda_device_qp_t *qp_d,
+                              uint64_t *ring_ci_old = NULL, uint32_t *ring_scan = NULL,
+                              uint32_t *ring_pi = NULL) {
+    const uint32_t skip = ibgda_ft.skip;
+    const bool host_built = ibgda_ft.ring || (skip & IBGDA_FT_SKIP_MVARS);
+    nvshmemi_ibgda_device_qp_management_t m;
+    uint64_t new_ci = 0;
+    int s = 0;
+    if (host_built) {
+        if (ibgda_ft_read_mvars(qp_d, &m)) return -1;
+        if (ibgda_ft.ring) {
+            uint32_t scan = 0, pi = 0;
+            int r = ibgda_ft_ring_resume_ci(ep, m.ft_ring_ci, &new_ci, &scan, &pi);
+            if (ring_ci_old) *ring_ci_old = m.ft_ring_ci;
+            if (ring_scan) *ring_scan = scan;
+            if (ring_pi) *ring_pi = pi;
+            if (r) {
+                fprintf(stderr, "[nvshmem-ft] PE%d ring resync of qpn 0x%x failed (%d): ci=%llu scan=%u "
+                                "cq_pi=%u\n", ibgda_ft.t->my_pe, ep->qpn, r,
+                        (unsigned long long)m.ft_ring_ci, scan, pi);
+                return -2;
+            }
+        }
+    }
+    if (!(skip & NVSHMEMI_IBGDA_FT_SKIP_CQFILL))
+        s = cudaMemsetAsync(ep->send_cq->cq_mobject->base.gpu_ptr, 0xff,
+                            ep->send_cq->cq_mobject->base.size, ibgda_ft.stream);
+    if (!s && !(skip & NVSHMEMI_IBGDA_FT_SKIP_DBR))
+        s = cudaMemsetAsync((char *)ep->qp_ctrl.dbr_mobject->aligned.gpu_ptr + ep->qp_ctrl.dbr_offset,
+                            0, IBGDA_DBRSIZE, ibgda_ft.stream);
+    if (!s) s = cudaStreamSynchronize(ibgda_ft.stream);
+    if (!s && !host_built)
+        s = cudaMemsetAsync(&qp_d->mvars, 0, sizeof(nvshmemi_ibgda_device_qp_management_t),
+                            ibgda_ft.stream);
+    if (!s && host_built) {
+        nvshmemi_ibgda_device_qp_management_t z;
+        memset(&z, 0, sizeof(z)); /* = ibgda_get_device_qp_mvars (setup), then the kept fields */
+        if (skip & NVSHMEMI_IBGDA_FT_SKIP_IDX) z.tx_wq = m.tx_wq;
+        if (skip & NVSHMEMI_IBGDA_FT_SKIP_LOCK) z.post_send_lock = m.post_send_lock;
+        if (skip & NVSHMEMI_IBGDA_FT_SKIP_IBUF) z.ibuf = m.ibuf;
+        if (skip & NVSHMEMI_IBGDA_FT_SKIP_STICKY) {
+            z.ft_state = m.ft_state;
+            z.ft_fp = m.ft_fp;
+            z.ft_wqe = m.ft_wqe;
+            z.ft_aux = m.ft_aux;
+        }
+        z.ft_ring_ci = new_ci;
+        memcpy(ibgda_ft.pinned, &z, sizeof(z));
+        s = cudaMemcpyAsync(&qp_d->mvars, ibgda_ft.pinned, sizeof(z), cudaMemcpyHostToDevice,
+                            ibgda_ft.stream);
+    }
+    if (!s) s = cudaStreamSynchronize(ibgda_ft.stream);
+    return s;
+}
+
+static bool ibgda_ft_quiescent(const nvshmemi_ibgda_device_qp_management_t *m) {
+    /* v2.1: a parked QP (prod_idx = PARK_MARK) has rung nothing since its error was recorded;
+     * every WQE the device made ready was either rung before or dropped. */
+    const bool parked = (m->tx_wq.prod_idx & NVSHMEMI_IBGDA_FT_PARK_MARK) != 0;
+    return m->post_send_lock == 0 && m->tx_wq.resv_head == m->tx_wq.ready_head &&
+           (parked || m->tx_wq.ready_head == m->tx_wq.prod_idx) && m->ibuf.head == m->ibuf.tail;
+}
+
+extern "C" __attribute__((visibility("default"))) int nvshmemt_ibgda_ft_enabled(void) {
+    return ibgda_ft.enabled ? NVSHMEMT_IBGDA_FT_API_VERSION : 0;
+}
+
+extern "C" __attribute__((visibility("default"))) uint32_t nvshmemt_ibgda_ft_commits(void) {
+    return ibgda_ft.commits.load();
+}
+
+/* 1 and *out filled if an unrecovered error record exists (waits up to wait_ms for one). */
+extern "C" __attribute__((visibility("default"))) int nvshmemt_ibgda_ft_query(
+    nvshmemt_ibgda_ft_info_t *out, int wait_ms) {
+    if (!ibgda_ft.enabled) return -1;
+    double t0 = ibgda_ft_mono_ms();
+    for (;;) {
+        if (ibgda_ft.have_error.load()) {
+            std::lock_guard<std::mutex> g(ibgda_ft.mu);
+            if (out) *out = ibgda_ft.first;
+            return 1;
+        }
+        if (ibgda_ft_mono_ms() - t0 >= wait_ms) break;
+        std::this_thread::sleep_for(std::chrono::microseconds(20));
+    }
+    if (out) memset(out, 0, sizeof(*out));
+    return 0;
+}
+
+extern "C" __attribute__((visibility("default"))) int nvshmemt_ibgda_ft_mark_failed(void) {
+    if (!ibgda_ft.t) return -1;
+    ibgda_ft_set_failed("application");
+    return 0;
+}
+
+/* Stop a running device sentinel (see nvshmemx_ibgda_ft_sentinel); waits up to wait_ms. */
+extern "C" __attribute__((visibility("default"))) int nvshmemt_ibgda_ft_sentinel_stop(int wait_ms,
+                                                                                    uint64_t *polls) {
+    if (!ibgda_ft.enabled) return -1;
+    uint32_t one = 1;
+    memcpy(ibgda_ft.pinned, &one, sizeof(one));
+    int s = cudaMemcpyAsync(&ibgda_ft.dev_d->sentinel_stop, ibgda_ft.pinned, sizeof(one),
+                            cudaMemcpyHostToDevice, ibgda_ft.stream);
+    if (!s) s = cudaStreamSynchronize(ibgda_ft.stream);
+    double t0 = ibgda_ft_mono_ms();
+    nvshmemi_ibgda_ft_dev_t h;
+    do {
+        s = cudaMemcpyAsync(ibgda_ft.pinned, ibgda_ft.dev_d, sizeof(h), cudaMemcpyDeviceToHost,
+                            ibgda_ft.stream);
+        if (!s) s = cudaStreamSynchronize(ibgda_ft.stream);
+        memcpy(&h, ibgda_ft.pinned, sizeof(h));
+        if (s || h.sentinel_running == 0) break;
+        std::this_thread::sleep_for(std::chrono::microseconds(100));
+    } while (ibgda_ft_mono_ms() - t0 < wait_ms);
+    if (polls) *polls = h.sentinel_polls;
+    return (s == 0 && h.sentinel_running == 0) ? 0 : -1;
+}
+
+/* Prepare: pause nothing (the GPU handler has no proxy); check that the device is quiescent on
+ * every RC QP to `peer`, move them to ERR, wait until the NIC has flushed every posted WQE, draw
+ * fresh send PSNs. Returns 0 and the local token, or <0 (decline; QPs possibly left in ERR). */
+extern "C" __attribute__((visibility("default"))) int nvshmemt_ibgda_ft_prepare(
+    int peer, nvshmemt_ibgda_ft_token_t *tok, nvshmemt_ibgda_ft_stats_t *stats) {
+    nvshmemt_ibgda_ft_stats_t lst;
+    nvshmemt_ibgda_ft_stats_t *S = stats ? stats : &lst;
+    memset(S, 0, sizeof(*S));
+    if (!ibgda_ft.enabled) return -1;
+    if (ibgda_nic_handler != IBGDA_NIC_HANDLER_GPU) {
+        snprintf(S->msg, sizeof(S->msg), "declined: recovery needs the GPU NIC handler");
+        return -2;
+    }
+    if (peer < 0 || peer >= ibgda_ft.t->n_pes || peer == ibgda_ft.t->my_pe) return -3;
+    std::lock_guard<std::mutex> opg(ibgda_ft.op_mu);
+    std::lock_guard<std::mutex> lk(ibgda_ft.st->rc_endpoint_lock);
+    double t0 = ibgda_ft_mono_ms();
+    nvshmemi_ibgda_device_state_t *dstate =
+        (nvshmemi_ibgda_device_state_t *)ibgda_ft.t->type_specific_shared_state;
+    struct ibgda_ep *eps[NVSHMEMT_IBGDA_FT_MAX_QPS];
+    struct ibgda_device *devs[NVSHMEMT_IBGDA_FT_MAX_QPS];
+    int n = ibgda_ft_rc_eps(peer, eps, devs, NVSHMEMT_IBGDA_FT_MAX_QPS);
+    if (n <= 0) {
+        snprintf(S->msg, sizeof(S->msg), "declined: %s RC QPs to PE %d",
+                 n == 0 ? "no" : "too many", peer);
+        return -4;
+    }
+    nvshmemi_ibgda_device_qp_management_t mv[NVSHMEMT_IBGDA_FT_MAX_QPS];
+    for (int i = 0; i < n; i++) {
+        if (ibgda_ft_read_mvars(&dstate->globalmem.rcs[eps[i]->user_index], &mv[i])) return -5;
+        if (!ibgda_ft_quiescent(&mv[i])) {
+            snprintf(S->msg, sizeof(S->msg),
+                     "declined: QP 0x%x not quiescent (lock=%d resv=%llu ready=%llu prod=%llu "
+                     "ibuf %llu/%llu)",
+                     eps[i]->qpn, mv[i].post_send_lock, (unsigned long long)mv[i].tx_wq.resv_head,
+                     (unsigned long long)mv[i].tx_wq.ready_head,
+                     (unsigned long long)mv[i].tx_wq.prod_idx, (unsigned long long)mv[i].ibuf.head,
+                     (unsigned long long)mv[i].ibuf.tail);
+            return -6;
+        }
+        S->prod_idx[i] = (uint32_t)mv[i].tx_wq.prod_idx;
+        ibgda_ft_query_qp(eps[i]->devx_qp, eps[i]->qpn, &S->qp_state[i], NULL, NULL);
+    }
+    /* No old-incarnation WQE may execute after this: every QP of the pair goes to ERR. */
+    for (int i = 0; i < n; i++) {
+        if (S->qp_state[i] != 6 && ibgda_ft_qp_cmd(eps[i]->devx_qp, eps[i]->qpn, MLX5_CMD_OP_2ERR_QP))
+            return -7;
+    }
+    double t1 = ibgda_ft_mono_ms();
+    S->to_err_ms = t1 - t0;
+    /* Drain: the NIC flushes [consumer, P) after the ERR transition, P = the send word of the
+     * doorbell record (../nvshmem_rootcause); wait until its consumer reached P. v2.1: P is read
+     * from the record, not taken from the device producer index: they are equal unless the QP was
+     * parked (FT_FLAG_PARK), when posts after the error were counted but never rung. */
+    uint32_t dbr_sq[NVSHMEMT_IBGDA_FT_MAX_QPS];
+    for (int i = 0; i < n; i++) {
+        uint32_t w[2] = {0, 0};
+        if (cudaMemcpyAsync(ibgda_ft.pinned,
+                            (char *)eps[i]->qp_ctrl.dbr_mobject->aligned.gpu_ptr + eps[i]->qp_ctrl.dbr_offset,
+                            sizeof(w), cudaMemcpyDeviceToHost, ibgda_ft.stream) ||
+            cudaStreamSynchronize(ibgda_ft.stream))
+            return -5;
+        memcpy(w, ibgda_ft.pinned, sizeof(w));
+        dbr_sq[i] = be32toh(w[1]) & 0xffff; /* word 1 = send producer (GPU handler) */
+    }
+    int drained = 0;
+    uint32_t last_hw = 0, last_sw = 0;
+    for (;;) {
+        drained = 1;
+        for (int i = 0; i < n; i++) {
+            uint32_t s = 0, hw = 0, sw = 0;
+            ibgda_ft_query_qp(eps[i]->devx_qp, eps[i]->qpn, &s, &hw, &sw);
+            if (s != 6 || hw != dbr_sq[i]) drained = 0;
+            if (i == 0) {
+                last_hw = hw;
+                last_sw = sw;
+            }
+        }
+        if (drained || ibgda_ft_mono_ms() - t1 > ibgda_ft.drain_ms) break;
+        std::this_thread::sleep_for(std::chrono::microseconds(50));
+    }
+    double t2 = ibgda_ft_mono_ms();
+    S->drain_ms = t2 - t1;
+    S->drained = drained;
+    if (!drained) {
+        uint32_t cq_pi = 0;
+        ibgda_ft_query_cq_pi(eps[0]->send_cq, &cq_pi);
+        snprintf(S->msg, sizeof(S->msg),
+                 "declined: NIC did not flush every posted WQE in %d ms (hw_sq %u sw_sq %u dbr %u "
+                 "ready16 %u cq_pi %u ring_ci %llu parked %d)",
+                 ibgda_ft.drain_ms, last_hw, last_sw, dbr_sq[0],
+                 (unsigned)(mv[0].tx_wq.ready_head & 0xffff), cq_pi,
+                 (unsigned long long)mv[0].ft_ring_ci,
+                 (mv[0].tx_wq.prod_idx & NVSHMEMI_IBGDA_FT_PARK_MARK) ? 1 : 0);
+        return -8;
+    }
+    std::random_device rd;
+    tok->magic = NVSHMEMT_IBGDA_FT_TOKEN_MAGIC;
+    tok->nqps = n;
+    tok->pe = ibgda_ft.t->my_pe;
+    tok->peer = peer;
+    ibgda_ft_prep &p = ibgda_ft.prep[peer];
+    p.nqps = n;
+    for (int i = 0; i < n; i++) {
+        uint32_t psn = ((uint32_t)rd() ^ ((uint32_t)rd() << 7)) & 0xffffff;
+        if (ibgda_ft.skip & NVSHMEMI_IBGDA_FT_SKIP_PSN) psn = 0; /* v2 (C) test-only: stock PSN */
+        p.sq_psn[i] = psn;
+        tok->qp[i].qpn = eps[i]->qpn;
+        tok->qp[i].peer_qpn = eps[i]->ft_peer.qpn;
+        tok->qp[i].sq_psn = psn;
+        tok->qp[i].prod_idx = (uint32_t)mv[i].tx_wq.prod_idx;
+    }
+    p.prepared = true;
+    S->nqps = n;
+    S->prepare_ms = ibgda_ft_mono_ms() - t0;
+    snprintf(S->msg, sizeof(S->msg), "prepared %d QP(s)", n);
+    return 0;
+}
+
+/* Reset one DCI of this PE that is not in RTS (local only: DCIs have no fixed peer). */
+static int ibgda_ft_reset_dci(struct ibgda_device *device, struct ibgda_ep *ep,
+                              nvshmemi_ibgda_device_qp_t *qp_d) {
+    nvshmemt_ibgda_state_t *st = ibgda_ft.st;
+    nvshmemi_ibgda_device_qp_management_t m;
+    if (ibgda_ft_read_mvars(qp_d, &m)) return -1;
+    if (!ibgda_ft_quiescent(&m)) return -2;
+    if (ibgda_ft_qp_cmd(ep->devx_qp, ep->qpn, MLX5_CMD_OP_2RST_QP)) return -3;
+    if (ibgda_ft_resync_qp(ep, qp_d)) return -4;
+    if (ibgda_qp_rst2init(st, ep, device, ep->portid)) return -5;
+    if (ibgda_dci_init2rtr(st, ep, device, ep->portid)) return -6;
+    if (ibgda_qp_rtr2rts(st, ep, device, 0)) return -7;
+    return 0;
+}
+
+/* Commit: with the peer's token, reset every RC QP to `peer` (RESET, device resync, INIT, RTR with
+ * rq_psn = peer's new sq_psn, RTS with our new sq_psn), reset any local DCI left in ERR, clear the
+ * FT error state. On failure the QPs are left in ERR or RESET (declined). */
+extern "C" __attribute__((visibility("default"))) int nvshmemt_ibgda_ft_commit(
+    int peer, const nvshmemt_ibgda_ft_token_t *remote, nvshmemt_ibgda_ft_stats_t *stats) {
+    nvshmemt_ibgda_ft_stats_t lst;
+    nvshmemt_ibgda_ft_stats_t *S = stats ? stats : &lst;
+    if (!ibgda_ft.enabled) return -1;
+    if (peer < 0 || peer >= ibgda_ft.t->n_pes) return -3;
+    int rc = 0;
+    {
+        std::lock_guard<std::mutex> opg(ibgda_ft.op_mu);
+        std::lock_guard<std::mutex> lk(ibgda_ft.st->rc_endpoint_lock);
+        nvshmemt_ibgda_state_t *st = ibgda_ft.st;
+        ibgda_ft_prep &p = ibgda_ft.prep[peer];
+        nvshmemi_ibgda_device_state_t *dstate =
+            (nvshmemi_ibgda_device_state_t *)ibgda_ft.t->type_specific_shared_state;
+        struct ibgda_ep *eps[NVSHMEMT_IBGDA_FT_MAX_QPS];
+        struct ibgda_device *devs[NVSHMEMT_IBGDA_FT_MAX_QPS];
+        int n = ibgda_ft_rc_eps(peer, eps, devs, NVSHMEMT_IBGDA_FT_MAX_QPS);
+        if (!p.prepared) {
+            snprintf(S->msg, sizeof(S->msg), "declined: commit without prepare");
+            return -10;
+        }
+        if (!remote || remote->magic != NVSHMEMT_IBGDA_FT_TOKEN_MAGIC || (int)remote->nqps != n ||
+            remote->pe != peer || remote->peer != ibgda_ft.t->my_pe || n != (int)p.nqps) {
+            snprintf(S->msg, sizeof(S->msg), "declined: token mismatch");
+            return -11;
+        }
+        for (int i = 0; i < n; i++) {
+            if (remote->qp[i].qpn != eps[i]->ft_peer.qpn || remote->qp[i].peer_qpn != eps[i]->qpn) {
+                snprintf(S->msg, sizeof(S->msg), "declined: QPN mismatch at %d (0x%x/0x%x)", i,
+                         remote->qp[i].qpn, remote->qp[i].peer_qpn);
+                return -12;
+            }
+        }
+        double t0 = ibgda_ft_mono_ms();
+        for (int i = 0; i < n; i++)
+            if (ibgda_ft_qp_cmd(eps[i]->devx_qp, eps[i]->qpn, MLX5_CMD_OP_2RST_QP)) return -13;
+        double t1 = ibgda_ft_mono_ms();
+        S->skip_mask = ibgda_ft.skip;
+        for (int i = 0; i < n; i++)
+            if (ibgda_ft_resync_qp(eps[i], &dstate->globalmem.rcs[eps[i]->user_index],
+                                   &S->ring_ci_old[i], &S->ring_scan[i], &S->ring_pi[i])) {
+                snprintf(S->msg, sizeof(S->msg), "declined: device resync of QP 0x%x failed%s",
+                         eps[i]->qpn, ibgda_ft.ring ? " (ring counter)" : "");
+                return -14;
+            }
+        double t2 = ibgda_ft_mono_ms();
+        for (int i = 0; i < n; i++) {
+            struct ibgda_ep *ep = eps[i];
+            struct ibgda_rc_handle h;
+            memset(&h, 0, sizeof(h));
+            h.qpn = ep->ft_peer.qpn;
+            h.lid = ep->ft_peer.lid;
+            h.spn = ep->ft_peer.spn;
+            h.iid = ep->ft_peer.iid;
+            if (ep->ah) { /* init2rtr creates a fresh AH from the same attributes */
+                ftable.destroy_ah(ep->ah);
+                ep->ah = NULL;
+            }
+            if (ibgda_qp_rst2init(st, ep, devs[i], ep->portid)) return -15;
+            if (ibgda_rc_init2rtr(st, ep, devs[i], ep->portid, &h, remote->qp[i].sq_psn)) return -16;
+            if (ibgda_qp_rtr2rts(st, ep, devs[i], p.sq_psn[i])) return -17;
+        }
+        double t3 = ibgda_ft_mono_ms();
+        /* Local DCIs left in ERR (the fault hook moves every QP of the PE). */
+        S->ndci_reset = 0;
+        for (int d = 0; d < st->n_devs_selected && !(ibgda_ft.skip & NVSHMEMI_IBGDA_FT_SKIP_DCI);
+             d++) {
+            struct ibgda_device *device =
+                (struct ibgda_device *)st->common.devices + st->selected_dev_ids[d];
+            for (int e = 0; e < device->dci.num_eps; e++) {
+                struct ibgda_ep *ep = device->dci.eps ? device->dci.eps[e] : NULL;
+                if (!ep || !ep->devx_qp) continue;
+                uint32_t s = 0;
+                ibgda_ft_query_qp(ep->devx_qp, ep->qpn, &s, NULL, NULL);
+                if (s == 3) continue;
+                int r = ibgda_ft_reset_dci(device, ep,
+                                           &dstate->globalmem.dcis[e * st->n_devs_selected + d]);
+                if (r) {
+                    fprintf(stderr, "[nvshmem-ft] PE%d DCI 0x%x reset failed (%d)\n",
+                            ibgda_ft.t->my_pe, ep->qpn, r);
+                    return -18;
+                }
+                S->ndci_reset++;
+            }
+        }
+        /* Clear the device error counter and the host record. */
+        if (!(ibgda_ft.skip & NVSHMEMI_IBGDA_FT_SKIP_NERR)) {
+            uint32_t z = 0;
+            memcpy(ibgda_ft.pinned, &z, sizeof(z));
+            if (cudaMemcpyAsync(&ibgda_ft.dev_d->nerr, ibgda_ft.pinned, sizeof(z),
+                                cudaMemcpyHostToDevice, ibgda_ft.stream) ||
+                cudaStreamSynchronize(ibgda_ft.stream))
+                return -19;
+        }
+        if (!(ibgda_ft.skip & NVSHMEMI_IBGDA_FT_SKIP_NERR)) {
+            std::lock_guard<std::mutex> g(ibgda_ft.mu);
+            ibgda_ft.have_error.store(0);
+            memset(&ibgda_ft.first, 0, sizeof(ibgda_ft.first));
+        }
+        p.prepared = false;
+        S->rst_ms = t1 - t0;
+        S->resync_ms = t2 - t1;
+        S->connect_ms = t3 - t2;
+        S->commit_ms = ibgda_ft_mono_ms() - t0;
+        S->nqps = n;
+        snprintf(S->msg, sizeof(S->msg), "committed %d QP(s), %u DCI(s) reset", n, S->ndci_reset);
+        ibgda_ft.commits.fetch_add(1);
+    }
+    /* Test hook: a shot scheduled "inside the commit" fires now, after RTS (hits the replay). */
+    if (ibgda_ft.fire_in_commit.exchange(0)) {
+        fprintf(stderr, "[nvshmem-fault-inject] in-commit shot fire_mono_ms=%.3f\n", ibgda_ft_mono_ms());
+        ibgda_fi_all_qps_to_err(ibgda_ft.st, ibgda_ft.t->n_pes);
+    }
+    return rc;
+}
+
+/* Abort: forget a prepared recovery, leave the QPs in ERR and mark the transport failed so that
+ * teardown skips device collectives. */
+extern "C" __attribute__((visibility("default"))) int nvshmemt_ibgda_ft_abort(int peer) {
+    if (!ibgda_ft.enabled) return -1;
+    {
+        std::lock_guard<std::mutex> opg(ibgda_ft.op_mu);
+        if (peer >= 0 && peer < (int)ibgda_ft.prep.size()) ibgda_ft.prep[peer].prepared = false;
+        std::lock_guard<std::mutex> lk(ibgda_ft.st->rc_endpoint_lock);
+        struct ibgda_ep *eps[NVSHMEMT_IBGDA_FT_MAX_QPS];
+        struct ibgda_device *devs[NVSHMEMT_IBGDA_FT_MAX_QPS];
+        int n = peer >= 0 ? ibgda_ft_rc_eps(peer, eps, devs, NVSHMEMT_IBGDA_FT_MAX_QPS) : 0;
+        for (int i = 0; i < n; i++) {
+            uint32_t s = 0;
+            ibgda_ft_query_qp(eps[i]->devx_qp, eps[i]->qpn, &s, NULL, NULL);
+            if (s != 6) ibgda_ft_qp_cmd(eps[i]->devx_qp, eps[i]->qpn, MLX5_CMD_OP_2ERR_QP);
+        }
+    }
+    ibgda_ft_set_failed("recovery declined/aborted");
+    return 0;
+}
+/* ===================== end NVSHMEM_IBGDA_FT ===================== */
+
+static uint32_t ibgda_ft_commit_count() { return ibgda_ft.commits.load(); }
+static void ibgda_ft_request_fire_in_commit() { ibgda_ft.fire_in_commit.store(1); }
+
 int nvshmemt_ibgda_connect_endpoints(nvshmem_transport_t t, int *selected_dev_ids,
                                      int num_selected_devs, int *out_qp_indices, int num_qps) {
     nvshmemt_ibgda_state_t *ibgda_state = (nvshmemt_ibgda_state_t *)t->state;
@@ -4871,6 +6054,12 @@ int nvshmemt_ibgda_connect_endpoints(nvshmem_transport_t t, int *selected_dev_id
     ibgda_fault_inject_arm(ibgda_state, t->n_pes);
     ibgda_fault_watch_arm(ibgda_state, t->n_pes);
 
+    /* NVSHMEM_IBGDA_FT (research, default off). */
+    {
