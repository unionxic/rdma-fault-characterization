+/* Record a rejected operation on the (first) RC QP to `pe` (DCI 0 without RCs). Cold path. */
+__device__ __noinline__ static void ibgda_ft_record_oob(int pe, uint64_t off, uint64_t len,
+                                                        uint64_t chunk_end, int why, int op) {
+    CONSTANT_ADDRESS_SPACE nvshmemi_ibgda_device_state_t *state = ibgda_get_state();
+    nvshmemi_ibgda_ft_dev_t *ft = (nvshmemi_ibgda_ft_dev_t *)state->ft;
+    if (ft == nullptr) return;
+    nvshmemi_ibgda_device_qp_t *qp = state->globalmem.rcs != nullptr
+                                         ? &state->globalmem.rcs[pe]
+                                         : &state->globalmem.dcis[0];
+    nvshmemi_ibgda_device_qp_management_t *mv = &qp->mvars;
+    const uint8_t cls = (op == NVSHMEMI_IBGDA_FT_OP_GET || op == NVSHMEMI_IBGDA_FT_OP_G)
+                            ? NVSHMEMI_IBGDA_FT_CLASS_OOB_READ
+                            : NVSHMEMI_IBGDA_FT_CLASS_OOB_WRITE;
+    const uint32_t old = atomicCAS(&mv->ft_state, 0u, 1u);
+    const bool first = (old == 0u);
+    if (first) {
+        mv->ft_fp = ((uint32_t)why << 8) | cls; /* opcode 0, syndrome 0: no CQE */
+        mv->ft_wqe = 0u;
+        mv->ft_aux = (uint32_t)off;
+        __threadfence();
+        atomicExch(&mv->ft_state, 2u);
+        atomicAdd(&ft->nerr, 1u);
+    }
+    uint32_t qp_index;
+    uint8_t qp_type;
+    int32_t peer;
+    ibgda_ft_qp_of_mvars(mv, &qp_index, &qp_type, &peer);
+    uint32_t r[sizeof(nvshmemi_ibgda_ft_record_t) / 4];
+#pragma unroll
+    for (int i = 0; i < (int)(sizeof(r) / 4); i++) r[i] = 0u;
+    r[2] = qp->qpn;
+    r[4] = ((uint32_t)why << 24);
+    r[5] = (uint32_t)cls | (2u << 8) | ((uint32_t)NVSHMEMI_IBGDA_FT_PATH_BOUNDS << 16) |
+           ((uint32_t)qp_type << 24);
+    r[6] = first ? 0u : (1u << 24); /* upgrade byte: 1 = a record already existed on this QP */
+    r[7] = (uint32_t)nvshmemi_device_state_d.mype;
+    r[8] = (uint32_t)pe;
+    r[9] = qp_index;
+    const uint64_t vals[6] = {0,
+                              ibgda_atomic_read(&mv->tx_wq.cons_idx),
+                              ibgda_atomic_read(&mv->tx_wq.prod_idx),
+                              ibgda_atomic_read(&mv->tx_wq.ready_head),
+                              ibgda_atomic_read(&mv->tx_wq.resv_head),
+                              ibgda_ft_globaltimer()};
+#pragma unroll
+    for (int i = 0; i < 6; i++) {
+        r[10 + 2 * i] = (uint32_t)vals[i];
+        r[11 + 2 * i] = (uint32_t)(vals[i] >> 32);
+    }
+    r[42] = (uint32_t)off;
+    r[43] = (uint32_t)(off >> 32);
+    r[44] = (uint32_t)len;
+    r[45] = (uint32_t)(len >> 32);
+    r[46] = (uint32_t)chunk_end;
+    r[47] = (uint32_t)(chunk_end >> 32);
+    r[48] = (uint32_t)op;
+    r[49] = (state->ft_flags & NVSHMEMI_IBGDA_FT_FLAG_RING_CQ) ? 1u : 0u;
+    ibgda_ft_mbox_publish(ft, r);
+}
