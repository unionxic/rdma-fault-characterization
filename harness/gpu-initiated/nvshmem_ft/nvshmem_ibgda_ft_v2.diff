+/* QUERY_QP -> state, hw/sw SQ wqebb counters. Returns the DEVX status. */
+static int ibgda_ft_query_qp(struct mlx5dv_devx_obj *devx_qp, uint32_t qpn, uint32_t *state,
+                             uint32_t *hw_sq, uint32_t *sw_sq) {
+    uint8_t cmd_in[DEVX_ST_SZ_BYTES(query_qp_in)] = {0};
+    uint8_t cmd_out[DEVX_ST_SZ_BYTES(query_qp_out)] = {0};
+    DEVX_SET(query_qp_in, cmd_in, opcode, MLX5_CMD_OP_QUERY_QP);
+    DEVX_SET(query_qp_in, cmd_in, qpn, qpn);
+    int st = mlx5dv_devx_obj_query(devx_qp, cmd_in, sizeof(cmd_in), cmd_out, sizeof(cmd_out));
+    void *qpc = DEVX_ADDR_OF(query_qp_out, cmd_out, qpc);
+    if (state) *state = DEVX_GET(qpc, qpc, state);
+    if (hw_sq) *hw_sq = DEVX_GET(qpc, qpc, hw_sq_wqebb_counter);
+    if (sw_sq) *sw_sq = DEVX_GET(qpc, qpc, sw_sq_wqebb_counter);
+    return st;
+}
+
+/* 2ERR (opcode 0x507) or 2RST (0x50a): same command layout. */
+static int ibgda_ft_qp_cmd(struct mlx5dv_devx_obj *devx_qp, uint32_t qpn, uint16_t opcode) {
+    uint8_t cmd_in[DEVX_ST_SZ_BYTES(ibgda_fi_2err_qp_in)] = {0};
+    uint8_t cmd_out[DEVX_ST_SZ_BYTES(ibgda_fi_2err_qp_out)] = {0};
+    DEVX_SET(ibgda_fi_2err_qp_in, cmd_in, opcode, opcode);
+    DEVX_SET(ibgda_fi_2err_qp_in, cmd_in, qpn, qpn);
+    int status = mlx5dv_devx_obj_modify(devx_qp, cmd_in, sizeof(cmd_in), cmd_out, sizeof(cmd_out));
+    if (status) {
+        fprintf(stderr, "[nvshmem-ft] qp cmd 0x%x qpn=0x%x failed ret=%d devx_status=0x%x syndrome=0x%x\n",
+                opcode, qpn, status, DEVX_GET(ibgda_fi_2err_qp_out, cmd_out, status),
+                DEVX_GET(ibgda_fi_2err_qp_out, cmd_out, syndrome));
+    }
+    return status;
+}
+
+static struct ibgda_ep *ibgda_ft_find_ep_by_qpn(uint32_t qpn, int *is_dci) {
+    nvshmemt_ibgda_state_t *st = ibgda_ft.st;
+    int n_pes = ibgda_ft.t->n_pes;
+    for (int i = 0; i < st->n_devs_selected; i++) {
+        struct ibgda_device *device =
+            (struct ibgda_device *)st->common.devices + st->selected_dev_ids[i];
+        for (int e = 0; e < device->rc.num_eps_per_pe * n_pes; e++) {
+            struct ibgda_ep *ep = device->rc.eps ? device->rc.eps[e] : NULL;
+            if (ep && ep->qpn == qpn) {
+                if (is_dci) *is_dci = 0;
+                return ep;
+            }
+        }
+        for (int e = 0; e < device->dci.num_eps; e++) {
+            struct ibgda_ep *ep = device->dci.eps ? device->dci.eps[e] : NULL;
+            if (ep && ep->qpn == qpn) {
+                if (is_dci) *is_dci = 1;
+                return ep;
+            }
+        }
+    }
+    return NULL;
+}
