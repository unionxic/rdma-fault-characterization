+/* v2.1 test-only (NVSHMEM_IBGDA_FT_TEST_TRIP): force d = 0 on the consumption that brings the
+ * countdown to 0. Returns the (possibly forced) d and whether to emulate v2's silent skip. */
+__device__ __noinline__ static uint32_t ibgda_ft_test_trip(uint32_t d, bool *silent) {
+    nvshmemi_ibgda_ft_dev_t *ft = ibgda_ft_dev();
+    *silent = false;
+    if (ft == nullptr) return d;
+    if (atomicSub(&ft->test_trip, 1u) != 1u) return d;
+    *silent = (*(volatile uint32_t *)&ft->test_trip_mode == 2u);
+    return 0u;
+}
