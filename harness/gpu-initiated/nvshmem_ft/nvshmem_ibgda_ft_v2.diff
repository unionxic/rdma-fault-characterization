+/* ---------------------------------------------------------------------------------------------
+ * NVSHMEM_IBGDA_FT (research, default off; host env NVSHMEM_IBGDA_FT=1 sets state->ft).
+ * Device-side classification of the root-cause error CQE on the collapsed send CQ. Every poll of
+ * a send CQ also looks at the slot's opcode while it spins; the first error CQE seen on a QP is
+ * snapshotted before the trailing flushes (5/0xf9, ~59 us later) overwrite it, kept as a sticky
+ * per-QP record in mvars, and published to a host-mapped mailbox. Waits on a failed QP return an
+ * error instead of spinning or reporting success. With state->ft == NULL nothing below runs.
+ * ------------------------------------------------------------------------------------------- */
+__device__ NVSHMEMI_STATIC NVSHMEMI_DEVICE_ALWAYS_INLINE nvshmemi_ibgda_ft_dev_t *ibgda_ft_dev() {
+    return (nvshmemi_ibgda_ft_dev_t *)ibgda_get_state()->ft;
+}
+
+__device__ NVSHMEMI_STATIC NVSHMEMI_DEVICE_ALWAYS_INLINE uint64_t ibgda_ft_globaltimer() {
+    uint64_t t;
+    asm volatile("mov.u64 %0, %%globaltimer;" : "=l"(t)::"memory");
+    return t;
+}
+
+/* The CQ struct points into the QP's mvars (cons_idx); recover the mvars from it. */
+__device__ NVSHMEMI_STATIC NVSHMEMI_DEVICE_ALWAYS_INLINE nvshmemi_ibgda_device_qp_management_t *
+ibgda_ft_mvars_of_cq(const nvshmemi_ibgda_device_cq_t *cq) {
+    return (nvshmemi_ibgda_device_qp_management_t *)((uintptr_t)cq->cons_idx -
+                                                     __builtin_offsetof(
+                                                         nvshmemi_ibgda_device_qp_management_t,
+                                                         tx_wq.cons_idx));
+}
+
+__device__ NVSHMEMI_STATIC NVSHMEMI_DEVICE_ALWAYS_INLINE bool ibgda_ft_is_err_opcode(uint8_t opown) {
+    uint8_t op = opown >> 4;
+    return op == MLX5_CQE_REQ_ERR || op == MLX5_CQE_RESP_ERR;
+}
+
+__device__ NVSHMEMI_STATIC NVSHMEMI_DEVICE_ALWAYS_INLINE uint8_t ibgda_ft_classify(uint8_t syndrome,
+                                                                                 uint8_t vendor) {
+    switch (syndrome) {
+        case 0x05:
+            return vendor == 0xf5   ? NVSHMEMI_IBGDA_FT_CLASS_LOCAL_QP_ERR
+                   : vendor == 0xf9 ? NVSHMEMI_IBGDA_FT_CLASS_FLUSH_TRAILING
+                                    : NVSHMEMI_IBGDA_FT_CLASS_FLUSH_OTHER;
+        case 0x04: return NVSHMEMI_IBGDA_FT_CLASS_LOC_PROT;
+        case 0x12: return NVSHMEMI_IBGDA_FT_CLASS_REM_INV_REQ;
+        case 0x13: return NVSHMEMI_IBGDA_FT_CLASS_REM_ACCESS;
+        case 0x15: return NVSHMEMI_IBGDA_FT_CLASS_RETRY_EXC;
+        case 0x16: return NVSHMEMI_IBGDA_FT_CLASS_RNR_RETRY_EXC;
+        case 0x01: return NVSHMEMI_IBGDA_FT_CLASS_LOC_LEN;
+        case 0x02: return NVSHMEMI_IBGDA_FT_CLASS_LOC_QP_OP;
+        case 0x14: return NVSHMEMI_IBGDA_FT_CLASS_REM_OP;
+        case 0x22: return NVSHMEMI_IBGDA_FT_CLASS_REM_ABORT;
+        case 0x11: return NVSHMEMI_IBGDA_FT_CLASS_LOC_ACCESS;
+        case 0x10: return NVSHMEMI_IBGDA_FT_CLASS_BAD_RESP;
+        default: return NVSHMEMI_IBGDA_FT_CLASS_OTHER;
+    }
+}
+
+__device__ NVSHMEMI_STATIC NVSHMEMI_DEVICE_ALWAYS_INLINE void ibgda_ft_st_sys32(uint32_t *p,
+                                                                              uint32_t v) {
+    asm volatile("st.relaxed.sys.global.u32 [%0], %1;" ::"l"(p), "r"(v) : "memory");
+}
+
+__device__ NVSHMEMI_STATIC NVSHMEMI_DEVICE_ALWAYS_INLINE uint32_t ibgda_ft_ld_u32(const void *p) {
+    uint32_t v;
+    asm volatile("ld.volatile.global.u32 %0, [%1];" : "=r"(v) : "l"(p) : "memory");
+    return v;
+}
+
+/* True once any error was recorded (or is being recorded) for the QP behind this CQ. */
+__device__ NVSHMEMI_STATIC NVSHMEMI_DEVICE_ALWAYS_INLINE bool ibgda_ft_cq_failed(
+    const nvshmemi_ibgda_device_cq_t *cq) {
+    return ibgda_atomic_read(&ibgda_ft_mvars_of_cq(cq)->ft_state) != 0;
+}
+
+/* Publish one 256-byte record (64 words, words 0 and 1 ignored) to the host mailbox: invalidate
+ * magic, body with system-scope stores, fence, seq, fence, magic. Cold path. */
+__device__ __noinline__ static void ibgda_ft_mbox_publish(nvshmemi_ibgda_ft_dev_t *ft,
+                                                          const uint32_t *w) {
+    nvshmemi_ibgda_ft_record_t *mbox = *(nvshmemi_ibgda_ft_record_t *volatile *)&ft->mbox;
+    const uint32_t nslots = *(volatile uint32_t *)&ft->nslots;
+    if (mbox == nullptr || nslots == 0) return;
+    const uint32_t seq = atomicAdd(&ft->seq, 1u) + 1u;
+    uint32_t *dst = (uint32_t *)(mbox + ((seq - 1u) % nslots));
+    ibgda_ft_st_sys32(&dst[0], 0u);
+    __threadfence_system();
+    for (int i = 2; i < (int)(sizeof(nvshmemi_ibgda_ft_record_t) / 4); i++)
+        ibgda_ft_st_sys32(&dst[i], w[i]);
+    __threadfence_system();
+    ibgda_ft_st_sys32(&dst[1], seq);
+    __threadfence_system();
+    ibgda_ft_st_sys32(&dst[0], NVSHMEMI_IBGDA_FT_MAGIC);
+    __threadfence_system();
+}
+
+/* Which QP owns these management variables: index into globalmem.rcs / dcis, type, peer. */
+__device__ NVSHMEMI_STATIC NVSHMEMI_DEVICE_ALWAYS_INLINE void ibgda_ft_qp_of_mvars(
+    const nvshmemi_ibgda_device_qp_management_t *mv, uint32_t *qp_index, uint8_t *qp_type,
+    int32_t *peer) {
+    CONSTANT_ADDRESS_SPACE nvshmemi_ibgda_device_state_t *state = ibgda_get_state();
+    uintptr_t qp_addr = (uintptr_t)mv - __builtin_offsetof(nvshmemi_ibgda_device_qp_t, mvars);
+    uint32_t ndcis = state->num_shared_dcis + state->num_exclusive_dcis;
+    uintptr_t dci0 = (uintptr_t)state->globalmem.dcis;
+    *peer = -1;
+    if (dci0 && qp_addr >= dci0 && qp_addr < dci0 + ndcis * sizeof(nvshmemi_ibgda_device_qp_t)) {
+        *qp_index = (uint32_t)((qp_addr - dci0) / sizeof(nvshmemi_ibgda_device_qp_t));
+        *qp_type = NVSHMEMI_IBGDA_DEVICE_QP_TYPE_DCI;
+    } else {
+        *qp_index = (uint32_t)((qp_addr - (uintptr_t)state->globalmem.rcs) /
+                               sizeof(nvshmemi_ibgda_device_qp_t));
+        *qp_type = NVSHMEMI_IBGDA_DEVICE_QP_TYPE_RC;
+        *peer = (int32_t)(*qp_index % (uint32_t)nvshmemi_device_state_d.npes);
+    }
+}
+
+/* v2.1: park the QP behind these management variables. A QP with a recorded error (CQE error or
+ * ring invariant; not a bounds record, whose QP is healthy) should not be posted to any more: the
+ * slot wait fails fast after an error, and v2 went on writing WQEs and ringing the doorbell far past
+ * the NIC's flush point (up to 16 queues), which overwrote SQ slots the NIC had not flushed; the
+ * NIC then stopped flushing (measured) and the recovery drain never completed. Parking raises
+ * prod_idx to NVSHMEMI_IBGDA_FT_PARK_MARK: every later ibgda_post_send's atomicMax returns a
+ * larger old value, so it neither writes the doorbell record nor rings (posts are dropped; on a
+ * failed QP they would only be flushed). Recovery zeroes prod_idx and so un-parks. */
+__device__ NVSHMEMI_STATIC NVSHMEMI_DEVICE_ALWAYS_INLINE void ibgda_ft_park(
+    nvshmemi_ibgda_device_qp_management_t *mv) {
+    if (ibgda_get_state()->ft_flags & NVSHMEMI_IBGDA_FT_FLAG_PARK)
+        atomicMax((unsigned long long int *)&mv->tx_wq.prod_idx,
+                  (unsigned long long int)NVSHMEMI_IBGDA_FT_PARK_MARK);
+}
+
+/* Snapshot the error CQE at `slot` (slot 0 of a collapsed CQ, or the ring slot at consumer
+ * counter ring_ci), record it as the QP's sticky first error and publish it to the host mailbox.
+ * Cold path: kept out of line so the poll loops stay small. Returns the syndrome. */
+__device__ __noinline__ static int ibgda_ft_capture(const nvshmemi_ibgda_device_cq_t *cq,
+                                                    const void *slot, uint64_t poll_idx,
+                                                    uint32_t path, uint64_t ring_ci) {
+    nvshmemi_ibgda_ft_dev_t *ft = ibgda_ft_dev();
+    const uint32_t *cw = (const uint32_t *)slot; /* 16 words of the CQE */
+    uint32_t w[16];
+    uint32_t tries = 0;
+
+    /* Consistent snapshot: word 15 (wqe_counter, signature, op_own) must be the same before and
+     * after the 64 bytes are read; a trailing flush that lands meanwhile changes it (collapsed
+     * CQ). A ring slot does not change before the next lap. */
+    for (;;) {
+        uint32_t a = ibgda_ft_ld_u32(&cw[15]);
+#pragma unroll
+        for (int i = 0; i < 16; i++) w[i] = ibgda_ft_ld_u32(&cw[i]);
+        uint32_t b = ibgda_ft_ld_u32(&cw[15]);
+        tries++;
+        if (a == b && a == w[15]) break;
+        if (tries >= 8) break;
+    }
+    /* Little-endian words: byte 4k+j is bits 8j..8j+7 of w[k]. */
+    const uint8_t opown = (uint8_t)(w[15] >> 24);                            /* byte 63 */
+    const uint8_t syndrome = (uint8_t)(w[13] >> 24);                         /* byte 55 */
+    const uint8_t vendor = (uint8_t)(w[13] >> 16);                           /* byte 54 */
+    const uint8_t hw_err = (uint8_t)w[13];                                   /* byte 52 */
+    const uint8_t hw_type = (uint8_t)(w[13] >> 8);                           /* byte 53 */
+    const uint16_t wqe = (uint16_t)(((w[15] & 0xffu) << 8) | ((w[15] >> 8) & 0xffu)); /* 60-61 BE */
+    const uint32_t sqpn = __byte_perm(w[14], 0, 0x0123);                     /* 56-59 BE */
+    if (!ibgda_ft_is_err_opcode(opown)) {
+        /* The slot changed to a non-error CQE between the caller's read and ours: nothing to
+         * record here (cannot happen after a QP error; defensive). */
+        return 0;
+    }
+    const uint8_t cls = ibgda_ft_classify(syndrome, vendor);
+    const bool trailing = (cls == NVSHMEMI_IBGDA_FT_CLASS_FLUSH_TRAILING);
+
+    nvshmemi_ibgda_device_qp_management_t *mv = ibgda_ft_mvars_of_cq(cq);
+    bool upgrade = false;
+    uint32_t old = atomicCAS(&mv->ft_state, 0u, 1u);
+    if (old != 0u) {
+        /* Already recorded. A record that holds only a trailing flush may be replaced by a root
+         * cause seen later by another poller (for example the sentinel). */
+        if (old == 3u && !trailing && atomicCAS(&mv->ft_state, 3u, 1u) == 3u) {
+            upgrade = true;
+        } else {
+            return syndrome;
+        }
+    }
+    const uint64_t gt = ibgda_ft_globaltimer();
+    mv->ft_fp = ((uint32_t)(opown >> 4) << 24) | ((uint32_t)syndrome << 16) |
+                ((uint32_t)vendor << 8) | cls;
+    mv->ft_wqe = (uint32_t)wqe | ((uint32_t)(poll_idx & 0xffff) << 16);
+    mv->ft_aux = sqpn;
+    __threadfence();
+    atomicExch(&mv->ft_state, trailing ? 3u : 2u);
+    if (!upgrade) atomicAdd(&ft->nerr, 1u);
+
+    uint32_t qp_index;
+    uint8_t qp_type;
+    int32_t peer;
+    ibgda_ft_qp_of_mvars(mv, &qp_index, &qp_type, &peer);
+    uint32_t r[sizeof(nvshmemi_ibgda_ft_record_t) / 4];
+#pragma unroll
+    for (int i = 0; i < (int)(sizeof(r) / 4); i++) r[i] = 0u;
+    r[2] = cq->qpn;
+    r[3] = sqpn;
+    r[4] = (uint32_t)wqe | ((uint32_t)syndrome << 16) | ((uint32_t)vendor << 24);
+    r[5] = (uint32_t)cls | (1u << 8) | ((path & 0xffu) << 16) | ((uint32_t)qp_type << 24);
+    r[6] = (uint32_t)hw_err | ((uint32_t)hw_type << 8) | ((uint32_t)(opown >> 4) << 16) |
+           ((upgrade ? 1u : 0u) << 24);
+    r[7] = (uint32_t)nvshmemi_device_state_d.mype;
+    r[8] = (uint32_t)peer;
+    r[9] = qp_index;
+    const uint64_t vals[6] = {poll_idx,
+                              ibgda_atomic_read(cq->cons_idx),
+                              ibgda_atomic_read(cq->prod_idx),
+                              ibgda_atomic_read(cq->ready_head),
+                              ibgda_atomic_read(cq->resv_head),
+                              gt};
+#pragma unroll
+    for (int i = 0; i < 6; i++) {
+        r[10 + 2 * i] = (uint32_t)vals[i];
+        r[11 + 2 * i] = (uint32_t)(vals[i] >> 32);
+    }
+    r[22] = tries;
+#pragma unroll
+    for (int i = 0; i < 16; i++) r[24 + i] = w[i];
+    const bool ring = (ibgda_get_state()->ft_flags & NVSHMEMI_IBGDA_FT_FLAG_RING_CQ) != 0;
+    r[40] = (uint32_t)ring_ci;
+    r[41] = (uint32_t)(ring_ci >> 32);
+    r[49] = ring ? 1u : 0u;
+    ibgda_ft_park(mv); /* v2.1: after the record's snapshot of prod_idx */
+    ibgda_ft_mbox_publish(ft, r);
+    return syndrome;
+}
+
+/* ---------------------------------------------------------------------------------------------
+ * v2 (A) ring-CQ mode, NVSHMEM_IBGDA_FT_RING_CQ=1: the send CQs are created non-collapsed (cc=0,
+ * oi=1), so the NIC writes CQE number k to slot k & (ncqes - 1) with owner bit !!(k & ncqes) and
+ * never overwrites an unconsumed CQE while at most ncqes CQEs are outstanding (flow control: the
+ * device posts WQE w only after cons_idx > w - nwqes, and nwqes <= ncqes). The consumer counter k
+ * lives in mvars.ft_ring_ci. A waiter walks the ring in order: a success CQE is consumed with a
+ * CAS on the counter (the winner, and only it, advances cons_idx from the CQE's wqe_counter); an
+ * error CQE is never consumed. So the first error CQE of a QP (its root cause) stays at the
+ * consumer position until recovery, every poll that reaches it records it and fails, and no
+ * sentinel or in-loop timing is needed. Exact 64-bit cons_idx: the CAS winner of CQE k reads
+ * cons_idx after the CAS; every CQE before k was claimed earlier and no later one yet, so
+ * w + 1 - nwqes <= cons_idx <= w (w = the CQE's WQE index) and d = (uint16)(wqe_counter + 1 -
+ * cons_idx) is the exact advance, 1 <= d <= nwqes <= ncqes. A d outside that range means the
+ * invariant is broken (bug or memory corruption): v2.1 records it (class RING_INVARIANT) and fails
+ * this and every later wait on the QP, instead of consuming the CQE silently (v2), which left the
+ * waiter spinning for a completion that had been consumed.
+ * No lap before the root cause is recorded, even with fail-fast posting: after an error cons_idx
+ * stops at the failing WQE w_err (error CQEs are never consumed), and a WQE with index >= cons_idx
+ * + nwqes can only be reserved after the slot wait (ibgda_wait_for_slot_availability) polled this
+ * ring, and that poll records the root cause before it returns -1 and lets posting continue. So
+ * at most nwqes CQEs (one per WQE in [w_err, cons_idx + nwqes)) are written from the root cause on
+ * before it is recorded, and slot k is rewritten only by CQE k + ncqes (nwqes == ncqes here, both
+ * round_up_pow2(QP_DEPTH); checked at init).
+ * ------------------------------------------------------------------------------------------- */
+/* v2.1: a consumed CQE broke the ring-walk invariant. Record it (sticky record with opcode 0xf so
+ * that every later wait on the QP fails, and a mailbox record the host logs). Cold path. */
+__device__ __noinline__ static void ibgda_ft_ring_invariant(const nvshmemi_ibgda_device_cq_t *cq,
+                                                            uint64_t idx, uint64_t ci, uint32_t w15,
+                                                            uint64_t cons, uint32_t d,
+                                                            uint32_t path) {
+    nvshmemi_ibgda_ft_dev_t *ft = ibgda_ft_dev();
+    if (ft == nullptr) return;
+    nvshmemi_ibgda_device_qp_management_t *mv = ibgda_ft_mvars_of_cq(cq);
+    const uint16_t wc = BSWAP16((uint16_t)(w15 & 0xffffu));
+    const uint8_t cls = NVSHMEMI_IBGDA_FT_CLASS_RING_INVARIANT;
+    const uint32_t old = atomicCAS(&mv->ft_state, 0u, 1u);
+    const bool first = (old == 0u);
+    if (first) {
+        mv->ft_fp = (0xfu << 24) | cls; /* opcode 0xf: not a CQE error, but it fails later waits */
+        mv->ft_wqe = (uint32_t)wc | ((uint32_t)(idx & 0xffff) << 16);
+        mv->ft_aux = d;
+        __threadfence();
+        atomicExch(&mv->ft_state, 2u);
+        atomicAdd(&ft->nerr, 1u);
+    }
+    uint32_t qp_index;
+    uint8_t qp_type;
+    int32_t peer;
+    ibgda_ft_qp_of_mvars(mv, &qp_index, &qp_type, &peer);
+    uint32_t r[sizeof(nvshmemi_ibgda_ft_record_t) / 4];
+#pragma unroll
+    for (int i = 0; i < (int)(sizeof(r) / 4); i++) r[i] = 0u;
+    r[2] = cq->qpn;
+    r[4] = (uint32_t)wc;
+    r[5] = (uint32_t)cls | (3u << 8) | ((path & 0xffu) << 16) | ((uint32_t)qp_type << 24);
+    r[6] = (0xfu << 16) | (first ? 0u : (1u << 24));
+    r[7] = (uint32_t)nvshmemi_device_state_d.mype;
+    r[8] = (uint32_t)peer;
+    r[9] = qp_index;
+    const uint64_t vals[6] = {idx,
+                              cons,
+                              ibgda_atomic_read(cq->prod_idx),
+                              ibgda_atomic_read(cq->ready_head),
+                              ibgda_atomic_read(cq->resv_head),
+                              ibgda_ft_globaltimer()};
+#pragma unroll
+    for (int i = 0; i < 6; i++) {
+        r[10 + 2 * i] = (uint32_t)vals[i];
+        r[11 + 2 * i] = (uint32_t)(vals[i] >> 32);
+    }
+    r[39] = w15; /* word 15 of the consumed CQE (root_cqe[60..63]) */
+    r[40] = (uint32_t)ci;
+    r[41] = (uint32_t)(ci >> 32);
+    r[49] = 1u;
+    r[50] = d;
+    r[51] = cq->ncqes;
+    ibgda_ft_park(mv);
+    ibgda_ft_mbox_publish(ft, r);
+}
