 typedef nvshmemi_ibgda_device_state_v2 nvshmemi_ibgda_device_state_t;
 
+/* ---------------------------------------------------------------------------------------------
+ * NVSHMEM_IBGDA_FT (research, default off): device-side classification of the root-cause error
+ * CQE, a host-mapped mailbox, and the state the host recovery path resyncs. See
+ * harness/gpu-initiated/nvshmem_ft/DESIGN.md.
+ * ------------------------------------------------------------------------------------------- */
+#define NVSHMEMI_IBGDA_FT_MAGIC 0x4e465442u /* "BTFN" */
+#define NVSHMEMI_IBGDA_FT_NSLOTS 16
+
+enum {
+    NVSHMEMI_IBGDA_FT_FLAG_ON = 1,          /* classification on: record + error return */
+    NVSHMEMI_IBGDA_FT_FLAG_CAPTURE_EXIT = 2, /* diagnostic: look at the slot only when the wait
+                                                exits (stock position), not in the spin loop */
+    NVSHMEMI_IBGDA_FT_FLAG_SENTINEL = 4,     /* the application runs the device sentinel */
+    /* v2 */
+    NVSHMEMI_IBGDA_FT_FLAG_RING_CQ = 8,      /* send CQs are non-collapsed rings (cc=0, oi=1); waits
+                                                walk them by consumer counter (mvars.ft_ring_ci) */
+    NVSHMEMI_IBGDA_FT_FLAG_BOUNDS = 16,      /* remote ranges are checked against the heap's
+                                                allocated chunks before an RMA/AMO is posted */
+    NVSHMEMI_IBGDA_FT_FLAG_TEST_TRIP = 32,   /* test-only: trip the ring-walk invariant check
+                                                (NVSHMEM_IBGDA_FT_TEST_TRIP) */
+    NVSHMEMI_IBGDA_FT_FLAG_PARK = 64,        /* v2.1: a QP with a recorded error is parked: posts
+                                                on it no longer advance its doorbell record or ring
+                                                the doorbell (they would only be flushed) */
+};
+/* v2.1: prod_idx of a parked QP (the recording thread raises it with atomicMax). */
+#define NVSHMEMI_IBGDA_FT_PARK_MARK (1ULL << 63)
+
+/* v2 test-only knobs (NVSHMEM_IBGDA_FT_TEST_SKIP=<comma list>): skip one step of the recovery
+ * resync (negative controls). Never set in production. */
+enum {
+    NVSHMEMI_IBGDA_FT_SKIP_IDX = 1 << 0,    /* keep tx_wq indices (resv/ready/prod/cons/get_*) */
+    NVSHMEMI_IBGDA_FT_SKIP_LOCK = 1 << 1,   /* keep post_send_lock */
+    NVSHMEMI_IBGDA_FT_SKIP_IBUF = 1 << 2,   /* keep ibuf head/tail */
+    NVSHMEMI_IBGDA_FT_SKIP_STICKY = 1 << 3, /* keep the per-QP sticky record (ft_state/fp/wqe/aux) */
+    NVSHMEMI_IBGDA_FT_SKIP_CQFILL = 1 << 4, /* do not refill the send CQ with 0xff */
+    NVSHMEMI_IBGDA_FT_SKIP_DBR = 1 << 5,    /* do not zero the QP doorbell record */
+    NVSHMEMI_IBGDA_FT_SKIP_NERR = 1 << 6,   /* do not clear ft_dev.nerr and the host record */
+    NVSHMEMI_IBGDA_FT_SKIP_DCI = 1 << 7,    /* do not reset local DCIs left in ERR */
+    NVSHMEMI_IBGDA_FT_SKIP_PSN = 1 << 8,    /* reconnect with PSN 0 instead of fresh random PSNs */
+    NVSHMEMI_IBGDA_FT_SKIP_FINBAR = 1 << 9, /* after a decline, do not skip the teardown barriers */
+    NVSHMEMI_IBGDA_FT_SKIP_RINGCI = 1 << 10, /* ring mode: restart the consumer counter at 0 instead
+                                               of the CQ's producer counter */
+    NVSHMEMI_IBGDA_FT_SKIP_PARK = 1 << 11    /* v2.1: do not park failed QPs (v2 behaviour: fail-fast
+                                               posts keep ringing the doorbell) */
+};
+
