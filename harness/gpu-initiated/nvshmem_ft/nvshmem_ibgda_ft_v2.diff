+template <threadgroup_t SCOPE>
+__device__ NVSHMEMI_STATIC NVSHMEMI_DEVICE_ALWAYS_INLINE bool ibgda_ft_bounds_ok(uint64_t addr,
+                                                                               uint64_t len, int pe,
+                                                                               int op) {
+    uint64_t off, chunk_end;
+    const int why = ibgda_ft_range_check(addr, len, &off, &chunk_end);
+    if (likely(why == 0)) return true;
+    if (nvshmemi_thread_id_in_threadgroup<SCOPE>() == 0)
+        ibgda_ft_record_oob(pe, off, len, chunk_end, why, op);
+    return false;
+}
