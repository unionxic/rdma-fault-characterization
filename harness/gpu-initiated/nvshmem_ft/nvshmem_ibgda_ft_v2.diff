+/* Class text; cause/action wording follows harness/common/probe.c classify(). */
+static void ibgda_ft_class_text(int cls, int vendor, nvshmemt_ibgda_ft_info_t *o) {
+    const char *n = "OTHER", *f = "other", *c = "other", *a = "inspect status+vendor_err";
+    int hint = 0;
+    switch (cls) {
+        case NVSHMEMI_IBGDA_FT_CLASS_LOCAL_QP_ERR:
+            n = "LOCAL_QP_ERR"; f = "local_err";
+            c = "WR flushed (local QP left RTS, e.g. forced ERR); head-of-SQ WQE (vendor 0xf5)";
+            a = "drain CQ, QP-only recover, repost"; hint = 1; break;
+        case NVSHMEMI_IBGDA_FT_CLASS_FLUSH_TRAILING:
+            n = "FLUSH_TRAILING"; f = "unknown";
+            c = "WR flushed behind an earlier error (vendor 0xf9); the root-cause CQE was overwritten";
+            a = "root cause unknown: query QP state and peer liveness; decline"; break;
+        case NVSHMEMI_IBGDA_FT_CLASS_FLUSH_OTHER:
+            n = "WR_FLUSH"; f = "local_err?"; c = "WR flushed (local QP left RTS, e.g. forced ERR)";
+            a = "drain CQ, QP-only recover, repost"; break;
+        case NVSHMEMI_IBGDA_FT_CLASS_REM_ACCESS:
+            n = "REM_ACCESS"; f = "rem_access";
+            c = vendor == 0x88 ? "remote access: invalid rkey or out-of-bounds addr"
+                               : "remote access violation";
+            a = "refresh rkey / clamp to remote MR bounds, QP-only recover"; break;
+        case NVSHMEMI_IBGDA_FT_CLASS_RETRY_EXC:
+            n = "RETRY_EXC"; f = "peer_err|proc_kill";
+            c = "transport retries exhausted (no ACK): responder QP ERR, process dead, or link down";
+            a = "probe peer liveness (counters/ctrl); if dead -> human intervention, else QP-only";
+            hint = 2; break;
+        case NVSHMEMI_IBGDA_FT_CLASS_REM_INV_REQ:
+            n = "REM_INV_REQ"; f = "rem_inv_req";
+            c = "remote invalid request (malformed WR / len / opcode)";
+            a = "fix request params, QP-only recover"; break;
+        case NVSHMEMI_IBGDA_FT_CLASS_RNR_RETRY_EXC:
+            n = "RNR_RETRY_EXC"; f = "rnr"; c = "RNR retries exhausted (responder had no recv WQE)";
+            a = "ensure remote posts recvs, QP-only recover"; break;
+        case NVSHMEMI_IBGDA_FT_CLASS_LOC_PROT:
+            n = "LOC_PROT"; f = "loc_prot"; c = "local protection (bad lkey / local MR bounds)";
+            a = "fix local MR/lkey, QP-only recover"; break;
+        case NVSHMEMI_IBGDA_FT_CLASS_LOC_LEN:
+            n = "LOC_LEN"; f = "loc_len"; c = "local length error"; a = "fix SGE length, QP-only recover";
+            break;
+        case NVSHMEMI_IBGDA_FT_CLASS_OOB_WRITE:
+        case NVSHMEMI_IBGDA_FT_CLASS_OOB_READ:
+            n = cls == NVSHMEMI_IBGDA_FT_CLASS_OOB_WRITE ? "OOB_WRITE" : "OOB_READ"; f = "oob_within_mr";
+            c = vendor == NVSHMEMI_IBGDA_FT_OOB_OUTSIDE_HEAP
+                    ? "remote range outside the symmetric heap (device bounds check, not posted)"
+                : vendor == NVSHMEMI_IBGDA_FT_OOB_FREE
+                    ? "remote range starts in unallocated heap (device bounds check, not posted)"
+                    : "remote range runs past the end of its heap chunk (device bounds check, not posted)";
+            a = "application addressing bug: fix offset/length; the QP is healthy; decline"; break;
+        case NVSHMEMI_IBGDA_FT_CLASS_RING_INVARIANT:
+            n = "RING_INVARIANT"; f = "internal";
+            c = "ring walk: consumed CQE did not advance cons_idx by 1..ncqes; QP completion "
+                "tracking unreliable (bug or corruption)";
+            a = "decline (a recovery commit would reset the ring); report as a bug"; break;
+        default: break;
+    }
+    snprintf(o->name, sizeof(o->name), "%s", n);
+    snprintf(o->fault, sizeof(o->fault), "%s", f);
+    snprintf(o->cause, sizeof(o->cause), "%s", c);
+    snprintf(o->action, sizeof(o->action), "%s", a);
+    o->recover_hint = hint;
+}
