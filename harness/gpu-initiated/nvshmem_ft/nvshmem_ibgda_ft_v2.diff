+static void ibgda_ft_watcher_main() {
+    const int wpr = sizeof(nvshmemi_ibgda_ft_record_t) / 4;
+    while (!ibgda_ft.stop.load()) {
+        for (int s = 0; s < NVSHMEMI_IBGDA_FT_NSLOTS; s++) {
+            volatile uint32_t *w = (volatile uint32_t *)&ibgda_ft.mbox_h[s];
+            uint32_t magic = w[0], seq = w[1];
+            if (magic != NVSHMEMI_IBGDA_FT_MAGIC || seq == 0 || seq == ibgda_ft.last_seq[s]) continue;
+            std::atomic_thread_fence(std::memory_order_acquire);
+            nvshmemi_ibgda_ft_record_t r;
+            uint32_t *rw = (uint32_t *)&r;
+            for (int i = 0; i < wpr; i++) rw[i] = w[i];
+            std::atomic_thread_fence(std::memory_order_acquire);
+            if (w[1] != seq || w[0] != NVSHMEMI_IBGDA_FT_MAGIC) continue; /* being rewritten */
+            ibgda_ft.last_seq[s] = seq;
+            ibgda_ft_handle_record(&r, ibgda_ft_mono_ms());
+        }
+        std::this_thread::sleep_for(std::chrono::microseconds(ibgda_ft.poll_us));
+    }
+}
