+// ---------------------------------------------------------------------------
+// GIN fault-injection test hook (research build; default OFF).
+//   env NCCL_GIN_FAULT_INJECT=local_err:<ms>  or  peer_err:<ms>
+// A detached host thread waits <ms> after the GIN proxy context is created
+// (which happens inside ncclDevCommCreate, just before the first GIN op is
+// issued from the device) and then moves *this rank's* GIN proxy QP(s) to the
+// IBV_QPS_ERR state with ibv_modify_qp. On the initiator this reproduces F1
+// (local_err -> WR_FLUSH); on the target it reproduces F3 (peer_err -> the
+// initiator sees RETRY_EXC once retries are exhausted). Both tokens do the
+// same thing (move the local QPs to ERR); which fault it is depends only on
+// whether the rank it is set on is the put initiator or the target.
+// Not compiled behind a macro: it is inert unless the env var is set, so the
+// stock code path is unchanged when NCCL_GIN_FAULT_INJECT is absent.
+// ---------------------------------------------------------------------------
+struct ncclRmaIbProxyCtx; // forward decl; defined below
+static void ncclGinFaultInjectArmProxy(struct ncclRmaIbProxyCtx* rmaProxyCtx);
+extern thread_local bool ncclGinFaultUserCtx;   // gin/gin_host.cc
+
 // Check GDR support for GIN. This is run at init, so we don't know yet whether the GPU will support DMA-BUF.
 static ncclResult_t ncclGinIbGdrSupport(bool* gdrSupport, bool gdaki) {
   *gdrSupport = true;
@@ -541,10 +564,66 @@ end:
   free(handles);
   if (lComm) ncclNetIb.closeListen(lComm);
