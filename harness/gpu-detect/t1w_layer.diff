+/* t1w (gpu-detect): what a decline does to the application. NVSHMEM's device waits (signal_wait_until, wait_until, the
+ * pSync waits of barriers and collectives) name no peer and have no error return, so in t1_380 a declined pair left them
+ * spinning (blind-apps: 8 of 8 remote-access revokes hung after the decline, qa/root_cause.md 3).
+ *   NVSHMEM_IBGDA_FT_T1_FAILSTOP_MS=0 (default): fail-stop. Right after the DECLINE line the process exits with
+ *     NVSHMEM_IBGDA_FT_T1_FAILSTOP_CODE (70). An application that does not check nvshmemt_ibgda_ft_query cannot go on
+ *     with data that never arrived; its peers see a FIN without a goodbye and decline in turn.
+ *   -1: no exit. The device-wait word goes up; every application-facing device wait returns within 1024 spins as if its
+ *     condition held (released, not satisfied), so kernels end and the host thread gets control back. The application
+ *     must check the transport's state (nvshmemt_ibgda_ft_query); without that check it continues with wrong data.
+ *   > 0: the word goes up as for -1, and the process exits that many ms later unless it exits first. */
+static void t1w_after_decline(int peer) {
+    const int ms = ibgda_t1.failstop_ms;
+    if (ms != 0 && ibgda_t1.abort_h && ibgda_t1.waits_released.exchange(1) == 0) {
+        __atomic_store_n(ibgda_t1.abort_h, 1u, __ATOMIC_SEQ_CST);
+        std::atomic_thread_fence(std::memory_order_seq_cst);
+        t1_log("t1w: device waits released: the decline of peer %d reaches every application-facing device wait of this "
+               "PE (released waits return without their data)", peer);
+    }
+    if (ms < 0 || ibgda_t1.failstop_armed.exchange(1) != 0) return;
+    if (ms == 0) t1w_failstop_exit(peer, "NVSHMEM_IBGDA_FT_T1_FAILSTOP_MS=0");
+    t1_log("t1w: FAILSTOP armed: the process exits with code %d in %d ms unless it ends first (decline of peer %d)",
+           ibgda_t1.failstop_code, ms, peer);
+    std::thread([peer, ms]() {
+        std::this_thread::sleep_for(std::chrono::milliseconds(ms));
+        t1w_failstop_exit(peer, "NVSHMEM_IBGDA_FT_T1_FAILSTOP_MS elapsed");
+    }).detach();
+}
