+  struct gdakiTsPeer& pe = r->ts->peers[peer];
+  pe.lostAfterCommit = true;
+  bool dead = false;
+  if (sendFailed) {
+    const char* n = gdakiTsErrName(sendErr);
+    snprintf(pe.closeCause, sizeof(pe.closeCause), "%s", n ? n : "send failed");
+  } else if (!pe.left && pe.fd >= 0) {
+    dead = pe.closeCause[0] != '\0' && gdakiTsCauseLiveness(pe.closeCause) == GDAKI_TS_LV_DEAD;
+  }
