+// ---- gpu-detect: host-side detection (the helper's QP-state watch) ----
+// blind-apps measured that a fault is detected only inside an application call: the device classifies an error CQE in
+// flush and request waits (tsPoll), never in waitSignal or the GIN barrier, which read only the signal and abort words.
+// NCCL's GIN example 01_ring_exchange spins in waitSignal while both ranks wait for the batch's signals, so a QP moved to
+// ERR then went unread and 14 of 16 trials hung (blind-apps qa/root_cause.md 2). The watch looks from the host: every
+// NCCL_GIN_TS_QPWATCH_MS (default 10; 0 = off, as hr) the idle helper reads the PRM state of every QP to every gated,
+// undeclined peer (QUERY_QP, a firmware command, under opMu like every QUERY_QP of the helper; not a guarded firmware
+// phase, review M1). A QP in ERR or SQER whose current epoch has no fault record (none taken by the helper, none queued)
+// for NCCL_GIN_TS_QPWATCH_GRACE_MS (default 5: a device thread that polls reports first, with the root CQE in its
+// record) gets one: the record the device would have written, built on the host from what the NIC wrote
+// (gdakiDetRecord), with the QP's current epoch, and queued like a device record (gdakiTsPushFault, as
+// gdakiTsTestSelfReport). Without a root error CQE the QP must stay out of RTS for NCCL_GIN_TS_QPWATCH_NOCQE_MS (default
+// 50) first (review M2, below). The helper then runs the normal round: classify, liveness, quiesce, re-post. At most one
+// record per QP and epoch, and one per peer and pass (the round decides its scope: a full reset when another QP to the
+// peer is not RTS). A state other than RTS, ERR and SQER (RST, INIT, RTR: only inside a round, which the idle helper is
+// not in) is logged once and not acted on; a failed query is not evidence and is counted. A QP in ERR with no WQE
+// reserved in its current incarnation (sq_rsvd_index 0: never posted to, or nothing re-posted at the last commit; a GIN
+// context whose QP to this peer the application does not use; the test hook with NCCL_GIN_FAULT_INJECT_CTX moves every
+// peer's QP of a context) gets no record until its next post: no round runs for a QP nobody uses, and the next post
+// (flushed at once) makes it "used", so the next pass queues it. Such a QP that only receives keeps the hr behaviour: the
+// sender's RETRY_EXC starts the round. The watch reads only this rank's QPs: the peer of a faulted rank is reached by
+// that rank's round (REQ), whatever its own device threads do. Records the watch builds do not pass through
+// gdakiQ4Handle, so ncclGinFaultQuery does not report them (transparent recovery owns them, as the device's).
+#define GDAKI_DET_PATH_HOST_WATCH 7  // ncclGinGdakiQ4Record::path of a record the watch built (host only)
+
+// mlx5 error-CQE syndrome (byte 55) and vendor syndrome (byte 54) -> class (gin_gdaki.h q4Classify, on the host)
+static uint8_t gdakiDetClassify(uint8_t syndrome, uint8_t vendor) {
+  switch (syndrome) {
+  case 0x05:
+    return vendor == 0xf5 ? NCCL_GIN_Q4_CLASS_LOCAL_QP_ERR :
+           vendor == 0xf9 ? NCCL_GIN_Q4_CLASS_FLUSH_TRAILING : NCCL_GIN_Q4_CLASS_FLUSH_OTHER;
+  case 0x04: return NCCL_GIN_Q4_CLASS_LOC_PROT;
+  case 0x12: return NCCL_GIN_Q4_CLASS_REM_INV_REQ;
+  case 0x13: return NCCL_GIN_Q4_CLASS_REM_ACCESS;
+  case 0x15: return NCCL_GIN_Q4_CLASS_RETRY_EXC;
+  case 0x16: return NCCL_GIN_Q4_CLASS_RNR_RETRY_EXC;
+  case 0x01: return NCCL_GIN_Q4_CLASS_LOC_LEN;
+  case 0x02: return NCCL_GIN_Q4_CLASS_LOC_QP_OP;
+  case 0x14: return NCCL_GIN_Q4_CLASS_REM_OP;
+  case 0x22: return NCCL_GIN_Q4_CLASS_REM_ABORT;
+  case 0x11: return NCCL_GIN_Q4_CLASS_LOC_ACCESS;
+  case 0x10: return NCCL_GIN_Q4_CLASS_BAD_RESP;
+  default: return NCCL_GIN_Q4_CLASS_OTHER;
+  }
+}
+
+// The fault record of a QP the watch found out of RTS, as q4Report would write it: the device QP struct and its CQ ring
+// are read over the copy path (gdakiRecD2H: over the NIC when that path is on, no CUDA call), and the first error CQE of
+// the current lap in the unconsumed window [cqe_ci, sq_rsvd_index) is the root. Without one, the poster-side record of
+// the vendored slot wait (gate swErr) is used. Without either, the QP left RTS with nothing in flight (a local QP moved
+// to ERR, or a responder-side error): class LOCAL_QP_ERR, which the round recovers (a QP reset with nothing to re-post),
+// root_src 3. Returns where the class came from: "cq", "slot-wait", "none", or "unread" (a copy failed: LOCAL_QP_ERR); or
+// "idle": no WQE reserved in this incarnation (sq_rsvd_index 0), and no record is made (the caller waits for a post).
+// Ring CQs only (the research knob NCCL_GIN_GDAKI_CQ_TYPE=collapsed gives "none"; transparent recovery needs a ring).
+static const char* gdakiDetRecord(struct gdakiRecHost* r, int peer, const gdakiRecQp& rq, struct doca_gpu_verbs_qp_hl* q,
+                                  struct ncclGinGdakiQ4Record* rec) {
+  memset(rec, 0, sizeof(*rec));
+  rec->kind = NCCL_GIN_Q4_KIND_ERR_CQE;
+  rec->path = GDAKI_DET_PATH_HOST_WATCH;
+  rec->cq_type = DOCA_GPUNETIO_VERBS_CQ_64B;
+  rec->peer = (uint32_t)peer;
+  rec->ctx_id = (uint32_t)rq.ctxIdx;
+  rec->ts_epoch = r->ts->qs[rq.qpIdx].epoch;
+  rec->qpn = gdakiRecQpn(q);
+  rec->cls = NCCL_GIN_Q4_CLASS_LOCAL_QP_ERR;
+  rec->root_src = 3;
+  struct doca_gpu_verbs_qp* v = q->qp_gverbs;
+  struct doca_gpu_dev_verbs_qp snap;
+  if (v->qp_gpu == nullptr || gdakiRecD2H(r, &snap, v->qp_gpu, sizeof(snap)) != ncclSuccess) return "unread";
+  const struct doca_gpu_dev_verbs_cq& cq = snap.cq_sq;
+  const uint64_t S = snap.sq_rsvd_index;
+  if (S == 0) return "idle";
+  const uint32_t cqeNum = cq.cqe_num;
+  rec->cqe_num = cqeNum;
+  rec->cqe_ci = cq.cqe_ci;
+  rec->ticket = S != 0 ? S - 1 : 0;
+  rec->root_index = rec->ticket;
+  if (cqeNum == 0 || (cqeNum & (cqeNum - 1)) != 0 || (size_t)cqeNum * DOCA_GPUNETIO_VERBS_CQE_SIZE > r->pinnedSize)
+    return "unread";
+  std::vector<uint8_t> ring((size_t)cqeNum * DOCA_GPUNETIO_VERBS_CQE_SIZE);
+  if (gdakiRecD2H(r, ring.data(), cq.cqe_daddr, ring.size()) != ncclSuccess) return "unread";
+  uint64_t lo = cq.cqe_ci;
+  if (S > cqeNum && lo < S - cqeNum) lo = S - cqeNum;
+  const uint8_t* root = nullptr;
+  for (uint64_t i = lo; i < S; i++) {
+    const uint64_t pos = i + cq.cqe_rsvd;
+    const uint8_t* c = ring.data() + (pos & (cqeNum - 1)) * DOCA_GPUNETIO_VERBS_CQE_SIZE;
+    if (!gdakiRecCqeCurrent(c, pos, cqeNum, i)) continue;
+    const uint8_t op = c[63] >> 4;
+    if (op == 0xd || op == 0xe) {
+      if (root == nullptr) {
+        root = c;
+        rec->root_index = i;
+      }
+      rec->n_err_window++;
+    } else {
+      rec->n_ok_window++;
+    }
+  }
+  if (root != nullptr) {
+    memcpy(rec->root_cqe, root, 64);
+    rec->hw_err_synd = root[52];
+    rec->hw_synd_type = root[53];
+    rec->vendor_err = root[54];
+    rec->syndrome = root[55];
+    rec->wqe_counter = ((uint16_t)root[60] << 8) | root[61];
+    rec->root_opcode = root[63] >> 4;
+    rec->cls = gdakiDetClassify(rec->syndrome, rec->vendor_err);
+    rec->root_src = 0;
+  }
+  // as q4Report: the poster-side record replaces a window with no root or with only a trailing flush (syndrome 0x05,
+  // not the head-of-SQ vendor syndrome 0xf5; the root CQE's slot was reused by the WQE that poster posted next)
+  if (root == nullptr || (rec->syndrome == 0x05 && rec->vendor_err != 0xf5)) {
+    uint32_t sw = 0;
+    if (gdakiTsGateRead(r, v, offsetof(struct ncclGinTsGate, swErr), &sw, sizeof(sw)) == ncclSuccess &&
+        (sw & NCCL_GIN_TS_SWERR_VALID) != 0) {
+      rec->syndrome = (uint8_t)(sw >> 8);
+      rec->vendor_err = (uint8_t)sw;
+      rec->root_opcode = (uint8_t)((sw >> 16) & 0xf);
+      rec->cls = gdakiDetClassify(rec->syndrome, rec->vendor_err);
+      rec->root_src = 1;
+      return "slot-wait";
+    }
+  }
+  return root != nullptr ? "cq" : "none";
+}
+
+// A fault record for a QP to `peer` that is waiting in the helper's queue and not stale.
+static bool gdakiDetQueued(struct gdakiRecHost* r, int peer) {
+  struct gdakiTs* ts = r->ts;
+  std::lock_guard<std::mutex> lk(ts->qMu);
+  for (const auto& f : ts->faults) {
+    if ((int)f.rec.peer != peer) continue;
+    const int qi = peer + (int)f.rec.ctx_id * r->nranks;
+    if (qi < 0 || qi >= (int)ts->qs.size() || f.rec.ts_epoch >= ts->qs[qi].epoch) return true;
+  }
+  return false;
+}
+
+static const char* gdakiDetStateName(uint32_t st) {
+  switch (st) {
+  case 0x0: return "RST";
+  case 0x1: return "INIT";
+  case 0x2: return "RTR";
+  case 0x3: return "RTS";
+  case 0x4: return "SQER";
+  case 0x5: return "SQD";
+  case 0x6: return "ERR";
+  default: return "?";
+  }
+}
+
+// One pass of the watch (helper thread, idle: no round runs, the fault queue was empty at the top of the loop).
+static void gdakiDetWatchStep(struct gdakiRecHost* r) {
+  struct gdakiTs* ts = r->ts;
+  if (ts->detWatchMs <= 0) return;
+  const double now = gdakiQ4MonoMs();
+  if (now < ts->detNextMs) return;
+  ts->detNextMs = now + ts->detWatchMs;
+  struct gdaki_context* g = r->ctx;
+  for (int p = 0; p < (int)ts->peers.size(); p++) {
+    struct gdakiTsPeer& pe = ts->peers[p];
+    if (p == g->rank || !pe.gated || pe.declined) continue;
+    struct Bad {
+      gdakiRecQp* rq;
+      struct doca_gpu_verbs_qp_hl* q;
+      uint32_t st;
+    };
+    std::vector<Bad> bad;
+    {
+      // QUERY_QP never overlaps a QP state change (the fault hook, a round). Review M1: no firmware-phase guard here
+      // (gdakiRecFwGuard). The round watchdog charges an overrun of a guarded phase to the peer (its word goes up, the
+      // async error is raised); a process stopped (SIGSTOP) inside a guarded phase looks like an overrun to the watcher
+      // thread right after SIGCONT, and the idle watch is inside a phase a few percent of the time. A QUERY_QP that never
+      // returns stalls the helper, which the heartbeat check sees once a record is queued (gdakiTsWatchdog).
+      std::lock_guard<std::mutex> op(r->opMu);
+      gdakiRecForPeer(r, p, [&](gdakiRecQp& rq, struct doca_gpu_verbs_qp_hl* q) {
+        uint32_t st = 0;
+        const double t0 = gdakiQ4MonoMs();
+        const bool ok = doca_verbs_qp_query_seq(q->qp, nullptr, nullptr, nullptr, &st) == DOCA_SUCCESS;
+        const double us = (gdakiQ4MonoMs() - t0) * 1e3;
+        ts->detQueries++;
+        ts->detQueryUsSum += us;
+        ts->detQueryUsMax = std::max(ts->detQueryUsMax, us);
+        if (!ok) {
+          ts->detQueryFail++;
+          return;
+        }
+        if (st == 0x3u) {  // RTS
+          ts->qs[rq.qpIdx].detErrMs = 0;
+          return;
+        }
+        bad.push_back({&rq, q, st});
+      });
+    }
+    for (auto& b : bad) {
+      struct gdakiTsQp& s = ts->qs[b.rq->qpIdx];
+      if (b.st != 0x6u && b.st != 0x4u) {  // RST, INIT, RTR, SQD outside a round: logged once, not acted on
+        if (!s.detOtherLogged) {
+          s.detOtherLogged = true;
+          ts->detOther++;
+          GIN_TS_NOTE("GIN/TS: rank %d: QP watch: qpn %#x (rank %d, context %d) is in state %s outside a round; not acted on "
+                      "mono_ms=%.3f", g->rank, gdakiRecQpn(b.q), p, b.rq->ctxIdx, gdakiDetStateName(b.st), gdakiQ4MonoMs());
+        }
+        continue;
+      }
+      if (s.detPushedEpoch == (int64_t)s.epoch) continue;  // queued once for this epoch already
+      if (s.handled >= s.epoch + 2u) continue;              // a record of this epoch was taken: its handling decides
+      if (s.detErrMs == 0 || s.detErrEpoch != s.epoch) {    // first sight: the grace starts
+        s.detErrMs = now;
+        s.detErrEpoch = s.epoch;
+        ts->detNextMs = std::min(ts->detNextMs, now + ts->detGraceMs);
+        continue;
+      }
+      if (now - s.detErrMs < ts->detGraceMs) {
+        ts->detNextMs = std::min(ts->detNextMs, s.detErrMs + ts->detGraceMs);
+        continue;
+      }
+      if (gdakiDetQueued(r, p)) break;  // a device record for this peer is waiting: the next loop handles it
+      struct ncclGinGdakiQ4Record rec;
+      ts->heartbeatUs.store(gdakiTsNowUs(), std::memory_order_release);  // review L1: the copies below are bounded (2 s)
+      const char* src = gdakiDetRecord(r, p, *b.rq, b.q, &rec);
+      ts->heartbeatUs.store(gdakiTsNowUs(), std::memory_order_release);
+      // review M2: without a root CQE (none, unread) the error may be on the responder side of a write the peer made (a
+      // remote access error leaves no CQE here); that peer's requester CQE says it, and its device thread or its own
+      // watch declines the pair and sends FAIL. A record here would start a LOCAL_QP_ERR round that re-posts the failing
+      // write. So such a QP waits NCCL_GIN_TS_QPWATCH_NOCQE_MS (default 50) out of RTS before its record is queued.
+      if ((strcmp(src, "none") == 0 || strcmp(src, "unread") == 0) && now - s.detErrMs < ts->detNoCqeMs) {
+        ts->detNextMs = std::min(ts->detNextMs, s.detErrMs + ts->detNoCqeMs);
+        continue;
+      }
+      if (strcmp(src, "idle") == 0) {  // never posted to: no round for a QP nobody uses (read again next pass)
+        if (!s.detIdleLogged) {
+          s.detIdleLogged = true;
+          ts->detIdle++;
+          GIN_TS_NOTE("GIN/TS: rank %d: QP watch: qpn %#x (rank %d, context %d) is in state %s and was never posted to; no "
+                      "record until its first post mono_ms=%.3f", g->rank, rec.qpn, p, b.rq->ctxIdx,
+                      gdakiDetStateName(b.st), gdakiQ4MonoMs());
+        }
+        continue;
+      }
+      s.detPushedEpoch = (int64_t)s.epoch;
+      ts->detFound++;
+      const double t = gdakiQ4MonoMs();
+      GIN_TS_NOTE("GIN/TS: rank %d: QP watch: qpn %#x (rank %d, context %d) is in state %s with no fault record for %.1f "
