+/* The CQ is collapsed, so by the time device code polls it the flush of a later WQE may have
+ * replaced the CQE of the operation that failed. The NIC also keeps the first error of a QP in the QP
+ * context (QUERY_QP with qpc_ext; qp_context_extension.error_syndrome is 12 bytes into the extension
+ * that follows query_qp_out, vendor_error_syndrome and syndrome are its last two bytes), and a flush
+ * does not replace it [measured, ConnectX-6 firmware 20.43.4100]. A latched flush is replaced by
+ * that; wqe_counter is not touched. QP numbers are per NIC and the record does not name
+ * the NIC, so nothing is replaced unless exactly one RC or DCI QP has that number.
+ * psn[0], psn[1] get last_acked_psn and next_send_psn of that QP: how far the NIC got, in packets
+ * (the send PSN starts at 0, see ibgda_qp_rtr2rts). */
+static bool ibgda_restore_cause(nvshmem_transport_t t, uint64_t *record, uint32_t *psn) {
+    nvshmemt_ibgda_state_t *ibgda_state = (nvshmemt_ibgda_state_t *)t->state;
+    const uint64_t rec = *record;
+    const uint32_t qpn = (rec >> 32) & 0xffffff;
+    uint8_t in[DEVX_ST_SZ_BYTES(query_qp_in)] = {0};
+    uint8_t out[DEVX_ST_SZ_BYTES(query_qp_out) + 192] = {0};
+    const uint8_t *synd = out + DEVX_ST_SZ_BYTES(query_qp_out) + 12;
+    struct ibgda_ep *found = NULL;
+    int matches = 0;
+    std::lock_guard<std::mutex> lock(ibgda_state->rc_endpoint_lock);
+
+    DEVX_SET(query_qp_in, in, opcode, MLX5_CMD_OP_QUERY_QP);
+    DEVX_SET(query_qp_in, in, qpc_ext, 1);
+    DEVX_SET(query_qp_in, in, qpn, qpn);
+    auto match = [&](struct ibgda_ep **eps, int num_eps) {
+        for (int i = 0; i < num_eps; i++) {
+            if (eps[i] && eps[i]->qpn == qpn) {
+                found = eps[i];
+                matches++;
+            }
+        }
+    };
+    for (int j = 0; j < ibgda_state->n_devs_selected; j++) {
+        struct ibgda_device *device =
+            (struct ibgda_device *)ibgda_state->common.devices + ibgda_state->selected_dev_ids[j];
+        match(device->rc.eps, device->rc.num_eps_per_pe * t->n_pes);
+        match(device->dci.eps, device->dci.num_eps);
+    }
+    if (matches != 1 || mlx5dv_devx_obj_query(found->devx_qp, in, sizeof(in), out, sizeof(out)))
+        return false;
+    psn[0] = DEVX_GET(qpc, DEVX_ADDR_OF(query_qp_out, out, qpc), last_acked_psn);
+    psn[1] = DEVX_GET(qpc, DEVX_ADDR_OF(query_qp_out, out, qpc), next_send_psn);
+    if (((rec >> 8) & 0xff) == MLX5_CQE_SYNDROME_WR_FLUSH_ERR &&
+        (rec & 0xff) != NVSHMEMI_IBGDA_VENDOR_ERR_LOCAL_QP && synd[3] &&
+        (synd[3] != MLX5_CQE_SYNDROME_WR_FLUSH_ERR || synd[2] == NVSHMEMI_IBGDA_VENDOR_ERR_LOCAL_QP))
+        __sync_bool_compare_and_swap(record, rec,
+                                     (rec & ~0xffffULL) | (uint64_t)synd[3] << 8 | synd[2]);
+    return true;
+}
+
+/* Prints, once, the first error CQE that device code latched in state.extra (see ibgda_poll_cq).
+ * One key=value line; a log collector can be fed from here once one exists. */
+static int ibgda_report_device_error(nvshmem_transport_t t) {
+    static bool reported = false;
+    static int restore_tries = 3; /* a query that fails or finds no cause is not repeated forever */
+    static std::mutex report_lock; /* the proxy thread and nvshmemx_get_op_error() both call this */
+    std::lock_guard<std::mutex> lock(report_lock);
+    nvshmemi_ibgda_device_state_t *state_h =
+        (nvshmemi_ibgda_device_state_t *)t->type_specific_shared_state;
+    nvshmemx_op_error_t err = {};
+    static uint32_t psn[2];
+    static bool psn_valid = false;
+    char psn_str[48] = "psn=unavailable";
+    const auto trailing_flush = [&err] {
+        return err.syndrome == MLX5_CQE_SYNDROME_WR_FLUSH_ERR &&
+               err.vendor_err != NVSHMEMI_IBGDA_VENDOR_ERR_LOCAL_QP;
+    };
+
+    if (state_h) nvshmemi_ibgda_load_err(state_h->extra, &err);
+    /* Queries go on while the QP did not answer or the record is still a trailing flush. */
+    if (err.error_class != NVSHMEMX_OP_ERROR_NONE && restore_tries > 0 &&
+        (!psn_valid || trailing_flush())) {
+        restore_tries--;
+        psn_valid |= ibgda_restore_cause(t, (uint64_t *)state_h->extra, psn);
+        nvshmemi_ibgda_load_err(state_h->extra, &err);
+    }
+    /* One line, printed once no further query can improve it. */
+    if (err.error_class != NVSHMEMX_OP_ERROR_NONE && !reported &&
+        !(trailing_flush() && restore_tries > 0)) {
+        reported = true;
+        if (psn_valid) snprintf(psn_str, sizeof(psn_str), "acked_psn=%u next_psn=%u", psn[0], psn[1]);
+        NVSHMEMI_WARN_PRINT(
+            "IBGDA error CQE: reporting_pe=%d qpn=%#x wqe_counter=%u syndrome=%#x vendor_err=%#x class=%d "
+            "%s. The operation failed and later operations on this QP are flushed.",
+            t->my_pe, err.qpn, err.wqe_counter, err.syndrome, err.vendor_err, err.error_class, psn_str);
+        /* quiet and the blocking calls cannot return an error, so by default this process exits
+         * here rather than go on with data that did not arrive. Whether the other PEs stop is up
+         * to the launcher (mpirun ends the job). */
+        if (((nvshmemt_ibgda_state_t *)t->state)->common.options->IBGDA_ABORT_ON_OP_ERROR) {
+            NVSHMEMI_ERROR_PRINT("Aborting after the IBGDA error above. Set "
+                                 "NVSHMEM_IBGDA_ABORT_ON_OP_ERROR=0 to keep running and handle "
+                                 "it with nvshmemx_get_op_error().\n");
+            fflush(NULL);
+            _exit(EXIT_FAILURE);
+        }
+    }
+    return 0;
+}
