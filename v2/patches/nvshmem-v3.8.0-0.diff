+// Reads op_own; if it is an error CQE, latches it into *record (first one wins) for
+// nvshmemx_get_op_error() and the host WARN. Call before cons_idx publishes the completion: a thread
+// that sees it may quiet and query at once. Returns op_own so the poll reads the CQE no more often
+// than the original code (each read is a cache-bypassing load).
+// The record keeps cons_idx, not the counter of the CQE: the CQ is collapsed, so that CQE can be the
+// flush of a later WQE, while every WQE below the cons_idx read before the first error was seen
+// has completed. That is the index a retransmission can safely start from.
+__device__ NVSHMEMI_STATIC NVSHMEMI_DEVICE_ALWAYS_INLINE uint8_t ibgda_latch_err_cqe(
+    void *record, struct mlx5_cqe64 *cqe64, uint64_t cons_idx) {
+    ibgda_mlx5_err_cqe_t *cqe_err = (ibgda_mlx5_err_cqe_t *)cqe64;
+    __be16 counter;
+    __be32 qpn;
+    uint8_t syndrome, vendor_err;
+    const uint8_t opown = ibgda_atomic_read(&cqe64->op_own);
+
+    if (!record || likely((opown >> 4) != MLX5_CQE_REQ_ERR)) return opown;
+    // The NIC overwrites this single CQE in place: reread until the counter is the same before and
+    // after (best effort, not a seqlock). Locals because BSWAP evaluates its argument more than once.
+    do {
+        counter = ibgda_atomic_read(&cqe_err->wqe_counter);
+        qpn = ibgda_atomic_read(&cqe_err->s_wqe_opcode_qpn);
+        syndrome = ibgda_atomic_read(&cqe_err->syndrome);
+        vendor_err = ibgda_atomic_read(&cqe_err->vendor_err_synd);
+    } while (ibgda_atomic_read(&cqe_err->wqe_counter) != counter);
+    atomicCAS((unsigned long long int *)record, 0ULL,
+              (unsigned long long int)NVSHMEMI_IBGDA_ERR_RECORD(BSWAP32(qpn), cons_idx, syndrome,
+                                                                vendor_err));
+    // The caller publishes the completion in cons_idx next. Threads of other blocks and the host
+    // read the record, so it is made visible at system scope first (error path only).
+    __threadfence_system();
+    return opown;
+}
