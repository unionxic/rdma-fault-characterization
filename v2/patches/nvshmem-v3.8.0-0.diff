@@ -11,12 +11,22 @@
 
 #define NVSHMEMI_IBGDA_STATE_PADDING_V2 44
 
+/* state.extra points to one uint64_t in host-pinned memory, written by device code and read by the
+ * host: 0, or the first error that device code polled:
+ * 1 << 63 | QP number << 32 | wqe_counter << 16 | syndrome << 8 | vendor_err_synd
+ * wqe_counter is the low 16 bits of the QP's cons_idx before the error was seen: every WQE of that QP
+ * below it has completed (see ibgda_latch_err_cqe). */
+#define NVSHMEMI_IBGDA_ERR_RECORD(qpn, wqe_counter, syndrome, vendor_err)                  \
+    ((1ULL << 63) | ((uint64_t)((qpn)&0xffffff) << 32) | ((uint64_t)(uint16_t)(wqe_counter) << 16) | \
+     ((uint64_t)(uint8_t)(syndrome) << 8) | (uint8_t)(vendor_err))
+
 #define NVSHMEMI_IBGDA_SCALAR_INVALID -1
 #define NVSHMEMI_IBGDA_USSCALAR_INVALID 0xFFFF
 #define NVSHMEMI_IBGDA_USCALAR_INVALID 0xFFFFFFFF
 #define NVSHMEMI_IBGDA_ULSCALAR_INVALID 0xFFFFFFFFFFFFFFFF
 
 #include <infiniband/mlx5dv.h>  // for mlx5_wqe_av
+#include "non_abi/nvshmemx_error.h"  // for nvshmemx_op_error_t
 #include <linux/types.h>        // for __be32
 #if !defined __CUDACC_RTC__
 #include <stddef.h>  // for size_t
@@ -346,6 +356,40 @@ static_assert(sizeof(nvshmemi_ibgda_device_state_v2) == 8384,
 
 typedef nvshmemi_ibgda_device_state_v2 nvshmemi_ibgda_device_state_t;
 
+/* vendor_err_synd is written by the NIC firmware; mlx5dv.h names none of the values used here. 0xf5
+ * on a flush syndrome meaning "this QP failed locally" is a measured rule (ConnectX-6 MT4123,
+ * firmware 20.43.4100): unverified on other NICs or firmware. */
+#define NVSHMEMI_IBGDA_VENDOR_ERR_LOCAL_QP 0xf5
+
+/* The one reader of the NVSHMEMI_IBGDA_ERR_RECORD that state.extra points to (host API, host WARN,
+ * device API). Classifies only: whether to retry is the caller's decision. */
+#ifdef __CUDACC__
+__host__ __device__
+#endif
+static inline int nvshmemi_ibgda_load_err(void *record_ptr, nvshmemx_op_error_t *err) {
+    if (!err || !record_ptr) return nvshmemi_op_error_unavailable(err);
+    const uint64_t record = *(volatile uint64_t *)record_ptr;
+    err->qpn = (record >> 32) & 0xffffff;
+    err->wqe_counter = (uint16_t)(record >> 16);
+    err->syndrome = (uint8_t)(record >> 8);
+    err->vendor_err = (uint8_t)record;
+    if (!record)
+        err->error_class = NVSHMEMX_OP_ERROR_NONE;
+    else if (err->syndrome == MLX5_CQE_SYNDROME_LOCAL_PROT_ERR ||
+             err->syndrome == MLX5_CQE_SYNDROME_REMOTE_INVAL_REQ_ERR)
+        err->error_class = NVSHMEMX_OP_ERROR_REQUEST;
+    else if (err->syndrome == MLX5_CQE_SYNDROME_WR_FLUSH_ERR &&
+             err->vendor_err == NVSHMEMI_IBGDA_VENDOR_ERR_LOCAL_QP)
+        err->error_class = NVSHMEMX_OP_ERROR_LOCAL_QP;
+    else if (err->syndrome == MLX5_CQE_SYNDROME_REMOTE_ACCESS_ERR ||
+             err->syndrome == MLX5_CQE_SYNDROME_TRANSPORT_RETRY_EXC_ERR ||
+             err->syndrome == MLX5_CQE_SYNDROME_RNR_RETRY_EXC_ERR)
+        err->error_class = NVSHMEMX_OP_ERROR_PEER;
+    else
+        err->error_class = NVSHMEMX_OP_ERROR_UNKNOWN;
+    return NVSHMEMX_SUCCESS;
+}
