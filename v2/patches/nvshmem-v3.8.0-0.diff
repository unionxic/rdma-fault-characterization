+/* What the error CQE alone tells about a failed operation. Whether the peer process is alive is not
+ * known here; NVSHMEMX_OP_ERROR_PEER needs that to decide between retry and giving up. */
+typedef enum {
+    NVSHMEMX_OP_ERROR_NONE = 0,
+    NVSHMEMX_OP_ERROR_REQUEST,  /* the request is invalid (length, key, permission): do not retry */
+    NVSHMEMX_OP_ERROR_LOCAL_QP, /* the local QP failed; the request may be valid */
+    NVSHMEMX_OP_ERROR_PEER,     /* rejected or not answered by the peer */
+    NVSHMEMX_OP_ERROR_UNKNOWN   /* only a flush was seen, or an unclassified syndrome */
+} nvshmemx_op_error_class_t;
+
+/* The first error since init, see nvshmemx_get_op_error(). qpn is the QP of the first error CQE that
+ * device code polled. wqe_counter is a lower bound, not the failed operation: every WQE of that QP
+ * below it (16-bit index) has completed, the ones from it on may or may not have. syndrome and
+ * vendor_err are the cause the NIC keeps for that QP once the host has read it, and those of the
+ * polled CQE (possibly a flush that follows the failed operation) before that or where it cannot be
+ * read. */
+typedef struct {
+    nvshmemx_op_error_class_t error_class;
+    uint32_t qpn;
+    uint16_t wqe_counter;
+    uint8_t syndrome;
+    uint8_t vendor_err;
+} nvshmemx_op_error_t;
+
+/* nvshmemx_get_op_error() where no error record is kept: NONE there must not read as "nothing failed". */
+#ifdef __CUDACC__
+__host__ __device__
+#endif
+static inline int nvshmemi_op_error_unavailable(nvshmemx_op_error_t *err) {
+    nvshmemx_op_error_t none = {NVSHMEMX_OP_ERROR_NONE, 0, 0, 0, 0};
+    if (!err) return NVSHMEMX_ERROR_INVALID_VALUE;
+    *err = none;
+    return NVSHMEMX_ERROR_NOT_SUPPORTED;
+}
