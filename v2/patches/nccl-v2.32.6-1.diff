+        *vendor_err = doca_gpu_dev_verbs_load_relaxed_sys_global(&err_cqe->vendor_err_synd);
+    } while (doca_gpu_dev_verbs_load_relaxed_sys_global(&cqe64->wqe_counter_sig_op_own_raw) !=
