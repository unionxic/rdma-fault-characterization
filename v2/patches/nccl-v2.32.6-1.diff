+// The PSNs a QP to rank peer has sent and not seen acknowledged, 0 if none has any. Only then does a closed socket
+// count as a death: the counter also rises for plain congestion, and in an orderly teardown, where the sockets close
+// too, everything sent was acknowledged. The NIC is asked because the GPU's own indices stay behind when the
+// application waits on counters or signals instead of a flush. A QP that already failed keeps its last gap and says
+// nothing about the peer. Main QPs only: the companion QPs loop back to this rank.
+static uint32_t gdakiOutstanding(struct gdaki_context* ctx, int peer) {
+  const int nranks = ctx->nranks;
+  for (int idx = peer; idx < ctx->nContexts * nranks; idx += nranks) {
+    struct doca_gpu_verbs_qp_error_info info;
+    if (ctx->gqps[idx] && doca_gpu_verbs_query_last_error(ctx->gqps[idx]->qp_gverbs, &info) == DOCA_SUCCESS &&
+        !info.has_error && info.unacked_psns) {
+      return info.unacked_psns;
+    }
+  }
+  return 0;
+}
