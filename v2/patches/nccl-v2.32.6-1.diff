+  const int cnpFd = tickMs > 0 ? open(path, O_RDONLY | O_CLOEXEC) : -1; // < 0: no death check
+  uint64_t cnp = UINT64_MAX, cnpTime = 0; // UINT64_MAX: the first read only sets the baseline
