+// ==================== Error record ====================
+
+/**
+ * @brief [Internal] Host-polled CQ: what a poll returns when the CQE it wants is not there: -EIO
+ * once the QP has failed (the CQE will never arrive), EBUSY otherwise. The host writes cq->err, so
+ * it is read with the system-scope, cache-bypassing load.
+ */
+__device__ static __forceinline__ int doca_priv_gpu_dev_verbs_cq_not_ready(
+    struct doca_gpu_dev_verbs_cq *cq) {
+    return doca_gpu_dev_verbs_load_relaxed_sys_global(&cq->err) ? -EIO : EBUSY;
+}
+
+/**
+ * @brief [Internal] GPU-polled CQ: true if cqe_ci has passed WQE cons_index. Once the QP has failed
+ * cqe_ci carries DOCA_GPUNETIO_VERBS_CQ_CI_FAILED, so a poll learns of it from the load it does
+ * anyway, with no extra load on the normal path. The flag is then stripped
+ * from *cqe_ci and *not_ready becomes -EIO, as above.
+ */
+__device__ static __forceinline__ bool doca_priv_gpu_dev_verbs_cq_passed(
+    uint64_t cons_index, uint64_t *cqe_ci, int *not_ready = nullptr) {
+    if (cons_index >= *cqe_ci) return false;
+    [[likely]] if (!(*cqe_ci & DOCA_GPUNETIO_VERBS_CQ_CI_FAILED))
+        return true;
+    *cqe_ci &= ~DOCA_GPUNETIO_VERBS_CQ_CI_FAILED;
+    if (not_ready) *not_ready = -EIO;
+    return cons_index < *cqe_ci;
+}
