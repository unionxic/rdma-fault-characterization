+__device__ static __forceinline__ uint32_t doca_priv_gpu_dev_verbs_cq_read_err_cqe(
+    struct doca_gpunetio_ib_mlx5_cqe64 *cqe64, uint8_t *syndrome, uint8_t *vendor_err) {
+    struct doca_gpunetio_ib_mlx5_err_cqe_ex *err_cqe =
+        (struct doca_gpunetio_ib_mlx5_err_cqe_ex *)cqe64;
+    uint32_t cqe_chunk;
+    do {
+        cqe_chunk = doca_gpu_dev_verbs_load_relaxed_sys_global(&cqe64->wqe_counter_sig_op_own_raw);
+        *syndrome = doca_gpu_dev_verbs_load_relaxed_sys_global(&err_cqe->syndrome);
+        *vendor_err = doca_gpu_dev_verbs_load_relaxed_sys_global(&err_cqe->vendor_err_synd);
+    } while (doca_gpu_dev_verbs_load_relaxed_sys_global(&cqe64->wqe_counter_sig_op_own_raw) !=
+             cqe_chunk);
+    return doca_gpu_dev_verbs_bswap32(cqe_chunk);
