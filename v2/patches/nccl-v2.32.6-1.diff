+// The QPs to a dead rank are moved to the error state: the NIC flushes what is outstanding, so the GPU threads return
+// through the error path instead of waiting for the retry limit.
+static void gdakiPeerDied(struct gdaki_context* ctx, int dead, uint32_t unacked) {
+  const int nranks = ctx->nranks;
+  WARN("GDAKI: remoteRank=%d is dead (rp_cnp_handled rose, its socket is closed and %u PSNs sent to it are not "
+       "acknowledged): rank=%d nranks=%d, its QPs are moved to the error state", dead, unacked, ctx->rank, nranks);
+  doca_verbs_qp_attr_t* attr = nullptr;
+  pthread_mutex_lock(&ctx->err_mutex);
+  ctx->error_seen = true; // reported by ncclCommGetAsyncError before the flush CQEs come
+  if (doca_verbs_qp_attr_create(&attr) == DOCA_SUCCESS &&
+      doca_verbs_qp_attr_set_next_state(attr, DOCA_VERBS_QP_STATE_ERR) == DOCA_SUCCESS) {
+    for (int idx = dead; idx < ctx->nContexts * nranks; idx += nranks) {
+      for (auto* gqp : {ctx->gqps[idx], ctx->companion_gqps ? ctx->companion_gqps[idx] : nullptr}) {
+        if (gqp && doca_verbs_qp_modify(gqp->qp, attr, DOCA_VERBS_QP_ATTR_NEXT_STATE) != DOCA_SUCCESS) {
+          WARN("GDAKI: failed to move qpIdx %d to the error state", idx);
+        }
+      }
+    }
+  }
+  if (attr) doca_verbs_qp_attr_destroy(attr);
+  pthread_mutex_unlock(&ctx->err_mutex);
