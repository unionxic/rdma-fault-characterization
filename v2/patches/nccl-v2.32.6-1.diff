+// ==================== Error record ====================
+
+/**
+ * @brief [Internal] Host-polled CQ: what a poll returns when the CQE it wants is not there: -EIO
+ * once the QP has failed (the CQE will never arrive), EBUSY otherwise. The host writes cq->err, so
+ * it is read with the system-scope, cache-bypassing load.
+ */
+__device__ static __forceinline__ int doca_priv_gpu_dev_verbs_cq_not_ready(
+    struct doca_gpu_dev_verbs_cq *cq) {
+    return doca_gpu_dev_verbs_load_relaxed_sys_global(&cq->err) ? -EIO : EBUSY;
+}
+
+/**
+ * @brief [Internal] GPU-polled CQ: true if cqe_ci has passed WQE cons_index. Once the QP has failed
+ * cqe_ci carries DOCA_GPUNETIO_VERBS_CQ_CI_FAILED, so a poll learns of it from the load it does
+ * anyway (reading cq->err in the poll loops cost 4% in ring_exchange). The flag is then stripped
+ * from *cqe_ci and *not_ready becomes -EIO, as above.
+ */
+__device__ static __forceinline__ bool doca_priv_gpu_dev_verbs_cq_passed(
+    uint64_t cons_index, uint64_t *cqe_ci, int *not_ready = nullptr) {
+    if (cons_index >= *cqe_ci) return false;
+    [[likely]] if (!(*cqe_ci & DOCA_GPUNETIO_VERBS_CQ_CI_FAILED))
+        return true;
+    *cqe_ci &= ~DOCA_GPUNETIO_VERBS_CQ_CI_FAILED;
+    if (not_ready) *not_ready = -EIO;
+    return cons_index < *cqe_ci;
+}
+
+/**
+ * @brief [Internal] Record the error CQE of WQE wqe_index in cq->err and return -EIO.
+ * After the first error CQE the QP is in the error state: no later WQE succeeds, and cqe_ci stops
+ * advancing because it only moves on success. Without this record every later poll waits forever.
+ * The record keeps the lowest failed index polled so far: the root cause if its CQE was polled, a
+ * flush otherwise.
+ */
+template <enum doca_gpu_dev_verbs_resource_sharing_mode resource_sharing_mode>
+__device__ static __forceinline__ int doca_priv_gpu_dev_verbs_cq_set_err(
+    struct doca_gpu_dev_verbs_cq *cq, uint64_t wqe_index, uint8_t syndrome, uint8_t vendor_err) {
+    // The first record also flags cqe_ci (not of a host-polled CQ: there the host owns cqe_ci).
+    if (doca_gpu_dev_verbs_atomic_max<uint64_t, resource_sharing_mode>(
+            &cq->err, DOCA_GPUNETIO_VERBS_CQ_ERR_RECORD(wqe_index, syndrome, vendor_err)) == 0 &&
+        doca_gpu_dev_verbs_load_const((uint8_t *)&cq->cq_type) !=
+            DOCA_GPUNETIO_VERBS_CQ_64B_COLLAPSED_HOST)
+        doca_gpu_dev_verbs_atomic_add<uint64_t, resource_sharing_mode>(
+            &cq->cqe_ci, DOCA_GPUNETIO_VERBS_CQ_CI_FAILED);
+    return -EIO;
