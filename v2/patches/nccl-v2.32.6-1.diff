+  const int nranks = ctx->nranks;
+  const int neighbour[2] = {(ctx->rank + 1) % nranks, (ctx->rank + nranks - 1) % nranks};
+  int socks[2]; // read once: collComm can be freed before this thread stops (both comm types start with ncclIbNetCommBase)
+  for (int i = 0; i < 2; i++) {
+    void* comm = i ? ctx->collComm->recvComm : ctx->collComm->sendComm;
+    socks[i] = comm && neighbour[i] != ctx->rank ? ((struct ncclIbNetCommBase*)comm)->sock.socketDescriptor : -1;
+  }
+  char path[PATH_MAX];
